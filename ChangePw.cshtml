@{
    
/*
Registration Page

This App requires pre-approval to register.
This page accepts a pre approval identifier and retrieves the pre approval info.
After that this is a Standard Registration Form using WebSecurity
*/

Layout = "~/Shared/Layouts/_MiniLayout.cshtml";
Page.Title = "שינוי סיסמא";
var password1 = "";
var password2 = "";
var old_password = "";
int u_id=WebSecurity.CurrentUserId;     

 }
  <div class="login-card" style="font-size: 24px;text-align: center">
      <form id="ChangePwForm">

 <h1><u>שינוי סיסמא</u></h1>
          משתמש: @WebSecurity.CurrentUserName
     <p>
         <input type="password" id="old_password" name="old_password" placeholder="סיסמא ישנה" style="font-size: 18px;padding: 5px;margin: 5px;">
        
    </p>
    <p>
         <input type="password" id="password1" name="password1" placeholder="סיסמא חדשה" style="font-size: 18px;padding: 5px;margin: 5px;">
    </p>
    <p>
         <input type="password" id="password2" name="password2" placeholder="אישור סיסמא" style="font-size: 18px;padding: 5px;margin: 5px;">
    </p>

    
    <br>
      <p>
          <button id="submit_btn" type="button" style="font-size: 16px;background-color: #57d600;color: #fff;border: 2px solid #57d600;padding: 5px;margin: 5px;" onclick="AjaxActions('CHANGEPW',@u_id,1);">שינוי סיסמא</button>
          <button id="cancel_btn" type="button" style="font-size: 16px;background-color: #f00;color: #fff;border: 2px solid #f00;padding: 5px;margin: 5px;" onclick="controller.close('Info');clearContenet('InfoContent');">ביטול</button>
    </p>
</form>
</div>