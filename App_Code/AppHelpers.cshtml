@helper CreditEntryRow(dynamic entry)
{

    if (entry != null)
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

        int u_id = WebSecurity.CurrentUserId;
        var op_data = Database.Open("op_data");
        var sqlSelect = "";
        string username = WebSecurity.CurrentUserName;
        DateTime local_time = AppFunctions.LocalTime();
        DateTime ts = local_time;
        DateTime default_date = Convert.ToDateTime("1/1/1900");
        int member_id = entry.m_id;
        string member_name = entry.member_name;
        decimal debt = entry.debt;
        DateTime due_date = entry.due_date;
        DateTime NOR_date = Convert.ToDateTime("1/1/1901");

        int DaysTillDue = 0;
        DaysTillDue = AppFunctions.HowManyDaysAgoWas(due_date);

        sqlSelect = "SELECT DISTINCT vendor_id FROM ChargeBook WHERE is_paid=0 AND m_id=@0";
        var owedVendors = op_data.Query(sqlSelect, member_id);
        string vendorsList = "";
        sqlSelect = "SELECT * FROM chargebook WHERE is_paid=0 AND m_id=@0 ORDER BY is_paid, current_due_date";
        var chargebook = op_data.Query(sqlSelect, member_id);

        sqlSelect = "SELECT SUM(amount_due) as amount_due FROM chargebook WHERE is_paid=0 AND m_id=@0 AND current_due_date<=@1";
        var currDueAmount = op_data.QuerySingle(sqlSelect, member_id, local_time.Date);
        decimal cur_amount_due = 0; try { cur_amount_due = currDueAmount.amount_due; } catch { }

        foreach (var vendor in owedVendors)
        {
            string vendor_name = AppFunctions.GetVendorTitleById(vendor.vendor_id);
            vendorsList += vendor_name + " ";
        }

        <td class="TableCell" style="text-align:center">
        </td>
        <td class="TableCell">
            <div style="overflow:auto;color:#000">
                <button type="button" style="margin-left: 5px; font-size: 16px;float:right;border:0 " onclick="sbload('MainSb', 'Caller?p1=Member_Info&p2=@entry.m_id');">👤</button>

                <b>@member_name</b>

            </div>
        </td>

        <td class="TableCell">
            <div style="overflow:auto;color:#000">
                <b>@debt.ToString("C", culture) </b>
                <button type="button" style="margin-left: 5px; font-size: 16px; float: right; border: 0 " onclick="Accordionize('credInf_@member_id');">❔</button>

            </div>

        </td>
        <td class="TableCell">
            <div style="overflow:auto;color:#000">
                <button type="button" style="margin-left: 5px; font-size: 16px; float: right; border: 0 " onclick="RepAjaxUpdate('SelectCreditMember', 'NewOrderMemberContainer','','@member_id','2');">💰</button>

                <b>@cur_amount_due.ToString("C", culture) </b>
            </div>

        </td>

        if (due_date == NOR_date)
        {
            <td class="TableCell">
                <div style="overflow: auto; color: #F00"><b>בהזמנה הבאה </b></div>
            </td>
        }
        else
        {
            if (DaysTillDue < 0)
            {
                <td class="TableCell">
                    <div style="overflow:auto;color:#000"><b>@due_date.ToShortDateString() (בעוד @(DaysTillDue*-1) ימים) </b></div>
                </td>
            }
            else
            {
                <td class="TableCell">
                    <div style="overflow:auto;color:#F00"><b>@due_date.ToShortDateString() (לפני @DaysTillDue ימים) </b></div>
                </td>
            }
        }

        op_data.Close();

    }


}

