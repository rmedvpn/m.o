@helper LoadWebProspectTemplate(int prospect_id, int template_id = 0)
{
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    int rep_id = WebSecurity.CurrentUserId;
    string rep_name = AppFunctions.GetRepName(rep_id);
    DateTime local_time = AppFunctions.LocalTime();
    sqlSelect = "SELECT serial,prospect_name,wanum,prospect_id FROM webprospects WHERE serial=@0";
    var prospect = op_data.QuerySingle(sqlSelect, prospect_id);

    if (template_id == 0)
    {
        template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultWebProspectsMsgTemplate"));
    }

    sqlSelect = "SELECT * FROM msgTemplates WHERE id=@0";
    var msgTemplate = op_data.QuerySingle(sqlSelect, template_id);




    string msgTxt = "";
    string JoinPhoneNumber = AppFunctions.GetAppProperty("JoinPhoneNumber");
    string msgType = "";
    try { msgType = msgTemplate.msgType; } catch { }
    sqlSelect = "select * from msgTemplates WHERE msgType=@0";
    var msgTemplates = op_data.Query(sqlSelect, msgType);

    if (msgTemplate != null)
    {



        msgTxt = msgTemplate.msg_body;




        if (prospect != null)
        {
            string wanum = prospect.wanum;
            string wanum_code = "";
            try { wanum_code = prospect.wanum.Substring(prospect.wanum.Length - 4); } catch { wanum_code = "9999"; }
            try { msgTxt = msgTxt.Replace("USERNAME", prospect.prospect_name); } catch { }
            try { msgTxt = msgTxt.Replace("JOINPHONENUMBER", JoinPhoneNumber); } catch { }
            try { msgTxt = msgTxt.Replace("PROSPECT_ID", prospect.serial.ToString()); } catch { }
            try { msgTxt = msgTxt.Replace("PROSPECTID", prospect.serial.ToString()); } catch { }
            try { msgTxt = msgTxt.Replace("LAST4WANUM", wanum_code); } catch { }
            try { msgTxt = msgTxt.Replace("WANUM", prospect.wanum); } catch { }
            try { msgTxt = msgTxt.Replace("REPNAME", rep_name); } catch { }
            try { msgTxt = msgTxt.Replace("DATESTAMP30", local_time.AddDays(30).ToShortDateString()); } catch { }
            try { msgTxt = msgTxt.Replace("DATESTAMP14", local_time.AddDays(30).ToShortDateString()); } catch { }
            try { msgTxt = msgTxt.Replace("DATESTAMP7", local_time.AddDays(7).ToShortDateString()); } catch { }
            try { msgTxt = msgTxt.Replace("DATESTAMP", local_time.ToShortDateString()); } catch { }
            try { msgTxt = msgTxt.Replace("TIMESTAMP", local_time.ToShortDateString() + " " + local_time.ToString("HH:mm")); } catch { }


        }

    }

    <div style="overflow: auto;background-color: #fff">
        <select style="border: 0;background: transparent;color: #fff;background-color: #808080;font-weight: bold;font-size: 16px;width: 90%" onchange="AjaxUpdate('LoadProspectTemplate','MsgTemplatesDiv','MsgTemplatesLoader',@prospect_id,this.value);">
            @foreach (var item in msgTemplates)
            {
                <option value="@item.id" @if (template_id == item.id) { <text> selected</text>}>@item.msg_title</option>
            }
        </select>
        <div class="spinner" style="text-align: center;display: none;" id="MsgTemplatesLoader">
            <div class="bounce1"></div>
            <div class="bounce2"></div>
            <div class="bounce3"></div>
        </div>
        <textarea id="tb_cb" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;height: 300px;" oninput="document.getElementById('txt_@prospect_id').innerHTML = this.value;">@msgTxt</textarea>
        <div id="txt_@prospect_id" style="padding: 5px;margin: 5px;display: none;">@msgTxt</div>


    </div>

    op_data.Close();
}

@helper LoadProspectTemplate(int prospect_id, int template_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    int rep_id = WebSecurity.CurrentUserId;
    string rep_name = AppFunctions.GetRepName(rep_id);
    DateTime local_time = AppFunctions.LocalTime();
    sqlSelect = "SELECT prospect_name,wanum FROM prospects WHERE serial=@0";
    var prospect = db.QuerySingle(sqlSelect, prospect_id);

    if (template_id == 0)
    {
        template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultProspectsMsgTemplate"));
    }
    template_id = 1;
    sqlSelect = "SELECT * FROM msgTemplates WHERE id=@0";
    var msgTemplate = db.QuerySingle(sqlSelect, template_id);




    string msgTxt = "";
    string JoinPhoneNumber = AppFunctions.GetAppProperty("JoinPhoneNumber");
    string msgType = "";
    try { msgType = msgTemplate.msgType; } catch { }
    sqlSelect = "select * from msgTemplates WHERE msgType=@0";
    var msgTemplates = db.Query(sqlSelect, msgType);

    if (msgTemplate != null)
    {



        msgTxt = msgTemplate.msg_body;


        if (prospect != null)
        {
            msgTxt = msgTxt.Replace("USERNAME", prospect.prospect_name);
            msgTxt = msgTxt.Replace("JOINPHONENUMBER", JoinPhoneNumber);
            msgTxt = msgTxt.Replace("PROSPECT_ID", prospect_id.ToString());
            msgTxt = msgTxt.Replace("PROSPECTID", prospect_id.ToString());
            msgTxt = msgTxt.Replace("WANUM", prospect.wanum);
            msgTxt = msgTxt.Replace("REPNAME", rep_name);
            msgTxt = msgTxt.Replace("DATESTAMP30", local_time.AddDays(30).ToShortDateString());
            msgTxt = msgTxt.Replace("DATESTAMP14", local_time.AddDays(30).ToShortDateString());
            msgTxt = msgTxt.Replace("DATESTAMP7", local_time.AddDays(7).ToShortDateString());
            msgTxt = msgTxt.Replace("DATESTAMP", local_time.ToShortDateString());
            msgTxt = msgTxt.Replace("TIMESTAMP", local_time.ToShortDateString() + " " + local_time.ToString("HH:mm"));


        }

        <div style="overflow: auto;background-color: #ffffcc">
            <select style="border: 0;background: transparent;color: #fff;background-color: #57d600;font-weight: bold;font-size: 16px;width: 90%" onchange="AjaxUpdate('LoadProspectTemplate','MsgTemplatesDiv','MsgTemplatesLoader',@prospect_id,this.value);">
                @foreach (var item in msgTemplates)
                {
                    <option value="@item.id" @if (template_id == item.id) { <text> selected</text>}>
                        @item.msg_title
                    </option>
                }
            </select>
            <div class="spinner" style="text-align: center;display: none;" id="MsgTemplatesLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
            <textarea id="tb_cb" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;height: 300px;" oninput="document.getElementById('txt_@prospect_id').innerHTML = this.value;">@msgTxt</textarea>
            <div id="txt_@prospect_id" style="padding: 5px;margin: 5px;display: none;">@msgTxt</div>


        </div>

        db.Close();
    }
}

@helper LoadReachoutTemplate(int member_id, int template_id = 0, string reachout_type = "REP", int list_id = 0)
{
    int u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";

    if (template_id == 0)
    {
        template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultReachOutMsgTemplate"));
    }
    int ReachOutPostponeIntervalDays = Convert.ToInt32(AppFunctions.GetAppProperty("ReachOutPostponeIntervalDays"));
    sqlSelect = "SELECT * FROM msgTemplates WHERE id=@0";
    var msgTemplate = db.QuerySingle(sqlSelect, template_id);
    string msgType = ""; try { msgType = msgTemplate.msgType; } catch { }
    sqlSelect = "select * from msgTemplates WHERE msgType=@0 AND (rep_id=@1 OR rep_id=0)";
    var msgTemplates = db.Query(sqlSelect, msgType, u_id);
    DateTime local_time = AppFunctions.LocalTime();
    sqlSelect = "select u_Stats.*,pb.member_name,pb.wanum from u_Stats JOIN pb ON u_Stats.serial=pb.m_id WHERE u_Stats.serial=@0";
    var memberRs = db.QuerySingle(sqlSelect, member_id);

    bool is_welcome_msg = false;
    if (msgType == "WELCOME")
    {
        is_welcome_msg = true;
    }


    string msgTxt = "";
    string MokedPhoneNumber = AppFunctions.GetAppProperty("MokedPhoneNumber");
    string DisconnectPhoneNumber = AppFunctions.GetAppProperty("DisconnectPhoneNumber");

    if (msgTemplate != null)
    {
        msgTxt = msgTemplate.msg_body;
        if (memberRs != null)
        {
            msgTxt = msgTxt.Replace("USERNAME", memberRs.member_name);
            msgTxt = msgTxt.Replace("REPNAME", WebSecurity.CurrentUserName);
            msgTxt = msgTxt.Replace("MOKEDPHONENUMBER", MokedPhoneNumber);
            msgTxt = msgTxt.Replace("DISCONNECTPHONENUMBER", DisconnectPhoneNumber);
            msgTxt = msgTxt.Replace("DATESTAMP30", local_time.AddDays(30).ToShortDateString());
            msgTxt = msgTxt.Replace("DATESTAMP14", local_time.AddDays(30).ToShortDateString());
            msgTxt = msgTxt.Replace("DATESTAMP7", local_time.AddDays(7).ToShortDateString());
            msgTxt = msgTxt.Replace("DATESTAMP", local_time.ToShortDateString());
            msgTxt = msgTxt.Replace("TIMESTAMP", local_time.ToShortDateString() + " " + local_time.ToString("HH:mm"));

            if (msgTxt.Contains("LODAYS"))
            {
                TimeSpan DaysSinceLastOrder = local_time - memberRs.last_order_ts;
                int lodays = DaysSinceLastOrder.Days;
                msgTxt = msgTxt.Replace("LODAYS", lodays.ToString());
            }

            if (msgTxt.Contains("ANNIVERSARYYEARS"))
            {
                TimeSpan DaysSinceFirstOrder = local_time - memberRs.first_order_ts;
                int AnniversaryYears = local_time.Year - memberRs.first_order_ts.Year;
                string AnniversaryYearsStr = ""; AnniversaryYearsStr = AppFunctions.FormatAnniversaryYears(AnniversaryYears);
                msgTxt = msgTxt.Replace("ANNIVERSARYYEARS", AnniversaryYearsStr);
            }

            msgTxt = msgTxt.Replace("USER_ID", memberRs.serial.ToString());
            msgTxt = msgTxt.Replace("USERID", memberRs.serial.ToString());
            msgTxt = msgTxt.Replace("WANUM", memberRs.wanum);

        }
    }

    <div style="overflow: auto;background-color: #ffffcc">
        <div style="overflow: auto">
            <textarea id="tb_cb" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;height: 300px;" oninput="document.getElementById('txt_@member_id').innerHTML = this.value;">@msgTxt</textarea>
            <div id="txt_@member_id" style="padding: 5px;margin: 5px;display: none;">@msgTxt</div>
        </div>
        <div style="overflow: auto">
            <div style="overflow: auto;" id="beforeMsgSentOptions">
                <span style="display: none" id="testcb1"></span>
                @if (!is_welcome_msg)
                {
                    <button style="font-size: 16px;text-align: center;color: #fff;background-color: #57d600;border:2px solid #57d600;padding: 5px;margin: 5px;font-weight: bold;float: left" onclick="copyTextAreaToClipBoard('tb_cb');window.location.href='https://api.whatsapp.com/send?phone=@memberRs.wanum';hideElement('beforeMsgSentOptions');showElement('afterMsgSentOptions');">שליחת הודעה</button>
                }


                <select style="border: 0;font-weight: bold;font-size: 16px;width: 50%" onchange="if(this.value=='0'){Accordionize('AccMoreOptions');}else{RepAjaxUpdate('LoadReachOutTemplate','MsgTemplatesDiv','MsgTemplatesLoader',@member_id,this.value,'@reachout_type','@list_id');}">
                    @foreach (var item in msgTemplates)
                    {
                        <option value="@item.id" @if (template_id == item.id) { <text> selected</text>}>@item.msg_title</option>
                    }


                    <option value="0">עוד אפשרויות</option>

                </select>
            </div>

            @switch (msgType)
            {
                case "WELCOME":
                    <div style="overflow: auto;">
                        <button class="accordion" id="AccMoreOptions" style="display: none;"></button>
                        <div class="panel">
                            אין פעולות נוספות
                        </div>
                    </div>

                    break;
                default:
                    <div style="overflow: auto;display: none;" id="afterMsgSentOptions">
                        <button style="font-size: 16px;text-align: center;color: #fff;background-color: #b200ff;border:2px solid #57d600;padding: 5px;margin: 5px;font-weight: bold;float: left" onclick="AjaxActions('REACHOUTMSGSENT',@memberRs.serial, 1, '@reachout_type', '@list_id'); EnableControlButton();">👌 ההודעה נשלחה</button>
                        <button style="border: 0;font-weight: bold;font-size: 16px;width: 50%" onclick="Accordionize('AccMoreOptions');">
                            פעולות נוספות
                        </button>
                    </div>

                    <div style="overflow: auto;">
                        <button class="accordion" id="AccMoreOptions" style="display: none;"></button>
                        <div class="panel">
                            <button style="background-color: #e3e3e3;color: #000;font-size: 16px;font-weight: bold;border: 2px solid #000;padding: 5px;margin: 5px;" onclick="AjaxActions('POSTPONEREACHOUT',@member_id,1,'@reachout_type','@list_id'); EnableControlButton();">דחיית ההודעה לעתיד</button>
                            <button style="background-color: #e3e3e3;color: #000;font-size: 16px;font-weight: bold;border: 2px solid #000;padding: 5px;margin: 5px;" onclick="AjaxActions('DEACTIVATEWANUM',@member_id,1,'@reachout_type','@list_id'); EnableControlButton();">סימון ווטסאפ לא פעיל</button>
                            <button style="background-color: #e3e3e3;color: #000;font-size: 16px;font-weight: bold;border: 2px solid #000;padding: 5px;margin: 5px;" onclick="AjaxActions('DELETIONUPONUSERREQUEST',@member_id,1,'@reachout_type','@list_id'); EnableControlButton();">החבר/ה ביקש/ה להתנתק</button>
                            <button style="background-color: #e3e3e3;color: #000;font-size: 16px;font-weight: bold;border: 2px solid #000;padding: 5px;margin: 5px;float:left;" onclick="EnableControlButton(); ControlButton();"><<חזרה</button>
                        </div>
                    </div>

                    break;
            }




            <div class="spinner" style="text-align: center;display: none;" id="MsgTemplatesLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>

        </div>


    </div>

    db.Close();
}

