                                        </div>

                                        <div style="font-size: 12px;padding: 5px;overflow: auto;">
                                            <span style="float: right">
                                                <input type="text" style="width: 40px;font-size: 16px;padding: 5px;margin: 5px;" id="discount" name="discount" value="@String.Format("{0:0.00}",Member.discount_percantage)">
                                            </span>
                                            <span style="float: right;margin-right: 10px;">
                                                <span style="float: right">
                                                    <input type="radio" style="padding: 5px;margin: 5px;" id="discount_type_percantage" name="discount_type" value="percent" checked> % הנחה
                                                </span><br>
                                                <span style="float: right">
