@helper MemberCredit(int member_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    int rep_id = WebSecurity.CurrentUserId;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime due_date = local_time.AddDays(14);
    DateTime default_date = Convert.ToDateTime("1/1/1900");


    var op_data = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM chargebook WHERE m_id=@0 ORDER BY is_paid, original_due_date";
    var chargebook = op_data.Query(sqlSelect, member_id);
    sqlSelect = "SELECT * FROM VENDORS WHERE is_active=1";
    var vendors = op_data.Query(sqlSelect);

    <div style="overflow:auto;padding:5px;">
        <button class="A" style="float:left" onclick="Accordionize('UserCreditSettingsDiv');">הגדרות</button>
        <h3>
            קרדיט
        </h3>
        <div class="ProspectListRow">
            <div class="B">
                <button style="display:none" class="accordion" id="UserCreditSettingsDiv"></button>
                <div class="panel">
                    <div class="A">
                        חסום באשראי
                    </div>
                    <div class="A">
                        סכום אשראי מאושר
                    </div>
                </div>
            </div>
            <div style="overflow:auto">
                <div style="overflow:auto;">
                    <div style="overflow:auto">
                        <div id="new_credit_div">
                            <form id="CreditAddForm">
                                <input type="hidden" name="member_id" value="@member_id" />

                                <h3>רישום קרדיט חדש</h3>
                                <span style="padding:5px;padding:5px;font-size:16px;float:right">
                                    ספק<br />
                                    <select style="padding:5px;padding:5px;font-size:16px;" name="vendor_id">
                                        <option>נא לבחור</option>
                                        @foreach (var vendor in vendors)
                                        {
                                            <option value="@vendor.vendor_id">@vendor.vendor_name</option>
                                        }
                                    </select>
                                </span>
                                <span style="padding:5px;;font-size:16px;float:right">
                                    סכום<br />
                                    <input type="text" name="amount" style="padding:5px;;font-size:16px;width:50px;" />
                                </span>
                                <span style="padding: 5px; ; font-size: 16px; float: right;  ">
                                    תאריך החזרה מוסכם<br />
                                    <input type="date" name="due_date" style="padding:5px;;font-size:16px;" value="@due_date.ToString("yyyy-MM-dd")" />
                                </span>
                                <span style="padding: 5px; ; font-size: 16px; float: right;  ">
                                    הערה?<br />
                                    <input type="text" style="padding:5px;;font-size:16px;" name="creditnote" />
                                </span>
                                <span style="padding: 5px; padding: 5px; font-size: 16px; float: right;  ">
                                    <br />
                                    <button type="button" style="padding: 5px;  font-size: 16px; float: right " onclick="AjaxActions('CreditAction', '@member_id', '', 'CreditAddForm', '@member_id');">ביצוע</button>
                                </span>
                            </form>
                        </div>
                        <div id="return_credit_div" style="display:none;">
                            <form id="CreditReturnForm">
                                <input type="hidden" name="member_id" value="@member_id" />

                                <h3>רישום החזרת חוב</h3>
                                <span style="padding:5px;padding:5px;font-size:16px;float:right">
                                    ספק אוסף<br />
                                    <select style="padding:5px;padding:5px;font-size:16px;" name="vendor_id">
                                        <option>נא לבחור</option>
                                        @foreach (var vendor in vendors)
                                        {
                                            <option value="@vendor.vendor_id">@vendor.vendor_name</option>
                                        }
                                    </select>
                                </span>
                                <span style="padding:5px;font-size:16px;float:right">
                                    סכום<br />
                                    <input type="text" name="amount" style="padding:5px;;font-size:16px;width:50px;" />
                                </span>
                                <span style="padding: 5px; ; font-size: 16px; float: right;">
                                    תאריך קבלת תשלום<br />
                                    <input type="date" name="return_date" style="padding:5px;font-size:16px;" value="@local_time.ToString("yyyy-MM-dd")" />
                                </span>
                                <span style="padding: 5px; font-size: 16px; float: right; ">
                                    הערה?<br />
                                    <input type="text" style="padding:5px;font-size:16px;" name="creditnote" />
                                </span>
                                <span style="padding: 5px; padding: 5px; font-size: 16px; float: right;">
                                    <br />
                                    <button type="button" style="padding: 5px;  font-size: 16px; float: right " onclick="AjaxActions('CreditReturn', '@member_id', '', 'CreditReturnForm', '@member_id');">ביצוע</button>
                                </span>
                            </form>
                        </div>

                        <button type="button" style="padding: 5px;  font-size: 16px; float: left " id="return_credit_btn" onclick="hideElement('new_credit_div');hideElement('return_credit_btn');showElement('return_credit_div');showElement('new_credit_btn');">החזרת חוב</button>
                        <button type="button" style="padding: 5px;  font-size: 16px; float: left;display:none; " id="new_credit_btn" onclick="hideElement('return_credit_div');hideElement('new_credit_btn');showElement('new_credit_div');showElement('return_credit_btn');">חוב חדש</button>

                    </div>
                </div>

            </div>

            @if (chargebook.Count() > 0)
            {
                <div class="ProspectListRow">
                    <div style="overflow:auto;padding:5px;border-bottom:1px dotted #e3e3e3;width:90%">
                        <span style="float: right; color: #000; padding: 3px; margin: 3px; width: 20%">תאריך</span>
                        <span style="float: right; padding: 3px; margin: 3px; width: 15%;">ספק</span>
                        <span style="float: right; padding: 3px; margin: 3px; width: 15%;">סכום</span>
                        <span style="float: right; color: #000; padding: 3px; margin: 3px; width: 15%">תאריך החזרה</span>
                        <span style="float: right; padding: 3px; margin: 3px;">הערות</span>
                    </div>

                    @foreach (var charge in chargebook)
                    {
                        int transaction_type = charge.transaction_type;
                        string amt_color = "#f00";
                        DateTime current_due_date = default_date; try { current_due_date = charge.current_due_date; } catch { }
                        DateTime actual_return_date = default_date; try { actual_return_date = charge.actual_return_date; } catch { }
                        int daysTillDue = 0;
                        daysTillDue = AppFunctions.HowManyDaysAgoWas(current_due_date) * -1;
                        bool is_paid = false;
                        decimal amount_due = charge.amount_due;
                        decimal amount = charge.amount;
                        if (charge.is_paid)
                        {
                            is_paid = true;
                            amt_color = "#57d600";
                        }
                        <div style="overflow:auto;padding:5px;border-bottom:1px dotted #e3e3e3;width:90%">
                            <span style="color: #000; float: right; padding: 3px; margin: 3px;width:20%"><span>@charge.ts.ToShortDateString()<br /><span style="font-size:11px;color:#808080">@charge.ts.ToString("HH:mm")</span></span></span>
                            <span style="float: right; padding: 3px; margin: 3px; width: 15%;">@AppFunctions.GetVendorTitleById(charge.vendor_id)</span>

                            @if (amount != amount_due)
                            {
                                <span style=" float: right; padding: 3px; margin: 3px;width:15%;color:@amt_color"><span>@amount_due.ToString("c", culture)</span><br /><span style="font-size:11px;color:#808080">חוב מקורי: @amount.ToString("c", culture)</span></span>

                            }
                            else
                            {
                                <span style="float: right; padding: 3px; margin: 3px; width: 15%;color:@amt_color">@amount_due.ToString("c", culture)</span>
                            }


                            <span style="color: #000; float: right; padding: 3px; margin: 3px;width:15%"><span>@current_due_date.ToShortDateString()</span><br /><span style="font-size:11px;color:#808080">עוד @daysTillDue ימים</span></span>
                            <span style="float: right; padding: 3px; margin: 3px;">@charge.transaction_notes</span>
                        </div>
                    }

                </div>

            }
            else
            {
                <div class="ProspcetListCell">אין הערות</div>
            }
        </div>

    </div>




    op_data.Close();

}

