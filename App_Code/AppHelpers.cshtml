                            <span style="padding: 5px;margin: 5px;float: right;width: 50px;">@userRec.order_count</span>
                            <span style="padding: 5px;margin: 5px;float: right;width: 50px;">@userRec.the_cnt</span>
                            <div style="padding: 5px;margin: 5px;float: left;text-align: left;font-size: 14px;display: @LastOrderDisplayState">@userRec.last_order_ts.ToShortDateString()<span style="font-size: 12px;color: #b200ff"><br>(לפני @DaysSinceLastOrderInt  ימים)</span></div>
                            <div style="padding: 5px;margin: 5px;float: left;text-align: left;font-size: 14px;display: @LastContactDisplayState">@userRec.last_reachout_ts.ToShortDateString()<span style="font-size: 12px;color: #b200ff"><br>(לפני @DaysSinceLastContactInt  ימים)</span></div>

