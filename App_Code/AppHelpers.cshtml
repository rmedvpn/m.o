@helper DebtsStatus(string showWhat = "ALL")
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;
    DateTime default_date = Convert.ToDateTime("1/1/1900");


    //DataFunctions.ImportWebContactForm();

    switch (showWhat)
    {
        case "ALL":
            sqlSelect = "SELECT serial,m_id,member_name,debt,due_date FROM pb WHERE debt>0 order by next_order_return, due_date";
            break;
        case "DUE":
            sqlSelect = "SELECT serial,m_id,member_name,debt,due_date FROM pb WHERE debt>0 AND due_date<=@0 AND next_order_return=0 order by due_date";
            break;
        case "GOOD":
            sqlSelect = "SELECT serial,m_id,member_name,debt,due_date FROM pb WHERE debt>0 AND due_date>@0 AND next_order_return=0 order by due_date";
            break;
        case "NOR":
            sqlSelect = "SELECT serial,m_id,member_name,debt,due_date FROM pb WHERE debt>0 AND next_order_return=1";
            break;
    }


    var Debtees = op_data.Query(sqlSelect, local_time);

    <table style="width:99%;direction:rtl">
        <tr class="ListRow" style="width: 100%;">
            <td class="TableCell" style="text-align:center"><div></div></td>
            <td class="TableCell">שם חבר.ה</td>
            <td class="TableCell">סכום חוב</td>
            <td class="TableCell">לתשלום מיידי</td>
            <td class="TableCell">לתשלום עד</td>

        </tr>

        @foreach (var entry in Debtees)
        {
            int member_id = entry.m_id;
            string member_name = entry.member_name;
            decimal debt = entry.debt;
            DateTime due_date = entry.due_date;

            int DaysTillDue = 0;
            DaysTillDue = AppFunctions.HowManyDaysAgoWas(due_date);

            sqlSelect = "SELECT DISTINCT vendor_id FROM ChargeBook WHERE is_paid=0 AND m_id=@0";
            var owedVendors = op_data.Query(sqlSelect, member_id);
            string vendorsList = "";
            sqlSelect = "SELECT * FROM chargebook WHERE is_paid=0 AND m_id=@0 ORDER BY is_paid, current_due_date";
            var chargebook = op_data.Query(sqlSelect, member_id);

            sqlSelect = "SELECT SUM(amount_due) as amount_due FROM chargebook WHERE is_paid=0 AND m_id=@0 AND current_due_date<=@1";
            var currDueAmount = op_data.QuerySingle(sqlSelect, member_id, local_time.Date);
            decimal cur_amount_due = 0; try { cur_amount_due = currDueAmount.amount_due; } catch { }

            foreach (var vendor in owedVendors)
            {
                string vendor_name = AppFunctions.GetVendorTitleById(vendor.vendor_id);
                vendorsList += vendor_name + " ";
            }


            <tr class="ListRow" id="CreditEntryRow_@entry.m_id">
                @AppHelpers.CreditEntryRow(entry)
            </tr>


            <tr>
                <td colspan="999">
                    <button class="Accordion" style="display:none" id="credInf_@member_id"></button>
                    <div class="panel" style="width:99%">
                        <table style="width: 99%; background-color: #e3e3e3; border: 1px dotted #808080;text-align:right">
                            <tr style="padding: 5px; border-bottom: 1px dotted #e3e3e3; width: 95%; color: #000;">
                                <td style=" color: #000; padding: 3px; margin: 3px;width:70px;">תאריך נטילה</td>
                                <td style=" padding: 3px; margin: 3px; ">ספק</td>
                                <td style=" padding: 3px; margin: 3px; ">סכום</td>
                                <td style=" color: #000; padding: 3px; margin: 3px; ">תאריך החזרה</td>
                                <td style="padding: 3px; margin: 3px;">הערות</td>
                                <td style="padding: 3px; margin: 3px; "></td>
                            </tr>

                            @foreach (var charge in chargebook)
                            {

                                <tr id="CreditEntryInfoRow_@charge.serial">
                                    @AppHelpers.CreditEntryInfoRow(charge)
                                </tr>


                            }

                        </table>

                    </div>
                </td>
            </tr>



        }
    </table>


    op_data.Close();

}


