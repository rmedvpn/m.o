@helper MemberDiscounts(int member_id)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

int rep_id = WebSecurity.CurrentUserId;
DateTime local_time = AppFunctions.LocalTime();
DateTime due_date = local_time.AddDays(14);
DateTime default_date = Convert.ToDateTime("1/1/1900");


var op_data = Database.Open("op_data");
var sqlSelect = "SELECT * FROM discounts WHERE m_id=0 ORDER BY discount_id";
var discounts = op_data.Query(sqlSelect);
sqlSelect = "SELECT * FROM VENDORS WHERE is_active=1";
var vendors = op_data.Query(sqlSelect);
sqlSelect = "SELECT * FROM pb WHERE m_id=@0";
var Member = op_data.QuerySingle(sqlSelect, member_id);
sqlSelect = "SELECT discounts.*,memberDiscounts.valid_until,memberDiscounts.is_expirable from discounts JOIN memberDiscounts ON discounts.discount_id=memberDiscounts.discount_id WHERE memberDiscounts.member_id=@0";
var AvailableMemberDiscounts = op_data.Query(sqlSelect, member_id, local_time);


<div style="overflow:auto;padding:5px;">
        <h3>
            הנחות
        </h3>
        <div class="ProspectListRow">

            <div style="overflow:auto">
                @if (AvailableMemberDiscounts.Count() > 0)
                {
                    <div style="overflow:auto;">
                        <h3>הנחות קבועות</h3>
                        @foreach (var discount in AvailableMemberDiscounts)
                        {
