@helper RepMembersList(int list_id, string sortBy = "LO", string sortDir = "", string showWhat = "NEW")
{
    int rep_id = 0;
    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    string theHtmlOutput = "";
    string LastContactDisplayState = "none;";
    string LastOrderDisplayState = "block;";
    string DelBtnDisplayState = "none;";

    if (sortBy.IsEmpty())
    {
        sortBy = "LO";
    }
    string nextSortDir = "";
    if (sortDir.IsEmpty())
    {
        nextSortDir = "DESC";
    }

    DateTime ts = AppFunctions.LocalTime();
    bool is_blaster = AppFunctions.isPermission(u_id, "is_blaster");

    var db = Database.Open("op_data");
    var sqlSelect = "select top(300) listsusers.*,(listsusers.order_count-listsusers.creation_order_count) AS the_cnt from listsusers INNER JOIN pb ON listsusers.user_id=pb.m_id WHERE listsusers.is_deleted=0 AND pb.is_deleted=0 AND listsusers.list_id=@0";
    if (list_id == -1)
    {
        sqlSelect = "select  top(300) listsusers.*,(listsusers.order_count-listsusers.creation_order_count) AS the_cnt from listsusers INNER JOIN u_stats ON listsusers.user_id=u_stats.serial WHERE u_stats.is_returning=1";
    }

    switch (showWhat)
    {
        case "NEW":
            sqlSelect = sqlSelect + " AND is_contact=0 AND mark_deletion=0";
            repTitle = repTitle + "מציג חברים שלא קיבלו הודעה ";
            break;
        case "INPROCESS":
            sqlSelect = sqlSelect + " AND is_contact=1 AND mark_deletion=0";
            repTitle = repTitle + "מציג חברים שקיבלו הודעה ";
            LastContactDisplayState = "block;";
            LastOrderDisplayState = "none;";
            break;
        case "DELETED":
            sqlSelect = sqlSelect + " AND mark_deletion=1";
            repTitle = repTitle + "מציג חברים שצריך למחוק ";
            DelBtnDisplayState = "block;";
            LastContactDisplayState = "none;";
            LastOrderDisplayState = "none;";

            break;

    }

    switch (sortBy)
    {
        case "OC":
            sqlSelect = sqlSelect + " ORDER BY order_count";
            repTitle = repTitle + "לפי כמות הזמנות כללית ";
            if (sortDir == "DESC")
            {
                sqlSelect = sqlSelect + " DESC";
                repTitle = repTitle + "בסדר יורד ";
            }
            break;
        case "AVG":
            sqlSelect = sqlSelect + " ORDER BY the_cnt ";
            repTitle = repTitle + "לפי הזמנות שבוצעו מאז יצירת הרשימה ";

            if (sortDir == "DESC")
            {
                sqlSelect = sqlSelect + " DESC";
                repTitle = repTitle + "בסדר יורד ";
            }
            break;

        case "LO":
            sqlSelect = sqlSelect + " ORDER BY last_order_ts";
            repTitle = repTitle + "לפי תאריך הזמנה אחרונה ";

            if (sortDir == "DESC")
            {
                sqlSelect = sqlSelect + " DESC";
                repTitle = repTitle + "בסדר יורד ";
            }
            break;
        case "UN":
            sqlSelect = sqlSelect + " ORDER BY user_name";
            repTitle = repTitle + "לפי שם משתמש ";

            if (sortDir == "DESC")
            {
                sqlSelect = sqlSelect + " DESC";
                repTitle = repTitle + "בסדר יורד ";
            }
            break;

        case "CONTACT":
            sqlSelect = sqlSelect + " ORDER BY last_reachout_ts";
            repTitle = repTitle + "לפי תאריך יצירת קשר אחרון ";

            if (sortDir == "DESC")
            {
                sqlSelect = sqlSelect + " DESC";
                repTitle = repTitle + "בסדר יורד ";
            }
            break;


    }


    var irgusers = db.Query(sqlSelect, list_id);

    sqlSelect = "select * from msgTemplates WHERE msgType='REACHOUT' AND (rep_id=@0 OR rep_id=0)";
    var msgTemplates = db.Query(sqlSelect, u_id);



    db.Close();
    int last_prospect_id = 9999999;
    int first_prospect_id = 0;

    string recordsList = "";

    <form id="PresereveRepActions">
        <input type="hidden" name="reachout_type" name="reachout_type" value="LIST">
        <input type="hidden" name="list_id" name="list_id" value="@list_id">

        <div style="overflow: auto;font-size: 14px;">
            <div style="overflow: auto;padding: 5px;">
                <select style="float: left;padding: 2px;margin: 2px;font-size: 16px;background: transparent;" onchange="if(document.getElementById('interfaceVar1').value==''){RepAjaxUpdate('RepMembersList','RepPreseveListDiv','SubMenuLoader',@list_id,'@sortBy','@sortDir',this.value)}">
                    <option value="NEW" @if (showWhat == "NEW") { <text> selected </text> }>חדשים</option>
                    <option value="INPROCESS" @if (showWhat == "INPROCESS") { <text> selected </text> }>בטיפול</option>
                    <option value="DELETED" @if (showWhat == "DELETED") { <text> selected </text> }>להסרה</option>
                </select>

                <b>@repTitle  <br><span style="color: #b200ff">סהכ @irgusers.Count() תוצאות</span></b>
            </div>
            <button class="Accordion" style="display: none" id="AccRepListSettings"></button>
            <div class="panel">
                <div style="overflow: auto">
                    <select style="padding: 5px;margin: 5px;font-size: 16px;float: right" name="RepRequestedAction" id="RepRequestedAction">
                        <option value="">נא לבחור פעולה</option>
                        <option value="DELETE">מחיקת רשימה</option>
                    </select>
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;float: right" onclick="AjaxActions('PresereveRepActions',@list_id,'','PresereveRepActions',document.getElementById('RepRequestedAction').value);">בצע</button>

                    @if (is_blaster)
                    {
                        <button id="blasterListBtn" type="button" style="padding: 5px;margin: 5px;font-size: 16px;float: left" onclick="hideElement('blasterListBtn');showElement('blasterListLoader');AjaxActions('ExportPreserveList',@list_id,'','PreserveListViewSettings');">בלסטר</button>
                    }


                    <div class="spinner" style="text-align: center;display: none;;float: left" id="blasterListLoader">
                        <div class="bounce1"></div>
                        <div class="bounce2"></div>
                        <div class="bounce3"></div>
                    </div>



                </div>
                <div style="overflow: auto">
                    הודעת ברירת מחדל<br>
                    <select style="padding: 5px;margin: 5px;font-size: 16px;float: right" name="RepDefaultTemplate" id="RepDefaultTemplate">
                        @foreach (var msg in msgTemplates)
                        {
                            <option value="@msg.id">@msg.msg_title</option>
                        }

                    </select>

                </div>

            </div>
            <div style="background-color: #fff;float: right;display: @DelBtnDisplayState" id="repListSelectAll">
                <span style="margin: 5px;padding: 5px;float: right;">
                    מחיקה
                </span>
            </div>
            <div style="overflow: auto">
                <span style="margin: 5px;float: right;display: none"></span>
                <span style="padding: 5px;margin: 5px;float: right;width: 80px;" onclick="if(document.getElementById('interfaceVar1').value==''){RepAjaxUpdate('RepMembersList','RepPreseveListDiv','SubMenuLoader',@list_id,'UN','@nextSortDir','@showWhat')}">שם </span>
                <span style="padding: 5px;margin: 5px;float: right;width: 50px;" onclick="if(document.getElementById('interfaceVar1').value==''){RepAjaxUpdate('RepMembersList','RepPreseveListDiv','SubMenuLoader',@list_id,'OC','@nextSortDir','@showWhat')}">הזמנות</span>
                <span style="padding: 5px;margin: 5px;float: right" onclick="if(document.getElementById('interfaceVar1').value==''){RepAjaxUpdate('RepMembersList','RepPreseveListDiv','SubMenuLoader',@list_id,'AVG','@nextSortDir','@showWhat')}">ה.מ.י</span>
                <div style="padding: 5px;margin: 5px;float: left;text-align: left;display: @LastOrderDisplayState" onclick="if(document.getElementById('interfaceVar1').value==''){RepAjaxUpdate('RepMembersList','RepPreseveListDiv','SubMenuLoader',@list_id,'LO','@nextSortDir','@showWhat')}">הזמנה אחרונה</div>
                <div style="padding: 5px;margin: 5px;float: left;text-align: left;display: @LastContactDisplayState" onclick="if(document.getElementById('interfaceVar1').value==''){RepAjaxUpdate('RepMembersList','RepPreseveListDiv','SubMenuLoader',@list_id,'CONTACT','@nextSortDir','@showWhat')}">קשר אחרון</div>
