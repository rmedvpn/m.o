}

@helper ProspectsList(string sortBy = "JOIN", string sortDir = "DESC", string showWhat = "NEW")
{
    int list_id = 0;
    int rep_id = 0;
    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    string theHtmlOutput = "";
    string LastContactDisplayState = "none;";
    string ContactReturnDisplayState = "none;";
    string JoinDisplayState = "block;";
    var op_data = Database.Open("op_data");
    var m_join = Database.Open("m_join");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;

    bool is_blaster = AppFunctions.isPermission(u_id, "is_blaster");


    DateTime local_time = AppFunctions.LocalTime();
    string nextSortDir = "DESC";
    if (sortDir == "DESC")
    {
        nextSortDir = "";
    }

    DateTime ts = AppFunctions.LocalTime();
    int prospectsCount = 0;
    int reJoinCount = 0;
    int urgentProspectsCount = 0;


    string msgTemplateType = "PROSPECT";

    sqlSelect = "SELECT COUNT(serial) as the_cnt FROM prospects WHERE is_finished=0 AND is_deleted=0 ";
    var countRs = op_data.QuerySingle(sqlSelect);
    try { prospectsCount = countRs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(serial) as the_cnt FROM pb WHERE prospect_notify=1 AND is_deleted=0 ";
    countRs = op_data.QuerySingle(sqlSelect);
    try { reJoinCount = countRs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(serial) as the_cnt FROM prospects WHERE is_finished=0 AND is_deleted=0 AND is_urgent=1";
    countRs = op_data.QuerySingle(sqlSelect);
    try { urgentProspectsCount = countRs.the_cnt; } catch { }

    sqlSelect = "SELECT * FROM webprospects";
    var webProspects = m_join.Query(sqlSelect);

    sqlSelect = "select TOP(500) serial,reachout_attempts,ts,prospect_name,city,last_reachout_ts,is_contact,is_returning,return_ts,is_urgent from prospects WHERE  is_deleted=0 AND is_finished=0 ";




    switch (showWhat)
    {
        case "NEW":
            sqlSelect = sqlSelect + " AND is_contact=0 AND mark_deletion=0";
            repTitle = repTitle + "מציג חברים שלא קיבלו הודעה ";
            sortBy = "JOIN";
            break;
        case "INPROCESS":
            sqlSelect = sqlSelect + " AND is_contact=1 AND mark_deletion=0";
            repTitle = repTitle + "מציג חברים שקיבלו הודעה ";
            LastContactDisplayState = "block;";
            JoinDisplayState = "none;";
            sortBy = "CONTACT";
            break;
        case "RETURNING":
            sqlSelect = sqlSelect + " AND is_returning=1";
            repTitle = repTitle + "מציג חברים שחזרו למערכת ";
            ContactReturnDisplayState = "block;";
            JoinDisplayState = "none;";
            sortBy = "RETURN";
            break;

        case "REJOIN":


            sqlSelect = "SELECT * FROM pb WHERE prospect_notify=1 AND is_deleted=0";
            repTitle = repTitle + "מציג חברים שמילאו טופס הצטרפות מחדש ";
            ContactReturnDisplayState = "block;";
            JoinDisplayState = "none;";
            sortBy = "REJOIN";

            msgTemplateType = "REJOIN";
            prospectsCount = reJoinCount;
            break;

    }


    switch (sortBy)
    {

        case "JOIN":
            sqlSelect = sqlSelect + " ORDER BY  is_urgent DESC,reachout_attempts, ts ";
            repTitle = repTitle + "לפי תאריך רישום ";

            if (sortDir == "DESC")
            {
                repTitle = repTitle + "בסדר יורד ";
            }
            break;

        case "CONTACT":
            sqlSelect = sqlSelect + " ORDER BY  is_urgent DESC,reachout_attempts, last_reachout_ts ";
            repTitle = repTitle + "לפי תאריך יצירת קשר אחרון ";

            if (sortDir == "DESC")
            {
                repTitle = repTitle + "בסדר יורד ";
            }
            break;
        case "RETURN":
            sqlSelect = sqlSelect + " ORDER BY  reachout_attempts, return_ts ";
            repTitle = repTitle + "לפי תאריך חזרה למערכת ";

            if (sortDir == "DESC")
            {
                repTitle = repTitle + "בסדר יורד ";
            }
            break;

        case "REJOIN":
            sqlSelect = sqlSelect + " ORDER BY  prospect_notify_ts ";
            repTitle = repTitle + "לפי תאריך הבקשה ";

            if (sortDir == "DESC")
            {
                repTitle = repTitle + "בסדר יורד ";
            }
            break;


    }


    sqlSelect = sqlSelect + sortDir;

    string sql2 = sqlSelect;
    var prospects = op_data.Query(sqlSelect);
    sqlSelect = "select * from msgTemplates WHERE is_active=1 AND  msgType=@0 AND (rep_id=@1 OR rep_id=0)";
    var msgTemplates = op_data.Query(sqlSelect, msgTemplateType, u_id);


    op_data.Close();
    int last_prospect_id = 9999999;
    int first_prospect_id = 0;

    string recordsList = "";

    <form id="ProspectsRepActions">

        <input type="hidden" name="list_id" name="list_id" value="@list_id">
        <div style="overflow: auto;padding: 5px;">
            <button type="button" id="goSettings" style="float: left;padding: 5px;margin: 0;background-color: #e3e3e3;border: 0;border-radius: 5px" onclick="Accordionize('AccRepListSettings');">⚙️</button>
            <h2>
                צירופים
            </h2>
        </div>

        <div style="overflow: auto;font-size: 14px;">
            <div style="overflow: auto;padding: 5px;">
                <select style="float: left;padding: 2px;margin: 2px;font-size: 16px;background: transparent;" onchange="RepAjaxUpdate('ProspectsList','RepPreseveListDiv','MainSbLoader',@list_id,'@sortBy','@sortDir',this.value)">
                    <option value="NEW" @if (showWhat == "NEW") { <text> selected </text> }>חדשים</option>
                    <option value="INPROCESS" @if (showWhat == "INPROCESS") { <text> selected </text> }>בטיפול</option>
                    <option value="RETURNING" @if (showWhat == "RETURNING") { <text> selected </text> }>חוזרים</option>
                    <option value="REJOIN" @if (showWhat == "REJOIN") { <text> selected </text> }>רענון</option>
                </select>

                <b>@repTitle  <br><span style="color: #b200ff">סהכ @prospects.Count() תוצאות</span> <b><span style="color: #000;">מתוך @prospectsCount רשומות</span></b></b>
            </div>

            @if (reJoinCount > 0)
            {
                <div style="overflow: auto; border-bottom:1px dotted #f00; color: red" onclick="RepAjaxUpdate('ProspectsList','RepPreseveListDiv','MainSbLoader',@list_id,'@sortBy','@sortDir','REJOIN')">⚠️ @reJoinCount משתמשים קיימים ממתינים לרענון!</div>
            }

            @if (urgentProspectsCount > 0)
            {
                <div style="overflow: auto; border-bottom:1px dotted #f00; color: red" onclick="RepAjaxUpdate('ProspectsList','RepPreseveListDiv','MainSbLoader',@list_id,'@sortBy','@sortDir','INPROCESS')">⚠️ @urgentProspectsCount מצטרפים לטיפול דחוף!</div>
            }
            <button class="Accordion" style="display: none" id="AccRepListSettings"></button>
            <div class="panel">
                <div style="overflow: auto">
                    @if (is_blaster)
                    {
                        <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;" id="blasterListBtn" onclick="hideElement('blasterListBtn');showElement('blasterListLoader');AjaxActions('ExportProspectsList',@list_id,'','ProspectsListViewSettings')">יצוא רשימה לבלסטר</button>
                    }

                    <div class="spinner" style="text-align: center;display: none;" id="blasterListLoader">
                        <div class="bounce1"></div>
                        <div class="bounce2"></div>
                        <div class="bounce3"></div>
                    </div>

                </div>
                <div style="overflow: auto">
                    הודעת ברירת מחדל<br>
                    <select style="padding: 5px;margin: 5px;font-size: 16px;float: right" name="RepDefaultTemplate" id="RepDefaultTemplate">
                        @foreach (var msg in msgTemplates)
                        {
                            <option value="@msg.id">@msg.msg_title</option>
                        }

                    </select>

                </div>

            </div>
        </div>


        @switch (showWhat)
        {
            case "NEW":
            case "INPROCESS":
            case "RETURNING":
                <div style="overflow: auto">
                    <input type="hidden" name="reachout_type" id="reachout_type" value="PROSPECT">
                    <span style="padding: 5px;margin: 5px;float: right;">שם</span>

                    <div style="padding: 5px;margin: 5px;float: left;text-align: left;display: @JoinDisplayState" onclick="RepAjaxUpdate('ProspectsList','RepPreseveListDiv','MainSbLoader',@list_id,'JOIN','@nextSortDir','@showWhat');">הצטרפות</div>
                    <div style="padding: 5px;margin: 5px;float: left;text-align: left;display: @LastContactDisplayState" onclick="RepAjaxUpdate('ProspectsList','RepPreseveListDiv','MainSbLoader',@list_id,'CONTACT','@nextSortDir','@showWhat')">קשר אחרון</div>
                    <div style="padding: 5px;margin: 5px;float: left;text-align: left;display: @ContactReturnDisplayState" onclick="RepAjaxUpdate('ProspectsList','RepPreseveListDiv','MainSbLoader',@list_id,'RETURN','@nextSortDir','@showWhat')">חזרה למערכת</div>
                </div>
                <div style="overflow: auto;background-color: #fff;" id="ProspectsDataDiv">
                    @foreach (var prospect in prospects)
                    {
                        TimeSpan DaysSinceJoin = local_time - prospect.ts;
                        var DaysSinceJoinInt = DaysSinceJoin.Days;
                        TimeSpan DaysSinceContact = local_time - prospect.last_reachout_ts;
                        var DaysSinceContactInt = DaysSinceContact.Days;
                        TimeSpan DaysSinceReturn = local_time - prospect.return_ts;
                        var DaysSinceReturnInt = DaysSinceReturn.Days;
                        string bgColor = "#e3e3e3";
                        if (prospect.is_contact)
                        {
                            bgColor = "#ffffcc";
                        }
                        if (prospect.is_urgent)
                        {
                            bgColor = "#ffcccc";
                        }
                        <div style="overflow: auto;padding: 5px;margin: 5px;background-color: @bgColor;" onclick="sbload('SubMenu','Caller?p1=prospect&p2=@prospect.serial','','ProspectsRepActions');" id="prospect_@prospect.serial">

                            <span style="float: right">
                                @prospect.prospect_name | @prospect.city<br><span style="color: #b200ff;font-size: 12px;">@prospect.ts.ToShortDateString() </span>
                            </span>
                            <span style="float: left;display: @JoinDisplayState">
                                <span style="color: #b200ff;font-size: 12px">@prospect.reachout_attempts ניסיונות</span><BR>לפני @DaysSinceJoinInt ימים
                            </span>
                            <span style="float: left;display: @LastContactDisplayState">
                                <span style="color: #b200ff;font-size: 12px">@prospect.reachout_attempts ניסיונות</span><BR>לפני @DaysSinceContactInt ימים
                            </span>
                            <span style="float: left;display: @ContactReturnDisplayState">
                                <span style="color: #b200ff;font-size: 12px">@prospect.return_ts.ToShortDateString()</span><BR>לפני @DaysSinceReturnInt ימים
                            </span>
                        </div>
                    }
                </div>
                break;
            case "REJOIN":
                <input type="hidden" name="reachout_type" id="reachout_type" value="REJOIN">
                <div style="overflow: auto">
                    <span style="padding: 5px;margin: 5px;float: right;">שם</span>

                    <div style="padding: 5px;margin: 5px;float: left;text-align: left;">חזרה למערכת</div>
                </div>
                <div style="overflow: auto;background-color: #fff;" id="ProspectsDataDiv">
                    @foreach (var prospect in prospects)
                    {
                        TimeSpan DaysSinceJoin = local_time - prospect.prospect_notify_ts;
                        var DaysSinceJoinInt = DaysSinceJoin.Days;
                        string bgColor = "#e3e3e3";
                        <div style="overflow: auto;padding: 5px;margin: 5px;background-color: @bgColor;" onclick="sbload('SubMenu', 'Caller?p1=UserReachout&p2=@prospect.m_id', '', 'ProspectsRepActions'); DisableControlButton();" id="prospect_@prospect.serial">

                            <span style="float: right">
                                @prospect.member_name
                            </span>

                            <span style="float: left;display: @ContactReturnDisplayState">
                                <span style="color: #b200ff;font-size: 12px">@prospect.prospect_notify_ts.ToShortDateString()</span><BR>לפני @DaysSinceJoinInt ימים
                            </span>
                        </div>
                    }
                </div>

                break;
        }





    </form>
    <form id="ProspectsListViewSettings">
        <input type="hidden" name="sortBy" id="sortBy" value="@sortBy">
        <input type="hidden" name="sortDir" id="sortDir" value="@sortDir">
        <input type="hidden" name="showWhat" id="showWhat" value="@showWhat">

    </form>
}

@helper syncPhoneBook(string PastedText)
{

    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    var u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string[] userRec;

    bool is_ok = true;

    string aLine, aParagraph = null;

    string last_sync = "";
    last_sync = AppFunctions.GetAppProperty("LastContactsSyncDate");

    DateTime lastFileSync = Convert.ToDateTime("1/1/1970");
    if (!last_sync.IsEmpty())
    {
        lastFileSync = Convert.ToDateTime(last_sync);
    }


    bool is_show = false;
    StringReader strReader = null;
    if (!PastedText.IsEmpty())
    {
        strReader = new StringReader(PastedText);
        is_show = true;
    }

    int counter = 0;
    int totalCount = 0;
    int dup_count = 0;
    string userName = "";
    string wanum = "";
    string display_wanum = "";
    string raw_bg_color = "#fff";


    <div style="background-color:  #000; overflow: auto; font-size: 24px; color: #fff;">
        הרשומות הבאות יקלטו במערכת
        <button onclick="hideElement('CommitOrdersUpdateBtn');showElement('ordersUploadLoader'); AjaxActions('SyncContacts', document.getElementById('Pasted_data').value, '');" style="float: left;font-size: 16px;padding: 5px;margin: 5px;" id="CommitOrdersUpdateBtn"><b>ביצוע עדכון</b></button>
        <div style="display: none;float: left" id="ordersUploadLoader">
            <div class="spinner" style="text-align: center;font-size: 30px;">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>

        <input type="hidden" name="Pasted_data" id="Pasted_data" value="@PastedText" />
    </div>
    <div style="overflow: auto;padding: 0;margin: 0;">
        <form id="OrdersToAdd">
            <table style="width: 100%;border: 1px solid #000;border-collapse: collapse">
                @while (is_show)
                {
                    totalCount++;
                    display_wanum = "";
                    aLine = strReader.ReadLine();

                    if (aLine != null)
                    {
                        userName = "";
                        wanum = "";
                        raw_bg_color = "#fff";
                        string sep = "\t";
                        userRec = aLine.Split(sep.ToCharArray());



                        try { userName = Convert.ToString(userRec[1]); userName = userName.Replace("\"", ""); } catch { }
                        for (int i = 2; i < 20; i++)
                        {
                            try { wanum = Convert.ToString(userRec[i]); wanum = wanum.Replace("\"", ""); } catch { }
                            if (wanum != "")
                            {
                                wanum = AppFunctions.wanumize(wanum);
                                if (AppFunctions.IsDigitsOnly(wanum))
                                {
                                    break;
                                }

                            }
                        }
                    }
                    else
                    {
                        aParagraph = aParagraph + "\n";
                        break;
                    }

                    wanum = AppFunctions.wanumize(wanum);
                    sqlSelect = "SELECT serial FROM phonebook WHERE phone=@0";
                    var checkDup = db.QuerySingle(sqlSelect, wanum);
                    if (checkDup != null)
                    {
                        raw_bg_color = "#ffffcc";
                        dup_count++;
                    }

                    if (userName != "" && wanum != "")
                    {
                        counter++;

                        <tr style="overflow: auto;color: #000;padding: 5px;margin: 5px;border-bottom: 1px solid #808080;background-color: @raw_bg_color">

                            <td style="overflow: auto;">@userName</td>
                            <td style="overflow: auto;">@wanum</td>
                        </tr>
                    }

                }




            </table>
        </form>
        <div style="overflow: auto;padding: 5px;margin: 5px">
            <div style="float: left;">
                <div style="display: none;float: left" id="ordersCommitLoader">
                    <div class="spinner" style="text-align: center;font-size: 30px;">
                        <div class="bounce1"></div>
                        <div class="bounce2"></div>
                        <div class="bounce3"></div>
                    </div>
                </div>

            </div>
            <div style="color: #000;font-size: 18px;overflow: auto;">👍 @counter שורות נקראו מהקובץ </div>
            <div style="color: #000;font-size: 18px;overflow: auto;">👍 @dup_count שורות קיימות במאגר </div>

        </div>

    </div>


    db.Close();

}

@helper MembersBirthdayList(string sortBy = "LO", string sortDir = "", string showWhat = "NEW")
{
    int rep_id = 0;
    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    string theHtmlOutput = "";
    string LastOrderDisplayState = "block;";
    string msgTemplateType = "";
    string reachout_type = "";
    bool is_blaster = AppFunctions.isPermission(u_id, "is_blaster");
    string exportAction = "";
    if (sortBy.IsEmpty())
    {
        sortBy = "LO";
    }
    string nextSortDir = "";
    if (sortDir.IsEmpty())
    {
        nextSortDir = "DESC";
    }

    DateTime ts = AppFunctions.LocalTime();

    var op_data = Database.Open("op_data");
    var sqlSelect = "";

    switch (showWhat)
    {
        case "MEMBERSTODAY":
            sqlSelect = "SELECT * FROM pb WHERE is_deleted=0 AND wanum_valid=1 AND DATEPART(d, birth_date) = DATEPART(d, @0) AND DATEPART(m, birth_date) = DATEPART(m, @0)  ";
            repTitle = repTitle + "מציג חברים שחוגגים היום ";
            msgTemplateType = "BIRTHDAYMEMBERS";
            reachout_type = "BDAY";
            exportAction = "ExportBirthdaysList";
            break;

        case "MEMBERANNIVERSARY":
            sqlSelect = "SELECT pb.* FROM pb JOIN u_stats ON pb.m_id=u_stats.serial WHERE pb.is_deleted=0 AND pb.wanum_valid=1 AND DATEPART(d, u_stats.first_order_ts) = DATEPART(d, @0) AND DATEPART(m, u_stats.first_order_ts) = DATEPART(m, @0)  AND u_stats.first_order_ts<>CAST('1/1/1900' AS DATE)";
            repTitle = repTitle + "מציג חברים שהיום הוא יום השנה שלהם איתנו  ";
            msgTemplateType = "ANNIVERSARY";
            reachout_type = "ANN";
            exportAction = "ExportBirthdaysList";
            break;

        case "MEMBERSTHISMONTH":
            sqlSelect = "SELECT * FROM pb WHERE is_deleted=0 AND wanum_valid=1 AND DATEPART(m, birth_date) = DATEPART(m, @0)  AND CAST(birth_date AS DATE)<>'1/1/1900' ";
            repTitle = repTitle + "מציג חברים שחוגגים החודש " + "(" + ts.Month + ")";
            msgTemplateType = "BIRTHDAYMEMBERS";
            reachout_type = "BDAY";
            exportAction = "ExportBirthdaysList";
            break;

        case "PROSPECTSTODAY":
