@helper LiveStats()
{

    int u_id = WebSecurity.CurrentUserId;
    var m_join = Database.Open("m_join");
    var op_data = Database.Open("op_data");

    int orderCnt = 0;
    int newOrdersCnt = 0;
    int postponedOrdersCnt = 0;
    int contactCnt = 0;
    int prospectsCnt = 0;
    int WebProspectsCnt = 0;
    int approvedContacts = 0;
    int newMembersCount = 0;
    int allMembersCount = 0;
    string prospectsBgColor = "#fff";

    DataFunctions.ImportWebOrders();
    DataFunctions.ImportWebContactForm();
    DataFunctions.ImportWebProspects();
    DataFunctions.ImportOrderFeedBacks();

    var sqlSelect = "SELECT COUNT(*) AS the_cnt FROM webOrders WHERE is_deleted=0";
    var rs = op_data.QuerySingle(sqlSelect);
    try { orderCnt = rs.the_cnt; } catch { }


    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM webOrders WHERE is_processed=0 AND is_deleted=0";
    rs = op_data.QuerySingle(sqlSelect);
    try { newOrdersCnt = rs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM webOrders WHERE is_processed=1 AND is_postponed=1 AND is_deleted=0";
    rs = op_data.QuerySingle(sqlSelect);
    try { postponedOrdersCnt = rs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM ContactForm";
    rs = op_data.QuerySingle(sqlSelect);
    try { contactCnt = rs.the_cnt; } catch { }




    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM WebProspects";
    rs = op_data.QuerySingle(sqlSelect);
    try { WebProspectsCnt = rs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM WebProspects";
    rs = op_data.QuerySingle(sqlSelect);
    try { prospectsCnt = rs.the_cnt; } catch { }
    prospectsCnt = WebProspectsCnt + prospectsCnt;

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM pb WHERE is_new=1";
    rs = op_data.QuerySingle(sqlSelect);
    try { newMembersCount = rs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM pb WHERE is_deleted=0";
    rs = op_data.QuerySingle(sqlSelect);
    try { allMembersCount = rs.the_cnt; } catch { }

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM prospectsapprovals";
    rs = m_join.QuerySingle(sqlSelect);
    try { approvedContacts = rs.the_cnt; } catch { }

    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=3";
    var AfterNickWebProspects = op_data.QuerySingle(sqlSelect);
    int AfterNickWebProspectsCnt = 0; AfterNickWebProspectsCnt = AfterNickWebProspects.the_cnt;
    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=0";
    var NewWebProspects = op_data.QuerySingle(sqlSelect);
    int NewWebProspectCnt = 0; NewWebProspectCnt = NewWebProspects.the_cnt;

    int NewFeedbackCnt = 0; NewWebProspectCnt = NewWebProspects.the_cnt;

    sqlSelect = "SELECT COUNT(*) AS the_cnt FROM orderfeedback WHERE is_completed=0";
    rs = op_data.QuerySingle(sqlSelect);
    try { NewFeedbackCnt = rs.the_cnt; } catch { }


    <div>

        @if (newOrdersCnt > 0)
        {
            <div class="BarInfoBoxGoodAlert" onclick="PageNavigator('NEWORDERS')">
                <span style="float:right;padding-left:5px;">@newOrdersCnt</span> הזמנות חדשות
            </div>
        }
        else
        {
            <div class="BarInfoBox" onclick="PageNavigator('ORDERS')">
                <span style="float:right;padding-left:5px;">@orderCnt</span> הזמנות
                @if (postponedOrdersCnt > 0)
                {<span style="color:#57d600;font-size:11px;">@postponedOrdersCnt עתידיות</span>}
            </div>
        }
        <div class="BarInfoBox" onclick="PageNavigator('MEMBERS')">
            <span style="float:right;padding-left:5px;">@allMembersCount</span> חברים
        </div>
        @if (newMembersCount > 0)
        {
            <div class="BarInfoBoxGoodAlert" onclick="PageNavigator('NEWMEMBERS')">
                <span style="float:right;padding-left:5px;">@newMembersCount</span> חדשים
            </div>
        }

        <div class="BarInfoBox" onclick="PageNavigator('WEBPROSPECTS')" style="background-color:@prospectsBgColor">
            מצטרפים
            @if (NewWebProspectCnt > 0)
            {
                <span style="color:#57d600;font-size:11px;">@NewWebProspectCnt חדשים</span>
            }
            @if (AfterNickWebProspectsCnt > 0)
            {
                <span style="color:#f00;font-size:11px;">@AfterNickWebProspectsCnt לרישום</span>
            }

        </div>

        @if (contactCnt > 0)
        {
            <div class="BarInfoBox" style="background-color:yellow" onclick="PageNavigator('CONTACTFORM')"><span style="float:right;padding-left:5px;">@contactCnt</span>  יצירת קשר</div>
        }
        @if (NewFeedbackCnt > 0)
        {
            <div class="BarInfoBox" onclick="PageNavigator('FEEDBACKMANAGER')"><span style="float:right;padding-left:5px;">@NewFeedbackCnt</span>  משובים</div>
        }


        <button type="button" onclick="refreshCurrentView();" style="display:none">asd</button>
    </div>


    m_join.Close();

    op_data.Close();

}

@helper EditWebOrder(int order_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    int u_id = WebSecurity.CurrentUserId;
    //var m_join = Database.Open("m_join");
    var op_data = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM webOrders WHERE serial=@0";
    var order = op_data.QuerySingle(sqlSelect, order_id);
    int member_id = 0; try { member_id = order.m_id; } catch { }
    sqlSelect = "SELECT id,title FROM menus WHERE is_active=1 ORDER BY sort_order";
    var menus = op_data.Query(sqlSelect);
    DateTime LocalTime = AppFunctions.LocalTime();

    DateTime Tommorow = LocalTime.AddDays(1);
    DateTime AfterTommorow = LocalTime.AddDays(2);

    string other_rec_display_state = "none";
    bool is_ship_phone = false;
    try { is_ship_phone = order.is_ship_phone; } catch { }
    if (is_ship_phone) { other_rec_display_state = "block"; }

    bool is_postponed = false; try { is_postponed = order.is_postponed; } catch { }
    string roundDivDisplayState = "block;";
    string FutShipDivDisplayState = "none;";
    if (is_postponed)
    {
        roundDivDisplayState = "none;";
        FutShipDivDisplayState = "block;";
    }
    string shipping_date_str = ""; try { shipping_date_str = order.shipping_date.ToString("yyyy-MM-dd"); } catch { }
    <div style="overflow:auto;direction:rtl">
        <form id="repEditOrder">
            <h2>עריכת פרטי הזמנה</h2>

            <div style="overflow:auto;" id="NewOrderMemberContainer">
                @AppHelpers.SelectOrderMember(member_id, order.wanum, order.nick_name)
            </div>
            <div style="overflow:auto;margin-top:10px;margin-bottom:10px;">
                <input type="checkbox" name="is_for_today" style="padding:5px;margin-left:5px;" @if (!is_postponed) { <text> checked</text>} onclick="if (this.checked) { hideElement('future_shipment_div'); showElement('round_select_div'); } else { hideElement('round_select_div'); showElement('future_shipment_div'); } FixAccordion('editOrderAcc'); " />
                הזמנה להיום?
            </div>
            <div style="overflow: auto;  font-size: 14px; color: #b200ff;display:@roundDivDisplayState" id="round_select_div">
                סבב חלוקה:<br />
                <select style="padding:5px;margin:5px;font-size:16px" name="round_id">
                    <option>בבקשה לבחור..</option>
                    @foreach (var round in menus)
                    {
                        <option value="@round.id" @if (order.menu_id == round.id) { <text> selected </text> }>@round.title</option>
                    }

                </select>
            </div>

            <div style="overflow:auto;display:@FutShipDivDisplayState" id="future_shipment_div">
                <div style="overflow:auto;">
                    תאריך לקבלת המשלוח<br />

                    <input type="date" style="padding:5px;margin:5px;font-size:16px;" name="shipping_date" id="shipping_date" value="@shipping_date_str" />
                </div>
                <div style="overflow:auto;">
                    זמן מועדף לקבלת המשלוח
                    <br />
                    <input type="time" style="padding:5px;margin:5px;font-size:16px;" name="shipping_time" id="shipping_time" value="@order.shipping_time" />
                </div>
            </div>


            <div style="overflow:auto;font-size:14px;color:#b200ff">
                <input type="checkbox" name="is_ship_phone" style="padding:5px;margin:5px;float:right" @if (is_ship_phone) { <text> checked</text>} onclick="if (this.checked) { showElement('other_recipient_div'); } else { hideElement('other_recipient_div'); } FixAccordion('editOrderAcc');" />
                משלוח לאדם אחר?
            </div>

            <div style="overflow:auto;display:@other_rec_display_state" id="other_recipient_div">
                <div style="overflow:auto;font-size:14px;color:#b200ff">
                    שם מקבל.ת המשלוח:<br />
                    <input type="text" style="padding:5px;margin:5px;font-size:16px" name="ship_name" value="@order.ship_name" />
                </div>
                <div style="overflow:auto;font-size:14px;color:#b200ff">
