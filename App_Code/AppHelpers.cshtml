                    <input type="text" style="padding:5px;margin:5px;font-size:16px" name="ship_phone" value="@order.ship_phone" />
                </div>
            </div>

            <div style="overflow:auto;font-size:14px;color:#b200ff">
                כתובת:<br />
                <input type="text" style="padding:5px;margin:5px;font-size:16px" name="address" value="@order.address" />
            </div>
            <div style="overflow:auto;font-size:14px;color:#b200ff">
                עיר:<br />
                <input type="text" style="padding:5px;margin:5px;font-size:16px" name="city" value="@order.city" />
            </div>
            <div style="overflow:auto;font-size:14px;color:#b200ff">
                פירוט הזמנה:<br />
                <textarea style="padding:5px;margin:5px;font-size:16px;resize:none;width:50%" rows="6" name="order_body">@order.orderbody</textarea>

            </div>
            <div style="overflow: auto; padding: 5px; margin: 5px;text-align:center">

                <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="Accordionize('editOrderAcc');">ביטול</button>
                <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="AjaxActions('UpdateOrderInfo','@order.serial','','repEditOrder','@order.serial');">שמירת שינויים</button>
            </div>
        </form>
        <div style="overflow:auto;height:100px">&nbsp;</div>
    </div>


    // m_join.Close();

    op_data.Close();

