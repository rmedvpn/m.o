@functions {
    public static string VendorPaymentAction()
    {
        DateTime local_time = AppFunctions.LocalTime();
        int order_id = 0;
        int vendor_id = 0;
        try { vendor_id = Convert.ToInt32(Request["value"]); } catch { }
        int reqAction = 0; try { reqAction = Convert.ToInt32(Request["reqAction"]); } catch { }
        string theHtmlOutput = "";
        string logMsg = "";
        int rep_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "";
        string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);


        if (vendor_id == 0) { theHtmlOutput = "חובה לבחור ספק לפעולה!<br>"; }

        if (theHtmlOutput == "")
        {
            switch (reqAction)
            {

                case 0:
                    theHtmlOutput += "חובה לבחור פעולה מבוקשת!<br>";

                    break;

                case 1:
                    if (true)
                    {
                        decimal amount = 0; try { amount = Convert.ToDecimal(Request["payment_amount"]); } catch { }
