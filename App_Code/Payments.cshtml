@helper PaymentsAdmin(int vendor_id = 0,int dep_id=0)
{
    if (!WebSecurity.IsAuthenticated) { Response.Redirect("~/"); }


    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT vendor_id,vendor_name FROM vendors WHERE is_active=1";
    var Vendors = db.Query(sqlSelect);
    string srchTitle = " תשלומי ספקים";

    string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);
    <div style="overflow: auto; padding: 5px; direction: rtl">
        <div id="CreditStatusDiv">
            @Payments.PaymentsStatus(vendor_id)
        </div>


        <h2 style="float:right;direction:rtl">
            <span onclick="RepAjaxUpdate('PAYMENTS', 'MainBoardContainer', 'MainLoader', -1);">⚙️</span>
            <span onclick="RepAjaxUpdate('PAYMENTS', 'MainBoardContainer', 'MainLoader', 0);">🏠</span>
            @srchTitle
        </h2>
        <select style="padding:5px;margin:5px;font-size:16px;float:right;margin-right:20px;" onchange="RepAjaxUpdate('PAYMENTS', 'MainBoardContainer', 'MainLoader', this.value);">
            <option value="0">כל הספקים</option>
            @foreach (var vendor in Vendors)
            {
                <option value="@vendor.vendor_id" @if (vendor.vendor_id == vendor_id) { <text> selected</text>}>@vendor.vendor_name</option>
            }


        </select>
    </div>
    <button class="Accordion" style="display:none" id="CreditActionsAcc"></button>
    <div class="panel" style="padding:0;margin:0">
        <div style="overflow:auto;background-color:#e3e3e3;width:99%;float:right" id="NewOrderMemberContainer">
            @Payments.VendorPaymentActions(vendor_id)
        </div>
    </div>


    if (vendor_id > 0)
    {
        <div style="overflow: auto;text-align:right;direction:rtl;">
            @Payments.VendorPaymentsStatus(vendor_id)
        </div>

    }
    else
    {
        if (vendor_id == 0)
        {
            <div style="overflow: auto;text-align:right;direction:rtl;">
                @Payments.VendorPaymentsSummary()
            </div>
            <div style="overflow: auto;text-align:right;direction:rtl;">
                @Payments.DepositoriesSummary()
            </div>

        }

        if (vendor_id == -1)
        {
            <div style="overflow: auto;text-align:right;direction:rtl;">
                @Payments.Depositories()
            </div>

        }
        if (vendor_id == -2)
        {
            <div style="overflow: auto;text-align:right;direction:rtl;">
                @Payments.DepositoryLog(dep_id)
            </div>

        }
    }



    <div class="A" style="height:150px;">&nbsp;</div>


    db.Close();
}

@helper PaymentsStatus(int vendor_id = 0)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;
    DateTime default_date = Convert.ToDateTime("1/1/1900");
    sqlSelect = "SELECT SUM(amount_due) as TotalDebt FROM vendorpayments WHERE is_paid=0";
    if (vendor_id > 0) { sqlSelect += " AND vendor_id=@0"; }
    var totDebt = op_data.QuerySingle(sqlSelect, vendor_id);
    decimal totalDebt = 0; try { totalDebt = totDebt.TotalDebt; } catch { }
    sqlSelect = "SELECT SUM(amount_due) as DueDebt FROM vendorpayments WHERE is_paid=0 AND current_due_date<=@0";
    if (vendor_id > 0) { sqlSelect += " AND vendor_id=@1"; }

    var dueDebt = op_data.QuerySingle(sqlSelect, local_time, vendor_id);
    decimal DueDebt = 0; try { DueDebt = dueDebt.DueDebt; } catch { }
    string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);

    <div style="float: left; padding: 5px; margin: 5px; font-size: 12px; border: 2px solid #808080; text-align: center; border-radius: 5px ">
        <span style="font-size:18px;">@totalDebt.ToString("C", culture)</span><br />סה"כ חוב @vendor_name
    </div>
    <div style="float: left; padding: 5px; margin: 5px; font-size: 12px; border: 2px solid #808080; text-align: center; border-radius: 5px;background-color:#e3e3e3 " onclick="Accordionize('CreditActionsAcc')">
        <span style="font-size:18px;">פעולות</span><br />חיוב / זיכוי
    </div>

    op_data.Close();

}

@helper VendorPaymentsStatus(int vendor_id, string showWhat = "ALL")
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;
    DateTime default_date = Convert.ToDateTime("1/1/1900");
    string vendor_name = "";
    string pageTitle = "";

    //DataFunctions.ImportWebContactForm();

    switch (showWhat)
    {
        case "ALL":
            sqlSelect = "SELECT * FROM VendorPayments WHERE (is_paid=0 OR is_paid=1) ";

            break;
        case "DUE":
            break;
        case "PAID":
            sqlSelect = "SELECT serial,m_id,member_name,debt,due_date FROM pb WHERE debt>0 AND due_date>@0 AND next_order_return=0 order by due_date";
            break;

    }
    if (vendor_id > 0)
    {
        sqlSelect += "AND vendor_id=@0 ORDER BY vendor_id,serial DESC";
        vendor_name = AppFunctions.GetVendorTitleById(vendor_id);
        pageTitle = "מצב חשבון לספק " + vendor_name;
    }
    else
    {
        sqlSelect += "ORDER BY vendor_id,serial DESC";

    }


    var Payments = op_data.Query(sqlSelect, vendor_id);

    <div class="A">
        <h2>@pageTitle</h2>
        <table style="width:99%;direction:rtl">
            <tr class="ListRow" style="width: 100%;">
                <td class="TableCell">Z</td>
                <td class="TableCell">תאריך</td>
                <td class="TableCell">תאור</td>
                <td class="TableCell">סכום חוב</td>

            </tr>

            @foreach (var entry in Payments)
            {

                <tr class="ListRow" id="CreditEntryRow_@entry.serial">
                    <td class="TableCell1">
                        @if (entry.z_serial > 0)
                        {@entry.z_serial}
                    else
                    {<span>-</span>}
                    </td>

                    <td class="TableCell1">@entry.z_date.ToShortDateString()</td>
                    <td class="TableCell1">
                        @entry.transaction_title
                        @if (entry.transaction_notes != "")
                        {
                            <br /><span class="PrplMiniTag">@entry.transaction_notes</span>
                        }
                    </td>

                    @if (entry.transaction_type == 1)
                    {
                        <td class="TableCell1" style="color:#ff0000">@entry.amount.ToString("C", culture)</td>
                    }
                    @if (entry.transaction_type == 2)
                    {
                        <td class="TableCell1" style="color:#57d600">@entry.amount.ToString("C", culture)-</td>
                    }


                </tr>





            }
        </table>
    </div>

    op_data.Close();

}


