    public static string DepositoryAction()
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

        DateTime local_time = AppFunctions.LocalTime();
        string reqAction= Request["reqAction"];
        string action_pw = Request["action_pw"];
        string action_note = Request["action_note"];
        string theHtmlOutput = "";
        string logMsg = "";
        int rep_id = WebSecurity.CurrentUserId;
        int depository_id = 0; try { depository_id = Convert.ToInt32(Request["depository_id"]); } catch { }
        decimal action_amount = 0; try { action_amount = Convert.ToDecimal(Request["action_amount"]); } catch { }
        string log_entry = "";
        var db = Database.Open("op_data");
        var sqlSelect = "";

        if (depository_id == 0)
        {
            theHtmlOutput += "!$!חובה לבחור קופה לפעולה!<br>";
        }
        else
        {
            if (reqAction == "delete")
            {
                string delPw = ""; try { delPw = AppFunctions.GetAppProperty("DepositoryDelPw"); } catch { }
                if (delPw != action_pw)
                {
                    theHtmlOutput += "סיסמא שגויה!<br>";
                }
                else
                {
                    sqlSelect = "SELECT depository_amount FROM depositories WHERE serial=@0";
                    var delChk = db.QuerySingle(sqlSelect, depository_id);
                    if (delChk != null)
                    {
                        if (delChk.depository_amount != 0)
                        {
                            theHtmlOutput += "לא ניתן למחוק קופה שיש בה יתרה!<br>";
                        }

                    }

                }

                if (theHtmlOutput == "")
                {
                    sqlSelect = "UPDATE depositories SET is_deleted=1,is_active=0,delete_ts=@0,is_update=1,deleted_by=@1 WHERE serial=@2";
                    db.Execute(sqlSelect, local_time, rep_id, depository_id);
                    logMsg = "הקופה נמחקה!";
                    sqlSelect = "INSERT INTO DepositoryLog(depository_id,rep_id,entry,timestamp,amount) VALUES(@0,@1,@2,@3,@4)";
                    db.Execute(sqlSelect, depository_id, rep_id, logMsg, local_time, action_amount);
                    theHtmlOutput = logMsg;
                }
                else
                {
                    theHtmlOutput = "!$!" + theHtmlOutput;
                }

            }
            else
            {
                if (action_amount <= 0)
                {
                    theHtmlOutput += "נא להזין סכום תקין!<br>";

                }
                if (action_note == "")
                {
                    theHtmlOutput += "חובה להזין הערה לפעולה!<br>";
                }

                if (theHtmlOutput == "")
                {
                    if(reqAction== "withdrawal")
                    {

                        sqlSelect = "SELECT depository_amount FROM depositories WHERE serial=@0";
                        var balanceChk = db.QuerySingle(sqlSelect, depository_id);
                        if (balanceChk != null)
                        {
                            if(balanceChk.depository_amount < action_amount)
                            {
                                theHtmlOutput += "לא ניתן למשוך מעל "+ balanceChk.depository_amount.ToString("C",culture) + "!<br>";
                                theHtmlOutput = "!$!" + theHtmlOutput;

                            }
                            action_amount = action_amount * -1;
                        }


                    }
                    if (theHtmlOutput == "")
                    {
                        sqlSelect = "UPDATE depositories SET is_update=1,depository_amount=depository_amount+@0 WHERE serial=@1";
                        db.Execute(sqlSelect, action_amount, depository_id);

                        sqlSelect = "INSERT INTO DepositoryLog(depository_id,rep_id,entry,timestamp,amount) VALUES(@0,@1,@2,@3,@4)";
                        db.Execute(sqlSelect, depository_id, rep_id, action_note, local_time, action_amount);
                        theHtmlOutput =  "הפעולה נרשמה!";
                    }
                }
                else
                {
                    theHtmlOutput = "!$!" + theHtmlOutput;
                }

            }

        }


        db.Close();

        return theHtmlOutput;
    }

    public static void ApplyVendorPayment(int vendor_id)
    {
        DateTime local_time = AppFunctions.LocalTime();
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "";

        sqlSelect = "SELECT * FROM vendorpayments WHERE transaction_type=2 AND is_paid=0 AND vendor_id=@0 ORDER BY serial";
        var PaymentsToApply = db.Query(sqlSelect, vendor_id);
        foreach (var payment in PaymentsToApply)
        {
            decimal payment_amount = payment.amount_due * -1;
            sqlSelect = "SELECT serial,amount_due FROM vendorpayments WHERE transaction_type=1 AND is_paid=0 AND vendor_id=@0 ORDER BY serial";
            var DebtsToPay = db.Query(sqlSelect, vendor_id);
            foreach (var debt in DebtsToPay)
            {
                bool is_paid = true;
                decimal debt_amount = debt.amount_due;

                if (payment_amount >= debt_amount)
                {

                    payment_amount = payment_amount - debt_amount;
                    debt_amount = 0;

                }
                else
                {

                    is_paid = false;
                    debt_amount = debt_amount - payment_amount;
                    payment_amount = 0;

                }
                sqlSelect = "UPDATE vendorpayments SET payment_ts=@0,marked_paid_by=@1,amount_due=@2,is_paid=@3 WHERE serial=@4";
                db.Execute(sqlSelect, local_time, rep_id, debt_amount, is_paid, debt.serial);


            }

            var no_balance = false;
            if (payment_amount == 0)
            {
                no_balance = true;
            }

            sqlSelect = "UPDATE vendorpayments SET payment_ts=@0,marked_paid_by=@1,amount_due=@2,is_paid=@3 WHERE serial=@4";
            db.Execute(sqlSelect, local_time, rep_id, payment_amount * -1, no_balance, payment.serial);

            decimal vendor_debt = Payments.VendorDebt(vendor_id);
            sqlSelect = "UPDATE vendors SET debt=@0 WHERE vendor_id=@1";
            db.Execute(sqlSelect, vendor_debt, vendor_id);
            DataFunctions.WriteDebugLine("vendor_debt " + vendor_debt);
        }

        db.Close();

    }

