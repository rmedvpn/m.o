@helper SpecialOffersBlock(int round_id, int spOffer_OfferType, int order_id = 0, string offer_type = "NONE", decimal charity_max = 0)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    int u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";

    bool is_free_charity = false;
    bool is_paid_charity = false;
    bool is_charity = false;

    switch (offer_type)
    {
        case "NONE":
            break;
        case "PAIDCHARITY":
            is_paid_charity = true;
            is_charity = true;
            break;
        case "FREECHARITY":
            is_free_charity = true;
            is_charity = true;
            break;
    }

    if (charity_max == 0)
    {
        sqlSelect = "SELECT * FROM SpecialOffers JOIN SpOfferRoundsAvailability ON SpecialOffers.id=SpOfferRoundsAvailability.specialOfferId WHERE SpOfferRoundsAvailability.round_id=@0  AND SpecialOffers.is_deleted=0 AND SpecialOffers.spOfferType=@1";
    }
    else
    {
        sqlSelect = "SELECT * FROM SpecialOffers JOIN SpOfferRoundsAvailability ON SpecialOffers.id=SpOfferRoundsAvailability.specialOfferId WHERE SpOfferRoundsAvailability.round_id=@0  AND SpecialOffers.is_deleted=0 AND SpecialOffers.spOfferType=@1 AND SpecialOffers.price<=@2";
    }
    var spOffers = db.Query(sqlSelect, round_id, spOffer_OfferType, charity_max);
    if (spOffers.Count() > 0)
    {

        sqlSelect = "SELECT * FROM SpOfferTypes WHERE id=@0";
        var spOfferType = db.QuerySingle(sqlSelect, spOffer_OfferType);
        string offerTypeTitle = spOfferType.title;
        string offerPricingTxt = "";
        string offerTypeHeaderIcon = spOfferType.HeaderIcon;



        bool is_first_row = true;
        <div style="overflow: auto;background-color: #000;color: #fff;font-size: 22px;font-weight: bold;padding: 5px;" onclick="Accordionize('spOfferCatAcc_@spOffer_OfferType'); ">@offerTypeHeaderIcon @offerTypeTitle <span style="float: left;font-size: 12px;">(@spOffers.Count())</span></div>
        <button class="Accordion" style="display: none" id="spOfferCatAcc_@spOffer_OfferType"></button>
        <div class="panel2" style="padding: 0;margin: 0">
            <div style="overflow: auto;font-size: 16px;color: #000;">

                @foreach (var spOffer in spOffers)
                {
                    <div class="A" id="spOfferEntry_@spOffer.id">
                        @Order.RoundSpecialOfferEntry(spOffer, round_id, order_id, offer_type)
                    </div>

                }
            </div>
        </div>
    }

    db.Close();
}

@helper RoundSpecialOfferEntry(dynamic spOffer, int round_id, int order_id = 0, string offer_type = "NONE")
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    bool is_charity = false;
    bool is_free_charity = false;
    bool is_paid_charity = false;

    switch (offer_type)
    {
        case "NONE":
            break;
        case "PAIDCHARITY":
            is_paid_charity = true;
            is_charity = true;
            break;
        case "FREECHARITY":
            is_free_charity = true;
            is_charity = true;
            break;
    }

    int u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";
    int member_id = 0;
    sqlSelect = "SELECT u_id FROM MainOrders WHERE order_id=@0";
    var theOrder = db.QuerySingle(sqlSelect, order_id);
    try { member_id = theOrder.u_id; } catch { }

    sqlSelect = "SELECT * FROM SpOfferTypes WHERE id=@0";
    var spOfferType = db.QuerySingle(sqlSelect, spOffer.spOfferType);
    string offerTypeTitle = spOfferType.title;
    string offerPricingTxt = "";
    string offerTypeHeaderIcon = spOfferType.HeaderIcon;
    string offerBgColor = "#fff";

    switch (offer_type)
    {
        case "NONE":
            offerPricingTxt = " מחיר מבצע רק " + spOffer.price.ToString("C", culture);
            break;
        case "PAIDCHARITY":
            offerPricingTxt = " הקצאה במחיר עלות רק " + spOffer.price.ToString("C", culture);
            break;
        case "FREECHARITY":
            offerPricingTxt = " הקצאה ללא עלות בשווי ";
            break;

        case "VIP":
            offerPricingTxt = " הטבת VIP רק " + spOffer.price.ToString("C", culture);

            break;
    }
    offerPricingTxt = offerTypeHeaderIcon + offerPricingTxt;
    bool isSpOfferAvailable = true;
    //get all items of offer
    sqlSelect = "SELECT * FROM SpecialOffersItems WHERE spOffer_id=@0 ";
    var spOfferItems = db.Query(sqlSelect, spOffer.id);
    //check if all special offer items are available in this round
    foreach (var spOfferItem in spOfferItems)
    {
        if (spOfferItem.spItemType == 1)
        {
            sqlSelect = "SELECT Top(1) id FROM roundMenuItems WHERE SpOffersOk=1 AND p_id=@0 AND round_id=@1";
            var tmpRs = db.QuerySingle(sqlSelect, spOfferItem.p_id, round_id);
            if (tmpRs == null)
            {
                isSpOfferAvailable = false;
            }
        }
        if (spOfferItem.spItemType == 2)
        {
            sqlSelect = "SELECT Top(1) id FROM roundMenuItems WHERE SpOffersOk=1 AND spOfferCatId=@0 AND round_id=@1";
            var tmpRs = db.QuerySingle(sqlSelect, spOfferItem.spOfferCatId, round_id);
            if (tmpRs == null)
            {
                isSpOfferAvailable = false;
            }
        }

    }
    // isSpOfferAvailable = true;
    if (!isSpOfferAvailable)
    { offerBgColor = "#e3e3e3"; }

    sqlSelect = "SELECT COUNT(id) as the_cnt FROM MainCart WHERE item_id=-1 AND u_id=@0 AND order_id=@1 AND special_id=@2 AND rep_id=@3";
    var cntRs = db.QuerySingle(sqlSelect, member_id, order_id, spOffer.id, u_id);
    int cartCnt = 0;
    try { cartCnt = cntRs.the_cnt; } catch { }



    <div style="overflow: auto;margin-bottom: 5px;border-bottom: 2px solid #000;background-color: @offerBgColor">
        <div style="padding: 0;margin: 0;overflow:auto;">
            <div style="overflow: auto;padding: 5px;">
                <div style="overflow: auto; font-size: 18px; ">
                    @if (isSpOfferAvailable)
                    {
                        <div style="float: left;">
                            <button style="float: left;margin-left: 5px;font-size: 16px;background-color: #fff;border: 0" onclick="RepAjaxUpdate('PopulateSpOffer','spOfferAdd_@spOffer.id','spOfferLoader_@spOffer.id',@spOffer.id,@round_id,'@offer_type',@order_id,@spOffer.spOfferType)">➕</button>
                            <div class="spinner" style="display: none;float: left" id="spOfferLoader_@spOffer.id">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>


                        </div>
                    }
                    else
                    {
                        <div style="float: left;">
                            <span class="RedMiniTag">חלק ממוצרי המבצע חסרים בתפריט!</span>


                        </div>
                    }
                    <b><u>@spOffer.Title</u></b>
                </div>
                <div style="overflow: auto" id="spOfferInfo_@spOffer.id">
                    <div style="overflow: auto;"><span style="font-size: 12px;color: #b200ff">כולל</span></div>
                    @foreach (var spOfferItem in spOfferItems)
                    {
                        if (spOfferItem.spItemType == 2)
                        {
                            <div style="overflow: auto;"><b>@spOfferItem.quan @spOfferItem.itemunit</b> לבחירה מקטגורית <b>@NewAppFunctions.GetTitleById("Cat", spOfferItem.main_cat_id) @spOfferItem.title </b></div>
                        }
                        if (spOfferItem.spItemType == 1)
                        {
                            <div style="overflow: auto;"><b>@spOfferItem.quan @spOfferItem.itemunit</b> מוצר #@spOfferItem.p_id <b>@spOfferItem.title</b> </div>
                        }
                    }
                    <div style="overflow: auto">

                        <div style="text-align: right;padding: 5px;margin: 5px;font-size: 16px;overflow: auto">

                            <div style="color: #808080;overflow: auto">
                                @offerPricingTxt
                                @if (is_free_charity)
                                {
                                    <span style="text-decoration: line-through;">@spOffer.price.ToString("C", culture)</span>
                                }

                            </div>
                            @if (cartCnt > 0)
                            {
                                sqlSelect = "SELECT * FROM MainCart Where item_id=-1 AND u_id=@0 AND order_id=@1 AND rep_id=@2 AND special_id=@3";
                                var spOffersInCart = db.Query(sqlSelect, member_id, order_id, u_id, spOffer.id);
                                <div style="color: #b200ff;overflow: auto">
                                    ✅ @cartCnt יח @spOffer.Title ברשימה
                                    <button style="float: left;padding: 3px;margin: 3px;font-size: 12px;color: #fff;background-color: #808080" onclick="Accordionize('spOfferDetailsAcc_@spOffer.id');FixAccordion('spOfferCatAcc_@spOfferType.id');">פרטים</button>
                                </div>
                                <div>
                                    <button class="Accordion" style="display: none" id="spOfferDetailsAcc_@spOffer.id"></button>
                                    <div class="panel" style="padding: 0;margin: 0">
                                        @foreach (var offer in spOffersInCart)
                                        {
                                            decimal calc_price = offer.quan * offer.price;
                                            if (offer.isQuanByOption)
                                            {
                                                calc_price = offer.calc_price;
                                            }

                                            var bundleSql = "SELECT * FROM mainCart WHERE item_id=-2 AND special_id=@0 AND group_ts=@1 AND order_id=@2 AND rep_id=@3";
                                            var bundleItems = db.Query(bundleSql, spOffer.id, offer.group_ts, order_id, u_id);
                                            <div style="overflow: auto;border: 1px dashed #000;border-radius: 5px;margin: 1px;">
                                                <div style="font-size: 16px;text-align: right;overflow: auto;color: #000">
                                                    <div style="float: right;margin-right: 5px;">
                                                        <div style="overflow: auto;"><b>@offer.title</b> <span style="font-size: 12px;color: #808080">כולל</span></div>
                                                    </div>
                                                    <button style="float: left;padding: 3px;margin: 3px;font-size: 12px;color: #fff;background-color: #f00" id="spOfferItemRemoveBtn_@offer.id" onclick="hideElement('spOfferItemRemoveBtn_@offer.id');AjaxActions('RemoveSpecialOffer','@spOffer.id','MainLoader','@offer.id','@round_id','@offer_type','@order_id');">הסרה</button>
                                                </div>
                                                <div style="overflow: auto;">
                                                    @foreach (var bundle_item in bundleItems)
                                                    {
                                                        <div style="overflow: auto;color: #000;;margin-right: 5px;">
                                                            <div style="font-size: 16px;text-align: right;">
                                                                <img style="width:25px;height: 25px;border-radius: 5px;float: right;margin-top: 5px;" src="ImgViewer?size=tn&p_id=@bundle_item.p_id" alt="@bundle_item.title">
                                                                <div style="float: right;margin-right: 5px;">
                                                                    <div style="overflow: auto;">@bundle_item.quan @bundle_item.itemunit @bundle_item.title</div>
                                                                    <div style="overflow: auto;font-size: 12px;color: #808080">מוצר #@bundle_item.p_id</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                @if (offer.is_free_charity)
                                                {
                                                    <span style="float: left;padding-left: 15px;color: #b200ff;font-size: 14px;font-weight: bold"><span style="text-decoration: line-through;font-size: 16px;color: #000;">@calc_price.ToString("C", culture)</span><br> <span style="float: left">הקצאה ללא עלות</span></span>
                                                }
                                                else
                                                {
                                                    <span style="font-size: 16px;float: left;padding-left: 15px;color: #000;font-weight: bold">@calc_price.ToString("C", culture)</span>
                                                }




                                            </div>

                                        }
                                    </div>
                                </div>
                            }

                        </div>



                    </div>
                </div>

                <div style="overflow: auto" id="spOfferAdd_@spOffer.id"></div>

            </div>
        </div>
    </div>
    db.Close();
}

