@helper EditPaymentInfo(dynamic order_info)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
int order_id = order_info.order_id;
var db = Database.Open("op_data");
var sqlSelect = "";
int u_id = WebSecurity.CurrentUserId;
int round_id = 0;
int member_id = 0;
int rep_id = 0; rep_id = u_id;

int payment_method = order_info.payment_method;

try { round_id = order_info.round_id; } catch { }
try { member_id = order_info.u_id; } catch { }
DateTime local_time = AppFunctions.LocalTime();
sqlSelect = "SELECT * FROM pb WHERE m_id=@0";
var UserInfo = db.QuerySingle(sqlSelect, member_id);

decimal debt = 0; try { debt = UserInfo.debt; } catch { }
bool is_credit_blocked = false; try { is_credit_blocked = UserInfo.is_credit_blocked; } catch { }
decimal member_credit_limit = 0; try { member_credit_limit = UserInfo.credit_limit; } catch { }
decimal member_current_limit = 0; try { member_current_limit = member_credit_limit - debt; } catch { }
decimal past_due_amount = 0; try { past_due_amount = MoneyFunctions.GetMemberDebt(member_id); } catch { }
DateTime due_date = local_time; try { due_date = UserInfo.due_date; } catch { }
DateTime defDueDate = due_date.AddDays(14);

bool is_credit = false; try { is_credit = order_info.is_credit; } catch { }
bool is_paying_debt = false; try { is_paying_debt = order_info.is_paying_debt; } catch { }
bool is_donate = false; try { is_donate = order_info.is_donate; } catch { }
bool is_refund = false; try { is_refund = order_info.is_refund; } catch { }
decimal credit_amount = 0; try { credit_amount = order_info.credit_amount; } catch { }
decimal charge_amount = 0; try { charge_amount = order_info.charge_amount; } catch { }
decimal return_amount = 0; try { return_amount = order_info.return_amount; } catch { }
decimal donate_amount = 0; try { donate_amount = order_info.donate_amount; } catch { }
decimal refund_amount = 0; try { refund_amount = order_info.refund_amount; } catch { }
decimal grand_total = 0; try { grand_total = order_info.grand_total; } catch { }
decimal CreditCouponsTotal = 0; try { CreditCouponsTotal = order_info.CreditCouponsTotal; } catch { }
decimal max_credit_order = member_current_limit;
int credit_transaction_id = 0; try { credit_transaction_id = order_info.credit_transaction_id; } catch { }
bool is_cost_charge = false; try { is_cost_charge = order_info.is_cost_charge; } catch { }
decimal total_cost_charge = 0; try { total_cost_charge = order_info.total_cost_charge; } catch { }
bool is_total_roundup = false; try { is_total_roundup = order_info.is_total_roundup; } catch { }
decimal after_roundup_total = 0; try { after_roundup_total = order_info.after_roundup_total; } catch { }
decimal roundup_amount = 0; try { roundup_amount = order_info.roundup_amount; } catch { }
decimal roundup_to = 0; try { roundup_to = order_info.roundup_to; } catch { }
bool is_donate_roundup = false; try { is_donate_roundup = order_info.is_donate_roundup; } catch { }
bool is_charge_waived = false; try { is_charge_waived = order_info.is_charge_waived; } catch { }
string charge_waive_note = ""; try { charge_waive_note = order_info.charge_waive_note; } catch { }
string refund_notes = ""; try { refund_notes = order_info.refund_notes; } catch { }
decimal waived_charge_sh = 0; try { waived_charge_sh = order_info.waived_charge_sh; } catch { }
decimal actual_pickup_amount = 0; try { actual_pickup_amount = order_info.actual_pickup_amount; } catch { }
decimal MoneyVouchersTotal = 0; try { MoneyVouchersTotal = order_info.MoneyVouchersTotal; } catch { }
bool DisableMoneyVouchers = false; try { DisableMoneyVouchers = order_info.DisableMoneyVouchers; } catch { }

int past_due_days = 0;
bool is_credit_past_due = false;
int credit_days = 0;
DateTime credit_return_date = local_time.AddDays(14);
string CashPaymentDivDisplayState = "none;";
string CreditPaymentDivDisplayState = "none;";
string ChargePaymentDivDisplayState = "none;";
string PaymentWaveDivDisplayState = "none;";
string RefundAmountDivDisplayState = "none;";
string roundup_settings_DivDisplayState = "none;";
string is_sh_charge_disabled = "disabled";
decimal amount_due = grand_total - CreditCouponsTotal;
decimal money_vouchers_available_balance = 0;
money_vouchers_available_balance = MoneyFunctions.GetMemberAvailableMoneyVouchersBalance(member_id);

if (is_total_roundup)
{
    roundup_settings_DivDisplayState = "block;";
}
if (waived_charge_sh > 0)
{
    is_sh_charge_disabled = "";

}
if (is_charge_waived)
{
    amount_due = waived_charge_sh;
}

int order_status = order_info.order_status;

bool debt_bypass = order_info.debt_bypass;

string mandatory_debt_disabler = "";

if (is_cost_charge)
{
    grand_total = total_cost_charge;
    amount_due = total_cost_charge - CreditCouponsTotal;
}

if (member_current_limit < 0) { member_current_limit = 0; }
if (max_credit_order > grand_total)
{
    max_credit_order = grand_total;
}

sqlSelect = "SELECT * FROM ChargeAccounts WHERE is_private=0 OR belongs_to=@0 ORDER BY belongs_to DESC";
var chargeAccounts = db.Query(sqlSelect, member_id);






//  try { is_credit = UserInfo.is_credit; } catch { }

if (past_due_amount > 0)
{
    is_credit_past_due = true;
    past_due_days = Convert.ToInt32((local_time - due_date).TotalDays);
    if (!debt_bypass) { mandatory_debt_disabler = "disabled"; }

}


try { credit_days = UserInfo.credit_days; } catch { }


if (grand_total < member_current_limit)
{
    max_credit_order = grand_total;
}

try { credit_return_date = order_info.credit_return_date; } catch { }


switch (payment_method)
{
    case 1:
        CashPaymentDivDisplayState = "block;";
        break;
    case 2:
        CreditPaymentDivDisplayState = "block;";
        break;
    case 3:
        ChargePaymentDivDisplayState = "block;";
        break;
    case 4:
        PaymentWaveDivDisplayState = "block;";
        break;
}

if (refund_amount > 0 || is_refund)
{
    RefundAmountDivDisplayState = "block;";
}



    <div class="A" style="color:#000">
