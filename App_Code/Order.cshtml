                                                                                    <div class="cartItemSubTitle">


                                                                                    </div>
                                                                                </div>

                                                                            </div>

                                                                        </div>

                                                                    </div>
                                                                }
                                                            </div>



                                                        }
                                                    </div>
                                                </div>



                                            </div>



                                        }
                                    </div>
                                </div>

                                <div class="B">
                                    <button type="button" class="A" style="float:left" onclick="AjaxActions('ORDERACTION',@order_id, 'MainLoader', 'TRANSFERORDER', document.getElementById('dest_round_id').value);">העברה</button>
                                </div>
                            </div>
                        }



                    </div>

                </div>

            </div>
        </form>
    </div>



    db.Close();
}

