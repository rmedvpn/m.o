    int round_id = 0;
    bool is_available_coupons = false;

    try { member_id = order.u_id; } catch { }
    try { round_id = order.round_id; } catch { }
    sqlSelect = "SELECT * FROM coupons WHERE is_active=1";
    sqlSelect = "SELECT coupons.* FROM coupons INNER JOIN memberCoupons ON coupons.coupon_id=memberCoupons.coupon_id WHERE coupons.is_active=1 AND (memberCoupons.round_id=0 OR memberCoupons.round_id=@0) AND (memberCoupons.member_id=0 OR memberCoupons.member_id=@1)";
