    sqlSelect = "SELECT * FROM MainCart WHERE (item_id=-5 OR item_id<-6) AND item_id>-11 AND u_id=@0 AND round_id=@1 AND rep_id=@2 AND order_id=@3";
    var couponsInCart = db.Query(sqlSelect, order.u_id, order.round_id, u_id, order_id); ;

    string couponsStr = "";
    string couponsStr2 = "";
    int arrIndex = 0;
    string lineSep = "@@";
    string itemSep = "$";
    foreach (var coupon in coupons)
    {
        couponsStr += coupon.coupon_id.ToString() + itemSep + Coupons.OrderCouponAvailability(order_id, coupon.coupon_id) + lineSep;
    }
    string[] couponsArr = couponsStr.Split(lineSep.ToCharArray());


