                                {
                                    <span class="MiniTag" style="cursor:pointer" onclick="AjaxActions('RemoveCouponFromCart','@order_id','MainLoader', 'CREDIT','@CreditCoupon.special_id','@CreditCoupon.id');">🗑️</span>
                                }
                                @CreditCoupon.title <span style="font-size:11px">(זיכוי #@CreditCoupon.special_id)</span><span style="float: left;padding-left: 10px">-@CreditCoupon.price.ToString("C", culture)</span>
                            </div>
                        }
                    }




                    @if (returning_amount > 0)
                    {
                        <div style="overflow: auto;font-size:14px;">

                            החזר חוב <span style="float: left;padding-left: 10px">@returning_amount.ToString("C", culture)</span>
                        </div>
                    }

                    @if (donate_amount > 0)
                    {
                        <div style="overflow: auto;font-size:14px;">

                            תרומה <span style="float: left;padding-left: 10px">@donate_amount.ToString("C", culture)</span>
                        </div>
                    }



                    @if (charge_amount > 0)
                    {
                        <div style="overflow: auto;">חיוב על חשבון <b>@charge_account_name</b><span style="float: left;padding-left: 10px"><b>-@charge_amount.ToString("C", culture)</b></span></div>
                    }

                    @if (credit_amount > 0)
                    {
                        if (next_order_return)
                        {
                            <div style="overflow: auto;">תשלום בקרדיט עד ההזמנה הבאה <span style="float: left;padding-left: 10px">-@credit_amount.ToString("C", culture)</span></div>
                        }
                        else
                        {
                            <div style="overflow: auto;">תשלום בקרדיט עד @credit_return_date.ToShortDateString() <span style="float: left;padding-left: 10px">-@credit_amount.ToString("C", culture)</span></div>
                        }

                    }


                    @if (is_charge_waived)
                    {
                        if (waived_charge_sh > 0)
                        {
                            <div style="overflow: auto;">
                                הזמנה בחיוב דמי משלוח בלבד <span class="PrplMiniTag">@charge_waive_note</span>
                                <span style="float: left;padding-left: 10px"><b>@waived_charge_sh.ToString("C", culture) </b></span>
                            </div>
                        }


                        else
                        {
                            <div style="overflow: auto;">
                                הזמנה ללא חיוב <span class="PrplMiniTag">@charge_waive_note</span>
                                <span style="float: left;padding-left: 10px"><b>ללא חיוב </b></span>
                            </div>
                        }


                    }

                    @if (MoneyVouchersTotal > 0)
                    {
                        <div style="overflow: auto;font-size:16px;">

                            <b>שובר זיכוי <span style="float: left;padding-left: 10px">@MoneyVouchersTotal.ToString("C", culture)</span></b>
                        </div>
                    }



                    @if (amount_to_be_collected != grand_total)
                    {
                        <div style="overflow: auto;">סה"כ יתרה לתשלום <span style="float: left;padding-left: 10px">👈<span style="background-color:yellow;border-radius:3px;"><b>@amount_to_be_collected.ToString("C", culture)</b></span></span></div>
                    }



                    @if (amount_to_be_collected != after_roundup_total && is_total_roundup && roundup_amount > 0)
                    {
                        <div style="overflow: auto;font-size:14px;">

                            עיגול אנטי עודף ל<span>@roundup_to.ToString("C", culture)</span>
