                                <input type="radio" name="payment_method" value="4" @if (payment_method == 4) { <Text> checked</text>} id="pmt_waived" onclick="if (this.checked) { hideElement('pmt_credit_div');hideElement('pmt_cash_div');hideElement('pmt_charge_div');showElement('pmt_waived_div'); }" /> ללא חיוב
