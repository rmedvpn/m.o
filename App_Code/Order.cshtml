    var db = Database.Open("op_data");
    var sqlSelect = "SELECT round_id FROM MainOrders WHERE order_id=@0";
    var order_data = db.QuerySingle(sqlSelect, order_id);
    int round_id = order_data.round_id;
    DateTime curDate = AppFunctions.LocalTime();
    int howManyDaysToCheck = 7;
    sqlSelect = "SELECT * FROM RoundsTimeTable WHERE round_id=@0";
    var roundSchedule = db.QuerySingle(sqlSelect, round_id);

    DateTime[] TimeTable = new DateTime[7];

    //populate daily schedule from database
    if (roundSchedule != null)
    {
        TimeTable[0] = roundSchedule.sun_order_close;
        TimeTable[1] = roundSchedule.mon_order_close;
        TimeTable[2] = roundSchedule.tue_order_close;
        TimeTable[3] = roundSchedule.wed_order_close;
        TimeTable[4] = roundSchedule.thu_order_close;
        TimeTable[5] = roundSchedule.fri_order_close;
        TimeTable[6] = roundSchedule.sat_order_close;
    }
    int dayAdder = 0;

    <div id="req_date_div" style="float: left">
        <select style="font-size: 16px;padding:5px;margin: 5px;" id="requsted_date" name="requsted_date">

            @for (int i = 0; i <= howManyDaysToCheck; i++)
            {
                bool is_today = false;
                DateTime checkedDate = curDate.AddDays(dayAdder);
                int todaysDay = (int)checkedDate.DayOfWeek;
                switch (todaysDay)
                {
                    case 0:
                        sqlSelect = "SELECT is_sun AS is_today,sun_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                    case 1:
                        sqlSelect = "SELECT is_mon AS is_today,mon_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                    case 2:
                        sqlSelect = "SELECT is_tue AS is_today,tue_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                    case 3:
                        sqlSelect = "SELECT is_wed AS is_today,wed_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                    case 4:
                        sqlSelect = "SELECT is_thu AS is_today,thu_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                    case 5:
                        sqlSelect = "SELECT is_fri AS is_today,fri_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                    case 6:
                        sqlSelect = "SELECT is_sat AS is_today,sat_order_close AS order_close FROM RoundsTimeTable WHERE round_id=@0";
                        break;
                }
                var rs = db.QuerySingle(sqlSelect, round_id);
                try { is_today = rs.is_today; } catch { }
                if (is_today)
                {
                    DateTime nextRound = Convert.ToDateTime(checkedDate.ToShortDateString() + " " + rs.order_close.ToString("HH:mm"));
                    if (nextRound > curDate)
                    {
                        string todayStr = "";
                        if (nextRound.Date == curDate.Date)
                        {
                            todayStr = "(היום)";
                        }
                        if (nextRound.Date == curDate.AddDays(1).Date)
                        {
                            todayStr = "(מחר)";
                        }

                        <option value="@nextRound">@NewAppFunctions.strDayOfWeek(checkedDate) @checkedDate.ToShortDateString() @nextRound.ToString("HH:mm") @todayStr</option>

                    }

                }

                dayAdder++;


            }
        </select>
        <button type="button" style="font-size: 16px;padding:5px;margin: 5px;background-color: #000;color: #fff" onclick="hideElement('req_date_div');showElement('custom_req_date_div');">אחר..</button>
    </div>
    <div style="display: none;float: left" id="custom_req_date_div">
        <input type="date" style="font-size: 16px;padding:5px;margin: 5px;" id="custom_req_date" name="custom_req_date">
        <button type="button" style="font-size: 16px;padding:5px;margin: 5px;background-color: #f00;color: #fff" onclick="showElement('req_date_div');hideElement('custom_req_date_div');document.getElementById('custom_req_date').value='';">ביטול</button>
    </div>
}

@helper PopulateSpecialOffer(int spOffer_id, int round_id, int order_id = 0, int selected_id = 0, string offer_type = "NONE")
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    sqlSelect = "SELECT * FROM SpecialOffers WHERE id=@0";
    var spOffer = db.QuerySingle(sqlSelect, spOffer_id);
    bool isSpOfferAvailable = true;
    bool is_charity = false; try { is_charity = spOffer.is_charity; } catch { }
    int charity_spOfferType = 0; try { charity_spOfferType = Convert.ToInt32(AppFunctions.GetAppProperty("charity_spOfferType")); } catch { charity_spOfferType = 0; }

    //get all items of offer
    sqlSelect = "SELECT * FROM SpecialOffersItems WHERE spOffer_id=@0 ORDER BY spItemType";
    var spOfferItems = db.Query(sqlSelect, spOffer.id);
    //check if all special offer items are available in this round
    foreach (var spOfferItem in spOfferItems)
    {
        if (spOfferItem.spItemType == 1)
        {
            if (spOffer.spOfferType == charity_spOfferType)
            {
                sqlSelect = "SELECT Top(1) id FROM roundMenuItems WHERE CharityOffersOk=1 AND p_id=@0 AND round_id=@1";
            }
            else
            {
                sqlSelect = "SELECT Top(1) id FROM roundMenuItems WHERE SpOffersOk=1 AND p_id=@0 AND round_id=@1";
            }

            var tmpRs = db.QuerySingle(sqlSelect, spOfferItem.p_id, round_id);
            if (tmpRs == null)
            {
                isSpOfferAvailable = false;
            }
        }
        if (spOfferItem.spItemType == 2)
        {
            if (spOffer.spOfferType == charity_spOfferType)
            {
                sqlSelect = "SELECT Top(1) id FROM roundMenuItems WHERE CharityOffersOk=1 AND spOfferCatId=@0 AND round_id=@1";
            }
            else
            {
                sqlSelect = "SELECT Top(1) id FROM roundMenuItems WHERE SpOffersOk=1 AND spOfferCatId=@0 AND round_id=@1";
            }

            var tmpRs = db.QuerySingle(sqlSelect, spOfferItem.spOfferCatId, round_id);
            if (tmpRs == null)
            {
                isSpOfferAvailable = false;
            }
        }

    }
    <div style="overflow: auto;background-color: #fff">
        @if (isSpOfferAvailable)
        {
            <div style="overflow: auto;margin-bottom: 5px;">
                <div style="padding: 0;margin: 0;overflow:auto;">
                    <div style="overflow: auto;border: 1px dotted #808080;padding: 5px;margin: 5px;border-radius: 5px;">

                        <div style="overflow: auto" id="spOfferInfo_@spOffer.id">
                            <form id="SpOfferForm_@spOffer.id">
                                <div style="overflow: auto;"><b>נא לבחור פריטים ל<span>@spOffer.Title</span></b> </div>
                                @foreach (var spOfferItem in spOfferItems)
                                {
                                    if (spOfferItem.spItemType == 1)
                                    {
                                        if (is_charity)
                                        {
                                            sqlSelect = "SELECT * FROM roundMenuItems Where CharityOffersOk=1 AND round_id=@0 AND p_id=@1";
                                        }
                                        else
                                        {
                                            sqlSelect = "SELECT * FROM roundMenuItems Where SpOffersOk=1 AND round_id=@0 AND p_id=@1";
                                        }

                                        var curSpOfferItem = db.QuerySingle(sqlSelect, round_id, spOfferItem.p_id);
                                        <div style="overflow: auto;background-color: #e3e3e3">
                                            נא לבחור <b>@spOfferItem.quan @spOfferItem.itemunit @spOfferItem.title</b>
                                        </div>
                                        <div style="border-bottom: 1px dotted #000;overflow: auto;">
                                            <div style="float: right;padding: 5px;margin: 5px;text-align: center">
                                                <input type="radio" name="spItem_@spOfferItem.id" value="@curSpOfferItem.id" checked>
                                            </div>
                                            <div>
                                                <span style="margin: 0;padding: 5px;float: right" onclick="sbload('SubSideMenu','Caller?p1=RoundMenuItem&p2=@curSpOfferItem.id&p3=@round_id');">
                                                    <img style="width:45px;height: 45px;border-radius: 5px;" src="imgViewer?size=tn&p_id=@spOfferItem.p_id" alt="@spOfferItem.title">
                                                </span>
                                                <div style="overflow: auto;">
                                                    <div style="font-size: 20px;padding: 2px;text-align: right;z-index: 7000;">
                                                        @curSpOfferItem.title<br>
                                                        <div style="font-size: 13px;color: #808080;overflow: auto;">
                                                            מוצר #@spOfferItem.p_id
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }

                                    if (spOfferItem.spItemType == 2)
                                    {
                                        if (is_charity)
                                        {
                                            sqlSelect = "SELECT * FROM roundMenuItems Where CharityOffersOk=1 AND round_id=@0 AND spOfferCatId=@1 ";
                                        }
                                        else
                                        {
                                            sqlSelect = "SELECT * FROM roundMenuItems Where SpOffersOk=1 AND round_id=@0 AND spOfferCatId=@1 ";
                                        }

                                        var availableSpOfferItems = db.Query(sqlSelect, round_id, spOfferItem.spOfferCatId, spOfferItem.p_id);
                                        int itemCnt = 0; itemCnt = availableSpOfferItems.Count;
                                        <div style="overflow: auto;">
                                            <div style="overflow: auto;background-color: #e3e3e3">
                                                נא לבחור <b>@spOfferItem.quan @spOfferItem.itemunit</b>  @NewAppFunctions.GetTitleById("Cat", spOfferItem.main_cat_id) @spOfferItem.title
                                            </div>
                                            <div style="overflow: auto;">
                                                @foreach (var item in availableSpOfferItems)
                                                {
                                                    <div style="overflow: auto;border-bottom: 1px dotted #000;">
                                                        <div style="float: right;padding: 5px;margin: 5px;text-align: center">
                                                            <input type="radio" name="spItem_@spOfferItem.id" value="@item.id" @if (itemCnt == 1 || item.id == selected_id) { <TEXT> checked</TEXT>}>
                                                        </div>
                                                        <div style="overflow: auto;">
                                                            <span style="float: left;padding: 3px;margin: 3px;background-color: #57d600;color: #fff;font-weight: bold;display: none">@item.sub_cat_id</span>

                                                            <span style="margin: 0;padding: 5px;float: right" onclick="sbload('SubSideMenu','Caller?p1=RoundMenuItem&p2=@item.id&p3=@round_id');">
                                                                <img style="width:45px;height: 45px;border-radius: 5px;" src="imgViewer?size=tn&p_id=@item.p_id" alt="@item.title">
                                                            </span>
                                                            <div style="overflow: auto;">
                                                                <div style="font-size: 20px;padding: 2px;text-align: right;z-index: 7000;">
                                                                    @item.title<br>
                                                                    <div style="font-size: 13px;color: #808080;overflow: auto;">
                                                                        מוצר #@item.p_id
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>


                                        </div>
                                    }


                                }
                                <div style="overflow: auto">
                                    <span style="float: right;padding: 5px;margin: 5px;font-size: 16px;font-weight: bold;color: #b200ff">

                                        @switch (offer_type)
                                        {
                                            case "NONE":
                                                <span style="font-weight: normal;color: #b200ff;">😍 רק</span> @spOffer.price.ToString("C", culture)
                                                break;
                                            case "PAIDCHARITY":
                                                <span style="font-weight: normal;color: #b200ff;">😍 הקצאה במחיר עלות רק </span> @spOffer.price.ToString("C", culture)
                                                break;
                                            case "FREECHARITY":
                                                <span style="font-weight: normal;color: #b200ff;">😍 ללא עלות</span>
                                                break;
                                        }

                                    </span>

                                    <div style="float: left;padding: 5px;margin: 5px;">
                                        <button type="button" style="float: left;margin-left: 5px;padding: 5px;font-size: 16px;background-color: #fff;color: #000;font-weight: bold" onclick="AjaxActions('AddSpecialOffer',@spOffer.id,'', 'SpOfferForm_@spOffer.id',@round_id, '@offer_type',@order_id)">הוספה</button>
                                        <button type="button" style="float: left;margin-left: 5px;padding: 5px;font-size: 16px;background-color: #fff;color: #000;font-weight: bold" onclick="showElement('spOfferInfo_@spOffer.id');clearContent('spOfferAdd_@spOffer.id');">ביטול</button>
                                        <div class="spinner" style="display: none;float: left" id="spOfferLoader_@spOffer.id">
                                            <div class="bounce1"></div>
                                            <div class="bounce2"></div>
                                            <div class="bounce3"></div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>


                    </div>
                </div>
            </div>
        }

    </div>

}

@helper GetCouponsForOrder(int order_id)
{
    var u_id = WebSecurity.CurrentUserId;
