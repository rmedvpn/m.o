                                    }

                                    @if (shipping_charge > 0)
                                    {
                                        if (does_discount_includes_sh)
                                        {
                                            <span class="PrplMiniTag" style="margin-right: 10px;">הנחה כוללת דמי משלוח</span>
                                        }
                                        else
                                        {

                                            <span class="RedMiniTag" style="margin-right: 10px;"> הנחה לא כוללת דמי משלוח </span>
                                        }
                                    }


