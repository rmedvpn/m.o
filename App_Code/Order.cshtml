                                        {
                                            if (actions_enabled)
                                            {
                                                <span class="MiniTag" style="cursor:pointer" onclick="AjaxActions('RemoveCouponFromCart','@order_id','MainLoader', 'DISCOUNT','@discount_coupon_id',@discount_coupon_cart_item_id);">🗑️</span>
                                            }

                                            @pre_defined_discount_title
