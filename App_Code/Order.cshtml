@helper RoundBoardEntry(dynamic order, string order_mode = "NEW", bool is_multi_select_mode = false)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    int round_id = order.round_id;
    string round_short_title = ""; try { round_short_title = order.round_title; } catch { }
    if (round_short_title == "")
    {
        sqlSelect = "SELECT short_title FROM rounds WHERE id=@0";
        var round = op_data.QuerySingle(sqlSelect, round_id);
        round_short_title = ""; try { round_short_title = round.short_title; } catch { }
    }


    string wanumMask = order.wanum;
    try { wanumMask = wanumMask.Substring(wanumMask.Length - 6) + "***"; } catch { }
    DateTime local_time = AppFunctions.LocalTime();

    string ts = "";
    int member_id = order.u_id;
    string rawColor = "#ffffff";
    string board_color = "#ffffff";

    bool is_member = true;

    board_color = order.board_color;

    if (member_id == 0)
    {
        is_member = false;
        board_color = "#ffcccc";
    }

    string member_name = order.nick_name;
    DateTime requested_delivery_date = local_time;
    DateTime scheduled_delivery_start = local_time;
    try { requested_delivery_date = order.requested_delivery_date; } catch { }
    try { scheduled_delivery_start = order.scheduled_delivery_start; } catch { }
    bool isExistingMember = false;
    string memberIcon = "⚠️";
    string rowBgCol = "#ffffcc";
    string VerificationNeededBgColor = "#e3e4e5";
    string alert_color = "";
    int notes_count = order.notes_count;
    bool is_notes = false;
    bool is_new_member = order.is_new_member;
    bool is_verification_needed = false;
    bool is_manual_verification = order.is_manual_verification;
    bool is_ship_phone = order.is_ship_phone;
    string ship_phone = order.ship_phone;
    string ship_name = order.ship_name;
    string copaste_ship_phone = ship_phone;
    bool is_postponed = order.is_postponed;
    bool is_processed = order.is_processed;
    bool is_cancelled = order.is_cancelled;
    bool is_deleted = order.is_deleted;
    bool is_main_page_request = false; if (order_mode == "MAIN") { is_main_page_request = true; }
    int order_status = order.order_status;
    int active_delivery_id = 0; try { active_delivery_id = order.active_delivery_id; } catch { }
    string round_title = ""; try { round_title = order.round_title; } catch { }
    string order_actions = "";
    string order_type = order.order_type;
    try { copaste_ship_phone = copaste_ship_phone.Substring(1); } catch { }

    string order_amount_color = "#000";
    decimal order_amount = order.after_roundup_total;
    string order_amount_txt = "";
    string order_amount_txt_class = "";
    decimal return_amount = order.return_amount;
    string return_amount_txt = "";
    string return_amount_txt_class = "";

    string envelope_class = "SetEnvelope";

    if (order.envelope_id <= 0)
    {
        envelope_class = "EnvelopeNotSet";
    }

    if (order.is_charge_waived)
    {
        order_amount = order.waived_charge_sh;
        order_amount_txt = "ללא חיוב";
        order_amount_txt_class = "RedMiniTag";
    }

    if (order.is_cost_charge)
    {
        order_amount_txt = "מחיר עלות";
        order_amount_txt_class = "PrplMiniTag";
    }

    if (return_amount > 0)
    {
        return_amount_txt = "החזר חוב";

    }




    if (notes_count > 0)
    {
        is_notes = true;
    }


    bool isCart = false;
    sqlSelect = "SELECT serial FROM cartsettings WHERE order_id=@0";
    var isCartRs = op_data.QuerySingle(sqlSelect, order.order_id);
    if (isCartRs != null) { isCart = true; }

    if (member_id == 0 || member_name == "")
    {
        sqlSelect = "SELECT serial,m_id,member_name FROM pb WHERE wanum=@0";
        var member = op_data.QuerySingle(sqlSelect, order.wanum);
        if (member != null)
        {
            isExistingMember = true;
            member_id = member.m_id;
            member_name = member.member_name;
            sqlSelect = "UPDATE mainorders SET u_id=@0,nick_name=@1,ship_reciepient=@1,username=@1 WHERE order_id=@2";
            op_data.Execute(sqlSelect, member_id, member_name, order.order_id);
        }
        if (member_id == 0)
        {
            is_verification_needed = true;
            if (member_name == "")
            {
                member_name = order.full_name;
            }

        }
    }
    else
    {
        isExistingMember = true;
    }

    if (isExistingMember)
    {
        memberIcon = "✅";
        rowBgCol = "#e3e3e3";
        is_verification_needed = false;
    }

    if (is_new_member)
    {
        is_verification_needed = true;
    }

    string display_wanum = order.wanum;

    string copPaste_wanum = order.wanum;

    if (copPaste_wanum.StartsWith("972"))
    {
        copPaste_wanum = copPaste_wanum.Substring(3);
    }
    display_wanum = display_wanum.Substring(display_wanum.Length - 4) + "****";

    if (is_manual_verification)
    {
        is_verification_needed = false;
    }

    if (requested_delivery_date.Date > local_time.Date)
    {
        is_postponed = true;
    }
    else
    {
        is_postponed = false;
    }


    if (is_verification_needed && order_mode != "ORDER") { order_mode = "VERIFY"; board_color = "#ffcccc"; }
    //   if (is_postponed && is_processed) { order_mode = "FUTURE"; board_color = "#57d600"; }
    //   if (!is_postponed && is_processed) { order_mode = "PROC"; board_color = "#123456"; }


    //if (member_name == "") { member_name = order.full_name; }

    if (order_status < 1 && order_mode != "ORDER")
    {
        order_actions = "נא להוסיף פריטים להזמנה ולאשר";
        order_mode = "PRE";
        if (board_color == "")
        {
            board_color = "#bfffb8";
        }
    }

    if (order_status == -2 && order_mode != "ORDER")
    {
        order_actions = "נא לוודא מלאי";
        order_mode = "PROC";
        if (board_color == "")
        {
            board_color = "#b9e0fc";
        }

    }


    if (is_cancelled || is_deleted)
    {
        if (order_mode != "ORDER")
        {
            order_mode = "DELETED";
            if (board_color == "")
            {
                board_color = "#ffcccc";
            }
        }


    }
    if (board_color == "") { board_color = "#ffffff"; }

    if (is_main_page_request) { order_mode = "MAIN"; }



    switch (order_mode)
    {


        case "NEW":
        case "PROC":
        case "DELETED":
        case "PRE":
            if (true)
            {
                string colorPickerClass = "";
                string colorPickerIcon = "";
                switch (order_type)
                {
                    case "ROUND":
                        if (true)
                        {
                            colorPickerClass = "GrayRoundButton";
                            colorPickerIcon = "✉️";

                            if (order.is_dispatched)
                            {
                                envelope_class = "DeliveryEnvelopeInTransit";
                                colorPickerIcon = "⛟";

                            }
                            else
                            {
                                if (active_delivery_id == order.delivery_id && active_delivery_id > 0)
                                {
                                    colorPickerClass = "DeliveryOkRoundButton";
                                    envelope_class = "DeliveryOkEnvelope";

                                }
                                else
                                {
                                    envelope_class = "DeliveryNotOkEnvelope";
                                }
                            }

                        }
                        break;
                    case "PICKUP":
                        if (true)
                        {
                            colorPickerClass = "PrplRoundButton";
                            colorPickerIcon = "🏠";

                        }
                        break;
                    case "EXPRESS":
                        if (true)
                        {
                            colorPickerClass = "GreenRoundButton";
                            colorPickerIcon = "🛵";

                        }
                        break;
                }
                if (is_postponed)
                {
                    colorPickerClass = "PostponedRoundButton";
                }
                if (order.envelope_id <= 0)
                {
                    envelope_class = "NoEnvelope";
                    colorPickerIcon = "❓❔❓";


                }

                <tr id="entry_@order.order_id" style="background-color:@board_color">
                    <td class="@envelope_class" onclick="document.getElementById('boardColorpicker_@order.order_id').click();">
                        @if (order.envelope_id > 0)
                        {
                            <span class="B" style="font-size:24px;float:right"><b>@colorPickerIcon @order.envelope_id </b></span>
                        }
                        else
                        {
                            <span class="B" style="font-size:24px;float:right;text-align:center"><b>@colorPickerIcon</b></span>
                        }



                    </td>

                    <td style="vertical-align:middle;text-align:center;">
                        <input type="color" class="HiddenRndBrdEntryColorPicker" id="boardColorpicker_@order.order_id" value="@board_color" onchange="AjaxActions('SetOrderBoardColor', '@order.order_id', '', this.value,'@order.order_id','M','@order.round_id');">
                        @if (is_multi_select_mode)
                        {
                            if (order_status > 0)
                            {
                                <input type="checkbox" id="cb_order_@order.order_id" class="A" s onclick="let x = document.getElementById('SelectedOrders'); if (this.checked) { x.value = x.value + '##' +@order.order_id+'##'; } else { x.value = x.value.replace('##' +@order.order_id+'##', ''); }" />
                            }

                        }


                        @if (isCart)
                        {
                            <span class="RndBrdEntryAlert" style="float:none" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=OrderItemsEdit&p2=@order.order_id');">
                                <button type="button" class="RndBrdCartEditAlert">❗<br />🛒</button>
                            </span>
                        }
                    </td>















                    <td style="width:120px;padding:5px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="overflow:auto;font-size:12px;color:#000">
                            @if (order.timestamp.Date == local_time.Date)
                            {
                                int min_ago = 0; min_ago = Convert.ToInt32(AppFunctions.HowManyMinutesAgoWas(order.timestamp));
                                <div style="overflow:auto;font-size:16px;color:#000">
                                    <b>@order.timestamp.ToString("HH:mm")</b>
                                    <div class="B" style="display:none;"><span class="MiniTag">לפני @AppFunctions.FormatStringMinutes(min_ago)</span></div>
                                </div>
                            }
                            else
                            {
                                <div style="overflow:auto;font-size:12px;color:#000">
                                    <b>@order.timestamp.ToString("HH:mm")</b>
                                    <div class="B"><span class="MiniTag">@order.timestamp.ToShortDateString()</span></div>

                                </div>
                            }
                            <div class="B" style="display:none">
                                <span class="MiniTag">#@order.order_id</span>
                                <span class="PrplMiniTag">@AppFunctions.FormatRelativeDate(order.requested_delivery_date)</span>
                            </div>
                        </div>
                    </td>


                    <td style="width: 150px; padding: 5px;color:#000;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">
                        <b>@member_name</b>
                        <div class="B" style="display:none;"><span class="MiniTag">@order.ship_city</span></div>
                    </td>

                    <td style="width: 100px; padding: 5px;color:@order_amount_color;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <b>@order.ship_city</b>
                        <div class="hide">
                            @order_amount.ToString("C", culture)
                            <br /><span class="@order_amount_txt_class">@order_amount_txt</span>
                            @if (return_amount > 0)
                            {
                                <span class="GreenMiniTag">@return_amount_txt</span>
                            }
                        </div>



                    </td>

                    <td style="width: 200px; padding: 5px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="font-size:14px;overflow:auto;color:#000"><b>@NewAppFunctions.GetTitleById("OrderStatus", order.order_status)</b></div>
                        <div style="font-size:12px;overflow:auto">@Order.RoundBoardEntryActions(order.order_id, order.order_status)</div>

                    </td>

                    <td></td>

                </tr>
                <tr><td colspan="999" style="background-color:#e3e3e3;height:2px;"> </td></tr>

            }
            break;

        case "MAIN":
            if (true)
            {
                string colorPickerClass = "";
                string colorPickerIcon = "";

                switch (order_type)
                {
                    case "ROUND":
                        if (true)
                        {
                            colorPickerClass = "GrayRoundButton";
                            colorPickerIcon = "🚚";

                        }
                        break;
                    case "PICKUP":
                        if (true)
                        {
                            colorPickerClass = "PrplRoundButton";
                            colorPickerIcon = "🏠";

                        }
                        break;
                    case "EXPRESS":
                        if (true)
                        {
                            colorPickerClass = "GreenRoundButton";
                            colorPickerIcon = "🛵";

                        }
                        break;
                }
                if (is_postponed)
                {
                    colorPickerClass = "PostponedRoundButton";
                }
                <tr id="entry_@order.order_id">
                    <td style="background-color:@board_color;vertical-align:middle;text-align:center">
                        @if (isCart)
                        {
                            <span class="RndBrdEntryAlert" style="float:none" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=OrderItemsEdit&p2=@order.order_id');">
                                <button type="button" class="RndBrdCartEditAlert">❗<br />🛒</button>
                            </span>
                        }
                    </td>
                    <td style="padding:5px;margin:5px;">
                        <input type="color" class="RndBrdEntryColorPicker" style="width:1px;height:1px;" id="boardColorpicker_@order.order_id" value="@board_color" onchange="AjaxActions('SetOrderBoardColor', '@order.order_id', '', this.value,'@order.order_id','M','@order.round_id');">


                        <button type="button" class="@colorPickerClass" style="background-color:@board_color" onclick="document.getElementById('boardColorpicker_@order.order_id').click();">
                            @colorPickerIcon
                        </button>







                    </td>


                    <td style="padding:5px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="overflow: auto; font-size: 16px;color:#000">
                            @if (round_id > 0)
                            {
                                <b>@round_short_title</b>
                            }
                            else
                            {
                                <span style="color:#f00"><b>טרם נקבע</b></span>
                            }

                            <div class="B" style="display:none">
                                <span class="MiniTag">#@order.order_id</span>
                                <span class="PrplMiniTag">@AppFunctions.FormatRelativeDate(order.requested_delivery_date)</span>
                            </div>
                        </div>


                    </td>




                    <td style="width:120px;padding:5px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="overflow:auto;font-size:12px;color:#000">
                            @if (order.timestamp.Date == local_time.Date)
                            {
                                int min_ago = 0; min_ago = Convert.ToInt32(AppFunctions.HowManyMinutesAgoWas(order.timestamp));
                                <div style="overflow:auto;font-size:16px;color:#000">
                                    <b>@order.timestamp.ToString("HH:mm")</b>
                                    <div class="B" style="display:none;"><span class="MiniTag">לפני @AppFunctions.FormatStringMinutes(min_ago)</span></div>
                                </div>
                            }
                            else
                            {
                                <div style="overflow:auto;font-size:12px;color:#000">
                                    <b>@order.timestamp.ToString("HH:mm")</b>
                                    <div class="B"><span class="MiniTag">@order.timestamp.ToShortDateString()</span></div>

                                </div>
                            }
                        </div>
                    </td>


                    <td style="width: 150px; padding: 5px;color:#000;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">
                        <b>@member_name</b>
                        <div class="B" style="display:none;"><span class="MiniTag">@order.ship_city</span></div>
                    </td>

                    <td style="width: 100px; padding: 5px;color:@order_amount_color;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <b>@order.ship_city</b>
                        <div class="hide">
                            @order_amount.ToString("C", culture)
                            <br /><span class="@order_amount_txt_class">@order_amount_txt</span>
                            @if (return_amount > 0)
                            {
                                <span class="GreenMiniTag">@return_amount_txt</span>
                            }
                        </div>



                    </td>

                    <td style="width: 200px; padding: 5px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="font-size:14px;overflow:auto;color:#000"><b>@NewAppFunctions.GetTitleById("OrderStatus", order.order_status)</b></div>
                        <div style="font-size:12px;overflow:auto">@Order.RoundBoardEntryActions(order.order_id, order.order_status)</div>
                    </td>

                    <td style="background-color:@board_color"></td>

                </tr>
                <tr><td colspan="999" style="background-color:#808080;height:8px;"> </td></tr>

            }
            break;

        case "ORDER":
            if (true)
            {
                string colorPickerClass = "";
                string colorPickerIcon = "";
                switch (order_type)
                {
                    case "ROUND":
                        if (true)
                        {
                            colorPickerClass = "GrayRoundButton";
                            colorPickerIcon = "🚚";

                        }
                        break;
                    case "PICKUP":
                        if (true)
                        {
                            colorPickerClass = "PrplRoundButton";
                            colorPickerIcon = "🏠";

                        }
                        break;
                    case "EXPRESS":
                        if (true)
                        {
                            colorPickerClass = "GreenRoundButton";
                            colorPickerIcon = "🛵";

                        }
                        break;
                }
                if (is_postponed)
                {
                    colorPickerClass = "PostponedRoundButton";
                }

                <tr id="entry_@order.order_id">
                    <td class="OrdersViewerCell" style="background-color:@board_color;vertical-align:middle;text-align:center">
                        @if (isCart)
                        {
                            <span class="RndBrdEntryAlert" style="float:none" onclick="MiscActions('HighlightEntry',@order.order_id);">
                                🛒
                            </span>
                        }
                    </td>
                    <td class="OrdersViewerCell">
                        @colorPickerIcon


                    </td>


                    <td class="OrdersViewerCell" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="overflow: auto; font-size: 16px;color:#000">
                            @if (round_id > 0)
                            {
                                <b>@round_short_title</b>
                            }
                            else
                            {
                                <span style="color:#f00"><b>טרם נקבע</b></span>
                            }

                            <div class="B" style="display:none">
                                <span class="MiniTag">#@order.order_id</span>
                                <span class="PrplMiniTag">@AppFunctions.FormatRelativeDate(order.requested_delivery_date)</span>
                            </div>
                        </div>


                    </td>




                    <td class="OrdersViewerCell" style="width:120px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="overflow:auto;font-size:12px;color:#000">
                            @if (order.timestamp.Date == local_time.Date)
                            {
                                int min_ago = 0; min_ago = Convert.ToInt32(AppFunctions.HowManyMinutesAgoWas(order.timestamp));
                                <div style="overflow:auto;font-size:16px;color:#000">
                                    <b>@order.timestamp.ToString("HH:mm")</b>
                                    <div class="B" style="display:none;"><span class="MiniTag">לפני @AppFunctions.FormatStringMinutes(min_ago)</span></div>
                                </div>
                            }
                            else
                            {
                                <div style="overflow:auto;font-size:12px;color:#000">
                                    <b>@order.timestamp.ToString("HH:mm")</b>
                                    <div class="B"><span class="MiniTag">@order.timestamp.ToShortDateString()</span></div>

                                </div>
                            }
                        </div>
                    </td>


                    <td class="OrdersViewerCell" style="width: 150px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">
                        <b>@member_name</b>
                        <div class="B" style="display:none;"><span class="MiniTag">@order.ship_city</span></div>
                    </td>
                    <td class="OrdersViewerCell" style="width: 100px; color:@order_amount_color;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">
                        <b>@order.ship_city</b>
                        <div class="hide">
                            @order_amount.ToString("C", culture)
                            <br /><span class="@order_amount_txt_class">@order_amount_txt</span>
                            @if (return_amount > 0)
                            {
                                <span class="GreenMiniTag">@return_amount_txt</span>
                            }
                        </div>
                    </td>

                    <td class="OrdersViewerCell" style="width: 200px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">
                        <div style="font-size:14px;overflow:auto;color:#000"><b>@NewAppFunctions.GetTitleById("OrderStatus", order.order_status)</b></div>
                        <div style="font-size:12px;overflow:auto;display:none">@Order.RoundBoardEntryActions(order.order_id, order.order_status)</div>
                    </td>

                    <td style="background-color:@board_color"></td>

                </tr>
                <tr><td colspan="999" style="background-color:#808080;height:2px;"> </td></tr>

            }
            break;


        case "VERIFY":
            if (true)
            {
                if (member_name == "")
                {
                    member_name = order.full_name;
                }

                <tr id="entry_@order.order_id" style="border-bottom: 1px dotted #000;background-color:@VerificationNeededBgColor">
                    <td>
                        <span style="text-align:right;direction:rtl;font-size:14px;display:none">
                            <input type="color" style="width: 30px;" id="boardColorpicker_@order.order_id" value="@VerificationNeededBgColor" onchange="AjaxActions('SetOrderBoardColor', '@order.order_id', '', this.value,'@order.order_id','M','@order.round_id');">
                        </span>
                        <span style="text-align:right;direction:rtl;font-size:11px;color:#b200ff">נדרש אימות</span>
                    </td>


                    <td style="padding:5px;" onclick="MiscActions('HighlightEntry',@order.order_id);sbload('GenSb','Caller?p1=BoardOrderInfo&p2=@order.order_id');">

                        <div style="overflow:auto"> @round_short_title</div>
                        @if (order.is_express)
                        {
                            <div style="overflow:auto"><span style="color: #57d600; font-size: 12px"><b>אקספרס</b></span></div>
                        }

                        @if (order.is_pickup)
                        {
                            <div style="overflow:auto"><span style="color: #b200ff; font-size: 12px"><b>איסוף</b></span></div>
                        }
                        @if (!order.is_pickup && !order.is_express)
                        {
                            <div style="overflow:auto"><span style="color:blue;font-size:12px"><b>סבב חלוקה</b></span></div>
                        }

                    </td>




