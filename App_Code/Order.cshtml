                            {<span class="PrplMiniTag">תרומה לקופה!</span>}

                            <span style="float: left;padding-left: 10px"><b>@roundup_amount.ToString("C", culture)</b></span>
                        </div>

                        <div style="overflow: auto;">סה"כ מזומן למסירה <span style="float: left;padding-left: 10px">👈👈<span style="background-color:yellow;border-radius:3px;"><b>@after_roundup_total.ToString("C", culture)</b></span></span></div>

                    }



                </div>
            }
            else
            {
                <div style="overflow: auto;color: #e3e3e3;font-size: 18px;"><b>הזמנה ריקה</b></div>
            }



            <input type="hidden" name="credit_grand_total" value="@grand_total">
        </div>
    }

    if (listType == "ORDERTOTAL")
    {
        string totForeColor = "#f00";
        string totbgColor = "white";
        string errtxt = "";
        if (itemsCount > 0)
        {

            totForeColor = "#57d600";
            if (min_order > SubTotal)
            {
                totForeColor = "#f00";
                errtxt = "⚠️ מתחת למינימום הזמנה";
            }
            if (max_order < grand_total)
            {
                totForeColor = "#f00";
                errtxt = "⚠️ מעל המקסימום להזמנה";
            }

        }
        else
        {
            totForeColor = "#e3e3e3";

        }
        <div style="overflow: auto;">
            <div style="float: left;background-color: @totbgColor;color: @totForeColor;border: 2px solid @totForeColor;padding: 5px;text-align: center;border-radius:5px;">
                💰 <B>@grand_total.ToString("C", culture)</B> <div style="font-size:11px;overflow:auto">@errtxt</div>
            </div>


        </div>

    }




    db.Close();
}

