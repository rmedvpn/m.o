@helper OrderEditBar(int order_id, int rep_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    int u_id = WebSecurity.CurrentUserId;
    if (rep_id == 0)
    {
        rep_id = u_id;
    }
    dynamic cart = null;
    string cartType = "ORDERTOTAL";
    sqlSelect = "SELECT * FROM MainCart WHERE rep_id=@0 AND order_id=@1";
    cart = db.Query(sqlSelect, rep_id, order_id);

    sqlSelect = "SELECT order_status,is_packed FROM MainOrders WHERE  order_id=@0";
    var order = db.QuerySingle(sqlSelect, order_id);
    int order_status = 0; try { order_status = order.order_status; } catch { }
    bool is_packed = false; try { is_packed = order.is_packed; } catch { }
    bool is_ok_to_approve_order = false;
    if (order_status < -3 || order_status > 0)
    {
        is_ok_to_approve_order = true;
    }
    if (order_status >= 3)
    {
        is_packed = true;
    }
    <div style="overflow: auto;font-size: 16px;">
        <div style="padding: 5px; margin: 5px; background-color: #57d600; color: #fff; float: right; border-radius: 5px;" onclick="hideElement('cartOptionsDiv');hideElement('specialOffersDiv');hideElement('CouponsDiv');showElement('menuItemsDiv');"><b>מוצרים</b></div>
        <div style="padding: 5px; margin: 5px; background-color: #b200ff; color: #fff; float: right; border-radius: 5px;" onclick="hideElement('cartOptionsDiv');hideElement('menuItemsDiv');hideElement('CouponsDiv');showElement('specialOffersDiv');"><b>מבצעים</b></div>
        <div style="padding: 5px; margin: 5px; background-color: #0094ff; color: #fff; float: right; border-radius: 5px;" onclick="hideElement('cartOptionsDiv');hideElement('menuItemsDiv');hideElement('specialOffersDiv');showElement('CouponsDiv');"><b>הטבות/קופונים</b></div>

        <div style="float: left;padding: 5px" onclick="hideElement('menuItemsDiv');hideElement('specialOffersDiv');hideElement('CouponsDiv');showElement('cartOptionsDiv');">

            @Order.ListOfItems(cart, order_id, cartType)

        </div>

        @if (!is_packed)
        {
            <div style="float: left;font-size:16px;padding:5px;margin:5px;border:2px solid #57d600;border-radius:5px;" onclick="AjaxActions('RepUpdateOrderItems','@order_id','', 'orderReview');">
                🛒
            </div>
        }


        <div style="float: left; font-size: 16px; padding: 5px; margin: 5px; border: 2px solid #f00; border-radius: 5px; " onclick="AjaxActions('OrderCartReset',@order_id,'',@u_id);">
            🗑️
        </div>

    </div>


    db.Close();
}

