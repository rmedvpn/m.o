            @foreach (var coupon in coupons)
            {
                string coupon_availability = "";
                //coupon_availability = Coupons.OrderCouponAvailability(order_id, coupon.coupon_id);
                //coupon.couponSummary
                string coupon_color = "#f00";
                //  is_valid_coupon = Coupons.isCouponValidForOrder(order_id, coupon.coupon_id);

                foreach (var coupLine in couponsArr)
                {
                    string[] CouponItem = coupLine.Split(itemSep.ToCharArray());
                    if (CouponItem[0] == coupon.coupon_id.ToString() && !CouponItem[1].IsEmpty())
                    {

                        <div class="B" style="background-color: white; border: 2px solid #000; border-radius: 5px; width: 85%; margin: 5px;text-align:right;color:#000 ">
                            <div class="B" style="padding:5px;" onclick="">


                                <button type="button" class="LeftAction" onclick="Accordionize('couponAcc_@coupon.coupon_id'); ">💡</button>

                                @coupon.coupon_title <span class="MiniTag">(קופון #@coupon.coupon_id)</span>
                                <div class="B" style="font-size:12px;color:#f00">@Html.Raw(CouponItem[1])</div>

                            </div>
                            <button class="Accordion" id="couponAcc_@coupon.coupon_id" style="display:none"></button>
                            <div class="panel" style="margin:0;padding:0">

                                <div style="overflow: auto; margin: 0; padding: 5px; color: #000;background-color:#e3e3e3">@Coupons.CouponSummary(coupon.coupon_id)</div>
                            </div>
                        </div>

                    }
                }


            }
        </center>
    </div>

    <div class="B" style="height:100px;">&nbsp;</div>
    db.Close();
}

