            }


        }
        else
        {
            if (!item.is_charge_waived)
            {
                if (item.is_discountable)
                {
                    DiscountableItemsSubTotal = DiscountableItemsSubTotal + item.Quan * item.price;
                }
                else
                {
                    unDiscountableItemsSubTotal = unDiscountableItemsSubTotal + item.Quan * item.price;
                }
            }


        }

    }
    else
    {
        if (item.item_id == -1)
        {
            if (!item.is_free_charity)
            {
                if (item.is_discountable)
                {
                    DiscountableSpOffersSubTotal = DiscountableSpOffersSubTotal + item.Quan * item.price;
                }
                else
