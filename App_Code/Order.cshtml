        <div class="B">
            <div class="OrderInfoTitle" style="color:#f00">
                ⚠️ לא זיהינו את הישוב <span><b>@city</b></span>, באיזה אזור זה?<br>
                <select class="A" id="selected_area_id" name="selected_area_id">
                    <option value="-1">נא לבחור איזור למשלוח</option>
                    @foreach (var area in areas)
                    {
                        <option value="@area.id" @if (selected_area == area.id) { <text> selected</text> }>@area.title</option>
                    }
                </select>
                <input type="hidden" id="detected_area_id" name="detected_area_id" value="0" />
            </div>
        </div>
    }
    db.Close();
}
