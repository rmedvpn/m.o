@helper BoardOrderInfo_bck(int order_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    DateTime local_time = AppFunctions.LocalTime();
    var u_id = WebSecurity.CurrentUserId;
    var db = WebMatrix.Data.Database.Open("op_data");


    var sqlSelect = "SELECT * FROM MainOrders where order_id=@0";
    var order_data = db.QuerySingle(sqlSelect, order_id);
    if (order_data != null)
    {
        int order_status = order_data.order_status;
        int round_id = order_data.round_id;
        int member_id = order_data.u_id;
        int area_id = order_data.area_id;

        decimal return_amount = 0; try { return_amount = order_data.return_amount; } catch { }
        decimal member_due_debt = 0; member_due_debt = MoneyFunctions.GetMemberDebt(member_id);
        bool debt_bypass = false; try { debt_bypass = order_data.debt_bypass; } catch { }
        string masked_phone = ""; masked_phone = AppFunctions.mask_phone(order_data.ship_phone, 3);

        sqlSelect = "SELECT * FROM rounds where id=@0";
        var round = db.QuerySingle(sqlSelect, round_id);
        int round_type = 0; try { round_type = round.round_type; } catch { }
        string round_title = "טרם נקבע"; try { round_title = round.title; } catch { }
        if (member_due_debt > return_amount && !debt_bypass)
        {
            if (!order_data.is_charge_waived && !order_data.is_cost_charge)
            {
            }
            //OrderFunctions.AttachDebtToOrder(order_id);

            // order_data = db.QuerySingle(sqlSelect, order_id, round_id, member_id);
        }





        string order_type = order_data.order_type;
        string button_disabler = "";
        bool is_EditLock = false; try { is_EditLock = Convert.ToBoolean(order_data.is_EditLock); } catch { }
        bool new_order_mode = false;
        string edit_lock_reason = "";
        bool in_transit = false;
        bool is_approved = false; try { is_approved = Convert.ToBoolean(order_data.is_approved); } catch { }
        bool is_charity = false; try { is_charity = Convert.ToBoolean(order_data.is_charity); } catch { }
        bool is_packed = false; try { is_packed = Convert.ToBoolean(order_data.is_packed); } catch { }
        string order_notes = ""; try { order_notes = order_data.order_notes; } catch { }
        string packing_notes = ""; try { packing_notes = order_data.packing_notes; } catch { }
        string ship_notes = ""; try { ship_notes = order_data.ship_notes; } catch { }
        DateTime pu_eta = local_time.AddMinutes(30); try { pu_eta = order_data.pu_eta; } catch { }
        DateTime requested_delivery_date = local_time; try { requested_delivery_date = order_data.requested_delivery_date; } catch { }
        DateTime scheduled_delivery_start = local_time; try { scheduled_delivery_start = order_data.scheduled_delivery_start; } catch { }
        int delivery_id = order_data.delivery_id;

        bool is_express_round = false; try { is_express_round = round.is_express; } catch { }
        bool is_route_round = false; ; try { is_route_round = round.is_route; } catch { }
        bool is_pickup_round = false; ; try { is_pickup_round = round.is_pickup; } catch { }

        sqlSelect = "SELECT * FROM orderitems WHERE orderitems.order_id=@0 ";
        var orderItems = db.Query(sqlSelect, order_id);

        sqlSelect = "SELECT * FROM OrderCancelCodes order by serial ";
        var OrderCancelCodes = db.Query(sqlSelect, member_id);

        sqlSelect = "SELECT * FROM pb WHERE m_id=@0";
        var member = db.QuerySingle(sqlSelect, member_id);
        bool is_member = true; if (member == null) { is_member = false; }
        int memeber_def_area = 0; try { memeber_def_area = member.def_Area; } catch { }
        if (area_id == 0) { area_id = memeber_def_area; }




        decimal total_order = 0;
        try { total_order = Convert.ToInt32(NewAppFunctions.GetOrderTotal(order_id)); } catch { }
        decimal grand_total = 0;



        string eta_text = "";

        sqlSelect = "SELECT * FROM Addresses WHERE member_id=@0 ORDER BY is_default DESC";
        var MemberAddresses = db.Query(sqlSelect, member_id);
        string newAddressDivDisplayState = "none";
        string ship_address = "";
        string ship_city = "";
        string address_notes = "";
        string address_nick = "";
        int cur_saved_address_id = 0;
        int selected_member_address_id = 0;

        try { cur_saved_address_id = order_data.saved_address_id; } catch { }

        if (cur_saved_address_id == 0 && MemberAddresses.Count() > 0)
        {
            sqlSelect = "SELECT TOP(1) * FROM Addresses WHERE member_id=@0 ORDER BY is_default DESC";
            var defAddress = db.QuerySingle(sqlSelect, member_id);
            try { cur_saved_address_id = defAddress.id; } catch { }

        }


        string delivery_date_str = "";
        string delivery_date_color = "#000";
        string delivery_type_txt = "";

        string pickupInfoEditDivDisplayState = "none;";
        string DeliveryInfoEditDivDisplayState = "none;";
        string UpdateDeliveryEtaDivDisplayState = "none;";

        DateTime promised_express_eta = local_time;
        int dynamic_eta_min = 0;
        bool is_express_eta_set = true;

        if (cur_saved_address_id == -1 || cur_saved_address_id == 0)
        {

            try { ship_address = order_data.ship_address; } catch { }
            try { ship_city = order_data.ship_city; } catch { }
