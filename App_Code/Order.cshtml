                                    <div class="B" style="border-top:2px dotted #b200ff;">&nbsp;</div>
                                }
                            }
                            else
                            {
                                decimal zero = 0;

                                <div style="overflow: auto;color: #b200ff;">

                                    @freeShippingTxt
                                    <span style="float: left;padding-left: 10px">@zero.ToString("C", culture)</span>
