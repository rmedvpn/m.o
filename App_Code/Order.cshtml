                            <button class="OkBtn">דיווח</button>
                        </div>
                        ההזמנה בביצוע
                    </div>
                    <div style="overflow: auto;padding: 5px;">
                        <div style="overflow: auto;padding: 5px;text-align: center;float:right">
                            בהמתנה לעדכונים
                        </div>

                    </div>
                </div>
            }
            break;

        case 4:
            if (true)
            {
                <div class="B">@tmpit.RoundOrderInProcessStatus(order.order_id)</div>

                <div style="overflow: auto;padding: 10px;background-color: #808080;font-size: 18px;display:none">
                    <div class="A" style="background-color:white;color:#000;border-radius:5px;padding:10px;">
                        <form id="VENDORAPPROVE">
                            <div style="overflow: auto">
                                <div class="deliveryToolTip" style="float:left" onclick="Accordionize('AccRoundDeliveryReport');">✅ דיווח מסירה</div>

                                <button type="button" style="padding:0;margin-right:5px;font-size:16px;float:left;display:none" onclick="Accordionize('AccEtaUpdate');">🕓 עדכון זמן הגעה</button>
                                <div style="overflow:auto">
