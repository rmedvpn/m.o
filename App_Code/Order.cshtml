        if (member_due_debt > 0) //&& debt_ignore=true;
        {    //is_EditLock = true;
            edit_lock_reason = "DUEDEBT";
        }
        if (order_status >= 2)
        {
            is_EditLock = true;
            edit_lock_reason = "TRANSIT";
            in_transit = true;
        }

        if (order_status >= -3 && order_status <= 0)
        {
            new_order_mode = true;
        }

        if (order_data.promised_express_eta == null)
        {
            is_express_eta_set = false;
            UpdateDeliveryEtaDivDisplayState = "block;";


        }

        if (area_id > 0)
        {
            try { dynamic_eta_min = Rounds.GetEtaMinForExpressDelivery(round_id, area_id); } catch { }
        }
        else
        {
            dynamic_eta_min = -1;
        }

        if (order_type == "EXPRESS")
        {
            delivery_type_txt = "🛵 משלוח אקספרס";
            try { promised_express_eta = order_data.promised_express_eta; } catch { promised_express_eta = order_data.timestamp.AddMinutes(90); }
            DeliveryInfoEditDivDisplayState = "block;";
        }
        if (order_type == "ROUND")
        {
            delivery_type_txt = "🚚 משלוח סבב";
            DeliveryInfoEditDivDisplayState = "block;";

        }
        if (order_type == "PICKUP")
        {
            delivery_type_txt = "🏠 איסוף עצמי";
            pickupInfoEditDivDisplayState = "block;";

        }

        if (promised_express_eta.Date == local_time.Date)
