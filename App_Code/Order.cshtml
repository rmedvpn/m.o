                                <div class="A" style="border: 1px dotted #808080; display: @RefundAmountDivDisplayState" id="refund_amount_div">
                                    <span class="A-Right">
                                        הערה להחזר כספי <span class="RedMiniTag">*חובה</span><br />

                                        <textarea class="A" name="refund_notes" id="refund_notes" maxlength="250">@refund_notes</textarea>

                                    </span>
                                    <span class="A-Right">
                                        סכום ההחזר<br />

                                        <input type="text" class="A30" name="refund_amount" id="refund_amount" value="@Convert.ToInt32(refund_amount)" onfocus="this.value = '';">₪

                                    </span>
                                </div>

                            </div>

                        </div>



                        <div class="A" style="text-align:center">
                            <button type="button" class="A" onclick="hideElement('PaymentCancelEditBtn'); hideElement('EditPaymentDiv'); showElement('PaymentInfoDiv'); showElement('PaymentEditBtn');">ביטול</button>

                            <button type="button" class="A" onclick="AjaxActions('UpdateOrderPaymentOptions',@order_id,'MainLoader','payment_info_form');">שמירת שינויים</button>
                        </div>
                    </div>
                }
            }


        </div>


    </div>


    db.Close();
}

@helper PaymentInfo(dynamic order_info)
{
decimal zero = 0;
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
DateTime local_time = AppFunctions.LocalTime();
int order_id = order_info.order_id;
var db = Database.Open("op_data");
var sqlSelect = "";
int u_id = WebSecurity.CurrentUserId;
int round_id = 0;
int member_id = 0; member_id = order_info.u_id;
int rep_id = 0; rep_id = u_id;
decimal money_vouchers_available_balance = 0; money_vouchers_available_balance = MoneyFunctions.GetMemberAvailableMoneyVouchersBalance(member_id);
bool DisableMoneyVouchers = false; try { DisableMoneyVouchers = order_info.DisableMoneyVouchers; } catch { }
decimal MoneyVouchersTotal = 0; try { MoneyVouchersTotal = order_info.MoneyVouchersTotal; } catch { }
money_vouchers_available_balance = money_vouchers_available_balance - MoneyVouchersTotal;

int payment_method = order_info.payment_method;
int charge_account_id = order_info.charge_account_id;
string charge_account_name = order_info.charge_account_name;
decimal credit_amount = 0; try { credit_amount = order_info.credit_amount; } catch { }
decimal grand_total = 0; try { grand_total = order_info.grand_total; } catch { }
decimal donate_amount = 0; try { donate_amount = order_info.donate_amount; } catch { }
decimal charge_amount = 0; try { charge_amount = order_info.charge_amount; } catch { }
decimal return_amount = 0; try { return_amount = order_info.return_amount; } catch { }
decimal CreditCouponsTotal = 0; try { CreditCouponsTotal = order_info.CreditCouponsTotal; } catch { }
decimal actual_pickup_amount = 0; try { actual_pickup_amount = order_info.actual_pickup_amount; } catch { }
bool is_cost_charge = false; try { is_cost_charge = order_info.is_cost_charge; } catch { }
decimal total_cost_charge = 0; try { total_cost_charge = order_info.total_cost_charge; } catch { }
bool is_total_roundup = false; try { is_total_roundup = order_info.is_total_roundup; } catch { }
decimal after_roundup_total = 0; try { after_roundup_total = order_info.after_roundup_total; } catch { }
decimal roundup_amount = 0; try { roundup_amount = order_info.roundup_amount; } catch { }
decimal roundup_to = 0; try { roundup_to = order_info.roundup_to; } catch { }
bool is_donate_roundup = false; try { is_donate_roundup = order_info.is_donate_roundup; } catch { }
decimal waived_charge_sh = 0; try { waived_charge_sh = order_info.waived_charge_sh; } catch { }
bool is_charge_waived = false; try { is_charge_waived = order_info.is_charge_waived; } catch { }
string charge_waive_note = ""; try { charge_waive_note = order_info.charge_waive_note; } catch { }

decimal refund_amount = 0; try { refund_amount = order_info.refund_amount; } catch { }
bool is_refund = false; try { is_refund = order_info.is_refund; } catch { }
string refund_notes = ""; try { refund_notes = order_info.refund_notes; } catch { }

decimal member_credit_balance = 0; //try { member_credit_balance = order_info.debt; } catch { }
DateTime credit_return_date = local_time; try { credit_return_date = order_info.credit_return_date; } catch { }
DateTime debt_due_date = local_time;
DateTime NOR_date = Convert.ToDateTime("1/1/1901");
bool is_active_debt = false;
bool is_past_due_debt = false;
bool is_credit_blocked = false;
decimal current_amount_due = 0;



sqlSelect = "SELECT debt,due_date,is_credit_blocked FROM pb WHERE m_id=@0";
var member = db.QuerySingle(sqlSelect, member_id);
if (member != null)
{
    try { member_credit_balance = member.debt; } catch { }
    try { debt_due_date = member.due_date; } catch { }
    try { is_credit_blocked = member.is_credit_blocked; } catch { }
}

if (member_credit_balance > 0)
{
    is_active_debt = true;
    if (debt_due_date.Date <= local_time.Date || NOR_date == debt_due_date)
    {
        is_past_due_debt = true;
        current_amount_due = MoneyFunctions.GetMemberDebt(member_id);
    }
}


    <div class="A" style="color:#000">

        @if (money_vouchers_available_balance > 0)
        {
            <div class="B" style="color:#000;text-align:right;padding:3px;background-color:#ffffcc;margin-bottom:5px;">
                ⚠️ קיימת יתרת זיכוי לא מנוצלת בסך <span style="color:#57d600"><b>@money_vouchers_available_balance.ToString("C", culture)</b></span>
            </div>



        }

        @if (is_active_debt)
        {
            if (is_past_due_debt)
            {
                <div class="B" style="color:red;text-align:center;border:1px dotted #f00;padding:3px;background-color:yellow"><b> *קיים חוב @member_credit_balance.ToString("C", culture)</b><br /><span class="RedMiniTag">@current_amount_due.ToString("C", culture) לתשלום מיידי!</span></div>
            }
            else
            {
                <div class="B" style="color:red;text-align:center;border:1px dotted #f00;padding:3px;background-color:yellow"><b> *קיים חוב @member_credit_balance.ToString("C", culture)</b><br /><span class="RedMiniTag">לפרעון עד @debt_due_date.ToShortDateString()</span></div>
            }


        }
        @if (is_credit_blocked)
        {
            <div class="B" style="color:red;text-align:center;border:1px dotted #f00;padding:3px;background-color:yellow"><b>⚠️ חשבון חסום לשימוש בקרדיט! </b></div>
        }

        @switch (payment_method)
        {
            case 1:
                if (true)
                {
                    <div class="B">
                        תשלום במזומן

                    </div>

                }
                break;

            case 2:
                if (true)
                {


                    <div class="B">
                        תשלום בקרדיט
                        <br />
                        @if (credit_return_date == NOR_date)
                        {
                            <div class="B">
                                @credit_amount.ToString("C", culture) בהקפה עד להזמנה הבאה
                            </div>
                        }
                        else
                        {
                            <div class="B">
                                @credit_amount.ToString("C", culture) בהקפה עד @credit_return_date.ToShortDateString()
                            </div>
                        }

                    </div>
                }
                break;
            case 3:
                if (true)
                {
                    <div class="B">
                        תשלום באמצעות חיוב חשבון
                    </div>

                }
                break;
            case 4:
                if (true)
                {
                    <div class="B">
                        ללא חיוב
                    </div>

                }
                break;
            default:
                break;
        }


        <div class="A" style="font-size:12px;">
            @if (is_charge_waived)
            {

                after_roundup_total = waived_charge_sh-MoneyVouchersTotal;
                credit_amount = 0;
                CreditCouponsTotal = 0;
                return_amount = 0;
                charge_amount = 0;
                donate_amount = 0;
                roundup_amount = 0;

                if (waived_charge_sh > 0)
                {
                    <div class="B" style="border-bottom:1px dotted #808080">☝️ <b><span style="background-color:yellow">הזמנה ללא חיוב </span><span class="RedMiniTag">(בחיוב דמי משלוח בלבד)</span> <span style="float:left">@waived_charge_sh.ToString("C", culture)</span> </b></div>
                }
                else
                {
                    <div class="B" style="border-bottom:1px dotted #808080">☝️ <b><span style="background-color:yellow">הזמנה ללא חיוב </span><span class="RedMiniTag">(ללא חיוב)</span> <span style="float:left">@zero.ToString("C", culture)</span> </b></div>
                }

            }
            else
            {
                if (is_cost_charge)
                {
                    if (total_cost_charge > 0)
                    {
                        <div class="B" style="border-bottom:1px dotted #808080">👈 <b>הזמנה <span class="PrplMiniTag">(במחיר עלות)</span> <span style="float:left">@total_cost_charge.ToString("C", culture)</span> </b></div>
                    }
                }
                else
                {
                    if (grand_total > 0)
                    {<div class="B" style="border-bottom:1px dotted #808080">👈 <b>הזמנה <span style="float:left">@grand_total.ToString("C", culture)</span> </b></div>}
            }

        }




            @if (CreditCouponsTotal > 0)
            {<div class="B" style="border-bottom:1px dotted #808080">🎟️ תשלום בזיכוי <span style="float: left; color: #f00">-@CreditCouponsTotal.ToString("C", culture)</span> </div>}



            @if (credit_amount > 0)
            {<div class="B" style="border-bottom:1px dotted #808080">🗒️ תשלום בקרדיט <span style="float: left; color: #f00">-@credit_amount.ToString("C", culture)</span> </div>}
            @if (charge_amount > 0)
            {<div class="B" style="border-bottom:1px dotted #808080">🗒️ חיוב חשבון #@charge_account_id - @charge_account_name<span style="float: left; color: #f00">-@charge_amount.ToString("C", culture)</span> </div>}

            @if (return_amount > 0)
            {<div class="B" style="border-bottom:1px dotted #808080">🤑 החזר חוב <span style="float:left;color:#b200ff">@return_amount.ToString("C", culture)</span> </div>}

            @if (donate_amount > 0)
            {<div class="B" style="border-bottom:1px dotted #808080">🪙 תרומה <span style="float: left; color: #b200ff">@donate_amount.ToString("C", culture)</span> </div>}

            @if (MoneyVouchersTotal > 0)
            {<div class="B" style="border-bottom:1px dotted #808080">💎 תשלום בזיכוי <span style="float: left; color: #f00">-@MoneyVouchersTotal.ToString("C", culture)</span> </div>}


            @if (roundup_amount > 0)
            {
                <div class="B" style="border-bottom:1px dotted #808080">
                    ⭕ עיגול אנטי עודף ל<span>@roundup_to.ToString("C", culture)</span>
                    @if (is_donate_roundup)
                    {<span class="PrplMiniTag">תרומה לקופה!</span>}

                    <span style="float:left;color:#b200ff">@roundup_amount.ToString("C", culture)</span>
                </div>
            }




            <div class="B" style="border-bottom:1px dotted #808080"><b>💰 סך הכל לאיסוף ע"י נהג / שליח <span style="float: left; background-color: #57d600;color:white;padding:5px">@after_roundup_total.ToString("C", culture)</span> </b></div>
            @if (refund_amount > 0)
            {
                decimal after_refund_total = after_roundup_total - refund_amount;

                <div class="B" style="border-bottom:1px dotted #808080"><b>💸 על הנהג / שליח למסור החזר כספי בסך <span style="float: left; background-color: #808080;color:yellow;padding:5px">@refund_amount.ToString("C", culture)</span> </b></div>
                <div class="B" style="border-bottom:1px dotted #808080"><b>☝️ סך הכל לאיסוף <span style="float: left; background-color: #278200; color: white; padding: 5px">@after_refund_total.ToString("C", culture)</span> </b></div>
            }


        </div>

    </div>


    db.Close();
}

@helper OrderLog(int order_id)
