                                @switch (order_type)
                                {
                                    case "":
                                    case "ROUND":
                                        <b>🚚 סבב חלוקה</b>
                                        break;
                                    case "EXPRESS":
                                        <b>🛵 משלוח אקספרס</b>
                                        break;
                                    case "PICKUP":
