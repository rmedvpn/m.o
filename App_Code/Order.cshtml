@helper NewOrderApproval(int order_id, string orderbody, int order_status = -9999, string order_type = "")
{
    string actionTxt = "";
    string headerTxt = "";
    string supplyTxt = "";
    DateTime local_time = AppFunctions.LocalTime();


    var u_id = WebSecurity.CurrentUserId;
    var db = WebMatrix.Data.Database.Open("op_data");
    var sqlSelect = "SELECT * FROM MainOrders WHERE order_id=@0";
    sqlSelect = "SELECT * FROM MainOrders WHERE order_id=@0";
    var order_data = db.QuerySingle(sqlSelect, order_id);
    int round_id = 0; try { round_id = order_data.round_id; } catch { }
    sqlSelect = "SELECT z_serial,active_delivery_id FROM rounds WHERE id=@0";
    var round_data = db.QuerySingle(sqlSelect, round_id);
    int z_serial = 0; try { z_serial = round_data.z_serial; } catch { }
    int active_delivery_id = 0; try { active_delivery_id = round_data.active_delivery_id; } catch { }

    int delivery_id = 0; try { delivery_id = order_data.delivery_id; } catch { }
    sqlSelect = "SELECT TOP(1) order_id FROM orderitems WHERE order_id=@0 AND p_id>0";
    var itemsChk = db.QuerySingle(sqlSelect, order_id);
    bool is_empty_order = false;
    if (itemsChk == null) { is_empty_order = true; }

    DateTime requested_delivery_date = local_time; try { requested_delivery_date = order_data.requested_delivery_date; } catch { }
    string shipping_time = ""; try { shipping_time = order_data.shipping_time; } catch { }
    string ship_city = ""; try { ship_city = order_data.ship_city; } catch { }
    string requested_delivery_window_start_hour = ""; try { requested_delivery_window_start_hour = order_data.requested_delivery_window_start_hour; } catch { }
    string requested_delivery_window_end_hour = ""; try { requested_delivery_window_end_hour = order_data.requested_delivery_window_end_hour; } catch { }
    supplyTxt = "בין שעה " + requested_delivery_window_start_hour + " לשעה " + requested_delivery_window_end_hour;

    string unverified_order_items = ""; try { unverified_order_items = OrderFunctions.VerifyOrderItems(order_id, round_id); } catch { }

    if (requested_delivery_window_start_hour == "00:00" && requested_delivery_window_end_hour == "23:59") { supplyTxt = ""; }
    else
    {
        if (requested_delivery_window_start_hour == "00:00" && requested_delivery_window_end_hour != "23:59") { supplyTxt = "עד " + requested_delivery_window_end_hour; }
        if (requested_delivery_window_start_hour != "00:00" && requested_delivery_window_end_hour == "23:59") { supplyTxt = "אחרי " + requested_delivery_window_start_hour; }
    }

    try { order_type = order_data.order_type; } catch { }

    if (round_id == 0)
    {
        order_type = "";
    }

    switch (order_status)
    {

        case 0:
            actionTxt = "❗ נא לוודא את ההזמנה";
            headerTxt = "הזמנה חדשה";

            break;

        case -1:
            actionTxt = "❗ נא לוודא הוספת פריטים בהתאם לבקשת הקונה";
            headerTxt = "הזמנה מיובאת";
            break;


        case -2:
            actionTxt = "❗ נא לוודא את תקינות ההזמנה";
            headerTxt = "הזמנה שעברה מסבב אחר";
            break;

        default:
            actionTxt = "❗ נא לוודא הוספת פריטים בהתאם לבקשת הקונה";
            headerTxt = NewAppFunctions.GetTitleById("OrderStatus", order_status);
            break;

    }

    <center>
        <div style=" overflow: auto; background-color: white; font-size: 18px; text-align: right">
            <div class="A">
                <span class="PrplMiniTag" style="float:left;display:none">@headerTxt</span>
                <h3>אישור @headerTxt</h3>
                <div class="A">
                    <b>@AppFunctions.GetRoundTitleById(round_id)</b>
                    <div class="B" style="float:left">
                        @switch (order_type)
                        {
                            case "":
                            case "FUTURE":
                                <div><b>🌎 הזמנה עתידית</b></div>
                                break;
                            case "ROUND":
                                <div><b>🚚 סבב חלוקה</b></div>
                                break;
                            case "EXPRESS":
                                <div><b>🛵 משלוח אקספרס</b></div>
                                break;
                            case "PICKUP":
                                <div><b>🏠 איסוף עצמי</b></div>
                                break;
                            default:
                                <div><b>@order_type</b></div>
                                break;

                        }

                    </div>
                </div>

                <div class="B" style="border-top:1px dotted #808080;">
                    <button class="OrderSectionCartBtn" style="float: left;" onclick="sbload('SubMenuLeft','Caller?p1=OrderItemsEdit&p2=@order_id');">
                        <span style="background-color:white;border-radius:5px;padding:1px">🛍️</span> הוספת פריטים
                    </button>
                    <div class="A">
                        <b>@actionTxt</b>
                    </div>

                    <div class="A">
                        👈 @orderbody
                    </div>

                    <div class="A">
                        <div class="B">
                            <div class="B" style="float:left">
                                <span class="PrplMiniTag">@supplyTxt</span>
                            </div>
                            @switch (order_type)
                            {
                                case "":
                                case "FUTURE":

                                    <div class="B">
                                        <span><b>🌎 לאספקה @AppFunctions.FormatRelativeDate(requested_delivery_date)</b></span>
                                    </div>

                                    break;
                                case "ROUND":
                                    if (true)
                                    {

                                        sqlSelect = "SELECT serial,scheduled_start,scheduled_end FROM deliveries WHERE ((round_id=@0 AND scheduled_start>@1) OR z_serial=@2 OR serial=@3) AND has_started=0 AND is_completed=0 ORDER BY scheduled_start DESC";
                                        var deliveries = db.Query(sqlSelect, round_id, local_time, z_serial, active_delivery_id);
                                        if (deliveries.Count() == 0)
                                        {
                                            deliveries = db.Query(sqlSelect, round_id, local_time, z_serial, active_delivery_id);
                                        }


                                        <div class="B">
                                            <span>🌎 תאריך אספקה מבוקש <b>@AppFunctions.FormatRelativeDate(requested_delivery_date) </b></span>
                                        </div>
