            @if (orders_counter > 0)
            {
                <div style="overflow: auto; -webkit-overflow-scrolling: touch; background-color: #808080;direction:rtl " id="round_board_container">
                    <center>
                        <table style="font-size: 16px; border-collapse: collapse; background-color: white;width:90% ">
                            <tr style=";font-size:18px;">
