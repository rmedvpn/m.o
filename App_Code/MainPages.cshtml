                                <td class="header"></td>
                                <td class="header">ערוץ</td>
                                <td class="header">הזמנה</td>
                                <td class="header">שם</td>
                                <td class="header">עיר</td>
                                <td class="header">סטטוס</td>
                                <td class="header"></td>

                            </tr>
                            @if (order_data.Count() != 0)
                            {
                                foreach (var order in order_data)
                                {
                                    if (true)
                                    {
                                        string colorPickerClass = "";
                                        string colorPickerIcon = "";
                                        string order_type = ""; try { order_type = order.order_type; } catch { }
                                        bool is_postponed = false; try { is_postponed = order.is_postponed; } catch { }
                                        string round_short_title = ""; try { round_short_title = order.round_title; } catch { }
                                        round_id = order.round_id;
                                        if (round_short_title == "")
                                        {
                                            sqlSelect = "SELECT short_title FROM rounds WHERE id=@0";
                                            var round = db.QuerySingle(sqlSelect, round_id);
                                            round_short_title = ""; try { round_short_title = round.short_title; } catch { }
                                        }
                                        switch (order_type)
                                        {
                                            case "ROUND":
                                                if (true)
                                                {
                                                    colorPickerIcon = "🚚";

                                                }
                                                break;
                                            case "PICKUP":
                                                if (true)
                                                {
                                                    colorPickerIcon = "🏠";

                                                }
                                                break;
                                            case "EXPRESS":
                                                if (true)
                                                {
                                                    colorPickerIcon = "🛵";

                                                }
                                                break;
                                        }

