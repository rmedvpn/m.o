    public static int CreateOrderEnvelopeId(int order_id, bool is_update = true)
    {
        int envelope_id = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");

        var sqlSelect = "SELECT round_id FROM MainOrders WHERE order_id=@0";
        var Order = db.QuerySingle(sqlSelect, order_id);
        int round_id = 0; try { round_id = Order.round_id; } catch { }
        sqlSelect = "SELECT MAX(envelope_id) as envelope_id FROM mainorders WHERE z_id=0 AND round_id=@0";
        Order = db.QuerySingle(sqlSelect, round_id);


        if (Order != null)
        {
            int max_envelope_id = Order.envelope_id;
            envelope_id = max_envelope_id + 1;
        }

        if (is_update)
        {
            sqlSelect = "UPDATE mainorders SET envelope_id=@0 WHERE order_id=@1";
            db.Execute(sqlSelect, envelope_id, order_id);
        }

        db.Close();
        return envelope_id;
    }
