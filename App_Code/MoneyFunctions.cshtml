    public static decimal GetMemberDebt(int member_id = 0, bool due_only = true)
    {
        decimal member_debt = 0;
        DateTime local_time = AppFunctions.LocalTime();

        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT SUM(amount_due) as amount_due FROM chargebook WHERE is_paid=0 AND m_id=@0 AND current_due_date<=@1";
        if (!due_only)
        {
            sqlSelect = "SELECT SUM(amount_due) as amount_due FROM chargebook WHERE is_paid=0 AND m_id=@0";
        }
        var currDueAmount = db.QuerySingle(sqlSelect, member_id, local_time.Date);
        try { member_debt = currDueAmount.amount_due; } catch { }

        db.Close();
        return member_debt;
    }

    public static decimal GetMemberCreditLimit(int member_id = 0)
    {
        decimal cur_debt = 0;
        decimal credit_limit = 0;
        DateTime local_time = AppFunctions.LocalTime();

        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT SUM(amount_due) as amount_due FROM chargebook WHERE is_paid=0 AND m_id=@0";
        var currDueAmount = db.QuerySingle(sqlSelect, member_id);
        try { cur_debt = currDueAmount.amount_due; } catch { }

        sqlSelect = "SELECT credit_limit FROM pb WHERE m_id=@0";
        var member = db.QuerySingle(sqlSelect, member_id);
        try { credit_limit = member.credit_limit; } catch { }

        credit_limit = credit_limit - cur_debt;

        db.Close();
        return credit_limit;
    }

    public static int RegisterOrderCredit(int order_id, DateTime due_date, decimal amount, string creditnote, bool is_pending = true)
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        int transaction_id = 0;
        DateTime local_time = AppFunctions.LocalTime();
        string logMsg = "";
        var u_id = WebSecurity.CurrentUserId;
        var db = WebMatrix.Data.Database.Open("op_data");
        int member_id = 0;
        int vendor_id = 0;
        int t_type = 0;

        var sqlSelect = "SELECT u_id,vendor_id,round_id FROM MainOrders WHERE order_id=@0";
        var order = db.QuerySingle(sqlSelect, order_id);

        if (order != null)
        {
            member_id = order.u_id;

            DateTime LocalTime = AppFunctions.LocalTime();
            DateTime default_date = Convert.ToDateTime("1/1/1900");
            bool next_order_return = false;
            if (due_date == AppFunctions.GetNorDate())
            {
                next_order_return = true;
            }
            DateTime nextDueDate = Convert.ToDateTime("1/1/1900"); ;
            decimal totalDebtAmount = 0;


            sqlSelect = "INSERT INTO ChargeBook(ts,m_id,transaction_type,amount,amount_due,rep_id,vendor_id,transaction_notes,original_due_date,current_due_date,credit_ts,next_order_return,order_id,is_pending) ";
            sqlSelect += " VALUES(@0,@1,@2,@3,@3,@4,@5,@6,@7,@7,@8,@9,@10,@11)";
            db.Execute(sqlSelect, local_time, member_id, t_type, amount, u_id, vendor_id, creditnote, due_date, local_time, next_order_return, order_id, is_pending);

            sqlSelect = "SELECT serial FROM ChargeBook WHERE ts=@0 AND order_id=@1";
            var transaction = db.QuerySingle(sqlSelect, local_time, order_id);
            try { transaction_id = transaction.serial; } catch { }

            sqlSelect = "UPDATE mainorders SET credit_transaction_id=@0 WHERE order_id=@1";
            db.Execute(sqlSelect, transaction_id, order_id);

            logMsg = "אושר חיוב אשראי בסך " + amount.ToString("C", culture) + " עד לתאריך " + due_date.ToShortDateString();
            if (next_order_return)
            {
                logMsg = " אושר חיוב אשראי בסך " + amount.ToString("C", culture) + " לתשלום בהזמנה הבאה ";
            }



            AppFunctions.WriteOrderComment(order_id, logMsg);

            if (!is_pending)
            {
                sqlSelect = "SELECT SUM(amount_due) AS the_sum FROM ChargeBook WHERE m_id=@0 AND is_paid=0";
                var totDebt = db.QuerySingle(sqlSelect, member_id);
                try { totalDebtAmount = totDebt.the_sum; } catch { }

                if (totalDebtAmount > 0)
                {
                    sqlSelect = "SELECT MIN(current_due_date) AS payment_due FROM ChargeBook WHERE m_id=@0 AND is_paid=0";
                    totDebt = db.QuerySingle(sqlSelect, member_id);
                    try { nextDueDate = totDebt.payment_due; } catch { }
                }

                sqlSelect = "UPDATE pb SET debt=@0,due_date=@1,credit_ts=@2,next_order_return=@3 WHERE m_id=@4";
                db.Execute(sqlSelect, totalDebtAmount, nextDueDate, local_time, next_order_return, member_id);

                logMsg = " נרשם חיוב אשראי בסך " + amount.ToString("C", culture) + " עד לתאריך " + due_date.ToShortDateString();
                if (next_order_return)
                {
                    logMsg = " נרשם חיוב אשראי בסך " + amount.ToString("C", culture) + " לתשלום בהזמנה הבאה ";
                }

                logMsg += " עבור הזמנה #" + order_id;

                AppFunctions.WriteUserNoteComment(member_id, logMsg);
            }

        }





        db.Close();
        return transaction_id;
    }

    public static decimal RoundUpAmount(double amount, double RoundTo = 50)
    {
        decimal RoundAmount = 0;
        double amount_rounded = Math.Floor(amount / RoundTo) * RoundTo;
        if (amount_rounded != amount && amount_rounded > 0)
        {
            amount_rounded = amount_rounded + RoundTo;
        }

        RoundAmount = Convert.ToDecimal(amount_rounded - amount);
        return RoundAmount;
    }

    public static decimal GetOrderItemsCost(int order_id, string ItemsTable = "OrderItems")
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        decimal items_cost = 0;
        DateTime local_time = AppFunctions.LocalTime();
        string logMsg = "";
        var u_id = WebSecurity.CurrentUserId;
        var db = WebMatrix.Data.Database.Open("op_data");

        var sqlSelect = "SELECT cost,quan FROM " + ItemsTable + " WHERE order_id=@0";
        var orderItems = db.Query(sqlSelect, order_id);

        foreach(var item in orderItems)
        {
            decimal item_cost = item.cost * item.quan;
            items_cost += item_cost;
        }




        db.Close();
        return items_cost;
    }

