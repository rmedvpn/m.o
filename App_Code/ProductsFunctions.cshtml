        string theHtmlOutput = "";
        DateTime local_time = AppFunctions.LocalTime();

        int rep_id = WebSecurity.CurrentUserId;
        string theValue = Request["value"];
        var db = Database.Open("op_data");
        var sqlSelect = "";

        int tag_id = 0; try { tag_id = Convert.ToInt32(Request["tag_id"]); } catch { }
        int cat_id = 0; try { cat_id = Convert.ToInt32(Request["cat_id"]); } catch { }
        int product_type_id = 0; try { product_type_id = Convert.ToInt32(Request["p_t_id"]); } catch { }
        int p_id = 0; try { p_id = Convert.ToInt32(Request["p_id"]); } catch { }
        int tag_type = 0; try { tag_type = Convert.ToInt32(Request["tag_type"]); } catch { }

        string title = ""; title = Request["custom_tag_title"];
        string title_e = ""; title_e = Request["custom_tag_e_title"];
        string values_list = ""; values_list = Request["values_list"];
        bool is_active = false; if (!Request["is_active"].IsEmpty()) { is_active = true; }

        if (title.IsEmpty())
        {
            theHtmlOutput += "חובה להזין כותרת לשדה<br>";
        }
        if (title_e.IsEmpty())
        {
            theHtmlOutput += "חובה להזין כותרת אנגלית לשדה<br>";
        }



        if (tag_type == 2) // select list field type
        {
            int valueCount = values_list
                .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None)
                .Count(x => !string.IsNullOrWhiteSpace(x));

            if (valueCount < 2)
            {
                // Error: At least two values are required.
                theHtmlOutput += "לא ניתן להוסיף רשימת בחירה ללא 2 אפשרויות לפחות<br>";
            }
            else
            {
                values_list = string.Join(Environment.NewLine, values_list.Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None).Select(x => x.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)));
            }

        }

        if (theHtmlOutput == "")
        {


            sqlSelect = "UPDATE pTags SET cat_id=@1,p_id=@2,p_t_id=@3,tag_type=@4,title_h=@5,title_e=@6,is_active=@7,values_list=@8,is_update=1 WHERE id=@0";
            db.Execute(sqlSelect, tag_id, cat_id, p_id, product_type_id, tag_type, title, title_e, is_active, values_list);


            db.Close();
            theHtmlOutput = " 👌 השינויים בשדה נשמרו! ";
        }
        return theHtmlOutput;
    }


