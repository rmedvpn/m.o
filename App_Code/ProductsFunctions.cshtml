    public static string CreateCustomFieldsJson(int main_cat_id, int sub_cat_id, int product_type, out string validationErrors)
    {
        validationErrors = "";

        var db = Database.Open("op_data");
        var sqlSelect = @"SELECT * FROM customFields WHERE is_active=1 AND (cat_id=@0 OR cat_id=@1 OR p_t_id=@2) ORDER BY is_required DESC, sort_order";
        var customFields = db.Query(sqlSelect, main_cat_id, sub_cat_id, product_type);
        var customFieldsList = new List<Dictionary<string, object>>();
        HttpRequest request = HttpContext.Current.Request;

        foreach (var fld in customFields)
        {
            int fieldId = 0; try { fieldId = Convert.ToInt32(fld.id); } catch { continue; }
            int fieldTypeId = 0; try { fieldTypeId = Convert.ToInt32(fld.fieldType_id); } catch { }
            bool isRequired = false; try { isRequired = Convert.ToBoolean(fld.is_required); } catch { }
            string fieldNameHebrew = ""; try { fieldNameHebrew = Convert.ToString(fld.title); } catch { }
            string fieldNameEnglish = ""; try { fieldNameEnglish = Convert.ToString(fld.title_e); } catch { }

            string inputName = "CusFld_" + fieldId;
            string inputNameEnglish = "CusFld_" + fieldId + "_e";
            string valueHebrew = request[inputName] ?? "";
            string valueEnglish = request[inputNameEnglish] ?? "";

            valueHebrew = valueHebrew.Trim();
            valueEnglish = valueEnglish.Trim();

            bool isFieldValid = false;
            object validatedValue = null;
            string validatedValueHebrew = "";
            string validatedValueEnglish = "";

            switch (fieldTypeId)
            {
                // Bilingual text
                case 1:
                case 2:
                    {
                        bool hebrewIsValid = !String.IsNullOrWhiteSpace(valueHebrew);
                        bool englishIsValid = !String.IsNullOrWhiteSpace(valueEnglish);

                        if (hebrewIsValid && englishIsValid)
                        {
                            validatedValueHebrew = valueHebrew;
                            validatedValueEnglish = valueEnglish;
                            isFieldValid = true;
                        }
                        else if (isRequired)
                        {
                            if (!hebrewIsValid) validationErrors += "השדה " + fieldNameHebrew + " הוא שדה חובה!<BR>";
                            if (!englishIsValid) validationErrors += "השדה " + fieldNameEnglish + " הוא שדה חובה!<BR>";
                        }

                        break;
                    }

                // Decimal
                case 3:
                case 6:
                    {
                        decimal decimalValue = 0;
                        bool decimalIsValid = decimal.TryParse(valueHebrew, NumberStyles.Any, CultureInfo.CurrentCulture, out decimalValue);

                        if (decimalIsValid && decimalValue > 0)
                        {
                            validatedValue = decimalValue;
                            isFieldValid = true;
                        }
                        else if (isRequired)
                        {
                            validationErrors += "חובה להזין מספר תקין בשדה " + fieldNameHebrew + "!<BR>";
                        }

                        break;
                    }

                // Boolean / checkbox
                case 4:
                    {
                        string booleanString = valueHebrew.ToLowerInvariant();
                        bool booleanValue = false;
                        bool booleanIsValid = true;

                        if (booleanString == "true" || booleanString == "on" || booleanString == "1" || booleanString == "yes")
                        {
                            booleanValue = true;
                        }
                        else if (booleanString == "" || booleanString == "false" || booleanString == "off" || booleanString == "0" || booleanString == "no")
                        {
                            booleanValue = false;
                        }
                        else
                        {
                            booleanIsValid = false;
                        }

                        if (booleanIsValid)
                        {
                            validatedValue = booleanValue;
                            isFieldValid = true;
                        }
                        else if (isRequired)
                        {
                            validationErrors += "יש להזין ערך תקין בשדה " + fieldNameHebrew + "!<BR>";
                        }

                        break;
                    }

                // Date
                case 5:
                    {
                        DateTime dateValue;
                        bool dateIsValid = DateTime.TryParse(valueHebrew, out dateValue);

                        if (dateIsValid)
                        {
                            validatedValue = dateValue.ToString("yyyy-MM-dd");
                            isFieldValid = true;
                        }
                        else if (isRequired)
                        {
                            validationErrors += "חובה להזין תאריך תקין בשדה " + fieldNameHebrew + "!<BR>";
                        }

                        break;
                    }

                // Integer
                case 7:
                    {
                        int integerValue = 0;
                        bool integerIsValid = int.TryParse(valueHebrew, out integerValue);

                        if (integerIsValid && integerValue > 0)
                        {
                            validatedValue = integerValue;
                            isFieldValid = true;
                        }
                        else if (isRequired)
                        {
                            validationErrors += "חובה להזין מספר תקין בשדה " + fieldNameHebrew + "!<BR>";
                        }

                        break;
                    }

                // Select
                case 8:
                    {
                        if (!String.IsNullOrWhiteSpace(valueHebrew))
                        {
                            string[] valueParts = valueHebrew.Split(new string[] { "##" }, StringSplitOptions.None);

                            validatedValueHebrew = valueParts.Length > 0 ? valueParts[0].Trim() : "";
                            validatedValueEnglish = valueParts.Length > 1 ? valueParts[1].Trim() : "";

                            if (validatedValueHebrew != "" && validatedValueEnglish != "")
                            {
                                isFieldValid = true;
                            }
                            else if (isRequired)
                            {
                                validationErrors += "יש לבחור ערך תקין בשדה " + fieldNameHebrew + "!<BR>";
                            }
                        }
                        else if (isRequired)
                        {
                            validationErrors += "השדה " + fieldNameHebrew + " הוא שדה חובה!<BR>";
                        }

                        break;
                    }
            }


            if (isFieldValid)
            {
                var customField = new Dictionary<string, object>();

                customField.Add("id", fieldId);
                customField.Add("NameHeb", fieldNameHebrew);
                customField.Add("NameEng", fieldNameEnglish);
                customField.Add("TypeId", fieldTypeId);

                switch (fieldTypeId)
                {
                    case 1:
                    case 2:
                    case 8:
                        customField.Add("ValHeb", validatedValueHebrew);
                        customField.Add("ValEng", validatedValueEnglish);
                        break;

                    default:
                        customField.Add("val", validatedValue);
                        break;
                }

                customFieldsList.Add(customField);
            }

        }
        var jsonSerializer = new JavaScriptSerializer();
        return jsonSerializer.Serialize(customFieldsList);
    }



    public static string SaveProductTags()
    {

        int u_id = WebSecurity.CurrentUserId;

        string theHtmlOutput = "";
        string logMsg = "";
        string theValue = Request["value"];
        int p_id = 0; try { p_id = Convert.ToInt32(theValue); } catch { }
        int p_t_id = 0;
        int cat_id = 0;
        string retTxt = "";
        string SelectedCat = Request["SelectedCat"];
        string ProductTagsJSON = "";
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT maincat_id, sub_cat_id, product_type, custom_fields_json FROM Products WHERE p_id=@0";
        var product = db.QuerySingle(sqlSelect, p_id);
        if (product != null)
        {
            int main_cat_id = 0; try { main_cat_id = Convert.ToInt32(product.maincat_id); } catch { }
            int sub_cat_id = 0; try { sub_cat_id = Convert.ToInt32(product.sub_cat_id); } catch { }
            p_t_id = 0; try { p_t_id = Convert.ToInt32(product.product_type); } catch { }
            sqlSelect = "SELECT * FROM pTags WHERE is_active=1 AND (cat_id=@0 OR cat_id=@1 OR p_t_id=@2) ORDER BY sort_order";
            var Tags = db.Query(sqlSelect, main_cat_id, sub_cat_id, p_t_id);

            var productTags = new List<Dictionary<string, object>>();

            foreach (var tag in Tags)
            {
                string tagStr = "##" + tag.id + "##";
                bool is_selected = SelectedCat.Contains(tagStr);

                if (is_selected)
                {
                    bool is_fav = Request["is_tag_fav_" + tag.id] == "true";
                    string title_h = ""; try { title_h = Convert.ToString(tag.title_h); } catch { }
                    string title_e = ""; try { title_e = Convert.ToString(tag.title_e); } catch { }

                    if (Convert.ToInt32(tag.tag_type) == 2)
                    {
                        string selVal = ""; try { selVal = Request["tag_value_" + tag.id]; } catch { }

                        if (!String.IsNullOrWhiteSpace(selVal))
                        {
                            string[] resArr = selVal.Split(new string[] { "##" }, StringSplitOptions.None);

                            if (resArr.Length > 0) { title_h = resArr[0].Trim(); }
                            if (resArr.Length > 1) { title_e = resArr[1].Trim(); }
                        }
                    }

                    var tagItem = new Dictionary<string, object>();
                    tagItem.Add("id", Convert.ToInt32(tag.id));
                    tagItem.Add("he", title_h);
                    tagItem.Add("en", title_e);
                    tagItem.Add("fav", is_fav);
                    tagItem.Add("sort", tag.sort_order);

                    productTags.Add(tagItem);
                }
            }            //  theHtmlOutput = "!$!LIST:<br>" + retTxt + "<br>" + SelectedCat;
            productTags = productTags.OrderBy(x => Convert.ToInt32(x["sort"])).ToList();
            var serializer = new JavaScriptSerializer();
            ProductTagsJSON = serializer.Serialize(productTags);

            sqlSelect = "UPDATE products SET tags_json=@0 WHERE p_id=@1";
            db.Execute(sqlSelect, ProductTagsJSON, p_id);

            theHtmlOutput = "הפעולה בוצעה בהצלחה!";
        }
        db.Close();
        //string description = Request.Unvalidated["description"];
        //string e_desc = Request.Unvalidated["e_desc"];



        return theHtmlOutput;
    }




