    public static void DoProductOptionsSequencing(int p_id)
    {

        var db = Database.Open("op_data");
        var sqlSelect = "SELECT option_id FROM ProductOptions WHERE  is_deleted=0 AND p_id=@0 ORDER BY sort_order";
        var fieldRs = db.Query(sqlSelect, p_id);
        int i = 0;
        foreach (var item in fieldRs)
        {
            i += 100;
            sqlSelect = "UPDATE ProductOptions SET sort_order=@0 WHERE option_id=@1";
            db.Execute(sqlSelect, i, item.option_id);
        }
        db.Close();
        return;
    }
    public static void DoProductOptionsItemSequencing(int option_id)
    {

        var db = Database.Open("op_data");
        var sqlSelect = "SELECT serial FROM ProductOptionsItems WHERE is_deleted=0 AND option_id=@0 ORDER BY sort_order";
        var fieldRs = db.Query(sqlSelect, option_id);
        int i = 0;
        foreach (var item in fieldRs)
        {
            i += 100;
            sqlSelect = "UPDATE ProductOptionsItems SET sort_order=@0 WHERE serial=@1";
            db.Execute(sqlSelect, i, item.serial);
        }

        sqlSelect = "SELECT min_choices,max_choices FROM ProductOptions WHERE option_id=@0";
        var opt = db.QuerySingle(sqlSelect, option_id);
        int min_choices = 0; try { min_choices = opt.min_choices; } catch { }
        int max_choices = 0; try { max_choices = opt.max_choices; } catch { }
        sqlSelect = "SELECT COUNT(serial) AS the_cnt FROM ProductOptionsItems WHERE is_Deleted=0 AND is_active=1 AND option_id=@0";
        var ProductOptionsItems = db.QuerySingle(sqlSelect, option_id);
        int cur_items_cnt = 0; try { cur_items_cnt = ProductOptionsItems.the_cnt; } catch { }

        if (cur_items_cnt < min_choices || cur_items_cnt < max_choices || cur_items_cnt == 0)
        {

            sqlSelect = "UPDATE ProductOptions SET is_active=0 WHERE option_id=@0";
            db.Execute(sqlSelect, option_id);
        }
        db.Close();
        return;
    }
