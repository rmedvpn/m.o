    public static string ProductTagMove()
    {
        string theHtmlOutput = "";
        int rec_id = 0; try { rec_id = Convert.ToInt32(Request["value"]); } catch { }
        int tag_id = 0; try { tag_id = Convert.ToInt32(Request["param1"]); } catch { }
        string direction = ""; direction = Request["param2"];

        var db = Database.Open("op_data");
        var sqlSelect = "SELECT id,sort_order FROM pTags WHERE id=@0";
        var item = db.QuerySingle(sqlSelect, tag_id);
        int cur_sort_order = 0; try { cur_sort_order = item.sort_order; } catch { }
        int new_sort_order = cur_sort_order;
        if (direction == "up")
        {
            new_sort_order = new_sort_order - 101;
        }
        else
        {
            new_sort_order = new_sort_order + 101;
        }
        sqlSelect = "UPDATE pTags SET sort_order=@0 WHERE id=@1";

        db.Execute(sqlSelect, new_sort_order, tag_id);
        db.Close();
        ProductsFunctions.DoProductTagsSequencing(tag_id);

        theHtmlOutput = "הפעולה בוצעה!";


        return theHtmlOutput;
    }


    public static void DoProductTagsSequencing(int tag_id)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT id,cat_id,p_t_id FROM pTags WHERE  id=@0 ";
        var tag = db.QuerySingle(sqlSelect, tag_id);
        int cat_id = 0;
        int p_t_id = 0;
        try { cat_id = tag.cat_id; } catch { }
        try { p_t_id = tag.p_t_id; } catch { }

        int rec_id = 0;
        if (p_t_id > 0)
        {
            sqlSelect = "SELECT id,cat_id,p_t_id FROM pTags WHERE  is_deleted=0 AND p_t_id =@0";
            rec_id = p_t_id;
        }
        if (cat_id > 0)
        {
            sqlSelect = "SELECT id,cat_id,p_t_id FROM pTags WHERE  is_deleted=0 AND cat_id =@0";
            rec_id = cat_id;
        }

        sqlSelect += " ORDER BY sort_order";

        var tagRs = db.Query(sqlSelect, rec_id);
        int i = 0;
        foreach (var item in tagRs)
        {
            i += 100;
            sqlSelect = "UPDATE pTags SET sort_order=@0 WHERE id=@1";
            db.Execute(sqlSelect, i, item.id);
        }
        db.Close();
        return;
    }


