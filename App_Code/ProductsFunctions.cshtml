                            theHtmlOutput = " 👌 האפשרות התווספה למחירון ";

                        }

                    }




                    //update lowest unit price field in applicable menus
                    if (menu_id != 99999)
                    {
                        //if option was added to a specific menu
                        sqlSelect = "SELECT MIN(price/quan) AS min_price FROM ProductPricingOptions WHERE p_id=@0 AND (round_id=@1 OR round_id=99999)";
                        checkRs = db.QuerySingle(sqlSelect, p_id, menu_id);
                        if (checkRs != null)
                        {
                            sqlSelect = "UPDATE roundMenuItems SET curLowestUnitPrice=@0 WHERE round_id=@1 AND p_id=@2";
                            db.Execute(sqlSelect, checkRs.min_price, menu_id, p_id);
                        }
                        else
                        {
                            sqlSelect = "UPDATE roundMenuItems SET curLowestUnitPrice=0 WHERE round_id=@0 AND p_id=@1";
                            db.Execute(sqlSelect, menu_id, p_id);
                        }
                    }
                    else
                    { //if option was added to all menus
                        sqlSelect = "SELECT DISTINCT (round_id) as round_id FROM roundMenuItems WHERE p_id=@0";
                        var AvailableMenus = db.Query(sqlSelect, p_id);
                        foreach (var menu in AvailableMenus)
                        {
                            sqlSelect = "SELECT MIN(price/quan) AS min_price FROM ProductPricingOptions WHERE p_id=@0 AND (round_id=@1 OR round_id=99999)";
                            checkRs = db.QuerySingle(sqlSelect, p_id, menu.round_id);
                            if (checkRs != null)
                            {
                                sqlSelect = "UPDATE roundMenuItems SET curLowestUnitPrice=@0 WHERE round_id=@1 AND p_id=@2";
                                db.Execute(sqlSelect, checkRs.min_price, menu.round_id, p_id);
                            }
                            else
                            {
                                sqlSelect = "UPDATE roundMenuItems SET curLowestUnitPrice=0 WHERE round_id=@0 AND p_id=@1";
                                db.Execute(sqlSelect, menu.round_id, p_id);
                            }

                        }

                    }


                }
                else
                {
                    theHtmlOutput = "!$!" + theHtmlOutput;
                }


            }
            else
            {
                theHtmlOutput = "!$!" + theHtmlOutput;
            }
        }

        return theHtmlOutput;

    }

