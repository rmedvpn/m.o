    public static void DoCustomFieldSequencing(int field_id)
    {
        DataFunctions.WriteDebugLine("field_id " + field_id);
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT id,cat_id,p_t_id FROM customFields WHERE  id=@0 ";
        var fld = db.QuerySingle(sqlSelect, field_id);
        int cat_id = 0;
        int p_t_id = 0;
        DataFunctions.WriteDebugLine("fld.p_t_id " + fld.p_t_id);
        try { cat_id = fld.cat_id; } catch { }
        try { p_t_id = fld.p_t_id; } catch { }

        int rec_id = 0;
        DataFunctions.WriteDebugLine("cat_id " + cat_id);
        DataFunctions.WriteDebugLine("p_t_id " + p_t_id);
        if (p_t_id > 0)
        {
            sqlSelect = "SELECT id,cat_id,p_t_id FROM customFields WHERE  is_deleted=0 AND p_t_id =@0";
            rec_id = p_t_id;
        }
        if (cat_id > 0)
        {
            sqlSelect = "SELECT id,cat_id,p_t_id FROM customFields WHERE  is_deleted=0 AND cat_id =@0";
            rec_id = cat_id;
        }

        DataFunctions.WriteDebugLine("rec_id " + rec_id);
        sqlSelect += " ORDER BY sort_order";

        var fieldRs = db.Query(sqlSelect, rec_id);
        int i = 0;
        foreach (var item in fieldRs)
        {
            i += 100;
            sqlSelect = "UPDATE customFields SET sort_order=@0 WHERE id=@1";
            db.Execute(sqlSelect, i, item.id);
            DataFunctions.WriteDebugLine("item.id " + item.id + " sort orer: " + i);
        }
        db.Close();
        return;
    }


