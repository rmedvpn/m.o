    public static string CreateVendorProductFromCatalog()
    {
        string theHtmlOutput = "";
        int u_id = WebSecurity.CurrentUserId;
        string theValue = Request["value"];
        if (true)
        {
            int p_id = 0; try { p_id = Convert.ToInt32(Request["value"]); } catch { }
            int vendor_id = 0; try { vendor_id = Convert.ToInt32(Request["vendor_id"]); } catch { }
            bool is_pictures = true; if (Request["is_pictures"].IsEmpty()) { is_pictures = false; }
            bool is_pricing = true; if (Request["is_pricing"].IsEmpty()) { is_pricing = false; }
            if (vendor_id == 0)
            {
                theHtmlOutput += "חובה לבחור אפשרות יצירת מוצר<BR>";
            }

            if (theHtmlOutput == "")
            {
                var db = Database.Open("op_data");
                var sqlSelect = "";

                sqlSelect = "SELECT * FROM products WHERE p_id=@0";
                var rec = db.QuerySingle(sqlSelect, p_id);

                if (!rec.is_setup || !rec.init_complete)
                {
                    theHtmlOutput += "לא ניתן להעתיק מוצר שתהליך ההגדרה שלו לא הסתיים<BR>";
                }

                if (theHtmlOutput == "")
                {
                    sqlSelect = "SELECT * FROM vendors WHERE is_Active=1 order by vendor_id";
                    var vendors = db.Query(sqlSelect);

                    if (vendor_id > 0)
                    {

                        ProductsFunctions.CreateProductCopy(rec, p_id, vendor_id, is_pricing, is_pictures);

                    }
                    else
                    {

                        if (vendor_id == -2)
                        {
                            vendor_id = 0;
                            ProductsFunctions.CreateProductCopy(rec, p_id, vendor_id, is_pricing, is_pictures);
                        }
                        else
                        {
                            foreach (var vendor in vendors)
                            {
                                vendor_id = vendor.vendor_id;
                                ProductsFunctions.CreateProductCopy(rec, p_id, vendor_id, is_pricing, is_pictures);
                            }
                        }


                    }
                }


                db.Close();

                if (theHtmlOutput != "")
                {
                    theHtmlOutput = "!$!" + theHtmlOutput;
                }
                else
                {
                    theHtmlOutput = "המוצר נוצר בהצלחה ";
                }


            }
        }

        return theHtmlOutput;
    }

