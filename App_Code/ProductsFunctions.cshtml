    public static string GetCustomFieldValue(dynamic field, bool is_catalog,int lang=1)
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

        string FieldValue = "";
        string FieldValue_e = "";
        int u_id = WebSecurity.CurrentUserId;
        string fieldType = field.fieldType;
        bool tmpBoolValue = false; try { tmpBoolValue = field.boolvalue; } catch { }
        switch(fieldType)
        {
            case "SHORTTEXT":
                FieldValue = field.shortStringValue;
                FieldValue_e = field.shortStringValue_e;
                break;
            case "LONGTEXT":
                FieldValue = field.LongStringValue;
                FieldValue_e = field.LongStringValue_e;
                break;
            case "DATE":
                try { FieldValue = field.DateValue.ToString(); } catch { }
                break;

            case "PERCENT":
            case "AMOUNT":

                try { FieldValue = String.Format("{0:0.##}", field.DecimalValue); } catch { }

                if (fieldType == "AMOUNT"){ FieldValue += "₪"; }
                else{ FieldValue += "%"; }
                break;

            case "YESNO":
                if(tmpBoolValue)
                { FieldValue = "true"; }
                else
                { FieldValue = "false"; }
                break;
            case "INT":
                try { FieldValue = field.IntValue.ToString(); } catch { }

                break;


            default:

                break;
        }


        if (lang == 2)
        {
            FieldValue = FieldValue_e;
        }
        return FieldValue;
    }



