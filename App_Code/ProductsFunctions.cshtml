                optionItem.Add("he", itemTitleHeb);
                optionItem.Add("en", itemTitleEng);

                if (optionPrice != 0) optionItem.Add("price", optionPrice);
                if (!isAvailable) optionItem.Add("avail", false);

                optionItemsList.Add(optionItem);
            }

            var productOption = new Dictionary<string, object>();
            productOption.Add("id", optionId);
            productOption.Add("he", titleHeb);
            productOption.Add("en", titleEng);

            if (!isRequired) productOption.Add("req", false);




            if (minChoices > 0) productOption.Add("min", minChoices);
            if (maxChoices > 0) productOption.Add("max", maxChoices);
            if (defChoices > 0) productOption.Add("def", defChoices);
            if (isLimited) productOption.Add("limit", true);

            productOption.Add("items", optionItemsList);

            ProductOptionsList.Add(productOption);
        }

        var serializer = new JavaScriptSerializer();
        string json = serializer.Serialize(ProductOptionsList);

        if (update_product)
        {
            sqlSelect = "UPDATE Products SET product_options_json=@0 WHERE p_id=@1";
            db.Execute(sqlSelect, json, p_id);
        }

        db.Close();
        return json;
    }

