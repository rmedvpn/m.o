    public static void updateRoundsActiveOrdersCount()
    {
        var op_data = WebMatrix.Data.Database.Open("op_data");

        var sqlSelect = "SELECT * FROM rounds";
        var rounds = op_data.Query(sqlSelect);
        foreach (var round in rounds)
        {
            int round_id = round.id;
            sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM mainorders WHERE round_id=@0";
            var order = op_data.QuerySingle(sqlSelect, round_id);
            int orders_count = 0; try { orders_count = order.the_cnt; } catch { }
            if (orders_count > 0)
            {
                op_data.Execute("EXEC sys.sp_set_session_context @key = N'skip_sync', @value = 1;");
                sqlSelect = "UPDATE rounds SET active_orders=@0 WHERE id=@1";
                op_data.Execute(sqlSelect, orders_count, round_id);
                op_data.Execute(" EXEC sys.sp_set_session_context @key = N'skip_sync', @value = NULL;");

            }
        }
        op_data.Close();

    }


