                                            <input type="hidden" name="member_id" id="member_id" value="@member_id">
                                            <input type="hidden" name="provided_wanum" id="provided_wanum" value="@wanumized">
                                            <input type="hidden" name="contact_entry_id" id="contact_entry_id" value="0">

                                        </form>

                                        <button type="button" style="padding:5px;margin:5px;float:left" onclick="sbload('MainSb', 'Caller?p1=CONTACTRESPONSE', '','repForm_@prospect.serial');">שליחת הודעת ברוכים הבאים וסיום הרשמה</button>

                                        <button type="button" style="padding:5px;margin:5px;float:left;display:none" onclick="sbload('MainSb','Caller?p1=RegisterWebProspect&p2=@prospect.serial','','ProspectsRepActions');">סיום הרשמה</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="ListCell" style="">
                                        <div style="padding:5px;margin:5px;color:#000;overflow:auto">
                                            נבחר כינוי!
                                        </div>

                                    </div>

                                    <div style="padding: 5px; margin: 5px; color: #fff; overflow: auto;  ">
                                        <button type="button" style="padding:5px;margin:5px;float:left" onclick="sbload('MainSb','Caller?p1=RegisterWebProspect&p2=@prospect.serial','','ProspectsRepActions');">רישום למערכת</button>
                                    </div>
                                }



                                break;

                            case 5:
                            case 7:
                                <div style=" padding: 5px; margin: 5px;  overflow: auto;  ">
                                    @prospect.approval_notes<br />
                                    <button type="button" style="font-size:16px; padding: 5px;margin:5px;" onclick="sbload('MainSb','Caller?p1=WebProspectVerification&p2=@prospect.serial','','ProspectsRepActions');">אימות מחדש</button>
                                    <button type="button" style="font-size:16px; padding: 5px;margin:5px;" onclick="sbload('MainSb','Caller?p1=WebProspectVerification&p2=@prospect.serial','','ProspectsRepActions');">מחיקה סופית</button>
                                </div>

                                break;


                            case 9:
                                <div style="background-color:#b200ff;padding:5px;margin:5px;color:#fff;overflow:auto;">
                                    <form id="repForm_@prospect.serial">
                                        <input type="hidden" name="reachout_type" name="reachout_type" value="WELCOME">
                                        <input type="hidden" name="RepDefaultTemplate" id="RepDefaultTemplate" value="@DefaultWelcomeMsg">


                                    </form>
