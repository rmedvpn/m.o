                }






            </div>
        }
    </div>
    <div style="overflow: auto;height:200px;"> &nbsp; </div>

    <input type="hidden" name="showWhat" id="showWhat" value="@showWhat" />


    op_data.Close();
    clientDB.Close();

}

@helper Prospect(int prospect_id = 0)
{

    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    var ClientDb = Database.Open("zion");
    var op_data = Database.Open("op_data");

    var sqlSelect = "";
    DateTime LocalTime = AppFunctions.LocalTime();


    sqlSelect = "select * from webprospects WHERE serial=@0";
    var memberRs = ClientDb.QuerySingle(sqlSelect, prospect_id);




    if (memberRs != null)
    {
        DateTime birth_date = Convert.ToDateTime("1/1/1900"); try { birth_date = memberRs.birth_date; } catch { }

        string wanum = memberRs.wanum;
        var DaysSinceJoinInt = 0;
        DaysSinceJoinInt = AppFunctions.HowManyDaysAgoWas(memberRs.ts);
        int status_code = memberRs.status_code;
        string JoinPhoneNumber = AppFunctions.GetAppProperty("JoinPhoneNumber");
        int MaxProspectsReachoutAttempts = Convert.ToInt32(AppFunctions.GetAppProperty("MaxProspectsReachoutAttempts"));
        DateTime zeroTime = new DateTime(1, 1, 1);
        TimeSpan span = LocalTime - birth_date;
        // Because we start at year 1 for the Gregorian
        // calendar, we must subtract a year here.
        int age = (zeroTime + span).Year - 1;
        string gender = "";


        if (memberRs.gender == 1) { gender = "זכר"; }
        if (memberRs.gender == 2) { gender = "נקבה"; }

        // int aff_id = memberRs.aff_id;
        string ref_source = ""; try { ref_source = memberRs.ref_source; } catch { }
        if (ref_source == null) { ref_source = ""; }


        <div style="overflow: auto;font-weight: bold;font-size: 24px;padding: 5px;">
            פרטי המצטרף.ת @memberRs.prospect_name
            <div style="float:left;font-size:18px;margin-left:50px;">הבקשה מלפני @DaysSinceJoinInt ימים</div>
        </div>
        <form id="RepProspectApproval">
            <center>
                <div style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080;">
                    <div class="formSectionSep"></div>
                    <div class="formSection">
                        <h3>👤 פרטים אישיים</h3>
                        <div class="ProspectListRow">
                            <div class="ProspcetListCell">
                                <span class="ProspcetListCellHeader">שם<br></span>@memberRs.prospect_name
                            </div>
                            <div class="ProspcetListCell">
                                <span class="ProspcetListCellHeader">מין<br></span>@gender
                            </div>
                            <div class="ProspcetListCell">
                                <span class="ProspcetListCellHeader">גיל<br></span>@age
                            </div>
                            <div class="ProspcetListCell">
                                <span class="ProspcetListCellHeader">עיר<br></span>@memberRs.city
                            </div>
                        </div>




                        @if (memberRs.ref_txt != "")
                        {
                            <div class="ProspectListRow">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;">
                                    <span style="font-size: 11px;;color: #b200ff">מקור פניה<br></span>@memberRs.ref_txt
                                </span>
                            </div>
                        }



                        @switch (ref_source)
                        {
                            case "ref":
                                string referring_member_wanum = memberRs.ref_source_desc;
                                referring_member_wanum = AppFunctions.wanumize(referring_member_wanum);
                                string referring_member_display = "";
                                bool recognized_referring_member = false;
                                sqlSelect = "SELECT member_name,oc from pb where wanum=@0";
                                var ref_check = op_data.QuerySingle(sqlSelect, referring_member_wanum);
                                if (ref_check != null)
                                {
