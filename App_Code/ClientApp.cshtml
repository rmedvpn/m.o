@functions {



    public static string CreateRegistrationPreApprovalToken()
    {
        string theHtmlOutput = "";
        DateTime local_time = AppFunctions.LocalTime();
        DateTime defDate = Convert.ToDateTime("1/1/1900");
        int member_id = 0; try { member_id = Convert.ToInt32(Request["value"]); } catch { }
        int prospect_id = 0; try { prospect_id = Convert.ToInt32(Request["param2"]); } catch { }

        int lang = 1;
        string wanum = ""; try { wanum = Request["param1"]; } catch { }

        DataFunctions.WriteDebugLine("member_id1 " + member_id);
        DataFunctions.WriteDebugLine("prospect_id1 " + prospect_id);
        DataFunctions.WriteDebugLine("wanum1 " + wanum);


        string telegram_nick = "";
        string email = "";
        string member_nick = "";
        int u_id = WebSecurity.CurrentUserId;

        var db = WebMatrix.Data.Database.Open("op_data");
        var zion = Database.Open("zion");

        var sqlSelect = "";

        if (member_id == -1)
        {
            if (prospect_id > 0)
            {
                sqlSelect = "SELECT wanum,tlg_nick,email,prospect_name FROM webprospects WHERE serial=@0";
                var prospect = zion.QuerySingle(sqlSelect, prospect_id);
                if (prospect != null)
                {
                    member_nick = prospect.prospect_name;
                    member_nick = GenerateNickname(member_nick);
                    wanum = prospect.wanum;
                    telegram_nick = prospect.tlg_nick;
                    email = prospect.email;
                }
            }

        }
        else
        {
            sqlSelect = "SELECT member_name,telegram_nick,email,wanum FROM pb WHERE m_id=@0";
            var member = db.QuerySingle(sqlSelect, member_id);
            if (member != null)
            {
                member_nick = member.member_name;
                telegram_nick = member.telegram_nick;
                email = member.email;
                wanum = member.wanum;
            }
        }

        string pa_code = GenerateRegistrationCode();
        sqlSelect = "SELECT serial FROM UserPreApprovals WHERE wanum=@0";
        var existingPreApproval = db.QuerySingle(sqlSelect, wanum);
        if (existingPreApproval != null)
        {
            theHtmlOutput += "קיים כבר קוד הרשמה למספר הטלפון!<br>";
        }

        if (member_id > 0)
        {
            sqlSelect = "SELECT serial FROM users WHERE member_id=@0";
            var existingUser = db.QuerySingle(sqlSelect, member_id);
            if (existingUser != null)
            {
                theHtmlOutput += "המשתמש כבר קיים במערכת!<br>";
            }
        }


        sqlSelect = "SELECT serial FROM UserPreApprovals WHERE pa_code=@0";
        var existingCode = db.QuerySingle(sqlSelect, pa_code);
        if (existingCode != null)
        {
            theHtmlOutput += "קרתה שגיאה לא סבירה בעליל, נא לנסות שוב!<br>";
        }

        if (theHtmlOutput == "")
        {

            DataFunctions.WriteDebugLine("member_id " + member_id);
            DataFunctions.WriteDebugLine("wanum " + wanum);
            DataFunctions.WriteDebugLine("member_nick " + member_nick);

            sqlSelect = "INSERT INTO UserPreApprovals (member_id, wanum, telegram_nick, email, member_nick, create_ts,created_by,pa_code,lang) VALUES (@0, @1, @2, @3, @4, @5,@6,@7,@8)";
            db.Execute(sqlSelect, member_id, wanum, telegram_nick, email, member_nick, local_time, u_id, pa_code, lang);
            zion.Execute(sqlSelect, member_id, wanum, telegram_nick, email, member_nick, local_time, u_id, pa_code, lang);



            theHtmlOutput = "הפעולה בוצעה בהצלחה!";
            theHtmlOutput += "<br>קוד ההרשמה הוא: <b>" + pa_code + "</b><br>";
        }
        else
        {
            theHtmlOutput = "!$!" + theHtmlOutput;
        }
        db.Close();
        zion.Close();

        return theHtmlOutput;
    }


    public static string GenerateNickname(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "";

        // Extract first name
        string firstName = fullName.Trim().Split(' ')[0];

        // Random 4-character alphanumeric code
        const string chars = "0123456789";
        Random rand = new Random();
        char[] codeChars = new char[4];
        for (int i = 0; i < codeChars.Length; i++)
        {
            codeChars[i] = chars[rand.Next(chars.Length)];
        }

        return firstName + new string(codeChars);
    }


    public static string GenerateRegistrationCode()
    {
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, 6)
                                     .Select(s => s[random.Next(s.Length)])
                                     .ToArray());
    }

    public static string LastOnlineLabel(DateTime lastOnline, DateTime now)
    {
        // Guard against future or junk dates (optional, tweak as needed)
        if (lastOnline > now) lastOnline = now;
        if (lastOnline.Year < 2000) return "לפני הרבה זמן";

        TimeSpan ts = now - lastOnline;
        DateTime today = now.Date;
        DateTime loDate = lastOnline.Date;

        int minutes = (int)Math.Floor(ts.TotalMinutes);
        int hours = (int)Math.Floor(ts.TotalHours);
        int days = (int)Math.Floor(ts.TotalDays);

        // 1) last 5 minutes
        if (minutes <= 5) return "מחובר";

        // 2) last hour -> minutes ago
        if (minutes < 60) return "לפני " + minutes + " דקות";

        // 3) last 3 hours -> hours ago
        if (hours < 3) return "לפני " + hours + " שעות";

        // 4) more than 3 hours but today
        if (loDate == today) return "היום";

        // 5) yesterday
        if (loDate == today.AddDays(-1)) return "אתמול";

        // 6) last 3 days -> days ago (i.e., 2–3 days)
        if (days <= 3) return "לפני " + days + " ימים";

        // 7) week buckets (Sunday-start)
        DateTime startOfWeek = today.AddDays(-(int)today.DayOfWeek);
        DateTime startOfLastWeek = startOfWeek.AddDays(-7);

        if (loDate >= startOfWeek) return "השבוע";
        if (loDate >= startOfLastWeek) return "שבוע שעבר";

        // 8) monthly buckets (over 2 weeks ago)
        DateTime startOfMonth = new DateTime(today.Year, today.Month, 1);
        int monthsDiff = (today.Year - loDate.Year) * 12 + (today.Month - loDate.Month);

        if (loDate >= startOfMonth) return "החודש";
        if (monthsDiff == 1) return "לפני חודש";       // last month
        if (monthsDiff == 2) return "לפני חודשיים";
        if (monthsDiff == 3) return "לפני 3 חודשים";

        // 9) older than 3 months
        return "לפני הרבה זמן";
    }



