@helper PreApprovalList()
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT * from UserPreApprovals Where is_completed=0 ORDER BY serial DESC";
    var preApprovals = db.Query(sqlSelect);
    if (preApprovals.Count() == 0)
    {
        <div class="B" style="color:yellow">אין תוצאות</div>
}
else
{
    foreach (var item in preApprovals)
    {
        int serial = item.serial;
        int lang = item.lang;
        int member_id = item.member_id;
        DateTime create_ts = item.create_ts;
        string wanum = item.wanum;
        string member_nick = item.member_nick;
        string telegram_nick = item.telegram_nick;
        string email = item.email;
        string pa_code = item.pa_code;
        string member_color = "#000";
        if (member_id <= 0)
        {
            member_color = "#e3e3e3";
        }


<div class="B" style="border-bottom:1px dotted #e3e3e3;">
    <div class="A" style="float:right">@create_ts.ToShortDateString()</div>
    <div class="A" style="float:right">@pa_code</div>
    <div class="A" style="float:right;color:@member_color">
        @member_nick
        

    </div>

 

    <div class="A" style="float:left">
        <button type="button" class="A" onclick="CompletePreApproval(@serial, '@pa_code');">שליחת הודעה</button>
    </div>


</div>
        }
    }





    db.Close();
}


