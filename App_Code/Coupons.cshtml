    try { allow_multi_discount = coupon.allow_multi_discount; } catch { }
    try { allow_multi_coupon = coupon.allow_multi_coupon; } catch { }
    try { max_discount_rate_validity = coupon.max_discount_rate_validity; } catch { }
    try { days_to_expire = coupon.days_to_expire; } catch { }
    try { min_order_total = coupon.min_order_total; } catch { }
    try { max_order_total = coupon.max_order_total; } catch { }
    try { max_coupon_value = coupon.max_coupon_value; } catch { }
    try { coupon_terms = coupon.coupon_terms; } catch { }
    try { coupon_item_type = coupon.coupon_item_type; } catch { }
    try { item_discount_rate = coupon.item_discount_rate; } catch { }
    try { offer_price = coupon.offer_price; } catch { }
    try { activation_order_total = coupon.activation_order_total; } catch { }
    try { does_min_order_total_includes_spItems = coupon.does_min_order_total_includes_spItems; } catch { }
    try { does_min_order_total_includes_sh = coupon.does_min_order_total_includes_sh; } catch { }
    try { is_min_cat_purchase = coupon.is_min_cat_purchase; } catch { }
    try { cat_invoking_amount = coupon.cat_invoking_amount; } catch { }
    try { invoking_cat_Id = coupon.invoking_cat_Id; } catch { }
    try { is_cat_invoking_items_count = coupon.is_cat_invoking_items_count; } catch { }
    try { cat_invoking_items_count = coupon.cat_invoking_items_count; } catch { }
    try { is_sun = coupon.is_sun; } catch { }
    try { is_mon = coupon.is_mon; } catch { }
    try { is_tue = coupon.is_tue; } catch { }
    try { is_wed = coupon.is_wed; } catch { }
    try { is_thu = coupon.is_thu; } catch { }
    try { is_fri = coupon.is_fri; } catch { }
    try { is_sat = coupon.is_sat; } catch { }
    try { validity_start_hour = coupon.validity_start_hour; } catch { }
    try { validity_end_hour = coupon.validity_end_hour; } catch { }
    try { order_discount_amount = coupon.order_discount_amount; } catch { }
    try { order_discount_percantage = coupon.order_discount_percantage; } catch { }
    try { voucher_type = coupon.voucher_type; } catch { }
    try { credit_amount = coupon.credit_amount; } catch { }
    try { shipping_price = coupon.shipping_price; } catch { }
