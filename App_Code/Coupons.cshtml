        bool isValidCoupon = true;
        string ret_string = "";
        DateTime local_time = AppFunctions.LocalTime();
        int curDateOfWeek = ((int)local_time.DayOfWeek);
        decimal grand_total = cart.grand_total;
        int member_id = cart.u_id;


        if (coupon != null && cart != null)
        {
            string offer_type = coupon.offer_type;
