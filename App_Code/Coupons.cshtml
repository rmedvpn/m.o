            כמות <input type="text" class="A" style="width:30px" name="invoking_product_quan" @if (invoking_product_quan > 0) { <text> value="@Convert.ToInt32(invoking_product_quan)" </text> } /> @prod.itemunit
        </div>
    }
    db.Close();
}
