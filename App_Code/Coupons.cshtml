    <div class="A">
        <h2>עדכון הגדרות קופון - אישור</h2>
    </div>
    <div class="C">
        <div class="B">
            <b>קוד קופון</b>
            <div class="A">@coupon_code / @coupon_code_e</div>
        </div>
        <div class="B">
            <b>כותרת</b>
            <div class="A">@coupon_title</div>
            <div class="A" style="direction:ltr;float:right">@coupon_title_e</div>
        </div>
    </div>
    <div class="C">
        <div class="B">
            <b>הנחת עמלה</b>
            @if (is_comission_discount)
            {
                switch (comission_discount_type)
                {
                    case "FIXED":
                        <div class="A">
                            @comission_discount₪ הנחה מהעמלה הכוללת של ההזמנה
                        </div>

                        break;
                    case "PERCENT":
                        <div class="A">
                            @comission_discount% הנחה מהעמלה הכוללת של ההזמנה
                        </div>
                        break;
                    case "COUPON":
                        <div class="A">
                            @comission_discount% הנחה משווי הקופון
                        </div>

                        break;
                }



            }
            else
            {
                <div class="A">
                    ללא
                </div>

            }
        </div>

    </div>
    switch (offer_type)
    {
        case "ITEM":
            if (true)
            {
                var db = Database.Open("op_data");
                var sqlSelect = "";
                string itemunit = "";
                int itemunit_type = 0;

                string product_title = "";
                string offer_type_title = "";
                string maincat_title = "";
                string cat_title = "";
                int maincat_id = 0;
                int cat_id = 0;
                if (free_product_scope == "PROD")
                {
                    sqlSelect = "SELECT itemunit,title,maincat_id,sub_cat_id FROM products WHERE p_id=@0";
                    var prod = db.QuerySingle(sqlSelect, free_product_id);

                    if (prod != null)
                    {
                        itemunit = prod.itemunit;
                        product_title = prod.title;
                        maincat_id = prod.maincat_id;
                        cat_id = prod.sub_cat_id;

                    }
                }
                if (free_product_scope == "CAT")
                {
                    sqlSelect = "SELECT * FROM categories WHERE id=@0";
                    var cat = db.QuerySingle(sqlSelect, free_product_cat_id);

                    if (cat != null)
                    {
                        itemunit = NewAppFunctions.GetTitleById("ItemType", free_product_itemunit);
                        product_title = cat.title;
                        maincat_id = cat.maincat_id;
                        cat_id = cat.id;
                        cat_title = NewAppFunctions.GetTitleById("Cat", cat_id);

                        if (maincat_id > 0)
                        {
                            maincat_title = NewAppFunctions.GetTitleById("Cat", maincat_id);
                        }
                    }
                }

                switch (coupon_item_type)
                {
                    case "FREE":
                        offer_type_title = "מוצר בחינם";
                        break;
                    case "DISC":
                        offer_type_title = "מוצר בהנחה";
                        break;
                    case "PRICE":
                        offer_type_title = "מוצר במחיר";
                        break;
                }
                db.Close();

                <div class="C">
                    <b>סוג הקופון</b>
                    <div class="A">@offer_type_title</div>
                </div><div class="C">
                    <b>ההטבה</b>
                    <div class="A">

                        @switch (free_product_scope)
                        {
                            case "PROD":
                                <span>@free_product_quan @itemunit מהמוצר @product_title <span class="PrplMiniTag">(#@free_product_id)</span></span>
                                break;

                            case "CAT":
                                if (maincat_id > 0)
                                {
                                    <span>@free_product_quan @itemunit מקטגורית @maincat_title >> @cat_title <span class="PrplMiniTag">(#@cat_id)</span></span>

                                }
                                else
                                {
                                    <span>@free_product_quan @itemunit מקטגורית @cat_title <span class="PrplMiniTag">(#@cat_id)</span></span>
                                }

                                break;



                            default:
                                <span>@free_product_scope</span>
                                break;

                        }



                        @if (coupon_item_type == "FREE")
                        {<span> <b>בחינם</b></span>}
                        @if (coupon_item_type == "DISC")
                        {<span> בהנחה של <b>@item_discount_rate%</b></span>}
                        @if (coupon_item_type == "PRICE")
                        {<span> במחיר מיוחד של <b>@offer_price.ToString("C", culture)</b></span>}
                    </div>
                </div>

            }

            break;

        case "VOUCHER":
            if (true)
            {
                string offer_type_title = "";

                switch (voucher_type)
                {
                    case "DISC":
                        offer_type_title = "שובר הנחה";
                        break;
                    case "GIFT":
                        offer_type_title = "שובר מתנה";
                        break;
                }

                <div class="C">
                    <b>סוג הקופון</b>
                    <div class="A">@offer_type_title</div>
                </div>

                <div class="C">
                    <b>ההטבה</b>
                    <div class="A">

                        @if (voucher_type == "DISC")
                        {
                            <span> שובר הנחה בשיעור <b>@order_discount_percantage%</b></span>
                            if (does_discount_includes_sh)
                            {
                                <span class="PrplMiniTag">* הנחה גם על דמי משלוח</span>
                            }
                            else
                            {
                                <span class="RedMiniTag">* ללא הנחה על דמי משלוח</span>
                            }
                            if (does_discount_includes_spItems)
                            {
                                <span class="PrplMiniTag">* הנחה גם על מבצעים</span>
                            }
                            else
                            {
                                <span class="RedMiniTag">* הנחה לא תקפה על מבצעים</span>
                            }
                        }
                        @if (voucher_type == "GIFT")
                        {<span> שובר מתנה בסך <b>@order_discount_amount.ToString("C", culture)</b></span>}
                    </div>
                </div>

            }

            break;

        case "CREDIT":
            if (true)
            {


                <div class="C">
                    <b>סוג הקופון</b>
                    <div class="A">שובר זיכוי</div>
                </div>

                <div class="C">
                    <b>ההטבה</b>
                    <div class="A">
                        <span> שובר זיכוי בסך <b>@credit_amount.ToString("C", culture)</b></span>
                    </div>
                </div>

            }

            break;

        case "SHIPPING":
            if (true)
            {
                string offer_type_title = "";

                switch (shipping_cost_type)
                {
                    case "FREE":
                        offer_type_title = "משלוח <b>חינם</b>";
                        break;
                    case "PRICE":
                        offer_type_title = "משלוח בעלות <b>" + shipping_price.ToString("C", culture) + "</b>";
                        break;
                }

                <div class="C">
                    <b>סוג הקופון</b>
                    <div class="A">הטבת @Html.Raw(offer_type_title)</div>
                </div>

            }

            break;


        default:
            break;
    }

    switch (coupon_terms)
    {
        case "BYPRODUCT":
            if (true)
            {
                var db = Database.Open("op_data");
                var sqlSelect = "SELECT itemunit,title FROM products WHERE p_id=@0";
                var prod = db.QuerySingle(sqlSelect, invoking_product_id);
                string itemunit = "";
                string product_title = "";
                if (prod != null)
                {
                    itemunit = prod.itemunit;
                    product_title = prod.title;
                }
                db.Close();

                <div class="C">
                    <b>התנאי</b>
                    <div class="A">בקניה של @invoking_product_quan @itemunit מהמוצר @product_title <span class="PrplMiniTag">(#@invoking_product_id)</span></div>
                </div>
            }
            break;

        case "OVERAMOUNT":
            <div class="C">
                <b>התנאי</b>
                <div class="A">
                    בביצוע הזמנה מעל <b>@activation_order_total ₪</b>

                    @if (does_min_order_total_includes_spItems)
                    {
                        <span class="A"><span class="PrplMiniTag">כולל מבצעים והטבות נוספות</span></span>
                    }

                    @if (does_min_order_total_includes_sh)
                    {
                        <span class="A"><span class="PrplMiniTag">כולל דמי משלוח</span></span>
                    }
                </div>
            </div>
            break;

        case "PRODBYCAT":
            if (true)
            {
                var db = Database.Open("op_data");
                var sqlSelect = "SELECT * FROM categories WHERE id=@0";
                var cat = db.QuerySingle(sqlSelect, invoking_cat_Id);
                string cat_title = "";
                if (cat != null)
                {
                    cat_title = cat.title;
                    if (!cat.is_mainCat)
                    {
                        sqlSelect = "SELECT title FROM categories WHERE id=@0";
                        var mainCat = db.QuerySingle(sqlSelect, cat.mainCat_id);
                        if (mainCat != null)
                        {
                            cat_title = mainCat.title + "-" + cat_title;
                        }
                    }
                    cat_title = "<B> " + cat_title + "</B>";
                }

                string term_title = "בקניה של ";

                string term_title_b = "מוצר כלשהו ";
                if (is_cat_invoking_items_count)
                {
                    if (cat_invoking_items_count > 1)
                    {
                        term_title_b = cat_invoking_items_count + " מוצרים כלשהם ";
                    }
                }

                string term_title_c = "מהקטגוריה " + cat_title + "<span class=\"PrplMiniTag\"> (#" + invoking_cat_Id + ")</span>";
                string term_title_d = " בכל סכום שהוא";

                if (is_min_cat_purchase)
                {
                    if (cat_invoking_amount > 0)
                    {
                        term_title_d = " בסכום של לפחות " + cat_invoking_amount.ToString("C", culture);
                    }
                }

                term_title = term_title + term_title_b + term_title_c + term_title_d;

                db.Close();

                <div class="C">
                    <b>התנאי</b>
                    <div class="A">@Html.Raw(term_title)</div>
                </div>
            }
            break;

        case "NONE":
            <div class="C">
                <b>התנאי</b>
                <div class="A">
                    ללא תנאים


                </div>
            </div>

            break;
        default:
            break;
    }

    <div class="A">
        <b style="color:#f00">הגבלות</b>

        <div class="C">
            <span class="B-Right" style="margin-right: 0; padding-right: 0">תקף בימים</span>

            <b>
                @if (is_sun)
                {<span class="B-Right">א</span>}
                @if (is_mon)
                {<span class="B-Right">ב</span>}
                @if (is_tue)
                {<span class="B-Right">ג</span>}
                @if (is_wed)
                {<span class="B-Right">ד</span>}
                @if (is_thu)
                {<span class="B-Right">ה</span>}
                @if (is_fri)
                {<span class="B-Right">ו</span>}
                @if (is_sat)
                {<span class="B-Right">שבת</span>}

            </b>
            <span class="B-Right"> <b>@validity_start_hour - @validity_end_hour</b></span>

        </div>



        @if (!allow_multi_discount)
        {
            <div class="C">ללא כפל מבצעים</div>
        }
        @if (!allow_multi_coupon)
        {
            <div class="C">ללא כפל קופונים</div>
        }
        <div class="C">
            מקסימום קופונים מסוג זה בהזמנה
            @if (max_in_cart > 0)
            {
                <b><span>@max_in_cart</span></b>
            }
            else
            {
                <b><span>ללא הגבלה</span></b>
            }

        </div>

        @if (max_discount_rate_validity > 0)
        {
            <div class="C">אחוז הנחה מקסימלי <b><span>@max_discount_rate_validity</span>%</b></div>
        }
        @if (days_to_expire > 0)
        {
            <div class="C">בתוקף למשך <b>@days_to_expire ימים</b> מההנפקה</div>
        }
        @if (min_order_total > 0)
        {
            <div class="C">תקף בהזמנות מעל <b>@min_order_total.ToString("C", culture)</b> </div>
        }
        @if (max_order_total > 0)
        {
            <div class="C">תקף בהזמנות מתחת <b>@max_order_total.ToString("C", culture)</b>  </div>
        }
        @if (max_coupon_value > 0)
        {
            <div class="C">ערך קופון מקסימלי <b>@max_coupon_value.ToString("C", culture)</b> </div>
        }

        @if (invoking_orders_count > 0)
        {
            <div class="C">תקף רק עבור משתמשים שביצעו יותר מ <b>@invoking_orders_count הזמנות</b> </div>
        }

        @if (membership_duration_months > 0)
        {
            <div class="C">תקף רק עבור משתמשים בעלי ותק של לפחות <b>@membership_duration_months חודשים</b> </div>
        }

        @if (!terms.IsEmpty())
        {
            <div class="C"><b>תנאים נוספים</b><br />@terms</div>
        }

        @if (!terms_e.IsEmpty())
        {
            <div class="C"><b>Additional Terms</b><br />@terms_e</div>
        }

        <div class="C"><b>תאריך תפוגה</b><br />@expiration_date.ToShortDateString()</div>
    </div>



    <div class="A" style="text-align:center">
        <button type="button" class="A" onclick="clearContent('SubMenuLeftContent');controller.open('GenSb');">ביטול</button>
        <button type="button" class="A" onclick="AjaxActions('SaveCouponSettings', '@coupon_id','', 'CreateCouponInfo',@coupon_id);">שמירת שינויים </button>
