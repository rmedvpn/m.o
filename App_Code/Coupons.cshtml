@helper CouponTermsSelector(string selected_term, int coupon_id = 0)
{
    int invoking_product_id = 0;
    decimal activation_order_total = 0;
    bool does_min_order_total_includes_spItems = true;
    bool does_min_order_total_includes_sh = true;
    int invoking_cat_Id = 0;
    bool is_min_cat_purchase = false;
    decimal cat_invoking_amount = 0;
    bool is_cat_invoking_items_count = false;
    int cat_invoking_items_count = 0;
    string min_cat_purchase_span_display_state = "none;";
    string cat_invoking_items_count_span_display_state = "none;";
    if (coupon_id > 0)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT * FROM coupons WHERE coupon_id=@0";
        var coupon = db.QuerySingle(sqlSelect, coupon_id);
        if (coupon != null)
        {
            invoking_product_id = coupon.invoking_product_id;
            activation_order_total = coupon.activation_order_total;
            does_min_order_total_includes_spItems = coupon.does_min_order_total_includes_spItems;
            does_min_order_total_includes_sh = coupon.does_min_order_total_includes_sh;
            invoking_cat_Id = coupon.invoking_cat_Id;
            is_min_cat_purchase = coupon.is_min_cat_purchase;
            cat_invoking_amount = coupon.cat_invoking_amount;
            is_cat_invoking_items_count = coupon.is_cat_invoking_items_count;
            cat_invoking_items_count = coupon.cat_invoking_items_count;
        }
        db.Close();
    }
    if (is_min_cat_purchase)
    {
        min_cat_purchase_span_display_state = "block;";
    }
    if (is_cat_invoking_items_count)
    {
        cat_invoking_items_count_span_display_state = "block;";
    }

    switch (selected_term)
    {
        case "BYPRODUCT":
            <div class="B">
                <div class="B">
                    <div class="B" style="float:right">
                        מוצר מזכה
                    </div>
                    <div class="B" style="float:left">
                        @Coupons.ProductSelector("invoking_product_id", "invoking_product", invoking_product_id, coupon_id)

                    </div>

                </div>

                <div class="B" id="InvokingProductResults">
                    @if (coupon_id > 0)
                    {
                        <div>@Coupons.InvokingProductSelector(invoking_product_id, coupon_id)</div>
                    }
                </div>
            </div>

            break;

        case "OVERAMOUNT":


            <div class="B">
                <div class="B">
                    <div class="B">
                        <span class="A-Right">
                            <input type="checkbox" style="width:30px;" checked disabled />
                            תקף בהזמנות מעל
                            <input type="text" class="A" style="width:30px;" name="activation_order_total" @if (activation_order_total > 0) { <text> value="@Convert.ToInt32(activation_order_total)" </text> } /> ₪
                        </span>
                    </div>
                    <div class="B">
                        <span class="A-Right">

                            <input type="checkbox" style="width:30px;" name="does_min_order_total_includes_spItems" @if (does_min_order_total_includes_spItems) { <text> checked</text> } /> סכום הזמנה כולל מבצעים והטבות אחרות
                        </span>
                    </div>
                    <div class="B">
                        <span class="A-Right">
                            <input type="checkbox" style="width:30px;" name="does_min_order_total_includes_sh" @if (does_min_order_total_includes_sh) { <text> checked</text> } /> סכום הזמנה כולל דמי משלוח
                        </span>
                    </div>


                </div>


            </div>
            break;

        case "PRODBYCAT":
            if (true)
            {
                var db = Database.Open("op_data");
                var sqlSelect = "SELECT id,title FROM categories WHERE is_maincat=1 AND is_active=1 ORDER BY id";
                var maincategories = db.Query(sqlSelect);
                int curMainCat = 0;

                <div class="B">
                    <div class="B">
                        בקניה מקטגוריה
                        <select class="A" style="float:left" name="invoking_cat_Id">
                            <option value="">נא לבחור..</option>
                            @foreach (var cat in maincategories)
                            {
                                if (curMainCat != cat.id)
                                {
                                    curMainCat = cat.id;
                                    <option value="">-----------------------</option>
                                }

                                <option value="@cat.id" @if (invoking_cat_Id == cat.id) { <text> selected</text> }>@cat.title</option>
                                sqlSelect = "SELECT id,title FROM categories WHERE is_spOffersCat=1 AND is_active=1 AND mainCat_id=@0 ORDER BY id";
                                var subCategories = db.Query(sqlSelect, cat.id);
                                foreach (var subcat in subCategories)
                                {
                                    <option value="@subcat.id" @if (invoking_cat_Id == subcat.id) { <text> selected</text>}>  @cat.title --> @subcat.title</option>
                                }

                            }
                        </select>
                    </div>

                </div>
                <div class="A">

                    <div class="B">
                        <span style="float:right">
                            <input type="checkbox" class="A" name="is_min_cat_purchase" @if (is_min_cat_purchase) { <text> checked</text>} onclick="if (this.checked) { showElement('min_cat_purchase_span'); } else { hideElement('min_cat_purchase_span'); }" />  מינימום לרכישה מהקטגוריה
                        </span>
                        <span style="display: @min_cat_purchase_span_display_state; float: left" id="min_cat_purchase_span"><input type="text" class="A" style="width:30px" name="cat_invoking_amount" placeholder="₪" @if (cat_invoking_amount > 0) { <text> value="@Convert.ToInt32(cat_invoking_amount)" </text> } />₪</span>
                    </div>
                    <div class="B">
                        <span style="float:right">
                            <input type="checkbox" class="A" name="is_cat_invoking_items_count" @if (is_cat_invoking_items_count) { <text> checked</text>} onclick="if (this.checked) { showElement('cat_invoking_items_count_span'); } else { hideElement('cat_invoking_items_count_span'); }" />  מינימום כמות פריטים לרכישה מהקטגוריה
                        </span>
                        <span style="display: @cat_invoking_items_count_span_display_state; float: left" id="cat_invoking_items_count_span"><input type="text" class="A" style="width:30px" name="cat_invoking_items_count" @if (cat_invoking_items_count > 0) { <text> value="@cat_invoking_items_count" </text> } /> </span>
                    </div>
                </div>

                db.Close();
            }
            break;

        case "NONE":
            break;

        default:
            @selected_term
            break;
    }
}
@helper ProductSelector(string field_name, string field_type = "", int selected_p_id = 0, int coupon_id = 0)
{
    string requestedAction = "";
    string return_container = "";
    var db = Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT p_id,title FROM products WHERE is_catalog=1 AND is_active=1 ORDER BY maincat_id,sub_cat_id";
    var products = db.Query(sqlSelect);
    sqlSelect = "SELECT id,title,is_maincat FROM categories WHERE is_active=1 AND is_maincat=1 ORDER BY maincat_id";
    var main_categories = db.Query(sqlSelect);

    switch (field_type)
    {
        case "free_item":
            requestedAction = "CouponProductSelector";
            return_container = "CouponProductSelectorResults";
            break;
        case "invoking_product":
            requestedAction = "InvokingProductSelector";
            return_container = "InvokingProductResults";

            break;
    }
    <select class="A" style="float:left" name="@field_name" id="@field_name" onchange="if (this.value != '') { RepAjaxUpdate('@requestedAction', '@return_container', 'MainLoader', this.value,@coupon_id); }">
        <option value="">נא לבחור..</option>
        @foreach (var product in products)
        {
            string prod_title = product.title;
            if (prod_title.Length > 35)
            {
                prod_title = prod_title.Substring(0, 35);
            }

            <option value="@product.p_id" @if (product.p_id == selected_p_id) { <text> selected</text>}>מוצר #@product.p_id - @prod_title</option>
        }
    </select>




    db.Close();
}
@helper CatSelector(string field_name, string field_type = "", int selected_p_id = 0, int coupon_id = 0)
{
    string requestedAction = "";
    string return_container = "";
    var db = Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT p_id,title FROM products WHERE is_catalog=1 AND is_active=1 ORDER BY maincat_id,sub_cat_id";
    var products = db.Query(sqlSelect);
    sqlSelect = "SELECT id,title,is_maincat FROM categories WHERE is_active=1 AND is_maincat=1 ORDER BY maincat_id";
    var main_categories = db.Query(sqlSelect);

    switch (field_type)
    {
        case "free_item":
            requestedAction = "CouponCategorySelector";
            return_container = "CouponProductSelectorResults";
            break;
        case "invoking_product":
            requestedAction = "InvokingProductSelector";
            return_container = "InvokingProductResults";

            break;
    }


    <select class="A" style="float:left;" name="@field_name" id="@field_name" onchange="if (this.value != '') { RepAjaxUpdate('@requestedAction', '@return_container', 'MainLoader', this.value,@coupon_id); }">
        <option value="">נא לבחור..</option>
        @foreach (var main_cat in main_categories)
        {
            string main_cat_title = main_cat.title;
            if (main_cat_title.Length > 35)
            {
                main_cat_title = main_cat_title.Substring(0, 35);
            }
            sqlSelect = "SELECT id,title,is_maincat FROM categories WHERE is_active=1 AND maincat_id=@0 ORDER BY id";
            var sub_categories = db.Query(sqlSelect, main_cat.id);

            <option value="@main_cat.id" @if (main_cat.id == selected_p_id) { <text> selected</text>}>@main_cat_title</option>

            foreach (var sub_cat in sub_categories)
            {
                string sub_cat_title = sub_cat.title;
                if (sub_cat_title.Length > 35)
                {
                    sub_cat_title = sub_cat_title.Substring(0, 35);
                }
                <option value="@sub_cat.id" @if (sub_cat.id == selected_p_id) { <text> selected</text>}>@main_cat_title >> @sub_cat_title</option>

            }


        }
    </select>



    db.Close();
}

@helper InvokingProductSelector(int p_id, int coupon_id = 0)
{

