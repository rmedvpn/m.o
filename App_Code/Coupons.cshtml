{}


@helper CouponsAdmin(string coupon_type = "")
{
    var db = Database.Open("op_data");
    var sqlSelect = "";



    sqlSelect = "SELECT * FROM coupons where is_deleted=0 AND coupon_type=@0 order by is_setup,is_active DESC, coupon_id DESC";
    if (coupon_type == "")
    {
        sqlSelect = "SELECT * FROM coupons where is_deleted=0 order by  is_setup,is_active DESC,coupon_id DESC";
    }
    var coupons = db.Query(sqlSelect, coupon_type);


    <div style="overflow:auto" id="CouponsAdminDiv">
        <div style="overflow: auto;background-color: #fff;min-height: 500px;">
            <div style="overflow: auto;padding: 5px;">
                <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;" onclick="AjaxActions('NewCoupon', '','MainLoader');">חדש</button>
                <div style="font-size: 20px;float: right;color: #000">
                    ניהול הטבות וקופונים



                </div>
                <div class="spinner" style="text-align: center;display: none;float: left" id="SpOfferAdminLoader">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>

            </div>

            <div style="overflow: auto;clear: both;" id="spOfferDiv">
                @foreach (var coupon in coupons)
                {
                    string ActiveTxt = "פעיל";
                    string rowBgColor = "#e3e3e3";
                    if (!coupon.is_setup)
                    {
                        rowBgColor = "#ffffcc";
                        ActiveTxt = "לא מוגדר";
                    }
                    if (!coupon.is_active)
                    {
                        rowBgColor = "#ffcccc";
                        ActiveTxt = "לא פעיל";
                    }
                    <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;color: #000;background-color: @rowBgColor">

                        @if (coupon.is_setup)
                        {
                            <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000" onclick="sbload('GenSb', 'Caller?p1=CouponInfo&p2=@coupon.coupon_id'); AdjustMainView();">פרטים</button>
                            <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000" onclick="sbload('GenSb', 'Caller?p1=IssueCoupon&p2=@coupon.coupon_id'); AdjustMainView();">הנפקה</button>

                        }
                        else
                        {
                            <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000" onclick="sbload('GenSb', 'Caller?p1=CouponSetup&p2=@coupon.coupon_id'); AdjustMainView();">הגדרה ראשונית</button>
                            <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000" onclick="sbload('GenSb', 'Caller?p1=VoucherSetup&p2=@coupon.coupon_id'); AdjustMainView();">הגדרת וואצר לקוח</button>
                        }



                        <div style="overflow: auto;">
                            @coupon.coupon_id - @coupon.coupon_title
                            <div class="B"><span class="MiniTitle">@ActiveTxt</span></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div style="overflow: auto;height:300px;background-color: #e3e3e3">&nbsp;</div>

    db.Close();
}
@helper CouponEdit(int coupon_id)
{
    var db = Database.Open("op_data");

    var sqlSelect = "SELECT * from coupons WHERE coupon_id=@0";
    var coupon = db.QuerySingle(sqlSelect, coupon_id);

    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    DateTime local_time = AppFunctions.LocalTime();

    string offer_type = coupon.offer_type;

    bool is_comission_discount = coupon.is_comission_discount;
    decimal comission_discount = coupon.comission_discount;
    string comission_discount_type = coupon.comission_discount_type;
    string comission_discount_div_display_state = "none;";
    if (is_comission_discount)
    {
        comission_discount_div_display_state = "block;";
    }
    <div style="overflow: auto;color: #000;padding: 5px;margin: 5px;background-color: #fff">

        <div>
            <div style="overflow: auto;font-size: 20px;">
                <div class="B">
                    @if (!coupon.is_active)
                    {
                        <span class="A" style=" margin-left: 30px; padding: 5px; border-radius: 5px; background-color: #f00; color: #fff; float: left " onclick="AjaxActions('CouponDelete', '@coupon_id', 'MainLoader');">מחיקת קופון</span>
                    }
                    <div style="overflow: auto; font-size: 14px; font-weight: bold; float: right; text-align: right;margin-left:10px; ">
                        פעיל?<br><input type="checkbox" class="A" style="height:20px;width:20px" id="is_active" name="is_active" @if (coupon.is_active) { <text> checked</text> } onclick="AjaxActions('SetCouponActiveState', '@coupon_id', 'MainLoader', this.checked);">
                    </div>

                    <div class="B">
                        <div class="B">@coupon.coupon_title - הגדרות</div>
                        <div class="B"><span class="PrplMiniTag">קופון #@coupon.coupon_id</span></div>
                    </div>
                </div>
            </div>
            <div style="overflow: auto;">
            </div>

        </div>

        <form id="CreateCouponForm">
            <input type="hidden" name="coupon_id" value="@coupon_id" />

            <div style="overflow: auto;background-color: #e3e3e3;">
                <div class="A">
                    <div style="overflow: auto;">
                        <div style="overflow: auto;">

                        </div>


                        <div style="overflow: auto; font-size: 14px; font-weight: bold; float: right; text-align: right; ">
                            קוד קופון<br><input type="text" style="font-size: 16px;padding: 5px;margin: 5px;" id="coupon_code" name="coupon_code" value="@coupon.coupon_code" maxlength="15">
                        </div>
                        <div style="overflow: auto; font-size: 14px; font-weight: bold; float: right; text-align: right;">
                            Code Coupon<br><input type="text" style="font-size: 16px;padding: 5px;margin: 5px;" id="coupon_code_e" name="coupon_code_e" value="@coupon.coupon_code_e" maxlength="15">
                        </div>

                    </div>
                    <div style="overflow: auto;">
                        <div style="overflow: auto;font-size: 14px;font-weight: bold">כותרת למבצע<br><input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;" id="coupon_title" name="coupon_title" value="@coupon.coupon_title"></div>
                        <div style="overflow: auto;font-size: 14px;font-weight: bold">Offer Title<br><input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;" id="coupon_title_e" name="coupon_title_e" value="@coupon.coupon_title_e"></div>
                    </div>
                    <div style="overflow: auto;">
                        <div style="overflow: auto;font-size: 14px;font-weight: bold">פירוט<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="coupon_notes" name="coupon_notes">@coupon.coupon_notes</textarea></div>
                        <div style="overflow: auto;font-size: 14px;font-weight: bold">Specification<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="coupon_notes_e" name="coupon_notes_e">@coupon.coupon_notes_e</textarea></div>
                    </div>
                    <div class="B">
                        <div style="overflow: auto;font-size: 14px;font-weight: bold">
                            <input type="checkbox" name="is_comission_discount" class="A" @if (is_comission_discount) { <text> checked</text> } onclick="if (this.checked) { showElement('comission_discount_div'); } else {hideElement('comission_discount_div'); }" /> הנחת עמלה?
                        </div>
                        <div style="overflow: auto;font-size: 14px;font-weight: bold;display:@comission_discount_div_display_state" id="comission_discount_div">
                            <input class="A30" style="float:right" name="comission_discount" value="@Convert.ToInt32(comission_discount)" />
                            <select class="A" style="float:right" name="comission_discount_type">
                                <option value="FIXED" @if (comission_discount_type == "FIXED") { <text> selected</text>}>₪ הנחה מהעמלה הכללית להזמנה</option>
                                <option value="PERCENT" @if (comission_discount_type == "PERCENT") { <text> selected</text>}>% הנחה מהעמלה הכללית להזמנה</option>
                                <option value="COUPON" @if (comission_discount_type == "COUPON") { <text> selected</text>}>% הנחה משווי הקופון</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div style="overflow: auto;font-size: 20px;font-weight: bold">
                    <div class="A">
                        סוג קופון

                        <div style="float: left">
                            <input type="hidden" name="offer_type" value="@offer_type" />
                            @switch (offer_type)
                            {
                                case "ITEM":
                                    <span>מוצר בחינם / בהנחה / במחיר</span>
                                    break;
                                case "VOUCHER":
                                    <span>שובר מתנה / הנחה</span>
                                    break;
                                case "SHIPPING":
                                    <span>משלוח חינם / מוזל</span>
                                    break;
                                case "CREDIT":
                                    <span>זיכוי</span>
                                    break;

                            }
                        </div>
                        <div class="B" id="OfferTypeLoader">
                            <div style="direction:rtl"> @Coupons.CouponOfferSetup(coupon.offer_type, coupon_id) </div>

                        </div>
                    </div>



                    <div style="overflow:auto;" id="OfferTypeResults">

                    </div>


                </div>
            </div>
        </form>




    </div>
    <div style="overflow: auto;height: 200px;">&nbsp;</div>


    db.Close();
}
@helper CouponInfo(int coupon_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * from coupons WHERE coupon_id=@0";
    var coupon = db.QuerySingle(sqlSelect, coupon_id);
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");


    if (coupon != null)
    {
        string offer_type = coupon.offer_type;
        string coupon_item_type = coupon.coupon_item_type;
        string voucher_type = coupon.voucher_type;
        string shipping_cost_type = coupon.shipping_cost_type;
        string coupon_terms = coupon.coupon_terms;
        string free_product_scope = coupon.free_product_scope;
        bool is_comission_discount = coupon.is_comission_discount;
        decimal comission_discount = coupon.comission_discount;
        string comission_discount_type = coupon.comission_discount_type;
        int maincat_id = 0;

        <div style="overflow: auto;color: #000;padding: 5px;margin: 5px;background-color: #fff">

            <div style="overflow: auto;font-size: 20px;">
                <button class="A" style="float: right;" onclick="sbload('GenSb', 'Caller?p1=CouponEdit&p2=@coupon.coupon_id'); AdjustMainView();">⚙️</button>
                <div class="B" style="float:right">

                    <div class="B">
                        <div class="B">@coupon.coupon_title</div>
                        <div class="B"><span class="PrplMiniTag">קופון #@coupon.coupon_id</span></div>
                    </div>
                </div>
                <div class="B" style="float:left;">
                    @if (coupon.is_active)
                    {
                        <span class="A" style="margin-left: 30px; padding: 5px; border-radius: 5px;background-color: #57d600;color:#fff;float:left ">פעיל</span>
                    }
                    else
                    {
                        <span class="A" style=" margin-left: 30px; padding: 5px; border-radius: 5px; background-color: #f00; color: #fff; float: left ">לא פעיל</span>
                    }

                </div>


            </div>

            <form id="CreateCouponForm">
                <div style="overflow: auto;background-color: #e3e3e3;border-radius:5px;">
                    <div class="A">
                        <div style="overflow: auto;">
                            <div class="A" style="float: right; text-align: right; ">
                                <div class="MiniTitle">
                                    קוד קופון
                                </div>
                                <div class="B">
                                    @coupon.coupon_code
                                </div>
                            </div>

                            <div class="A" style="float: right; text-align: right; ">
                                <div class="MiniTitle">
                                    Code Coupon
                                </div>
                                <div class="B">
                                    @coupon.coupon_code_e
                                </div>
                            </div>


                        </div>
                        <div class="A" style=" text-align: right; ">
                            <div class="MiniTitle">
                                כותרת קופון
                            </div>
                            <div class="B">
                                @coupon.coupon_title
                            </div>
                        </div>
                        <div class="A" style=" text-align: right; ">
                            <div class="MiniTitle">
                                Offer Title
                            </div>
                            <div class="B">
                                @coupon.coupon_title_e
                            </div>
                        </div>

                        @if (coupon.coupon_notes != "")
                        {
                            <div class="A" style="text-align: right; ">
                                <div class="MiniTitle">
                                    תיאור
                                </div>
                                <div class="B">
                                    @coupon.coupon_notes
                                </div>
                            </div>
                        }
                        @if (coupon.coupon_notes_e != "")
                        {
                            <div class="A" style="text-align: right; ">
                                <div class="MiniTitle">
                                    Specification
                                </div>
                                <div class="B">
                                    @coupon.coupon_notes_e
                                </div>
                            </div>
                        }


                        <div class="A" style=" text-align: right; ">
                            <div class="MiniTitle">
                                הנחת עמלה
                            </div>
                            @if (is_comission_discount)
                            {
                                switch (comission_discount_type)
                                {
                                    case "FIXED":
                                        <div class="B">
                                            @Convert.ToInt32(comission_discount)₪ הנחה מהעמלה הכוללת של ההזמנה
                                        </div>

                                        break;
                                    case "PERCENT":
                                        <div class="B">
                                            @Convert.ToInt32(comission_discount)% הנחה מהעמלה הכוללת של ההזמנה
                                        </div>
                                        break;
                                    case "COUPON":
                                        <div class="B">
                                            @Convert.ToInt32(comission_discount)% הנחה משווי הקופון
                                        </div>

                                        break;
                                }



                            }
                            else
                            {
                                <div class="B">
                                    ללא
                                </div>

                            }
                        </div>

                    </div>
                    <div style="overflow:auto">
                        @switch (offer_type)
                        {
                            case "ITEM":
                                if (true)
                                {
                                    int itemunit_type = 0;
                                    int rec_item_id = 0;
                                    string itemunit = "";
                                    string item_title = "";
                                    string cat_title = "";
                                    string maincat_title = "";
                                    if (free_product_scope == "PROD")
                                    {
                                        sqlSelect = "SELECT title,itemunit,p_id FROM products WHERE p_id=@0";
                                        var prod = db.QuerySingle(sqlSelect, coupon.free_product_id);
                                        if (prod != null)
                                        {
                                            item_title = prod.title;
                                            itemunit = prod.itemunit;
                                            rec_item_id = prod.p_id;
                                        }

                                    }
                                    if (free_product_scope == "CAT")
                                    {
                                        sqlSelect = "SELECT id,title,maincat_id FROM categories WHERE id=@0";
                                        var cat = db.QuerySingle(sqlSelect, coupon.free_product_cat_id);
                                        if (cat != null)
                                        {
                                            maincat_id = cat.maincat_id;
                                            cat_title = cat.title;
                                            rec_item_id = cat.id;
                                            try { itemunit_type = coupon.free_product_itemunit; } catch { }
                                            try { itemunit = NewAppFunctions.GetTitleById("ItemType", itemunit_type); } catch { }
                                            if (maincat_id > 0)
                                            {
                                                try { maincat_title = NewAppFunctions.GetTitleById("Cat", maincat_id); } catch { }
                                            }



                                        }


                                    }

                                    <div class="B">
                                        <div class="A">
                                            סוג קופון
                                            <div style="float: left">
                                                <span class="B">
                                                    @switch (coupon_item_type)
                                                    {
                                                        case "FREE":
                                                            if (true)
                                                            {<span>מוצר במתנה</span>

                                                            }
                                                            break;
                                                        case "DISC":
                                                            if (true)
                                                            {
                                                                <span>מוצר בהנחה @String.Format("{0:0.00}", coupon.item_discount_rate)%</span>
                                                            }
                                                            break;
                                                        case "PRICE":
                                                            if (true)
                                                            {
                                                                <span>מוצר במחיר @coupon.offer_price.ToString("C", culture)</span>
                                                            }
                                                            break;
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    </div><div class="B">

                                        @if (free_product_scope == "PROD")
                                        {
                                            <div class="A">
                                                מוצר בהטבה
                                                <div style="float: left">
                                                    <span class="B">@coupon.free_product_quan @itemunit @item_title <span class="PrplMiniTag">(#@coupon.free_product_id)</span></span>
                                                </div>
                                            </div>

                                        }
                                        @if (free_product_scope == "CAT")
                                        {


                                            <div class="A">
                                                מוצר בהטבה
                                                @if (maincat_id > 0)
                                                {
                                                    <div style="float: left">
                                                        <span class="B">@coupon.free_product_quan @itemunit מקטגוריית @maincat_title >> @cat_title <span class="PrplMiniTag">(#@coupon.free_product_cat_id)</span></span>
                                                    </div>

                                                }
                                                else
                                                {
                                                    <div style="float: left">
                                                        <span class="B">@coupon.free_product_quan @itemunit מקטגוריית @cat_title <span class="PrplMiniTag">(#@coupon.free_product_cat_id)</span></span>
                                                    </div>

                                                }
                                            </div>

                                        }
                                    </div>

                                }

                                break;
                            case "VOUCHER":
                                <div class="B">
                                    @switch (voucher_type)
                                    {
                                        case "GIFT":
                                            <div class="C">
                                                סוג קופון
                                                <div style="float: left">

                                                    <span class="B">שובר מתנה @coupon.order_discount_amount.ToString("C", culture)</span>

                                                </div>
                                            </div>
                                            break;
                                        case "DISC":
                                            <div class="C">
                                                סוג קופון
                                                <div style="float: left">


                                                    <span class="B">שובר הנחה @String.Format("{0:0.00}", coupon.order_discount_percantage)%</span>

                                                </div>
                                            </div>
                                            break;


                                    }

                                    <div class="C">
                                        תקף גם במבצעים
                                        <div style="float: left">
                                            @if (coupon.does_discount_includes_spItems)
                                            {<span class="B">✅</span>}
                                            else
                                            {<span class="B">❌</span>}
                                        </div>
                                    </div>
                                    <div class="C">
                                        תקף גם בדמי משלוח
                                        <div style="float: left">
                                            @if (coupon.does_discount_includes_sh)
                                            {<span class="B">✅</span>}
                                            else
                                            {<span class="B">❌</span>}
                                        </div>
                                    </div>

                                </div>
                                break;
                            case "CREDIT":
                                <div class="B">
                                    <div class="C">
                                        סוג קופון
                                        <div style="float: left">

                                            <span class="B">שובר זיכוי @coupon.credit_amount.ToString("C", culture)</span>

                                        </div>
                                    </div>
                                </div>
                                break;
                            case "SHIPPING":


                                <div class="B">

                                    @switch (shipping_cost_type)
                                    {
                                        case "FREE":
                                            <div class="B">
                                                <div class="C">
                                                    סוג קופון
                                                    <div style="float: left">

                                                        <span class="B">משלוח חינם</span>

                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                        case "PRICE":
                                            <div class="B">
                                                <div class="C">
                                                    סוג קופון
                                                    <div style="float: left">

                                                        <span class="B">משלוח במחיר @coupon.shipping_price.ToString("C", culture)</span>

                                                    </div>
                                                </div>
                                            </div>
                                            break;
                                    }
                                </div>
                                break;

                        }
                    </div>
                    <div style="overflow:auto">
                        @switch (coupon_terms)
                        {
                            case "BYPRODUCT":
                                if (true)
                                {
                                    sqlSelect = "SELECT title,itemunit FROM products WHERE p_id=@0";
                                    var prod = db.QuerySingle(sqlSelect, coupon.invoking_product_id);
                                    string product_title = "";
                                    product_title = prod.title;
                                    string itemunit = "";
                                    itemunit = prod.itemunit;

                                    <div class="B">
                                        <div class="A">
                                            מוצר מזכה
                                            <div style="float: left">
                                                <span class="B">@coupon.invoking_product_quan @itemunit @product_title <span class="PrplMiniTag">(#@coupon.invoking_product_id)</span></span>
                                            </div>
                                        </div>
                                    </div>
                                }


                                break;

                            case "OVERAMOUNT":
                                <div class="B">
                                    <div class="C">
                                        תקף בהזמנות מעל
                                        <div style="float: left">

                                            <span class="B">@coupon.activation_order_total.ToString("C", culture)</span>

                                        </div>
                                    </div>

                                    <div class="C">
                                        סכום ההזמנה כולל מבצעים והטבות אחרות
                                        <div style="float: left">
                                            @if (coupon.does_min_order_total_includes_spItems)
                                            {<span class="B">✅</span>}
                                            else
                                            {<span class="B">❌</span>}
                                        </div>
                                    </div>
                                    <div class="C">
                                        סכום הזמנה כולל דמי משלוח
                                        <div style="float: left">
                                            @if (coupon.does_min_order_total_includes_sh)
                                            {<span class="B">✅</span>}
                                            else
                                            {<span class="B">❌</span>}
                                        </div>
                                    </div>

                                </div>
                                break;


                            case "PRODBYCAT":
                                if (true)
                                {
                                    sqlSelect = "SELECT id,title,is_maincat,maincat_id FROM categories WHERE id=@0";
                                    var invoking_cat = db.QuerySingle(sqlSelect, coupon.invoking_cat_Id);
                                    int invoking_cat_Id = 0; invoking_cat_Id = invoking_cat.id;
                                    maincat_id = 0; maincat_id = invoking_cat.maincat_id;
                                    string main_cat_title = "";

                                    if (!invoking_cat.is_maincat)
                                    {
                                        sqlSelect = "SELECT id,title,is_maincat,maincat_id FROM categories WHERE id=@0";
                                        var main_cat = db.QuerySingle(sqlSelect, maincat_id);
                                        if (main_cat != null)
                                        {
                                            main_cat_title = main_cat.title;
                                        }
                                    }


                                    <div class="C">
                                        בקניה מקטגוריה
                                        <div style="float: left">
                                            @if (invoking_cat.is_maincat)
                                            {
                                                <span class="B">@invoking_cat.title <span class="PrplMiniTag">(#@invoking_cat_Id)</span></span>
                                            }
                                            else
                                            {
                                                <span class="B">@main_cat_title <span class="PrplMiniTag">(#@maincat_id)</span> >></span>
                                                <span class="B">@invoking_cat.title <span class="PrplMiniTag">(#@invoking_cat_Id)</span></span>
                                            }
                                        </div>
                                    </div>
                                    <div class="C">
                                        מינימום לרכישה מהקטגוריה
                                        <div style="float: left">

                                            <span class="B">@coupon.cat_invoking_amount.ToString("C", culture)</span>

                                        </div>
                                    </div>
                                    <div class="C">
                                        מינימום כמות פריטים לרכישה מהקטגוריה
                                        <div style="float: left">

                                            <span class="B">@coupon.cat_invoking_items_count</span>

                                        </div>
                                    </div>

                                }
                                break;




                            case "NONE":
                                <div class="C">
                                    ללא תנאים
                                </div>
                                break;

                            default:
                                @coupon_terms
                                break;
                        }

                    </div>

                    <div style="overflow:auto">
                        <div class="A" style="background-color:#fff">
                            <b style="color:#f00">הגבלות</b>

                            <div class="C">
                                <span class="B-Right" style="margin-right: 0; padding-right: 0">תקף בימים</span>

                                <b>
                                    @if (coupon.is_sun)
                                    {<span class="B-Right">א</span>}
                                    @if (coupon.is_mon)
                                    {<span class="B-Right">ב</span>}
                                    @if (coupon.is_tue)
                                    {<span class="B-Right">ג</span>}
                                    @if (coupon.is_wed)
                                    {<span class="B-Right">ד</span>}
                                    @if (coupon.is_thu)
                                    {<span class="B-Right">ה</span>}
                                    @if (coupon.is_fri)
                                    {<span class="B-Right">ו</span>}
                                    @if (coupon.is_sat)
                                    {<span class="B-Right">שבת</span>}

                                </b>
                                <span class="B-Right"> <b>@coupon.validity_start_hour - @coupon.validity_end_hour</b></span>

                            </div>



                            @if (!coupon.allow_multi_discount)
                            {
                                <div class="C">ללא כפל מבצעים</div>
                            }
                            @if (!coupon.allow_multi_coupon)
                            {
                                <div class="C">ללא כפל קופונים</div>
                            }
                            @if (coupon.max_discount_rate_validity > 0)
                            {
                                <div class="C">אחוז הנחה מקסימלי <b><span>@coupon.max_discount_rate_validity</span>%</b></div>
                            }
                            @if (coupon.days_to_expire > 0)
                            {
                                <div class="C">בתוקף למשך <b>@coupon.days_to_expire ימים</b> מההנפקה</div>
                            }
                            @if (coupon.min_order_total > 0)
                            {
                                <div class="C">תקף בהזמנות מעל <b>@coupon.min_order_total.ToString("C", culture)</b> </div>
                            }
                            @if (coupon.max_order_total > 0)
                            {
                                <div class="C">תקף בהזמנות מתחת <b>@coupon.max_order_total.ToString("C", culture)</b>  </div>
                            }
                            @if (coupon.max_coupon_value > 0)
                            {
                                <div class="C">ערך קופון מקסימלי <b>@coupon.max_coupon_value.ToString("C", culture)</b> </div>
                            }

                            @if (coupon.invoking_orders_count > 0)
                            {
                                <div class="C">תקף רק עבור משתמשים שביצעו יותר מ <b>@coupon.invoking_orders_count הזמנות</b> </div>
                            }

                            @if (coupon.membership_duration_months > 0)
                            {
                                <div class="C">תקף רק עבור משתמשים בעלי ותק של לפחות <b>@coupon.membership_duration_months חודשים</b> </div>
                            }

                            @if (coupon.terms != "")
                            {
                                <div class="C"><b>תנאים נוספים</b><br />@coupon.terms</div>
                            }

                            @if (coupon.terms_e != "")
                            {
                                <div class="C"><b>Additional Terms</b><br />@coupon.terms_e</div>
                            }

                            <div class="C"><b>תאריך תפוגה</b><br />@coupon.expiration_date.ToShortDateString()</div>
                        </div>

                    </div>


                </div>
            </form>




        </div>

    }


    <div style="overflow: auto;height: 200px;">&nbsp;</div>


    db.Close();
}
