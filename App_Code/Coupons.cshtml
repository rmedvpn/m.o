    public static string DoCouponIssue()
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        string theHtmlOutput = "";
        DateTime local_time = AppFunctions.LocalTime();
        DateTime exp_date = local_time.AddYears(1);
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;

        int member_id = 0; try { member_id = Convert.ToInt32(Request["value"]); } catch { }
        int coupon_id = 0; try { coupon_id = Convert.ToInt32(Request["coupon_id"]); } catch { }
        int round_id = 0; try { round_id = Convert.ToInt32(Request["round_id"]); } catch { }
        if (round_id == -1) { round_id = 0; }
        try { exp_date = Convert.ToDateTime(Request["exp_date"]); } catch { }

        int usage_limit = -1;
        if (!Request["is_usage_limit"].IsEmpty())
        {
            try { usage_limit = Convert.ToInt32(Request["usage_limit"]); } catch { }
        }




        int usage_count = 0;

        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "SELECT serial FROM memberCoupons WHERE coupon_id=@0 AND member_id=@1 AND round_id=@2";
        var coupon = db.QuerySingle(sqlSelect, coupon_id, member_id, round_id);
        if (coupon == null)
        {

            sqlSelect = "INSERT INTO memberCoupons(create_ts,rep_id,coupon_id,member_id,exp_date,usage_limit,usage_count,round_id) VALUES(@0,@1,@2,@3,@4,@5,@6,@7)";
            db.Execute(sqlSelect, local_time, rep_id, coupon_id, member_id, exp_date, usage_limit, usage_count, round_id);
            theHtmlOutput = "הקופון נופק בהצלחה!";
        }
        else
        {
            theHtmlOutput = "הקופון הזה מנופק כבר!";
        }
        db.Close();



        return theHtmlOutput;
    }

