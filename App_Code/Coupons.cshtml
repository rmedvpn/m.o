@helper CouponSelectCatProduct(int coupon_id, int round_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    DateTime local_time = AppFunctions.LocalTime();
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM coupons WHERE coupon_id=@0";
    var coupon = db.QuerySingle(sqlSelect, coupon_id);
    int free_product_cat_id = 0;
    int free_product_itemunit = 0;
    string itemunit = "";
    int free_product_quan = 0;
    if (coupon != null)
    {
        free_product_cat_id = coupon.free_product_cat_id;
        free_product_itemunit = coupon.free_product_itemunit;
        free_product_quan = coupon.free_product_quan;
        itemunit = NewAppFunctions.GetTitleById("ItemType", free_product_itemunit);
        sqlSelect = "SELECT * FROM roundmenuitems WHERE is_active=1 AND (maincat_id=@0 OR sub_cat_id=@0) AND round_id=@1 AND itemunit_type=@2";
        var RelevantProducts = db.Query(sqlSelect, free_product_cat_id, round_id, free_product_itemunit);
        string checker = "";
        string selectedRowClass = "ProdCatSelector";
        if (RelevantProducts.Count() == 1)
        {
            checker = "Checked";
            selectedRowClass = "ProdCatSelector_selected";
        }

        if (RelevantProducts.Count() > 0)
        {
            <div class="B">
                <div class="B" style="font-size:16px;margin-right:5px"><B>נא לבחור את המוצר הרלוונטי </B> <span class="PrplMiniTag" style="color:#b200ff">(@free_product_quan @itemunit)</span></div>
                <input type="hidden" name="selected_prod" id="selected_prod" value="" />
                @foreach (var item in RelevantProducts)
                {
                    <div class="B">

                        <div class="@selectedRowClass" style="border-bottom: 1px dashed #808080;" id="IR_@item.id">

                            <div style="overflow: auto;">
                                <div class="B" style="float: right">
                                    <input class="A" type="radio" name="selected_prod" @checker value="@item.id" onclick="setElementClass('IR_' + document.getElementById('selected_prod').value, 'ProdCatSelector'); document.getElementById('selected_prod').value = this.value;setElementClass('IR_' + document.getElementById('selected_prod').value,'ProdCatSelector_selected');" />
                                </div>

                                <div class="B" style="float:right;margin-right:10px;">
                                    <div class="B" style="font-size:14px">
                                        @item.title
                                    </div>
                                </div>
                                <div class="B" style="float:left;margin-left:5px;">

                                    <div class="B">
                                        <span class="MiniTag"> מוצר #@item.p_id</span>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                }
                <div class="B" style="font-size:16px;text-align:center">
                    <button type="button" class="A" style="width:95%;background-color:#000;color:#fff" onclick="AjaxActions('APPLYCOUPONTOORDER', document.getElementById('target_order_id').value, 'MainLoader', '@coupon.coupon_id', document.getElementById('selected_prod').value);"><b>בחירת מוצר>></b></button>
                </div>

            </div>

        }
        else
        {
            <div class="B">

                <span style="color:#f00">אין מוצרים רלוונטים בתפריט</span>

            </div>

        }




    }

    db.Close();

}




@helper CouponSummary(int coupon_id, bool is_selector = false)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    DateTime local_time = AppFunctions.LocalTime();
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM coupons WHERE coupon_id=@0";
    var coupon = db.QuerySingle(sqlSelect, coupon_id);

    string coupon_code = coupon.coupon_code;
    string coupon_code_e = coupon.coupon_code_e;
    string coupon_title = coupon.coupon_title;
    string coupon_title_e = coupon.coupon_title_e;
    string coupon_notes = coupon.coupon_notes;
    string coupon_notes_e = coupon.coupon_notes_e;
    string offer_type = coupon.offer_type;
    int free_product_id = coupon.free_product_id;
    int free_product_quan = coupon.free_product_quan;
    string free_product_scope = coupon.free_product_scope;
    int invoking_product_id = coupon.invoking_product_id;
    int invoking_product_quan = coupon.invoking_product_quan;
    bool allow_multi_discount = coupon.allow_multi_discount;
    bool allow_multi_coupon = coupon.allow_multi_coupon;
    decimal max_discount_rate_validity = coupon.max_discount_rate_validity;
    int days_to_expire = coupon.days_to_expire;
    decimal min_order_total = coupon.min_order_total;
    decimal max_order_total = coupon.max_order_total;
    decimal max_coupon_value = coupon.max_coupon_value;
    string coupon_terms = coupon.coupon_terms;
    string coupon_item_type = coupon.coupon_item_type;
    decimal item_discount_rate = coupon.item_discount_rate;
    decimal offer_price = coupon.offer_price;
    decimal activation_order_total = coupon.activation_order_total;
    bool does_min_order_total_includes_spItems = coupon.does_min_order_total_includes_spItems;
    bool does_min_order_total_includes_sh = coupon.does_min_order_total_includes_sh;
    bool is_min_cat_purchase = coupon.is_min_cat_purchase;
    decimal cat_invoking_amount = coupon.cat_invoking_amount;
    int invoking_cat_Id = coupon.invoking_cat_Id;
    bool is_cat_invoking_items_count = coupon.is_cat_invoking_items_count;
    int cat_invoking_items_count = coupon.cat_invoking_items_count;
    bool is_sun = coupon.is_sun;
    bool is_mon = coupon.is_mon;
    bool is_tue = coupon.is_tue;
    bool is_wed = coupon.is_wed;
    bool is_thu = coupon.is_thu;
    bool is_fri = coupon.is_fri;
    bool is_sat = coupon.is_sat;
    string validity_start_hour = coupon.validity_start_hour;
    string validity_end_hour = coupon.validity_end_hour;
    decimal order_discount_amount = coupon.order_discount_amount;
    decimal order_discount_percantage = coupon.order_discount_percantage;
    string voucher_type = coupon.voucher_type;
    decimal credit_amount = coupon.credit_amount;
    decimal shipping_price = coupon.shipping_price;
    string shipping_cost_type = coupon.shipping_cost_type;
    string terms = coupon.terms;
    string terms_e = coupon.terms_e;
    DateTime expiration_date = coupon.expiration_date;
    bool does_discount_includes_spItems = coupon.does_discount_includes_spItems;
    bool does_discount_includes_sh = coupon.does_discount_includes_sh;
    int invoking_orders_count = coupon.invoking_orders_count;
    int membership_duration_months = coupon.membership_duration_months;
    int max_in_cart = coupon.max_in_cart;


    <div class="B" id="CouponInfoDiv_@coupon_id">
        @switch (offer_type)
        {
            case "ITEM":
                if (true)
                {
                    if (free_product_scope == "PROD")
                    {
                        sqlSelect = "SELECT itemunit,title FROM products WHERE p_id=@0";
                        var prod = db.QuerySingle(sqlSelect, free_product_id);
                        string itemunit = "";
                        string product_title = "";

                        if (prod != null)
                        {
                            itemunit = prod.itemunit;
                            product_title = prod.title;
                        }
                        <div class="B">
                            @free_product_quan @itemunit @product_title <span class="PrplMiniTag">(#@free_product_id)</span>
                            @if (coupon_item_type == "FREE")
                            {<span><b>בחינם</b></span>}
                            @if (coupon_item_type == "DISC")
                            {<span>בהנחה של <b>@String.Format("{0:0.00}", item_discount_rate)%</b></span>}

                            @if (coupon_item_type == "PRICE")
                            {<span>במחיר <b>@offer_price.ToString("C", culture)</b></span>}
                        </div>

                    }

                    if (free_product_scope == "CAT")
                    {
                        int free_product_cat_id = coupon.free_product_cat_id;
                        int free_product_itemunit = coupon.free_product_itemunit;
                        sqlSelect = "SELECT title FROM Categories WHERE id=@0";
                        var cat = db.QuerySingle(sqlSelect, free_product_cat_id);

                        if (cat != null)
                        {

                            string itemunit = "";
                            string cat_title = "";
                            cat_title = cat.title;
                            itemunit = NewAppFunctions.GetTitleById("ItemType", free_product_itemunit);

                            <div class="B">
                                @free_product_quan @itemunit מקטגורית @cat_title <span class="PrplMiniTag">(#@free_product_cat_id)</span>
                                @if (coupon_item_type == "FREE")
                                {<span><b>בחינם</b></span>}
                                @if (coupon_item_type == "DISC")
                                {<span>בהנחה של <b>@String.Format("{0:0.00}", item_discount_rate)%</b></span>}

                                @if (coupon_item_type == "PRICE")
                                {<span>במחיר <b>@offer_price.ToString("C", culture)</b></span>}
                            </div>

                        }
                    }


                }

                break;

            case "VOUCHER":
                if (true)
                {
                    string offer_type_title = "";

                    switch (voucher_type)
                    {
                        case "DISC":
                            offer_type_title = "שובר הנחה";
                            break;
                        case "GIFT":
                            offer_type_title = "שובר מתנה";
                            break;
                    }

                    <div class="B">

                        @if (voucher_type == "DISC")
                        {
                            <span> שובר הנחה בשיעור <b>@String.Format("{0:0.00}", coupon.order_discount_percantage)%</b></span>
                            <div class="B"></div>
                            if (does_discount_includes_sh)
                            {
                                <span class="PrplMiniTag">* הנחה גם על דמי משלוח</span>
                            }
                            else
                            {
                                <span class="RedMiniTag">* ללא הנחה על דמי משלוח</span>
                            }
                            if (does_discount_includes_spItems)
                            {
                                <span class="PrplMiniTag">* הנחה גם על מבצעים</span>
                            }
                            else
                            {
                                <span class="RedMiniTag">* הנחה לא תקפה על מבצעים</span>
                            }
                        }
                        @if (voucher_type == "GIFT")
                        {<span> שובר מתנה בסך <b>@order_discount_amount.ToString("C", culture)</b></span>}
                    </div>

                }

                break;

            case "CREDIT":
                if (true)
                {


                    <div class="B">
                        <span> שובר זיכוי בסך <b>@credit_amount.ToString("C", culture)</b></span>
                    </div>

                }

                break;

            case "SHIPPING":
                if (true)
                {
                    string offer_type_title = "";

                    switch (shipping_cost_type)
                    {
                        case "FREE":
                            offer_type_title = "משלוח <b>חינם</b>";
                            break;
                        case "PRICE":
                            offer_type_title = "משלוח בעלות <b>" + shipping_price.ToString("C", culture) + "</b>";
                            break;
                    }

                    <div class="B">הטבת @Html.Raw(offer_type_title)</div>

                }

                break;


            default:
                break;
        }

        @switch (coupon_terms)
        {
            case "BYPRODUCT":
                if (true)
                {
                    sqlSelect = "SELECT itemunit,title FROM products WHERE p_id=@0";
                    var prod = db.QuerySingle(sqlSelect, invoking_product_id);
                    string itemunit = "";
                    string product_title = "";
                    if (prod != null)
                    {
                        itemunit = prod.itemunit;
                        product_title = prod.title;
                    }

                    <div class="B">בקניה של @invoking_product_quan @itemunit מהמוצר @product_title <span class="PrplMiniTag">(#@invoking_product_id)</span></div>
                }
                break;

            case "OVERAMOUNT":
                <div class="B">
                    בביצוע הזמנה מעל <b>@activation_order_total.ToString("C", culture)</b>
                    <div class="B">
                        @if (does_min_order_total_includes_spItems)
                        {
                            <span class="PrplMiniTag">👈 כולל מבצעים והטבות נוספות</span>
                        }

                        @if (does_min_order_total_includes_sh)
                        {
                            <span class="PrplMiniTag">👈 כולל דמי משלוח</span>
                        }
                    </div>
                </div>
                break;

            case "PRODBYCAT":
                if (true)
                {
                    sqlSelect = "SELECT * FROM categories WHERE id=@0";
                    var cat = db.QuerySingle(sqlSelect, invoking_cat_Id);
                    string cat_title = "";
                    if (cat != null)
                    {
                        cat_title = cat.title;
                        if (!cat.is_mainCat)
                        {
                            sqlSelect = "SELECT title FROM categories WHERE id=@0";
                            var mainCat = db.QuerySingle(sqlSelect, cat.mainCat_id);
                            if (mainCat != null)
                            {
                                cat_title = mainCat.title + "-" + cat_title;
                            }
                        }
                        cat_title = "<B> " + cat_title + "</B>";
                    }

                    string term_title = "בקניה של ";

                    string term_title_b = "מוצר כלשהו ";
                    if (is_cat_invoking_items_count)
                    {
                        if (cat_invoking_items_count > 1)
                        {
                            term_title_b = cat_invoking_items_count + " מוצרים כלשהם ";
                        }
                    }

                    string term_title_c = "מהקטגוריה " + cat_title + "<span class=\"PrplMiniTag\"> (#" + invoking_cat_Id + ")</span>";
                    string term_title_d = " בכל סכום שהוא";

                    if (is_min_cat_purchase)
                    {
                        if (cat_invoking_amount > 0)
                        {
                            term_title_d = " בסכום של לפחות " + cat_invoking_amount.ToString("C", culture);
                        }
                    }

                    term_title = term_title + term_title_b + term_title_c + term_title_d;


                    <div class="B">@Html.Raw(term_title)</div>
                }
                break;

            case "NONE":
                <div class="B">
                    ללא תנאים


                </div>
                break;
            default:
                break;
        }
    </div>

    <div class="B" id="CouponRestrictionsDiv_@coupon_id">
        <div class="B">
            <span class="MiniTag" style="margin-right: 0; padding-right: 0"><b>תקף בימים</b></span>
            @if (is_sun)
            {<span class="MiniTag">א</span>}
            @if (is_mon)
            {<span class="MiniTag">ב</span>}
            @if (is_tue)
            {<span class="MiniTag">ג</span>}
            @if (is_wed)
            {<span class="MiniTag">ד</span>}
            @if (is_thu)
            {<span class="MiniTag">ה</span>}
            @if (is_fri)
            {<span class="MiniTag">ו</span>}
            @if (is_sat)
            {<span class="MiniTag">שבת</span>}

            <span class="MiniTag"> <b>@validity_start_hour - @validity_end_hour</b></span>

        </div>

        <div class="B">

            @if (!allow_multi_discount)
            {
                <span class="RedMiniTag">ללא כפל מבצעים</span>
            }
            @if (!allow_multi_coupon)
            {
                <span class="RedMiniTag">ללא כפל קופונים</span>
            }
            @if (max_discount_rate_validity > 0)
            {
                <span class="MiniTag">אחוז הנחה מקסימלי <b><span>@max_discount_rate_validity</span>%</b></span>
            }
            @if (days_to_expire > 0)
            {
                <span class="MiniTag">בתוקף למשך <b>@days_to_expire ימים</b> מההנפקה</span>
            }
            @if (min_order_total > 0)
            {
                <span class="RedMiniTag">תקף בהזמנות מעל <b>@min_order_total.ToString("C", culture)</b> </span>
            }
            @if (max_order_total > 0)
            {
                <span class="MiniTag">תקף בהזמנות מתחת <b>@max_order_total.ToString("C", culture)</b>  </span>
            }
            @if (max_coupon_value > 0)
            {
                <span class="RedMiniTag">ערך קופון מקסימלי <b>@max_coupon_value.ToString("C", culture)</b> </span>
            }

            @if (invoking_orders_count > 0)
            {
                <span class="MiniTag">תקף רק עבור משתמשים שביצעו יותר מ <b>@invoking_orders_count הזמנות</b> </span>
            }

            @if (membership_duration_months > 0)
            {
                <span class="MiniTag">תקף רק עבור משתמשים בעלי ותק של לפחות <b>@membership_duration_months חודשים</b> </span>
            }
            @if (max_in_cart > 0)
            {
                <span class="MiniTag">מספר מקסימלי של קופונים מסוג זה לשימוש בהזמנה אחת <b>@max_in_cart</b> </span>
            }
            @if (!terms.IsEmpty())
            {
                <div class="B">
                    <span class="MiniTag"><b>תנאים נוספים</b><br />@terms</span>
                </div>
            }

            @if (!terms_e.IsEmpty())
            {
                <div class="B">
                    <span class="MiniTag"><b>Additional Terms</b><br />@terms_e</span>
                </div>
            }
        </div>
        <div class="B">
            <span class="RedMiniTag">
                <b>בתוקף עד </b>@expiration_date.ToShortDateString()
            </span>
        </div>
    </div>



    db.Close();

}



