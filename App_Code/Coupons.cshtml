@helper VerifyCouponCreation()
{

    string errTxt = ""; try { errTxt = Coupons.ValidateCouponCreation(); } catch { }

    if (errTxt == "")
    {
        <div>@Coupons.ReviewCouponCreation()</div>
    }
    else
    {
        <div class="A">
            <div class="A">
                <h2>⚠️ יצירת קופון - יש בעיה!</h2>
            </div>
            <div class="A" style="color:#f00">
                <div>@Html.Raw(errTxt)</div>
            </div>
            <div class="A" style="text-align:center">
                <button type="button" class="A" onclick="clearContent('SubMenuLeftContent');controller.open('GenSb');">תיקון</button>
            </div>
        </div>
    }




}
