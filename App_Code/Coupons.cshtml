                            {
                                ret_string += "מוצר ההטבה אינו קיים בתפריט";

                            }
                        }

                        if (free_product_scope == "CAT")
                        {
                            //check if item available for sale to the specified order
                            //if item available: check terms
                            sqlSelect = "";
                            sqlSelect = "SELECT p_id FROM roundMenuItems WHERE is_active=1 AND (maincat_id=@0 or sub_cat_id=@0) AND round_id=@1 AND itemunit_type=@2";
                            var free_product = db.QuerySingle(sqlSelect, coupon.free_product_cat_id, cart.round_id, coupon.free_product_itemunit);
                            if (free_product == null)
                            {
                                ret_string += "לא קיימים מוצרים מתאימים בתפריט";

                            }
                        }


                    }

                    break;
                case "VOUCHER":
                    if (true)
                    {

                    }
                    break;
                case "CREDIT":
                    if (true)
                    {

                    }
                    break;
                case "SHIPPING":
                    if (true)
                    {

                    }
                    break;
            }

            switch (coupon_terms)
            {

                case "BYPRODUCT":
                    if (true)
                    {
                        //check if invoking product is in quan
                        sqlSelect = "SELECT p_id,quan FROM MainCart WHERE p_id=@0 or catalog_p_id=@0 AND u_id=@1 AND round_id=@2 AND rep_id=@3 AND order_id=@4";
                        var invoking_product_in_cart = db.QuerySingle(sqlSelect, coupon.invoking_product_id, member_id, cart.round_id, cart.rep_id, order_id);
                        if (invoking_product_in_cart == null)
                        {
                            ret_string += "המוצר המזכה אינו קיים בעגלה!<br>";
                        }
                        else
                        {
                            if (coupon.invoking_product_quan > invoking_product_in_cart.quan)
                            {
                                ret_string += "המוצר המזכה אינו קיים בעגלה בכמות הנדרשת להפעלת הקופון!<br>";
                            }
                        }

                    }
                    break;

                case "OVERAMOUNT":
                    if (true)
                    {
                        if (grand_total < coupon.activation_order_total)
                        {
                            ret_string += "ההזמנה אינה עומדת בסכום המינימום להפעלת הקופון בסך של " + coupon.activation_order_total.ToString("C", culture) + "!<br>";
                        }
                    }
                    break;

                case "PRODBYCAT":
                    if (true)
                    {
                        int cat_invoking_items_count = coupon.cat_invoking_items_count;
                        int invoking_cat_Id = coupon.invoking_cat_Id;
                        decimal cat_invoking_amount = coupon.cat_invoking_amount;

                        sqlSelect = "SELECT MainCart.p_id,MainCart.quan FROM MainCart INNER JOIN RoundMenuItems ON MainCart.item_id=roundMenuItems.id WHERE roundMenuItems.sub_cat_id=@0  or roundMenuItems.maincat_id=@0 AND MainCart.u_id=@1 AND MainCart.round_id=@2 AND MainCart.rep_id=@3 AND MainCart.order_id=@4";
                        var invoking_cat_products_in_cart = db.Query(sqlSelect, coupon.invoking_cat_Id, member_id, cart.round_id, cart.rep_id, order_id);
                        if (invoking_cat_products_in_cart.Count == 0)
                        {
                            ret_string += "אין בהזמנה מוצרים מהקטגוריה המזכה " + NewAppFunctions.GetTitleById("Cat", coupon.invoking_cat_Id) + "!<br>";
                        }
                        else
                        {
                            if (invoking_cat_products_in_cart.Count < coupon.cat_invoking_items_count)
                            {
                                ret_string += "אין בהזמנה מספיק מוצרים מהקטגוריה המזכה " + NewAppFunctions.GetTitleById("Cat", coupon.invoking_cat_Id) + "!<br>";
                            }
                            else
                            {
                                sqlSelect = "SELECT SUM(MainCart.calc_price) AS catItemsTotal FROM MainCart INNER JOIN RoundMenuItems ON MainCart.item_id=roundMenuItems.id WHERE roundMenuItems.sub_cat_id=@0  or roundMenuItems.maincat_id=@0 AND MainCart.u_id=@1 AND MainCart.round_id=@2 AND MainCart.rep_id=@3 AND MainCart.order_id=@4";
                                invoking_cat_products_in_cart = db.QuerySingle(sqlSelect, coupon.invoking_cat_Id, member_id, cart.round_id, cart.rep_id, order_id);
                                decimal catItemsTotal = 0;
                                try { catItemsTotal = invoking_cat_products_in_cart.catItemsTotal; } catch { }
                                if (catItemsTotal < cat_invoking_amount)
                                {
                                    ret_string += "אין בהזמנה מוצרים מהקטגוריה המזכה " + NewAppFunctions.GetTitleById("Cat", coupon.invoking_cat_Id) + " בשווי של " + cat_invoking_amount.ToString("C", culture) + "!<br>";
                                }
                            }

                        }
                    }
                    break;



                case "NONE":
                    break;
            }

            //check day & time availablity
            bool is_available_today = false;
            switch (curDateOfWeek)
            {
                case 0: if (coupon.is_sun) { is_available_today = true; } break;
                case 1: if (coupon.is_mon) { is_available_today = true; } break;
                case 2: if (coupon.is_tue) { is_available_today = true; } break;
                case 3: if (coupon.is_wed) { is_available_today = true; } break;
                case 4: if (coupon.is_thu) { is_available_today = true; } break;
                case 5: if (coupon.is_fri) { is_available_today = true; } break;
                case 6: if (coupon.is_sat) { is_available_today = true; } break;

            }
            if (!is_available_today)
            {
                ret_string += "הקופון אינו תקף היום!<br>";

            }
            else
            {
                DateTime validity_start_hour = Convert.ToDateTime(local_time.ToShortDateString() + " " + coupon.validity_start_hour);
                DateTime validity_end_hour = Convert.ToDateTime(local_time.ToShortDateString() + " " + coupon.validity_end_hour);

                if (local_time > validity_start_hour && local_time < validity_end_hour) { }
                else
                {
                    ret_string += "קופון זה אינו בתוקף בשעה זו. הקופון תקף בשעות " + coupon.validity_start_hour + " - " + coupon.validity_end_hour + "!<br>";
                }


            }

            //check multi coupons restriction
            bool allow_multi_coupon = coupon.allow_multi_coupon;
            if (!allow_multi_coupon)
            {
                sqlSelect = "SELECT p_id,quan FROM MainCart WHERE item_id<>-9 AND item_id<=-5 AND item_id>-11 AND u_id=@0 AND round_id=@1 AND rep_id=@2 AND order_id=@3";
                var coupons_in_cart = db.Query(sqlSelect, member_id, cart.round_id, cart.rep_id, order_id);
                if (coupons_in_cart.Count > 0)
                {
                    ret_string += "לא ניתן להפעיל קופון זה כאשר קיים כבר קופון פעיל אחר בעגלה!<br>";
                }
            }
            //check multi discounts restriction
            bool allow_multi_discount = coupon.allow_multi_discount;
            if (!allow_multi_discount)
            {
                decimal discount_total = 0;
                sqlSelect = "SELECT discount_total FROM CartSettings WHERE u_id=@0 AND round_id=@1 AND rep_id=@2 AND order_id=@3";
                var cartDiscount = db.QuerySingle(sqlSelect, member_id, cart.round_id, cart.rep_id, order_id);
                try { discount_total = cartDiscount.discount_total; } catch { }
                if (discount_total > 0)
                {
                    ret_string += "לא ניתן להפעיל קופון זה כאשר קיימת כבר הנחה בעגלה!<br>";
                }
            }

            //check max in cart restriction
            int max_in_cart = coupon.max_in_cart;
            if (max_in_cart > 0)
            {
                sqlSelect = "SELECT Count(id) AS coupon_cnt FROM MainCart WHERE (item_id=-5 OR item_id<-6)  AND item_id>-11  AND rep_id=@0 AND order_id=@1 AND special_id=@2";
                var couponCounter = db.QuerySingle(sqlSelect, cart.rep_id, order_id, coupon.coupon_id);
                if (couponCounter != null)
                {
                    if (max_in_cart <= couponCounter.coupon_cnt)
                    {
                        ret_string += "לא ניתן להפעיל קופון זה - בכל הזמנה ניתן להשתמש בקופון זה רק " + max_in_cart + " פעמים!<br>";
                    }
                }

            }

            //check min order amount restriction
            //check max order amount restriction
            if (grand_total < coupon.min_order_total && coupon.min_order_total > 0)
            {
                ret_string += "ההזמנה אינה עומדת בסכום המינימום להפעלת הקופון בסך של " + coupon.min_order_total.ToString("C", culture) + "!<br>";
            }
            if (grand_total > coupon.max_order_total && coupon.max_order_total > 0)
            {
                ret_string += "סכום ההזמנה גבוה מסכום המקסימום להפעלת הקופון בסך של " + coupon.max_order_total.ToString("C", culture) + "!<br>";
            }


            //check member order count restriction
            int invoking_orders_count = coupon.invoking_orders_count;
            sqlSelect = "SELECT create_ts,anniversary_ts,serial,oc FROM pb WHERE m_id=@0";
            var member = db.QuerySingle(sqlSelect, member_id);
            if (member != null)
            {
                DateTime defDate = Convert.ToDateTime("1/1/1900");
                DateTime create_ts = member.create_ts;
                DateTime anniversary_ts = member.anniversary_ts;
                DateTime join_date = anniversary_ts;
                if (member.oc < invoking_orders_count)
                {
                    ret_string += "קופון זה בתוקף רק למשתמשים שביצעו יותר מ" + invoking_orders_count + " הזמנות!<br>";
                }

                //check member seniority restriction
                int membership_duration_months = AppFunctions.HowManyMonthsAgoWas(join_date);
                if (membership_duration_months < coupon.membership_duration_months)
                {
                    ret_string += "קופון זה בתוקף רק למשתמשים שחברים במערכת מעל ל" + membership_duration_months + " חודשים!<br>";
                }
            }


            //check coupon validity date restriction
            if (coupon.expiration_date < local_time)
            {
                ret_string += "תוקפו של קופון זה פג בתאריך " + coupon.expiration_date.ToShortDateString() + "!<br>";
            }


            //check coupon value restriction
            //TBD if needed
        }

        db.Close();
        return ret_string;
    }
