                            <div class="B" style="text-align: center; display: none" id="CouponProductSelectorLoader">
                                <center>
                                    <div class="spinner"><div class="bounce1"></div><div class="bounce2"></div><div class="bounce3"></div></div>
                                </center>
                            </div>

                        </div>
                        <div class="B" id="CouponProductSelectorResults">
                            @if (free_product_scope == "PROD")
                            {
                                <div>@Coupons.CouponProductSelector(free_product_id, coupon_id)</div>
                            }
                            @if (free_product_scope == "CAT")
                            {
                                <div>@Coupons.CouponCategorySelector(free_product_cat_id, coupon_id)</div>
                            }


                        </div>


                    </div>
                }

                break;

            case "VOUCHER":
                if (true)
                {


                    <div class="A">
                        הגדרת קופון מתנה / הנחה
                        <div class="C">
                            <input type="radio" style="width:30px;" name="voucher_type" value="GIFT" @if (voucher_type == "GIFT") { <text> checked</text>} /> שובר מתנה בסך

                            <div style="float:left"><input type="text" class="A" style="width:30px;" name="order_discount_amount" placeholder="₪" @if (order_discount_amount > 0) { <text> value="@Convert.ToInt32(order_discount_amount)" </text> } />₪</div>

                        </div>
                        <div class="C">
                            <div class="B">
                                <input type="radio" style="width:30px;" name="voucher_type" value="DISC" @if (voucher_type == "DISC") { <text> checked</text>} /> שובר הנחה בשיעור
                                <div style="float:left"><input type="text" class="A" style="width:30px;" name="order_discount_percantage" placeholder="%" @if (order_discount_percantage > 0) { <text> value="@String.Format("{0:0.0}", order_discount_percantage)" </text> } />%</div>

                            </div>

                        </div>
                        @if (!is_voucher)
                        {
                            <div class="C">
                                <div class="A">
                                    הנחה גם על מבצעים?
                                    <div style="float:left"><input type="checkbox" class="A" name="does_discount_includes_spItems" @if (does_discount_includes_spItems) { <text> checked</text>} /></div>

                                </div>
                                <div class="A">
                                    הנחה גם על דמי המשלוח?
                                    <div style="float:left"><input type="checkbox" class="A" name="does_discount_includes_sh" @if (does_discount_includes_sh) { <text> checked</text>} /></div>

                                </div>
                            </div>
                        }


                    </div>

                }
                break;

            case "CREDIT":
                if (true && !is_voucher)
                {
                    <div class="A">
                        הגדרת קופון שובר זיכוי
                        <div class="C">
                            שובר זיכוי בסך

                            <div style="float:left"><input type="text" class="A" style="width:40px;" name="credit_amount" placeholder="₪" @if (credit_amount > 0) { <text> value="@Convert.ToInt32(credit_amount)" </text> } />₪</div>

                        </div>

                    </div>
                }
                break;

            case "SHIPPING":
                if (true)
                {
                    string shipping_price_div_display_state = "none;";
                    if (shipping_price > 0)
                    {
                        shipping_price_div_display_state = "block;";
                    }

                    <div class="A">
                        הגדרת קופון משלוח חינם / מוזל
                        <div class="C">
                            <input type="radio" style="width:30px;" name="shipping_cost_type" value="FREE" @if (shipping_cost_type == "FREE") { <text> checked</text>} onclick="if (this.checked) { hideElement('shipping_price_div'); }" /> משלוח חינם
                        </div>
                        <div class="C">
                            <input type="radio" style="width:30px;" name="shipping_cost_type" value="PRICE" @if (shipping_cost_type == "PRICE") { <text> checked</text>} onclick="if (this.checked) { showElement('shipping_price_div'); }" /> משלוח מוזל

                            <div style="float:left;display:@shipping_price_div_display_state;" id="shipping_price_div"><input type="text" class="A" style="width:30px;" name="shipping_price" @if (shipping_price > 0) { <text> value="@Convert.ToInt32(shipping_price)" </text> } placeholder="₪" />₪</div>
                        </div>
                    </div>
                }
                break;


            case "":
                <div class="A">@offer_type</div>
                break;
            default:
                <div class="A">@offer_type</div>
                break;
        }


        <div class="B" style="text-align: center; display: none" id="CouponTermsLoader">
            <center>
                <div class="spinner"><div class="bounce1"></div><div class="bounce2"></div><div class="bounce3"></div></div>
            </center>
        </div>
        <div class="B" id="CouponTermsResults">
            @if (!is_voucher)
            {
                <div>
                    @Coupons.CouponTerms(coupon_id)
                </div>
            }

        </div>


        <div class="B" id="CouponRestrictions">
            @if (!is_voucher)
            {
                <div>
                    @Coupons.CouponRestrictions(coupon_id)
                </div>
            }


        </div>


    </div>





}
