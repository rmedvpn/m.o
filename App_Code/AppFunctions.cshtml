    public static double HowManyMinutesAgoWas(DateTime theDate)
    {

        TimeSpan spanSinceDate = AppFunctions.LocalTime() - theDate;
        return spanSinceDate.TotalMinutes;
    }

    public static int HowManyDaysAgoWas (DateTime theDate)
    {
        TimeSpan spanSinceDate = AppFunctions.LocalTime() - theDate;
        return spanSinceDate.Days;
    }
    public static int HowManyMonthsAgoWas(DateTime theDate)
    {

        DateTime local_time = AppFunctions.LocalTime();

        // TimeSpan spanSinceDate = local_time - theDate;
        return 12 * (local_time.Year - theDate.Year) + (local_time.Month - theDate.Month);
    }
    public static int HowManyYearsAgoWas (DateTime theDate)
    {
        TimeSpan spanSinceDate = AppFunctions.LocalTime() - theDate;
        decimal tmp = spanSinceDate.Days / 365;
        int tmpInt = Convert.ToInt32(tmp);
        return tmpInt;
    }
    public static int MinutesDifferenceToDate(DateTime theDate)
    {
        TimeSpan spanSinceDate = theDate - AppFunctions.LocalTime();
        int tmp = spanSinceDate.Minutes;
        return tmp;
    }
    public static string wanumize(string wanum)
    {
        string wanumized_str=wanum;

        wanumized_str=wanumized_str.Replace("(","");
        wanumized_str=wanumized_str.Replace(")","");
        wanumized_str=wanumized_str.Replace("+","");
        wanumized_str=wanumized_str.Replace(" ","");
        wanumized_str=wanumized_str.Replace("-","");
        wanumized_str=wanumized_str.Replace("‑","");
        wanumized_str=wanumized_str.Replace(" ","");

        if(wanumized_str.StartsWith("0")){
            wanumized_str = "972" + wanumized_str.Substring(1);
        }
        if(wanumized_str.StartsWith("50") || wanumized_str.StartsWith("51") || wanumized_str.StartsWith("52") || wanumized_str.StartsWith("53") || wanumized_str.StartsWith("54") || wanumized_str.StartsWith("55") || wanumized_str.StartsWith("56") || wanumized_str.StartsWith("57") || wanumized_str.StartsWith("58") || wanumized_str.StartsWith("59")){
            wanumized_str = "972" + wanumized_str;
        }



        return wanumized_str;

    }
