    public static void DoLogin(int u_id)
    {
        var op_data = Database.Open("op_data");
        DateTime local_time = AppFunctions.LocalTime();
        var sqlSelect = "SELECT * FROM members WHERE userId=@0";
        var member = op_data.QuerySingle(sqlSelect, u_id);
        if (member != null)
        {
            DateTime last_online = Convert.ToDateTime("1/1/1900"); try { last_online = member.last_online; } catch { }
            sqlSelect = "UPDATE RepTrack SET is_active=0,session_end=@0 WHERE u_id=@1 AND is_active=1";
            op_data.Execute(sqlSelect, last_online, u_id);
            sqlSelect = "INSERT INTO RepTrack (u_id,session_start,is_active) VALUES (@0,@1,1) ";
            op_data.Execute(sqlSelect, u_id, local_time);
            sqlSelect = "UPDATE members SET last_login=@0,last_online=@0 WHERE userId=@1";
            op_data.Execute(sqlSelect,  local_time,u_id);

            string logMsg = "המשתמש/ת " + member.username + " התחבר/ה למערכת";

            AppFunctions.WriteLog("LOGIN", u_id, logMsg,u_id);

        }


        op_data.Close();
    }

