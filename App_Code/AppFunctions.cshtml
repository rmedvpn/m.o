    public static void ChangeMemberWanum(int member_id, string new_wanum)
    {
        DateTime LocalTime = AppFunctions.LocalTime();
        var op_data = Database.Open("op_data");

        var sqlSelect = "SELECT serial,wanum,member_name FROM pb WHERE m_id=@0";
        var pbEntry = op_data.QuerySingle(sqlSelect, member_id);
        if (pbEntry != null)
        {
            int pb_id = pbEntry.serial;
            string wanum = pbEntry.wanum;
            string member_name = pbEntry.member_name;
            string changeTo = new_wanum;
            string changeFrom = wanum;
            sqlSelect = "INSERT INTO pb_sub_records(pb_id,m_id,wanum,nick,is_nick,is_update) VALUES(@0,@1,@2,@3,@4,1)";
            op_data.Execute(sqlSelect, pb_id, member_id, wanum, member_name, 0);

            sqlSelect = "UPDATE pb SET wanum=@0,is_update=1 WHERE serial=@1";
            op_data.Execute(sqlSelect, new_wanum, pb_id);

            sqlSelect = "UPDATE u_stats SET wanum=@0,is_update=1 WHERE serial=@1";
            op_data.Execute(sqlSelect, new_wanum, member_id);

            sqlSelect = "INSERT INTO pbActions(create_ts,actionCode,pb_id,m_id,changeFrom,changeTo,wanum,member_name) VALUES(@0,@1,@2,@3,@4,@5,@6,@7)";
            //op_data.Execute(sqlSelect, LocalTime, "WANUM", pb_id, member_id, changeFrom, changeTo, wanum, member_name);
            AppFunctions.CreatePBAction(member_id, "WANUM", changeTo,changeFrom);

        }
        op_data.Close();


    }

