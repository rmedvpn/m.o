    public static void CreatePBAction(int member_id,string ActionCode, string changeTo,string changeFrom="")
    {
        DateTime LocalTime = AppFunctions.LocalTime();
        int pb_id = 0;
        string wanum = "";
        string member_name = "";

        var op_data = Database.Open("op_data");

        var sqlSelect = "SELECT serial,wanum,member_name FROM pb WHERE m_id=@0";
        var pbEntry = op_data.QuerySingle(sqlSelect, member_id);
        if (pbEntry != null)
        {
            pb_id = pbEntry.serial;
            wanum = pbEntry.wanum;
            member_name = pbEntry.member_name;
        }

        sqlSelect = "DELETE FROM pbActions WHERE is_completed=0 AND ActionCode=@0 AND m_id=@1";
        op_data.Execute(sqlSelect, ActionCode, member_id);

        sqlSelect = "INSERT INTO pbActions(create_ts,ActionCode,pb_id,m_id,changeFrom,changeTo,wanum,member_name) VALUES(@0,@1,@2,@3,@4,@5,@6,@7)";
        op_data.Execute(sqlSelect, LocalTime, ActionCode, pb_id, member_id, changeFrom, changeTo, wanum, member_name);

        op_data.Close();


    }


    public static void BlockMember(int member_id)
    {
        int block_by = WebSecurity.CurrentUserId;

        DateTime LocalTime = AppFunctions.LocalTime();

        var op_data = Database.Open("op_data");
        var sqlSelect = "";

        sqlSelect = "SELECT * FROM pb WHERE m_id=@0";
        var pb_entry = op_data.QuerySingle(sqlSelect, member_id);
        if (pb_entry != null)
        {
            string member_name = pb_entry.member_name;

            //mark phonebook entries as blocked
            sqlSelect = "UPDATE pb SET is_blocked=1,block_ts=@0,block_by=@1,is_update=1 WHERE serial=@2";
            op_data.Execute(sqlSelect, LocalTime, block_by, pb_entry.serial);

            //mark phonebook user account as blocked
            sqlSelect = "UPDATE u_stats SET is_blocked=1,block_ts=@0,block_by=@1,is_update=1 WHERE serial=@2";
            op_data.Execute(sqlSelect, LocalTime, block_by, pb_entry.m_id);
            string logMsg = "המשתמש " + member_name + " נחסם!";
            AppFunctions.WriteLog("BLOCKMEMBER", block_by, logMsg);

        }


        op_data.Close();
    }

    public static void UnBlockMember(int member_id)
    {
        DateTime LocalTime = AppFunctions.LocalTime();
        int block_by = WebSecurity.CurrentUserId;

        var op_data = Database.Open("op_data");
        var sqlSelect = "";

        sqlSelect = "SELECT * FROM pb WHERE m_id=@0";
        var pb_entry = op_data.QuerySingle(sqlSelect, member_id);
        if (pb_entry != null)
        {
            string member_name = pb_entry.member_name;
            //mark phonebook entries as blocked
            sqlSelect = "UPDATE pb SET is_blocked=0,block_ts=@0,block_by=@1,is_update=1 WHERE serial=@2";
            op_data.Execute(sqlSelect, LocalTime, block_by, pb_entry.serial);

            //mark phonebook user account as blocked
            sqlSelect = "UPDATE u_stats SET is_blocked=0,block_ts=@0,block_by=@1,is_update=1 WHERE serial=@2";
            op_data.Execute(sqlSelect, LocalTime, block_by, pb_entry.m_id);
            string logMsg = "הוסרה החסימה מהמשתמש  " + member_name;
            AppFunctions.WriteLog("BLOCKMEMBER", block_by, logMsg);
        }


        op_data.Close();
    }

