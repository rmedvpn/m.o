    public static bool IsDigitsOnly(string str)
    {
        bool ret_val = true;
        foreach (char c in str)
        {
            if (c < '0' || c > '9')
                ret_val = false;
        }

        if (ret_val)
        {
            if (str.Length < 7 || str.Length > 14)
            {
                ret_val = false;
            }
        }

        return ret_val;
    }
    public static bool IsValidPhone(string str)
    {
        bool ret_val = true;
        foreach (char c in str)
        {
            if (c < '0' || c > '9')
                ret_val = false;
        }

        if (ret_val)
        {
            if (str.Length < 10 || str.Length > 14)
            {
                ret_val = false;
            }
        }

        return ret_val;
    }
    public static string FormatAnniversaryYears(int YearsAgo,int lang=1)
    {
        string retVal = "";

        switch (YearsAgo)
        {
            case 1:
                retVal = "שנה";
                break;

            case 2:
                retVal = "שנתיים";
                break;

            default:
                retVal = YearsAgo.ToString() +  " שנים";
                break;
        }

        return retVal;
    }

    public static string FormatRelativeDate(DateTime theDate,bool is_year=true,bool is_dayOfWeek=false,int lang=1)
    {
        DateTime curTime = AppFunctions.LocalTime();
        string retVal = "";

        int daysDiff = 0;
        TimeSpan daysUntilDate = theDate.Date - curTime.Date;
        daysDiff= daysUntilDate.Days;

        int dayOfWeek = ((int)theDate.DayOfWeek);


        switch (daysDiff)
        {
            case -1:
                retVal = "אתמול";
                break;
            case 0:
                retVal = "היום";
                break;

            case 1:
                retVal = "מחר";
                break;

            default:
                retVal = theDate.ToShortDateString() ;
                if (!is_year)
                {
                    retVal = theDate.ToString("dd/MM");
                }

                if (is_dayOfWeek)
                {
                    retVal = "יום " + AppFunctions.DayOfWeekTxt(((int)theDate.DayOfWeek)) + " " + retVal;
                }

                break;
        }

        return retVal;
    }

    public static string FormatStringMinutes(int valueToFormat,int lang = 1)
    {
        string retVal = "";

        int formattedValue = 0;
        int formattedReminder = 0;
        formattedValue = valueToFormat / 60;
        formattedReminder = valueToFormat % 60;

        if (formattedValue > 0)
        {
            retVal = formattedValue.ToString() + " שעות ";
        }
        if (formattedReminder > 0)
        {
            retVal = retVal + formattedReminder.ToString() + " דקות";
        }


        return retVal;
    }


    public static string DayOfWeekTxt(int dayOfWeek)
    {

        switch (dayOfWeek)
        {
            case 0: return "ראשון";
            case 1: return "שני";
            case 2: return "שלישי";
            case 3: return "רביעי";
            case 4: return "חמישי";
            case 5: return "שישי";
            case 6: return "שבת";
            default: return "";


        }

    }


    public static DateTime GetDateOfNextDayOfWeek(int requested_dayOfWeek)
    {

        DateTime local_time = AppFunctions.LocalTime();
        DateTime dateResult = local_time.Date;
        int todays_dayOfWeek = ((int)local_time.DayOfWeek);
        int dayDiff = 0;

        dayDiff = requested_dayOfWeek - todays_dayOfWeek;
        if (dayDiff < 0) { dayDiff += 7; }
        dateResult = dateResult.Date.AddDays(dayDiff);

        return dateResult;


    }


    public static string PopulateReachoutTemplate(int member_id, int template_id, string reachout_type = "REP", int list_id = 0)
    {
        int u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "";

        sqlSelect = "SELECT * FROM msgTemplates WHERE id=@0";
        var msgTemplate = db.QuerySingle(sqlSelect, template_id);
        string msgType = ""; try { msgType = msgTemplate.msgType; } catch { }
        DateTime local_time = AppFunctions.LocalTime();
        sqlSelect = "select u_Stats.*,pb.member_name,pb.wanum from u_Stats JOIN pb ON u_Stats.serial=pb.m_id WHERE u_Stats.serial=@0";
        var memberRs = db.QuerySingle(sqlSelect, member_id);
        string msgTxt = "";
        string MokedPhoneNumber = AppFunctions.GetAppProperty("MokedPhoneNumber");
        string DisconnectPhoneNumber = AppFunctions.GetAppProperty("DisconnectPhoneNumber");

        if (msgTemplate != null)
        {
            msgTxt = msgTemplate.msg_body;
            if (memberRs != null)
            {
                msgTxt = msgTxt.Replace("USERNAME", memberRs.member_name);
                msgTxt = msgTxt.Replace("REPNAME", WebSecurity.CurrentUserName);
                msgTxt = msgTxt.Replace("MOKEDPHONENUMBER", MokedPhoneNumber);
                msgTxt = msgTxt.Replace("DISCONNECTPHONENUMBER", DisconnectPhoneNumber);
                msgTxt = msgTxt.Replace("DATESTAMP30", local_time.AddDays(30).ToShortDateString());
                msgTxt = msgTxt.Replace("DATESTAMP14", local_time.AddDays(30).ToShortDateString());
                msgTxt = msgTxt.Replace("DATESTAMP7", local_time.AddDays(7).ToShortDateString());
                msgTxt = msgTxt.Replace("DATESTAMP", local_time.ToShortDateString());
                msgTxt = msgTxt.Replace("TIMESTAMP", local_time.ToShortDateString() + " " + local_time.ToString("HH:mm"));

                if (msgTxt.Contains("LODAYS"))
                {
                    TimeSpan DaysSinceLastOrder = local_time - memberRs.last_order_ts;
                    int lodays = DaysSinceLastOrder.Days;
                    msgTxt = msgTxt.Replace("LODAYS", lodays.ToString());
                }

                if (msgTxt.Contains("ANNIVERSARYYEARS"))
                {
                    TimeSpan DaysSinceFirstOrder = local_time - memberRs.first_order_ts;
                    int AnniversaryYears = local_time.Year - memberRs.first_order_ts.Year;
                    string AnniversaryYearsStr = ""; AnniversaryYearsStr = AppFunctions.FormatAnniversaryYears(AnniversaryYears);
                    msgTxt = msgTxt.Replace("ANNIVERSARYYEARS", AnniversaryYearsStr);
                }

                msgTxt = msgTxt.Replace("USER_ID", memberRs.serial.ToString());
                msgTxt = msgTxt.Replace("USERID", memberRs.serial.ToString());
                msgTxt = msgTxt.Replace("WANUM", memberRs.wanum);

            }
        }
        return msgTxt;
    }



