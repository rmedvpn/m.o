    public static int RegisterClientUserAsMember(int client_u_id,int site_id=1)
    {
        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        int rep_id = WebSecurity.CurrentUserId;
        int u_id = 0;
        int m_id = 0;

        bool is_existing = false;

        var op_data = Database.Open("op_data");

        var sqlSelect = "SELECT * FROM ClientUsers WHERE site_id=@0 AND u_id=@1";
        var ClientUser = op_data.QuerySingle(sqlSelect, site_id, client_u_id);
        if (ClientUser != null)
        {
            string wanum = ClientUser.wanum;
            string telegram_nick = ""; try { telegram_nick = ClientUser.telegram_nick; } catch { }
            string email = ""; try { email = ClientUser.email; } catch { }
            string UserName = ""; try { UserName = ClientUser.UserName; } catch { }
            string member_nick = ""; try { member_nick = ClientUser.member_nick; } catch { }
            string full_name = ""; try { full_name = ClientUser.full_name; } catch { }
            DateTime birth_date = defTime; try { birth_date = ClientUser.birth_date; } catch { }
            int def_area = 0; try { def_area = ClientUser.def_area; } catch { }
            int main_area_id = 0; try { main_area_id = ClientUser.main_area_id; } catch { }
            int pb_id = 0;


            sqlSelect = "SELECT m_id FROM pb WHERE wanum=@0";
            var pbEntry = op_data.QuerySingle(sqlSelect, wanum);
            if (pbEntry == null)
            {
                sqlSelect = "INSERT INTO pb(member_name,wanum,create_ts,created_by,is_update,is_main,last_change_ts,is_new,anniversary_ts,UserName,email,telegram_nick,birth_date,full_name,def_area,main_area_id,site_id,client_u_id) VALUES(@0,@1,@2,@3,@4,@5,@6,1,@2,@7,@8,@9,@10,@11,@12,@13,@14,@15)";
                op_data.Execute(sqlSelect, member_nick, wanum, local_time, rep_id, 1, 1, local_time, UserName, email, telegram_nick, birth_date, full_name, def_area, main_area_id, site_id, client_u_id);

                sqlSelect = "SELECT serial FROM pb WHERE site_id=@0 AND client_u_id=@1";
                var newPbEntry = op_data.QuerySingle(sqlSelect, site_id, client_u_id);
                if (newPbEntry != null)
                {
                    pb_id = newPbEntry.serial;
                    sqlSelect = "INSERT INTO u_stats(create_ts,pb_id,is_update,wanum,is_new) VALUES(@0,@1,1,@2,1)";
                    try { op_data.Execute(sqlSelect, local_time, pb_id, wanum); } catch { }
                    sqlSelect = "SELECT serial FROM u_stats WHERE pb_id=@0 AND create_ts=@1";
                    var newUStatsEntry = op_data.QuerySingle(sqlSelect, pb_id, local_time);
                    if (newUStatsEntry != null)
                    {
                        m_id = newUStatsEntry.serial;
                        sqlSelect = "UPDATE pb SET m_id=@0 WHERE serial=@1";
                        op_data.Execute(sqlSelect, m_id, pb_id);

                    }
                    else
                    {
                        m_id = -3;
                    }
                }

            }
            else
            {
                m_id = pbEntry.m_id;
                sqlSelect = "UPDATE pb SET username=@0,client_u_id=@1,email=@2,telegram_nick=@3,birth_date=@4,full_name=@5,def_area=@6,main_area_id=@7 WHERE wanum=@8";
                op_data.Execute(sqlSelect, UserName, client_u_id, email, telegram_nick, birth_date, full_name, def_area, main_area_id, wanum);
                //if member exists in phone book need to do the link



            }

            if (m_id > 0)
            {
                DataFunctions.UpdateMemberStats(m_id);
                ClientExport.PushUserDataToClient(m_id);
            }


        }
        else
        {
            m_id = -2;
        }




        op_data.Close();
        return m_id;

    }


    public static int CreatePbEntryAndReturnMemberId(string member_name, string wanum)
    {
        DateTime local_time = AppFunctions.LocalTime();
        int u_id = WebSecurity.CurrentUserId;
        int member_id = 0;
        int pb_id = 0;
        bool is_existing = false;
        var op_data = Database.Open("op_data");
        var sqlSelect = "SELECT * FROM pb WHERE wanum=@0";
        var pbEntry = op_data.QuerySingle(sqlSelect, wanum);

        if (pbEntry == null)
        {
            sqlSelect = "INSERT INTO pb(member_name,wanum,create_ts,created_by,is_update,is_main,last_change_ts,is_new,anniversary_ts) VALUES(@0,@1,@2,@3,@4,@5,@6,1,@2)";
            op_data.Execute(sqlSelect, member_name, wanum, local_time, u_id, 1, 1, local_time);
            sqlSelect = "SELECT * FROM pb WHERE wanum=@0 AND create_ts=@1";
            var newPbEntry = op_data.QuerySingle(sqlSelect, wanum, local_time);
            if (newPbEntry != null)
            {
                pb_id = newPbEntry.serial;
                sqlSelect = "INSERT INTO u_stats(create_ts,pb_id,is_update,wanum,is_new) VALUES(@0,@1,1,@2,1)";
                try { op_data.Execute(sqlSelect, local_time, pb_id, wanum); } catch { }
                sqlSelect = "SELECT serial FROM u_stats WHERE pb_id=@0 AND create_ts=@1";
                var newUStatsEntry = op_data.QuerySingle(sqlSelect, pb_id, local_time);
                if (newUStatsEntry != null)
                {
                    member_id = newUStatsEntry.serial;
                    sqlSelect = "UPDATE pb SET m_id=@0 WHERE serial=@1";
                    op_data.Execute(sqlSelect, member_id, pb_id);
                    DataFunctions.UpdateMemberStats(member_id);
                }
            }

        }

        op_data.Close();
        return member_id;

    }



