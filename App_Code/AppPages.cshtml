                @if (msgTmp.created_by == u_id || is_user_admin)
                {
                    <span style="float: left"><button style="font-size: 12px;margin: 5px;padding: 5px;font-weight: bold;color: #fff;background-color: #57d600" onclick="sbload('SubMenu','Caller?p1=MsgEditor&p2=@msgTmp.id');" id="TemplateGoBtn_@msgTmp.id">עריכה</button></span>
                    <span style="float: left">
                        <button style="font-size: 12px;margin: 5px;padding: 5px;font-weight: bold;color: #fff;background-color: #f00" onclick="hideElement('TemplateGoBtn_@msgTmp.id');;hideElement('TemplatedelBtn_@msgTmp.id');showElement('TemplatedelApp_@msgTmp.id');" id="TemplatedelBtn_@msgTmp.id">מחיקה</button>
