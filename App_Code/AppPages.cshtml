@helper ProspectsApproval()
{

    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var m_join = Database.Open("m_join");
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;

    var sqlSelect = " SELECT * FROM prospectsapprovals ORDER BY is_completed DESC,serial";
    var webProspects = m_join.Query(sqlSelect);

    m_join.Close();

    bool completedHeaderFlag = false;
    bool unCompletedHeaderFlag = false;

    <div style="overflow: auto;padding: 5px;">

        <h2 style="float:right;direction:rtl">
            @webProspects.Count() מצטרפים שאושרו
        </h2>
    </div>



    <div style="overflow: auto;text-align:right:">
        @foreach (var prospect in webProspects)
        {

            if (prospect.is_completed && !completedHeaderFlag)
            {
                completedHeaderFlag = true;
                <div style="overflow:auto;background-color:#57d600;color:#fff">מצטרפים שבחרו כינוי</div>
            }
            if (!prospect.is_completed && !unCompletedHeaderFlag)
            {
                unCompletedHeaderFlag = true;
                <div style="overflow:auto;background-color:#808080;color:#fff">מצטרפים בהמתנה לבחירת כינוי</div>
            }

            var DaysSinceApproval = 0;
            DaysSinceApproval = AppFunctions.HowManyDaysAgoWas(prospect.create_ts);
            <div class="ListRow" style="overflow:auto;" onclick="sbload('MainSb','Caller?p1=WebProspect&p2=@prospect.serial','','ProspectsRepActions');" id="prospect_@prospect.serial">

                <div class="ListCell" style="float: right;width:20%;">
                    <div style="overflow:auto">@prospect.prospect_name </div>
                    <span style="color: #b200ff;font-size: 12px;">
                        🗓️ @prospect.create_ts.ToShortDateString() (לפני @DaysSinceApproval ימים)
                    </span>
                </div>




                <div style="overflow:auto;float:left">

                    <div class="ListCell" style="float: left">
                        @prospect.suggested_nick
                    </div>







                </div>


            </div>
        }
    </div>
    <div style="overflow: auto;height:200px;"> &nbsp; </div>

}

