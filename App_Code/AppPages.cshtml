                        </div>
                    }

                </div>
            </div>




        </div>




    }


}


@helper ContactForm(string showWhat = "NEW")
{
int u_id = WebSecurity.CurrentUserId;
string repTitle = "";
var op_data = Database.Open("op_data");
var m_join = Database.Open("m_join");
var sqlSelect = "";
string username = WebSecurity.CurrentUserName;
DateTime local_time = AppFunctions.LocalTime();
DateTime ts = local_time;
string srchTitle = "";


int newMembersCount = 0;

//DataFunctions.ImportWebContactForm();

//showWhat = "COMPLETED";
switch (showWhat)
{
    case "NEW":
        sqlSelect = "SELECT * FROM ContactForm order by ts DESC";
        srchTitle = " יצירת קשר - פניות חדשות";
        break;
    case "COMPLETED":
        sqlSelect = "SELECT * FROM completedcontactrequests order by ts DESC";
        srchTitle = " יצירת קשר - פניות שטופלו";
        break;
}



var formEntries = op_data.Query(sqlSelect);


op_data.Close();
m_join.Close();


int DefaultWelcomeMsg = 0;
try { DefaultWelcomeMsg = Convert.ToInt32(Request["DefaultMembersWelcomeMsgTemplate"]); } catch { }



<div style="overflow: auto;padding: 5px;">

        <select style="padding:5px;margin:5px;font-size:16px"  onchange="PageNavigator('CONTACTFORM',this.value)">
            <option value="NEW" @if (showWhat == "NEW") { <text>selected</text>} >פניות חדשות</option>
            <option value="COMPLETED" @if (showWhat == "COMPLETED") { <text>selected</text>} >פניות שטופלו</option>
        </select>

        <h2 style="float:right;direction:rtl">
            @srchTitle
        </h2>
    </div>



    <div style="overflow: auto;">
        @foreach (var entry in formEntries)
        {
            string member_name = entry.nick_name;
            string provided_wanum = entry.wanum;
            string member_wanum = provided_wanum;
            bool cus_refresh = entry.cus_refresh;
            int m_id = 0;
            int pb_id = 0;
            string reachout_type = "NONMEMBERCONTACT";
            int contact_entry_id = entry.serial;


            DateTime create_ts = entry.ts;
            int DaysSinceContactInt = 0;
            sqlSelect = "SELECT member_name,wanum,create_ts,m_id,serial FROM pb WHERE wanum=@0";
            var pbEntry = op_data.QuerySingle(sqlSelect, provided_wanum);
            if (pbEntry != null)
            {
                member_name = pbEntry.member_name;
                member_wanum = pbEntry.wanum;
                m_id = pbEntry.m_id;
                pb_id = pbEntry.serial;
                reachout_type = "MEMBERCONTACT";
            }

            DaysSinceContactInt = AppFunctions.HowManyDaysAgoWas(create_ts);



            string recognition_icon = "❌";

            if (m_id > 0)
            {
                recognition_icon = "✅";
            }


            <div class="ListRow" style="overflow:auto;" id="entry_@entry.serial" onclick="sbload('MainSb', 'Caller?p1=CONTACTRESPONSE', '','repForm_@entry.serial');">

                <div class="ListCell" style="float: right;width:30px;">
                    @recognition_icon
                </div>



                @if (m_id > 0)
                {
                    <div class="ListCell" style="float: right;width:20%;">
                        <div style="overflow:auto;color:#000">
                            <b>@member_name</b>
                            @if (entry.nick_name != "" && entry.nick_name != member_name)
                            {<span style="color: #808080;font-size: 12px;">(@entry.nick_name)</span>}
                        </div>
                        <div style="color: #b200ff; font-size: 12px; overflow: auto">
                            🗓️ @create_ts.ToShortDateString() @create_ts.ToString("HH:mm") (לפני @DaysSinceContactInt ימים)
                        </div>
                        <div style="color: #808080; font-size: 11px; overflow: auto">
                            יצירת קשר #@entry.serial
