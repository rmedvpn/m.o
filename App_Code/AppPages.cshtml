@helper OrdersMain(string ShowWhat = "30")
{
    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";

    DateTime local_time = AppFunctions.LocalTime();

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT COUNT(serial) AS the_cnt FROM dbo.O_history";
    var rs = db.QuerySingle(sqlSelect);
    int recCount = 0;
    if (rs != null)
    {
        recCount = rs.the_cnt;
    }
    sqlSelect = "SELECT COUNT(serial) AS the_cnt FROM UploadedOrders WHERE is_sync=0";
    rs = db.QuerySingle(sqlSelect);
    int unSyncedCount = 0;
    if (rs != null)
    {
        unSyncedCount = rs.the_cnt;
    }
    DateTime start_date = Convert.ToDateTime("1/1/1900");
    DateTime end_date = local_time;
    DateTime curr_date = Convert.ToDateTime("1/1/1900");

    sqlSelect = "SELECT * FROM dbo.O_history WHERE ts>=@0 AND ts<=@1 ORDER BY ts DESC";

    switch (ShowWhat)
    {
        case "30":
            start_date = local_time.AddDays(-30);
            break;
        case "60":
            start_date = local_time.AddDays(-60);
            break;
        case "90":
            start_date = local_time.AddDays(-90);
            break;
        case "-1":
            start_date = local_time.AddDays(-90);
            break;
    }
    curr_date = end_date;
    var orders = db.Query(sqlSelect, start_date, end_date);
    // sql=SELECT * FROM d_host.orders WHERE ts>=@start_date AND ts<=@end_date ORDER BY ts DESC
    <div style="overflow: auto;padding: 5px;">

        <div style="overflow: auto;padding: 5px;">
            <div style="float:left">
