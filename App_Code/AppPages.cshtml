@helper WebProspects(string showWhat = "NEW")
{
    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var m_join = Database.Open("m_join");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;
    string srchTitle = "";

    //DataFunctions.ImportWebProspects();

    if (showWhat == "") { showWhat = "NEW"; }

    switch (showWhat)
    {
        case "NEW":
            sqlSelect = "SELECT * FROM webprospects WHERE status_code=0 ORDER BY ts desc";
            srchTitle = " מצטרפים חדשים";
            break;
        case "NICKWAIT":
            sqlSelect = "SELECT * FROM webprospects WHERE status_code=1 OR status_code=2 ORDER BY last_reachout_ts ";
            srchTitle = " מצטרפים בהמתנה לבחירת כינוי";
            break;
        case "AFTERNICK":
            sqlSelect = "SELECT * FROM webprospects WHERE status_code=3 ORDER BY ts desc";
            srchTitle = " מצטרפים בהמתנה לרישום";
            break;
        case "DENIED":
            sqlSelect = "SELECT * FROM webprospects WHERE status_code=5 OR status_code=7 ORDER BY status_code,ts desc";
            srchTitle = " בקשות שנדחו";
            break;
        default:
            sqlSelect = "SELECT * FROM webprospects WHERE status_code=0 ORDER BY ts desc";
            srchTitle = " מצטרפים חדשים";
            showWhat = "NEW";
            break;
    }

    var webProspects = op_data.Query(sqlSelect);

    srchTitle = webProspects.Count() + " " + srchTitle;

    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects";
    var pendingWebProspects = m_join.QuerySingle(sqlSelect);
    int prospectCnt = 0; prospectCnt = webProspects.Count();
    int pendingProspectCnt = 0; pendingProspectCnt = pendingWebProspects.the_cnt;

    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE is_approved=1";
    var ApprovedWebProspects = op_data.QuerySingle(sqlSelect);
    int approvedProspectCnt = 0; approvedProspectCnt = ApprovedWebProspects.the_cnt;

    sqlSelect = "SELECT count(*) as the_cnt FROM prospectsapprovals";
    var prospectsapprovals = m_join.QuerySingle(sqlSelect);
    int prospectsapprovalsCnt = 0; prospectsapprovalsCnt = prospectsapprovals.the_cnt;

    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=0";
    var NewWebProspects = op_data.QuerySingle(sqlSelect);
    int NewWebProspectCnt = 0; NewWebProspectCnt = NewWebProspects.the_cnt;

    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=1";
    var NoMsgApprovedWebProspects = op_data.QuerySingle(sqlSelect);
    int NoMsgApprovedProspectCnt = 0; NoMsgApprovedProspectCnt = NoMsgApprovedWebProspects.the_cnt;
    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=2";
    var AfterMsgApprovedWebProspects = op_data.QuerySingle(sqlSelect);
    int AfterMsgApprovedWebProspectsCnt = 0; AfterMsgApprovedWebProspectsCnt = AfterMsgApprovedWebProspects.the_cnt;

    int TotalApprovedProspects = NoMsgApprovedProspectCnt + AfterMsgApprovedWebProspectsCnt;

    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=3";
    var AfterNickWebProspects = op_data.QuerySingle(sqlSelect);
    int AfterNickWebProspectsCnt = 0; AfterNickWebProspectsCnt = AfterNickWebProspects.the_cnt;
    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=5";
    var NeedReviewWebProspects = op_data.QuerySingle(sqlSelect);
    int NeedReviewWebProspectsCnt = 0; NeedReviewWebProspectsCnt = NeedReviewWebProspects.the_cnt;
    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=7";
    var DeniedWebProspects = op_data.QuerySingle(sqlSelect);
    int DeniedWebProspectsCnt = 0; DeniedWebProspectsCnt = DeniedWebProspects.the_cnt;

    int TotalDeniedProspects = DeniedWebProspectsCnt + NeedReviewWebProspectsCnt;


    sqlSelect = "SELECT count(*) as the_cnt FROM webprospects WHERE status_code=9";
    var AfterRegisterWebProspects = op_data.QuerySingle(sqlSelect);
    int AfterRegisterWebProspectsCnt = 0; AfterRegisterWebProspectsCnt = AfterRegisterWebProspects.the_cnt;



    op_data.Close();
    m_join.Close();

    int DefaultWelcomeMsg = 0;
    try { DefaultWelcomeMsg = Convert.ToInt32(Request["DefaultMembersWelcomeMsgTemplate"]); } catch { }

    <div style="overflow: auto; padding: 5px;; direction: rtl">
        <button type="button" onclick="AjaxActions('tmpAction');"  style="">בצע</button>
        <h2 style="float:right">
            @srchTitle
        </h2>
        <div style="float:left;padding:5px;margin-left:30px;">
            @if (NewWebProspectCnt > 0)
            {<button style="border: 2px solid #000; background-color: white; color: black; border-radius: 5px; padding: 5px; float: right; margin-right: 10px;" onclick="PageNavigator('WEBPROSPECTS','NEW');">@NewWebProspectCnt חדשים</button>}
            @if (AfterNickWebProspectsCnt > 0)
            {<button style="border: 2px solid #000; background-color: white; color: black; border-radius: 5px; padding: 5px; float: right; margin-right: 10px;" onclick="PageNavigator('WEBPROSPECTS','AFTERNICK');">@AfterNickWebProspectsCnt בהמתנה לסיום הרשמה</button>}
            @if (TotalApprovedProspects > 0)
            {<button style="border: 2px solid #000; background-color: white; color: black; border-radius: 5px; padding: 5px; float: right; margin-right: 10px;" onclick="PageNavigator('WEBPROSPECTS','NICKWAIT');">@TotalApprovedProspects בהמתנה לבחירת כינוי</button>}
            @if (AfterRegisterWebProspectsCnt > 0)
            {<button style="border: 2px solid #000; background-color: white; color: black; border-radius: 5px; padding: 5px; float: right; margin-right: 10px;display:none" onclick="PageNavigator('WEBPROSPECTS','NEW');">@AfterRegisterWebProspectsCnt רשומים בהמתנה לסיום</button>}
            @if (TotalDeniedProspects > 0)
            {<button style="border: 2px solid #f00; background-color: white; color: #f00; border-radius: 5px; padding: 5px; float: right; margin-right: 20px;" onclick="PageNavigator('WEBPROSPECTS','DENIED');">@TotalDeniedProspects בקשות שנדחו</button>}

            <button style="border: 2px solid #57d600; background-color: #57d600; color: #fff; border-radius: 5px; padding: 5px; float: right; margin-right: 20px;" onclick="Accordionize('btnAddMemberAcc');">➕ צירוף מהיר</button>







        </div>

    </div>

    <button class="Accordion" id="btnAddMemberAcc" style="display:none"></button>
    <div class="panel">
        <div style="overflow: auto; padding: 5px; direction: rtl;border-bottom:1px dotted #808080;border-radius:5px;">
            <div style="overflow: auto; padding: 5px;color:#000">
                <b>הוספה מהירה למערכת</b>
            </div>
            <form id="QuickAddMember">
                <div style="float: right;text-align:right">
                    <div style="overflow:auto">
                        <div style="float:right">
                            <input type="text" style="padding:5px;margin:5px;font-size:16px;width:100px" name="selectedNick" id="selectedNick" placeholder="כינוי" />
                        </div>
                        <div style="float:right">
                            <input type="text" style="padding:5px;margin:5px;font-size:16px;width:100px" name="NumberToRegister" id="NumberToRegister" placeholder="מספר ווטסאפ" />
                        </div>
                    </div>
                    <div style="overflow:auto">
                        <div style="float:right">
                            <input type="checkbox" style="padding:5px;margin:5px;font-size:16px;" name="is_welcome_msg" id="is_welcome_msg" checked /> לשלוח הודעת ברוכים הבאים?
                        </div>
                    </div>
                    <div style="overflow: auto;">
                        <textarea style="padding:5px;margin:5px;font-size:16px;resize:none" name="contact_notes" id="contact_notes" placeholder="הערות פתיחה ללקוח?"></textarea>
                    </div>
                </div>
                <div style="overflow:auto">
                    <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="AjaxActions('RegisterNewMember', '', '', 'QuickAddMember','','QuickAdd');">הוספה</button>
                </div>
                <div style="float: right; display: none; color: red" id="QuickAddErrMsg">

                </div>

            </form>
        </div>
    </div>


    <div style="overflow: auto;">
        @foreach (var prospect in webProspects)
        {
            var is_exists = false;
            int member_id = 0;
            bool is_nick_selected = false;
            string member_name = "";
            string wanumized = AppFunctions.wanumize(prospect.wanum);
            sqlSelect = "SELECT serial,m_id,member_name FROM pb WHERE wanum=@0";
            var dupChk = op_data.QuerySingle(sqlSelect, wanumized);
            if (dupChk != null)
            {
                is_exists = true;
                member_id = dupChk.serial;
                member_name = dupChk.member_name;
            }

            string ref_source = prospect.ref_source;
            string ref_source_desc = prospect.ref_source_desc;
            int status_code = prospect.status_code;
            var DaysSinceJoinInt = 0;
            bool is_approved_prospect = prospect.is_approved;
            DateTime approval_ts = Convert.ToDateTime("1/1/1900"); try { approval_ts = prospect.approval_ts; } catch { }

            sqlSelect = "SELECT * FROM prospectsApprovals WHERE prospect_id=@0 AND is_completed=1";
            var nickSelectChk = m_join.QuerySingle(sqlSelect, prospect.serial);
            if (nickSelectChk != null)
            {
                is_nick_selected = true;
                status_code = 3;

            }

            DaysSinceJoinInt = AppFunctions.HowManyDaysAgoWas(prospect.ts);
            <div class="ListRow" style="overflow:auto;" id="prospect_@prospect.serial">

                <div class="ListCell" style="float: right;width:20%;" onclick="sbload('MainSb','Caller?p1=WebProspect&p2=@prospect.serial','','ProspectsRepActions');">
                    <div style="overflow:auto">@prospect.prospect_name </div>
                    <span style="color: #b200ff;font-size: 12px;">
                        🏙️ @prospect.city<br />
                        🗓️ @prospect.ts.ToShortDateString() (לפני @DaysSinceJoinInt ימים)
                    </span>

                </div>



                @if (is_exists)
                {
                    <div class="ListCell" style="float: right;width:20%;">
                        <div style="padding:5px;margin:5px;color:#000;overflow:auto">
                            ⚠️ רשום.ה במערכת כ<b>@member_name</b>
                        </div>

                    </div>
                    <div style="overflow: auto; float: left; ">
                        <form id="repForm_@prospect.serial">
                            <div style="overflow:auto">
                                <select style="padding:5px;margin:5px;float:left;font-size:16px;display:none" name="reachout_type34" id="reachout_type34" onchange="if (this.value == 'ARCHIVEPROSPECT') { alert('adfadsf'); } else {sbload('MainSb', 'Caller?p1=CONTACTRESPONSE', '','repForm_@prospect.serial'); }">
                                    <option value="">בחירת פעולה..</option>
                                    <option value="ARCHIVEPROSPECT">סגירת בקשת הצטרפות</option>
                                    <option value="MEMBERWELCOME">שליחת הודעת ברוכים הבאים</option>
                                    <option value="REFRESHMSG">שליחת הודעת רענון</option>

                                </select>
                                <button type="button" style="padding:5px;margin:5px;float:left;" onclick="sbload('MainSb', 'Caller?p1=CONTACTRESPONSE', '','repForm_@prospect.serial');">שליחת הודעה</button>

                            </div>

                            <input type="hidden" name="reachout_type" id="reachout_type" value="REFRESHMSG">
                            <input type="hidden" name="prospect_id" id="prospect_id" value="@prospect.serial">
                            <input type="hidden" name="m_id" id="m_id" value="@member_id">
                            <input type="hidden" name="provided_wanum" id="provided_wanum" value="@prospect.wanum">

                        </form>
                    </div>
                }

                else
                {
                    <div style="overflow:auto;float:left">

                        @switch (status_code)
                        {

                            case 0:
                                <div style=" padding: 5px; margin: 5px;  overflow: auto;  ">
                                    <button type="button" style="font-size:16px; padding: 5px;margin:5px;" onclick="sbload('MainSb','Caller?p1=WebProspectVerification&p2=@prospect.serial','','ProspectsRepActions');">אימות</button>
                                </div>

                                break;

                            case 1:
                            case 2:





                                <div style="background-color: #808080; padding: 5px; margin: 5px; color: #fff; overflow: auto;  ">
                                    <button type="button" style="padding:5px;margin:5px;float:left" onclick="sbload('MainSb', 'Caller?p1=CONTACTRESPONSE&reachout_type=PROSPECTMSG&member_id=@prospect.serial');">שליחת הודעה</button>

                                    <span>מצטרף.ת מאומת.ת<br /><span style="font-size:12px;color:#e3e3e3">בהמתנה לבחירת כינוי</span></span>
                                    <br />
                                    @if (status_code == 2)
                                    {
                                        DateTime last_reachout_ts = local_time;
                                        try { last_reachout_ts = prospect.last_reachout_ts; } catch { }
                                        if (last_reachout_ts != local_time)
                                        {
                                            int DaysSinceLastReachout = AppFunctions.HowManyDaysAgoWas(last_reachout_ts);

                                            <span style="font-size:12px;color:#e3e3e3">הודעה אחרונה נשלחה לפני <span>@DaysSinceLastReachout</span> ימים ע"י @AppFunctions.GetRepName(prospect.last_reachout_by)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="font-size:12px;color:yellow">לא נשלחה הודעה!</span>
                                    }


                                    @if (prospect.reachout_attempts > 1)
                                    {
                                        <br /><span style="font-size:12px;color:#000;background-color:yellow">נעשו עד כה @prospect.reachout_attempts ניסיונות ליצירת קשר</span>
                                    }


                                </div>

                                break;

                            case 3:

                                if (is_exists)
                                {
