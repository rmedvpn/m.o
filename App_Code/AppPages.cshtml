                </div>




            </div>



        </div>
    }


}

@helper msgTemplates()
{


    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";

    var db = Database.Open("op_data");
    var sqlSelect = "";
    bool is_user_admin = AppFunctions.isPermission(u_id, "is_admin");
