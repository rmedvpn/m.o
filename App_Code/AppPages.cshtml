                    @recCount הזמנות במערכת<br />
                    @recCount נוספו בסנכרון אחרון    <br />
                    סנכרון אחרון בתאריך 1.1.2021 <br />
                    גיבוי אחרון בתאריך 1.1.2021
                    <span id="SyncNotifier">
                        <br />
                        סונכרנו X רשומות מתוך Y
                    </span>
                </p>
            </div>

            <h2>מאגר הזמנות @ShowWhat ימים @orders.Count() רשומות</h2>
            <div style="overflow:auto;padding:5px;margin:5px">
                <div style="overflow:auto;padding:5px;margin:5px;float:right;background-color:#000;color:#fff" onclick="sbload('SubMenu','Caller?p1=OrdersSync&p2=30');">
                    סנכרון
                </div>
                <div style="overflow:auto;padding:5px;margin:5px;float:right;background-color:#e3e3e3" onclick="sbload('MainSb','Caller?p1=OrdersMain&p2=30');">
                    30 יום
                </div>
                <div style="overflow:auto;padding:5px;margin:5px;float:right;background-color:#e3e3e3" onclick="sbload('MainSb','Caller?p1=OrdersMain&p2=60');">
                    60 יום
                </div>
                <div style="overflow:auto;padding:5px;margin:5px;float:right;background-color:#e3e3e3" onclick="sbload('MainSb', 'Caller?p1=OrdersMain&p2=90'); ">
                    90 יום
                </div>
                <div style="overflow:auto;padding:5px;margin:5px;float:right;background-color:#e3e3e3" onclick="sbload('MainSb','Caller?p1=OrdersMain');">
                    תאריך אחר
                </div>
            </div>
        </div>
        <button class="Accordion" id="OrdersSync" style="display: none"></button>
        <div class="panel">
            יש @unSyncedCount רשומות שהועלו ולא סונכרנו<br />
            <button type="button" style="padding:5px;margin:5px;" id="btnSync" onclick="showElement('SyncLoader');hideElement('btnSync');AjaxActions('SyncUploadedOrders');">סנכרון</button>

            <div style="overflow: auto;opacity: 0.7;height: 100%;background-color: #fff;width: 100%;display: none;float:left" id="SyncLoader">
                <div class="spinner" style="text-align: center;font-size: 30px;">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>
            </div>


        </div>

        <table style="overflow:auto;width:2500px;" dir="rtl">

            @do
            {
                int daily_orders = 0;
                int rowHeight = 0;
                string rowHeightStr = "";
                sqlSelect = "SELECT COUNT(serial) as the_cnt FROM dbo.O_history WHERE CAST(ts AS date)=CAST(@0 AS date)";
                var todaysOrders = db.QuerySingle(sqlSelect, curr_date);
                try { daily_orders = todaysOrders.the_cnt; } catch { }
                rowHeight = daily_orders * 2;
                rowHeightStr = rowHeight.ToString() + "px";
                if (daily_orders > 0)
                {
                    <tr>
                        <td style="width:100px"> @curr_date.ToShortDateString()</td>
                        <td>
                            <div style="width:@rowHeightStr;background-color:#b200ff;font-size:18px;padding:3px;">
                                <b>   @daily_orders</b>

                            </div>
                        </td>

                    </tr>


                }
                curr_date = curr_date.AddDays(-1);
            }
            while (curr_date >= start_date);
            <tr><td colspan="2"><div style="overflow:auto;height:50px;">&nbsp;</div></td></tr>
        </table>
    </div>
    db.Close();
}

