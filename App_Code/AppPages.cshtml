                            <select style="padding: 5px;margin: 5px;font-size: 16px" name="logRepId" id="logRepId">
                                <option value="">כולם</option>
                                @foreach (var rep in Reps)
                                {
                                    string tmpMember = "";
                                    tmpMember = AppFunctions.GetRepName(rep.clerk_id);
                                    if (tmpMember != "")
                                    {
                                        <option value="@rep.clerk_id">@AppFunctions.GetRepName(rep.clerk_id)</option>

                                    }

                                }

                            </select>
                        </span>
                        <span style="float: right;font-size: 12px;color: #b200ff">
                            <br>
                            <button type="button" style="float: right;font-size: 16px;padding: 5px;margin: 5px;border: 0" onclick="sbload('JoinAdmin','Caller?p1=SysLog&p2=' + document.getElementById('logName').value + '&p3=' +  document.getElementById('logRepId').value);">בצע</button>
                        </span>

                        <span style="float: left;font-size: 12px;color: #b200ff" id="btnDelete">
                            <br>
                            <button type="button" style="float: left;font-size: 16px;padding: 5px;margin: 5px;border: 0" onclick="hideElement('btnDelete');showElement('verifyDelete');setTimeout(function(){showElement('btnDelete');hideElement('verifyDelete'); }, 3000);">ניקוי</button>
                        </span>
                        <span style="float: left;font-size: 12px;color: #b200ff;display: none" id="verifyDelete">
                            <br>
                            <input type="checkbox" style="font-size: 16px;padding: 5px;margin: 5px;" onclick="AjaxActions('KillLog');">אישור
                        </span>
                    </div>

                </form>
            </div>

        </div>

    </div>
    <div style="overflow: auto;padding: 5px;margin: 5px">
        @foreach (var logEntry in theLog)
        {
            <div style="overflow: auto;font-size: 14px;border-bottom: 1px dotted #e3e3e3">
                <div style="overflow: auto;margin: 2px;">
                    <span>@logEntry.entry</span>
                </div>
                <span style="float: right;padding: 2px;margin: 2px;font-size: 11px;color: #808080">@logEntry.timestamp.ToShortDateString() @logEntry.timestamp.ToString("HH:mm")</span>
                <span style="float: left;font-size: 12px;">@AppFunctions.GetRepName(logEntry.clerk_id)</span>
                <span style="float: right;display: none">@logEntry.LogName</span>
            </div>
        }
    </div>

}

@helper PhoneBook(string ShowWhat = "30")
