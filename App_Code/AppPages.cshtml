                    <div class="panel">
                        <div style="overflow: auto;max-height: 400px;">
                            <div>
                                הזמנה ראשונה:  @memberRs.first_order_ts<br>
                                הזמנה אחרונה:  @memberRs.last_order_ts<br>
                            </div>
                            <h2>היסטורית הזמנות</h2>
                            @foreach (var order in userOrders)
