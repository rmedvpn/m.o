@helper prospectUnVerfied(string sortDir = "DESC")
{
    if (!WebSecurity.IsAuthenticated) { Response.Redirect("~/"); }


    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";
    var db = Database.Open("op_data");
    var sqlSelect = "";

    if (sortDir == "ASC")
    {
        sqlSelect = "select serial,reachout_attempts,ts,prospect_name,city from prospects WHERE (SELECT top(1) wanum FROM pb WHERE wanum=prospects.wanum) is null AND (SELECT top(1) wanum FROM u_Stats WHERE wanum=prospects.wanum) is null AND is_deleted=0 order by reachout_attempts, ts";
    }
    else
    {
        sqlSelect = "select serial,reachout_attempts,ts,prospect_name,city from prospects WHERE (SELECT top(1) wanum FROM pb WHERE wanum=prospects.wanum) is null AND (SELECT top(1) wanum FROM u_Stats WHERE wanum=prospects.wanum) is null AND is_deleted=0 order by reachout_attempts, ts DESC";
    }

    //   order by ts desc
    //sqlSelect = "select * from prospects WHERE (SELECT wanum FROM u_Stats WHERE wanum=prospects.wanum) is null AND is_deleted=0 order by next_reachout_ts,ts DESC";

    var prospects = db.Query(sqlSelect);
    //decimal avgDaysBetweenOrders=0;
    sqlSelect = "select distinct city from prospects order by city";
    var prospectsCities = db.Query(sqlSelect);
    <div style="overflow: auto;padding: 5px;">
        @prospects.Count() רשומות של חברים לא רשומים

        <select style="float: left;padding: 5px;font-size: 16px;" id="sortDir" name="sortDir" onchange="sbload('MainSb','Caller?p1=prospectUnVerfied&p2=' + this.value);">
            <option value="ASC" @if (sortDir == "ASC") { <text> selected</text>}>מהישן לחדש</option>
            <option value="DESC" @if (sortDir == "DESC") { <text> selected</text>}>מהחדש לישן</option>
        </select>
    </div>






    <div style="overflow: auto;background-color: #fff;" id="ProspectsDataDiv">
        @foreach (var prospect in prospects)
        {
            TimeSpan DaysSinceJoin = DateTime.Now - prospect.ts;
            var DaysSinceJoinInt = DaysSinceJoin.Days;
            string bgColor = "#e3e3e3";
            if (prospect.reachout_attempts > 0)
            {
                bgColor = "#ffffcc";
            }
            <div style="overflow: auto;padding: 5px;margin: 5px;background-color: @bgColor;" onclick="sbload('SubMenu','Caller?p1=prospect&p2=@prospect.serial');" id="prospect_@prospect.serial">
                <span style="float: right">
                    @prospect.prospect_name | @prospect.city<br><span style="color: #b200ff;font-size: 12px;">@prospect.ts.ToShortDateString() </span>
                </span>
                <span style="float: left">
                    <span style="color: #b200ff;font-size: 12px;">@prospect.reachout_attempts ניסיונות</span><BR>לפני @DaysSinceJoinInt ימים
                </span>


            </div>
        }
    </div>
    db.Close();


}


@helper Prospect(int member_id = 0, int template_id = 0, bool is_birthday = false)
{

    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    var op_data = Database.Open("op_data");
    var sqlSelect = "";

    string birthday = ""; if (is_birthday) { birthday = "on"; }

    DateTime LocalTime = AppFunctions.LocalTime();


    sqlSelect = "select * from prospects WHERE serial=@0";
    var memberRs = op_data.QuerySingle(sqlSelect, member_id);


    string wanum = "";
    if (memberRs != null)
    {

        wanum = memberRs.wanum;
        var DaysSinceJoinInt = 0;
        string JoinPhoneNumber = AppFunctions.GetAppProperty("JoinPhoneNumber");
        int MaxProspectsReachoutAttempts = Convert.ToInt32(AppFunctions.GetAppProperty("MaxProspectsReachoutAttempts"));

        DateTime tss = LocalTime;
        TimeSpan DaysSinceLastReachout = tss - memberRs.last_reachout_ts;
        DaysSinceJoinInt = DaysSinceLastReachout.Days;

        <div style="overflow: auto;font-weight: bold;font-size: 30px;padding: 5px;">
            <button style="float: right;font-size: 16px;padding: 5px;margin: 5px;font-weight: bold;color: #57d600;background-color: #fff;border: 2px solid #57d600" onclick="EnableControlButton(); ControlButton();">🔙</button>

            @memberRs.prospect_name


        </div>
        <div style="overflow: auto;-webkit-overflow-scrolling: touch;width: 100%;height: 100%;">

            <div style="overflow: auto;">

                <div style="overflow: auto;">
                    <h2>בקשת הצטרפות #@memberRs.serial</h2>
                </div>
                <div style="overflow: auto;">
                    <div style="overflow: auto;">
                        @if (memberRs.email != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">email<br></span><a href="mailto:@memberRs.email" target=" _blank">@memberRs.email</a></span>
                            </div>
                        }

                        @if (memberRs.fb != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;color: #b200ff">fb<br></span><a href="@memberRs.fb" target=" _blank">@memberRs.fb</a></span>
                            </div>
                        }

                        @if (memberRs.ref_txt != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">מקור פניה<br></span>@memberRs.ref_txt</span>
                            </div>
                        }

                        @if (memberRs.occupation != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">עיסוק<br></span>@memberRs.occupation</span>
                            </div>
                        }

                        @if (memberRs.more_info != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">מידע נוסף<br></span>@memberRs.more_info</span>
                            </div>
                        }

                        @if (memberRs.join_reason != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">סיבת הצטרפות<br></span>@memberRs.join_reason</span>
                            </div>
                        }
                        @if (memberRs.involvement != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">מעורבות<br></span>@memberRs.involvement</span>
                            </div>
                        }
                        @if (memberRs.notes != "")
                        {
                            <div style="overflow: auto">
                                <span style="padding: 3px;margin: 3px;font-size: 14px;float: right;"><span style="font-size: 11px;;color: #b200ff">הערות<br></span>@memberRs.notes</span>
                            </div>
                        }
                    </div>

                </div>
            </div>


            <div style="overflow: auto;margin: 5px;padding: 5px;color: #000;font-size: 16px;background-color: #fff;text-align: center">

                <div style="overflow: auto;background-color: #ffffcc" id="MsgTemplatesDiv">
                    @AppHelpers.LoadProspectTemplate(memberRs.serial, template_id)
                </div>
                <button style="font-size: 16px;text-align: center;color: #fff;background-color: #57d600;border:2px solid #57d600;padding: 5px;margin: 5px;width: 90%;font-weight: bold" onclick="copyTextAreaToClipBoard('tb_cb');window.location.href='https://api.whatsapp.com/send?phone=@wanum';showElement('MsgSentBtn');">שליחת הודעה ל<span>@memberRs.prospect_name</span></button>

                <div style="overflow: auto;font-size: 18px;" onclick="toggle_visibility('entry_@memberRs.serial')">


                    <div style="overflow: auto;display: none" id="entry_@memberRs.serial">
                        <span style="padding: 3px;margin: 3px;float: right;"><span style="font-size: 14px;">#<br></span>@memberRs.serial</span>
                        <span style="padding: 3px;margin: 3px;float: right;"><span style="font-size: 14px;">שעה<br></span>@memberRs.ts.ToShortDateString()</span>
                        <span style="padding: 3px;margin: 3px;float: right;"><span style="font-size: 14px;">משתמש<br></span>@memberRs.prospect_name</span>
                        <span style="padding: 3px;margin: 3px;float: right;"><span style="font-size: 14px;">עיר<br></span>@memberRs.city</span>
                        <span style="padding: 3px;margin: 3px;float: right;"><span style="font-size: 14px;">ת.לידה<br></span>@memberRs.birth_date</span>
                        <span style="padding: 3px;margin: 3px;float: right;">
                            <span style="font-size: 14px;">מין<br></span>
                            @if (memberRs.gender == 1)
                            {
                                <span>זכר</span>
                            }@if (memberRs.gender == 2)
                            {
                                <span>נקבה</span>
                            }
                        </span>
                    </div>

                </div>




            </div>

            <div style="overflow: auto;text-align: right;padding: 5px;margin: 5px;">
                <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;border: 2px dotted #57d600">
                    <input type="checkbox" style="height: 25px;width: 25px;" id="is_vip" onclick="AjaxActions('MarkProspect',@memberRs.serial,1,this.checked);"> סימון בכוכב
                    <br><span style="font-size: 14px;color: #b200ff">@memberRs.prospect_name עשוי/ה לסייע לארגון</span>
                </div>

                <button id="MsgSentBtn" style="font-size: 16px;text-align: center;color: #fff;background-color: #b200ff;border:2px solid #b200ff;padding: 5px;margin: 5px;width: 90%;font-weight: bold;display: none" onclick="AjaxActions('PROSPECTMSGSENT',@memberRs.serial,1,'@birthday');">הודעת צירוף נשלחה ל<span>@memberRs.prospect_name</span></button>

                <div style="overflow: auto;text-align: center">


                    <select style="font-size: 16px;padding: 5px;margin: 5px;width: 100%;background-color: #57d600;color: #fff;font-weight: bold;border: 0" id="action_id" onchange="if(this.value!=''){AjaxActions(this.value,@memberRs.serial,1,'@birthday');}">
                        <option value=""> בבקשה לבחור פעולה</option>
                        <option value="CANCELPROSPECTACTION"> ביטול וחזרה לרשימה</option>
                        <option value="PROSPECTMSGSENT"> הודעת צירוף נשלחה</option>
                        <option value="PROSPECTBADCONTACT"> סגירה - פרטי קשר שגויים</option>
                        <option value="PROSPECTDUPLICATE"> סגירה - המידע קיים כבר</option>
                        <option value="PROSPECTNOTINERESTED"> סגירה - לא מעוניינ/ת</option>
                        <option value="PROSPECTNOWANUM"> סגירה - רשומה ללא ווטסאפ</option>
                        <option value="PROSPECTUNAPPROVED"> סגירה - החבר לא עבר אימות בהצלחה</option>
                    </select>
                </div>


                <div style="overflow: auto;font-size: 18px;color: #b200ff;text-align: right;background-color: #ffffcc">הודעה אחרונה: @memberRs.last_reachout_ts (לפני @DaysSinceJoinInt  ימים)</div>

            </div>

            <div style="overflow: auto;height: 200px;">&nbsp;</div>
        </div>
    }



    op_data.Close();
}

@helper UsersAdmin()
{
    if (!WebSecurity.IsAuthenticated) { Response.Redirect("~/"); }


    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT is_admin FROM members WHERE userId=@0"; ;
    var currentUser = db.QuerySingle(sqlSelect, u_id);
    if (currentUser != null)
    {
        if (!currentUser.is_admin)
        {
            Response.Redirect("~/Main");
        }
    }


    sqlSelect = "SELECT * FROM members order by userId";
    var AllUsers = db.Query(sqlSelect);




    <div style="overflow: auto;padding: 5px;">
        @AllUsers.Count() משתמשים
        <button style="float: left;background-color: #fff;color: #808080;border: 2px solid #808080;padding: 5px;margin: 5px;font-size: 16px;" onclick="Accordionize('AddUserAcc')">חדש</button>
    </div>
    <div style="overflow: auto;">
        <button class="accordion" id="AddUserAcc" style="display: none"></button>
        <div class="panel">
            <div style="overflow: auto;padding: 5px;border: 1px dotted #b200ff">
                <div style="overflow: auto;float: right;">
                    <input type="text" id="user_nick" name="user_nick" placeholder="שם משתמש" style="font-size: 16px;margin: 5px;padding: 5px;">
                    <button style="padding: 5px;margin: 5px;font-size: 12px;" onclick="AjaxActions('ADDUSER',document.getElementById('user_nick').value,1);">שמירה</button>
                </div>


            </div>
        </div>
    </div>
    <div style="overflow: auto;" id="ProspectsDataDiv">
        @foreach (var user in AllUsers)
        {
            <div style="overflow: auto;padding: 5px;margin: 5px;background-color: #e3e3e3;" id="prospect_@user.userId">
                <div style="overflow: auto" onclick="Accordionize('UserSettingsAcc_@user.userId');">
                    <button style="font-size: 12px;margin: 5px;float: left;display: none" onclick="AjaxActions('RESETPW',@user.userId,1);">איפוס סיסמא</button>
                    <span style="font-size: 16px;font-weight: bold;">
                        <input type="checkbox" style="padding: 5px;margin: 5px;" @if (user.is_active) { <text> checked</text>} onclick="AjaxActions('TOGGLEUSERPERMISSION',@user.userId,'',this.checked,'is_active');"> @user.username @if (user.is_admin)
                        {<span style="color: #b200ff">מנהל</span>}
                    </span>
                </div>
                <button class="accordion" id="UserSettingsAcc_@user.userId" style="display: none"></button>
                <div class="panel">
                    <div style="overflow: auto;">
                        <div style="overflow: auto;float: right;">
                            <span style="float: right;">
                                <input type="checkbox" style="padding: 5px;margin: 5px;" @if (user.is_admin) { <text> checked</text>} onclick="AjaxActions('TOGGLEUSERPERMISSION',@user.userId,'',this.checked,'is_admin');">
                                ניהול
                            </span>
                            <span style="float: right;">
                                <input type="checkbox" style="padding: 5px;margin: 5px;" @if (user.is_preserving) { <text> checked</text>} onclick="AjaxActions('TOGGLEUSERPERMISSION',@user.userId,'',this.checked,'is_preserving');">
                                שימור
                            </span>
                            <span style="float: right;">
                                <input type="checkbox" style="padding: 5px;margin: 5px;" @if (user.is_blaster) { <text> checked</text>} onclick="AjaxActions('TOGGLEUSERPERMISSION',@user.userId,'',this.checked,'is_blaster');">
                                בלסטר
                            </span>
                        </div>
                        <button style="font-size: 12px;margin: 5px;float: left;" onclick="AjaxActions('RESETPW',@user.userId,1);">סיסמא</button>
                        <button style="font-size: 12px;margin: 5px;float: left;" onclick="AjaxActions('DELUSER',@user.userId,1);">מחיקה</button>

                    </div>
                </div>


            </div>
        }
    </div>

    db.Close();
}
@helper PreserveMembers()
{
    if (!WebSecurity.IsAuthenticated) { Response.Redirect("~/"); }
    int u_id = WebSecurity.CurrentUserId;

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM members WHERE is_preserving=1";
    var preserveTeam = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM repLists WHERE is_deleted=0 ORDER BY create_ts";
    var repLists = db.Query(sqlSelect);


    db.Close();

    <div style="overflow: auto;padding: 0;margin: 0">
        <div style="padding: 5px;margin: 5px;background-color: #fff;text-align: center;">
            <div style="overflow: auto">
                <h2 style="float: right;">ניהול שימור לקוחות</h2>
                <button style="float: left;font-size: 16px;padding: 5px;margin: 5px;border: 0" onclick="Accordionize('ListSettingsAcc');">רשימה חדשה</button>
            </div>

            <div style="overflow: auto;padding: 0;margin: 0">

                <button class="accordion" id="ListSettingsAcc" style="display: none;"></button>
                <div class="panel" style="padding: 0;margin: 0">
                    <div style="overflow: auto;padding: 5px;border: 2px dotted #000;color: #000;font-size: 16px;text-align: right;margin: 5px">
                        <form id="NewListSettings">
                            <div style="overflow: auto;">
                                <div style="overflow: auto;" id="ListOptionsDiv">
                                    @AppHelpers.LoadPreserveListSettings()
                                </div>


                            </div>

                        </form>
                        <div style="overflow: auto">
                            <div id="CounterResultsDiv" style="float: right"></div>
                            <button type="button" style="float: left;font-size: 16px;padding: 5px;margin: 5px;border: 0" onclick="RepAjaxUpdate('CalcNewList','CounterResultsDiv','mHLoader','NewListSettings')">בצע</button>
                        </div>
                    </div>

                </div>

            </div>

            <div style="overflow: auto;padding: 0;margin: 0">
                @foreach (var aList in repLists)
                {
                    int listCount = 0;
                     sqlSelect = "select COUNT(listsUsers.serial) AS the_cnt from listsusers INNER JOIN pb ON listsusers.user_id=pb.m_id WHERE listsusers.is_deleted=0 AND pb.is_deleted=0 AND listsusers.list_id=@0";

                    var rs = db.QuerySingle(sqlSelect, aList.list_id);
                    try { listCount = rs.the_cnt; } catch { }
                    if (listCount > 0)
                    {
                        <span style="padding: 5px;margin: 5px;background-color: #e3e3e3;color: #808080;font-size: 16px;float: right" onclick="sbload('SubMenu', 'Caller?p1=ListManager&p2=@aList.list_id');">
                            @aList.list_name <span style="padding: 3px;margin: 5px;font-size: 14px;background-color: #fff;color: #808080">@listCount</span>
                        </span>
                    }
                }
            </div>

        </div>

        <div style="overflow: auto;opacity: 0.7;height: 100%;background-color: #fff;width: 100%;display: none;" id="mHLoader">
            <div class="spinner" style="text-align: center;font-size: 30px;">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>

        <div style="overflow: auto" id="RepResDiv">

        </div>
    </div>

}

@helper MembersListPreview(string StartsWith, int min_order_count, DateTime max_order_date, DateTime min_order_date, bool unassigned_only = true)
{
    DateTime emptyDate = Convert.ToDateTime("1/1/1900");
    var db = Database.Open("op_data");
    //var sqlSelect = "select * from u_stats WHERE order_count>=@0 AND last_order_ts<@1 AND last_order_ts>@2 ";
    var sqlSelect = "select u_stats.*,pb.member_name from u_stats JOIN pb ON u_stats.serial=pb.m_id WHERE u_stats.order_count>=@0 AND u_stats.last_order_ts<@1 AND u_stats.last_order_ts>@2";

    string strStartsWith = StartsWith;
    string tmp = sqlSelect;
    if (!strStartsWith.IsEmpty())
    {
        try { strStartsWith = strStartsWith.Replace(",", "##"); } catch { }
        string[] StartsWithArr;
        string sep = "##";
        StartsWithArr = strStartsWith.Split(sep.ToCharArray());
        string curOpertor = " AND (";

        foreach (var searchterm in StartsWithArr)
        {
            if (!searchterm.IsEmpty())
            {
                tmp = tmp + curOpertor + " pb.member_name LIKE N'" + searchterm + "%'";
                // sqlSelect = sqlSelect + curOpertor+ "  pbname LIKE '" + searchterm + "%'";
                curOpertor = " OR ";
            }

        }
        tmp = tmp + " )";
    }

    if (unassigned_only)
    {
        tmp = tmp + " AND preserve_rep=0";
    }


    sqlSelect = tmp;

    sqlSelect = sqlSelect + " ORDER BY last_order_ts DESC";

    if (max_order_date == emptyDate)
    {
        //         max_order_date=Convert.ToDateTime("1/1/2199");
    }

    var rs = db.Query(sqlSelect, min_order_count, max_order_date, min_order_date);
    int counter = 0;
    sqlSelect = "SELECT * FROM members WHERE is_preserving=1";
    var preserveTeam = db.Query(sqlSelect);

    int last_prospect_id = 9999999;
    int first_prospect_id = 0;


    <div style="overflow: auto;padding: 0;margin: 0">
        <form id="PreserveProspectsAllocation">
            <div style="overflow: auto;padding: 5px;">
                <h2>רשימות שימור לקוחות</h2>
                מציג @rs.Count() חברים  @if (StartsWith != "")
                {<span>שהשם שלהם מתחיל ב @StartsWith</span>} שהזמינו לפחות @min_order_count פעמים ושתאריך ההזמנה האחרונה שלהם הוא בין @min_order_date.ToShortDateString() - @max_order_date.ToShortDateString()
            </div>

            <div style="overflow: auto;padding: 5px;background-color: #ffffcc;font-size: 16px;">
                שמירה:
                <input type="text" style="padding: 5px;margin: 5px;font-size: 16px" name="list_name" id="list_name" placeholder="נא להזין שם רשימה">
                <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;float: left" id="btnGoPreserveList" onclick="showElement('GoPreserveListLoader');hideElement('btnGoPreserveList');AjaxActions('AllocatePreserveProspects','','','PreserveProspectsAllocation');">שמירה</button>
                <div style="float: left;display: none;" id="GoPreserveListLoader">
                    <div class="spinner" style="text-align: center;font-size: 30px;">
                        <div class="bounce1"></div>
                        <div class="bounce2"></div>
                        <div class="bounce3"></div>
                    </div>
                </div>
            </div>


            <table style="width: 100%">
                <tr style="width: 100%">
                    <td style="padding: 3px;margin: 3px;float: right;text-align: center;display: none">
                        <input type="checkbox" style="padding: 3px;margin: 3px" onclick="var x=document.getElementById('last_prospect_id').value;for (var i = @first_prospect_id; i <=x; i++) {try{document.getElementById('prospect_' + i).checked=this.checked;}catch(err){}}">
                    </td>
                    <td style="padding: 3px;margin: 3px;float: right;text-align: right">משתמש</td>
                    <td style="padding: 3px;margin: 3px;margin-left: 10px;float: left;width: 150px;text-align: left">הזמנה אחרונה</td>
                    <td style="padding: 3px;margin: 3px;margin-left: 20px;float: left;text-align: center">קודמות</td>
                </tr>

                @foreach (var prospect in rs)
                {
                    if (first_prospect_id > prospect.serial || first_prospect_id == 0)
                    {
                        first_prospect_id = prospect.serial;
                    }
                    if (last_prospect_id < prospect.serial || last_prospect_id == 9999999)
                    {
                        last_prospect_id = prospect.serial;
                    }

                    <tr style="width: 100%">
                        <td style="padding: 3px;margin: 3px;float: right;text-align: center">
                            <input type="checkbox" style="padding: 3px;margin: 3px;display: none" id="prospect_@prospect.serial" name="prospect_@prospect.serial" checked>
                        </td>
                        <td style="padding: 3px;margin: 3px;float: right;text-align: right">@prospect.member_name</td>
