@helper SysLog(int rep_id = 0, string logName = "")
{
    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";
    string txtHeader = "";
    int recordCnt = 0;
    var db = Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "select top(500) * from AppLog WHERE ";

    if (logName.IsEmpty())
    {
        sqlSelect = sqlSelect + " (logname='" + logName + " 'OR logname<>'" + logName + "')";
        txtHeader = "מציג את כל היומנים";
    }
    else
    {
        sqlSelect = sqlSelect + " logname='" + logName + "'";
        txtHeader = "מציג את היומן " + logName;
    }

    if (rep_id != 0)
    {
        sqlSelect = sqlSelect + " AND clerk_id=" + rep_id;
        txtHeader = txtHeader + " למשתמש " + AppFunctions.GetRepName(rep_id);
    }
    else
    {
        txtHeader = txtHeader + " לכל המשתמשים ";
    }

    sqlSelect = sqlSelect + " ORDER BY id DESC";
    var theLog = db.Query(sqlSelect);
    recordCnt = theLog.Count();
    string tmpsql = sqlSelect;
    sqlSelect = "SELECT DISTINCT clerk_id FROM AppLog ";
    var Reps = db.Query(sqlSelect);
    sqlSelect = "SELECT DISTINCT logName FROM AppLog ";
    var Logs = db.Query(sqlSelect);
    db.Close();

    <div style="overflow: auto;padding: 5px;" id="RepPreseveListDiv">
        <button style="float: left;font-size: 16px;padding: 5px;margin: 5px;border: 0" onclick="Accordionize('LogListSettingsAcc');">⚙️</button>
