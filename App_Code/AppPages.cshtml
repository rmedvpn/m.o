                                    <button style="font-size: 16px;padding: 5px;margin: 5px;font-weight: bold;color: #57d600;background-color: #fff;border: 2px solid #57d600" onclick="Accordionize('UserActionsAcc');">הקפאת לקוח</button>
                                </div>

