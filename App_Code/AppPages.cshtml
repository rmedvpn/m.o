            <div style="overflow: auto;padding: 5px;border: 2px dotted #000;color: #000;font-size: 16px;text-align: right;margin: 5px">
                <form id="LogListSettings">
                    <div style="overflow: auto;">
                        <span style="float: right;font-size: 12px;color: #b200ff">
                            סוג יומן<br>
                            <select style="padding: 5px;margin: 5px;font-size: 16px" name="logName" id="logName">
                                <option value="">כולם</option>
                                @foreach (var log in Logs)
                                {
                                    <option value="@log.logname">@log.logname</option>
                                }
                            </select>
                        </span>
                        <span style="float: right;font-size: 12px;color: #b200ff">
