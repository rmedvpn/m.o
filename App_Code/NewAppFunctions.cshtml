    public static Decimal GetOrderTotal(int order_id)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "select SUM(price*quan) AS tot from orderitems where order_id=@0";
        var ord_total = db.QuerySingle(sqlSelect, order_id);
        decimal totalSum = 0;
        try { totalSum = Convert.ToDecimal(ord_total.tot); } catch { }
        db.Close();
        return totalSum;

