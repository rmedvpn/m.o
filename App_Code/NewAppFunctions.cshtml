                sqlSelect = "SELECT title AS the_label FROM irgoon.mahSysMenus WHERE id=@0";
                break;
            case "ItemType":
                switch (lang)
                {
                    case 1:
                        sqlSelect = "SELECT title AS the_label FROM ItemUnitTypes WHERE id=@0";
                        break;
                    case 2:
                        sqlSelect = "SELECT title_e AS the_label FROM ItemUnitTypes WHERE id=@0";
                        break;

                    default:
                        sqlSelect = "SELECT title AS the_label FROM ItemUnitTypes WHERE id=@0";
                        break;
                }
                break;
            case "StrainType":
                switch (lang)
                {
                    case 1:
                        sqlSelect = "SELECT title AS the_label FROM StrainTypes WHERE strain_type=@0";
                        break;
                    case 2:
                        sqlSelect = "SELECT title_e AS the_label FROM StrainTypes WHERE strain_type=@0";
                        break;

                    default:
                        sqlSelect = "SELECT title AS the_label FROM ItemUnitTypes WHERE id=@0";
                        break;
                }
                break;
            case "Round":
                sqlSelect = "SELECT title AS the_label FROM rounds WHERE id=@0";
                break;

            case "Round_Short":
                sqlSelect = "SELECT short_title AS the_label FROM rounds WHERE id=@0";
                break;

            case "Cat":
                sqlSelect = "SELECT title AS the_label FROM categories WHERE id=@0";
                break;

            case "Product":
                sqlSelect = "SELECT title AS the_label FROM products WHERE p_id=@0";
                break;


            case "SpecialOffer":
                sqlSelect = "SELECT title AS the_label FROM SpecialOffers WHERE id=@0";
                break;


            case "Coupon":
                sqlSelect = "SELECT coupon_title AS the_label FROM coupons WHERE coupon_id=@0";
                break;

            case "Area":
                sqlSelect = "SELECT title AS the_label FROM AppServicesArea WHERE id=@0";
                break;

            case "OrderStatus":
                sqlSelect = "SELECT heb_status AS the_label FROM AppOrderStatuses WHERE order_status=@0";
                break;

            case "InventoryActionCode":
                sqlSelect = "SELECT title AS the_label FROM irgoon.InventoryActionCodes WHERE action_code=@0";
                break;
            case "Vendor":
                sqlSelect = "SELECT vendor_name AS the_label FROM vendors WHERE vendor_id=@0";
                break;
            case "VendorPermission":
                sqlSelect = "SELECT title AS the_label FROM appPermissionCodes WHERE id=@0";
                break;
            case "VendorAddressNick":
                sqlSelect = "SELECT address_nick AS the_label FROM vendoraddresses WHERE id=@0";
                break;
    
            default:
