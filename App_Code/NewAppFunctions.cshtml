    public static string strDayOfWeekFromInt(int theDay, int lang = 0)
    {
        string dayOfWeekStr = "";
        switch (theDay)
        {
            case 0:
                dayOfWeekStr = "ראשון";
                break;
            case 1:
                dayOfWeekStr = "שני";
                break;
            case 2:
                dayOfWeekStr = "שלישי";
                break;
            case 3:
                dayOfWeekStr = "רביעי";
                break;
            case 4:
                dayOfWeekStr = "חמישי";
                break;
            case 5:
                dayOfWeekStr = "שישי";
                break;
            case 6:
                dayOfWeekStr = "שבת";
                break;

        }

        return dayOfWeekStr;

    }

    public static string StatusLabelByCode(int status_code, string status_of, bool is_english = false)
    {

        var sqlSelect = "";
        var db = Database.Open("op_data");

        switch (status_of)
        {

            case "LOCALORDER":
                break;
            case "CAT":
                if (!is_english)
                {
                    sqlSelect = "SELECT title AS theStatus FROM irgoon.categories WHERE id=@0";
                }
                else
                {
                    sqlSelect = "SELECT title_e AS theStatus FROM irgoon.categories WHERE id=@0";
                }
                break;
            case "SALEDISAPPROVAL":
                if (!is_english)
                {
                    sqlSelect = "SELECT denial_reason AS theStatus FROM irgoon.localSaleDenialCodes WHERE serial=@0";
                }
                else
                {
                    sqlSelect = "SELECT denial_reason_e AS theStatus FROM irgoon.localSaleDenialCodes WHERE serial=@0";
                }
                break;
            case "ROUND":
                if (!is_english)
                {
                    sqlSelect = "SELECT heb_status AS theStatus FROM irgoon.RoundStatuses WHERE round_status=@0";
                }
                else
                {
                    sqlSelect = "SELECT eng_status AS theStatus FROM irgoon.RoundStatuses WHERE round_status=@0";
                }
                break;
            case "ORDER":
                if (!is_english)
                {
                    sqlSelect = "SELECT heb_status AS theStatus FROM irgoon.AppOrderStatuses WHERE order_status=@0";
                }
                else
                {
                    sqlSelect = "SELECT eng_status AS theStatus FROM irgoon.AppOrderStatuses WHERE order_status=@0";
                }
                break;
            case "ROUTE":
                if (!is_english)
                {
                    sqlSelect = "SELECT heb_status AS theStatus FROM tlg.AppRouteStatuses WHERE route_status=@0";
                }
                else
                {
                    sqlSelect = "SELECT eng_status AS theStatus FROM tlg.AppRouteStatuses WHERE route_status=@0";
                }
                break;

        }



        var StatusRS = db.QuerySingle(sqlSelect, status_code);
        db.Close();
        if (StatusRS != null) { return StatusRS.theStatus; }
        else { return ""; }

    }

