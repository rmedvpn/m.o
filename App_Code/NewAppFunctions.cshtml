    public static int Counter(string CountWhat, string param1 = "", string param2 = "", string param3 = "")
    {
        int ret_val = 0;
        var sqlSelect = "";
        var db = Database.Open("op_data");
        switch (CountWhat)
        {
            case "ALLORDERS": //count all orders
                if (true)
                {
                    sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders";
                    var theCounter = db.QuerySingle(sqlSelect);
                    try { ret_val = theCounter.cnt; } catch { }
                }
                break;

            case "ALLROUNDORDERS": //count unpacked orders
                if (true)
                {
                    int round_id = 0; try { round_id = Convert.ToInt32(param1); } catch { }
                    sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where round_id=@0";
                    var theCounter = db.QuerySingle(sqlSelect, round_id);
                    try { ret_val = theCounter.cnt; } catch { }

                }
                break;

            case "CURRENTROUNDORDERS": //count unpacked orders
                if (true)
                {
                    int round_id = 0; try { round_id = Convert.ToInt32(param1); } catch { }
                    DateTime curTime = AppFunctions.LocalTime();
                    sqlSelect = "SELECT next_scheduled_delivery FROM dbo.rounds WHERE id=@0";
                    var round_info = db.QuerySingle(sqlSelect, round_id);
                    DateTime next_scheduled_delivery = Convert.ToDateTime("1/1/2100");
                    try { next_scheduled_delivery = round_info.next_scheduled_delivery; } catch { }
                    sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where round_id=@0 AND requested_delivery_date<=@1";
                    var theCounter = db.QuerySingle(sqlSelect, round_id, next_scheduled_delivery);
                    try { ret_val = theCounter.cnt; } catch { }

                }
                break;

            case "FUTUREROUNDORDERS": //count unpacked orders
                if (true)
                {
                    int round_id = 0; try { round_id = Convert.ToInt32(param1); } catch { }
                    DateTime curTime = AppFunctions.LocalTime();
                    sqlSelect = "SELECT next_scheduled_delivery FROM dbo.rounds WHERE id=@0";
                    var round_info = db.QuerySingle(sqlSelect, round_id);
                    DateTime next_scheduled_delivery = Convert.ToDateTime("1/1/2100");
                    try { next_scheduled_delivery = round_info.next_scheduled_delivery; } catch { }
                    sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where round_id=@0 AND requested_delivery_date>@1";
                    var theCounter = db.QuerySingle(sqlSelect, round_id, next_scheduled_delivery);
                    try { ret_val = theCounter.cnt; } catch { }
                }
                break;

            case "UNASSIGNEDDUEROUNDORDERS": //count unpacked orders
                if (true)
                {
                    int round_id = 0; try { round_id = Convert.ToInt32(param1); } catch { }
                    DateTime curTime = AppFunctions.LocalTime();
                    sqlSelect = "SELECT next_scheduled_delivery FROM dbo.rounds WHERE id=@0";
                    var round_info = db.QuerySingle(sqlSelect, round_id);
                    DateTime next_scheduled_delivery = Convert.ToDateTime("1/1/2100");
                    try { next_scheduled_delivery = round_info.next_scheduled_delivery; } catch { }
                    sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where delivery_id=0 AND round_id=@0 AND requested_delivery_date<=@1";
                    var theCounter = db.QuerySingle(sqlSelect, round_id, next_scheduled_delivery);
                    try { ret_val = theCounter.cnt; } catch { }

                }
                break;

            case "DeliveryOrders": //count orders in a delivery
                if (true)
                {
                    int delivery_id = 0; try { delivery_id = Convert.ToInt32(param1); } catch { }
                    sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where delivery_id=@0";
                    var theCounter = db.QuerySingle(sqlSelect, delivery_id);
                    try { ret_val = theCounter.cnt; } catch { }

                }
                break;

            case "RoundDeliveriesCount": //count orders in a delivery
                if (true)
                {
                    int round_id = 0; try { round_id = Convert.ToInt32(param1); } catch { }
                    sqlSelect = "SELECT COUNT(serial) AS cnt from deliveries where round_id=@0";
                    var theCounter = db.QuerySingle(sqlSelect, round_id);
                    try { ret_val = theCounter.cnt; } catch { }

                }
                break;

        }

        db.Close();

        return ret_val;

    }

    public static Decimal GetRoundTotalOrdersSum(int round_id,int z_id=0)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT SUM(grand_total) AS ord_tot from MainOrders  WHERE is_cancelled=0 AND is_deleted=0 AND z_id=@0 AND round_id=@1";
        var ord_total = db.QuerySingle(sqlSelect, z_id,round_id);
        decimal totalSum = 0;
        try { totalSum = Convert.ToDecimal(ord_total.ord_tot); } catch { }
        db.Close();
        return totalSum;

    }
    public static int GetOrdersCountByRound(string CountWhat, int round_id)
    {
        var sqlSelect = "";


        switch (CountWhat)
        {
            case "ALL": //count all orders

                sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where round_id=@0";

                break;
            case "UNPACKED": //count unpacked orders
                sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where is_packed=0 AND round_id=@0";
                break;

            case "PACKED": //count unpacked orders
                sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where is_packed=1 AND round_id=@0";


                break;
            case "UNAPPROVED": //count unapproved orders
                sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where is_approved=0 AND  round_id=@0";
                break;

            case "READYFORPU": //count unapproved orders
                sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where is_awaiting_pickup=1 AND  round_id=@0";
                break;
            case "INCOMPLETE": //count uncompleted orders
                sqlSelect = "SELECT COUNT(order_id) AS cnt from MainOrders where is_complete=0 AND  round_id=@0";
                break;

        }

        var db = Database.Open("op_data");
        var theCounter = db.QuerySingle(sqlSelect, round_id);
        db.Close();
        if (theCounter != null)
        {
            return theCounter.cnt;
        }
        else { return 0; }
    }

