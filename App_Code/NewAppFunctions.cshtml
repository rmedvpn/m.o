    public static void DoProductCustomFieldSequencing(int p_id)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT id FROM ProductsCustomFields WHERE is_activated=1 AND p_id=@0 ORDER BY listindex";
        var fieldRs = db.Query(sqlSelect, p_id);
        int i = 0;
        foreach (var item in fieldRs)
        {
            i++;
            sqlSelect = "UPDATE ProductsCustomFields SET listindex=@0 WHERE id=@1";
            db.Execute(sqlSelect, i, item.id);
        }
        db.Close();
        return;
    }

    public static void DoCategoryCustomFieldSequencing(int cat_id)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT id FROM ProductsCustomFields WHERE p_id=0 AND cat_id=@0 ORDER BY listindex";
        var fieldRs = db.Query(sqlSelect, cat_id);
        int i = 0;
        foreach (var item in fieldRs)
        {
            i++;
            sqlSelect = "UPDATE ProductsCustomFields SET listindex=@0 WHERE id=@1";
            db.Execute(sqlSelect, i, item.id);
        }
        db.Close();
        return;
    }

