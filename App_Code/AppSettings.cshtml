@helper SettingsMain()
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

if (!WebSecurity.IsAuthenticated) { Response.Redirect("~/"); }
int u_id = WebSecurity.CurrentUserId;
string username = WebSecurity.CurrentUserName;
var sqlSelect = "";

var db = Database.Open("op_data");

sqlSelect = "SELECT * FROM AppServicesArea where is_main_area=1 ";
var serviceAreas = db.Query(sqlSelect);

    <div class="A" style="text-align:right">
        <div style="overflow: auto;padding: 5px;">

            <h2 style="float:right">הגדרות</h2>
        </div>
        <div class="A">
            <div class="B">
                <div style="float:left;direction:rtl">
                    <form id="AddMainArea">
                        <input type="text" class="A" name="area_name" id="area_name" placeholder="אזור" />
                        <input type="text" class="A" name="area_name_e" id="area_name_e" placeholder="In English" />
                        <select class="A" name="main_area_id" id="main_area_id">
                            <option >נא לבחור לאיזה אזור להוסיף</option>
                            <option value="-1">אזור ראשי</option>
                            @foreach (var area in serviceAreas)
                            {
                                <option value="@area.id">@area.title</option>
                            }
                        </select>
                        <button type="button" class="A" onclick="AjaxActions('AddServiceArea', document.getElementById('area_name').value, 'MainLoader',document.getElementById('area_name_e').value,document.getElementById('main_area_id').value);">הוספה</button>
                    </form>
                    
                </div>

                <h3>אזורים</h3>
            </div>

            <div class="A">
                @foreach (var area in serviceAreas)
                {
                    sqlSelect = "SELECT * FROM AppServicesArea where main_area_id=@0";
                    var subAreas = db.Query(sqlSelect, area.id);
                    <div class="PropTag">
                        <button type="button" class="A" style="float:left" onclick="AjaxActions('DeleteServiceArea', '@area.id', 'MainLoader');">מחיקה</button>
                        <div style="float:left;direction:rtl">
  

                        </div>
                        <div class="PropTagTitle">@area.title</div>
                    </div>
                    if (subAreas.Count > 0)
                    {
                        <div class="PropTagSub">
                            @foreach (var subArea in subAreas)
                            {
                                <div class="PropTag" style="background-color:#e3e3e3;color:#000000;margin-right:15px;">
                                    <button type="button" class="A" style="float:left" onclick="AjaxActions('DeleteServiceArea', '@subArea.id', 'MainLoader');">מחיקה</button>
                                    <div class="PropTagTitle" style="color: #000000;">@subArea.title</div>
                                </div>
                            }
                        </div>
                    }

                }
            </div>
        </div>

    </div>
    <div class="A" style="height:150px;">&nbsp;</div>


    db.Close();
}




@functions {

    public static string AddServiceArea()
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        int u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        string theHtmlOutput = "";
        string logMsg = "";

        string area_name = ""; area_name = Request["value"];
        string area_name_e = ""; area_name_e = Request["param1"];
        int main_area_id = 0; try { main_area_id = Convert.ToInt32(Request["param2"]); } catch { }

        if (area_name=="" || area_name_e == "")
        {
            theHtmlOutput += "חובה להזין שם אזור בעברית ובאנגלית!<br>";
        }
        if (main_area_id==0)
        {
            theHtmlOutput += "חובה לבחור לאיזה אזור רוצים להוסיף!<br>";
        }

        if (theHtmlOutput == "")
        {
            var db = Database.Open("op_data");
            var sqlSelect = "INSERT INTO AppServicesArea (title,e_title) VALUES(@0,@1)";
            db.Execute(sqlSelect, area_name, area_name_e);
            theHtmlOutput = "הפעולה בוצעה בהצלחה!<br>";
            db.Close();

        }
        else
        {
            theHtmlOutput = "!$!" + theHtmlOutput;
        }

        return theHtmlOutput;


    }

    public static string DeleteServiceArea()
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        int u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        string theHtmlOutput = "";
        string logMsg = "";

        int area_id = 0; try { area_id = Convert.ToInt32(Request["value"]); } catch { }
        if (theHtmlOutput == "")
        {
            var db = Database.Open("op_data");
            var sqlSelect = "UPDATE AppServicesArea SET is_active=0 WHERE id=@0";
            db.Execute(sqlSelect, area_id);
            sqlSelect = "DELETE FROM RoundAreas WHERE area_id=@0";
            db.Execute(sqlSelect, area_id);
            sqlSelect = "DELETE FROM CitiesInAreas WHERE area_id=@0";
            db.Execute(sqlSelect, area_id);



            theHtmlOutput = "הפעולה בוצעה בהצלחה!<br>";
            db.Close();

        }

        return theHtmlOutput;


    }

}