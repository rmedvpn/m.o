                            logMsg = "אופן תשלום עודכן לאשראי עד תאריך " + credit_return_date.ToShortDateString() + " " + credit_notes;
                        }
                        AppFunctions.WriteOrderComment(order_id, logMsg);

                        if (is_credit_limit_override)
                        {
                            logMsg = "בוצעה עקיפה ידנית של הגבלות אשראי!: " + credit_notes;
                            AppFunctions.WriteOrderComment(order_id, logMsg);
                        }

                        break;
                    case 3:
                        is_charge = true;
                        credit_amount = 0;
                        donate_amount = 0;
                        debt_return_amount = 0;
                        actual_pickup_amount = grand_total - CreditCouponsTotal - charge_amount;
                        logMsg = "אופן תשלום עודכן לחיוב חשבון #" + charge_account_id;
                        AppFunctions.WriteOrderComment(order_id, logMsg);
                        break;
                    case 4:
                        is_charge_waived = true;
                        credit_amount = 0;
                        donate_amount = 0;
                        debt_return_amount = 0;
                        charge_amount = 0;
                        is_cost_charge = false;
                        actual_pickup_amount = waived_charge_sh;
                        logMsg = "ההזמנה ללא עלות: " + charge_waive_note ;
                        if (waived_charge_sh > 0)
                        {
                            logMsg += " בתשלום דמי משלוח של " + waived_charge_sh.ToString("C", culture);
                        }
                        AppFunctions.WriteOrderComment(order_id, logMsg);
                        break;
                }

                if (DisableMoneyVouchers) {
                    MoneyVouchersTotal = 0;

                }
                else {
                    if (money_vouchers_available_balance > 0) {
                        if (money_vouchers_available_balance > actual_pickup_amount)
                        {
                            MoneyVouchersTotal = actual_pickup_amount;

                        }
                        else
                        {
                            MoneyVouchersTotal = money_vouchers_available_balance;
                        }
                    }
                    else
                    {
                        MoneyVouchersTotal = 0;
                    }

                }

                DataFunctions.WriteDebugLine("actual_pickup_amount " + actual_pickup_amount);
                DataFunctions.WriteDebugLine("MoneyVouchersTotal " + MoneyVouchersTotal);

                actual_pickup_amount = actual_pickup_amount - MoneyVouchersTotal;


                sqlSelect = "UPDATE MainOrders SET payment_method=@0,is_donate=@1,donate_amount=@2,is_returning_credit=@3,return_amount=@4,credit_amount=@5,is_credit=@6,credit_return_date=@7,charge_amount=@8,is_charge=@9,charge_account_id=@10,actual_pickup_amount=@11,charge_account_name=@12,is_credit_limit_override=@13,credit_limit_override_by=@14,credit_overide_amount=@15,credit_notes=@16,debt_bypass=@17,debt_bypass_amount=@18,debt_bypass_by=@19,is_cost_charge=@20,is_total_roundup=@21,is_donate_roundup=@22,roundup_to=@23,items_cost_charge=@24,cost_charge_markup=@25,total_cost_charge=@26,charge_waive_note=@27,is_charge_waived=@28,waived_charge_sh=@29,is_refund=@30,refund_amount=@31,refund_notes=@32,MoneyVouchersTotal=@33,DisableMoneyVouchers=@34 WHERE order_id=@35";
                db.Execute(sqlSelect, payment_method, is_donate, donate_amount, is_returning_credit, debt_return_amount, credit_amount, is_credit, credit_return_date, charge_amount, is_charge, charge_account_id, actual_pickup_amount, charge_account_name, is_credit_limit_override, u_id, credit_overide_amount, credit_notes, debt_bypass, debt_bypass_amount, u_id, is_cost_charge, is_total_roundup, is_donate_roundup, roundup_to, items_cost_charge, cost_charge_markup, total_cost_charge,charge_waive_note, is_charge_waived,waived_charge_sh,is_refund,refund_amount,refund_notes, MoneyVouchersTotal, DisableMoneyVouchers, order_id);


                if (payment_method == 1 && !debt_bypass)
                {
                    OrderFunctions.AttachDebtToOrder(order_id);
                }
                else
                {
                    OrderFunctions.CalcOrderActualPickupAmount(order_id);
                }

                decimal cur_order_refund_amount = 0; try { cur_order_refund_amount = order.refund_amount; } catch { }
                if (cur_order_refund_amount > 0 && (refund_amount == 0 || (refund_amount>0 && refund_amount!= cur_order_refund_amount)) )
