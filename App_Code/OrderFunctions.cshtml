    public static decimal GetItemEffectivePrice(int p_id, int round_id, int quan = 1, int price_type = 0)
    {
        decimal item_price = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT *  FROM roundMenuItems WHERE round_id=@0 AND p_id=@1";
        var MenuItem = db.QuerySingle(sqlSelect, round_id, p_id);
        if (MenuItem == null)
        {
            DataFunctions.WriteDebugLine("round_id " + round_id + "p_id " + p_id);
            item_price = -1;
        }
        else
        {
            int catalog_p_id = MenuItem.catalog_p_id;

            if (price_type == 1)
            {
                item_price = (MenuItem.price * quan); //efffective price based on item list price

            }
            if (price_type == 0)
            {
                sqlSelect = "SELECT top(1) * FROM ProductPricingOptions WHERE (p_id=@0 OR p_id=@1) AND (round_id=@2 OR round_id=99999) AND quan<=@3 ORDER BY round_id DESC, QUAN DESC";
                var pricingOption = db.QuerySingle(sqlSelect, MenuItem.p_id, catalog_p_id, round_id, quan);


                if (pricingOption != null)
                {
                    decimal OptionIdPrice = pricingOption.price;
                    int OptionIdQuan = pricingOption.quan;
                    decimal optionIdAdditional = pricingOption.each_additional;
                    int additionalUnitsCount = quan - OptionIdQuan;
                    item_price = OptionIdPrice + (additionalUnitsCount * optionIdAdditional);
                }
                else
                {
                    item_price = (MenuItem.price * quan);
                }
            }


        }





        db.Close();
        return item_price;
    }
