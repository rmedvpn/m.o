    public static void CalcOrderActualPickupAmount(int order_id)
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        decimal OrderPickupAmount = 0;
        DateTime local_time = AppFunctions.LocalTime();
        string logMsg = "";
        var u_id = WebSecurity.CurrentUserId;
        var db = WebMatrix.Data.Database.Open("op_data");

        int vendor_id = 0;
        int t_type = 0;

        var sqlSelect = "SELECT * FROM MainOrders WHERE order_id=@0";
        var order = db.QuerySingle(sqlSelect, order_id);
        if (order != null)
        {
            bool is_total_roundup = order.is_total_roundup;
            bool is_cost_charge = order.is_cost_charge;
            bool is_charge_waived = order.is_charge_waived;
            decimal waived_charge_sh = order.waived_charge_sh;
            decimal roundup_amount = 0;
            decimal roundup_to = order.roundup_to;
            decimal total_cost_charge = order.total_cost_charge;
            decimal MoneyVouchersTotal = 0;
            bool DisableMoneyVouchers = order.DisableMoneyVouchers;

            int member_id = order.u_id;
            try { MoneyVouchersTotal = MoneyFunctions.GetMemberAvailableMoneyVouchersBalance(member_id); } catch { }

            decimal subTotal = 0;
            int payment_method= order.payment_method;
            decimal money_vouchers_available_balance = 0;
            money_vouchers_available_balance = MoneyFunctions.GetMemberAvailableMoneyVouchersBalance(member_id);



            if (is_charge_waived)
            {
                OrderPickupAmount = waived_charge_sh;
            }
            else
            {
                subTotal = order.grand_total + order.return_amount + order.donate_amount - order.CreditCouponsTotal - order.credit_amount - order.charge_amount;
                OrderPickupAmount = subTotal;
            }

            if (is_cost_charge)
            {
                OrderPickupAmount = order.total_cost_charge + order.return_amount + order.donate_amount - order.CreditCouponsTotal - order.credit_amount - order.charge_amount;
            }

            if (OrderPickupAmount <= MoneyVouchersTotal)
            {
                MoneyVouchersTotal = OrderPickupAmount;
            }

            if (DisableMoneyVouchers)
            {
                MoneyVouchersTotal = 0;
            }

            OrderPickupAmount = OrderPickupAmount - MoneyVouchersTotal;


            if (is_total_roundup && payment_method == 1)
            {
                roundup_amount = MoneyFunctions.RoundUpAmount(Convert.ToDouble(OrderPickupAmount), Convert.ToDouble(roundup_to));
            }


            decimal after_roundup_total = OrderPickupAmount + roundup_amount;

            DataFunctions.WriteDebugLine("OrderPickupAmount123c " + OrderPickupAmount);

            sqlSelect = "UPDATE mainOrders SET actual_pickup_amount=@0,roundup_amount=@1,after_roundup_total=@2,MoneyVouchersTotal=@3 WHERE order_id=@4";
            db.Execute(sqlSelect, OrderPickupAmount, roundup_amount, after_roundup_total, MoneyVouchersTotal, order_id);

        }


        db.Close();
    }

