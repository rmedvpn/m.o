    public static int GetOrderLeadTimeMin(int order_id)
    {
        int lead_time = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");

        var sqlSelect = "SELECT round_id,is_express,is_pickup FROM MainOrders WHERE order_id=@0";
        var Order = db.QuerySingle(sqlSelect, order_id);
        int round_id = 0; try { round_id = Order.round_id; } catch { }
        sqlSelect = "SELECT round_type,express_eta_min,pu_lead_time,round_start,estimated_duration FROM rounds WHERE id=@0";
        var Round = db.QuerySingle(sqlSelect, round_id);
        if (Round != null)
        {
            bool is_express = false; try { is_express = Order.is_express; } catch { }
            bool is_pickup = false; try { is_pickup = Order.is_pickup; } catch { }
            if (is_express)
            {
                try { lead_time = Round.express_eta_min; } catch { }
            }
            if (is_pickup)
            {
                try { lead_time = Round.pu_lead_time; } catch { }

            }
            if (lead_time == 0)
            {
                DateTime defDate = Convert.ToDateTime("1/1/1900");
                DateTime round_start = defDate; try { round_start = Round.round_start; } catch { }
                int estimated_duration = 0; try { estimated_duration = Round.estimated_duration; } catch { }
                if (round_start != defDate && estimated_duration > 0)
                {
                    round_start = round_start.AddMinutes(estimated_duration);
                    lead_time = AppFunctions.MinutesDifferenceToDate(round_start);
                }
            }
        }

        db.Close();
        return lead_time;
    }
    public static int CreateOrderEnvelopeId(int order_id, bool is_update = true, int delivery_id=0)
    {
        int envelope_id = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");

        var sqlSelect = "SELECT round_id FROM MainOrders WHERE order_id=@0";
        var Order = db.QuerySingle(sqlSelect, order_id);

        if (delivery_id == 0)
        {
            int round_id = 0; try { round_id = Order.round_id; } catch { }
            sqlSelect = "SELECT z_serial FROM rounds WHERE id=@0";
            var round = db.QuerySingle(sqlSelect, round_id);
            int z_serial = 0; try { z_serial = round.z_serial; } catch { }

            sqlSelect = "SELECT MAX(envelope_id) as envelope_id FROM mainorders WHERE z_serial=@0 ";
