    public static decimal CalculateOrderComission(int order_id)
    {
        decimal order_commission = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");

        var sqlSelect = "SELECT * FROM orderitems WHERE order_id=@0 ORDER BY special_id,item_id DESC";
        var OrderItems = db.Query(sqlSelect, order_id);
        foreach (var item in OrderItems)
        {
            order_commission += OrderFunctions.GetItemCommission(item.id);

        }


        db.Close();
        return order_commission;
    }
    public static decimal GetItemCommission(int item_serial)
    {
        decimal item_commission = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");
        var sqlSelect = "SELECT * FROM orderitems WHERE id=@0";
        var orderItem = db.QuerySingle(sqlSelect, item_serial);
        int p_id = orderItem.p_id;



        //if item is a special offer
        if (orderItem.item_id == -1)
        {
            sqlSelect = "SELECT * FROM specialoffers WHERE id=@0";
            var spOffer = db.QuerySingle(sqlSelect, orderItem.special_id);
            item_commission = orderItem.quan * spOffer.special_commision;
        }


        //if regular item
        if (orderItem.item_id > 0)
        {
            if (!orderItem.isQuanByOption)
            {
                sqlSelect = "SELECT commision_rate FROM products WHERE p_id=@0";
                var product = db.QuerySingle(sqlSelect, p_id);
                try { item_commission = orderItem.quan * product.commision_rate; } catch { }
            }
            else
            {
                sqlSelect = "SELECT * FROM productpricingoptions WHERE serial=@0";
                var priceOption = db.QuerySingle(sqlSelect, orderItem.QuanOptionId);
                if (priceOption != null)
                {
                    int quan = orderItem.quan;
                    int AdditionalsOverOptionQuan = 0;
                    if (quan > priceOption.quan)
                    {
                        AdditionalsOverOptionQuan = quan - priceOption.quan;
                    }

                    try { item_commission = priceOption.optionCommision + (AdditionalsOverOptionQuan * priceOption.AdditionalUnitCommision); } catch { }
                }
            }
        }

        db.Close();

