        string existing_ship_address = ""; try { existing_ship_address = order.ship_address; } catch { }
        string existing_ship_city = ""; try { existing_ship_city = order.ship_city; } catch { }

        string existing_packing_notes = ""; try { existing_packing_notes = order.packing_notes; } catch { }
        string existing_ship_notes = ""; try { existing_ship_notes = order.ship_notes; } catch { }
        string existing_order_notes = ""; try { existing_order_notes = order.order_notes; } catch { }
        bool is_changing_delivery_method = false;
        bool critical_order_change = false;
        string critical_order_change_note = "";
        bool is_mark_address_default = false; if (!Request["is_mark_address_default"].IsEmpty()) { is_mark_address_default = true; }
        DateTime delivery_window_start = local_time;
        DateTime delivery_window_end = local_time;
        if (requested_delivery_date_non_update == 1)
        {
            requested_delivery_date = order.requested_delivery_date;
            shipping_time = order.shipping_time;
            requested_delivery_window_start_hour = order.requested_delivery_window_start_hour;
            requested_delivery_window_end_hour = order.requested_delivery_window_end_hour;
        }

        string tmpdate = requested_delivery_date.Date.ToShortDateString() + " " + requested_delivery_window_start_hour;
        DateTime tmp_date = Convert.ToDateTime(tmpdate);
        requested_delivery_date = tmp_date;
        try { delivery_window_start = Convert.ToDateTime(requested_delivery_date.ToShortDateString() + " " + requested_delivery_window_start_hour); } catch { }
        try { delivery_window_end = Convert.ToDateTime(requested_delivery_date.ToShortDateString() + " " + requested_delivery_window_end_hour); } catch { }

        if (requested_delivery_date.Date > local_time.Date)
        {
            is_postponed = true;
        }

        if (existing_order_type != order_type)
        {
            is_changing_delivery_method = true;
            critical_order_change = true;
            critical_order_change_note += "אופן המשלוח השתנה מ " + existing_order_type + " ל " + order_type + " <br>";
        }

        if (detected_area_id > 0) { area_id = detected_area_id; }
        if (selected_area_id > 0) { area_id = selected_area_id; }

        if (new_ship_phone == "") {new_ship_phone = ship_phone;}
        new_ship_phone = AppFunctions.wanumize(new_ship_phone);
        if (new_ship_phone == "" || !AppFunctions.IsValidPhone(new_ship_phone))
        {
            theHtmlOutput = theHtmlOutput + "טלפון למשלוח הוא שדה חובה!<br>";
        }
        if (ship_reciepient.IsEmpty())
        {
            theHtmlOutput = theHtmlOutput + "מקבל המשלוח הוא שדה חובה!<br>";
        }

        if (delivery_window_end < local_time && requested_delivery_date_non_update==0)
        {
            theHtmlOutput = theHtmlOutput + "חובה להזין תאריך מבוקש למשלוח עתידי!<br>";
        }


        if (delivery_window_start > delivery_window_end )
        {
            theHtmlOutput = theHtmlOutput + "נא להזין שעות חלון לאספקת ההזמנה באופן תקין!<br>";
        }



        switch (order_type)
        {
            case "PICKUP":
                if (true)
                {
                    is_pickup = true;

                    string pu_eta_str = "";
                    pu_eta = local_time;
                    if (pu_eta_selector == 1)
                    {
                        pu_eta_str = pu_eta.ToShortDateString() + " " + pu_eta_time;
                        try { pu_eta = Convert.ToDateTime(pu_eta_str); } catch { }

                        if (pu_eta <= local_time)
                        {
                            theHtmlOutput = theHtmlOutput + "חובה להזין זמן תקין להגעה לאיסוף!<br>";
                        }

                    }
                    else
                    {
                        pu_eta = pu_eta.AddMinutes(pu_eta_min);
                        if (pu_eta < existing_pu_eta)
                        {
                            critical_order_change = true;
                            critical_order_change_note += "זמן הגעה הוקדם!<br>";
                        }
                    }
                }
                break;


            case "EXPRESS":
            case "ROUND":
                if (true)
                {
                    int eta_min = 0;

                    if (saved_address_id == 0 || saved_address_id == -1)
                    {
                        if (ship_address.IsEmpty())
                        {
                            theHtmlOutput = theHtmlOutput + "כתובת למשלוח הוא שדה חובה!<br>";
                        }
                        if (ship_city.IsEmpty())
                        {
                            theHtmlOutput = theHtmlOutput + "עיר למשלוח הוא שדה חובה!<br>";
                        }


                        try { detected_area_id = Rounds.GetAreaIdForCity(ship_city); } catch { }

                        if (detected_area_id > 0)
                        {
                            is_area_detected = true;
                        }
                        else
                        {
                            try { selected_area_id = Convert.ToInt32(Request["selected_area_id"]); } catch { }
                            if (selected_area_id <= 0)
                            {
                                theHtmlOutput = "$!$חובה לבחור איזור למשלוח!";
                            }
                            else
                            {
                                is_area_selected = true;
                            }
                        }

                        if (detected_area_id > 0) { order_area_id = detected_area_id; }
                        if (selected_area_id > 0)
                        {
                            order_area_id = selected_area_id;
                            sqlSelect = "INSERT INTO CitiesInAreas(area_id,city) VALUES (@0,@1)";
                            db.Execute(sqlSelect, order_area_id, ship_city);
                        }





                    }
                    else
                    {
                        sqlSelect = "SELECT * FROM Addresses where id=@0 ";
                        var savedAddress = db.QuerySingle(sqlSelect, saved_address_id);
                        if (savedAddress != null)
                        {
                            ship_city = savedAddress.city;
                            ship_address = savedAddress.address;
                            order_area_id = savedAddress.area_id;
                        }
                        else
                        {
                            theHtmlOutput = theHtmlOutput + "הכתובת השמורה לא נמצאה!<br>";
                        }
                    }
                    if (is_save_address)
                    {
                        if (address_nick.IsEmpty())
                        {
                            address_nick = ship_address;
                        }

                        sqlSelect = "SELECT id FROM Addresses WHERE address_nick=@0 AND member_id=@1 AND is_active=1";
                        var dupChk = db.QuerySingle(sqlSelect, address_nick, member_id);
                        if (dupChk != null)
                        {
                            theHtmlOutput = theHtmlOutput + "כינוי הכתובת כבר שמור במערכת!<br>";
                        }

                    }

                    if (ship_city != existing_ship_city)
                    {
                        critical_order_change = true;
                        critical_order_change_note += "עיר למשלוח השתנתה!<br>";
                    }
                    if (ship_address != existing_ship_address)
                    {
                        critical_order_change = true;
                        critical_order_change_note += "כתובת למשלוח השתנתה!<br>";
                    }


                }
                break;

        }

        // theHtmlOutput += requested_delivery_window_start_hour + "<BR>" + requested_delivery_window_end_hour + "<BR>" + delivery_window_start.ToString() + "<BR>" + delivery_window_end.ToString();


        if (order_type == "ROUND")
        {
            is_route = true;

        }
        if (order_type == "EXPRESS")
        {
            is_express = true;

        }


        if (theHtmlOutput == "")
        {

            if (order_notes != existing_order_notes)
            {
                critical_order_change = true;
                critical_order_change_note += "ההערות להזמנה התעדכנו!<br>";
            }
            if (ship_notes != existing_ship_notes)
            {
                critical_order_change = true;
                critical_order_change_note += "ההערות לשליח התעדכנו!<br>";
            }
            if (packing_notes != existing_packing_notes)
            {
                critical_order_change = true;
                critical_order_change_note += "ההערות לאריזה התעדכנו!<br>";
            }

            if (is_save_address)
            {
                if (is_mark_address_default)
                {
                    sqlSelect = "UPDATE addresses SET is_default=0 WHERE member_id=@0";
                    db.Execute(sqlSelect, member_id);
                }

                sqlSelect = "INSERT INTO addresses(address,city,member_id,area_id,address_nick,address_notes,is_active,is_default) VALUES(@0,@1,@2,@3,@4,@5,1,@6)";
                db.Execute(sqlSelect, ship_address, ship_city, member_id, area_id, address_nick, address_notes, is_mark_address_default);

                sqlSelect = "SELECT id FROM addresses WHERE address_nick=@0 AND member_id=@1 ";
                var new_saved_address = db.QuerySingle(sqlSelect, address_nick, member_id);
                try { saved_address_id = new_saved_address.id; } catch { }

            }



            sqlSelect = "UPDATE mainOrders SET ship_reciepient=@0,ship_phone=@1,ship_address=@2,ship_city=@3,order_notes=@4,ship_notes=@5,packing_notes=@6,saved_address_id=@7,area_id=@8,is_express=@9,is_route=@10,is_pickup=@11,order_type=@12,pu_eta=@13,requested_delivery_date=@14,shipping_time=@15,requested_delivery_window_start_hour=@16,requested_delivery_window_end_hour=@17,is_postponed=@18 WHERE order_id=@19";
            db.Execute(sqlSelect, ship_reciepient, new_ship_phone, ship_address, ship_city, order_notes, ship_notes, packing_notes, saved_address_id, area_id, is_express, is_route, is_pickup, order_type, pu_eta,   requested_delivery_date,shipping_time, requested_delivery_window_start_hour, requested_delivery_window_end_hour,is_postponed, order_id);

            if (requested_delivery_date.Date != order.requested_delivery_date.Date) //delivery date changed
            {
                if (is_postponed != order.is_postponed || (is_postponed && order.is_postponed))
                {

                    sqlSelect = "UPDATE mainorders SET delivery_id=0,route_id=0,stop_id=0,driver_id=0,envelope_id=0 WHERE order_id=@0";
                    db.Execute(sqlSelect, order.order_id);

                    logMsg = "התאריך המבוקש לביצוע ההזמנה נקבע ל" + requested_delivery_date.ToShortDateString() + " " + delivery_window_start.ToString("HH:mm") + " - " + delivery_window_end.ToString("HH:mm");
                    AppFunctions.WriteOrderComment(order_id, logMsg);
                }
            }


            if (selected_area_id > 0)
            {
                AppFunctions.LinkCityToArea(selected_area_id, ship_city);
            }

            /*
            if (critical_order_change)
            {
                sqlSelect = "UPDATE MainOrders SET critical_order_change=@0,critical_order_change_note=@1,critical_order_change_ts=@2,critical_order_change_by=@3 WHERE order_id=@4";
                db.Execute(sqlSelect, critical_order_change, critical_order_change_note, local_time, rep_id, order_id);

            }

            if (critical_order_change_note != "")
            {
                AppFunctions.WriteOrderComment(order_id, critical_order_change_note);
            }
            */

            Rounds.reCalcDeliveryStatistics(round_id);

            theHtmlOutput = "ההזמנה התעדכנה בהצלחה!";
        }
        else
        {
            theHtmlOutput = "!$!" + theHtmlOutput;
        }

        db.Close();
        return theHtmlOutput;
    }

    public static decimal GetOrderPickupAmount(int order_id)
    {
        decimal pickup_amount = 0;
        var u_id = WebSecurity.CurrentUserId;
        var db = Database.Open("op_data");

        var sqlSelect = "SELECT after_roundup_total FROM MainOrders WHERE order_id=@0";
        var Order = db.QuerySingle(sqlSelect, order_id);
        try { pickup_amount = Order.after_roundup_total; } catch { }

        db.Close();
        return pickup_amount;
    }

}