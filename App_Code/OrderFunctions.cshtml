@functions {
    public static decimal calcDiscountAmount(decimal discount_percantage, bool does_discount_includes_sh, bool does_discount_includes_spItems, decimal DiscountableItemsSubTotal, decimal DiscountableSpOffersSubTotal, decimal shipping_charge, decimal VouchersTotal = 0)
    {
        decimal discount_total = 0;
        if (discount_percantage > 0)
        {
            if (does_discount_includes_sh)
            {
                if (does_discount_includes_spItems)
                {
                    discount_total = ((DiscountableItemsSubTotal + DiscountableSpOffersSubTotal + shipping_charge - VouchersTotal) * (discount_percantage / 100));
                }
                else
                {
                    discount_total = ((DiscountableItemsSubTotal + shipping_charge - VouchersTotal) * (discount_percantage / 100));
                }
            }
            else
            {
                if (does_discount_includes_spItems)
                {
                    discount_total = ((DiscountableItemsSubTotal + DiscountableSpOffersSubTotal - VouchersTotal) * (discount_percantage / 100));
                }
                else
                {
                    discount_total = ((DiscountableItemsSubTotal - VouchersTotal) * (discount_percantage / 100));
                }
            }
        }


        return discount_total;
    }
