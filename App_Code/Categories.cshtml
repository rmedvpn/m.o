    </div>
    <div style="overflow: auto; font-size: 18px; color: #000; display: none; border: 1px dashed #000; text-align: center; direction: rtl" id="cat_edit_@cat_id">
        <form id="EditCat_@cat_id">

            <div style="overflow: auto;font-weight: bold;font-size: 16px">
                עריכת פרטים לקטגוריה @title
            </div>
            <div style="overflow: auto;">
                <input type="text" style="font-size: 16px;padding: 5px;margin: 2px;width: 90%" placeholder="שם הקטגוריה" name="cat_title" id="cat_title_@cat_id" value="@title">
                <input type="text" style="font-size: 16px;padding: 5px;margin: 2px;width: 90%" placeholder="Title" name="cat_e_title" id="cat_e_title_@cat_id" value="@e_title">
            </div>

            @if (SubCatType != "SPOFFER")
            {<div class="B" style="text-align:right">
                    ברירות מחדל
                </div>
                <div class="B">
                    <div class="B" style="float:right;width:45%;">
                        סוג מוצר
                        <select class="A" name="productType" id="productType">
                            <option>ללא</option>
                            @foreach (var pt in productTypes)
                            {
                                <option value="@pt.id" selected="@(pt.id == def_product_type)">@pt.title</option>
                            }
                        </select>
                    </div>
                    <div class="B" style="float: right; width: 45%;">
                        יחידת מידה
                        <select class="A" name="ItemUnitType" id="ItemUnitType">
                            <option>ללא</option>
                            @foreach (var item in ItemUnitTypes)
