            <div style="overflow: auto;text-align: center;padding: 5px;">
                <button type="button" style="padding: 5px;margin: 5px;font-size: 12px;border: 0;background-color: #000;color: #fff;font-weight: bold" onclick="hideElement('cat_edit_@cat_id');showElement('cat_info_@cat_id');">ביטול</button>
                <button type="button" style="padding: 5px;margin: 5px;font-size: 12px;border: 0;background-color: #57d600;color: #fff;font-weight: bold" onclick="AjaxActions('UpdateCatInfo', @cat_id,'MainLoader', 'EditCat_@cat_id');">שמירת שינוים</button>

                <button type="button" style="padding: 5px;margin: 5px;font-size: 12px;border: 0;background-color: #f00;color: #fff;font-weight: bold" onclick="AjaxActions('DeleteCat', @cat_id,'MainLoader','@is_maincat');">מחיקת קטגוריה</button>
            </div>
        </form>
    </div>
}

@helper SubCatList(int main_cat_id, string SubCatType = "")
{
    int cat_id = 0;
    string title = "";
    string e_title = "";
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string emptyTxt = "";
    switch (SubCatType)
    {
        case "SUBCAT":
            sqlSelect = "SELECT * FROM categories WHERE is_subcat=1 AND mainCat_id=@0 ORDER BY sort_order";
            emptyTxt = "אין תתי קטגוריה";
            break;
        case "SPOFFER":
            sqlSelect = "SELECT * FROM categories WHERE is_spOffersCat=1 AND mainCat_id=@0 ORDER BY sort_order";
            emptyTxt = "אין קטגוריות מבצעים";
            break;
        case "TAG":
            sqlSelect = "SELECT * FROM categories WHERE is_tag=1 AND mainCat_id=@0 ORDER BY sort_order";
            emptyTxt = "אין תגיות";
            break;
    }

    var catList = db.Query(sqlSelect, main_cat_id);
    if (catList.Count() > 0)
    {
        <div>
            @foreach (var Category in catList)
            {
                <div style="; direction: rtl" id="catDiv_@Category.id">@Categories.CatEditRow(Category.id, SubCatType)</div>
            }

        </div>
    }
    else
    {
        <div style="overflow: auto;font-size: 14px;color: #ff6a00;">@emptyTxt</div>
    }


}

