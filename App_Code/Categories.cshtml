@functions {
    public static string AddCategoryPricingOption()
    {
        int rep_id = WebSecurity.CurrentUserId;
        if (rep_id <= 0) return "!$!יש להתחבר למערכת";

        int cat_id = 0; int.TryParse(Request["value"], out cat_id);
        int round_id = 0; int.TryParse(Request["menu_id"], out round_id);
        int optionQuan = 0; int.TryParse(Request["optionQuan"], out optionQuan);
        decimal optionPrice = -1; decimal.TryParse(Request["optionPrice"], System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.GetCultureInfo("he-IL"), out optionPrice);

        bool is_activated = true;
        bool is_fav = false;

        if (cat_id <= 0) return "!$!מזהה קטגוריה לא תקין";
        if (optionQuan <= 0) return "!$!חובה להזין כמות תקינה";
        if (Request["optionPrice"].IsEmpty() || optionPrice < 0) return "!$!חובה להזין מחיר תקין";

        var db = Database.Open("op_data");

        try
        {
            var category = db.QuerySingle("SELECT id,def_itemunit_type,is_cat_pricing,is_active,is_deleted,is_spOffersCat,is_maincat,is_subcat FROM Categories WHERE id=@0", cat_id);

            if (category == null) return "!$!הקטגוריה לא נמצאה";
            if (Convert.ToInt32(category.def_itemunit_type ?? 0) <= 0) return "!$!יש להגדיר יחידת מידה לקטגוריה לפני יצירת מחירון";
            if (category.is_active != true || category.is_deleted == true || category.is_spOffersCat == true) return "!$!הקטגוריה אינה זמינה לתמחור";
            if (category.is_maincat != true && category.is_subcat != true) return "!$!סוג הקטגוריה אינו מתאים לתמחור";

            var existing = db.QuerySingle("SELECT serial FROM ProductPricingOptions WHERE cat_id=@0 AND ISNULL(p_id,0)=0 AND round_id=@1 AND quan=@2 AND ISNULL(is_deleted,0)=0", cat_id, round_id, optionQuan);
            if (existing != null) return "!$!כבר קיימת אפשרות מחירון לכמות זו בקטגוריה";

            db.Execute("INSERT INTO ProductPricingOptions(p_id,cat_id,round_id,price,quan,ts,created_by,is_activated,is_spOffer,is_fav,is_deleted,is_update,last_update_ts) VALUES (0,@0,@1,@2,@3,@4,@5,@6,0,@7,0,1,SYSUTCDATETIME())", cat_id, round_id, optionPrice, optionQuan, AppFunctions.LocalTime(), rep_id, is_activated, is_fav);
            string json = AppJson.CreateCategoryPricingOptionsJson(cat_id, true);

            return "👌 אפשרות המחירון נוספה לקטגוריה!";
        }
        catch (Exception ex)
        {
            return "!$!שגיאה בהוספת אפשרות מחירון: " + ex.Message;
        }
        finally
        {
            db.Close();
        }
    }

    public static string UpdateCategoryPricingOption()
    {
        int rep_id = WebSecurity.CurrentUserId;
        if (rep_id <= 0) return "!$!יש להתחבר למערכת";

        int cat_id = 0; int.TryParse(Request["value"], out cat_id);
        int optionSerial = 0; int.TryParse(Request["optionSerial"], out optionSerial);
        decimal optionPrice = -1; decimal.TryParse(Request["optionPrice"], System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.GetCultureInfo("he-IL"), out optionPrice);

        bool is_activated = true;
        bool is_fav = false;

        if (cat_id <= 0 || optionSerial <= 0) return "!$!נתוני מחירון לא תקינים";
        if (Request["optionPrice"].IsEmpty() || optionPrice < 0) return "!$!חובה להזין מחיר תקין";

        var db = Database.Open("op_data");

        try
        {
            var option = db.QuerySingle("SELECT serial FROM ProductPricingOptions WHERE serial=@0 AND cat_id=@1 AND ISNULL(p_id,0)=0 AND ISNULL(is_deleted,0)=0", optionSerial, cat_id);
            if (option == null) return "!$!אפשרות המחירון לא נמצאה";

            db.Execute("UPDATE ProductPricingOptions SET price=@0,is_activated=@1,is_fav=@2,is_spOffer=0,is_update=1,last_update_ts=SYSUTCDATETIME() WHERE serial=@3 AND cat_id=@4 AND ISNULL(p_id,0)=0 AND ISNULL(is_deleted,0)=0", optionPrice, is_activated, is_fav, optionSerial, cat_id);
            string json = AppJson.CreateCategoryPricingOptionsJson(cat_id,  true);

            return "👌 אפשרות המחירון התעדכנה!";
        }
        catch (Exception ex)
        {
            return "!$!שגיאה בעדכון אפשרות מחירון: " + ex.Message;
        }
        finally
        {
            db.Close();
        }
    }

    public static string DeleteCategoryPriceOption()
    {
        int u_id = WebSecurity.CurrentUserId;
        if (u_id <= 0) return "!$!יש להתחבר למערכת";

        int pricingOptionId = 0; try { pricingOptionId = Convert.ToInt32(Request["value"]); } catch { }
        int cat_id = 0; try { cat_id = Convert.ToInt32(Request["param1"]); } catch { }

        if (pricingOptionId <= 0 || cat_id <= 0) return "!$!נתוני מחירון לא תקינים";

        var db = Database.Open("op_data");

        try
        {
            string sqlSelect = "DELETE FROM ProductPricingOptions WHERE serial=@0 AND cat_id=@1 AND ISNULL(p_id,0)=0";
            int affected = db.Execute(sqlSelect, pricingOptionId, cat_id);

            if (affected == 0) return "!$!אפשרות המחירון לא נמצאה";

            string json = AppJson.CreateCategoryPricingOptionsJson(cat_id,  true);

            return " 👌 אפשרות המחירון של הקטגוריה נמחקה ";
        }
        catch (Exception ex)
        {
            return "!$!שגיאה במחיקת אפשרות המחירון: " + ex.Message;
        }
        finally
        {
            db.Close();
        }
    }
    public static string ToggleCategoryPricingActivation()
    {
        int u_id = WebSecurity.CurrentUserId;
        if (u_id <= 0) return "!$!יש להתחבר למערכת";

        int cat_id = 0; try { cat_id = Convert.ToInt32(Request["value"]); } catch { }
        if (cat_id <= 0) return "!$!לא נמצאה קטגוריה";
        bool is_cat_pricing = false; try { is_cat_pricing = Convert.ToBoolean(Request["param1"]); } catch { }

        var db = Database.Open("op_data");

        try
        {
            string sqlSelect = "UPDATE categories SET is_cat_pricing=@0 WHERE id=@1";
            int affected = db.Execute(sqlSelect, is_cat_pricing, cat_id);
            string json = AppJson.CreateCategoryPricingOptionsJson(cat_id,  true);
            if (is_cat_pricing)            return " 👌 מחירון הקטגוריה הופעל! ";
            else           return " 👌 מחירון הקטגוריה לא יהיה פעיל! ";
        }
        catch (Exception ex)
        {
            return "!$!שגיאה בהפעלת המחירון: " + ex.Message;
        }
        finally
        {
            db.Close();
        }

    }

    public static void CalcCatProdLowestCost(int cat_id)
    {
        var db = Database.Open("op_data");

        try
        {
            string sqlSelect = "SELECT MIN(CAST(price AS DECIMAL(18,4))/NULLIF(quan,0)) FROM ProductPricingOptions WHERE cat_id=@0 AND ISNULL(p_id,0)=0 AND round_id=0 AND is_activated=1 AND ISNULL(is_deleted,0)=0";
            decimal curLowestUnitPrice = Math.Round(Convert.ToDecimal(db.QueryValue(sqlSelect, cat_id) ?? 0), 2);

            sqlSelect = "UPDATE Products SET curLowestUnitPrice=@0 WHERE pricing_source IN (1,2) AND pricing_cat_id=@1";
            db.Execute(sqlSelect, curLowestUnitPrice, cat_id);

            sqlSelect = "UPDATE roundMenuItems SET curLowestUnitPrice=@0 WHERE pricing_source IN (1,2) AND pricing_cat_id=@1";
            db.Execute(sqlSelect, curLowestUnitPrice, cat_id);
        }
        finally
        {
            db.Close();
        }
    }

}
