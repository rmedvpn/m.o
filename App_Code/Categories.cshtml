        {
            <button type="button" style="float: right; padding: 1px; margin: 1px; font-size: 14px; border: 0;  background: transparent;" onclick="    AjaxActions('CatChangeOrder', '@cat_id','MainLoader',@maincat_id,'up','@SubCatType');">⬆️</button>
