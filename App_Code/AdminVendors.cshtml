    public static string vendorAddTeamMember()
    {
        System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
        int u_id =WebSecurity.CurrentUserId;

        string theHtmlOutput = "";
        DateTime local_time = AppFunctions.LocalTime();
        var db = Database.Open("op_data");
        var sqlSelect = "";

        int vendor_id = 0; try { vendor_id = Convert.ToInt32(Request["value"]); } catch { }
        string userNameToAdd = Request["UserName"];
        string wanum = Request["wanum"];
        if (userNameToAdd.IsEmpty())
        {
            theHtmlOutput = theHtmlOutput + "חובה להזין שם משתמש!<br>";
        }
        else
        {
            if (WebSecurity.UserExists(userNameToAdd))
            {
                theHtmlOutput = theHtmlOutput + "שם המשתמש קיים כבר!<br>";
            }
        }

        if (wanum.IsEmpty())
        {
            theHtmlOutput = theHtmlOutput + "חובה להזין מספר ווטסאפ!<br>";
        }
        else
        {
            try { wanum = AppFunctions.wanumize(wanum); } catch { }
            if (!ValidationFunctions.IsValidWanum(wanum))
            {
                theHtmlOutput = theHtmlOutput + "חובה להזין מספר ווטסאפ תקין!<br>";
            }
            else
            {
                sqlSelect = "SELECT userid FROM members WHERE wanum=@0";
                var existingUser = db.QuerySingle(sqlSelect, wanum);
