@helper VendorTeamSettings(int vendor_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * from TeamMembersInRounds WHERE round_id=0 AND vendor_id=@0 AND permission_id=0";
    var VendorTeam = db.Query(sqlSelect, vendor_id);
    sqlSelect = "SELECT * from AppPermissionCodes WHERE permission_group='MAIN'";
    var VendorPermissions = db.Query(sqlSelect);
    sqlSelect = "SELECT userId,username from members WHERE (is_vendor_rep=1 AND work_for_vendor_id=@0)";
    foreach (var vt in VendorTeam)
    {
        sqlSelect = sqlSelect + " AND userid<>" + vt.u_id + " ";
    }
    var VendorProspects = db.Query(sqlSelect, vendor_id);


    <div style="margin: 5px;padding: 5px;overflow: auto;">
        <button style="float: left;padding: 2px;margin: 2px;font-size: 16px;background-color: #000;color: white" onclick="Accordionize('AddTeamMemberAcc');"> + הוספה</button>
        <h2>צוות </h2>
    </div>
    <div style=";overflow: auto;">
        <button style="display: none" class="Accordion" id="AddTeamMemberAcc"></button>
        <div class="panel" style="padding: 0;margin: 0">
            <div style="overflow: auto;" id="TeamAddContainer">
                <h2>נא לבחור משתמש/ת מהרשימה</h2>
                @foreach (var prospect in VendorProspects)
                {
                    <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;border-bottom: 1px dotted #e3e3e3">
                        <b>@prospect.username</b>
                        <button style="float: left;padding: 2px;margin: 2px;font-size: 14px" onclick="AjaxActions('vendorLinkTeamMember', @vendor_id,'MainLoader',@prospect.userid);">בחירה</button>
                        <button style="float: right;padding: 2px;margin: 2px;font-size: 14px;color: #f00" onclick="AjaxActions('vendorUnLinkTeamMember', @vendor_id,'MainLoader',@prospect.userid);">מחיקה</button>

                    </div>

                }
                <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: blue;border-bottom: 1px dotted #e3e3e3">
                    <form id="vendorAddTeamMember">
                        יצירת משתמש חדש
                        <button type="button" style="float: left;padding: 2px;margin: 2px;font-size: 14px" onclick="showElement('addNewTeamMember');FixAccordion('AddTeamMemberAcc');">חדש</button>
                        <div style="overflow: auto;display: none;padding: 5px;margin: 5px;text-align: center;" id="addNewTeamMember">
                            <div style="overflow: auto;">
                                <input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;" id="UserName" name="UserName" placeholder="UserName">
                                <input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;" id="wanum" name="wanum" placeholder="#WhatsApp">
                            </div>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;" onclick="document.getElementById('vendorAddTeamMember').reset();hideElement('addNewTeamMember');Accordionize('AddTeamMemberAcc');">ביטול</button>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;" onclick="AjaxActions('vendorAddTeamMember', @vendor_id,'MainLoader','vendorAddTeamMember');">הוספה</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <form id="vendorTeamPermissions">
        @foreach (var item in VendorTeam)
        {
            bool ca_is_driver = false; try { ca_is_driver = item.is_driver; } catch { }
            bool ca_is_packing = false; try { ca_is_packing = item.is_packing; } catch { }
            bool ca_is_admin = false; try { ca_is_admin = item.is_admin; } catch { }

            string teamMemberName = "";
            teamMemberName = AppFunctions.GetRepName(item.u_id);

            if (!teamMemberName.IsEmpty())
            {
                <div style="overflow: auto;text-align: right;font-size: 12px;">
                    <div style="padding: 5px;margin: 5px;overflow: auto;border-bottom: 1px solid #000;">
                        <div style="padding: 5px;margin: 5px;font-size: 16px;overflow: auto">
                            <button style="float: left;padding: 2px;margin: 2px;color: #f00;background: transparent;" type="button" id="is_remove_@item.u_id" name="is_remove_@item.u_id" onclick="AjaxActions('vendorRemoveTeamMember', @vendor_id,'MainLoader',@item.u_id);">הסרה</button>
                            <b>@teamMemberName</b>
                        </div>
                        <div style="overflow: auto;">

                            @foreach (var p in VendorPermissions)
                            {
                                var fld_name = p.code + "_" + item.u_id;
                                bool is_permission = false;
                                is_permission = AdminVendors.isPermission(vendor_id, item.u_id, p.id);
                                <div style="float: right;padding: 5px;margin: 5px;font-size: 16px;"><input type="checkbox" style=";padding: 5px;margin: 5px;" id="@fld_name" name="@fld_name" @if (is_permission) { <TEXT> checked</TEXT>} onclick="AjaxActions('SetVendorTeamPermissions', @vendor_id,'MainLoader', '@p.code',@item.u_id, this.checked,@p.id);">@p.title</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        <div style="overflow: auto;height: 100px;">
            &nbsp;
        </div>
    </form>

    db.Close();
}

@helper VendorProductsSettings(int vendor_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * from products WHERE v_id=@0 ORDER BY p_id";
    var products = db.Query(sqlSelect, vendor_id);
    <div style="margin: 5px;padding: 5px;overflow: auto;">
        <h2>מוצרים </h2>
        <div style="text-align: right;font-size: 20px;padding: 5px;margin: 5px;overflow: auto;background-color: #fff;color: #000;font-size: 18px;-webkit-overflow-scrolling: touch;margin-bottom: 30px;">
            @foreach (var item in products)
            {
                int prod_inventory = 0;
                sqlSelect = "SELECT SUM(inventory.quan) AS totQuan FROM inventory INNER JOIN products ON products.P_id=inventory.p_id WHERE inventory.v_id=@0 AND inventory.p_id=@1";
                var prod_inv = db.QuerySingle(sqlSelect, vendor_id, item.p_id);
                if (prod_inv != null)
                {
                    try { prod_inventory = prod_inv.totQuan; } catch { }
                }
                <div style="font-size: 18px;overflow: auto;padding: 2px;margin: 2px;text-align: right;border-bottom: 2px dashed #e3e3e3;">
                    <img style="width:40px;height:40px;float: right;margin: 5px;padding: 5px;" src="imgViewer?size=tn&p_id=@item.p_id&id=0" alt="@item.title">
                    <div style="padding: 2px;margin: 2px;float: right;">
                        @item.title <br>
                        <small>@prod_inventory @item.itemunit במלאי</small>
                    </div>
                </div>


            }

        </div>
    </div>

    db.Close();
}

