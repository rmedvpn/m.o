                            trans_title = cur_ent_name + " (" + cur_ent_type + ") קיבל/ה מ" + InventoryFunctions.GetEntityName(ent.source_entity) + " (" + InventoryFunctions.GetEntityTypeByCode(InventoryFunctions.GetEntityType(ent.source_entity)) + ")";
