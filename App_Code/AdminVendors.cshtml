@helper VendorEntitiesSettings(int v_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * from inv_Entities WHERE is_active=1 ORDER BY entity_type";
    var entities = db.Query(sqlSelect);
    sqlSelect = "SELECT * from inv_entity_type WHERE is_system=0";
    var entity_types = db.Query(sqlSelect);
    int prod_inventory = 0;
    sqlSelect = "SELECT * from inv_Entities WHERE is_deleted=0 AND v_id=@0 AND is_active=1";
    var VendorEntities = db.Query(sqlSelect, v_id);
    sqlSelect = "SELECT * from inv_Entities WHERE  is_deleted=0 AND v_id=@0 AND is_active=0";
    var inactiveEntities = db.Query(sqlSelect, v_id);
    <div style="overflow: auto">
        <div style="overflow: auto;font-size: 20px;padding: 5px;">
            <B>ניהול ישויות מלאי</B>
            <button style="float: left;padding: 5px;font-size: 16px;color: white;border-radius: 5px;background-color: #000" onclick="Accordionize('AccAddEntity');">הוספה</button>

        </div>
        <div style="overflow: auto">
            <form id="AddEntityForm">
                <button style="display: none" id="AccAddEntity" class="Accordion"></button>
                <div class="panel" style="padding: 0;margin: 0;">
                    <div style="overflow: auto;">
                        <div style="overflow: auto;">
                            <div style="overflow: auto;font-size: 12px;color: #000;font-weight: bold">
                                שם ישות<br><input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%" name="ent_name">
                            </div>
                            <div style="overflow: auto;font-size: 12px;color: #000;font-weight: bold">
                                סוג ישות<br>
                                <select style="padding: 5px;margin: 5px;font-size: 16px;width: 90%" name="ent_type">
                                    <option value="0">נא לבחור סוג ישות</option>
                                    @foreach (var entType in entity_types)
                                    {
                                        <option value="@entType.serial">@entType.entity_title</option>
                                    }
                                </select>
                            </div>
                            <div style="overflow: auto;font-size: 12px;color: #000;font-weight: bold">
                                הערות<br><textarea style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;resize: none" rows="2" name="ent_notes"></textarea>

                            </div>
                        </div>
                        <div style="overflow: auto;text-align: center">
                            <button type="button" style="float: right;padding: 5px;margin: 5px;font-size: 16px;color: white;border-radius: 5px;background-color: #f00" onclick="Accordionize('AccAddEntity');">ביטול</button>
                            <button type="button" style="float: left;padding: 5px;margin: 5px;font-size: 16px;color: white;border-radius: 5px;background-color: #57d600" onclick="AdminAjaxAction('AddInvEntity', @v_id,'AddEntityForm');">הוספה</button>

                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
    if (VendorEntities.Count() > 0)
    {
        <div style="background-color: #fff;padding: 5px;">
            <h2>ישויות מלאי פעילות</h2>
            @foreach (var ent in VendorEntities)
            {
                decimal inventoryValue = 0;

                sqlSelect = "SELECT SUM(quan*unitcost) AS inventoryValue from inv_transactions WHERE entity_id=@0 AND v_id=@1 ";
                var entity_items = db.QuerySingle(sqlSelect, ent.serial, v_id);
                try { inventoryValue = entity_items.inventoryValue; } catch { }

                <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;border-bottom: 1px solid #e3e3e3">
                    <div style="overflow: auto;">
                        @if (ent.is_active)
                        {
                            <input type="checkbox" style="padding: 5px;margin: 5px;width: 15px;height: 15px;float: right" checked onclick="if(this.checked){AdminAjaxAction('ActivateInventoryEntity', @v_id,@ent.serial);}else{AdminAjaxAction('DeActivateInventoryEntity', @v_id,@ent.serial);}">
                        }
                        else
                        {
                            <input type="checkbox" style="padding: 5px;margin: 5px;width: 15px;height: 15px;float: right" onclick="if(this.checked){AdminAjaxAction('ActivateInventoryEntity', @v_id,@ent.serial);}else{AdminAjaxAction('DeActivateInventoryEntity', @v_id,@ent.serial);}">
                        }

                        <span style="color: #000;float: right">

                            <b>@ent.entity_name</b> <span style="font-size: 12px"><br>@InventoryFunctions.GetEntityTypeByCode(InventoryFunctions.GetEntityType(ent.serial))</span>
                        </span>
                        <span style="float: left">
                            @if (inventoryValue > 0)
                            {
                                <span style="float: left;padding: 3px;font-size: 12px;color: white;border-radius: 5px;background-color: #57d600;">שווי מלאי @inventoryValue.ToString("C", culture)</span><br>
                            }
                            else
                            {
                                <span style="float: left;padding: 3px;font-size: 12px;color: #808080;border-radius: 5px;background-color: #e3e3e3;">שווי מלאי @inventoryValue.ToString("C", culture)</span><br>
                            }


                            <button style="float: left;padding: 3px;font-size: 12px;color: white;border-radius: 5px;background-color: #000;display: none">מחיקה</button>

                        </span>
                    </div>

