                    @if (ent.notes != "")
                    {
                        <div style="font-size: 14px;color: #000;overflow: auto;clear: both;display: none;padding: 2px;background-color: #ddd" id="notes_@ent.serial">@ent.notes</div>
                    }


                </div>
            </div>


        }
    </div>
    <div style="overflow: auto;height: 200px">&nbsp;</div>

    db.Close();
}


