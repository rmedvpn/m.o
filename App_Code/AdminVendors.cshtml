@helper VendorSummary(int vendor_id, string summaryOf = "")
{

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM vendors WHERE vendor_id=@0 ";
    var vendor = db.QuerySingle(sqlSelect, vendor_id);
    sqlSelect = "SELECT * from products WHERE v_id=@0 ORDER BY p_id";
    var products = db.Query(sqlSelect, vendor.vendor_id);
    sqlSelect = "SELECT * from rounds WHERE is_active=1 AND vendor_id=@0 ORDER BY round_type";
    var rounds = db.Query(sqlSelect, vendor.vendor_id);

    sqlSelect = "SELECT inventory.*,products.title,products.itemunit FROM inventory INNER JOIN products ON products.P_id=inventory.p_id WHERE inventory.v_id=@0";
    var inventory = db.Query(sqlSelect, vendor_id);

    string vendor_name = "";
    string vendor_name_e = "";
    string vendor_desc_e = "";
    string vendor_desc = "";
    int admin_u_id = 0;
    string admin_username = "";

    vendor_name = vendor.vendor_name;
    vendor_name_e = vendor.vendor_name_e;
    vendor_desc_e = vendor.vendor_desc_e;
    vendor_desc = vendor.vendor_desc;
    admin_u_id = vendor.admin_u_id;
    admin_username = AppFunctions.GetRepName(admin_u_id);


    switch (summaryOf)
    {
        case "":
            <div>@AdminVendors.VendorGeneralSettings(vendor_id)</div>
            break;
        case "TEAM":
            <div>@AdminVendors.VendorTeamSettings(vendor_id)</div>

            break;
        case "PRODUCTS":
            <div>@AdminVendors.VendorProductsSettings(vendor_id)</div>
            break;
        case "ROUNDS":
            <div>@AdminVendors.VendorRoundSettings(vendor_id)</div>
            break;
        case "INVENTORY":
            <div>@AdminVendors.VendorProductInventory(vendor_id)</div>
            break;
        case "ENTITIES":
            <div>@AdminVendors.VendorEntitiesSettings(vendor_id)</div>
            break;
        case "ENTITYINVENTORY":
            <div>@AdminVendors.VendorEntitiesInventory(vendor_id)</div>
            break;
        case "INVENTORYACTIONS":
            <div>@AdminVendors.VendorInventoryActions(vendor_id)</div>
            break;

        default:
            break;
    }

    db.Close();
}

