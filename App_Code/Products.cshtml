@helper RoundsProductAvailability(int p_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT v_id,title FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, p_id);
    int round_id = 0; try { round_id = product.round_id; } catch { }
    int vendor_id = 0; try { vendor_id = product.v_id; } catch { }
    string product_title = ""; try { product_title = product.title; } catch { }
    string vendor_name = ""; try { vendor_name = AppFunctions.GetVendorTitleById(vendor_id); } catch { }
    sqlSelect = "SELECT rounds.title,roundMenuItems.id FROM Rounds INNER JOIN roundMenuItems ON rounds.id=roundMenuItems.round_id WHERE roundMenuItems.p_id=@0";
    var rounds = db.Query(sqlSelect, p_id);
    if (rounds.Count() > 0)
    {
        <div style="overflow: auto;padding: 5px;">
            <div style="overflow: auto;">תפריטים בהם מופיע המוצר <b>@product_title</b></div>

            <div class="spinner" style="text-align: center;display: none;float: left" id="ActiveProductsLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>
        <div style="overflow: auto;">

            <div style="overflow: auto;border-bottom: 1px dotted #000">
                <div class="A">

                    @foreach (var round in rounds)
                    {

                        <div class="ProdViewItem">
                            @round.title
                            <span class="PPOInfoSpan">
                                <button style="float: left;" onclick="sbload('SubMenuLeft','Caller?p1=MenuItemEdit&p2=@round.id');">⚙️</button>
                            </span>
                        </div>


                    }

                </div>
            </div>


        </div>

    }
    else
    {
        <div class="B">
            <div class="ProductTagNone">המוצר <b>@product_title</b> של הספק <b>@vendor_name</b> לא זמין כרגע באף תפריט</div>
        </div>
    }
    db.Close();
}


@helper SubProductsForCatalogProduct(int p_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = " SELECT * FROM products WHERE is_Catalog=0 AND Catalog_p_id=@0 order by v_id,p_id desc";
    var subProducts = db.Query(sqlSelect, p_id);
    sqlSelect = "SELECT * FROM products WHERE p_id=@0";
    var catProduct = db.QuerySingle(sqlSelect, p_id);

    if (subProducts.Count() > 0 && catProduct != null)
    {

        <div style="overflow: auto;">

            <div style="overflow: auto;border-bottom: 1px dotted #000">
                <div style="overflow: auto">
                    @foreach (var product in subProducts)
                    {
                        string DivClass = "PPOBtnItemSelected";
                        bool is_rc = true; try { is_rc = product.is_rc; } catch { }
                        if (!is_rc)
                        {
                            DivClass = "PPOBtnItem";
                        }

                        string vendor_name = "";
                        try { vendor_name = AppFunctions.GetVendorTitleById(product.v_id); } catch { }
                        <div style="overflow: auto;border-bottom:1px dotted #808080;font-size: 16px;color: #000;background-color: #fff">
                            <div style="overflow: auto;">
                                <button style="float: left; background: transparent; border: 0; font-size: 16px;  padding: 5px; margin: 5px;display:none"></button>

                                <div class="PPOBtnItem" style="float: right; overflow: auto; padding: 5px; margin: 5px; " onclick="sbload('GenSb','Caller?p1=ProductEdit&p2=@product.p_id');">
                                    ⚙️

                                </div>
                                <div class="@DivClass" id="prodRcDiv_@product.p_id" style="float: right; overflow: auto; padding: 5px; margin: 5px; " onclick=" AjaxActions('SetProductRcState', '@product.p_id', 'MainLoader', document.getElementById('subProd_@product.p_id').checked);MiscActions('PPOOPTTOGGLE', '@product.p_id','RC');">
                                    <span style="background-color:#fff;border-radius:50%;">🌍</span>
                                    <input type="checkbox" id="subProd_@product.p_id" value="true" checked="@product.is_rc" style="display:none" />
                                </div>
                                <div style="overflow:auto;float:right">
                                    <div class="ProdListImgContainer" style="width:50px;">
                                        <img class="ProdImg_small" src="ImgViewer?size=tn&p_id=@product.p_id" alt="אלט" />
                                    </div>

                                    <div style="overflow: auto; padding: 5px; margin: 5px;">

                                        <div style="overflow: auto;  color: #000"><b>@product.title - @vendor_name</b></div>

                                    </div>
                                </div>
                                <div style="float: left; padding: 5px; margin: 5px; color: #808080;overflow:auto">#@product.p_id </div>

                            </div>
                        </div>

                    }

                </div>
            </div>


        </div>

    }
    else
    {
        <div>
            <div class="PviewTagEmpty">אין מוצרים פעילים למוצר הקטלוגי <b>@catProduct.title</b></div>

        </div>
    }
    db.Close();
}


@helper CreateSubProductForVendors(int p_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = " SELECT * FROM vendors WHERE is_active=1 order by vendor_id";
    var vendors = db.Query(sqlSelect);

    <div class="B">

        <div class="B">
            <form id="ProductSetupForm">
                <input type="hidden" name="p_id" value="@p_id" />
                <div class="B">
                    <div class="A">
                        <select style="padding: 5px;margin:5px; font-size: 16px; float: right" name="vendor_id" id="vendor_id_select">
                            <option value="">נא לבחור..</option>

                            <option value="-1">יצירת המוצר אצל כל הספקים</option>
                            @foreach (var vendor in vendors)
                            {
                                <option value="@vendor.vendor_id">יצירה עבור @vendor.vendor_name</option>
                            }
                            <option value="-3">העתקת התבנית</option>

                        </select>
                        <div class="A" style="float:right">
                            <input type="checkbox" name="is_active" /> יצירה כפעיל
                        </div>
                        <button type="button" class="A" style="float: left; " onclick="AjaxActions('CreateProductFromCatalog', '@p_id', 'MainLoader', 'ProductSetupForm');">יצירה</button>

                    </div>



                </div>
            </form>
        </div>


    </div>
    db.Close();
}


