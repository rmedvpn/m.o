                    <div style="overflow: auto;border-bottom: 1px dotted #000;">
                        הנחות <span style="float: left"><input type="checkbox" id="is_discountable" name="is_discountable" style="width: 20px;height: 20px;margin: 5px;" @if (product.is_discountable) { <text> checked </text> }></span>
                    </div>
                    <div style="overflow: auto;border-bottom: 1px dotted #000;">
