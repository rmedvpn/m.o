                                        <span style="float: left;font-weight: bold">
                                            @if (itemunit_type == 0)
                                            {
                                                <select style="padding: 5px;margin: 5px;font-size: 16px;" id="itemunit_type" name="itemunit_type" onchange="if(this.value!=''){let itemunittitle=this.options[this.selectedIndex].text;for(var i = 1; i <= 5; i++) { document.getElementById('itemunit' + i).innerHTML = itemunittitle;}}">
                                                    <option value="">נא לבחור</option>
                                                    @foreach (var item in itemUnitTypes)
                                                    {
                                                        <option value="@item.id">@item.title</option>
                                                    }
                                                </select>
                                            }
