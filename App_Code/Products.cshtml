                                            {
                                                <input type="hidden" id="itemunit_type" name="itemunit_type" value="@itemunit_type">
                                                <span style="color: #000">@itemunit</span>
                                            }
                                        </span>
                                    </span>
                                </div>


                                <div style="overflow: auto;border-bottom: 1px dotted #000;">
                                    מחיר מחירון<span style="float: left"><input type="text" id="price" name="price" style="width: 30px;padding: 5px;font-size: 16px;margin: 5px;"> (₪/<span id="itemunit1">@itemunit</span>)</span>
                                </div>
                                <div style="overflow: auto;border-bottom: 1px dotted #000;">
                                    מחיר עלות <span style="float: left"><input type="text" id="cost" name="cost" style="width: 30px;padding: 5px;font-size: 16px;margin: 5px;"> (₪/<span id="itemunit2">@itemunit</span>)</span>
                                </div>


                            </div>


                        </div>
                        <div class="Spacer50"></div>
                        <div style="overflow: auto;text-align: center">
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #000;color: #fff;font-weight: bold" onclick="AjaxActions('AddNewProduct', '', 'MainLoader', 'AddNewProduct', document.getElementById('vendor_id').value);">הוספת מוצר</button>
                        </div>
                    </div>


                </div>

            </form>
            <form id="SelectCatalogProduct">

                <div id="ProductImportDiv" style="font-size:18px;color:#000;display:none;">
                    <input type="hidden" name="vendor_id" id="imp_v_id" />
                    <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
                        קטגורית מוצר
                        <select style="padding: 5px;margin: 5px;font-size: 16px;float: left" onchange="RepAjaxUpdate('LoadProductCatalog', 'CatalogProductsContainer', 'ProductCatalogLoader', this.value);">
                            <option>נא לבחור </option>
                            @foreach (var cat in MainCategories)
                            {
                                <option value="@cat.id">@cat.title</option>
                            }
                        </select>
                        <div class="spinner" style="text-align: center;display: none;float: left" id="ProductCatalogLoader">
                            <div class="bounce1"></div>
                            <div class="bounce2"></div>
                            <div class="bounce3"></div>
                        </div>
                    </div>

                    <div style="overflow: auto">
                        <div style="overflow: auto;border-bottom: 1px dotted #000;" id="CatalogProductsContainer">

                        </div>
                    </div>

                </div>
            </form>

        </div>
        <div class="Spacer100"></div>

    </div>
    db.Close();
}


