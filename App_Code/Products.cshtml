@helper LoadCustomFieldsList(int rec_id, string scope = "PT")
{

    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM  CustomFields WHERE p_t_id=@0 AND is_active=1 ORDER BY sort_order";
    if (scope == "CAT")
    {
        sqlSelect = "SELECT * FROM  CustomFields WHERE cat_id=@0 AND is_active=1 ORDER BY sort_order";
    }
    var customFields = db.Query(sqlSelect, rec_id);
    sqlSelect = "SELECT * FROM CustomProductFieldsType";
    var customProductFieldTypes = db.Query(sqlSelect);
    if (customFields.Count() > 0)
    {
        foreach (var field in customFields)
        {
            string valuesListDisplayState = "none;";
            string fieldPrfx = field.p_t_id + "_" + field.id + "_";
            if (field.fieldType_id == 8)
            {
                valuesListDisplayState = "block;";
            }

            <div class="B" id="customFieldDiv_@field.id" style="border-bottom:1px dotted #e3e3e3;">
                <div class="B">
                    <div style="float:right">

                        <button type="button" style="float: right; padding: 1px; margin: 1px; font-size: 14px; border: 0;  background: transparent" onclick="AjaxActions('CustomFieldMove', '@rec_id','MainLoader','@field.id','up','@scope');">⬆️</button>
                        <button type="button" style="float: right; padding: 1px; margin: 1px; font-size: 14px; border: 0;  background: transparent" onclick="    AjaxActions('CustomFieldMove', '@rec_id', 'MainLoader', '@field.id', 'down', '@scope');">⬇️</button>

                    </div>
                    <div style="float:right;margin-right:10px;">
                        <b>@field.title</b>
                        @if (field.is_required)
                        {<span style="font-size: 14px;color: #f00"> <b>*</b> </span>}
                    </div>

                    <div style="float: left">
                        <button type="button" style="float: left; padding: 1px; margin: 1px; font-size: 14px; border: 0;  background: transparent" onclick="toggle_visibility('customFieldEditDiv_@field.id');">⚙️</button>
                    </div>





                </div>
            </div>

            <div class="B" id="customFieldEditDiv_@field.id" style="border-bottom:1px dotted #e3e3e3;display:none;background-color:#ffffcc">
                <div class="B">


                    <form id="edit_Field_@field.id">
                        <input type="hidden" name="field_id" value="@field.id">
                        <input type="hidden" name="cat_id" value="@field.cat_id">
                        <input type="hidden" name="p_id" value="@field.p_id">
                        <input type="hidden" name="p_t_id" value="@field.p_t_id">

                        <div class="B">
                            <div class="B">
                                <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;float:right;width:150px;" name="custom_field_title" id="custom_field_title" placeholder="שם השדה" value="@field.title">
                                <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;float:right;width:150px;" name="custom_field_e_title" id="custom_field_e_title" placeholder="Title" value="@field.title_e">

                                <select style="font-size: 16px; padding: 5px; margin: 5px; float: right" name="fieldType" id="fieldType" onchange="    if (this.value == 8) { showElement('Select_List_@field.id'); } else { hideElement('Select_List_@field.id'); } ">

                                    @foreach (var item in customProductFieldTypes)
                                    {
                                        <option value="@item.id" @(field.fieldType_id == item.id ? "selected" : "") }>@item.title</option>
                                    }
                                </select>
                            </div>
                            <div class="B" id="Select_List_@field.id" style="display:@valuesListDisplayState;">

                                <div class="B" id="Add_Select_List_Div_@fieldPrfx">
                                    <div class="B">

                                        <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;float:right;width:150px;" name="add_to_select_list_title" id="add_to_select_list_title_@fieldPrfx" placeholder="עברית">
                                        <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;float:right;width:150px;" name="add_to_select_list_title_e" id="add_to_select_list_title_e_@fieldPrfx" placeholder="אנגלית">
                                        <button class="A" type="button" style="float:right" onclick="MiscActions('AddToCustomFieldSelectList', 'add_to_select_list_title_@fieldPrfx', 'add_to_select_list_title_e_@fieldPrfx', 'values_list_@fieldPrfx','e_values_list_@fieldPrfx')">הוספה</button>
                                        <button class="A" type="button" style="float:right" onclick="MiscActions('ResetCustomFieldSelectList', 'values_list_@fieldPrfx')">איפוס</button>

                                    </div>
                                    <div class="B">
                                        <textarea style="font-size: 16px;padding: 5px;margin: 5px;float:right;width:40%;resize:none;" rows="6" id="DISP_values_list_@fieldPrfx" disabled>@field.values_list</textarea>
                                        <textarea style="display:none;" name="values_list" id="values_list_@fieldPrfx">@field.values_list</textarea>
                                    </div>



                                </div>


                            </div>
                            <div class="B">
                                <div style="overflow: auto;font-size: 16px;padding: 5px;margin: 5px;float:right">
                                    <input type="checkbox" name="is_active" @(field.is_active ? "checked" : "")> שדה פעיל
                                </div>
                                <div style="overflow: auto;font-size: 16px;padding: 5px;margin: 5px;float:right">
                                    <input type="checkbox" name="is_required" @(field.is_required ? "checked" : "")> שדה חובה
                                </div>
                                <div style="overflow: auto; font-size: 16px; padding: 5px; margin: 5px; float: right">
                                    <input type="checkbox" name="is_vendor_editable" @(field.is_vendor_editable ? "checked" : "")> ניתן לעריכה
                                </div>
                                <div style="overflow: auto; font-size: 16px; padding: 5px; margin: 5px; float: left">
                                    <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent;" onclick="AjaxActions('UpdateCustomField', '@field.id', 'MainLoader', 'edit_Field_@field.id','@rec_id','@scope');">✔️</button>
                                    <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent;" onclick="toggle_visibility('customFieldEditDiv_@field.id');">❌</button>
