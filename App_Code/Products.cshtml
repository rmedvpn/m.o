                                    <div >@Products.LoadCatTagsSelector(product.maincat_id, product.p_id)</div>
                                }
                            </div>
                        </div>



                    </div>
                </div>
                <div style="overflow: auto;font-size: 18px;padding: 5px;background-color: #fff">

                    <div style="overflow: auto;border-bottom: 1px dotted #000;">
                        סוג צמח
                        <span style="float: left">
                            <select name="strain_type" id="strain_type" style="padding: 5px;font-size: 16px;margin: 5px;">
                                <option></option>
                                @foreach (var s in StrainTypes)
                                {
                                    <option value="@s.strain_type" @if (strain_type == s.strain_type) { <text>selected</text> }>@s.title</option>
