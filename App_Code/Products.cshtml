                </div>
                <div style="overflow: auto;">
                    <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%" name="custom_field_title" id="custom_field_title" placeholder="שם השדה">
                    <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%" name="custom_field_e_title" id="custom_field_e_title" placeholder="Title">
                    <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%" name="custom_fieldName" id="custom_fieldName" placeholder="Field Name">
                    <select style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;" name="fieldType" id="fieldType">
                        <option value="">נא לבחור סוג שדה</option>
                        @foreach (var item in customProductFieldTypes)
                        {
                            <option value="@item.id">@item.title</option>
                        }
                    </select>
                    <div style="overflow: auto;font-size: 16px;padding: 5px;margin: 5px">
                        <span style="float: right"><input type="checkbox" id="is_required" name="is_required" style="overflow: auto;font-size: 16px;padding: 5px;margin: 5px"> שדה חובה</span>
                        <input type="hidden" value="is_editable" name="is_editable">
                    </div>
                </div>
                <div style="overflow: auto;text-align: center;padding: 5px;">
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 12px;border: 0;background-color: #000;color: #fff;font-weight: bold" onclick="Accordionize('AddProdFieldAcc');document.getElementById('Add_Product_Field').reset();">ביטול</button>
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 12px;border: 0;background-color: #57d600;color: #fff;font-weight: bold" onclick="AjaxActions('AddCustomProductField', '@p_id','', 'Add_Product_Field'); document.getElementById('Add_Product_Field').reset(); Accordionize('AddProdFieldAcc');">הוספת שדה</button>
                </div>
