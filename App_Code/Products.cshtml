@helper ProductImages(int product_id, bool is_RoundMenuItem = false, bool is_actions = true)
{

    var db = Database.Open("op_data");
    var sqlSelect = "Select mimeType,File_id,is_primary From ProductImages Where is_deleted=0 AND product_id = @0 ORDER BY is_primary DESC,timestamp DESC";
    var files = db.Query(sqlSelect, product_id);

    db.Close();


    <div style="background-color: #fff;color: #808080;padding: 5px;">
        <input type="hidden" name="upload_p_id" id="upload_p_id" value="@product_id">


        <div class="ProductViewImagesContainer">


            @if (files.Count() > 0)
            {
                int cnt = 0;
                string imgClass = "ProductViewPrimaryImage";


                foreach (var item in files)
                {
                    cnt++;
                    string imgLink = "ImgViewer?Id=" + item.file_id;
                    if (!item.is_primary)
                    {
                        imgClass = "ProductViewSmallImage";
                        imgLink = "ImgViewer?size=tn&Id=" + item.file_id;


                    }

                    if (item.MimeType.StartsWith("image"))
                    {
                        if (item.is_primary)
                        {
                            <div class="B">
                                <span class="ProductViewImageSpan">

                                    <img class="@imgClass" src="@imgLink" alt="אלט" onclick="sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=0');" />


                                </span>
                            </div>
                        }
                        else
                        {
                            <span class="ProductViewImageSpan">

                                <img class="@imgClass" src="@imgLink" alt="אלט" onclick="sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=0');" />


                            </span>
                        }

                    }
                }
            }
            else
            {

                <span class="ProductViewImageSpan">

                    <img class="ProductViewNoImage" src="~/Images/nopic.jpg" />


                </span>
            }
        </div>

        <div class="hide">
            @if (!is_RoundMenuItem && is_actions)
            {
                <div style="float:left;">
                    <form id="picupload" name="picupload" enctype="multipart/form-data">
                        <input style="float: left;font-size: 12px;padding: 5px;margin: 5px;" type="button" value="הוספה" id="ImgUploadBtn" onclick="document.getElementById('picfilebox').click();" />
                        <span id="pbar_txt" style="background-color: #b200ff;color: #fff;float: left;display: none;">0%</span>
                    </form>
                    <div style="overflow: auto;padding: 0;margin: 0;background-color: #fff;text-align: center;" id="pbContainer">
                        <div style="overflow: auto;background-color: #b200ff;color: #fff;float: right;width: 0%;height: 10px" id="pbar_bar">
                            <span style="color:#b200ff;height: 10px;"></span>
                        </div>
                    </div>
                </div>
            }



            @if (files.Count() > 0)
            {

                foreach (var item in files)
                {
                    if (item.MimeType.StartsWith("image"))
                    {
                        <span style="padding: 2px;">
                            @if (item.is_primary)
                            {
                                <small style="color: #808080;font-size: 11px;left: 0px;">תמונה ראשית</small><br>
                            }
                            @if (is_RoundMenuItem)
                            {
                                <img style="height: 50px;max-width: 50px;border-radius: 10px;margin: 3px;padding: 3px;" src="ImgViewer?size=tn&Id=@item.file_id" alt="אלט" onclick="    sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=1');" />
                            }
                            else
                            {
                                <img style="height: 50px;max-width: 50px;border-radius: 10px;margin: 3px;padding: 3px;" src="ImgViewer?size=tn&Id=@item.file_id" alt="אלט" onclick="    sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id');" />
                            }


                        </span>
                    }
                }
            }
            else
            {
                <span style="padding: 5px;font-size: 14px;color: #808080;">אין תמונות למוצר</span>
            }
            <div class="spinner" style="text-align: center;float: left;display: none" id="ImgUploadLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>

        </div>

    </div>


    db.Close();
}


@helper LoadSubCatSelector(int main_cat_id, int product_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM categories WHERE is_subcat=1 AND maincat_id=@0";
    var SubCategories = db.Query(sqlSelect, main_cat_id);
    sqlSelect = "SELECT * FROM categories WHERE is_spOffersCat=1 AND (maincat_id=@0 OR maincat_id=0)";
    var spOfferCategries = db.Query(sqlSelect, main_cat_id);
    sqlSelect = "SELECT p_id,spOfferCatId,sub_cat_id FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);
    int sub_cat_id = 0; try { sub_cat_id = product.sub_cat_id; } catch { }
    int spOfferCatId = 0; try { spOfferCatId = product.spOfferCatId; } catch { }


    if (SubCategories.Count() > 0)
    {
        <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
            תת קטגוריה
            <select style="padding: 5px;margin: 5px;font-size: 16px;float: left" id="sub_cat_id" name="sub_cat_id">
                <option>נא לבחור </option>
                @foreach (var cat in SubCategories)
                {
                    <option value="@cat.id" @if (cat.id == sub_cat_id) { <text> selected</text>}>@cat.title</option>
                }
            </select>
        </div>

    }
    else
    {
        <div></div>
    }

    if (spOfferCategries.Count() > 0)
    {
        <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
            קטגורית מבצעים
            <select style="padding: 5px;margin: 5px;font-size: 16px;float: left" id="spOfferCatId" name="spOfferCatId">
                <option>נא לבחור </option>
                @foreach (var cat in spOfferCategries)
                {
                    <option value="@cat.id" @if (cat.id == spOfferCatId) { <text> selected</text>}>@cat.title</option>
                }
            </select>
        </div>
    }
    else
    {
        <div></div>
    }


    db.Close();
}

@helper LoadCatTagsSelector(int main_cat_id, int p_id = 0, bool is_header = true)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM categories WHERE is_tag=1 AND (maincat_id=@0 OR maincat_id=99999)";
    var CatTags = db.Query(sqlSelect, main_cat_id);
    sqlSelect = "SELECT title FROM categories WHERE id=@0";
    var MainCat = db.QuerySingle(sqlSelect, main_cat_id);
    string SelectedCat = "";
    if (CatTags.Count() > 0)
    {

        <div style="overflow: auto;">

            @if (CatTags.Count() > 0)
            {
                <div class="B">
                    @if (is_header)
                    {
                        <div style="overflow: auto;font-weight: bold">תגיות לקטגוריה @MainCat.title</div>
                    }

                    <div style="overflow: auto">
                        @foreach (var cat in CatTags)
                        {
                            bool is_selected = false;
                            sqlSelect = "SELECT cat_id FROM productTags WHERE cat_id=@0 AND p_id=@1";
                            var rs = db.QuerySingle(sqlSelect, cat.id, p_id);
                            if (rs != null)
                            {
                                SelectedCat = SelectedCat + "##" + cat.id + "##";
                                is_selected = true;
                            }

                            if (is_selected)
                            {
                                <input type="hidden" name="is_cat_@cat.id" id="is_cat_@cat.id" value="">
                                <div class="ProductTagSelected">
                                    <button type="button" class="ProductTagFavBtn">⭐</button>
                                    <button type="button" class="ProductTagBtn" id="cat_btn_@cat.id" onclick="ProductCatSelector(@cat.id);">@cat.title</button>

                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="is_cat_@cat.id" id="is_cat_@cat.id" value="no">
                                <div class="ProductTagUnSelected">
                                    <button type="button" class="ProductTagFavBtn">★</button>

                                    <button type="button" id="cat_btn_@cat.id" onclick="ProductCatSelector(@cat.id);" class="ProductTagBtn">@cat.title</button>
                                </div>


                            }
                        }

                    </div>
                </div>
            }


            <input type="hidden" name="SelectedCat" id="SelectedCat" value="@SelectedCat">
        </div>

    }
    else
    {
        <div class="ProductTagNone">אין תגיות לקטגוריית @MainCat.title</div>
    }

    db.Close();
}





@helper EditProductCustomFields(int p_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM  ProductsCustomFields WHERE p_id=@0 AND is_activated=1 ORDER BY listindex";
    var customFields = db.Query(sqlSelect, p_id);
    sqlSelect = "SELECT * FROM  ProductsCustomFields WHERE p_id=@0 AND is_activated=0";
    var unUsedCustomFields = db.Query(sqlSelect, p_id);
    sqlSelect = "SELECT * FROM CustomProductFieldsType";
    var customProductFieldTypes = db.Query(sqlSelect);

    bool is_catalog = false;
    sqlSelect = "SELECT is_catalog FROM products WHERE p_id=@0";
    var prodRs = db.QuerySingle(sqlSelect, p_id);
    try { is_catalog = prodRs.is_catalog; } catch { }

    <div>

        <div style="overflow: auto;text-align: center">
            <select style="width: 70%;padding: 5px;margin: 5px;font-size: 16px;float: right" id="field_id" name="field_id" onchange="if (this.value == '-1') { Accordionize('AddProdFieldAcc'); } else { if (IsAccordion('AddProdFieldAcc')) { Accordionize('AddProdFieldAcc'); } AjaxActions('ActivateProductCustomField','@p_id','', document.getElementById('field_id').value); }">
                <option value="">נא לבחור שדה להוספה</option>
                @foreach (var field in unUsedCustomFields)
                {
                    <option value="@field.id">@field.title</option>
                }
                <option value="-1">שדה חדש..</option>

            </select>
            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;float: left;border: 0;display: none" onclick="AjaxActions('ActivateProductCustomField','@p_id','', document.getElementById('field_id').value);">הוספה</button>
            <div class="spinner" style="text-align: center;display: none;float: left" id="CustomFieldLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>

        </div>
        <button class="Accordion" style="display: none" id="AddProdFieldAcc"></button>
        <div class="panel" style="padding: 0;margin: 0">
            <form id="Add_Product_Field">
                <input type="hidden" name="p_id" id="p_id" value="@p_id">
                <div style="overflow: auto;font-weight: bold;font-size: 16px">
                    הוספת שדה מידע
                </div>
                <div style="overflow: auto;">
                    <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%" name="custom_field_title" id="custom_field_title" placeholder="שם השדה">
                    <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%" name="custom_field_e_title" id="custom_field_e_title" placeholder="Title">
                    <input type="text" style="font-size: 16px;padding: 5px;margin: 5px;width: 90%" name="custom_fieldName" id="custom_fieldName" placeholder="Field Name">
                    <select style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;" name="fieldType" id="fieldType">
                        <option value="">נא לבחור סוג שדה</option>
                        @foreach (var item in customProductFieldTypes)
                        {
                            <option value="@item.id">@item.title</option>
                        }
