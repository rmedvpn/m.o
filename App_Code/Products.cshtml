@helper ProductCustomFields(int product_id, int p_t_id = 0, int cat_id = 0, bool is_vendor = false)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT title,maincat_id, sub_cat_id, product_type, custom_fields_json FROM Products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);

    if (product != null)
    {
        int main_cat_id = 0; try { main_cat_id = Convert.ToInt32(product.maincat_id); } catch { }
        int sub_cat_id = 0; try { sub_cat_id = Convert.ToInt32(product.sub_cat_id); } catch { }
        int product_type = 0; try { product_type = Convert.ToInt32(product.product_type); } catch { }
        string customFieldsJson = ""; try { customFieldsJson = Convert.ToString(product.custom_fields_json); } catch { }

        if (p_t_id > 0) { product_type = p_t_id; }
        if (cat_id > 0) { sub_cat_id = cat_id; }
        if (cat_id == -1) { sub_cat_id = 0; }
        if (sub_cat_id == 0) { sub_cat_id = -1; }
        DataFunctions.WriteDebugLine("title: " + product.title + " product_type: " + product_type + " main_cat_id: " + main_cat_id + " sub_cat_id: " + sub_cat_id + " p_t_id: " + p_t_id);

        sqlSelect = "SELECT * FROM customFields WHERE is_active=1 AND (cat_id=@0 OR cat_id=@1 OR p_t_id=@2) ORDER BY is_required DESC, sort_order";
        if (is_vendor)
        {
            sqlSelect = "SELECT * FROM customFields WHERE is_active=1 AND (cat_id=@0 OR cat_id=@1 OR p_t_id=@2) ORDER BY is_vendor_editable DESC,is_required DESC, sort_order";
        }
        var CustomFields = db.Query(sqlSelect, main_cat_id, sub_cat_id, product_type);
        var savedCustomFields = new List<Dictionary<string, object>>();
        var savedFieldsLookup = new Dictionary<int, Dictionary<string, object>>();
        var shownTitles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        if (!String.IsNullOrWhiteSpace(customFieldsJson))
        {
            try
            {
                var serializer = new JavaScriptSerializer();
                savedCustomFields = serializer.Deserialize<List<Dictionary<string, object>>>(customFieldsJson);
            }
            catch { savedCustomFields = new List<Dictionary<string, object>>(); }
        }

        foreach (var item in savedCustomFields)
        {
            int savedId = 0;
            try
            {
                if (item.ContainsKey("id") && item["id"] != null) { savedId = Convert.ToInt32(item["id"]); }
            }
            catch { }

            if (savedId > 0 && !savedFieldsLookup.ContainsKey(savedId)) { savedFieldsLookup.Add(savedId, item); }
        }

        if (CustomFields.Count() > 0)
        {
            <div class="B">
                <div class="B"><b>שדות מידע</b></div>

                @foreach (var catFld in CustomFields)
                {
                    int fieldId = 0; try { fieldId = Convert.ToInt32(catFld.id); } catch { }
                    int fldType = 0; try { fldType = Convert.ToInt32(catFld.fieldType_id); } catch { }
                    bool isRequired = false; try { isRequired = Convert.ToBoolean(catFld.is_required); } catch { }
                    string FldTitle = ""; try { FldTitle = Convert.ToString(catFld.title).Trim(); } catch { }
                    string FldTitle_e = ""; try { FldTitle_e = Convert.ToString(catFld.title_e).Trim(); } catch { }
                    bool is_vendor_editable = false; try { is_vendor_editable = Convert.ToBoolean(catFld.is_vendor_editable); } catch { }
                    if (FldTitle == "" || shownTitles.Contains(FldTitle)) { continue; }
                    shownTitles.Add(FldTitle);

                    string FldName = "CusFld_" + fieldId;
                    string FldName_e = "CusFld_" + fieldId + "_e";
                    string req = isRequired ? "*" : "";

                    Dictionary<string, object> savedField = null;
                    savedFieldsLookup.TryGetValue(fieldId, out savedField);

                    string savedValue = "";
                    string savedValueHebrew = "";
                    string savedValueEnglish = "";
                    bool savedBooleanValue = false;

                    if (savedField != null)
                    {
                        try
                        {
                            if (savedField.ContainsKey("val") && savedField["val"] != null)
                            {
                                savedValue = Convert.ToString(savedField["val"]);
                                if (fldType == 4) { savedBooleanValue = Convert.ToBoolean(savedField["val"]); }
                            }
                        }
                        catch { }

                        try
                        {
                            if (savedField.ContainsKey("ValHeb") && savedField["ValHeb"] != null) { savedValueHebrew = Convert.ToString(savedField["ValHeb"]); }
                        }
                        catch { }

                        try
                        {
                            if (savedField.ContainsKey("ValEng") && savedField["ValEng"] != null) { savedValueEnglish = Convert.ToString(savedField["ValEng"]); }
                        }
                        catch { }
                    }

                    <div class="ProdViewItem">
                        @FldTitle <span class="RedMiniTag">@req</span>

                        @switch (fldType)
                        {
                            case 1:
                                {
                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><input type="text" class="ProdCustomFldShortText" name="@FldName" value="@savedValueHebrew" /></div>
                                            <div class="Spacer5"></div>
                                            <div class="B"><input type="text" class="ProdCustomFldShortText" name="@FldName_e" value="@savedValueEnglish" placeholder="@FldTitle_e" /></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">

                                            <div class="B"><span class="PPOInfoSpan">@savedValueHebrew</span></div>
                                            <div class="Spacer5"></div>
                                            <div class="B"><span class="PPOInfoSpan">@savedValueEnglish</span></div>
                                        </div>

                                    }

                                    break;
                                }

                            case 2:
                                {

                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><input type="text" class="ProdCustomFldLongText" name="@FldName" value="@savedValueHebrew" /></div>
                                            <div class="Spacer5"></div>
                                            <div class="B"><input type="text" class="ProdCustomFldLongText" name="@FldName_e" value="@savedValueEnglish" placeholder="@FldTitle_e" /></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">

                                            <div class="B"><span class="PPOInfoSpan">@savedValueHebrew</span></div>
                                            <div class="Spacer5"></div>
                                            <div class="B"><span class="PPOInfoSpan">@savedValueEnglish</span></div>
                                        </div>

                                    }


                                    break;
                                }

                            case 3:
                                {
                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld"><span class="MiniTag">%</span><input type="text" class="ProdCustomFldShortText" name="@FldName" value="@savedValue" /></div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><span class="PPOInfoSpan">@savedValue</span></div>
                                        </div>
                                    }

                                    break;
                                }

                            case 4:
                                {
                                    <div class="ProdCustomFld">
                                        @if ((is_vendor && is_vendor_editable) || !is_vendor)
                                        {
                                            if (savedBooleanValue)
                                            {
                                                <input type="checkbox" class="ProdCustomFldCheckBox" value="true" name="@FldName" checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="ProdCustomFldCheckBox" value="true" name="@FldName" />
                                            }
                                        }
                                        else
                                        {
                                            if (savedBooleanValue)
                                            {
                                                <div class="ProdCustomFld">
                                                    <div class="B"><span class="PPOInfoSpan">✅</span></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ProdCustomFld">
                                                    <div class="B"><span class="PPOInfoSpan">❌</span></div>
                                                </div>
                                            }
                                        }

                                    </div>
                                    break;
                                }

                            case 5:
                                {
                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld"><input type="date" class="ProdCustomFldDate" name="@FldName" value="@savedValue" /></div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><span class="PPOInfoSpan">@savedValue</span></div>
                                        </div>
                                    }



                                    break;
                                }

                            case 6:
                                {
                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld"><span class="MiniTag">₪</span><input type="text" class="ProdCustomFldShortText" name="@FldName" value="@savedValue" /></div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><span class="PPOInfoSpan">@savedValue</span></div>
                                        </div>
                                    }


                                    break;
                                }

                            case 7:
                                {
                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld"><span class="MiniTag">#</span><input type="text" class="ProdCustomFldShortText" name="@FldName" value="@savedValue" /></div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><span class="PPOInfoSpan">@savedValue</span></div>
                                        </div>
                                    }
                                    break;
                                }

                            case 8:
                                {
                                    string values_list = ""; try { values_list = Convert.ToString(catFld.values_list); } catch { }
                                    var options = values_list.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Split(new[] { "##" }, StringSplitOptions.None)).Where(x => x.Length == 2);
                                    if ((is_vendor && is_vendor_editable) || !is_vendor)
                                    {
                                        <div class="ProdCustomFld">
                                            <select class="ProdCustomFldSelect" name="@FldName">
                                                <option value=""></option>

                                                @foreach (var opt in options)
                                                {
                                                    string optionHebrew = opt[0].Trim();
                                                    string optionEnglish = opt[1].Trim();
                                                    string optionValue = optionHebrew + "##" + optionEnglish;
                                                    bool isSelected = optionHebrew == savedValueHebrew && optionEnglish == savedValueEnglish;

                                                    if (isSelected)
                                                    {
                                                        <option value="@optionValue" selected>@optionHebrew</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@optionValue">@optionHebrew</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ProdCustomFld">
                                            <div class="B"><span class="PPOInfoSpan">@savedValueHebrew</span></div>
                                        </div>
                                    }
                                    break;

                                }
                        }
                    </div>
                }

                <div class="Spacer10"></div>
            </div>
        }
    }

    db.Close();
}

@helper ProductCustomTags(int product_id, int p_t_id = 0, int cat_id = 0)
{
    var db = Database.Open("op_data");
    var product = db.QuerySingle("SELECT maincat_id, sub_cat_id, product_type, tags_json FROM Products WHERE p_id=@0", product_id);

    int main_cat_id = 0;
    int sub_cat_id = 0;
    int product_type = 0;
    string tags_json = "";

    if (product != null)
    {
        try { main_cat_id = Convert.ToInt32(product.maincat_id); } catch { }
        try { sub_cat_id = Convert.ToInt32(product.sub_cat_id); } catch { }
        try { product_type = Convert.ToInt32(product.product_type); } catch { }
        try { tags_json = Convert.ToString(product.tags_json); } catch { }
    }

    if (p_t_id > 0) { product_type = p_t_id; }
    if (cat_id > 0) { sub_cat_id = cat_id; }
    if (cat_id == -1) { sub_cat_id = 0; }
    if (sub_cat_id == 0) { sub_cat_id = -1; }
    var Tags = db.Query("SELECT * FROM pTags WHERE is_active=1 AND (cat_id=@0 OR cat_id=@1 OR p_t_id=@2) ORDER BY sort_order", main_cat_id, sub_cat_id, product_type);
    var savedTags = new List<Dictionary<string, object>>();
    var savedTagsLookup = new Dictionary<int, Dictionary<string, object>>();
    var shownTagTitles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    if (!String.IsNullOrWhiteSpace(tags_json))
    {
        try
        {
            var serializer = new JavaScriptSerializer();
            savedTags = serializer.Deserialize<List<Dictionary<string, object>>>(tags_json);
        }
        catch { savedTags = new List<Dictionary<string, object>>(); }
    }

    foreach (var savedTag in savedTags)
    {
        int savedTagId = 0;
        try
        {
            if (savedTag.ContainsKey("id") && savedTag["id"] != null) { savedTagId = Convert.ToInt32(savedTag["id"]); }
        }
        catch { }

        if (savedTagId > 0 && !savedTagsLookup.ContainsKey(savedTagId)) { savedTagsLookup.Add(savedTagId, savedTag); }
    }

    string SelectedCat = "";

    <div style="overflow:auto;">
        <form id="SaveProductTags">
            @if (Tags.Count() > 0)
            {
                <div class="B">
                    <div style="overflow:auto;">
                        @foreach (var tag in Tags)
                        {
                            int tagId = 0; try { tagId = Convert.ToInt32(tag.id); } catch { }
                            int tag_type = 0; try { tag_type = Convert.ToInt32(tag.tag_type); } catch { }
                            string tagTitleHebrew = ""; try { tagTitleHebrew = Convert.ToString(tag.title_h).Trim(); } catch { }
                            string values_list = ""; try { values_list = Convert.ToString(tag.values_list); } catch { }

                            string duplicateKey = tagTitleHebrew.Trim();
                            if (duplicateKey == "" || shownTagTitles.Contains(duplicateKey)) { continue; }
                            shownTagTitles.Add(duplicateKey);

                            Dictionary<string, object> savedTag = null;
                            savedTagsLookup.TryGetValue(tagId, out savedTag);

                            bool is_selected = savedTag != null;
                            bool is_fav = false;
                            string savedHebrew = "";
                            string savedEnglish = "";

                            if (savedTag != null)
                            {
                                try
                                {
                                    if (savedTag.ContainsKey("fav") && savedTag["fav"] != null) { is_fav = Convert.ToBoolean(savedTag["fav"]); }
                                }
                                catch { }

                                try
                                {
                                    if (savedTag.ContainsKey("he") && savedTag["he"] != null) { savedHebrew = Convert.ToString(savedTag["he"]); }
                                }
                                catch { }

                                try
                                {
                                    if (savedTag.ContainsKey("en") && savedTag["en"] != null) { savedEnglish = Convert.ToString(savedTag["en"]); }
                                }
                                catch { }
                            }

                            if (is_selected) { SelectedCat += "##" + tagId + "##"; }

                            string tagVal = is_selected ? "yes" : "no";
                            string tagClass = is_selected ? "ProductTagSelected" : "ProductTagUnSelected";
                            string savedListValue = savedHebrew != "" ? savedHebrew + "##" + savedEnglish : "";

                            <input type="hidden" name="is_cat_@tagId" id="is_cat_@tagId" value="@tagVal" />

                            <div class="@tagClass" id="cat_btn_@tagId">
                                @if (tag_type == 2)
                                {
                                    if (is_fav)
                                    {
                                        <input type="checkbox" class="ProductTagFavBtn" name="is_tag_fav_@tagId" id="is_tag_fav_@tagId" value="true" checked onchange="if(document.getElementById('tag_value_@tagId').value==''){this.checked=false;}else{ProductTagFavChanged(@tagId,this.checked);}" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="ProductTagFavBtn" name="is_tag_fav_@tagId" id="is_tag_fav_@tagId" value="true" onchange="if(document.getElementById('tag_value_@tagId').value==''){this.checked=false;}else{ProductTagFavChanged(@tagId,this.checked);}" />
                                    }

                                    <select class="ProductTagSelect" id="tag_value_@tagId" name="tag_value_@tagId" onchange="if(this.value==''){ProductCatSelector(@tagId);hideElement('pt_lst_btn_@tagId');document.getElementById('is_tag_fav_@tagId').checked=false;}else{ProductTagSelectChanged(@tagId,this);showElement('pt_lst_btn_@tagId');}">
                                        <option value="">@tagTitleHebrew</option>

                                        @foreach (string item in values_list.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            string[] vals = item.Split(new[] { "##" }, StringSplitOptions.None);
                                            string valHeb = vals.Length > 0 ? vals[0].Trim() : "";
                                            string valEng = vals.Length > 1 ? vals[1].Trim() : valHeb;
                                            string selVal = valHeb + "##" + valEng;

                                            if (selVal == savedListValue)
                                            {
                                                <option value="@selVal" selected>@valHeb</option>
                                            }
                                            else
                                            {
                                                <option value="@selVal">@valHeb</option>
                                            }
                                        }
                                    </select>

                                    if (is_selected)
                                    {
                                        <div class="B" id="pt_lst_btn_@tagId" style="float:left;">
                                            <button type="button" class="ProductTagBtn" style="font-size:12px;" onclick="ProductCatSelector(@tagId);document.getElementById('tag_value_@tagId').value='';document.getElementById('is_tag_fav_@tagId').checked=false;hideElement('pt_lst_btn_@tagId');">❎</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="B" id="pt_lst_btn_@tagId" style="float:left;display:none;">
                                            <button type="button" class="ProductTagBtn" style="font-size:12px;" onclick="ProductCatSelector(@tagId);document.getElementById('tag_value_@tagId').value='';document.getElementById('is_tag_fav_@tagId').checked=false;hideElement('pt_lst_btn_@tagId');">❎</button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    if (is_fav)
                                    {
                                        <input type="checkbox" class="ProductTagFavBtn" name="is_tag_fav_@tagId" id="is_tag_fav_@tagId" value="true" checked onchange="ProductTagFavChanged(@tagId,this.checked);" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="ProductTagFavBtn" name="is_tag_fav_@tagId" id="is_tag_fav_@tagId" value="true" onchange="ProductTagFavChanged(@tagId,this.checked);" />
                                    }

                                    <button type="button" class="ProductTagBtn" onclick="ProductCatSelector(@tagId);">@tagTitleHebrew</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="Spacer20"></div>

                    <div class="hide">
                        <div style="overflow:auto;text-align:center;">
                            <button type="button" style="padding:5px;margin:5px;font-size:16px;background-color:#f00;color:#fff;font-weight:bold;" onclick="hideElement('ProdTagsEditBtn');hideElement('ProdTagsEditDiv');showElement('ProdTagsViewBtn');showElement('ProdTagsViewDiv');">ביטול</button>
                            <button type="button" style="padding:5px;margin:5px;font-size:16px;background-color:#57d600;color:#fff;font-weight:bold;" onclick="AjaxActions('SaveProductTags','@product_id','MainLoader','SaveProductTags');">שמירת שינויים</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="PviewTagEmpty">אין תגיות רלוונטיות</div>
            }
            <div style="display:none;">ptid:@p_t_id catid:@cat_id pid:@product_id</div>
            <input type="hidden" name="SelectedCat" id="SelectedCat" value="@SelectedCat" />
        </form>
    </div>

    db.Close();
}

