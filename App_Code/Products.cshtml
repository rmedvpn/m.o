@helper RoundsProductAvailability(int p_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT v_id,title FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, p_id);
    int round_id = 0; try { round_id = product.round_id; } catch { }
    int vendor_id = 0; try { vendor_id = product.v_id; } catch { }
    string product_title = "";  try { product_title = product.title; } catch { }

    sqlSelect = "SELECT rounds.title,roundMenuItems.id FROM Rounds INNER JOIN roundMenuItems ON rounds.id=roundMenuItems.round_id WHERE roundMenuItems.p_id=@0";
    var rounds = db.Query(sqlSelect, p_id);
    if (rounds.Count() > 0)
    {
          <div style="overflow: auto;padding: 5px;">
      <div style="overflow: auto;">תפריטים בהם מופיע המוצר <b>@product_title</b></div>

      <div class="spinner" style="text-align: center;display: none;float: left" id="ActiveProductsLoader">
          <div class="bounce1"></div>
          <div class="bounce2"></div>
          <div class="bounce3"></div>
      </div>
  </div>
        <div style="overflow: auto;">

            <div style="overflow: auto;border-bottom: 1px dotted #000">
                <div class="A">

                    @foreach (var round in rounds)
                    {
                        <div class="A" style="border-bottom:1px dotted #808080;">
                            <button style="float: left;background:transparent;border:0;font-size: 16px;margin-left:10px;"  onclick="sbload('SubMenuLeft','Caller?p1=MenuItemEdit&p2=@round.id');">⚙️</button>
                            <div style="overflow:auto">
                                <span style="font-size:14px;color:#000"><b>@round.title</b></span>
                            </div>
                        </div>
                    }

                </div>
            </div>


        </div>

    }
    else
    {
                <div class="A">
            <div style="overflow: auto;font-size: 14px;color:#808080">אין מוצרים פעילים למוצר הקטלוגי <b>@product_title</b></div>

        </div>
    }
    db.Close();
}


@helper SubProductsForCatalogProduct(int p_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = " SELECT * FROM products WHERE is_Catalog=0 AND Catalog_p_id=@0 order by v_id,p_id desc";
    var subProducts = db.Query(sqlSelect, p_id);
    sqlSelect = "SELECT * FROM products WHERE p_id=@0";
    var catProduct = db.QuerySingle(sqlSelect, p_id);

    if (subProducts.Count() > 0 && catProduct != null)
    {

        <div style="overflow: auto;">

            <div style="overflow: auto;border-bottom: 1px dotted #000">
                <div style="overflow: auto">
                    @foreach (var product in subProducts)
                    {
                        string vendor_name = "";
                        try { vendor_name = AppFunctions.GetVendorTitleById(product.v_id); } catch { }
                        <div style="overflow: auto;border-bottom:1px dotted #808080;font-size: 18px;color: #000;background-color: #fff">
                            <div style="overflow: auto;">
                                <button style="float: left;background:transparent;border:0;font-size: 16px;margin-left:10px;" onclick="sbload('SubMenuLeft','Caller?p1=AddVendorProduct&p2=@product.p_id');">⚙️</button>
                                <div style="overflow:auto">
                                    <div style="float: right; padding: 5px; margin: 5px; font-size: 12px; color: #808080">#@product.p_id </div>
                                    <div style="overflow:auto;">
                                        <span style="font-size:14px;color:#000"><b>@product.title</b></span>
                                        <div style="overflow:auto;padding: 2px;margin:2px;font-size:12px;color:#b200ff">@vendor_name</div>
                                    </div>
                                </div>


                            </div>
                        </div>

                    }

                </div>
            </div>


        </div>

    }
    else
    {
        <div>
            <div style="overflow: auto;font-size: 14px;color:#808080">אין מוצרים פעילים למוצר הקטלוגי <b>@catProduct.title</b></div>

        </div>
    }
    db.Close();
}

@helper CreateSubProductForVendors(int p_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = " SELECT * FROM vendors WHERE is_active=1 order by vendor_id";
    var vendors = db.Query(sqlSelect);

    <div style="overflow: auto;">

        <div style="overflow: auto;border-bottom: 1px dotted #000">
            <form id="ProductSetupForm">
                <input type="hidden" name="p_id" value="@p_id" />
                <div style="overflow: auto">
                    <div style="overflow: auto;border-bottom:1px dotted #808080;font-size: 18px;color: #000;background-color: #fff">
                        <div style="overflow: auto;padding:4px;">
                            <div style="overflow:auto">
                                <div style="float: right; padding: 5px; margin: 1px; font-size: 12px; color: #808080">יצירת מוצר עבור </div>
                                <div style="float:right;">

                                    <div style="overflow:auto;">
                                        <select style="padding:5px;font-size:16px;" name="vendor_id" id="vendor_id_select">
                                            <option value="">נא לבחור..</option>
                                            <option value="-2">העתקה לקטלוג</option>
                                            <option value="-1">כל הספקים</option>
                                            @foreach (var vendor in vendors)
                                            {
                                                <option value="@vendor.vendor_id">@vendor.vendor_name</option>
                                            }


                                        </select>
                                    </div>
                                </div>
                                <div style="float: right;padding:5px;">
                                    <div style="float: right;">
                                        <input type="checkbox" style="padding:5px;margin:5px" name="is_pictures" checked /> תמונות
                                    </div>
                                    <div style="float: right;">
                                        <input type="checkbox" style="padding:5px;margin:5px" name="is_pricing" checked /> מחירון
                                    </div>
                                </div>
                                <button type="button" style="float: left; padding: 2px; margin: 2px; font-size: 12px; color: #808080" onclick="AjaxActions('CreateVendorProductFromCatalog', '@p_id', '', 'ProductSetupForm');">יצירה</button>


                            </div>

                        </div>
                    </div>


                </div>
            </form>
        </div>


    </div>
    db.Close();
}

