@using System.Web.Script.Serialization
@using System.Collections.Generic
@using System.Linq

@helper AllProducts(string listType = "CATALOG", int vendor_id = 0, bool ActiveOnly = false)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var db = Database.Open("op_data");
var sqlSelect = "";
string listTitle = "";
int itemsCnt = 0;

int activeCnt = 0;
int catalogCnt = 0;
int deletedCnt = 0;
int inActiveCnt = 0;
int curCat = 0;

bool showAddBtn = true;

sqlSelect = "SELECT vendor_id,vendor_name FROM vendors order by vendor_id";
var vendors = db.Query(sqlSelect);

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE is_deleted=0 AND is_catalog=0";

if (vendor_id > 0)
{
    sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE is_deleted=0 AND  v_id=@0";
}
var cntRS = db.QuerySingle(sqlSelect, vendor_id);
try { activeCnt = cntRS.the_cnt; } catch { }

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE is_deleted=0  AND is_catalog=1";
cntRS = db.QuerySingle(sqlSelect);
try { catalogCnt = cntRS.the_cnt; } catch { }

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE is_active=0";
cntRS = db.QuerySingle(sqlSelect);
try { inActiveCnt = cntRS.the_cnt; } catch { }

string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);
string bodyClass = "VendorProductsDiv";
string itemClass = "VendorProductEntry";
string headerClass = "VendorProductsDiv";

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM DeletedProducts";
cntRS = db.QuerySingle(sqlSelect);
try { deletedCnt = cntRS.the_cnt; } catch { }

if (listType == "VENDOR" && vendor_id == 0)
{
    listType = "ACTIVE";
}

switch (listType)
{
    case "ACTIVE":
        sqlSelect = "SELECT * FROM products WHERE is_deleted=0  AND is_catalog=0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "כל מוצרי הספקים הפעילים";
        itemsCnt = activeCnt;
        break;
    case "VENDOR":
        sqlSelect = "SELECT * FROM products WHERE is_deleted=0 AND v_id=@0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "תפריט מוצרים - " + vendor_name;
        itemsCnt = activeCnt;
        break;
    case "CATALOG":
        sqlSelect = "SELECT * FROM products WHERE is_deleted=0  AND is_catalog=1 ORDER BY maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "קטלוג תבניות";
        itemsCnt = catalogCnt;
        bodyClass = "CatalogProductsDiv";
        break;
    case "DELETED":
        sqlSelect = "SELECT * FROM DeletedProducts ORDER BY p_id DESC";
        listTitle = "מוצרים שנמחקו";
        itemsCnt = deletedCnt;
        showAddBtn = false;
        break;
}
var Products = db.Query(sqlSelect, vendor_id);


int cur_main_cat = -1;
int cur_sub_cat = -1;
string watermark = "קטלוג<br>Catalog";
if (vendor_id > 0)
{
    watermark = vendor_name + "<br> " + vendor_name;
}



if (listType == "ACTIVE"){watermark = "";}
if (listType == "DELETED") {watermark = "❌ ❌ ❌ <br> ❌ ❌ ❌"; }


    <div class="page-watermark" style="text-align:center">@Html.Raw(watermark)</div>

    <div class="@bodyClass">
        <input type="hidden" name="is_all_products" id="is_all_products" value="1">
        <input type="hidden" name="listType" id="listType" value="@listType">
        <input type="hidden" name="listType" id="vendor_id" value="@vendor_id">
        <div style="overflow: auto">
            <div style="overflow: auto;font-size: 24px;color: #000;padding: 5px;margin: 5px;">
                <button type="button" class="StdBtn" onclick="sbload('GenSb','Caller?p1=AddNewProduct');AdjustMainView();">➕</button>
                <button type="button" class="StdBtn" onclick="sbload('GenSb','Caller?p1=EditProductTypesSettings');AdjustMainView();">⚙️</button>
                <select class="StdSelect" onchange="if (this.value > 0) { RepAjaxUpdate('LoadProductsList', 'MainBoardContainer', 'MainLoader', 'VENDOR', this.value); currentProductsView = 'VENDOR'; } else { RepAjaxUpdate('LoadProductsList', 'MainBoardContainer', 'MainLoader', this.value); currentProductsView = this.value; } ">
                    <option value="CATALOG" selected="@(listType == "CATALOG")">קטלוג תבניות</option>
                    <option value="ACTIVE" selected="@(listType == "ACTIVE")">כל הספקים</option>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.vendor_id" selected="@(v.vendor_id == vendor_id)">@v.vendor_name</option>
                    }
                    <option value="DELETED" selected="@(listType == "DELETED")">מוצרים מחוקים</option>
                </select>



                <span class="StdTitle">@listTitle</span> <span class="MiniTag">@itemsCnt מוצרים</span>



            </div>


            <center>
                <div style="overflow: auto;clear: both;width:80%">

                    <div style="overflow: auto;clear: both;">
                        @foreach (var product in Products)
                        {
                            bool is_active = false; try { is_active = product.is_active; } catch { }
                            bool is_generic = false; try { is_generic = product.is_generic; } catch { }
                            bool is_catalog = false; try { is_catalog = product.is_catalog; } catch { }
                            bool is_rc = false; try { is_rc = product.is_rc; } catch { }
                            string bgColor = "#fff";
                            string cur_main_cat_name = "";
                            string cur_sub_cat_name = "";
                            string itmLink = "sbload('GenSb','Caller?p1=ProductEdit&p2=" + product.p_id + "');AdjustMainView();";
                            string itmCls = "VendorProductEntry";
                            if (listType == "DELETED") { itmLink = ""; }

                            if (!is_active)
                            {
                                itmCls = "InActiveProductEntry";
                            }

                            if (cur_main_cat != product.maincat_id)
                            {
                                cur_main_cat = product.maincat_id;
                                cur_sub_cat = -1;
                            }
                            if (cur_sub_cat != product.sub_cat_id)
                            {
                                cur_sub_cat = product.sub_cat_id;

                            }

                            try { cur_main_cat_name = NewAppFunctions.GetTitleById("Cat", cur_main_cat); } catch { }
                            try { cur_sub_cat_name = NewAppFunctions.GetTitleById("Cat", cur_sub_cat); } catch { }


                            if (curCat != cur_main_cat)
                            {
                                curCat = cur_main_cat;
                                <div style="overflow:auto;margin-right:10px;padding:5px;font-size:18px;color:white;background-color:#808080">@cur_main_cat_name</div>
                            }

                            <div class="@itmCls" id="Prod_@product.p_id" onclick="@itmLink">


                                <div class="B">

                                    <div class="B">


                                        @if (listType != "DELETED")
                                        {
                                            <button class="ProductsListBtn" style="display:none" onclick="sbload('GenSb','Caller?p1=ProductEdit&p2=@product.p_id');AdjustMainView();">⚙️</button>
                                        }

                                        <div class="B" style="text-align:right">

                                            <div class="ProdListImgContainer">
                                                <img class="ProductsListTemplateImg" src="ImgViewer?size=tn&p_id=@product.p_id" alt="אלט" />
                                            </div>

                                            <div class="B" style="font-size:24px;text-align:right">
                                                <b>@product.title</b>

                                            </div>


                                            <div class="B" style="font-size: 14px;float: right">


                                                <div class="B">


                                                    <div class="B">
                                                        <span style="display:none">
                                                            <span class="GrayMiniTag" style="font-size:14px;">@cur_main_cat_name</span>
                                                        </span>


                                                        <span class="MiniTag" style="font-size:14px;">@cur_sub_cat_name</span>
                                                    </div>
                                                    <div class="B">


                                                        <div style="display:none">
                                                            @if (product.is_catalog)
                                                            {
                                                                <span class="PrplMiniTag">מוצר קטלוגי #@product.p_id</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="GrayMiniTag">מוצר ספק #@product.p_id</span>
                                                            }

                                                        </div>


                                                        @if (product.v_id != 0)
                                                        {
                                                            <span class="PrplMiniTag">@AppFunctions.GetVendorTitleById(product.v_id)</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>



                                </div>

                            </div>
                        }
                    </div>




                </div>
            </center>


        </div>




        <div style="overflow: auto;height: 100px;">&nbsp;</div>
    </div>
    <div style="overflow: auto;height: 150px;">&nbsp;</div>

    db.Close();
}

@helper ProductEditSwitch(int product_id, string viewMode = "")
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT is_catalog,is_generic,is_rc,catalog_p_id FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);
    bool is_catalog = false; try { is_catalog = product.is_catalog; } catch { }
    bool is_rc = false; try { is_rc = product.is_rc; } catch { }
    bool is_generic = false; try { is_generic = product.is_generic; } catch { }

    <div style="overflow: auto; text-align: right; background-color: #fff; direction: rtl; ">
        @if (is_catalog || !is_rc)
        {
            <div style="color: #000">@Products.ViewProductTemplate(product_id, viewMode)</div>
        }
        else
        {
            <div style="overflow: auto; text-align: right; background-color: #fff; direction: rtl; color: #000">
                @Products.ViewProductTemplate(product_id, viewMode)
            </div>

        }




    </div>
    <div style="overflow: auto;height: 50px;">&nbsp;</div>

    db.Close();
}


@helper ViewProductTemplate(int product_id, string viewMode = "")
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);
    bool is_catalog = false; try { is_catalog = product.is_catalog; } catch { }
    bool is_rc = false; try { is_rc = product.is_rc; } catch { }
    bool is_generic = false; try { is_generic = product.is_generic; } catch { }
    int catalog_p_id = 0; try { catalog_p_id = product.catalog_p_id; } catch { }
    int vendor_id = 0; try { vendor_id = product.v_id; } catch { }
    string vendor_name = ""; if (vendor_id > 0) { try { vendor_name = AppFunctions.GetVendorTitleById(vendor_id); } catch { } }
    bool is_editable = true; if (is_generic && !is_catalog) { is_editable = false; }
    int itemunit_type = 0; try { itemunit_type = product.itemunit_type; } catch { }
    string itemunit = ""; itemunit = product.itemunit;
    int maincat_id = 0; try { maincat_id = product.maincat_id; } catch { }
    int product_type = 0; try { product_type = product.product_type; } catch { }

    string rc_disabler = "";
    string generic_disabler = "";



    if (product_type == 0)
    {
        sqlSelect = "SELECT def_product_type FROM Categories WHERE id=@0";
        var Category = db.QuerySingle(sqlSelect, maincat_id);
        try { product_type = Category.def_product_type; } catch { }

    }

    sqlSelect = "SELECT * FROM ProductTypes ORDER BY id";
    var ProductTypes = db.Query(sqlSelect);
    sqlSelect = "Select mimeType,File_id,is_primary From ProductImages Where is_deleted=0 AND product_id = @0 ORDER BY is_primary DESC,timestamp DESC";
    var files = db.Query(sqlSelect, product_id);
    var SubCategories = db.Query("SELECT * FROM categories WHERE is_subcat=1 AND maincat_id=@0", maincat_id);
    var spOfferCategries = db.Query("SELECT * FROM categories WHERE is_spOffersCat = 1 AND(maincat_id=@0 OR maincat_id=0)", maincat_id);
    int sub_cat_id = 0; try { sub_cat_id = product.sub_cat_id; } catch { }
    int spOfferCatId = 0; try { spOfferCatId = product.spOfferCatId; } catch { }
    var CustomFields = db.Query("SELECT * FROM customFields WHERE is_active=1 AND (cat_id=@0 OR cat_id=@1 OR p_t_id=@2) ORDER BY is_required DESC, sort_order", maincat_id, sub_cat_id, product_type);
    string customFieldsJson = product.custom_fields_json;

    string CustomFieldsStr = "";
    var savedCustomFields = new List<Dictionary<string, object>>();

    if (!String.IsNullOrWhiteSpace(customFieldsJson))
    {
        try
        {
            var serializer = new JavaScriptSerializer();
            savedCustomFields = serializer.Deserialize<List<Dictionary<string, object>>>(customFieldsJson);
        }
        catch
        {
            savedCustomFields = new List<Dictionary<string, object>>();
        }
    }

    string tags_json = ""; try { tags_json = Convert.ToString(product.tags_json); } catch { }

    var productTags = new List<Dictionary<string, object>>();

    if (!String.IsNullOrWhiteSpace(tags_json))
    {
        try
        {
            var serializer = new JavaScriptSerializer();
            productTags = serializer.Deserialize<List<Dictionary<string, object>>>(tags_json);
            productTags = productTags.OrderBy(x => x.ContainsKey("sort") && x["sort"] != null ? Convert.ToInt32(x["sort"]) : 0).ToList();
        }
        catch { productTags = new List<Dictionary<string, object>>(); }
    }


    string main_cat_title = ""; try { main_cat_title = NewAppFunctions.GetTitleById("Cat", product.maincat_id); } catch { }
    string sub_cat_title = ""; try { sub_cat_title = NewAppFunctions.GetTitleById("Cat", product.sub_cat_id); } catch { }
    string spOffer_cat_title = ""; try { spOffer_cat_title = NewAppFunctions.GetTitleById("Cat", product.spOfferCatId); } catch { }
    string prod_title = product.title + " - תבנית המוצר";

    string headerClass = "CatalogTemplateHeader";

    if (!product.is_catalog)
    {
        prod_title = product.title + " - " + vendor_name;
        headerClass = "CatalogProductHeader";
    }
    int curPad = 5;
    string watermark = "תבנית<br>";

    <div class="page-watermark" style="color:#b200ff;display:none">@Html.Raw(watermark)</div>

    <div style="overflow: auto;text-align: right;background-color: #fff">


        <div class="@headerClass">

            @prod_title
        </div>


        <div class="prodSection">

            <div class="prodSectionTitle">
                <input type="hidden" name="upload_p_id" id="upload_p_id" value="@product_id">

                <form id="picupload" name="picupload" enctype="multipart/form-data">
                    <input class="B" style="float:left" type="button" value="➕" id="ImgUploadBtn" onclick="document.getElementById('picfilebox').click();" />
                    <span id="pbar_txt" style="background-color: #b200ff;color: #fff;float: left;display: none;">0%</span>
                </form>

                תמונות מוצר

            </div>
            <div class="ProductViewImagesContainer" id="ProductImagesContainer">


                @if (files.Count() > 0)
                {
                    int cnt = 0;
                    string imgClass = "ProductViewPrimaryImage";


                    foreach (var item in files)
                    {
                        cnt++;
                        string imgLink = "ImgViewer?Id=" + item.file_id;
                        if (!item.is_primary)
                        {
                            imgClass = "ProductViewSmallImage";
                            imgLink = "ImgViewer?size=tn&Id=" + item.file_id;


                        }

                        if (item.MimeType.StartsWith("image"))
                        {
                            if (item.is_primary)
                            {
                                <div class="B">
                                    <span class="ProductViewImageSpan">

                                        <img class="@imgClass" src="@imgLink" alt="אלט" onclick="sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=0');" />


                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="ProductViewImageSpan">

                                    <img class="@imgClass" src="@imgLink" alt="אלט" onclick="sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=0');" />


                                </span>
                            }

                        }
                    }
                }
                else
                {

                    <span class="ProductViewImageSpan">

                        <img class="ProductViewNoImage" src="~/Images/nopic.jpg" />


                    </span>
                }
            </div>


        </div>


        <div class="B">

            <div class="B">
                <div class="prodSection">
                    <div class="B">
                        <div class="prodSectionTitle">
                            <button type="button" class="B" style="float:left;" id="ProdSettingsViewBtn" onclick="hideElement('ProdSettingsViewBtn');hideElement('ProdSettingsViewDiv');showElement('ProdSettingsEditBtn');showElement('ProdSettingsEditDiv');">⚙️</button>

                            <div style="float:left;display:none" id="ProdSettingsEditBtn">
                                <button type="button" onclick="hideElement('ProdSettingsEditBtn');showElement('ProdSettingsDelConfirm');">
                                    🗑️
                                </button>
                                <button type="button" onclick="AjaxActions('UpdateProductTemplate', '@product_id','MainLoader','UpdateProductTemplate');">
                                    💾
                                </button>
                                <button type="button" onclick="hideElement('ProdSettingsEditBtn');hideElement('ProdSettingsEditDiv');showElement('ProdSettingsViewBtn');showElement('ProdSettingsViewDiv');">
                                    ❎
                                </button>

                            </div>
                            <div style="float:left;display:none;color:#f00;font-weight:bold;" id="ProdSettingsDelConfirm">
                                <input type="checkbox" id="delConfCb" onclick="AjaxActions('MarkProductDeleted', '@product_id','MainLoader', '0'); this.checked = false;" /> <span> בטוח?</span>
                                <button type="button" onclick="hideElement('ProdSettingsDelConfirm'); hideElement('ProdSettingsEditBtn');hideElement('ProdSettingsEditDiv');showElement('ProdSettingsViewBtn');showElement('ProdSettingsViewDiv');">
                                    ❎
                                </button>


                            </div>



                            פרטי המוצר <span class="MiniTag">#@product_id</span>
                        </div>




                    </div>

                    <div class="ProdEditSection" id="ProdSettingsViewDiv">

                        <div class="ProdViewItem">
                            שם המוצר
                            <span class="PPOInfoSpan">
                                @product.title
                            </span>
                        </div>
                        <div class="ProdViewItem">
                            Title
                            <span class="PPOInfoSpan">
                                @product.e_title
                            </span>
                        </div>

                        <div class="ProdViewItem" style="display:none">
                            מחיר מחירון ל<span id="itemunit1">@itemunit</span>
                            <span class="PPOInfoSpan">
                                @product.price.ToString("C", culture)
                            </span>
                        </div>
                        <div class="ProdViewItem" style="display:none">
                            עלות ל<span id="itemunit2">@itemunit</span>
                            <span class="PPOInfoSpan">
                                @product.cost.ToString("C", culture)
                            </span>
                        </div>


                        @if (!String.IsNullOrEmpty(spOffer_cat_title))
                        {
                            <div style="overflow: auto">

                                <div class="ProdViewItem">
                                    מבצעים לפי

                                    <span class="PPOInfoSpan">
                                        @spOffer_cat_title
                                    </span>
                                </div>
                            </div>
                        }





                        <div class="ProdViewItem">
                            הנחות

                            <span class="PPOInfoSpan">
                                @if (product.is_discountable)
                                {<span>✅</span>}

                            </span>
                        </div>



                    </div>

                    <div class="B" style="display:none" id="ProdSettingsEditDiv">

                        <div class="B">


                            <form id="UpdateProductTemplate">
                                <div class="ProdEditSection">
                                    <div class="ProdViewItem">
                                        <input type="checkbox" class="ProdEditCb" onclick="if (this.checked) { AjaxActions('ActivateProduct', @product_id,'', '1'); } else { AjaxActions('ActivateProduct', @product_id, '', '0'); }" @if (product.is_active) { <text> checked</text>}>

                                        פעיל במערכת?
                                    </div>
                                    <div class="ProdViewItem">
                                        <input type="text" class="ProdEditTb" id="title" name="title" value="@product.title">
                                        כותרת עברית <span class="RedMiniTag">*</span>
                                    </div>
                                    <div class="ProdViewItem">
                                        <input type="text" class="ProdEditTb" id="e_title" name="e_title" value="@product.e_title">
                                        English title <span class="RedMiniTag">*</span>
                                    </div>



                                    <div id="ProductSettingsDiv" class="B">

                                        <div class="B">
                                            <div class="ProdViewInfo">

                                                הגדרות מתקדמות
                                            </div>

                                            <div class="B">

                                                <div class="B">







                                                    <div class="B">
                                                        <div class="ProdViewItem">
                                                            <span>
                                                                מוצר מדף
                                                                <span class="PPOInfoSpan">
                                                                    <input type="checkbox" class="ProdEditCb" id="is_generic" name="is_generic" @if (is_generic) { <text> checked </text> }>
                                                                </span>
                                                            </span>
                                                        </div>
                                                        <div class="B">
                                                            <div class="ProdViewItem">
                                                                קטגוריה ראשית
                                                                <input type="hidden" id="main_cat_id" name="main_cat_id" value="@product.maincat_id">
                                                                <span class="PPOInfoSpan">
                                                                    @NewAppFunctions.GetTitleById("Cat", product.maincat_id)
                                                                </span>

                                                            </div>


                                                        </div>
                                                        <div class="B">
                                                            <div class="B" id="SubCatContainer">
                                                                <div class="ProdViewItem">
                                                                    תת קטגוריה
                                                                    <select class="ProdEditSelect" id="sub_cat_id" name="sub_cat_id" onchange="MiscActions('LoadProductCustomFields', '@product_id', document.getElementById('product_type').value, this.value);">
                                                                        <option value="0">ללא</option>
                                                                        @foreach (var cat in SubCategories)
                                                                        {
                                                                            <option value="@cat.id" selected="@(cat.id == sub_cat_id ? "selected" : null)">@cat.title</option>
                                                                        }
                                                                    </select>
                                                                </div>

                                                                <div class="ProdViewItem">
                                                                    קטגורית מבצעים
                                                                    <select class="ProdEditSelect" id="spOfferCatId" name="spOfferCatId">
                                                                        <option value="-1">ללא</option>
                                                                        @foreach (var cat in spOfferCategries)
                                                                        {
                                                                            <option value="@cat.id" selected="@(cat.id == spOfferCatId ? "selected" : null)">@cat.title</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <div class="ProdViewItem">
                                                                    סוג המוצר
                                                                    <select class="ProdEditSelect" id="product_type" name="product_type" onchange="MiscActions('LoadProductCustomFields','@product_id', this.value, document.getElementById('sub_cat_id').value);">
                                                                        @foreach (var p_t in ProductTypes)
                                                                        {
                                                                            <option value="@p_t.id" selected="@(p_t.id == product_type ? "selected" : null)">@p_t.title</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>






                                                    </div>
                                                </div>





                                                <div class="Spacer10"></div>
                                                <div class="B" id="ProductCustomFieldsDiv">
                                                    @Products.ProductCustomFields(product_id, product_type)
                                                </div>



                                                <div class="B">
                                                    <b>הגדרות פיננסיות</b>
                                                </div>
                                                <div class="ProdViewItem">
                                                    מחיר מחירון
                                                    <span class="MiniTag">(₪/<span id="itemunit2">@itemunit</span>)</span>
                                                    <span class="ProdEditSmallSpan" style="float: left">
                                                        <input type="text" id="price" name="price" class="ProdEditTbSmall" value="@product.price.ToString("F2")" onfocus="this.value = '';">

                                                    </span>
                                                </div>
                                                <div class="ProdViewItem">
                                                    מחיר עלות
