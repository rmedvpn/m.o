                    <div class="spinner" style="text-align: center;display: none;float: left" id="AddProductLoader">
                        <div class="bounce1"></div>
                        <div class="bounce2"></div>
                        <div class="bounce3"></div>
                    </div>
                </div>
                <button style="display: none;" id="AddPricingOptionAcc"></button>
                <div class="panel" style="padding: 0;margin: 0;text-align: center">

                    <div id="AddPricingOptionsContainer">
                        @Products.AddProductPricingOption(product_id)
                    </div>

                </div>
                <div id="PricingOptionsContainer">
                    @Products.ProductPricingOptions(product_id)
                </div>

            </div>
            <div class="B" style="height:100px;">&nbsp;</div>
        </div>

        <div style="overflow: auto;display: none" id="ActiveProductsDiv_@product_id">
            <div style="overflow: auto;">
              
         

                <div id="SubProductsContainer">
                    @Products.RoundsProductAvailability(product_id)
                </div>


            </div>
        </div>


        <div style="overflow: auto;height: 100px;">&nbsp;</div>

    </div>
    db.Close();
}


@helper ViewProduct(int product_id,string viewMode="")
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
var db = Database.Open("op_data");
var sqlSelect = "SELECT * FROM products WHERE p_id=@0";
var product = db.QuerySingle(sqlSelect, product_id);
bool is_catalog = false;
try { is_catalog = product.is_catalog; } catch { }
bool is_setup = false;
try { is_setup = product.is_setup; } catch { }
bool init_complete = false;
try { init_complete = product.init_complete; } catch { }
bool is_generic = false;
try { is_generic = product.is_generic; } catch { }
string vendor_name = ""; try { vendor_name = AppFunctions.GetVendorTitleById(product.v_id); } catch { }

bool is_editable = true;
if(is_generic && !is_catalog)
{
    is_editable = false;
}


int itemunit_type = 0;
try { itemunit_type = product.itemunit_type; } catch { }
string itemunit = "";
itemunit = product.itemunit;

int maincat_id = 0; try { maincat_id = product.maincat_id; } catch { }

sqlSelect = "SELECT * FROM productTags WHERE p_id=@0";
var productTags = db.Query(sqlSelect,  product_id);

sqlSelect = "SELECT * FROM  ProductsCustomFields WHERE p_id=@0  ORDER BY listindex";
var customFields = db.Query(sqlSelect, product_id);

sqlSelect = "SELECT * FROM ProductPricingOptions WHERE p_id=@0  ORDER BY is_catalog DESC,round_id DESC,quan,price";
var PricingOptions = db.Query(sqlSelect, product_id);

sqlSelect = "SELECT rounds.title,roundMenuItems.id FROM Rounds INNER JOIN roundMenuItems ON rounds.id=roundMenuItems.round_id WHERE roundMenuItems.p_id=@0";
if (is_catalog)
{
    sqlSelect = "SELECT rounds.title,roundMenuItems.id FROM Rounds INNER JOIN roundMenuItems ON rounds.id=roundMenuItems.round_id WHERE roundMenuItems.catalog_p_id=@0";
}


var rounds = db.Query(sqlSelect, product_id);

sqlSelect = "Select mimeType,File_id,is_primary From ProductImages Where is_deleted=0 AND product_id = @0 ORDER BY is_primary DESC,timestamp DESC";
var files = db.Query(sqlSelect, product_id);

int strain_type = 0; try { strain_type = product.strain_type; } catch { }
string strain_type_title = ""; try { strain_type_title = product.strain_type_title; } catch { }

string prod_code = ""; try { prod_code = product.prod_code; } catch { }

bool sell_1s = false; try { sell_1s = product.sell_1s; } catch { }
bool sell_3s = false; try { sell_3s = product.sell_3s; } catch { }
bool sell_5s = false; try { sell_5s = product.sell_5s; } catch { }
int sell_inXs = 0; try { sell_inXs = product.sell_inXs; } catch { }

string MainInfoDivDisplayState = "block;";
string PricingDivDisplayState = "none;";

string sell_1s_display_state = "none";
string sell_Xs_display_state = "block";

if (sell_1s) { sell_1s_display_state = "block;"; sell_Xs_display_state = "none;"; }
if (viewMode == "PRICE")
{
    MainInfoDivDisplayState = "none;";
    PricingDivDisplayState = "block;";
}

string main_cat_title = ""; try { main_cat_title = NewAppFunctions.GetTitleById("Cat", product.maincat_id); } catch { }
string sub_cat_title = ""; try { sub_cat_title = NewAppFunctions.GetTitleById("Cat", product.sub_cat_id); } catch { }
string spOffer_cat_title = ""; try { spOffer_cat_title = NewAppFunctions.GetTitleById("Cat", product.spOfferCatId); } catch { }

string prod_title = product.title + " - " + vendor_name;
if (is_catalog) { prod_title = product.title + " - קטלוג"; }



<div style="overflow: auto;text-align: right;background-color: #fff">
        <div class="B" style="color: #fff; background-color: #000; padding: 5px; ">
            <div class="B" style="float:right">
                <div class="B" style="font-size: 24px;padding:0">

                    @if (is_generic)
                    {
                        <span class="PViewGenericFlag">🔒</span>
                    }

                    @prod_title 
                </div>
            </div>
            

            <span class="YellowMiniTag" style="float:left;margin-left:30px;">מוצר #@product.p_id </span>

            
        </div>


        <div class="B" style="background-color:#e3e3e3">
            <div style="float: right; padding: 5px; font-weight: bold;">
                <input type="checkbox" onclick="if (this.checked) { AjaxActions('ActivateProduct', @product_id,'', '1'); } else { AjaxActions('ActivateProduct', @product_id, '', '0'); }" @if (product.is_active) { <text> checked</text>}> מוצר פעיל
            </div>
            <div style="float:left;padding:5px;font-weight:bold;">
                @main_cat_title

                @if (!String.IsNullOrEmpty(sub_cat_title))
                {
                    <span>
                        - @sub_cat_title
                    </span>
                }

            </div>


        </div>



            <div class="ProductViewImagesContainer">

                @if (is_editable)
    {
       <button type="button" class="B" style="float:left" onclick="sbload('GenSb','Caller?p1=EditCatalogProduct&p2=@product_id');">⚙️</button>
    }

                @if (files.Count() > 0)
                {
                    int cnt = 0;
                    string imgClass = "ProductViewPrimaryImage";


                    foreach (var item in files)
                    {
                        cnt++;
                        string imgLink = "ImgViewer?Id=" + item.file_id;
                        if (!item.is_primary)
                        {
                            imgClass = "ProductViewSmallImage";
                            imgLink = "ImgViewer?size=tn&Id=" + item.file_id;


                        }

                        if (item.MimeType.StartsWith("image"))
                        {
                            if (item.is_primary)
                            {
                                <div class="B">
                                    <span class="ProductViewImageSpan">

                                        <img class="@imgClass" src="@imgLink" alt="אלט" onclick="sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=1');" />


                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="ProductViewImageSpan">

                                    <img class="@imgClass" src="@imgLink" alt="אלט" onclick="sbload('SubMenuLeft','Caller?p1=ImgInfo&p2=@product_id&p3=@item.file_id&p4=1');" />


                                </span>
                            }

                        }
                    }
                }
                else
                {

                    <span class="ProductViewImageSpan">

                        <img class="ProductViewNoImage" src="~/Images/nopic.jpg" />


                    </span>
                }
            </div>

            <div class="B" style="padding:20px;">

                <div class="B">
                    <div class="B">
                        <div class="B" style="text-align:center;">

                            <div class="ProdViewInfo">
                                <span style="float:right">
                                    @product.title
                                </span>
                                <span style="float:left">
                                    @product.e_title
                                </span>


                            </div>




                        </div>

                        <div style="overflow: auto;color: #000;padding: 5px;">

                            <div class="ProdViewItem">
                                מחירון
                                <span class="PPOInfoSpan">
                                    @product.price.ToString("C", culture) ל<span id="itemunit1">@itemunit</span>
                                </span>
                            </div>
                            <div class="ProdViewItem">
                                עלות
                                <span class="PPOInfoSpan">
                                    @product.cost.ToString("C", culture) ל<span id="itemunit2">@itemunit</span>
                                </span>
                            </div>
                            <div class="ProdViewItem">
                                עמלה
                                <span class="PPOInfoSpan">
                                    @product.commision_rate.ToString("C", culture) ל<span id="itemunit">@itemunit</span>
                                </span>

                            </div>

                            @if (!String.IsNullOrEmpty(spOffer_cat_title))
                            {
                                <div style="overflow: auto">

                                    <div class="ProdViewItem">
                                        מבצעים לפי

                                        <span class="PPOInfoSpan">
                                            @spOffer_cat_title
                                        </span>
                                    </div>
                                </div>
                            }



                            @if (strain_type > 0)
                            {
                                <div class="ProdViewItem">
                                    סוג צמח
                                    <span class="PPOInfoSpan">
                                        @product.strain_type_title


                                    </span>
                                </div>
                            }



                            <div class="ProdViewItem">
                                הנחות

                                <span class="PPOInfoSpan">
                                    @if (product.is_discountable)
                                    {<span>✅</span>}

                                </span>
                            </div>
                            <div class="ProdViewItem">
                                קהילה
                                <span class="PPOInfoSpan">
                                    @if (product.CharityOffersOk)
                                    {<span>✅</span>}
                                </span>
                            </div>

                            @foreach (var field in customFields)
                            {
                                string fieldValue = ProductsFunctions.GetCustomFieldValue(field, is_catalog);
                                <div class="ProdViewItem">
                                    @field.title
                                    <span class="PPOInfoSpan">
                                        @fieldValue

                                    </span>
                                </div>
                            }

                        </div>


                    </div>





                    <div class="Spacer20">&nbsp;</div>


                    <div style="overflow: auto;" id="ProductPricingDiv_@product_id">
                        <div class="B">
                            <div class="ProdViewInfo">
                                מחירון

                            </div>

                            <div id="PricingOptionsContainer">



                                <div class="B">
                                    @foreach (var priceOption in PricingOptions)
                                    {
                                        bool is_activated = false; is_activated = priceOption.is_activated;
                                        if (is_activated)
                                        {
                                            bool is_spOffer = priceOption.is_spOffer;
                                            bool is_catalog_option = priceOption.is_catalog;
                                            bool is_fav = false; is_fav = priceOption.is_fav;



                                            <div class="ProdViewItem" style="text-align:center;">
                                                <div class="PPOItem">@Convert.ToInt32(priceOption.quan) @itemunit</div>
                                                <div class="PPOValue">
                                                    @Convert.ToInt32(priceOption.price) ₪
                                                </div>
                                                @if (priceOption.round_id > 0 && priceOption.round_id < 99999)
                                                {
                                                    <div class="PPOInfo"><span>@AppFunctions.GetRoundTitleById(priceOption.round_id) בלבד</span></div>
                                                }

                                            </div>
                                        }






                                    }
                                </div>


                            </div>

                        </div>

                    </div>

                    <div class="B">

                        <div class="B">
                            <div class="Spacer20">&nbsp;</div>

                            <div class="ProdViewInfo">
                                זמינות

                            </div>
                            @if (rounds.Count() > 0)
                            {

                                <div style="overflow: auto;">

                                    <div class="B">
                                        <div class="B">

                                            @foreach (var round in rounds)
                                            {
                                                <div class="ProdViewItem">
                                                    @round.title
                                                </div>
                                            }

                                        </div>
                                    </div>


                                </div>

                            }
                            else
                            {
                                <div class="B">
                                    <div class="ProdViewItem">
                                        המוצר לא נמכר באף תפריט כרגע
                                    </div>

                                </div>
                            }
                        </div>
                    </div>


                    <div class="B">


                        @if (productTags.Count() > 0)
                        {
                            <div class="Spacer20">&nbsp;</div>

                            <div class="B">
                                <div class="ProdViewInfo">
                                    תגיות

                                </div>
                                <div class="B" style="text-align:center;">

                                    @foreach (var pt in productTags)
                                    {
                                        <div class="PviewTag">@pt.title</div>
                                    }
                                </div>
                            </div>
                        }




                    </div>


                    @if (!String.IsNullOrEmpty(product.description))
                    {
                        <div class="Spacer20">&nbsp;</div>
                        <div class="B">
                            <div class="ProdViewInfo">
                                תאור
                            </div>
                            <div class="ProdViewDesc">
                                @product.description
                            </div>
                        </div>
                    }
                    @if (!String.IsNullOrEmpty(product.e_desc))
                    {
                        <div class="Spacer20">&nbsp;</div>
                        <div class="B" style="text-align:left;">
                            <div class="ProdViewInfo">
                                Description
                            </div>
                            <div class="ProdViewDesc">
                                @product.e_desc
                            </div>
                        </div>
                    }


                </div>


                <div class="Spacer100">&nbsp;</div>
                <div class="Spacer100">&nbsp;</div>

            </div>
        </div>
    db.Close();
}



@helper CatalogProductSetup(int product_id)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
var db = Database.Open("op_data");
var sqlSelect = "SELECT * FROM products WHERE p_id=@0";
var product = db.QuerySingle(sqlSelect, product_id);
bool is_catalog = false;
try { is_catalog = product.is_catalog; } catch { }
bool is_setup = false;
try { is_setup = product.is_setup; } catch { }
int itemunit_type = 0;
try { itemunit_type = product.itemunit_type; } catch { }
sqlSelect = "SELECT * from ItemUnitTypes";
var itemUnitTypes = db.Query(sqlSelect);
string itemunit = "";
itemunit = product.itemunit;

sqlSelect = "SELECT * from StrainTypes ORDER BY strain_type";
