                                @if (product.maincat_id != 0)
                                {
                                    <div>@Products.LoadSubCatSelector(product.maincat_id, product.p_id)</div>
                                }
                            </div>
                        </div>


                        <div style="overflow: auto">
                            <div style="float: right;border-bottom: 1px dotted #000" id="CatTagsContainer">
                                @if (product.maincat_id != 0)
