                                    bool is_active = false; try { is_active = optItem.is_active; } catch { }
                                    decimal option_price = 0; try { option_price = optItem.option_price; } catch { }
                                    string optPriceStr = "";
                                    string optColor = "#000";

                                    if (optItem.option_price != 0)
                                    {
