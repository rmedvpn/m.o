@helper AllProducts(string listType = "CATALOG",int vendor_id=0 ,bool ActiveOnly = false)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var db = Database.Open("op_data");
var sqlSelect = "";
string listTitle = "";
int itemsCnt = 0;

int activeCnt = 0;
int catalogCnt = 0;
int deletedCnt = 0;
int inActiveCnt = 0;
int curCat = 0;

bool showAddBtn = true;

sqlSelect = "SELECT vendor_id,vendor_name FROM vendors order by vendor_id";
var vendors = db.Query(sqlSelect);

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=0";

if (vendor_id > 0)
{
    sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE (is_active=1 OR is_setup=0) AND v_id=@0";
}
var cntRS = db.QuerySingle(sqlSelect,vendor_id);
try { activeCnt = cntRS.the_cnt; } catch { }

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=1";
cntRS = db.QuerySingle(sqlSelect);
try { catalogCnt = cntRS.the_cnt; } catch { }

sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE is_active=0";
cntRS = db.QuerySingle(sqlSelect);
try { inActiveCnt = cntRS.the_cnt; } catch { }



sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM DeletedProducts";
cntRS = db.QuerySingle(sqlSelect);
try { deletedCnt = cntRS.the_cnt; } catch { }

if(listType=="VENDOR" && vendor_id == 0)
{
    listType = "ACTIVE";
}

switch (listType)
{
    case "ACTIVE":
        sqlSelect = "SELECT * FROM products WHERE (is_active=1 AND is_setup=1) AND is_catalog=0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "כל המוצרים הפעילים";
        itemsCnt = activeCnt;
        break;
    case "VENDOR":
        sqlSelect = "SELECT * FROM products WHERE (is_active=1 OR is_setup=0) AND v_id=@0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "תפריט מוצרים - " + AppFunctions.GetVendorTitleById(vendor_id);
        itemsCnt = activeCnt;
        break;
    case "INACTIVE":
        sqlSelect = "SELECT * FROM products WHERE is_active=0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "מוצרים לא פעילים";
        itemsCnt = inActiveCnt;
        showAddBtn = false;
        break;

    case "CATALOG":
        sqlSelect = "SELECT * FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=1 ORDER BY maincat_id,sub_cat_id, is_setup,p_id DESC";
        listTitle = "קטלוג ראשי";
        itemsCnt = catalogCnt;
        break;
    case "DELETED":
        sqlSelect = "SELECT * FROM DeletedProducts ORDER BY p_id DESC";
        listTitle = "מוצרים שנמחקו";
        itemsCnt = deletedCnt;
        showAddBtn = false;
        break;
}
var Products = db.Query(sqlSelect,vendor_id);


int cur_main_cat = -1;
int cur_sub_cat = -1;

    <div style="overflow: auto;background-color: #fff">
        <input type="hidden" name="is_all_products" id="is_all_products" value="1">
        <input type="hidden" name="listType" id="listType" value="@listType">
        <input type="hidden" name="listType" id="vendor_id" value="@vendor_id">
        <div style="overflow: auto">
            <div style="overflow: auto;font-size: 24px;color: #000;padding: 5px;margin: 5px;">


                <select class="StdSelect" onchange="if (this.value > 0) { RepAjaxUpdate('LoadProductsList', 'MainBoardContainer', 'MainLoader', 'VENDOR', this.value); currentProductsView = 'VENDOR'; } else { RepAjaxUpdate('LoadProductsList', 'MainBoardContainer', 'MainLoader', this.value); currentProductsView = this.value; } ">

                    <option value="CATALOG" @if (listType == "CATALOG") { <text> selected</text>}>קטלוג ראשי</option>
                    <option value="ACTIVE" @if (listType == "ACTIVE") { <text> selected</text>}>מוצרים פעילים</option>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.vendor_id" @if (v.vendor_id == vendor_id) { <text> selected</text>}>@v.vendor_name</option>
                    }
                    <option value="INACTIVE" @if (listType == "INACTIVE") { <text> selected</text>}>מוצרים לא פעילים</option>
                    <option value="DELETED" @if (listType == "DELETED") { <text> selected</text>}>מוצרים מחוקים</option>

                </select>

                @if (showAddBtn)
                {
                

                    <button type="button" class="StdBtn" onclick="sbload('GenSb','Caller?p1=AddNewProduct');AdjustMainView();">+ מוצר חדש</button>

                }

                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#e3e3e3;color: #808080;padding: 5px;margin: 5px;display:none;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','DELETED');currentProductsView = 'DELETED';"><span style="float:left;background-color: #fff;color: #808080;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@deletedCnt</b> </span>מחוקים</button>
                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#57d600;color: #fff;padding: 5px;margin: 5px;display:none;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','ACTIVE');currentProductsView = 'ACTIVE'"><span style="float:left;background-color: #fff;color: #57d600;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@activeCnt</b> </span>פעילים</button>
                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#b200ff;color: #fff;padding: 5px;margin: 5px;display:none;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','CATALOG');currentProductsView = 'CATALOG';"><span style="float:left;background-color: #fff;color: #b200ff;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@catalogCnt</b> </span>קטלוג</button>
                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#808080;color: #fff;padding: 5px;margin: 5px;display:none;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','INACTIVE');currentProductsView = 'INACTIVE';"> <span style="float:left;background-color: #fff;color: #808080;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@inActiveCnt</b> </span>לא פעילים</button>

                <span class="StdTitle">@listTitle</span> <span class="MiniTag">@itemsCnt מוצרים</span>



            </div>


            <center>
                <div style="overflow: auto;clear: both;width:80%">

                    <div style="overflow: auto;clear: both;">
                        @foreach (var product in Products)
                        {
                            bool is_setup = false; try { is_setup = product.is_setup; } catch { }
                            string bgColor = "#fff";
                            string cur_main_cat_name = "";
                            string cur_sub_cat_name = "";


                            sqlSelect = " SELECT * FROM products WHERE is_active=1 AND is_Catalog=0 AND Catalog_p_id=@0 ORDER BY v_id";
                            var subProducts = db.Query(sqlSelect, product.p_id);

                            if (cur_main_cat != product.maincat_id)
                            {
                                cur_main_cat = product.maincat_id;
                                cur_sub_cat = -1;
                            }
                            if (cur_sub_cat != product.sub_cat_id)
                            {
                                cur_sub_cat = product.sub_cat_id;

                            }

                            try { cur_main_cat_name = NewAppFunctions.GetTitleById("Cat", cur_main_cat); } catch { }
                            try { cur_sub_cat_name = NewAppFunctions.GetTitleById("Cat", cur_sub_cat); } catch { }

                            if (!is_setup)
                            {
                                bgColor = "#ffffcc";
                                cur_main_cat_name = "";
                                cur_sub_cat_name = "";
                            }

                            if (curCat != cur_main_cat)
                            {
                                curCat = cur_main_cat;
                                <div style="overflow:auto;margin-right:10px;padding:5px;font-size:18px;color:white;background-color:#808080">@cur_main_cat_name</div>

                            }



                            <div style="overflow: auto;font-size: 16px;color: #000;">


                                <div style="border-radius: 5px; border: 2px solid #e3e3e3; padding: 5px; margin: 5px; overflow: auto; background-color: @bgColor" id="Prod_@product.p_id">

                                    <div class="B">
                                        <img class="ProdImg_A" src="ImgViewer?size=tn&p_id=@product.p_id" alt="אלט" />

                                        @if (listType != "DELETED")
                                        {
                                            <button style="float: left;padding: 5px;font-size: 24px;background: transparent;border: 0;margin: 5px" onclick="MiscActions('SelectEntry','Prod_@product.p_id');sbload('GenSb','Caller?p1=ProductEdit&p2=@product.p_id');AdjustMainView();">⚙️</button>
                                            <button style="float: left; padding: 5px; font-size: 16px; background-color: #fff; border: 2px solid #808080; border-radius: 5px; margin: 5px; color: #808080; display: none" onclick="MiscActions('SelectEntry','Prod_@product.p_id');sbload('GenSb','Caller?p1=ProductEdit&p2=@product.p_id&p3=PRICE');AdjustMainView();">מחירון</button>
                                        }


                                        @if (subProducts.Count > 0)
                                        {
                                            <div class="ProductsListSubProducts" onclick="Accordionize('prodAcc_@product.p_id');" style="display:none">
                                                @subProducts.Count מוצרים פעילים
                                            </div>
                                        }

                                        <div class="B" style="text-align:right">
                                            <div class="B" style="font-size:24px;text-align:right">
                                                <b>@product.title</b>

                                            </div>


                                            <div class="B" style="font-size: 14px;float: right">


                                                <div class="B">


                                                    <div class="B">
                                                        <span style="display:none">
                                                            @if (cur_main_cat == 0)
                                                            {
                                                                if (is_setup)
                                                                {
                                                                    <span class="RedMiniTag" style="font-size:14px;">ללא  קטגוריה</span>
                                                                }

                                                            }
                                                            else
                                                            {<span class="GrayMiniTag" style="font-size:14px;">@cur_main_cat_name</span>}
                                                        </span>


                                                        @if (cur_sub_cat == 0)
                                                        {
                                                            if (is_setup)
                                                            {
                                                                <span class="RedMiniTag" style="font-size:14px;">ללא תת קטגוריה</span>}
                                                        }
                                                        else
                                                        {<span class="MiniTag" style="font-size:14px;">@cur_sub_cat_name</span>}
                                                    </div>
                                                    <div class="B">


                                                        <div style="display:none">
                                                            @if (product.is_catalog)
                                                            {
                                                                <span class="PrplMiniTag">מוצר קטלוגי #@product.p_id</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="GrayMiniTag">מוצר ספק #@product.p_id</span>
                                                            }

                                                        </div>
                                                      

                                                        @if (product.v_id != 0)
                                                        {
                                                            <span class="PrplMiniTag">@AppFunctions.GetVendorTitleById(product.v_id)</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    @if (subProducts.Count > 0)
                                    {
                                        <center>
                                            <div class="B" style="width:90%">
                                                <button class="Accordion" style="display: none" id="prodAcc_@product.p_id"></button>
                                                <div class="panel" style="padding: 0;margin: 0;">
                                                    <div class="A" style="background-color:#e3e3e3;border-radius:5px;text-align:right">
                                                        @foreach (var subProd in subProducts)
                                                        {
                                                            string vendor_name = AppFunctions.GetVendorTitleById(subProd.v_id);

                                                            <div class="B" style="border-bottom:1px dotted #808080;vertical-align:middle">
                                                                <img class="ProdImg_small" src="ImgViewer?size=tn&p_id=@subProd.p_id" alt="אלט" />
                                                                <div class="B" style="float:right">
                                                                    <div class="B">
                                                                        <b>@subProd.title</b>

                                                                    </div>
                                                                    <div class="B">
                                                                        <span class="PrplMiniTag">@vendor_name  <span class="GrayMiniTag" style="font-size:10px">(מוצר #@subProd.p_id)</span></span>
                                                                    </div>
                                                                </div>
                                                                <button style="float: left;padding: 5px;font-size: 16px;margin:5px;" onclick="sbload('GenSb','Caller?p1=ProductEdit&p2=@subProd.p_id');AdjustMainView();">עריכה</button>
                                                                <button style="float: left;padding: 5px;font-size: 16px;margin:5px;" onclick="sbload('GenSb','Caller?p1=ProductEdit&p2=@subProd.p_id&p3=PRICE');AdjustMainView();">מחירון</button>


                                                            </div>
                                                        }

                                                    </div>
                                                </div>

                                            </div>
                                        </center>


                                    }


                                </div>

                            </div>
                        }
                    </div>




                </div>
            </center>
            

        </div>




        <div style="overflow: auto;height: 100px;">&nbsp;</div>
    </div>
    <div style="overflow: auto;height: 150px;">&nbsp;</div>

    db.Close();
}

@helper ProductEditSwitch(int product_id,string viewMode="")
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT is_catalog,is_setup,is_generic,init_complete FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);
    bool is_catalog = false;  try { is_catalog = product.is_catalog; } catch { }
    bool is_setup = false;     try { is_setup = product.is_setup; } catch { }
    bool init_complete = false;     try { init_complete = product.init_complete; } catch { }
    bool is_generic = false;     try { is_generic = product.is_generic; } catch { }

    <div style="overflow: auto; text-align: right; background-color: #fff; direction: rtl; color: #000">
        @Products.ViewProduct(product_id, viewMode)
    </div>

    <div style="overflow: auto;text-align: right;background-color: #fff;direction:rtl;display:none">
        @if (is_setup)
        {
            if (is_catalog)
            {
                <div style="color: #000">Products.EditCatalogProduct(product_id, viewMode)</div>
            }
            else
            {
                if (is_generic)
                {
                    <div style="color: #000">Products.ViewProduct(product_id, viewMode)</div>
                }
                else
                {
                    <div style="color: #000">Products.EditProduct(product_id, viewMode)</div>
                }

            }
        }
        else
        {
            if (is_catalog)
            {
                if (init_complete)
                {
                    <div style="color: #000">Products.EditCatalogProduct(product_id, viewMode)</div>
                }
                else
                {
                    <div style="color: #000">Products.CatalogProductSetup(product_id)</div>
                }

            }
            else
            {
                <div style="color: #000">Products.EditProduct(product_id)</div>
            }
        }



    </div>
    <div style="overflow: auto;height: 50px;">&nbsp;</div>

    db.Close();
}



