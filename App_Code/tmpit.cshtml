                                {
                                    try { commision = OrderFunctions.CalculateOrderComission(order.order_id); } catch { }
                                }
                                <div class="zReportRowHeader">
                                    <div style="overflow:auto">
                                        <div class="zReportRowItem">
                                            @order.nick_name
                                            <br />
                                            <div style="font-size: 12px; overflow: auto; float: right">
                                                הזמנה #@order.order_id   @order.ship_city
                                            </div>
                                        </div>
                                        <div class="zReportRowResult">@commision.ToString("C", culture)</div>
                                    </div>
                                    <center>
                                        <div style="overflow: auto; padding: 10px; font-size: 12px; width: 50%; background-color: #e3e3e3; margin: 10px; border: 1px dotted #808080; border-radius:5px">
                                            @if (orderitems.Count > 0)
                                            {
                                                foreach (var orderitem in orderitems)
                                                {

                                                    if (orderitem.item_id > -2)
                                                    {
                                                        <div style="overflow:auto;padding:5px;margin:5px;font-size:12px;border-bottom:1px dashed #808080">
                                                            <div class="zReportRowItem">
                                                                @orderitem.title

                                                                @if (orderitem.item_id > 0)
                                                                {
                                                                    <span style="font-size: 12px; ">
                                                                        (@orderitem.quan @orderitem.itemunit)
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="font-size: 12px;color:#808080 ">
                                                                        (מבצע)
                                                                    </span>
                                                                }

                                                            </div>
                                                            <div class="zReportRowResult">@orderitem.commision.ToString("C", culture)</div>
                                                        </div>
                                                    }

                                                }
                                            }
                                            else
                                            {
                                                <div style="overflow:auto;padding:5px;margin:5px;font-size:12px;color:#ff6a00">
                                                    -- אין פריטים חייבים בעמלה --
                                                </div>
                                            }

                                        </div>

                                    </center>
                                </div>

                            }

                        </div>
                    </div>


                </center>



            </div>





        </div>


        <div style="overflow:auto;height:250px;">&nbsp;</div>



    }
    db.Close();
}


@helper DeliveryInfo(int delivery_id)
{

    DateTime local_time = AppFunctions.LocalTime();
    int round_id = 0;
    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    var db = WebMatrix.Data.Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT * FROM deliveries WHERE serial=@0";
    var delivery = db.QuerySingle(sqlSelect, delivery_id);
    if (delivery != null)
    {
        round_id = delivery.round_id;

        sqlSelect = "SELECT active_delivery_id,vendor_id,title FROM rounds WHERE id=@0";
        var round = db.QuerySingle(sqlSelect, round_id);
        int vendor_id = 0; try { vendor_id = round.vendor_id; } catch { }
        int active_delivery_id = 0; try { active_delivery_id = round.active_delivery_id; } catch { }
        string round_title = ""; try { round_title = round.title; } catch { }


        sqlSelect = "SELECT * FROM routes WHERE delivery_id=@0 ORDER BY route_id";
        var routes = db.Query(sqlSelect, delivery_id);

        sqlSelect = "SELECT * FROM VendorAddresses WHERE vendor_id=@0";
        var VendorAddresses = db.Query(sqlSelect, vendor_id);
        int cur_route_id = 0;
        bool is_active_delivery = false;
        string bgColor = "#ffffff";

        sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE is_cancelled=0 AND delivery_id=@0"; // order by is_approved, order_id DESC";
        var current_orders = db.QuerySingle(sqlSelect, delivery_id);
        int delivery_orders_counter = 0; try { delivery_orders_counter = current_orders.the_cnt; } catch { }


        sqlSelect = "select * from TeamMembersInRounds WHERE round_id=@0 AND permission_code='ROUNDTEAMLEADER'";
        var RoundTeamLeaders = db.Query(sqlSelect, round_id);
        sqlSelect = "select * from TeamMembersInRounds WHERE round_id=@0 AND permission_code='ROUNDPACK'";
        var RoundPackers = db.Query(sqlSelect, round_id);
        is_active_delivery = false;
        bgColor = "#e3e3e3";
        if (delivery_id == active_delivery_id && delivery_id > 0)
        {
            is_active_delivery = true;
            bgColor = "#fff";
        }

        string OrderCountClass = "NoOrders";
        string tmpOrdersList = "";
