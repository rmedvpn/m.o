        bool is_open_tommorow = false; if (!Request["is_open_tommorow"].IsEmpty()) { is_open_tommorow = true; }
        bool is_zed_reopen = true;
        DateTime next_z_date = main_z_date.AddDays(1);

        if (!is_close_orders)
        {
            if (z_orders_action == "")
            {
                theHtmlOutput = "חובה לבחור מה לעשות עם ההזמנות!";
            }
        }

        // theHtmlOutput = z_orders_action;

        if (theHtmlOutput == "")
        {
            int main_orders_count = 0;
            int main_transfered_to_next_z_count = 0;
            decimal main_total_sales = 0;
            decimal main_total_pick_up = 0;
            decimal main_total_commision = 0;
            decimal main_returns_amount = 0;
            int main_cancel_count = 0;

            int main_delivery_count = 0;
            int main_non_delivery_count = 0;
            int main_returns_count = 0;
            int main_exchanges_count = 0;
