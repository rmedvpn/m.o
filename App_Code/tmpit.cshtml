                                {
                                    cur_vendor_id = zRep.vendor_id;
                                    <tr>
                                        <td colspan="999" class="zReportRowHeader">
                                            <b>@AppFunctions.GetVendorTitleById(cur_vendor_id)</b>
                                        </td>
                                    </tr>
                                    <tr style="overflow: auto;font-size:12px;">

                                        <td class="zReportCell"><span class="PrplMiniTag">#Z</span></td>
                                        <td class="zReportCell"><span class="PrplMiniTag">ערוץ</span></td>
                                        <td class="zReportCell"><span class="PrplMiniTag">משלוח</span></td>
                                        <td class="zReportCell"><span class="PrplMiniTag">תאריך Z</span></td>
                                        <td class="zReportCell"><span class="PrplMiniTag">הזמנות</span></td>
                                        <td class="zReportCell"><span class="PrplMiniTag">מכירות</span></td>
                                        <td class="zReportCell"><span class="PrplMiniTag">עמלה</span></td>
                                        <td class="zReportCell" style="width:200px;"></td>

                                    </tr>
                                }


                                <tr style="overflow: auto;font-size:14px;color:@forecolor">

                                    <td class="zReportCell" style="width:30px;"><span class="GrayMiniTag">@zRep.serial</span></td>
                                    <td class="zReportCell"><b>@zRep.round_title</b></td>
                                    <td class="zReportCell">
                                        @if (z_delivery_id > 0)
                                        {
                                            <span class="MiniTag">✅</span>
                                        }
                                        else
                                        {
                                            if (round_type == 1)
                                            {
                                                <span class="MiniTag">❌</span>
                                            }
                                            else
                                            {
                                                <span class="GrayMiniTag">-</span>
                                            }
                                        }


                                    </td>



                                    <td class="zReportCell" style="color:@date_color;">@zRep.z_date.ToShortDateString()</td>
                                    <td class="zReportCell">@z_orders_count</td>
                                    <td class="zReportCell">@z_total_sales.ToString("C", culture)</td>
                                    <td class="zReportCell">@z_total_commision.ToString("C", culture) <span class="PrplMiniTag" style="display:none">@String.Format("{0:0.00}", commision_percantage)%</span></td>
                                    <td class="zReportCell">
                                        @if (is_active_z)
                                        {
                                            <button type="button" class="zReportAction" style="color:#57d600" onclick="RepAjaxUpdate('CloseRoundZReport', 'MainBoardContainer', 'MainLoader', @zRep.round_id);">✅ סגירת Z</button>
                                        }

                                        <button type="button" class="zReportAction" style="display:none" onclick="PageNavigator('ZREPORT',@zRep.serial)">📋</button>
                                        <button type="button" class="zReportAction" style="color:#57d600" onclick="sbload('GenSb','Caller?p1=ZREPORT&p2=@zRep.serial');AdjustMainView();">📋</button>
                                    </td>


                                </tr>


                            }

                        </table>


                    </div>




                </div>
            </center>




        </div>





    </div>


    <div style="overflow:auto;height:250px;">&nbsp;</div>



    db.Close();
}



@helper ActiveZSummary()
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";
    DateTime local_time = AppFunctions.LocalTime();
    DateTime defDate = Convert.ToDateTime("1/1/1900");

    DateTime main_z_date = defDate;
    DateTime next_z_date = defDate;
    int vendor_id = 0;
    int round_id = 0;
    int cur_vendor_id = 0;
    int main_z_id = 0;

    bool is_clear_for_close = true;

    string zCloseApprovalDivDisplayState = "none;";
    string zCloseWarningDivDisplayState = "none;";

    sqlSelect = "SELECT top(1) z_id,serial,z_date FROM ZREPORTS WHERE is_main_z=1 AND is_active=1 ORDER BY z_date DESC";
    var main_z = db.QuerySingle(sqlSelect);
    try { main_z_date = main_z.z_date; } catch { }
    try { main_z_id = main_z.z_id; } catch { }


    sqlSelect = "SELECT id,vendor_id,z_id,title,round_type,z_serial FROM rounds WHERE is_active=1 ORDER BY vendor_id,z_id DESC";
    var rounds = db.Query(sqlSelect);

    <div style="max-height: 95%;overflow: auto;direction:rtl">
        <div style="overflow: auto; -webkit-overflow-scrolling: touch; ">

            <center>
                <div class="A" style="background-color:white;border-radius:5px;text-align:right;color:#000">
                    <div class="A">
                        <h2>סגירת יום לתאריך @main_z_date.ToShortDateString() </h2>
                    </div>
                    <div class="B">
                        <table style="width:100%">
                            @foreach (var round in rounds)
                            {
                                DateTime next_schedule_date = defDate;
                                string next_schedule_date_str = "";
                                string issues_preventing_close = "";
                                string issues_bgcolor = "#000";
                                string next_schedule_date_color = "#57d600";
                                int issues_cnt = 0;
                                int round_type = 0;
                                bool is_ok = true;
                                int z_serial = 0;
                                int un_finished_orders_cnt = 0;
                                int un_processed_orders_cnt = 0;

                                try { next_schedule_date = tmpit.GetNextScheduleDate(round.id); } catch { }
                                try { round_type = round.round_type; } catch { }
                                try { z_serial = round.z_serial; } catch { }
                                if (next_schedule_date != defDate)
                                {
                                    next_schedule_date_str = next_schedule_date.ToShortDateString();
                                }
                                if (round_type == 1)
                                {
                                    sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE z_serial=@0 AND round_id = @1 AND order_status>0  AND delivery_id>0 "; // order by is_approved, order_id DESC";
                                }
                                if (round_type == 4)
                                {
                                    sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE z_serial=@0 AND round_id = @1 AND order_status>0  "; // order by is_approved, order_id DESC";
                                }

                                var unFinishedOrdersCnt = db.QuerySingle(sqlSelect, z_serial, round.id);
                                try { un_finished_orders_cnt = unFinishedOrdersCnt.the_cnt; } catch { }
                                sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE z_serial=@0 AND round_id = @1 AND order_status>=-2 AND order_status<=0"; // order by is_approved, order_id DESC";
                                var unProcessedOrdersCnt = db.QuerySingle(sqlSelect, z_serial, round.id);
                                try { un_processed_orders_cnt = unProcessedOrdersCnt.the_cnt; } catch { }

                                if (un_processed_orders_cnt > 0 || un_finished_orders_cnt > 0)
                                {
                                    is_ok = false;
                                }

                                if (!is_ok)
                                {
                                    issues_preventing_close = "⚠️ קיימות " + issues_cnt + " הזמנות שלא נסגרו!";
                                }

                                if (zCloseApprovalDivDisplayState == zCloseWarningDivDisplayState) { zCloseWarningDivDisplayState = "block;"; }


                                <tr style="overflow: auto;font-size:14px;">

                                    <td class="zReportCell"><b>@round.title</b></td>

                                    <td class="zReportCell"></td>

                                    <td class="zReportCell">
                                        @if (un_processed_orders_cnt > 0)
                                        {
                                            <div class="B"><span class="MiniTag" style="color:@issues_bgcolor;">⚠️ קיימות @un_processed_orders_cnt הזמנות שלא טופלו!</span></div>
                                        }
                                        @if (un_finished_orders_cnt > 0)
                                        {
                                            <div class="B"><span class="MiniTag" style="color:@issues_bgcolor;">⚠️ קיימות @un_finished_orders_cnt הזמנות שלא נסגרו!</span></div>
                                        }



                                    </td>

                                    @if (next_schedule_date_str == "")
                                    {
                                        <td class="zReportCell"><span class="RedMiniTag">‼️ אין מועד מתוכנן</span></td>
                                    }
                                    else
                                    {
                                        <td class="zReportCell"><span class="MiniTag" style="color:@next_schedule_date_color;">✅ Z הבא <b>@next_schedule_date_str</b></span></td>
                                    }
                                    <td class="zReportCell" style="display:none">
                                        <button type="button" class="zReportAction" style="color:#57d600" onclick="RepAjaxUpdate('CloseRoundZReport', 'MainBoardContainer', 'MainLoader', @round.id);">✅ סגירת Z</button>
                                    </td>
                                    <td class="zReportCell" style="display:none">@next_schedule_date_str</td>

                                </tr>

                            }

                        </table>
                    </div>

                    <form id="CloseMainZ">

                        <center>
                            <div id="zCloseApprovalDiv" style="padding:5px;margin:5px;background-color:#57d600;color:white;width:40%;display:@zCloseApprovalDivDisplayState">

                                <div style="overflow: auto; text-align: right" id="is_close_orders_div">
                                    <input type="checkbox" checked style="padding: 5px; margin: 5px;" name="is_close_orders" onclick=" hideElement('is_close_orders_div'); showElement('zedOrdersActionsDiv'); " /> סגירת כל ההזמנות הפתוחות והעברה למחר של ההזמנות שלא טופלו
                                </div>
                                <div style="overflow:auto;display:none;text-align:right" id="zedOrdersActionsDiv">
                                    <div style="overflow:auto;">
                                        <input type="radio" name="z_orders_action" value="ClosePending" style="padding: 5px; margin: 5px;" checked /> סגירת כל ההזמנות הפתוחות והעברה למחר של ההזמנות שלא טופלו

                                    </div>
                                    <div style="overflow:auto;">
                                        <input type="radio" name="z_orders_action" value="CloseAll" style="padding: 5px; margin: 5px;" /> סגירת כל ההזמנות
                                    </div>

                                </div>

                                <div style="overflow: auto; text-align: right">
                                    <input type="checkbox" checked style="padding: 5px; margin: 5px;" name="is_open_tommorow" onclick="if (this.checked) {hideElement('zedActionsDiv'); } else { showElement('zedActionsDiv'); }" /> פתיחת זד חדש למחר
                                </div>


                                <div style="overflow:auto;display:none;text-align:right" id="zedActionsDiv">
                                    <div style="overflow:auto;">
                                        <input type="radio" name="z_action" value="date" style="padding: 5px; margin: 5px;" /> פתיחת זד חדש לתאריך <input type="date" style="padding:5px;margin:5px;font-size:18px;" name="custom_z_date" />

                                    </div>
                                </div>

                                <div style="overflow:auto">
                                    <button type="button" style="padding: 10px; margin: 10px; font-size: 18px;" onclick="AjaxActions('CloseMainZ', '@round_id','MainLoader', 'CloseMainZ');">
                                        סגירת יום - @main_z_date.ToShortDateString() - ZED #@main_z_id
                                    </button>
                                </div>


                            </div>
                        </center>
                    </form>
                    <center>
                        <div id="zCloseWarningDiv" style="padding:10px;margin:10px;font-size:18px;background-color:#ffffcc;color:#000;border:2px dotted #f00;display:@zCloseWarningDivDisplayState">
                            לא ניתן לבצע סגירת יום - @main_z_date.ToShortDateString() - ZED #@main_z_id
                            <div class="A">
                                <button type="button" style="padding: 10px; margin: 10px; font-size: 18px;" onclick="hideElement('zCloseWarningDiv');showElement('zCloseApprovalDiv');">
                                    אתה לא הבוס שלי!
                                </button>
                            </div>
                        </div>
                    </center>


                </div>
            </center>




        </div>






    </div>


    <div style="overflow:auto;height:250px;">&nbsp;</div>



    db.Close();
}

@helper ZReport(int z_serial = 0)
