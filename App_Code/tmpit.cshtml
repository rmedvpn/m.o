            try { transferred_order_count = order.the_cnt; } catch { }


            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE  round_id=@0 AND packing_trouble_flag=1  AND z_serial=@1";
            order = op_data.QuerySingle(sqlSelect, round.id, z_serial);
            try { issues_order_count = order.the_cnt; } catch { }


            <div class="@RoundDivClass" onclick="PageNavigator('ROUNDBOARD',@round.id,false,'MAIN');" id="round_alert_@round.id">

                @round.short_title

                @if (order_count > 0)
                {
                    if (new_order_count > 0)
                    {
                        <span class="@RoundOrdersAlertClass">@new_order_count</span>
                    }
                    else
                    {
                        <span class="@RoundOrdersAlertClass">@order_count</span>
                    }

                    if (vendor_cancelled_order_count > 0)
                    {
                        <span class="VendorCancelledOrdersCounterAlert">@vendor_cancelled_order_count</span>
                    }

                    if (transferred_order_count > 0)
                    {
                        <span class="TransferredOrdersCounterAlert">@transferred_order_count </span>
                    }
                    if (issues_order_count > 0)
                    {
                        <span class="ProblematicOrdersCounterAlert">@issues_order_count</span>
                    }



                }
                else
                {
                    <span class="@RoundOrdersAlertClass">@order_count</span>

                }




            </div>

            <div class="A" style="display:none;" onclick="PageNavigator('ROUNDBOARD',@round.id,false,'MAIN');" id="round_tooltip_@round.id">
                <div class="A">@round.title</div>


                @if (new_order_count > 0)
                {
                    <div class="A">@new_order_count</div>
                }
                else
                {
                    <div class="A">@order_count</div>
                }

                @if (vendor_cancelled_order_count > 0)
                {
                    <div class="A">@vendor_cancelled_order_count</div>
                }

                @if (transferred_order_count > 0)
                {
                    <div class="A">@transferred_order_count</div>
                }




            </div>

        }

        <span class="WhiteMiniTag" style="padding:2px;margin:2px;margin-left:20px;float:left;font-size:12px;"><span>בָּ֤ר֣וּךְ אֲדֹנָי֮ י֤וֹם | י֥וֹם יַֽעֲמָס-לָ֗נוּ הָ֘אֵ֤ל יְֽשׁוּעָתֵ֬נוּ סֶֽלָה: </span></span>
    </div>



    op_data.Close();

