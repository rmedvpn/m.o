                            <span class="RoundBoardToolTipBox" style=" float: left;" onclick="sbload('GenSb','Caller?p1=ZREPORT&p2=@active_z_serial');AdjustMainView();">📋</span>



                            <div class="RoundBoardTitleBarButton" style="float: left;" onclick="RepAjaxUpdate('ROUNDLOG',  'round_board_container', 'MainLoader', @round_id);">📜 </div>
                            @if (round_type == 1)
                            {

                                <div class="RoundBoardTitleBarButton">

                                    📦 אריזה
                                    @if (packing_issues_orders_counter > 0)
