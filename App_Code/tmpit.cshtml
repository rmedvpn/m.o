                        if (order_status > 0 || (z_orders_action == "CloseAll" && order_status >= -3))
                        {


                            if (order_status <= 9)
                            {
                                non_delivery_count++;
                                if (order_status < 9)
                                {
                                    order_status = 9;
                                    sqlSelect = "UPDATE mainorders SET order_status=@0,status_change_ts=@1,status_change_by=@2 WHERE order_id=@3";
