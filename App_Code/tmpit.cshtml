    public static DateTime GetNextScheduleDate(int round_id, bool is_next_day = false)
    {
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;

        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        DateTime schedule_date = defTime;
        DateTime cur_time = local_time;
        int curDayOfWeek = 0;
        int schedDayOfWeek = -1;
        curDayOfWeek = ((int)local_time.DayOfWeek);
        string tmp_date = "";

        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "SELECT round_type,round_start FROM rounds WHERE id=@0";
        var round = db.QuerySingle(sqlSelect, round_id);
        int round_type = 0; try { round_type = round.round_type; } catch { }
        tmp_date = defTime.ToShortDateString() + " " + cur_time.ToString("HH:mm");
        cur_time = Convert.ToDateTime(tmp_date);

        if (round_type == 1)
        {
            DateTime round_start = round.round_start;

            sqlSelect = "SELECT Top(1) dayOfWeek FROM RoundsSchedules WHERE round_id=@0 AND ((dayOfWeek=@1 AND round_start>@2) OR dayOfWeek>@1)  ORDER BY dayOfWeek";
            var next_schedule = db.QuerySingle(sqlSelect, round_id, curDayOfWeek, cur_time);
            if (next_schedule == null)
            {
                sqlSelect = "SELECT Top(1) dayOfWeek FROM RoundsSchedules WHERE round_id=@0 AND dayOfWeek>=0  ORDER BY dayOfWeek";
                next_schedule = db.QuerySingle(sqlSelect, round_id);
            }
            try { schedDayOfWeek = next_schedule.dayOfWeek; } catch { }
        }

        if (round_type == 4)
        {

            sqlSelect = "SELECT Top(1) dayOfWeek FROM RoundsSchedules WHERE round_id=@0 AND ((dayOfWeek=@1 AND (express_open>@2 OR pickup_open>@2) ) OR dayOfWeek>@1) AND (express_open<>@3 OR pickup_open<>@3)  ORDER BY dayOfWeek";
            var next_schedule = db.QuerySingle(sqlSelect, round_id, curDayOfWeek, cur_time, defTime);
            if (next_schedule == null)
            {
                sqlSelect = "SELECT Top(1) dayOfWeek FROM RoundsSchedules WHERE round_id=@0 AND dayOfWeek>=0 AND (express_open<>@1 OR pickup_open<>@1)  ORDER BY dayOfWeek";
                next_schedule = db.QuerySingle(sqlSelect, round_id, defTime);
            }
            try { schedDayOfWeek = next_schedule.dayOfWeek; } catch { }
        }

        int daysdiff = -999;
        if (schedDayOfWeek >= 0)
        {
            daysdiff = schedDayOfWeek - curDayOfWeek;
        }


        if (daysdiff >= 0)
        {
            schedule_date = local_time.AddDays(daysdiff);
        }
        else
        {
            if (daysdiff != -999)
            {
                schedule_date = local_time.AddDays(daysdiff + 7);
            }
            else
            {
                schedule_date = defTime;
            }


        }


        db.Close();

        return schedule_date;
    }

