    int vendor_id = 0;
    int round_id = 0;
    DateTime main_z_date = defDate;
    int cur_vendor_id = 0;
    bool is_active_z = false;

    if (main_z_id == 0)
    {
        sqlSelect = "SELECT top(1) z_id,serial,z_date,is_active FROM ZREPORTS WHERE is_main_z=1 AND is_active=1 ORDER BY z_date DESC";
    }
    else
    {
        sqlSelect = "SELECT z_id,serial,z_date,is_active FROM ZREPORTS WHERE is_main_z=1 AND z_id=@0";
    }

    var main_z = db.QuerySingle(sqlSelect, main_z_id);
    try { main_z_date = main_z.z_date; } catch { }
    try { main_z_id = main_z.z_id; } catch { }
    try { is_active_z = main_z.is_active; } catch { }



    sqlSelect = "SELECT * FROM ZREPORTS WHERE is_main_z=1 ORDER BY z_id DESC";
    var main_z_reports = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM ZREPORTS WHERE main_z_id=@0 ORDER BY vendor_id,z_date DESC";
    var z_reports = db.Query(sqlSelect, main_z_id);

    sqlSelect = "SELECT id,vendor_id,z_id,title FROM rounds WHERE is_active=1 ORDER BY vendor_id,z_id DESC";
    var rounds = db.Query(sqlSelect);



