@functions {

    public static void AddOrderToDelivery(int order_id, int delivery_id = 0)
    {
        int envelope_id = 0;
        string logmsg = "";
        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        int route_id = 0;
        int driver_id = 0;
        int round_id = 0;
        var db = Database.Open("op_data");
        var sqlSelect = "";
        string round_title = AppFunctions.GetRoundTitleById(round_id);
        string requested_delivery_window_start_hour = "";
        string requested_delivery_window_end_hour = "";
        DateTime scheduled_delivery_start = defTime;

        sqlSelect = "SELECT MAX(envelope_id) AS envelope_id FROM MainOrders Where delivery_id=@0";
        var order = db.QuerySingle(sqlSelect, delivery_id);
        try { envelope_id = order.envelope_id; } catch { }
        envelope_id++;

        sqlSelect = "SELECT serial,scheduled_start,scheduled_end FROM deliveries WHERE serial=@0";
        var delivery = db.QuerySingle(sqlSelect, delivery_id);

        if (delivery != null)
        {

            try { scheduled_delivery_start = delivery.scheduled_start; } catch { }
            try { requested_delivery_window_start_hour = scheduled_delivery_start.ToString("HH:mm"); } catch { }
            try { requested_delivery_window_end_hour = delivery.scheduled_end.ToString("HH:mm"); } catch { }
        }
        else
        {
            delivery_id = 0;
        }

        if (delivery_id > 0)
        {
            sqlSelect = "UPDATE mainorders SET route_id=0,route_serial=0,stop_id=0,driver_id=0,delivery_id=@0,scheduled_delivery_start=@1,requested_delivery_window_start_hour=@2,requested_delivery_window_end_hour=@3,envelope_id=@4 WHERE order_id=@5";
            db.Execute(sqlSelect, delivery_id, scheduled_delivery_start, requested_delivery_window_start_hour, requested_delivery_window_end_hour, envelope_id, order_id);

            logmsg = "ההזמנה שובצה למשלוח #" + delivery_id + " שמתוכנן לצאת ב " + delivery.scheduled_start.ToShortDateString() + " בשעה " + delivery.scheduled_start.ToString("HH:mm");
            AppFunctions.WriteOrderComment(order_id, logmsg);
        }






        db.Close();


    }

    public static void AbortRoute(int route_serial, string notes = "")
    {
        DateTime local_time = AppFunctions.LocalTime();
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "SELECT order_id,round_id,delivery_id FROM MainOrders WHERE order_status>=4 AND order_status<=7 AND route_serial=@0 ORDER by stop_id";
        var orders = db.Query(sqlSelect, route_serial);
        int round_id = 0;
        int delivery_id = 0;
        foreach (var order in orders)
        {
            round_id = order.round_id;
            delivery_id = order.delivery_id;
            delivery_id = 0;
            tmpit.CancelInRouteOrder(order.order_id);
        }

        sqlSelect = "UPDATE routes SET is_route_aborted=1,is_route_completed=1,is_route_problem=1,route_completed_ts=@0,route_problem_ts=@0,route_abort_ts=@0,route_problem_notes=@1,route_abort_notes=@1,route_abort_by=@2 WHERE serial=@3";
        db.Execute(sqlSelect, local_time, notes, rep_id, route_serial);
        string logMsg = "בוצעה עצירה ידנית של מסלול #" + route_serial + " במשלוח #" + delivery_id;
        AppFunctions.WriteRoundComment(round_id, logMsg);

        db.Close();
    }

    public static void CancelInRouteOrder(int order_id)
    {
        DateTime local_time = AppFunctions.LocalTime();
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;

        int stop_id = 0;
        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "SELECT round_id,order_status,delivery_id,route_serial FROM MainOrders WHERE order_id=@0";
        var order = db.QuerySingle(sqlSelect, order_id);
        int round_id = 0; try { round_id = order.round_id; } catch { }
        int delivery_id = 0; try { delivery_id = order.delivery_id; } catch { }
        int route_serial = 0; try { route_serial = order.route_serial; } catch { }
        string delivery_status = "NONDELIVERY";
        int order_status = 9;
        sqlSelect = "UPDATE mainorders SET order_status=@0,status_change_ts=@1,status_change_by=@2,delivery_status=@3,is_complete=1 WHERE order_id=@4";
        db.Execute(sqlSelect, order_status, local_time, rep_id, delivery_status, order_id);
        string logMsg = "ההזמנה סומנה ידנית כלא נמסרה!";
        AppFunctions.WriteOrderComment(order_id, logMsg, false, true);

