    public static int CreateDeliveriesForZedAndReturnActiveDeliveryId(int z_serial)
    {
        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        string logmsg = "";
        DateTime z_date = defTime;
        int new_delivery_id = 0;

        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "";

        sqlSelect = "SELECT * FROM zreports WHERE serial=@0";
        var zReport = db.QuerySingle(sqlSelect, z_serial);
        if (zReport != null)
        {
            int round_id = 0; try { round_id = zReport.round_id; } catch { }
            int main_z_id = 0; try { main_z_id = zReport.main_z_id; } catch { }
            try { z_date = zReport.z_date; } catch { }
            int schedDayOfWeek = ((int)z_date.DayOfWeek);
            int todayDayOfWeek = ((int)local_time.DayOfWeek);

            sqlSelect = "SELECT * FROM RoundsSchedules WHERE dayOfWeek=@0 AND round_id=@1 order by round_start";
            var RoundsSchedules = db.Query(sqlSelect, schedDayOfWeek, round_id);
            foreach (var Schedule in RoundsSchedules)
            {
                new_delivery_id = tmpit.CreateScheduledDeliveryAndReturnId(Schedule.schedule_id);
            }


            sqlSelect = "SELECT top(1) serial FROM deliveries WHERE z_serial=@0 AND round_id=@1 AND scheduled_start>@2 ORDER BY scheduled_start";
            var next_delivery = db.QuerySingle(sqlSelect, z_serial, round_id,local_time);
