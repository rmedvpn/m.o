                                    AppFunctions.WriteOrderComment(order.order_id, logMsg);
                                }
                            }
                            else
                            {
                                delivery_count++;
                                total_commision += order.commision;
                                total_pick_up += order.actual_pickup_amount;
                            }

                            total_sales += order.grand_total;
                        }

                    }

                    main_transfered_to_next_z_count += transfered_to_next_z_count;
                    main_orders_count += orders_count;
                    main_total_sales += total_sales;
                    main_total_pick_up += total_pick_up;
                    main_total_commision += total_commision;
                    main_returns_amount += returns_amount;
                    main_cancel_count += cancel_count;

                    main_delivery_count += delivery_count;
                    main_non_delivery_count += non_delivery_count;
                    main_returns_count += returns_count;
                    main_exchanges_count += exchanges_count;
                    main_deliveries_in_z += deliveries_in_z;


                    sqlSelect = "UPDATE ZREPORTS SET is_active=0,close_ts=@0,close_by=@1,orders_count=@2,total_sales=@3,total_pick_up=@4,total_commision=@5,cancel_count=@6,delivery_count=@7,non_delivery_count=@8,returns_count=@9,returns_amount=@10,exchanges_count=@11,deliveries_in_z=@12,transfered_to_next_z_count=@13 WHERE serial=@14";
                    db.Execute(sqlSelect, local_time, u_id, orders_count, total_sales, total_pick_up, total_commision, cancel_count, delivery_count, non_delivery_count, returns_count, returns_amount, exchanges_count, deliveries_in_z, transfered_to_next_z_count, z_serial);

                    sqlSelect = "UPDATE deliveries SET is_completed=1,complete_ts=@0,completed_by=@1 WHERE z_serial=@2 OR (round_id=@3 AND scheduled_end<@4)";
                    db.Execute(sqlSelect, local_time, rep_id, z_serial,round_id,local_time);

                }

                sqlSelect = "UPDATE ZREPORTS SET is_active=0,close_ts=@0,close_by=@1,orders_count=@2,total_sales=@3,total_pick_up=@4,total_commision=@5,cancel_count=@6,delivery_count=@7,non_delivery_count=@8,returns_count=@9,returns_amount=@10,exchanges_count=@11,deliveries_in_z=@12,main_z_id=@13,no_z_rounds=@14,transfered_to_next_z_count=@15 WHERE serial=@16";
                db.Execute(sqlSelect, local_time, u_id, main_orders_count, main_total_sales, main_total_pick_up, main_total_commision, main_cancel_count, main_delivery_count, main_non_delivery_count, main_returns_count, main_returns_amount, main_exchanges_count, main_deliveries_in_z, 0, no_z_rounds, main_transfered_to_next_z_count, main_z_report.serial);



                new_z_id = tmpit.CreateMainZReport(next_z_date);

                sqlSelect = "UPDATE zreports SET is_active=1 WHERE is_main_z=1 AND z_id=@0";
                db.Execute(sqlSelect, new_z_id);

                sqlSelect = "UPDATE zreports SET is_active=1 WHERE is_main_z=0 AND main_z_id=@0";
                db.Execute(sqlSelect, new_z_id);

                sqlSelect = "SELECT serial,z_date FROM zReports WHERE is_main_z=1 AND z_id=@0";
                var zReport = db.QuerySingle(sqlSelect, new_z_id);
                main_z_serial = 0;
                main_z_date = defTime;
                try { main_z_serial = zReport.serial; } catch { }
                try { main_z_date = zReport.z_date; } catch { }

                AppFunctions.SetAppProperty("ActiveZSerial", main_z_serial.ToString());
                AppFunctions.SetAppProperty("ActiveZId", new_z_id.ToString());
                AppFunctions.SetAppProperty("ActiveZDate", main_z_date.ToShortDateString());



                theHtmlOutput = " זד איז דד בייבי, זד איז דד!<br>";
                theHtmlOutput += "דוח יומי #" + z_id + " נסגר!";
                theHtmlOutput += "דוח יומי #" + new_z_id + " נפתח!";


            }



            db.Close();
        }
        else
        {
            theHtmlOutput = "!$!" + theHtmlOutput;
        }



        return theHtmlOutput;
    }


    public static int CreateMainZReport(DateTime main_z_date, bool is_orders_update = false)
    {
        int u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;

        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        string logMsg = "";
        int rep_id = u_id;
        int main_z_id = 0;
        int main_z_serial = 0;
        bool is_active = false;


        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "";



        //check if main z report exists for the requested date
        sqlSelect = "SELECT * FROM ZREPORTS WHERE is_main_z=1 AND CAST(z_date AS DATE) = CAST(@0 AS DATE)";
        var main_z_report = db.QuerySingle(sqlSelect, main_z_date);
        if (main_z_report == null)
        {
            //create new main z report and retrieve new z id #
            main_z_id = tmpit.CreateMainZedAndReturnId(main_z_date);
            main_z_report = db.QuerySingle(sqlSelect, main_z_date);
        }
        else
        {
            main_z_id = main_z_report.z_id;
        }



        try { main_z_serial = main_z_report.serial; } catch { }
        sqlSelect = "UPDATE ZREPORTS SET main_z_serial=@0 WHERE serial=@0";
        db.Execute(sqlSelect, main_z_serial);



        sqlSelect = "SELECT id,vendor_id,title,round_type,active_delivery_id FROM rounds WHERE is_active=1 ORDER BY vendor_id,round_type,id";
        var rounds = db.Query(sqlSelect);

        foreach (var round in rounds)
        {

            int round_id = round.id;
            int round_type = round.round_type;
            int delivery_id = 0;
            int z_serial = 0;


            sqlSelect = "SELECT TOP(1) serial,z_id,z_date,round_id FROM ZREPORTS WHERE round_id=@0 AND main_z_id=@1";
            var z_report = db.QuerySingle(sqlSelect, round.id, main_z_id);
            if (z_report == null)
            {
                z_serial = tmpit.CreateZReportAndReturnId(main_z_id, round_id);
            }
            else
            {
                z_serial = z_report.serial;
            }

            if (z_serial > 0)
            {

                if (round_type == 1)
                {
                    delivery_id = tmpit.CreateDeliveriesForZedAndReturnActiveDeliveryId(z_serial);
                    Rounds.setActiveDelivery(round_id);
                }


                if (is_orders_update)
                {
                    sqlSelect = "UPDATE mainorders SET z_serial=@0, z_id=@1,delivery_id=@2 WHERE CAST(timestamp AS DATE) = CAST(@3 AS DATE) AND round_id=@4";
                    db.Execute(sqlSelect, z_serial, main_z_id, delivery_id, main_z_date, round.id);
                }


                sqlSelect = "SELECT order_id FROM mainorders WHERE z_serial=-1 AND round_id=@0";
                var orders = db.Query(sqlSelect, round_id);
                foreach (var order in orders)
                {
                    logMsg = "ההזמנה נקלטה לZ#" + main_z_id + " בתהליך פתיחת יום!";
                    AppFunctions.WriteOrderComment(order.order_id, logMsg);
                }


                sqlSelect = "UPDATE mainorders SET z_serial=@0, z_id=@1,delivery_id=@2,envelope_id=0,route_id=0,stop_id=0,driver_id=0 WHERE z_serial=-1 AND round_id=@3";
                db.Execute(sqlSelect, z_serial, main_z_id, delivery_id, round.id);

                sqlSelect = "SELECT order_id FROM mainorders WHERE z_serial=@0 ORDER BY order_id";
                orders = db.Query(sqlSelect, z_serial);
                foreach (var order in orders)
                {
                    sqlSelect = "UPDATE orderitems SET z_serial=@0 WHERE order_id=@1";
                    db.Execute(sqlSelect, z_serial, round.id);
                }

                sqlSelect = "UPDATE deliveries SET z_serial=@0,main_z_id=@1 WHERE CAST(scheduled_start AS DATE)=CAST(@2 AS DATE) AND round_id=@3 AND z_serial=-1";
                db.Execute(sqlSelect,z_serial,main_z_id,main_z_date,round_id);

                sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM mainorders WHERE z_serial=@0";
                var ordersInZ = db.QuerySingle(sqlSelect, z_serial);

                int ordersInZ_cnt = 0; try { ordersInZ_cnt = ordersInZ.the_cnt; } catch { }

                sqlSelect = "UPDATE zreports SET orders_count=@0 WHERE serial=@1";
                db.Execute(sqlSelect, ordersInZ_cnt, z_serial);





            }



        }

        sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM mainorders WHERE z_id=@0";
        var ordersInMainZ = db.QuerySingle(sqlSelect, main_z_id);
        int ordersInMainZ_cnt = 0; try { ordersInMainZ_cnt = ordersInMainZ.the_cnt; } catch { }
        db.Execute(sqlSelect, ordersInMainZ_cnt, main_z_serial);


        logMsg = "נוצר Z חדש לתאריך " + main_z_date.Date + " Z#" + main_z_id;
        AppFunctions.WriteLog("ZED", rep_id, logMsg);
        return main_z_id;







        //  theHtmlOutput += "שדגדשג" + is_open_tommorow + z_action;




    }


    public static int CreateMainZedAndReturnId(DateTime main_z_date)
    {
        int u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;

        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        string logMsg = "";
        int rep_id = u_id;
        int z_serial = 0;
        int main_z_id = 0;
        int main_z_serial = 0;
        bool is_active = false;


        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "";
        //get current z#

        //check if main z report exists for the requested date
        sqlSelect = "SELECT * FROM ZREPORTS WHERE is_main_z=1 AND CAST(z_date AS DATE) = CAST(@0 AS DATE)";
        var main_z_report = db.QuerySingle(sqlSelect, main_z_date);
        if (main_z_report == null)
        {
            sqlSelect = "SELECT MAX(z_id) as max_z FROM ZREPORTS WHERE is_main_z=1";
            var max_z = db.QuerySingle(sqlSelect);
            try { main_z_id = max_z.max_z; } catch { }
            main_z_id++;
            if (main_z_id == 0) { main_z_id = 1; }
            //create new main z report and retrieve new z id #
            sqlSelect = "INSERT INTO ZREPORTS(z_id,is_active,z_date,open_ts,open_by,is_main_z) VALUES(@0,@1,@2,@3,@4,@5)";
            db.Execute(sqlSelect, main_z_id, is_active, main_z_date, local_time, rep_id, 1);

            sqlSelect = "SELECT TOP(1) * FROM ZREPORTS WHERE is_main_z=1 AND z_id=@0 ORDER BY z_id DESC";
            main_z_report = db.QuerySingle(sqlSelect, main_z_id);
            try { main_z_id = main_z_report.z_id; } catch { }
            try { main_z_serial = main_z_report.serial; } catch { }
            sqlSelect = "UPDATE ZREPORTS SET main_z_serial=@0 WHERE serial=@0";
            db.Execute(sqlSelect, main_z_serial);
            logMsg = "נוצר Z ראשי חדש לתאריך " + main_z_date.Date + " Z#" + main_z_id;
            AppFunctions.WriteLog("ZED", rep_id, logMsg);

        }



        return main_z_id;







