            sqlSelect = "SELECT top(1) * FROM ZREPORTS WHERE serial=@0";
            var main_z_report = db.QuerySingle(sqlSelect, main_z_serial);
            if (main_z_report != null)
            {


                sqlSelect = "SELECT * FROM Zreports WHERE main_z_id=@0";
