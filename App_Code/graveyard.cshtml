                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;font-weight: bold" onclick="toggle_visibility('ProductSettingsDiv');">הגדרות מתקדמות</button>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #57d600;color: #fff;font-weight: bold" onclick="AjaxActions('UpdateProduct', '@product_id','','UpdateProduct');">שמירת שינויים</button>
                        </div>

                    </div>


                </div>



                <div class="Spacer100"></div>


            </div>


        </form>

        <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;display: none" id="ProductOptionsDiv">
            @Products.EditProductOptions(product_id)
        </div>
        <div style="display: none" id="ProductCustomFieldsDiv">

        </div>


        <div style="overflow: auto;display: @PricingDivDisplayState" id="ProductPricingDiv">
