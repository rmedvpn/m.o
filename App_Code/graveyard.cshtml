                    <button type="button" class="A" style="float:left;background:transparent;border:0;display:none" onclick="Accordionize('PricingOptionsSync');">🔁</button>
                    <div class="spinner" style="text-align: center;display: none;float: left" id="AddProductLoader">
                        <div class="bounce1"></div>
                        <div class="bounce2"></div>
                        <div class="bounce3"></div>
                    </div>
                </div>
                <button class="Accordion" style="display: none;" id="PricingOptionsSync"></button>
                <div class="panel" style="padding: 0;margin: 0;">
                    <div class="A" style="float:right">⚠️ המחירון הקטלוגי יסונכרן לכל המוצרים הפעילים</div>
                    <button type="button" class="A" style="float:left;" onclick="AjaxActions('SyncProductPriceOptionsCatalog', @product_id,'MainLoader', '1'); ">🔁 ביצוע סנכרון</button>

                </div>

                <button style="display: none;" id="AddPricingOptionAcc"></button>
                <div class="panel" style="padding: 0;margin: 0;text-align: center">

                    <div id="AddPricingOptionsContainer">
                        @Products.AddProductPricingOption(product_id)
                    </div>

                </div>
                <div id="PricingOptionsContainer">
                    @Products.CatalogProductPricingOptions(product_id)
                </div>

            </div>
            <div class="B" style="height:100px;">&nbsp;</div>
        </div>

        <div style="overflow: auto;display: none" id="ProductMenusDiv">
