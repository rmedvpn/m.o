decimal shipping_price = 0; try { shipping_price = Convert.ToDecimal(Request["shipping_price"]); } catch { }

decimal refund_amount = 0; try { refund_amount = Convert.ToDecimal(Request["refund_amount"]); } catch { }
string refund_type = Request["refund_type"];

var db = WebMatrix.Data.Database.Open("op_data");
