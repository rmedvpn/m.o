@functions {
    public static int CreateDeliveryAndReturnId(int round_id = 0, int schedule_id = 0, string next_schedule_date_str = "1/1/1900")
    {

        int u_id = WebSecurity.CurrentUserId;
        int new_delivery_id = 0;
        int delivery_z_serial = 0;
        string logmsg = "";
        DateTime local_time = AppFunctions.LocalTime();
        DateTime defDate = Convert.ToDateTime("1/1/1900");
        DateTime next_schedule_date = defDate; try { next_schedule_date = Convert.ToDateTime(next_schedule_date_str); } catch { }
        int delivery_status = 0;
        DateTime delivery_z_date = defDate;
        bool is_team_leader = false;
        int z_serial = 0;
        int main_z_id = 0;
        int todayDayOfWeek = ((int)local_time.DayOfWeek);

        var db = Database.Open("op_data");
        var sqlSelect = "";


        sqlSelect = "SELECT * FROM RoundsSchedules WHERE schedule_id=@0";
        var Schedule = db.QuerySingle(sqlSelect, schedule_id);
        int schedDayOfWeek = Schedule.dayOfWeek;


        DateTime round_start = Schedule.round_start;
        try { round_id = Schedule.round_id; } catch { }

        sqlSelect = "SELECT * FROM dbo.rounds WHERE id=@0";
        var round = db.QuerySingle(sqlSelect, round_id);

        next_schedule_date = tmpit.GetNextScheduleDate(round_id);
        DataFunctions.WriteDebugLine("NEXT SCHED DATE " + round.title + "  -  " + next_schedule_date.ToString() + " SCHED " + Schedule.schedule_id);

        sqlSelect = "SELECT * FROM zReports WHERE round_id=@0 AND z_date=@1";
        var zReport = db.QuerySingle(sqlSelect, round_id, next_schedule_date.Date);
        if (zReport != null)
        {
            z_serial = zReport.serial;
            main_z_id = zReport.main_z_id;
        }
        else
        {
            z_serial = -1;
            main_z_id = -1;

        }




        int active_deliveries = round.active_deliveries;
        int active_delivery_id = round.active_delivery_id;
        int vendor_id = round.vendor_id;
        DateTime next_order_close = defDate;
        DateTime next_scheduled_launch = defDate;
        DateTime next_scheduled_finish = defDate;
        int estimated_duration = Schedule.estimated_duration;
        string start_address_street = ""; try { start_address_street = round.start_address_street; } catch { }
        string start_address_city = ""; try { start_address_city = round.start_address_city; } catch { }
        string start_address_notes = ""; try { start_address_notes = round.start_address_notes; } catch { }
        string end_address_street = ""; try { end_address_street = round.end_address_street; } catch { }
        string end_address_city = ""; try { end_address_city = round.end_address_city; } catch { }
        string end_address_notes = ""; try { end_address_notes = round.end_address_notes; } catch { }
        int start_address_id = 0; try { start_address_id = round.start_address_id; } catch { }
        int end_address_id = 0; try { end_address_id = round.end_address_id; } catch { }
        string tmpDate = "";

        next_scheduled_launch = next_schedule_date;

        tmpDate = next_scheduled_launch.ToShortDateString() + " " + Schedule.round_start.ToString("HH:mm");
        next_scheduled_launch = Convert.ToDateTime(tmpDate);

        tmpDate = next_scheduled_launch.ToShortDateString() + " " + Schedule.round_order_close.ToString("HH:mm");
        next_order_close = Convert.ToDateTime(tmpDate);
        next_scheduled_finish = next_scheduled_launch.AddMinutes(estimated_duration);

