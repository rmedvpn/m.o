    {
        errMsg += "חובה לבחור מוצרים להחלפה!<br/>";
    }

    else
    {

        replacementItemsArr = ReplacementItemsList.Split(sep.ToCharArray());
        foreach (var rep_item in replacementItemsArr)
        {

            int rep_item_id = 0;
            try { rep_item_id = Convert.ToInt32(rep_item); } catch { }

            if (rep_item_id > 0)
            {
                sqlSelect = "SELECT * FROM roundMenuItems WHERE id=@0";
