                        </div>
                        <div class="B">
                            @round_title
                        </div>
                        <div class="B">
                            <span class="YellowMiniTag">#@order_id @order_data.timestamp.ToString("HH:mm") @order_data.timestamp.ToShortDateString() </span>
                        </div>
                    </div>

                </div>



            </div>
        </div>




        <div class="B" style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080">
            <center>
                <div class="OrderSection" id="SelectOrderItemsForReturnDiv">
                    <div class="OrderSectionTitle">
                        <h2>החזרות והחלפות</h2>
                    </div>
                    <div class="B">
                        <div class="A">נא לבחור את ההזמנה הרלוונטית</div>
                        @foreach (var order in ReturnableOrders)
                        {
                            string short_round_title = NewAppFunctions.GetTitleById("Round_Short", order.round_id);
                            <div class="B" style="border-bottom:1px dashed #ff6a00;font-size:14px;">
                                <div class="A" style="float: right; font-size: 14px; ">
                                    @order.order_id
                                </div>
                                <div class="A" style="float: right; font-size: 14px;">
                                    @order.timestamp.ToShortDateString()
                                </div>
                                <div class="A" style="float: right; font-size: 14px;">
                                    @short_round_title
                                </div>
                                <div class="A" style="float: right; font-size: 14px;">
                                    @order.ship_city
                                </div>
                                <div class="A" style="float: right; font-size: 14px;">
                                    @order.grand_total.ToString("C", culture)
                                </div>
                                <div class="A" style="float: left; font-size: 14px;">
                                    <button type="button" style="padding:2px;font-size:14px;" onclick="RepAjaxUpdate('LoadOrderItemsForReturn', 'SelectOrderItemsForReturnDiv', 'MainLoader',@order.order_id,@order_id);">בחירה</button>
                                </div>
                            </div>
                        }

                    </div>




                    <div class="A" id="SelectOrderItemsForReturnDiv34">

                    </div>



                </div>

            </center>

            <div style="overflow: auto;height: 200px;">&nbsp;</div>
        </div>



    }


    db.Close();
}

