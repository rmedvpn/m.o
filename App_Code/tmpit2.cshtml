}

if (is_voucher)
{
    if (offer_type.IsEmpty())
    {
        errMsg += "חובה לבחור את סוג הפיצוי!<br>";
    }
    else
    {
        switch (offer_type)
        {
            case "ITEM":
                if (true)
                {
                    if(free_product_scope=="PROD")
                    {
                        if (free_product_id == 0)
                        {
                            errMsg += "חובה לבחור מוצר הטבה!<br>";
                        }

