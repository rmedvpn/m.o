                        }
                    }

                    if (voucher_type == "DISC")
                    {
                        if (order_discount_percantage <= 0)
                        {
                            errMsg += "חובה להזין שיעור % תקין לשובר הנחה!<br>";
                        }
                    }

                }
                break;

            case "SHIPPING":
                if (true)
                {
                    if (shipping_cost_type == "")
                    {
                        errMsg += "חובה לבחור סוג הטבת משלוח!<br>";

                    }
                    if (shipping_cost_type == "PRICE")
                    {
                        if (shipping_price <= 0) {
                            errMsg += "חובה להזין סכום תקין למחיר המשלוח!<br>";
                        }


                    }

                }
                break;

        }
    }



}

if (is_refund)
{
    if (refund_type.IsEmpty())
    {
        errMsg += "חובה לבחור  את סוג הזיכוי!<br>";

    }
    else
    {
