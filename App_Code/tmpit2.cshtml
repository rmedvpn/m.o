@helper RoundBoard(int round_id, string showWhat = "ALL", int requested_z_id = 0, int requested_delivery_id = 0)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    var u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
    var db = WebMatrix.Data.Database.Open("op_data");
    var sqlSelect = "";
    DateTime local_time = AppFunctions.LocalTime();
    DateTime defTime = Convert.ToDateTime("1/1/1900");
    DateTime z_date = Convert.ToDateTime("1/1/1900");
    DateTime order_close_hour = Convert.ToDateTime("1/1/1900");
    DateTime round_start = Convert.ToDateTime("1/1/1900");

    dynamic deliveries = null;
    dynamic requested_delivery = null;
    dynamic active_delivery = null;

    int main_z_id = 0;
    int active_z_serial = 0;
    int active_delivery_id = 0;
    int z_id = 0;
    bool is_active_z = false;
    bool is_open_for_orders = false;

    int round_type = 0;
    bool is_express = false;
    bool is_pickup = false;
    bool is_route = false;
    string round_type_title = "";
    string viewTitle = "";
    string viewTitleColor = "#57d600";
    string title_bar_bg_color = "#000";
    string sub_title_bar_bg_color = "yellow";
    string round_start_time_bg_color = "";



    sqlSelect = "SELECT * FROM Rounds WHERE id=@0";
    var round_info = db.QuerySingle(sqlSelect, round_id);
    try { round_type = round_info.round_type; } catch { }

    if (round_type == 1)
    {
        //   tmpit.InitRoundDeliveries(round_id);
        //   round_info = db.QuerySingle(sqlSelect, round_id);
    }

    try { is_open_for_orders = round_info.is_open_for_orders; } catch { }
    try { is_express = round_info.is_express; } catch { }
    try { is_pickup = round_info.is_pickup; } catch { }
    try { is_route = round_info.is_route; } catch { }

    try { main_z_id = round_info.main_z_id; } catch { }
    try { active_z_serial = round_info.z_serial; } catch { }

    sqlSelect = "SELECT TOP(1) * FROM ZREPORTS WHERE serial=@0 ORDER BY z_date DESC";
    var ActiveZ = db.QuerySingle(sqlSelect, active_z_serial);
    if (ActiveZ != null)
    {
        is_active_z = true;
    }


    if (round_type == 1)
    {
        is_route = true;
        is_express = false;
        is_pickup = false;

        try { active_delivery_id = round_info.active_delivery_id; } catch { }


        if (requested_delivery_id > 0)
        {
            sqlSelect = "SELECT scheduled_start,order_close_hour FROM deliveries WHERE serial=@0";
            requested_delivery = db.QuerySingle(sqlSelect, requested_delivery_id);

        }
        if (active_delivery_id > 0)
        {
            sqlSelect = "SELECT scheduled_start,order_close_hour FROM deliveries WHERE serial=@0";
            active_delivery = db.QuerySingle(sqlSelect, active_delivery_id);
        }


        if (active_delivery != null)
        {
            try { order_close_hour = active_delivery.order_close_hour; } catch { }
            try { round_start = active_delivery.scheduled_start; } catch { }
        }
        else
        {
            active_delivery_id = 0;
        }

        sqlSelect = "SELECT serial,scheduled_start,order_close_hour,z_serial,main_z_id,has_started FROM deliveries WHERE z_serial=@0 OR (z_serial<=0 AND round_id=@1) ORDER BY scheduled_start";
        deliveries = db.Query(sqlSelect, active_z_serial, round_id);

    }





    round_type_title = NewAppFunctions.GetRoundTypeTitleById(round_type);


    bool is_sorted = false;
    is_sorted = round_info.is_sorted;

    //  showWhat = "ALL";

    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND  z_serial=@0   AND  round_id = @1 "; // order by is_approved, order_id DESC";
    var CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id);


    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>=-3  AND order_status<1 AND  z_serial=@0 AND  round_id = @1  "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id, local_time);
    int new_orders_counter = 0;
    try { new_orders_counter = CntRs.the_cnt; } catch { }

    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>=4  AND order_status<=6 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id);
    int in_proc_orders_counter = 0;
    try { in_proc_orders_counter = CntRs.the_cnt; } catch { }


    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>=1  AND order_status<=3 AND  z_serial=@0 AND  round_id = @1  AND  (CAST(requested_delivery_date AS date) <= CAST(@2 AS date) OR delivery_id=@3)"; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id, local_time, active_delivery_id);
    int in_prep_orders_counter = 0;
    try { in_prep_orders_counter = CntRs.the_cnt; } catch { }

    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>=1  AND order_status<=3 AND  z_serial=@0 AND  round_id = @1   AND packing_trouble_flag=1"; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id, local_time, active_delivery_id);
    int packing_issues_orders_counter = 0;
    try { packing_issues_orders_counter = CntRs.the_cnt; } catch { }


    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>=9 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id);
    int completed_orders_counter = 0;
    try { completed_orders_counter = CntRs.the_cnt; } catch { }

    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=1 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id);
    int cancelled_orders_counter = 0;
    try { cancelled_orders_counter = CntRs.the_cnt; } catch { }


    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE order_status=-6 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id);
    int vendor_cancelled_orders_counter = 0;
    try { vendor_cancelled_orders_counter = CntRs.the_cnt; } catch { }



    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND   z_serial=@0 AND  round_id = @1 AND order_status>0  "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id, local_time);
    int today_orders_counter = 0;
    try { today_orders_counter = CntRs.the_cnt; } catch { }


    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND  round_id = @1 AND CAST(requested_delivery_date AS DATE)>CAST(@2 AS DATE)"; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id, local_time);
    int future_orders_counter = 0;
    try { future_orders_counter = CntRs.the_cnt; } catch { }



    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status=1 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id);
    int awaiting_vendor_approval_orders_counter = 0;
    try { awaiting_vendor_approval_orders_counter = CntRs.the_cnt; } catch { }



    sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE  is_cancelled=0 AND order_type='ROUND' AND delivery_id<=0 AND z_serial=@0 AND  round_id = @1 AND order_status>=-1 AND order_status<=3 ";
    CntRs = db.QuerySingle(sqlSelect, active_z_serial, round_id, local_time);
    int unAssignedOrdersCounter = 0;
    try { unAssignedOrdersCounter = CntRs.the_cnt; } catch { }


    sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE is_cancelled=0 AND delivery_id=@0  AND delivery_id>0 "; // order by is_approved, order_id DESC";
    var current_orders = db.QuerySingle(sqlSelect, active_delivery_id);
    int delivery_orders_counter = 0; try { delivery_orders_counter = current_orders.the_cnt; } catch { }



    if (showWhat == "")
    {
        if (round_type == 1)
        {
            showWhat = "DELIVERY";
            requested_delivery_id = active_delivery_id;

            if (new_orders_counter > 0)
            {
                showWhat = "NEW";
                requested_delivery_id = 0;
            }
            if (unAssignedOrdersCounter > 0)
            {
                showWhat = "NODELIVERY";
                requested_delivery_id = 0;
            }

        }
        else
        {
            showWhat = "ACTIVE";
        }




    }

    sqlSelect = "SELECT top(200)  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE ";
    switch (showWhat)
    {

        case "NEW":
            sqlSelect += " is_cancelled=0 AND  MainOrders.z_serial=@0 AND  round_id = @1 AND order_status>=-3 AND order_status<1  ORDER BY envelope_id,order_status,order_id "; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות חדשות";
            viewTitleColor = "#fff";
            sub_title_bar_bg_color = "#57d600";
            break;


        case "ACTIVE":
            sqlSelect += " is_cancelled=0 AND is_postponed=0 AND  MainOrders.z_serial=@0  AND  round_id = @1 ORDER BY envelope_id,order_status,order_id DESC"; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות פעילות";
            viewTitleColor = "#57d600";
            sub_title_bar_bg_color = "#fff";

            break;


        case "DELIVERY":
            sqlSelect += " is_cancelled=0 AND  MainOrders.z_serial=@0 AND  round_id = @1 AND delivery_id=@3  ORDER BY envelope_id,order_status,order_id "; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות במשלוח של " + AppFunctions.FormatRelativeDate(order_close_hour) + " בשעה " + order_close_hour.ToString("HH:mm");
            viewTitleColor = "#fff";
            sub_title_bar_bg_color = "#57d600";

            break;

        case "FUTURE":
            sqlSelect += " is_cancelled=0 AND  (MainOrders.z_serial=@0 OR MainOrders.z_serial<=0)   AND  round_id = @1 AND CAST(requested_delivery_date AS DATE)>CAST(@2 AS DATE) ORDER BY requested_delivery_date, order_status,envelope_id,order_id"; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות עתידיות";
            break;

        case "PROC":
            sqlSelect += " is_cancelled=0 AND  MainOrders.z_serial=@0   AND  round_id = @1  AND order_status>=4 AND order_status<=6   ORDER BY envelope_id,order_status,order_id DESC"; // order by is_approved, order_id DESC";
            viewTitle = "בתהליך אספקה";

            break;

        case "COMPLETED":
            sqlSelect += " is_cancelled=0 AND  MainOrders.z_serial=@0   AND  round_id = @1  AND order_status>=9  ORDER BY envelope_id,order_status,order_id DESC"; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות שבוצעו";

            break;
        case "CANCELLED":
            sqlSelect += "  is_cancelled=1 AND  MainOrders.z_serial=@0   AND  round_id = @1 ORDER BY envelope_id,order_status,order_id DESC"; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות שבוטלו";
            break;

        case "NODELIVERY":
            sqlSelect += " is_cancelled=0 AND delivery_id<=0 AND MainOrders.z_serial=@0   AND  round_id = @1 AND order_status>=-3 ORDER BY envelope_id,delivery_id,order_status,order_id"; // order by is_approved, order_id DESC";
            viewTitle = "הזמנות שלא משובצות למשלוח";
            viewTitleColor = "#fff";
            sub_title_bar_bg_color = "#f00";
            break;

        case "ALL":
            sqlSelect += " is_cancelled=0 AND  MainOrders.z_serial=@0  AND  round_id = @1 ORDER BY envelope_id,order_status,order_id DESC"; // order by is_approved, order_id DESC";
            viewTitle = "כל ההזמנות";

            break;

        case "VENDOR":
            sqlSelect += " order_status=-6 AND  (MainOrders.z_serial=@0 OR MainOrders.z_serial=0) AND  round_id = @1 ORDER BY envelope_id,order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
            viewTitle = "ביטולי ספק";
            break;
    }

    var order_data = db.Query(sqlSelect, active_z_serial, round_id, local_time, requested_delivery_id);
    int orders_counter = 0;
    orders_counter = order_data.Count();



    var title = round_info.title;
    decimal round_total = 0; try { round_total = Convert.ToInt32(NewAppFunctions.GetRoundTotalOrdersSum(round_id, z_id)); } catch { }

    string orders_counter_text = "🤩  " + orders_counter + " הזמנות פעילות";
    if (showWhat == "CANCELLED")
    {
        orders_counter_text = "⛔  " + orders_counter + " הזמנות שבוטלו";
        viewTitleColor = "#f00";
    }

    string tmpOrdersList = "";
    //new code
    int tableColSpan = 8;

    bool is_multi_select_mode = false;

    <input type="hidden" name="round_id" id="round_id" value="@round_id">
    <input type="hidden" name="board_round_id" id="board_round_id" value="@round_id">
    <input type="hidden" id="board_show_what" name="board_show_what" value="@showWhat" />

    <input type="hidden" name="cur_record" id="cur_record" value="0">
    <input type="hidden" name="IsInline" id="IsInline" value="1">
    <div style="text-align: right;font-size: 16px;width: 100%;height: 100%;overflow: auto;background-color:#fff">
        <div style="position: fixed;display: none;z-index: 500000;width: 100%;height: 100%;background-color: #e3e3e3;opacity: 0.5;text-align: center;" id="RoundBoardLoader">
            <div class="cssload-loading"></div>
        </div>
        <div style="max-height: 95%;overflow: auto;">

            <div class="B">
                <div style="overflow: auto;">
                    <div style="overflow: auto;background-color: @title_bar_bg_color;color: #fff;padding: 5px;">
                        <div style="float: right">

                            <div class="RoundBoardTitleBarButton" style="display:none" onclick="Accordionize('RoundOptionsAcc');">⚙️</div>
                            <div class="RoundBoardTitleBarButton" onclick="PageNavigator('ROUNDBOARD',@round_id,false,'MAIN');">🏠</div>
                            <div class="RoundBoardTitleBarButton" onclick="sbload('GenSb','Caller?p1=RoundCP&p2=@round_id');AdjustMainView();">⚙️</div>
                            <div class="RoundBoardTitleBarButton" onclick="sbload('GenSb','RepCaller?p1=AddOrder&p2=@round_id');AdjustMainView();">➕</div>

                        </div>

                        <div style="float: right">
                            <div class="B" style="font-size: 28px;" id="RoundMainTitle">
                                <b>@round_info.title  <span style="color:@viewTitleColor;font-size:20px;display:none">@viewTitle</span></b> <span class="WhiteMiniTag"> @round_type_title #@round_id</span>
                            </div>
                            <div class="B" style="font-size: 28px; color:yellow;display:none;" id="deliveriesTitle">
                                <b>@round_info.title ניהול משלוחים </b> <span class="WhiteMiniTag"> @round_type_title #@round_id</span>
                            </div>
                        </div>





                        <div style="font-size: 30px;float: left">


                            <span class="RoundBoardToolTipBox" style="float: left;" id="SelectZDateDiv">
                                <span style="float:left">📄</span><span><b> Z#@main_z_id</b></span> <span class="MiniTag">@ActiveZ.z_date.ToShortDateString()</span>
                            </span>
                            <span class="RoundBoardToolTipBox" style="float: left;">💰 @round_total.ToString("C", culture)</span>
                            <span class="RoundBoardToolTipBox" style=" float: left;" onclick="sbload('GenSb','Caller?p1=ZREPORT&p2=@active_z_serial');AdjustMainView();">📋</span>



                            <div class="RoundBoardTitleBarButton" style="float: left;" onclick="RepAjaxUpdate('ROUNDLOG',  'round_board_container', 'MainLoader', @round_id);">📜 </div>
                            @if (round_type == 1)
                            {

                                <div class="RoundBoardTitleBarButton">

                                    📦 אריזה
                                    @if (packing_issues_orders_counter > 0)
                                    {
                                        <span style="float:left;background-color:#f00;color:yellow;padding:2px"><b>@packing_issues_orders_counter</b></span>
                                    }

                                </div>
                                <div class="RoundBoardTitleBarButton" style="display:none " onclick="RepAjaxUpdate('Deliveries', 'round_board_container', 'MainLoader', @round_id, 0); hideElement('RoundMainTitle'); showElement('deliveriesTitle');">
                                    <b>🚚 משלוחים</b>

                                </div>

                            }
                            @if (round_type == 4)
                            {
                                string expressAvailabilityBgColor = "white;";
                                string pickupAvailabilityBgColor = "white;";
                                if (is_express) { expressAvailabilityBgColor = "#57d600;"; }
                                if (is_pickup) { pickupAvailabilityBgColor = "#57d600;"; }
                                <div class="RoundBoardTitleBarButton" style="background-color: @expressAvailabilityBgColor;">🛵</div>
                                <div class="RoundBoardTitleBarButton" style="background-color: @pickupAvailabilityBgColor; ">🏠</div>
                            }

                        </div>


                        <div class="B" style="padding: 0; margin: 0; background-color: #000; text-align: center; float: left">


                            @if (!is_active_z)
                            {
                                <span style="background-color: #fff;color: #000;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: left;margin: 5px;">
                                    <span style="color:#ff6a00"><b>אין Z פעיל! </b></span>
                                </span>


                            }


                            <div class="B" style="float:left">

                                @if (vendor_cancelled_orders_counter > 0)
                                {
                                    <span class="RoundBoardToolTipBox" style="color: #f00; float: left" onclick="RepAjaxUpdate('RoundBoard', 'MainBoardContainer', 'RoundBoardLoader', '@round_id', 'VENDOR', '@z_id');">
                                        😞 @vendor_cancelled_orders_counter
                                    </span>
                                }



                                @if (future_orders_counter > 0)
                                {
                                    <span class="RoundBoardToolTipBox" style="float:left" onclick="RepAjaxUpdate('RoundBoard', 'MainBoardContainer', 'RoundBoardLoader', '@round_id', 'FUTURE', '@z_id');">
                                        🌎 @future_orders_counter
                                    </span>
                                }

                                @if (completed_orders_counter > 0)
                                {
                                    <span class="RoundBoardToolTipBox" style="float:left" onclick="RepAjaxUpdate('RoundBoard', 'MainBoardContainer', 'RoundBoardLoader', '@round_id', 'COMPLETED', '@z_id');">
                                        ✅ @completed_orders_counter
                                    </span>
                                }

                                @if (cancelled_orders_counter > 0)
                                {
                                    <span class="RoundBoardToolTipBox" style="float:left" onclick="RepAjaxUpdate('RoundBoard', 'MainBoardContainer', 'RoundBoardLoader', '@round_id', 'CANCELLED', '@z_id');">
                                        ⛔ @cancelled_orders_counter
                                    </span>
                                }

                            </div>




                        </div>




                    </div>
                    @if (round_type == 1)
                    {
                        string newOrdersViewClass = "RoundBoardDeliveryTipBox";
                        string unAssignedOrdersViewClass = "RoundBoardDeliveryTipBox";
                        if (showWhat == "NODELIVERY") { unAssignedOrdersViewClass = "RoundBoardSelectedView"; }
                        if (showWhat == "NEW") { newOrdersViewClass = "RoundBoardSelectedView"; }

                        <div style="overflow: auto;background-color: @title_bar_bg_color;color: #fff;vertical-align:bottom">
                            <div class="B" style="float:right;">
                                <span class="@newOrdersViewClass" onclick="RepAjaxUpdate('RoundBoard', 'MainBoardContainer', 'RoundBoardLoader', '@round_id', 'NEW', '@z_id');">
                                    💫 @new_orders_counter
                                </span>
                                @if (unAssignedOrdersCounter > 0)
                                {
                                    <span class="@unAssignedOrdersViewClass" style="color:#f00;float:right;" onclick="RepAjaxUpdate('RoundBoard', 'MainBoardContainer', 'RoundBoardLoader', '@round_id', 'NODELIVERY', '@z_id');">
                                        ⛓️‍💥 @unAssignedOrdersCounter
                                    </span>
                                }


                                <div class="B" style="float: right;display:none ">
                                    <span class="RoundBoardToolTipBox" style="color:@round_start_time_bg_color;float:left;" onclick="hideElement('viewRoundStartDiv'); showElement('changeRoundStartDiv');">
                                        🕒 @order_close_hour.ToString("HH:mm") <span style="font-size:11px;">@AppFunctions.FormatRelativeDate(order_close_hour)</span>
                                    </span>

                                    <span style="display: none; float: left;">
                                        <span style="background-color: #fff; color: #000; padding: 5px; font-size: 16px; border-radius: 5px; border: 1px solid #57d600; float: left; margin: 5px; margin-right: 1px; margin-left: 1px" onclick="AjaxActions('UpdateRoundScheduledDelivery', '@round_id', 'MainLoader', document.getElementById('order_close_hour').value);">
                                            <span style="color:#ff6a00">✔️</span>
                                        </span>
                                        <span style="background-color: #fff; color: #000; padding: 5px; font-size: 16px; border-radius: 5px; border: 1px solid #57d600; float: left; margin: 5px; margin-right: 1px; margin-left: 1px" onclick="hideElement('changeRoundStartDiv');showElement('viewRoundStartDiv');">
                                            <span style="color:#ff6a00">❌</span>
                                        </span>
                                        <span style="background-color: #fff;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: left;margin: 5px;margin-right:1px;margin-left:1px">
                                            <input type="time" style="padding:5px;font-size:16px;border:0;direction:rtl;font-weight:bold;" id="order_close_hour" name="order_close_hour" value="@round_info.order_close_hour.ToString("HH:mm")">
                                        </span>
                                    </span>
                                </div>


                                @foreach (var dlvry in deliveries)
                                {

                                    if (dlvry != null)
                                    {
                                        try { order_close_hour = dlvry.order_close_hour; } catch { }
                                        try { round_start = dlvry.scheduled_start; } catch { }
                                    }


                                    if (order_close_hour > local_time)
                                    {
                                        round_start_time_bg_color = "#57d600";
                                    }
                                    else
                                    {
                                        round_start_time_bg_color = "#f00";
                                    }

                                    bool has_started = dlvry.has_started;

                                    int orders_in_delivery = 0;
                                    string delivery_class = "RoundBoardFutureDelivery";
                                    string delivery_order_counter_class = "RoundBoardOrdersDeliveryCounter";
                                    string active_delivery_icon = "";
                                    sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE delivery_id=@0 AND is_cancelled=0";
                                    var ordersCnt = db.QuerySingle(sqlSelect, dlvry.serial);
                                    try { orders_in_delivery = ordersCnt.the_cnt; } catch { }
                                    if (orders_in_delivery == 0)
                                    {
                                        delivery_order_counter_class = "RoundBoardNoOrdersDeliveryCounter";
                                    }

                                    DateTime delivery_order_close_hour = dlvry.order_close_hour;
                                    round_start_time_bg_color = "#57d600";
                                    if (delivery_order_close_hour < local_time)
                                    {
                                        delivery_class = "RoundBoardPastDelivery";
                                    }
                                    if (dlvry.serial == active_delivery_id)
                                    {
                                        active_delivery_icon = "⭐";
                                    }

                                    if (has_started)
                                    {
                                        active_delivery_icon = "🚚";
                                        delivery_class = "RoundBoardInTransitDelivery";
                                    }

                                    if (dlvry.serial == requested_delivery_id)
                                    {

