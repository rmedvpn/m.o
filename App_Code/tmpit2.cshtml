var order = db.QuerySingle(sqlSelect, order_id);
string short_round_title = ""; try { short_round_title = NewAppFunctions.GetTitleById("Round_Short", order.round_id); } catch { }
string vendor_name = ""; try { vendor_name = NewAppFunctions.GetTitleById("Vendor", order.vendor_id); } catch { }
//  int round_id = order.round_id;

string round_title = "טרם נקבע"; try { round_title = AppFunctions.GetRoundTitleById(round_id); } catch { }
string ItemUnit = "";


int ItemsToBeReplacedCount = 0;
int ReplacementItemsCount = 0;
string reqActionTxt = "";

string sep = "##";

if (return_items_scope.IsEmpty())
{
    errMsg += "חובה לבחור פריטים להחזרה!<br/>";

}

if (!is_refund && !is_voucher && !is_exchange)
{
    errMsg += "חובה לבחור את אופן הטיפול בהחזרה!<br/>";

}

if (return_notes.IsEmpty())
{
    errMsg += "חובה לציין את סיבת ההחזרה!<br/>";

}


if (return_items_scope == "SOME")
{
    if (!ItemsToReplace.IsEmpty())
    {

        string[] returningItemsArr;


        returningItemsArr = ItemsToReplace.Split(sep.ToCharArray());


        foreach (var item in returningItemsArr)
        {
            int return_item_id = 0; try { return_item_id = Convert.ToInt32(item); } catch { }

            if (return_item_id > 0)
            {
                errMsg = "";
                int quan_to_replace = 0;
                ItemsToBeReplacedCount++;
                sqlSelect = "SELECT id,p_id,title,quan FROM orderitems WHERE id=@0";
                var ReturningItem = db.QuerySingle(sqlSelect, return_item_id);
                string product_title = ""; try { product_title = ReturningItem.title; } catch { }
                int product_id = 0; try { product_id = ReturningItem.p_id; } catch { }
                int itemQuan = 0; try { itemQuan = ReturningItem.quan; } catch { }

                string ActionTypefldName = ""; try { ActionTypefldName = "ItemToReplaceAction_" + ReturningItem.id + "_For_" + order_id; } catch { }

                // string QuanToReplacefldName = "ReplacementItemQuan_" + ReturningItem.id + "_For_" + ReturningItem.p_id;
                string QuanToReplacefldName = "";
                try { QuanToReplacefldName = "tb_ItemToReplace_" + ReturningItem.p_id + "_For_" + order_id; } catch { }

                try { quan_to_replace = Convert.ToInt32(Request[QuanToReplacefldName]); } catch { }

                if (quan_to_replace <= 0)
                {
                    errMsg += "חובה להכניס כמות תקינה להחלפה עבור המוצר " + product_title + "<br/>" ;
                }

                if (quan_to_replace > itemQuan)
                {
                    errMsg += "הכמות המבוקשת להחזרה גדולה מהכמות בהזמנה!<br/>";
                }
            }


        }

    }
    else
    {
        errMsg += "חובה לבחור פריטים להחלפה!<br/>";

    }


}

if (is_exchange)
{
