                    {
                        errMsg += "חובה לבחור כמות למוצר הטבה!<br>";
                    }

                }
                break;

            case "VOUCHER":
                if (true)
                {
                    if (voucher_type.IsEmpty())
                    {
                        errMsg += "חובה לבחור סוג שובר!<br>";
                    }

                    if (voucher_type == "GIFT")
                    {
                        if (order_discount_amount <= 0 )
                        {
