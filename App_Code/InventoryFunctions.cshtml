    public static int GetInventoryEntityForRound (int round_id)
    {
        var db = Database.Open("op_data");
        DateTime time_stamp=DateTime.Now;

        //first check if an inventory entity exists for the round
        var sqlSelect="";
        sqlSelect="SELECT title,vendor_id,inv_entity_id FROM rounds WHERE id=@0";
        var round = db.QuerySingle(sqlSelect,round_id);
        if(round!=null){
            int round_inv_entity=0;
            round_inv_entity=round.inv_entity_id;
            if(round_inv_entity==0)
            {
                DateTime timestamp=DateTime.Now;
                sqlSelect="INSERT INTO inv_Entities(entity_name,entity_type,created_by,ts,v_id,round_id) VALUES(@0,@1,@2,@3,@4,@5)";
                db.Execute(sqlSelect,round.title,-2,WebSecurity.CurrentUserId,timestamp,round.vendor_id,round_id);
                sqlSelect="SELECT serial FROM inv_Entities WHERE round_id=@0 AND ts=@1";
                var rs=db.QuerySingle(sqlSelect,round_id,timestamp);

                if(rs!=null)
                {
                    round_inv_entity= rs.serial;
                    sqlSelect = "UPDATE rounds SET inv_entity_id=@0 WHERE id=@1";
                    db.Execute(sqlSelect,round_inv_entity,round_id);
                }
            }

            return round_inv_entity;




        }
        else{
            return -1;
        }
        db.Close();
    }


    public static void updateAvailableQuan (int rec_id,string updatedRecordType="PRODUCT")
    {
        var db = Database.Open("op_data");
        var sqlSelect="";
        int available_quan=0;
        switch(updatedRecordType){
            case "CATALOG":
                break;
            case "PRODUCT":
                if(true){
                    int p_id=rec_id;
                    sqlSelect = "select sum(quan) as available_quan from inv_transactions where p_id=@0";
                    var rs = db.QuerySingle(sqlSelect,p_id);
                    try{available_quan=rs.available_quan;}catch{}
                    sqlSelect = "UPDATE products SET available_quan=@0 WHERE p_id=@1";
                    db.Execute(sqlSelect,available_quan,p_id);
                }
                break;
            case "ROUNDMENUITEMS":
                //fetch all rounds with this product id in the menu, then recalc inventory for each one.
                if(true){
                    int p_id=rec_id;
                    sqlSelect = "SELECT DISTINCT round_id from roundMenuItems where p_id=@0";
                    var rs = db.Query(sqlSelect,p_id);
                    foreach(var round in rs){
                        InventoryFunctions.reCalcRoundInventory(round.round_id);
                    }
                }

                break;

        }
        db.Close();

    }

    public static void reCalcRoundInventory (int round_id)
    {
        var db = Database.Open("op_data");
        var sqlSelect="";

        //step1: get all inventory entities linked to this round
        sqlSelect = "SELECT * FROM RoundInventoryEntities WHERE round_id=@0";
        var RoundInventoryEntities=db.Query(sqlSelect,round_id);
        //step2: for every entity, load all available products
        sqlSelect = "SELECT DISTINCT(p_id) FROM inv_transactions WHERE";
        string conditionSql="";
        foreach(var roundEntity in RoundInventoryEntities){
            conditionSql = conditionSql + " entity_id=" + roundEntity.entity_id + " OR";
        }

        if(conditionSql!=""){
            conditionSql=conditionSql.Remove(conditionSql.Length-2);
            sqlSelect = sqlSelect + conditionSql;
            var entityProducts = db.Query(sqlSelect);
            foreach(var product in entityProducts){
                sqlSelect = "SELECT SUM(quan) AS the_quan FROM inv_transactions WHERE (p_id=@0) AND (" + conditionSql + ")";
                var prodAvailableQuan=db.QuerySingle(sqlSelect,product.p_id);
                int prodQuan=0;try{prodQuan=prodAvailableQuan.the_quan;}catch{}
                sqlSelect = "UPDATE roundMenuItems SET available_quan=@0 WHERE round_id=@1 AND p_id=@2";
                db.Execute(sqlSelect,prodQuan,round_id,product.p_id);
            }
        }

        db.Close();
    }

