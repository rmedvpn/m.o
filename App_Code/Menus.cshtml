                    </div>
                    <div style="padding: 5px;margin: 5px;overflow: auto;">
                        <input type="checkbox" style="margin: 5px;height: 20px;width: 20px;" @if (round.is_guaranteed) { <text> checked</text>} id="is_guaranteed" name="is_guaranteed"> סיבוב באחריות מורחבת
                    </div>
                    <div style="padding: 5px;margin: 5px;overflow: auto;">
                        <input type="checkbox" style="margin: 5px;height: 20px;width: 20px;" @if (round.is_accepting_credit) { <text> checked</text>} id="is_accepting_credit" name="is_accepting_credit"> הסבב מאושר לתשלום בהקפה
                    </div>
                    <div style="padding: 5px;margin: 5px;overflow: auto;">
                        <input type="checkbox" style="margin: 5px;height: 20px;width: 20px;" @if (round.is_accepting_debt_collection) { <text> checked</text>} id="is_accepting_debt_collection" name="is_accepting_debt_collection"> הסבב מאושר לאיסוף חובות
                    </div>
                    <div style="padding: 5px;margin: 5px;overflow: auto;">
                        <input type="checkbox" style="margin: 5px;height: 20px;width: 20px;" @if (round.is_accepting_charity_payment) { <text> checked</text>} id="is_accepting_charity_payment" name="is_accepting_charity_payment"> הסבב מאושר לתשלום מקופת הקהילה
                    </div>
                    <div style="padding: 5px;margin: 5px;overflow: auto;">
                        <input type="checkbox" style="margin: 5px;height: 20px;width: 20px;" @if (round.is_accepting_charity_donations) { <text> checked</text>} id="is_accepting_charity_donations" name="is_accepting_charity_donations"> הסבב מאושר לאיסוף תרומות לקופת הקהילה
                    </div>
                </div>
                <div style="overflow: auto;text-align: center">
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #808080;color: #fff" onclick="hideElement('RoundInfoEdit');showElement('RoundInfoView');">ביטול</button>
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #57d600;color: #fff" onclick="AjaxActions('SaveRoundBasicInfo', '@round_id','','RoundBasicInfo', 'GENERAL');">שמירת שינויים</button>
                </div>
            </div>
            <div class="Spacer100"></div>
        </form>
    </div>
}


