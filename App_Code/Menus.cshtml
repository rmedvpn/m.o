@using System
@using System.Collections.Generic
@using System.Globalization

@using System.Web.Script.Serialization

@helper MenusAdmin(string showWhat = "ACTIVE", int vendor_id = 0)
{
    if (showWhat == "") { showWhat = "ACTIVE"; }
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string txtHeader = "תפריטים ";
    sqlSelect = "SELECT * FROM rounds WHERE round_type=5 AND is_deleted=0 ";
    if (vendor_id != 0)
    {
        sqlSelect = sqlSelect + " AND vendor_id=@0";
        txtHeader = txtHeader + "- לספק " + AppFunctions.GetVendorTitleById(vendor_id);
    }

    sqlSelect = sqlSelect + " order by vendor_id,round_type,sort_order"; //" order by is_setup DESC,round_type,vendor_id DESC,id DESC";
    var Rounds = db.Query(sqlSelect, vendor_id);
    sqlSelect = "SELECT * FROM vendors";
    var vendors = db.Query(sqlSelect);

    <div style="overflow: auto;direction:rtl">
        <input type="hidden" id="showWhat" value="@showWhat">
        <div style="overflow: auto;padding: 5px;">
            <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;" onclick="Accordionize('AddRoundAcc')">חדש</button>
            <select style="font-size: 16px;margin: 5px;padding: 5px;float: left" name="showing_vendor" id="showing_vendor" onChange="RepAjaxUpdate('MENUSADMIN', 'MainBoardContainer', 'MainLoader', document.getElementById('showWhat').value, this.value);">
                <option value="0">כל הספקים</option>
                @foreach (var vendor in vendors)
                {
                    <option value="@vendor.vendor_id" @if (vendor.vendor_id == vendor_id) { <TEXT> selected</TEXT>}>@vendor.vendor_name </option>
                }
            </select>
            <div style="font-size: 20px;float: right;color: #000">@txtHeader</div>
        </div>
        <div style="overflow: auto;">
            <button class="accordion" id="AddRoundAcc" style="display: none"></button>
            <div class="panel">
                <form id="AddNewVendorMenu">
                    <div style="overflow: auto;padding: 5px;border: 1px dotted #b200ff">
                        <div style="overflow: auto;float: right;">
                            <input type="text" id="title" name="title" placeholder="שם התפריט" style="font-size: 16px;margin: 5px;padding: 5px;float: right">
                            <input type="text" id="title_e" name="title_e" placeholder="In English" style="font-size: 16px;margin: 5px;padding: 5px;float: right">

                            <select style="font-size: 16px;margin: 5px;padding: 5px;float: right" name="vendor_id" id="vendor_id">
                                <option value="">נא לבחור</option>
                                @foreach (var vendor in vendors)
                                {
                                    <option value="@vendor.vendor_id">@vendor.vendor_name</option>
                                }
                            </select>
                            <button type="button" class="A" onclick="AjaxActions('AddNewVendorMenu', '','', 'AddNewVendorMenu');">שמירה</button>
                        </div>


                    </div>
                </form>
            </div>
        </div>

        <div style="overflow: auto;clear: both;">
            @foreach (var round in Rounds)
            {
                string bgRawColor = "#000";
                bool is_setup = round.is_setup;
                bool is_active = round.is_active;
                if (!round.is_setup)
                {
                    bgRawColor = "#f00";
                }

                string round_vendor_name = "";
                round_vendor_name = AppFunctions.GetVendorTitleById(round.vendor_id);

                <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;background-color:#fff;color: #000;border-bottom: 1px dashed #000" id="RoundDiv_@round.id">
                    <div style="overflow: auto;float: right;background-color: #fff;color: #808080;padding: 5px;margin: 5px;width: 40px;text-align: center;border-radius: 5px;font-size: 14px">
                        @if (round.is_setup && is_active)
                        {
                            <span style="color: #57d600">פעיל</span>
                        }
                        else
                        {
                            if (!is_setup)
                            {
                                <span style="color: #808080">לא מוגדר</span>
                            }
                            if (!is_active && is_setup)
                            {
                                <span style="color: #f00">לא פעיל</span>
                            }


                        }
                    </div>
                    <div style="overflow: auto;float: right;background-color: #fff;color: #808080;padding: 5px;margin: 5px;width: 120px;text-align: center;border-radius: 5px;font-size: 14px">@round_vendor_name</div>
                    <div style="overflow: auto;float: right;background-color: #57d600;color: #fff;padding: 5px;margin: 5px;width: 120px;text-align: center;border-radius: 5px;font-size: 14px;font-weight:bold;">תפריט <span style="margin-right:5px;font-size:11px;">#@round.id</span></div>

                    <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #808080" onclick="MiscActions('SelectEntry','RoundDiv_@round.id');sbload('GenSb','Caller?p1=VendorMenuEdit&p2=@round.id');AdjustMainView();">הגדרות</button>
                    <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #808080" onclick="MiscActions('SelectEntry','RoundDiv_@round.id');sbload('GenSb','Caller?p1=EditMenuItems&p2=@round.id');AdjustMainView();">תפריט</button>
                    <div style="overflow: auto;padding: 5px;font-size: 20px;">@round.title </div>
                </div>
            }
        </div>


        <div style="overflow:auto;height:250px;">&nbsp;</div>


    </div>
    db.Close();
}


@helper VendorMenuEdit(int round_id, string viewMode = "GENERAL")
{
    <div>@Menus.VendorMenuControlPanel(round_id, viewMode)</div>
}


@helper EditMenuItems(int round_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    int vendor_id = 0; try { vendor_id = round.vendor_id; } catch { }
    string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);

    <div style="padding: 0;margin: 0;;overflow: auto;background-color: #fff;direction:rtl">
        <div style="background-color:  #000; overflow: auto; font-size: 24px; color: #fff;">
            #@round.id @round.title - תפריט
        </div>

        <div style="overflow: auto;">
            <input type="hidden" name="RoundToUpdate" id="RoundToUpdate" value="@round_id">
            <div class="RoundMenuItemsEditorTitle"  >
                ספק: @vendor_name
                <button type="button" class="RoundMenuItemsEditorTitleBtn" onclick="    hideElement('RoundMenuDiv');showElement('RoundSpecialsDiv');">מבצעים</button>
                <button type="button" class="RoundMenuItemsEditorTitleBtn" onclick="showElement('RoundMenuDiv');hideElement('RoundSpecialsDiv');">מוצרים</button>

                <div class="spinner" style="text-align: center;display: none;float: left" id="RoundMenuLoader">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>

            </div>
            <div class="B">
                <div class="B" style="overflow: auto;color:#000" id="RoundMenuDiv">
                    @Menus.MenuItems(round_id)
                </div>
                <div class="B" style="overflow: auto; color: #000;display:none" id="RoundSpecialsDiv">
                    @Menus.RoundSpecials(round_id)

                </div>
            </div>
            
                


        </div>

        <div class="Spacer100"></div>
        <div class="Spacer100"></div>


    </div>

}

@helper MenuItems(int round_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * from roundMenuItems WHERE  is_deleted=0 AND round_id=@0 ORDER BY maincat_id,sub_cat_id";
    var roundMenuItems = db.Query(sqlSelect, round_id);
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    int vendor_id = 0;
    sqlSelect = "SELECT vendor_id FROM rounds where id=@0";
    var roundInfo = db.QuerySingle(sqlSelect, round_id);
    vendor_id = roundInfo.vendor_id;
    sqlSelect = "SELECT * FROM products where is_active=1 AND v_id=@0";
    var vendorsProducts = db.Query(sqlSelect, vendor_id);
    int cur_main_cat = -1;
    int cur_sub_cat = -1;
    int curCat = 0;

    <div style="overflow: auto;">
        <div class="B">
            <button type="button" style="float:left;padding:5px;margin:5px;border:0;background:transparent;" onclick="toggle_visibility('AddItemToProductDiv');">➕</button>
            <h2>מוצרים</h2>

        </div>
        <div style="overflow: auto;display:none" id="AddItemToProductDiv">
            <select style="font-size: 16px;padding: 5px;margin: 5px;" onchange="AjaxActions('AddProductToRound', @round_id,'MainLoader', this.value);">
                <option>נא לבחור מוצר להוספה ממוצרי הספק..</option>
                <option value="-1">הוספת כל מוצרי הספק לתפריט</option>
                @foreach (var product in vendorsProducts)
                {
                    sqlSelect = "SELECT id FROM roundMenuItems WHERE p_id=@0 AND round_id=@1";
                    var isInMenuCheck = db.QuerySingle(sqlSelect, product.p_id, round_id);
                    if (isInMenuCheck == null)
                    {
                        <option value="@product.p_id">@product.title</option>
                    }
                }
            </select>
        </div>
        <div class="B">
            @foreach (var item in roundMenuItems)
            {
                string price_options_json = "";
                try { price_options_json = item.price_options_json; } catch { }

                bool is_featured = false;
                bool is_active = true;
                try { is_featured = item.is_featured; } catch { }
                try { is_active = item.is_active; } catch { }

                string favRes = is_featured ? "true" : "false";

                string is_active_class = "PPOBtnItem"; if (is_active) { is_active_class = "PPOBtnItemSelected"; }
                string is_featured_class = "PPOBtnItem"; if (is_featured) { is_featured_class = "PPOBtnItemSelected"; }

                var PricingOptions = new List<Dictionary<string, object>>();

                if (!string.IsNullOrWhiteSpace(price_options_json))
                {
                    try
                    {
                        var serializer = new JavaScriptSerializer();
                        PricingOptions = serializer.Deserialize<List<Dictionary<string, object>>>(price_options_json);
                    }
                    catch { }
                }

                int currentRoundId = 0;
                try { currentRoundId = Convert.ToInt32(item.round_id); } catch { }

                var FilteredPricingOptions = PricingOptions
                    .Where(x =>
                        Convert.ToInt32(x["round"]) == currentRoundId ||
                        Convert.ToInt32(x["round"]) == 99999 ||
                        Convert.ToInt32(x["round"]) == 0
                    )
                    .OrderBy(x => Convert.ToInt32(x["quan"]))
                    .ToList();
                string bgColor = "#fff";
                string cur_main_cat_name = "";
                string cur_sub_cat_name = "";
                string itmLink = "sbload('GenSb','Caller?p1=ProductEdit&p2=" + item.p_id + "');AdjustMainView();";
                string itmCls = "VendorProductEntry";


                if (cur_main_cat != item.maincat_id)
                {
                    cur_main_cat = item.maincat_id;
                    cur_sub_cat = -1;
                }
                if (cur_sub_cat != item.sub_cat_id)
                {
                    cur_sub_cat = item.sub_cat_id;

                }

                try { cur_main_cat_name = NewAppFunctions.GetTitleById("Cat", cur_main_cat); } catch { }
                try { cur_sub_cat_name = NewAppFunctions.GetTitleById("Cat", cur_sub_cat); } catch { }


                if (curCat != cur_main_cat)
                {
                    curCat = cur_main_cat;
                    <div style="overflow:auto;margin-right:10px;padding:5px;font-size:18px;color:white;background-color:#808080">@cur_main_cat_name</div>
                }
                <div class="VendorMenuItemDiv" onclick="sbload('SubMenuLeft','Caller?p1=MenuItemEdit&p2=@item.id');">

                    <div style="overflow: auto;color: #000">



                        <img class="VendorMenuItemImg" src="ImgViewer?size=tn&p_id=@item.p_id" alt="אלט" />
                        <div style="font-size: 18px; color: #000; float: right; padding: 5px;">
                            <div class="B" style="padding:1px;">
                                @item.Title
                            </div>
                            <div class="B" style="font-size: 14px; padding: 1px;color:#808080">
                                @cur_sub_cat_name
                            </div>


                        </div>
                        @if (is_featured)
                        {
                            <div class="B" style="float:left;padding:5px;margin:5px;">⭐</div>
                        }
                    </div>


                </div>
            }

        </div>
    </div>


    db.Close();
}

@helper RoundSpecials(int round_id)
{
var db = Database.Open("op_data");
var sqlSelect = "SELECT specialOffers.title,specialOffers.price,specialOffers.id FROM specialOffers INNER JOIN SpOfferRoundsAvailability ON specialOffers.id=SpOfferRoundsAvailability.specialOfferId WHERE SpOfferRoundsAvailability.round_id=@0 AND specialOffers.is_deleted<>1 ORDER BY specialOffers.spOfferType DESC";
var specials = db.Query(sqlSelect, round_id);
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
int vendor_id = 0;
sqlSelect = "SELECT vendor_id FROM rounds where id=@0";
var roundInfo = db.QuerySingle(sqlSelect, round_id);
try { vendor_id = roundInfo.vendor_id; } catch { }

sqlSelect = "SELECT * FROM specialOffers where is_active=1 AND (vendor_id=@0 OR vendor_id=0) ORDER BY vendor_id DESC,spOfferType";
var AllSpecialOffers = db.Query(sqlSelect, vendor_id);


    <div style="overflow: auto;">

        <div class="B">
            <button type="button" style="float:left;padding:5px;margin:5px;border:0;background:transparent;" onclick="toggle_visibility('AddSpOfferToMenuDiv');">➕</button>
            <div class="spinner" style="text-align: center;display: none;float: left" id="RoundSpLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>

            <h2>מבצעים</h2>

        </div>
        <div style="overflow: auto;display:none" id="AddSpOfferToMenuDiv">
            <select style="font-size: 16px;padding: 5px;margin: 5px;" onchange="AjaxActions('AddOfferToRound', this.value, 'MainLoader',@round_id, '1');">
                <option>נא לבחור מבצע להוספה לתפריט..</option>
                <option value="-1">הוספת כל המבצעים לתפריט</option>
                @foreach (var spOffer in AllSpecialOffers)
                {
                    sqlSelect = "SELECT id FROM SpOfferRoundsAvailability WHERE specialOfferId=@0 AND round_id=@1";
                    var isInMenuCheck = db.QuerySingle(sqlSelect, spOffer.id, round_id);
                    if (isInMenuCheck == null)
                    {
                        <option value="@spOffer.id">@spOffer.title</option>
                    }
                }
            </select>
        </div>
        @if (specials.Count() > 0)
        {
            foreach (var spOffer in specials)
            {


                sqlSelect = "SELECT * FROM SpecialOffersItems WHERE spOffer_id=@0 order by main_cat_id";
                var spItemsIncluded = db.Query(sqlSelect, spOffer.id);
                <div style="overflow: auto; color: #000; border-bottom: 1px dotted #000" id="spOfferItemsList" onclick="Accordionize('sp_@spOffer.id');">
                    <div style="overflow: auto;font-size: 22px;font-weight: bold;margin: 5px;">
                    @spOffer.title <span style="float: left">@spOffer.price.ToString("C", culture)</span>
                    </div>
                    <button class="Accordion" style="display: none" id="sp_@spOffer.id"></button>
                    <div class="panel" style="padding:0;margin:0">

                        <div style="overflow: auto;margin-right:15px;">
                            @foreach (var item in spItemsIncluded)
                            {
                                string cat_title = "";
                                try { cat_title = NewAppFunctions.GetTitleById("Cat", item.main_cat_id); } catch { }
                                <div>
                                    @if (item.SpItemType == 1)
                                    {
                                        <div style="overflow: auto;font-size: 18px;color: #ff6a00">@item.quan @item.itemunit @cat_title @item.title</div>
                                    }
                                    else
                                    {
                                        <div style="overflow: auto;font-size: 18px;">@item.quan @item.itemunit @cat_title @item.title </div>
                                    }
                                </div>


                            }

                        </div>


                        <div class="spinner" style="text-align: center;display: none;float: left" id="spOfferItemsLoader">
                            <div class="bounce1"></div>
                            <div class="bounce2"></div>
                            <div class="bounce3"></div>
                        </div>

                    </div>


                </div>
            }

        }
        else
        {
            <div style="padding: 5px;margin: 5px;font-size: 16px;color: #808080;"> אין מבצעים בתפריט </div>

        }



    </div>
    <div style="overflow: auto;height:150px;">&nbsp;</div>
    db.Close();
}


@helper VendorMenuControlPanel(int round_id, string viewMode = "GENERAL")
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    if (round != null)
    {
        bool is_setup = round.is_setup;
        bool is_active = round.is_active;
        bool is_deleted = round.is_deleted;
        bool in_delivery_mode = round.in_delivery_mode;
        int vendor_id = round.vendor_id;
        int round_type = round.round_type;

        <input type="hidden" name="sRound_id" id="sRound_id" value="@round_id">
        <div style="padding: 0;margin: 0;overflow: auto;direction:rtl">

            <div style="background-color:  #000; overflow: auto; font-size: 24px; color: #fff;">

                @round.title <span style="font-size:12px;">#@round.id</span>
                @if (!is_active)
                {<span style="font-size:12px;margin-right:10px;background-color:#f00;color:yellow;padding:2px;"><b>לא פעיל</b></span>}
                <select name="viewType" style="padding: 3px;margin: 3px;font-size: 16px;float: left;margin-left: 10px;display:none" onchange="RepAjaxUpdate('MenuSettingsView', 'GenSbContent', 'GenSbLoader',@round_id, this.value)">

                    <option value="GENERAL" @if (viewMode == "GENERAL") { <text> selected</text>}>הגדרות כלליות</option>
                    <option value="FULLFILMENT" @if (viewMode == "FULLFILMENT") { <text> selected</text>}>הגדרות אספקה</option>
                </select>
            </div>

            <div style="text-align: right;font-size: 18px;padding: 0;margin: 0;color: #000;min-height: 600px;overflow: auto;background-color: #fff">


                @if (is_deleted)
                {
                    <div style="overflow: auto;background-color:yellow;padding: 5px;margin: 5px;border: 2px solid #f00">
                        <div style="overflow: auto">
                            התפריט נמחק!

                        </div>

                    </div>
                }

                @if (!is_setup)
                {
                    <div style="overflow: auto;background-color:#ffcccc;padding: 5px;margin: 5px;border: 2px solid #f00">
                        <div style="overflow: auto">
                            הפעלת תפריט זה במערכת לא הושלמה!<div style="overflow: auto;font-size: 12px;">התפריט '@round.title' לא מוצג כעת במערכת</div>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #e3e3e3;color: #000;float: left" onclick="AjaxActions('MenuFinishSetup', @round_id);">הפעלה</button>
                        </div>

                    </div>
                }



                <div style="overflow: auto" id="CurViewDiv">

                    @switch (viewMode)
                    {

                        case "GENERAL":
                            <div style="overflow: auto;">
                                @Menus.MenuFulfilmentSettings(round_id)
                            </div>
                            break;

                        case "FULLFILMENT":
                            <div style="overflow: auto;">
                                @Menus.VendorMenuFullfilment(round_id)
                            </div>
                            break;

                        default:
                            <div style="overflow: auto;">
                                vmn: @viewMode
                            </div>
                            break;

                    }

                </div>















            </div>




            <div class="Spacer100">&nbsp;</div>

        </div>

    }

    db.Close();
}

@helper MenuFulfilmentSettings(int round_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    string showMode = "";
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    string title = round.title;
    string e_title = round.e_title;
    string short_title = round.short_title;
    string description = round.description;
    string e_desc = round.e_desc;

    decimal min_order = round.min_order;
    decimal max_order = round.max_order;

    int shift_leader_id = round.shift_leader_id;

    sqlSelect = "SELECT * FROM RoundFullfilmentOptions WHERE round_id=@0 ORDER BY service_type";
    var serviceOptions = db.Query(sqlSelect, round_id);


    <div style="background-color: #fff;padding:5px;" id="RoundInfoView">


        <div class="B">
            <div class="B">

                <div class="B">
                    <button type="button" class="EditMenuOptionsBtn" onclick="showElement('RoundInfoEdit');hideElement('RoundInfoView');">אפשרויות</button>
                    <div class="ServiceOptionTitle">
                        @title
                    </div>
                </div>



                <div class="B">
                    <div style="overflow: auto">
                        <div style="overflow: auto;font-weight: bold;color: #b200ff">
                            מינימום הזמנה
                            <div style="float: left;color: #000;">@min_order.ToString("C", culture)</div>
                        </div>
                        <div style="overflow: auto;font-weight: bold;color: #b200ff">
                            מקסימום הזמנה
                            <div style="float: left;color: #000;">@max_order.ToString("C", culture)</div>
                        </div>

                        <div class="Spacer20"></div>
                        <div class="B">
                            <div class="B">
                                <button type="button" class="EditMenuOptionsBtn" onclick="RepAjaxUpdate('MenuSettingsView', 'GenSbContent', 'GenSbLoader',@round_id, 'FULLFILMENT');">חדש</button>
                                <div class="ServiceOptionTitle">
                                    אפשרויות אספקה
                                </div>
                            </div>


                            @if (serviceOptions.Count() > 0)
                            {
                                <div class="B">
                                    @foreach (var opt in serviceOptions)
                                    {
                                        <div class="ServiceOptionRow">
                                            <button class="A" style="float:left" onclick="sbload('SubMenuLeft','Caller?p1=EditMenuFullfilmentOption&p2=@round_id&p3=@opt.id');AdjustMainView();">📝</button>
                                            @opt.title_h
                                        </div>
                                        <div class="B">

                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="B" style="color:#f00;">אין אפשרויות אספקה פעילות!</div>
                            }


                        </div>



                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="background-color: #e3e3e3;display: none" id="RoundInfoEdit">
        <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
            הגדרות כלליות
            <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #f00;color: #fff;font-size: 16px;" onclick="hideElement('RoundInfoEdit');showElement('RoundInfoView');">ביטול</button>
        </div>

        <form id="RoundBasicInfo">
            <div style="padding: 0;margin: 0;overflow: auto;">
                <div style="overflow: auto;clear: both;font-size: 16px;font-weight: bold;padding: 5px;" id="RoundEditInfo">
                    <div style="overflow: auto;padding:5px;border-bottom:1px dotted #808080;">
                        <div style="float:right"><input type="checkbox" style="margin: 5px;height: 20px;width: 20px;" name="is_active" id="is_active" @if (round.is_active) { <text> checked</text> } onclick="AjaxActions('DeActivateRound', '@round_id','',this.checked);" /> ערוץ פעיל</div>
                        <button type="button" style="padding: 2px; font-size: 16px; background-color: #f00; color: #fff; float: left" onclick="AjaxActions('DeleteRound', '@round_id');">מחיקת ערוץ</button>

                    </div>
