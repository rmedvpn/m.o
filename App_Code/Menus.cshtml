                            <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">#משלוח</span><br>@sched.next_delivery_id</div>
                        }
                        else
                        {
                            <div style="float: left;padding: 3px;margin: 3px;text-align:center">
                                <span style="font-size: 12px;">#משלוח</span><br>
                                <button type="button" style="padding: 1px; margin: 1px; font-size: 12px; color: #f00; padding-left: 3px; padding-right: 3px;" onclick="AjaxActions('AddDeliveryToSchedule',@round_id,'MainLoader',  @sched.schedule_id, 'SCHEDULE');">יצירה</button>
                            </div>


                        }

                    </div>

                </div>
            }
        </div>




        <div style="height: 150px;overflow: auto;">&nbsp;</div>
    </div>


    <div style="overflow: auto;display:none">
        <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
            שעות פתיחה
            <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;display:none" onclick="">🥸 איפוס לברירת מחדל</button>
            <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="showElement('RoundEditScheduleDiv');hideElement('RoundScheduleDiv');">⚙️ עריכה</button>
        </div>

        <div class="A">




            @for (int dayOfWeek = 0; dayOfWeek < 7; dayOfWeek++)
            {

                sqlSelect = "SELECT * FROM RoundsSchedules WHERE DayOfWeek=@0 AND round_id=@1 ORDER BY express_open,pickup_open";
                var schedule = db.Query(sqlSelect, dayOfWeek, round_id);
                icon = "";
                string txt_color = "#000";

                <div style="padding: 0;margin: 0;overflow: auto;border-bottom: 1px dashed #e3e3e3">
                    <div style="overflow: auto;">
                        <div class="B" style="padding: 3px;margin: 3px;float:right">
                            <b>@icon יום @NewAppFunctions.strDayOfWeekFromInt(dayOfWeek)</b>

                        </div>
                        @if (schedule.Count() > 0)
                        {

                            <div class="B" style="float:left">
                                @foreach (var sched in schedule)
                                {
                                    DateTime defDate = Convert.ToDateTime("1/1/1900");
                                    bool is_express = true;
                                    DateTime opening_hour = defDate;
                                    DateTime closing_hour = defDate;
                                    try { opening_hour = sched.express_open; } catch { }
                                    try { closing_hour = sched.express_close; } catch { }
                                    if (opening_hour == defDate)
                                    {
                                        try { opening_hour = sched.pickup_open; } catch { }
                                        try { closing_hour = sched.pickup_close; } catch { }
                                        is_express = false;
                                    }
                                    <div class="B">
                                        <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">שעת סגירה</span><br>@closing_hour.ToString("HH:mm")</div>

                                        <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">שעת פתיחה</span><br>@opening_hour.ToString("HH:mm")</div>
                                        @if (is_express)
                                        {
                                            <div style="float: left;padding: 3px;margin: 3px;"><br>🛵</div>
                                        }
                                        else
                                        {
                                            <div style="float: left;padding: 3px;margin: 3px;"><br>🏠</div>
                                        }

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="B" style="float:left">
                                <div class="B" style="padding: 3px; margin: 3px; color: #f00;">
                                    סגור

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

        <div style="height: 150px;overflow: auto;">&nbsp;</div>
    </div>



    db.Close();
}


