@helper MenuItems_bck(int round_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * from roundMenuItems WHERE  is_deleted=0 AND round_id=@0 ORDER BY maincat_id,sub_cat_id";
    var roundMenuItems = db.Query(sqlSelect, round_id);
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    int vendor_id = 0;
    sqlSelect = "SELECT vendor_id FROM rounds where id=@0";
    var roundInfo = db.QuerySingle(sqlSelect, round_id);
    vendor_id = roundInfo.vendor_id;
    sqlSelect = "SELECT * FROM products where is_active=1 AND v_id=@0";
    var vendorsProducts = db.Query(sqlSelect, vendor_id);
    <div style="overflow: auto;">
        <div style="overflow: auto">
            <select style="font-size: 16px;padding: 5px;margin: 5px;" onchange="AjaxActions('AddProductToRound', @round_id,'MainLoader', this.value);">
                <option>נא לבחור מוצר להוספה ממוצרי הספק..</option>
                <option value="-1">הוספת כל מוצרי הספק לתפריט</option>
                @foreach (var product in vendorsProducts)
                {
                    sqlSelect = "SELECT id FROM roundMenuItems WHERE p_id=@0 AND round_id=@1";
                    var isInMenuCheck = db.QuerySingle(sqlSelect, product.p_id, round_id);
                    if (isInMenuCheck == null)
                    {
                        <option value="@product.p_id">@product.title</option>
                    }
                }
            </select>
        </div>

        @foreach (var item in roundMenuItems)
        {
            bool is_featured = false; try { is_featured = item.is_featured; } catch { }
            string favRes = "false";
            if (is_featured)
            {
                favRes = "true";
            }
            sqlSelect = "SELECT * FROM ProductPricingOptions WHERE p_id=@0 AND (round_id=@1 OR round_id=99999 OR round_id=0) ORDER BY quan";
            var PricingOptions = db.Query(sqlSelect, item.p_id, item.round_id);
            <div style="overflow: auto;padding: 3px;border-bottom: 1px dotted #000;margin: 3px">
                <div style="overflow: auto;color: #000 ">
                    <button style="padding: 5px;margin: 5px;background-color: #fff;border: 0;font-size: 22px;float: left" onclick="sbload('SubMenuLeft','Caller?p1=MenuItemEdit&p2=@item.id');">⚙️</button>
                    <button style="padding: 5px;margin: 5px;background-color: #fff;border: 0;font-size: 22px;float: left" onclick="Accordionize('menuItemAcc_@item.id');toggle_visibility('delItem_@item.id');">💡</button>
                    <button style="padding: 5px;margin: 5px;background-color: #fff;border: 0;font-size: 22px;float: left;display: none" id="delItem_@item.id" onclick="AjaxActions('RemoveMenuItemFromRound', @round_id,'',@item.id);">🗑️</button>

                    <div class="B" style="cursor:pointer; vertical-align: middle;float:right " onclick="AjaxActions('MenuItemIsFeaturedToggle','@favRes','MainLoader',@item.id,@round_id);">
                        @if (is_featured)
                        {
                            <span style="font-size: 30px; margin: 5px; margin-top: 10px;float:right ">
                                ❤️
                            </span>
                        }
                        else
                        {
                            <span style="font-size:30px;margin:5px;margin-top:10px;">
                                🤍
                            </span>
                        }

                    </div>

                    <img style="max-height: 50px;width: 50px;border-radius: 10px;margin: 5px;float: right;" src="ImgViewer?size=tn&p_id=@item.p_id&theTime=@DateTime.Now" alt="אלט" />
                    <div style="padding: 5px;margin: 5px;font-size: 18px;color: #000;float: right">
                        @item.Title
                    </div>
                </div>
                <div style="overflow: auto;color: #000">
                    <button style="display: none" class="Accordion" id="menuItemAcc_@item.id"></button>
                    <div class="panel" style="padding: 0;margin: 0">
                        <h2>מחירון מוצר</h2>


                        @foreach (var priceOption in PricingOptions)
                        {
                            string itemunit = ""; try { itemunit = NewAppFunctions.GetTitleById("ItemType", item.itemtype_id); } catch { }
                            <div style="overflow: auto;font-size: 16px;;margin: 5px;text-align: right;;border-bottom: 1px dotted #e3e3e3">
                                <div style="overflow: auto;">
                                    <div style="font-size: 14px;overflow: auto">
                                        <span style="padding: 5px;float: right;width: 100px;font-size: 16px;"><b>@Convert.ToInt32(priceOption.quan) @item.itemunit</b></span>
                                        <span style="padding: 5px;float: right">
                                            <b>@priceOption.price.ToString("C", culture)</b>
                                        </span>


                                    </div>
                                </div>


                            </div>
                        }
                    </div>
                </div>
            </div>

        }
    </div>

    db.Close();
}


@functions{

    public static string AddProductToRound()
    {
        int u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        DateTime local_time = AppFunctions.LocalTime();
        string theHtmlOutput = "";
        int round_id = 0; try { round_id = Convert.ToInt32(Request["value"]); } catch { }
        int p_id = 0; try { p_id = Convert.ToInt32(Request["param1"]); } catch { }
        int menuItem_id = 0;
        var db = Database.Open("op_data");
        var sqlSelect = "";

        if (p_id > 0)
        {

            theHtmlOutput = Menus.SyncRoundItemWithProduct(p_id, round_id);



        }
        if (p_id == -1)
        {
            sqlSelect = "SELECT vendor_id FROM rounds WHERE id=@0";
            var round = db.QuerySingle(sqlSelect, round_id);
            int vendor_id = 0; try { vendor_id = round.vendor_id; } catch { }
            sqlSelect = "SELECT p_id FROM Products WHERE v_id=@0 ORDER by p_id";
            var products = db.Query(sqlSelect, vendor_id);
            foreach (var product in products)
            {
                theHtmlOutput = Menus.SyncRoundItemWithProduct(product.p_id, round_id);

            }

        }

        Menus.UpdateMenuStatsAndParams(round_id);

        db.Close();

        return theHtmlOutput;
    }




