            }
            else
            {
                if (!Request["is_pickup"].IsEmpty())
                {
                    is_pickup = true;
                }
                if (!Request["is_express"].IsEmpty())
                {
                    is_express = true;
                }
            }
            var db = Database.Open("op_data");
            var sqlSelect = "";

            sqlSelect = "INSERT INTO dbo.rounds(title,e_title,vendor_id,round_type,is_route,is_pickup,is_express,is_catalog,create_ts,clerk_id) VALUES(@0,@1,@2,@3,@4,@5,@6,1,@7,@8)";
            db.Execute(sqlSelect, title, title_e, vendor_id, round_type, is_route, is_pickup, is_express, DateTime.Now, u_id);
            theHtmlOutput = " 👌 הסבב התווסף בהצלחה ";
            db.Close();

        }
        return theHtmlOutput;
    }


    public static void UpdateMenuStatsAndParams(int round_id)
    {
        int u_id = WebMatrix.WebData.WebSecurity.CurrentUserId;


        bool is_route = false;
        bool is_pickup = false;
        bool is_express = false;
        int ActiveSpOffersCount = 0;
        int ActiveProductsCount = 0;

        var db = Database.Open("op_data");
        var sqlSelect = "";

        sqlSelect = "SELECT TOP(1) id FROM RoundFullfilmentOptions WHERE is_active=1 AND is_route=1 AND round_id=@0";
        var chkRs = db.QuerySingle(sqlSelect, round_id);
        if (chkRs != null) { is_route = true; }

        sqlSelect = "SELECT TOP(1) id FROM RoundFullfilmentOptions WHERE is_active=1 AND is_express=1 AND round_id=@0";
        chkRs = db.QuerySingle(sqlSelect, round_id);
        if (chkRs != null) { is_express = true; }

        sqlSelect = "SELECT TOP(1) id FROM RoundFullfilmentOptions WHERE is_active=1 AND is_pickup=1 AND round_id=@0";
        chkRs = db.QuerySingle(sqlSelect, round_id);
        if (chkRs != null) { is_pickup = true; }

        sqlSelect = "SELECT COUNT(id) AS the_cnt FROM RoundMenuItems WHERE is_active=1 AND round_id=@0";
        chkRs = db.QuerySingle(sqlSelect, round_id);
        try { ActiveProductsCount = chkRs.the_cnt; } catch { }

        sqlSelect = "SELECT COUNT(id) AS the_cnt FROM SpOfferRoundsAvailability WHERE is_active=1 AND round_id=@0";
        chkRs = db.QuerySingle(sqlSelect, round_id);
        try { ActiveSpOffersCount = chkRs.the_cnt; } catch { }

        string json = AppJson.CreateFulfillmentOptionsJson(round_id);
        string SpOfferAvailabilityJson = AppJson.CreateMenuSpecialOffersAvailabilityJson(round_id, true);

        sqlSelect = "UPDATE ROUNDS set is_route=@0,is_express=@1,is_pickup=@2,ActiveProductsCount=@3,ActiveSpOffersCount=@4,FulfillmentJson=@5,SpOfferAvailabilityJson=@6 WHERE id=@6";
        db.Execute(sqlSelect, is_route, is_express, is_pickup, ActiveProductsCount, ActiveSpOffersCount, json, SpOfferAvailabilityJson, round_id);

        db.Close();
    }


