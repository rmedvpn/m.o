@helper SubCatList(int main_cat_id, string SubCatType = "")
{
    int cat_id = 0;
    string title = "";
    string e_title = "";
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string emptyTxt = "";
    switch (SubCatType)
    {
        case "SUBCAT":
            sqlSelect = "SELECT * FROM categories WHERE is_subcat=1 AND mainCat_id=@0";
            emptyTxt = "אין תתי קטגוריה";
            break;
        case "SPOFFER":
            sqlSelect = "SELECT * FROM categories WHERE is_spOffersCat=1 AND mainCat_id=@0";
            emptyTxt = "אין קטגוריות מבצעים";
            break;
        case "TAG":
            sqlSelect = "SELECT * FROM categories WHERE is_tag=1 AND mainCat_id=@0";
            emptyTxt = "אין תגיות";
            break;
    }

    var catList = db.Query(sqlSelect, main_cat_id);
    if (catList.Count() > 0)
    {
        <div>
            @foreach (var Category in catList)
            {
                <div style="; direction: rtl" id="catDiv_@Category.id">@NewAppHelpers.CatEditRow(Category.id, Category.title, Category.e_title)</div>
            }

        </div>
    }
    else
    {
        <div style="overflow: auto;font-size: 14px;color: #ff6a00;">@emptyTxt</div>
    }


}

@helper CustomProductFieldsList(int rec_id, string fieldScope = "PROD")
{
    string title = "";
    string e_title = "";
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string emptyTxt = "אין שדות מיוחדים";

    int curr_cat = 0;

    sqlSelect = "SELECT ProductsCustomFields.*,CustomProductFieldsType.title AS TypeTitle,CustomProductFieldsType.max_length FROM ProductsCustomFields JOIN CustomProductFieldsType ON CustomProductFieldsType.id=ProductsCustomFields.fieldType_id WHERE cat_id<>0 AND p_id=0 AND (cat_id=@0 or maincat_id=@0) order by maincat_id,cat_id,listindex";
    var fieldsList = db.Query(sqlSelect, rec_id);

    if (fieldsList.Count() > 0)
    {
        <div>
            @foreach (var customField in fieldsList)
            {
                if (curr_cat != customField.cat_id)
                {
                    curr_cat = customField.cat_id;
                    <div style="overflow: auto;background-color: #e3e3e3;color: #000;font-size: 16px;padding: 5px">
                        <b>
                            שדות מידע לקטגוריה #@curr_cat @NewAppFunctions.GetTitleById("Cat", curr_cat)
                        </b>
                    </div>
                }
                <div id="fieldDiv_@customField.id">@NewAppHelpers.CustomProductField(customField)</div>
            }

        </div>
    }
    else
    {
        <div style="overflow: auto;font-size: 14px;color: #ff6a00;">@emptyTxt</div>
    }


}
