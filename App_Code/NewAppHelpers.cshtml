                                <option value="@ent_type.serial">@ent_type.entity_title</option>
                            }
                        </select>

                    </span>

                </div>
                <div style="overflow: auto;border-bottom: 1px dotted #e3e3e3;">
                    הערות
                    <textarea style="float: left;padding: 5px;font-size: 16px;margin: 5px;resize: none;" id="new_entity_notes" name="new_entity_notes"></textarea>

                </div>
            </div>
        }


    </div>


    db.Close();
}

