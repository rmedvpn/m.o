@helper SubProductsForCatalogProduct_bck(int p_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = " SELECT * FROM products WHERE is_Catalog=0 AND Catalog_p_id=@0 order by v_id,p_id desc";
    var subProducts = db.Query(sqlSelect, p_id);
    sqlSelect = "SELECT * FROM products WHERE p_id=@0";
    var catProduct = db.QuerySingle(sqlSelect, p_id);

    if (subProducts.Count() > 0 && catProduct != null)
    {

        <div style="overflow: auto;">

            <div style="overflow: auto;border-bottom: 1px dotted #000">
                <div style="overflow: auto">
                    @foreach (var product in subProducts)
                    {
                        string vendor_name = "";
                        try { vendor_name = AppFunctions.GetVendorTitleById(product.v_id); } catch { }
                        <div style="overflow: auto;border-bottom:1px dotted #808080;font-size: 18px;color: #000;background-color: #fff">
                            <div style="overflow: auto;">
                                <button style="float: left;background:transparent;border:0;font-size: 16px;margin-left:10px;" onclick="sbload('SubMenuLeft','Caller?p1=ProductEdit&p2=@product.p_id');">⚙️</button>
                                <div style="overflow:auto">
                                    <div style="float: right; padding: 5px; margin: 5px; font-size: 12px; color: #808080">#@product.p_id </div>
                                    <div style="overflow:auto;">
                                        <span style="font-size:14px;color:#000"><b>@product.title</b></span>
                                        <div style="overflow:auto;padding: 2px;margin:2px;font-size:12px;color:#b200ff">@vendor_name</div>
                                    </div>

                                </div>


                            </div>
                        </div>

                    }

                </div>
            </div>


        </div>

    }
    else
    {
        <div>
            <div style="overflow: auto;font-size: 14px;color:#808080">אין מוצרים פעילים למוצר הקטלוגי <b>@catProduct.title</b></div>

        </div>
    }
    db.Close();
}

