                    <span style="float: left">

                        <input type="text" style="padding: 5px;font-size: 16px;width: 80px;margin: 5px;" placeholder="שם ישות" name="new_entity_name" id="new_entity_name">

                    </span>

                </div>
                <div style="overflow: auto;border-bottom: 1px dotted #e3e3e3;">
                    סוג ישות חדשה
                    <span style="float: left">

                        <select style="padding: 5px;font-size: 16px;margin: 5px;" name="new_entity_type" id="new_entity_type">
                            <option value="">נא לבחור</option>
                            @foreach (var ent_type in entity_types)
