@helper LoadCatTagsSelector_bck(int main_cat_id, int p_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM categories WHERE is_tag=1 AND (maincat_id=@0 OR maincat_id=99999)";
    var CatTags = db.Query(sqlSelect, main_cat_id);
    sqlSelect = "SELECT title FROM categories WHERE id=@0";
    var MainCat = db.QuerySingle(sqlSelect, main_cat_id);
    string SelectedCat = "";
    if (CatTags.Count() > 0)
    {

        <div style="overflow: auto;">

            @if (CatTags.Count() > 0)
            {
                <div style="overflow: auto;border-bottom: 1px dotted #000">
                    <div style="overflow: auto;font-weight: bold">תגיות לקטגוריה @MainCat.title</div>
                    <div style="overflow: auto">
                        @foreach (var cat in CatTags)
                        {
                            bool is_selected = false;
                            sqlSelect = "SELECT cat_id FROM productTags WHERE cat_id=@0 AND p_id=@1";
                            var rs = db.QuerySingle(sqlSelect, cat.id, p_id);
                            if (rs != null)
                            {
                                SelectedCat = SelectedCat + "##" + cat.id + "##";
                                is_selected = true;
                            }

                            if (is_selected)
                            {
                                <input type="hidden" name="is_cat_@cat.id" id="is_cat_@cat.id" value="">
                                <button type="button" id="cat_btn_@cat.id" onclick="ProductCatSelector(@cat.id);" style="background-color: #57d600;padding: 2px;margin: 5px;font-weight: bold;font-size: 16px;color: #000;border: 0;float: right;">@cat.title</button>
                            }
                            else
                            {
                                <input type="hidden" name="is_cat_@cat.id" id="is_cat_@cat.id" value="no">
                                <button type="button" id="cat_btn_@cat.id" onclick="ProductCatSelector(@cat.id);" style="background-color: #e3e3e3;padding: 2px;margin: 5px;font-weight: bold;font-size: 16px;color: #000;border: 0;float: right;">@cat.title</button>
                            }
                        }

                    </div>
                </div>
            }


            <input type="hidden" name="SelectedCat" id="SelectedCat" value="@SelectedCat">
        </div>

    }
    else
    {
        <div></div>
    }

    db.Close();
}




