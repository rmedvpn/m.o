@helper LoadSubCatSelector_bck(int main_cat_id, int product_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM categories WHERE is_subcat=1 AND maincat_id=@0";
    var SubCategories = db.Query(sqlSelect, main_cat_id);
    sqlSelect = "SELECT * FROM categories WHERE is_spOffersCat=1 AND (maincat_id=@0 OR maincat_id=0)";
    var spOfferCategries = db.Query(sqlSelect, main_cat_id);
    sqlSelect = "SELECT p_id,spOfferCatId,sub_cat_id FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);
    int sub_cat_id = 0; try { sub_cat_id = product.sub_cat_id; } catch { }
    int spOfferCatId = 0; try { spOfferCatId = product.spOfferCatId; } catch { }


    if (SubCategories.Count() > 0)
    {
        <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
            תת קטגוריה
            <select style="padding: 5px;margin: 5px;font-size: 16px;float: left" id="sub_cat_id" name="sub_cat_id">
                <option>נא לבחור </option>
                @foreach (var cat in SubCategories)
                {
                    <option value="@cat.id" @if (cat.id == sub_cat_id) { <text> selected</text>}>@cat.title</option>
                }
            </select>
        </div>

    }
    else
    {
        <div></div>
    }

    if (spOfferCategries.Count() > 0)
    {
        <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
            קטגורית מבצעים
            <select style="padding: 5px;margin: 5px;font-size: 16px;float: left" id="spOfferCatId" name="spOfferCatId">
                <option>נא לבחור </option>
                @foreach (var cat in spOfferCategries)
                {
                    <option value="@cat.id" @if (cat.id == spOfferCatId) { <text> selected</text>}>@cat.title</option>
                }
            </select>
        </div>
    }
    else
    {
        <div></div>
    }


    db.Close();
}

