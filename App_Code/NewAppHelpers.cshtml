@helper RoundStats()
{
DateTime local_time = AppFunctions.LocalTime();
int u_id = WebSecurity.CurrentUserId;
var op_data = Database.Open("op_data");


var sqlSelect = "SELECT id,short_title,title  FROM ROUNDS WHERE is_active=1 ORDER BY round_type,sort_order";
var rounds = op_data.Query(sqlSelect);




    <div style="overflow:auto" >
        <div style="position: fixed;display: none;z-index: 500000;width: 100%;height: 100%;background-color: #e3e3e3;opacity: 0.5;text-align: center;" id="RoundsStatsLoader">
            <div class="cssload-loading"></div>
        </div>
        <div class="Tinyloader" style="float:left;margin:5px;display:none" id="RoundsStatsLoader12"></div>

        @foreach (var round in rounds)
        {
            int order_count = 0;
            int new_order_count = 0;
            int vendor_cancelled_order_count = 0;
            int transferred_order_count = 0;
            string bgcolor = "#fff";
            string forecolor = "#000";
            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE z_id=0 AND is_cancelled=0 AND is_deleted=0 AND order_status<1 AND order_status>=-3 AND round_id=@0";
            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE z_id=0 AND is_cancelled=0 AND is_deleted=0 AND order_status<1 AND order_status>=-3 AND round_id=@0 AND CAST(timestamp AS date) = CAST(@1 AS date)";
            var order = op_data.QuerySingle(sqlSelect, round.id,local_time);
            try { new_order_count = order.the_cnt; } catch { }

            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE z_id=0 AND is_cancelled=0 AND is_deleted=0 AND round_id=@0";
            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE z_id=0 AND is_cancelled=0 AND is_deleted=0 AND round_id=@0 AND CAST(timestamp AS date) = CAST(@1 AS date)";
            order = op_data.QuerySingle(sqlSelect, round.id,local_time);
            try{ order_count = order.the_cnt;} catch{}
            string RoundDivClass = "EmptyRound";
            string RoundOrdersAlertClass = "RoundNoOrdersAlert";
            if (order_count > 0)
            {
                RoundDivClass = "ActiveRound";
                RoundOrdersAlertClass = "RoundOrdersCounterAlert";
            }
            if (new_order_count > 0)
            {
                RoundDivClass = "AttnRound";
                RoundOrdersAlertClass = "RoundNewOrdersAlert";
            }

            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE z_id=0 AND order_status=-6 AND round_id=@0 AND CAST(timestamp AS date) = CAST(@1 AS date)";
            order = op_data.QuerySingle(sqlSelect, round.id,local_time);
            try { vendor_cancelled_order_count = order.the_cnt; } catch { }

            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM MainOrders WHERE z_id=0 AND order_status=-2 AND round_id=@0 AND CAST(timestamp AS date) = CAST(@1 AS date)";
            order = op_data.QuerySingle(sqlSelect, round.id,local_time);
            try { transferred_order_count = order.the_cnt; } catch { }


            <div class="@RoundDivClass" onclick="PageNavigator('ROUNDBOARD',@round.id,false,'MAIN');" id="round_alert_@round.id" >

               @round.short_title

               @if (order_count > 0)
               {
                   if (new_order_count > 0)
                   {
                       <span class="@RoundOrdersAlertClass">@new_order_count</span>
                   }
                   else
                   {
                       <span class="@RoundOrdersAlertClass">@order_count</span>
                   }

                   if (vendor_cancelled_order_count > 0)
                   {
                       <span class="VendorCancelledOrdersCounterAlert">@vendor_cancelled_order_count</span>
                   }

                   if (transferred_order_count > 0)
                   {
                       <span class="TransferredOrdersCounterAlert">@transferred_order_count</span>
                   }



               }
               else
               {
                   <span class="@RoundOrdersAlertClass">@order_count</span>

               }




           </div>

            <div class="A" style="display:none;" onclick="PageNavigator('ROUNDBOARD',@round.id,false,'MAIN');" id="round_tooltip_@round.id" >
                <div class="A">@round.title</div>


                @if (new_order_count > 0)
                {
                <div class="A">@new_order_count</div>
                }
                else
                {
                <div class="A">@order_count</div>
                }

                @if (vendor_cancelled_order_count > 0)
                {
                <div class="A">@vendor_cancelled_order_count</div>
                }

                @if (transferred_order_count > 0)
                {
                <div class="A">@transferred_order_count</div>
                }




            </div>
 
        }

        <span class="WhiteMiniTag" style="padding:2px;margin:2px;margin-left:20px;float:left;font-size:12px;"><span>בָּ֤ר֣וּךְ אֲדֹנָי֮ י֤וֹם | י֥וֹם יַֽעֲמָס-לָ֗נוּ הָ֘אֵ֤ל יְֽשׁוּעָתֵ֬נוּ סֶֽלָה: </span></span>
    </div>



    op_data.Close();

}


