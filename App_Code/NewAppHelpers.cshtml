@helper ProductCustomFieldEntry(dynamic field, bool is_catalog)
{

   <div>@Products.ProductCustomFieldEntry(field,is_catalog) </div>

}


@helper ProductCustomFieldEntry_bck(dynamic field, bool is_catalog)
{

    string fieldType = field.fieldType;
    string tmpFieldName = field.fieldName;
    string tmpFieldName_e = tmpFieldName + "_e";
    bool tmpBoolValue = false; try { tmpBoolValue = field.boolvalue; } catch { }
    DateTime tmpDateValue = Convert.ToDateTime("1/1/1970"); try { tmpDateValue = field.DateValue; } catch { }
    int tmpIntValue = 0; try { tmpIntValue = field.IntValue; } catch { }
    decimal tmpDecimalValue = 0; try { tmpDecimalValue = field.DecimalValue; } catch { }
    string bgColor = "#ffffcc";
    string headerColor = "#000";
    bool manually_created = false;
    if (field.manually_created)
    {
        manually_created = true;
        headerColor = "blue";
    }
    bool is_disabled = false;
    string disabler = "";
    bool is_editable = false; try { is_editable = field.is_editable; } catch { }
    if (!is_editable && !is_catalog)
    {
        disabler = "disabled";
        is_disabled = true;
        bgColor = "#e3e3e3";
    }
    <div style="overflow: auto;font-size: 16px;font-weight: normal;padding: 5px;background-color: @bgColor;margin: 5px;">
        <form id="ProductFieldsForm_@field.id">
            <div style="overflow: auto;font-size: 16px;font-weight: normal;padding: 5px;margin: 5px;display: none" id="fld_edit_@field.id">
                <div style="overflow: auto">
                    <span style="color: @headerColor">

                        <b>@field.title</b>
                    </span> @if (field.is_required)
                    {<span style="font-size: 14px;color: #f00"> <b>*</b> </span>}

                    @if (!is_disabled)
                    {
                        <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent;" onclick="AjaxActions('UpdateProductCustomField', '@field.p_id','', 'ProductFieldsForm_@field.id',@field.id,@is_catalog);"> ✔️ </button>
                    }
                    else
                    {
                        <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent;" onclick="hideElement('fld_edit_@field.id');showElement('fld_info_@field.id');"> 🔒 </button>
                    }
                    <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent;" onclick="hideElement('fld_edit_@field.id');showElement('fld_info_@field.id');"> ❌ </button>
                    <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent" onclick="AjaxActions('ProdCustomFieldMoveUp','@field.p_id','','@field.id');">⬆️</button>
                    <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent" onclick="AjaxActions('ProdCustomFieldMoveDown','@field.p_id','','@field.id');">⬇️</button>
                    <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent" onclick="AjaxActions('DeActivateProductCustomField','@field.p_id','','@field.id');">❎</button>

                    @if (manually_created)
                    {
                        <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent" onclick="AjaxActions('DeleteCustomProductField', '@field.id','','@field.p_id', 'PROD');">מחיקה</button>
                    }

                </div>

                @if (is_catalog)
                {
                    <div style="overflow: auto;">
                        <span style="float: right;padding: 1px;margin: 1px;font-size: 16px;">
                            <input type="checkbox" style="float: right;padding: 5px;margin: 5px;font-size: 16px;" @if(field.is_editable){<text> checked </text>} onclick="if(this.checked){ AjaxActions('ProdCustomFieldEditableOn','@field.p_id','','@field.id');}else{AjaxActions('ProdCustomFieldEditableOff','@field.p_id','','@field.id');}"> ניתן לעריכה
                        </span>

                        @if (field.is_cat_required)
                        {
                            <span style="float: right;padding: 1px;margin: 1px;font-size: 16px;">
                                <input type="checkbox" style="float: right;padding: 5px;margin: 5px;font-size: 16px;" checked disabled> שדה נדרש
                            </span>
                        }
                        else
                        {
                            <span style="float: right;padding: 1px;margin: 1px;font-size: 16px;">
                                <input type="checkbox" style="float: right;padding: 5px;margin: 5px;font-size: 16px;" @if(field.is_required){<text> checked </text>} onclick="if(this.checked){AjaxActions('ProdCustomFieldRequiredOn','@field.p_id','','@field.id');}else{AjaxActions('ProdCustomFieldRequiredOff','@field.p_id','','@field.id');}"> שדה נדרש
                            </span>
                        }

                    </div>
                }
                else
                {
                    if (!is_disabled && field.is_protected)
                    {
                        <div style="overflow: auto;">
                            <span style="float: right;padding: 1px;margin: 1px;font-size: 16px;">
                                <input type="checkbox" style="float: right;padding: 5px;margin: 5px;font-size: 16px;" checked onclick="AjaxActions('ProdCustomFieldProtectionOff','@field.p_id','','@field.id',@field.id,@is_catalog);"> שדה מוגן
                            </span>

                        </div>
                    }
                }

                @switch (fieldType)
                {
                    case "SHORTTEXT":
                        <div style="overflow: auto">
                            <input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%" name="@tmpFieldName" value="@field.shortStringValue" placeholder="@field.title" @disabler>
                            <input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%" name="@tmpFieldName_e" value="@field.shortStringValue_e" placeholder="@field.title_e" @disabler>
                        </div>
                        break;
                    case "LONGTEXT":
                        <div style="overflow: auto">
                            <textarea style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;resize: none" name="@tmpFieldName" placeholder="@field.title" @disabler>@field.LongStringValue</textarea>
                            <textarea style="padding: 5px;margin: 5px;font-size: 16px;width: 90%;resize: none" name="@tmpFieldName_e" placeholder="@field.title_e" @disabler>@field.LongStringValue</textarea>
                        </div>
                        break;
                    case "DATE":
                        <div style="overflow: auto">
                            <input type="date" style="padding: 5px;margin: 5px;font-size: 16px;width: 90%" name="@tmpFieldName" value="@field.strDateValue" placeholder="@field.title" @disabler>
                        </div>
                        break;

                    case "PERCENT":
                    case "AMOUNT":
                        <div style="overflow: auto">
                            <input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 50%" name="@tmpFieldName" @if (tmpDecimalValue>0){<TEXT></TEXT>}>
@if (fieldType == "AMOUNT")
{<span> ₪ </span>}
else
{<span> % </span>}
</div>
break;

case "YESNO":
<div style="overflow: auto">
    <span style="float: right">
        <input type="radio" style="padding: 5px;margin: 5px;width: 15px;height: 15px;" name="@tmpFieldName" value="yes" @if(tmpBoolValue){<TEXT> checked </TEXT>}  @disabler /> כן
    </span>
    <span style="float: right">
        <input type="radio" style="padding: 5px;margin: 5px;width: 15px;height: 15px;" name="@tmpFieldName" value="no" @if(!tmpBoolValue){<TEXT> checked </TEXT>}  @disabler /> לא
    </span>
</div>
break;
case "INT":
<div style="overflow: auto">
    <input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 50%" name="@tmpFieldName" @if(tmpIntValue>0){<TEXT></TEXT>}/><span></span>
</div>
break;


default:
<div></div>
break;
}
            </div>
        </form>
        <div style="overflow: auto;font-size: 16px;font-weight: normal;padding: 5px;background-color: @bgColor;margin: 5px;" id="fld_info_@field.id">
            <div style="overflow: auto">
                <span style="color: @headerColor"><b>@field.title</b></span> @if (field.is_required)
                {<span style="font-size: 14px;color: #f00"> <b>*</b> </span>}
                <button type="button" style="float: left;padding: 1px;margin: 1px;font-size: 14px;border: 0;margin-left: 5px;background: transparent;" onclick="hideElement('fld_info_@field.id');showElement('fld_edit_@field.id');"> ⚙️ </button>
            </div>
            @switch (fieldType)
            {
                case "SHORTTEXT":
                    <div style="overflow: auto">
                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">@field.shortStringValue</div>
                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">@field.shortStringValue_e</div>
                    </div>
                    break;
                case "LONGTEXT":
                    <div style="overflow: auto">
                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">@field.LongStringValue</div>
                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">@field.LongStringValue</div>
                    </div>
                    break;
                case "DATE":
                    <div style="overflow: auto">
                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">@field.strDateValue</div>
                    </div>
                    break;

                case "PERCENT":
                case "AMOUNT":
                    <div style="overflow: auto">
                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">
                            @String.Format("{0:0.00}", tmpDecimalValue) @if (fieldType == "AMOUNT")
                            {<span> ₪ </span>}
                            else
                            {<span> % </span>}
                        </div>
                    </div>
                    break;
                case "YESNO":
                    <div style="overflow: auto">

                        <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 16px;width: 90%">
                            @if (tmpBoolValue)
                            {<span> כן </span>}
                            else
                            {<span> לא </span>}
                        </div>
                    </div>
                    break;
                case "INT":
                    <div style="overflow: auto">
