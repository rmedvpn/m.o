@helper TeamRoundMiniStatus(int round_status, int round_id, bool is_actions = true)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM dbo.rounds WHERE id=@0";
    var round = db.QuerySingle(sqlSelect, round_id);

    string start_time = round.start_time;
    DateTime round_start = round.round_start;
    DateTime nextRound = round_start.AddDays(1);
    string next_round = nextRound.ToString("yyyy'-'MM'-'dd");
    <div>
        @switch (round_status)
        {
            case 0:
                <div style="overflow: auto;text-align: right">
                    <div style="padding: 5px;text-align: center;overflow: auto;min-width: 100px;background-color: white;border-radius: 5px;">
                        <span style="font-size: 14px;color: #57d600"> מצב עריכה  </span>
                    </div>

                </div>
                break;
            case 1:
                <div style="overflow: auto;text-align: right">
                    <div style="padding: 5px;text-align: center;overflow: auto;min-width: 100px;background-color: white;border-radius: 5px;">
                        <span style="font-size: 14px;color: #57d600"> פתוח להזמנות  </span>
                    </div>

                </div>

                break;
            case 2:
                <div style="overflow: auto;text-align: right">
                    <div style="padding: 5px;text-align: center;overflow: auto;min-width: 100px;background-color: white;border-radius: 5px;">
                        <span style="font-size: 14px;color: #f00"> ההזמנות נעצרו זמנית  </span>
                    </div>

                </div>

                break;
            case 3:

                <div style="overflow: auto;text-align: right">
                    <div style="padding: 5px;text-align: center;;background-color: white;border-radius: 5px;overflow: auto">
                        <span style="font-size: 14px;color: #f00"> הסבב נסגר להזמנות </span>

                    </div>
                </div>
                break;
            case 4:
                <div style="overflow: auto;text-align: right">
                    בהכנת מסלולים
                </div>
                break;
            case 5:
                <div style="overflow: auto;text-align: right">
                    מסלולי חלוקה מוכנים
                </div>
                break;
            case 6:
                <div style="overflow: auto;text-align: right">
                    מיון טרום יציאה הושלם
                </div>
                break;

            case 8:
                <div style="overflow: auto;text-align: right">
                    הסבב נמסר לאחמש
                </div>
                break;
            case 9:
                <div style="overflow: auto;text-align: right">
                    נמסר לנהגי חלוקה
                </div>
                break;
            case 10:
                <div style="overflow: auto;text-align: right">
                    במהלך סבב חלוקה
                </div>
                break;
            case 11:
                <div style="overflow: auto;text-align: right">
                    כל המשלוחים בוצעו
                </div>
                break;
            case 12:
                <div style="overflow: auto;text-align: right">
                    נוהל סגירה
                </div>
                break;
            case 13:
                <div style="overflow: auto;text-align: right">
                    הסבב הושלם בהצלחה
                </div>
                break;
            case 99:
                <div style="overflow: auto;text-align: right">
                    קוד אדום
                </div>
                break;

            default:
                <div style="overflow: auto;text-align: right">@NewAppFunctions.StatusLabelByCode(round_id, "ROUND") </div>
                break;

        }
        <div style="display: none;" id="roundLoader_@round_id">
            <div class="spinner" style="text-align: center;padding: 5px;margin: 5px;">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>

    </div>
}

