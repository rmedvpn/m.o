// showWhat = "ALL";
sqlSelect = "SELECT top(200)  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE ";
switch (showWhat)
{

    case "NEW":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 AND order_status<=0 AND  CAST(requested_delivery_date AS date) <= CAST(@2 AS date) ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות לטיפול";
        break;

    case "FUTURE":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 AND CAST(requested_delivery_date AS date) > CAST(@2 AS date) ORDER BY requested_delivery_date, order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות עתידיות";
        break;

    case "PREP":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status>=1 AND order_status<=3  AND  (CAST(requested_delivery_date AS date) <= CAST(@2 AS date) OR delivery_id=@3) ORDER BY delivery_id,envelope_id,order_status,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות בהכנה";

        break;
    case "PROC":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status>=4 AND order_status<=6   ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "בתהליך אספקה";

        break;

    case "COMPLETED":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status>=9  ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות שבוצעו";

        break;
    case "CANCELLED":
        sqlSelect += "  is_cancelled=1 AND  z_serial=@0 AND  round_id = @1 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות שבוטלו";
        break;



    case "TODAY":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 AND (order_status>0 OR CAST(requested_delivery_date AS date) = CAST(@2 AS date)) ORDER BY order_status, delivery_id ,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות להיום";
        break;


    case "NODELIVERY":
        sqlSelect += " is_cancelled=0 AND delivery_id<=0 AND z_serial=@0 AND  round_id = @1 AND (order_status>=1 AND order_status<=3 AND CAST(requested_delivery_date AS date) <= CAST(@2 AS date)) ORDER BY delivery_id,order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות שלא משובצות למשלוח";
        viewTitleColor = "#f00";
        break;

    case "ALL":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "כל ההזמנות";

        break;

    case "PENDING":
        sqlSelect += " is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status=1  ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות בהמתנה לאישור ספק";

        break;


    case "VENDOR":
        sqlSelect += " order_status=-6 AND  z_serial=@0 AND  round_id = @1 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "ביטולי ספק";
        break;
}

var order_data = db.Query(sqlSelect, z_id, round_id,local_time, active_delivery_id);
int orders_counter = 0;

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
