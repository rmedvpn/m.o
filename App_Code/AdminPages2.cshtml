    </div>
    <div style="overflow: auto;height: 200px;">&nbsp;</div>


    db.Close();
}


@helper ImageDetails(int p_id, int file_id, int action_code = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "Select is_primary From ProductImages Where file_id = @0";
    var picRs = db.QuerySingle(sqlSelect, file_id);
    bool is_primary = false;
    if (picRs != null)
    {
        if (picRs.is_primary)
        {
            is_primary = true;
        }

        sqlSelect = "SELECT title FROM products WHERE p_id=@0;";
        var product = db.QuerySingle(sqlSelect, p_id);

        if (action_code == 0)
        {
            <div style="overflow: auto;padding: 5px;margin: 5px;text-align: center">
                @if (is_primary)
                {
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;" disabled>✅ תמונה ראשית</button>
                }
                else
                {
                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;" onclick="AjaxActions('PrimaryPic', @file_id,'',@p_id);">תמונה ראשית</button>
                }


                <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;" onclick="AjaxActions('DeletePic', @file_id,'',@p_id);">מחיקת תמונה</button>
            </div>
        }

        <div style="overflow: auto;background-color: #fff;min-height: 500px;;text-align: center">
            <div style="overflow: auto;color: #000;font-size: 20px;font-weight: bold;padding: 5px;text-align: center">תמונת מוצר #@p_id @product.title</div>
            <img style="height: 100%;width: 100%;" src="ImgViewer?Id=@file_id" alt="אלט" />
