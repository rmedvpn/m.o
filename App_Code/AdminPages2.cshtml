    int spOfferType = 0;
    try { spOfferType = spOffer.spOfferType; } catch { }
    sqlSelect = "SELECT id,title from rounds WHERE is_catalog=1 ORDER BY vendor_id";
    var CatalogRounds = db.Query(sqlSelect);
    sqlSelect = "SELECT rounds.id,rounds.title FROM rounds INNER JOIN RoundSpecials ON rounds.id=RoundSpecials.round_id WHERE RoundSpecials.specialOfferId=@0";
    var SpOfferInRounds = db.Query(sqlSelect, spOfferId);

