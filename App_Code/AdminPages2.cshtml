@helper AllProducts_bck(string listType = "CATALOG", bool ActiveOnly = false)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    var db = Database.Open("op_data");
    var sqlSelect = "";
    string listTitle = "";
    int itemsCnt = 0;
    int activeCnt = 0;
    int catalogCnt = 0;
    int deletedCnt = 0;
    int inActiveCnt = 0;
    int curCat = 0;
    sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=0";
    var cntRS = db.QuerySingle(sqlSelect);
    try { activeCnt = cntRS.the_cnt; } catch { }

    sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=1";
    cntRS = db.QuerySingle(sqlSelect);
    try { catalogCnt = cntRS.the_cnt; } catch { }

    sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM products WHERE is_active=0";
    cntRS = db.QuerySingle(sqlSelect);
    try { inActiveCnt = cntRS.the_cnt; } catch { }


    sqlSelect = " SELECT COUNT(p_id) AS the_cnt FROM DeletedProducts";
    cntRS = db.QuerySingle(sqlSelect);
    try { deletedCnt = cntRS.the_cnt; } catch { }
    switch (listType)
    {
        case "ACTIVE":
            sqlSelect = "SELECT * FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
            listTitle = "מוצרים פעילים";
            itemsCnt = activeCnt;
            break;
        case "INACTIVE":
            sqlSelect = "SELECT * FROM products WHERE is_active=0 ORDER BY  maincat_id,sub_cat_id, is_setup,p_id DESC";
            listTitle = "מוצרים לא פעילים";
            itemsCnt = inActiveCnt;
            break;

        case "CATALOG":
            sqlSelect = "SELECT * FROM products WHERE (is_active=1 OR is_setup=0) AND is_catalog=1 ORDER BY maincat_id,sub_cat_id, is_setup,p_id DESC";
            listTitle = "קטלוג מוצרים";
            itemsCnt = catalogCnt;
            break;
        case "DELETED":
            sqlSelect = "SELECT * FROM DeletedProducts ORDER BY p_id DESC";
            listTitle = "מוצרים שנמחקו";
            itemsCnt = deletedCnt;
            break;
    }
    var Products = db.Query(sqlSelect);


    int cur_main_cat = -1;
    int cur_sub_cat = -1;

    <div style="overflow: auto;background-color: #fff">
        <input type="hidden" name="is_all_products" id="is_all_products" value="1">
        <input type="hidden" name="listType" id="listType" value="@listType">
        <div style="overflow: auto">
            <div style="overflow: auto;font-size: 24px;color: #000;padding: 5px;margin: 5px;">


                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#e3e3e3;color: #808080;padding: 5px;margin: 5px;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','DELETED');currentProductsView = 'DELETED';"><span style="float:left;background-color: #fff;color: #808080;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@deletedCnt</b> </span>מחוקים</button>
                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#808080;color: #fff;padding: 5px;margin: 5px;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','INACTIVE');currentProductsView = 'INACTIVE';"> <span style="float:left;background-color: #fff;color: #808080;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@inActiveCnt</b> </span>לא פעילים</button>
                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#57d600;color: #fff;padding: 5px;margin: 5px;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','ACTIVE');currentProductsView = 'ACTIVE'"><span style="float:left;background-color: #fff;color: #57d600;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@activeCnt</b> </span>פעילים</button>
                <button type="button" style="float: left;font-size: 16px;border: 0;background-color:#b200ff;color: #fff;padding: 5px;margin: 5px;" onclick="RepAjaxUpdate('LoadProductsList','MainBoardContainer','MainLoader','CATALOG');currentProductsView = 'CATALOG';"><span style="float:left;background-color: #fff;color: #b200ff;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>@catalogCnt</b> </span>קטלוג</button>

                @listTitle (@itemsCnt)

                @switch (listType)
                {
                    case "ACTIVE":
                        <button type="button" style="font-size: 16px;border: 0;background-color:#000;color: #fff;padding: 5px;margin: 5px;float: right" onclick="AjaxActions('AddProduct', 'ACTIVE'); AdjustMainView();"><span style="float:left;background-color: #fff;color: #000;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>+</b> </span></button>
                        break;
                    case "CATALOG":
                        <button type="button" style="font-size: 16px;border: 0;background-color:#000;color: #fff;padding: 5px;margin: 5px;float: right" onclick="AjaxActions('AddProduct', 'CATALOG');AdjustMainView();"><span style="float:left;background-color: #fff;color: #000;margin-right: 5px;margin-left: 5px;padding-left: 5px;padding-right: 5px"> <b>+</b> </span></button>
                        break;
                    default:
                        break;
                }



            </div>



            <div style="overflow: auto;clear: both;">

                <div style="overflow: auto;clear: both;">
                    @foreach (var product in Products)
                    {
                        string bgColor = "#fff";
                        if (!product.is_setup)
                        {
                            bgColor = "#ffcccc";
                        }


                        sqlSelect = " SELECT * FROM products WHERE is_Catalog=0 AND Catalog_p_id=@0";
                        var subProducts = db.Query(sqlSelect, product.p_id);

                        if (cur_main_cat != product.maincat_id)
                        {
                            cur_main_cat = product.maincat_id;
                            cur_sub_cat = -1;
                        }
                        if (cur_sub_cat != product.sub_cat_id)
                        {
                            cur_sub_cat = product.sub_cat_id;

                            <div style="overflow: auto;font-size: 14px;color: #ff6a00;background-color: #fff;display: none">
                                <div style="float: right;padding: 5px;color: #000;font-size: 18px;font-weight: bold;">
                                    @if (cur_sub_cat == 0)
                                    {<span style="font-weight: bold;color: #b200ff;font-size: 16px">ללא תת קטגוריה</span>}
                                    else
                                    {<span style="font-weight: bold;color: #b200ff;font-size: 16px">@NewAppFunctions.GetTitleById("Cat", cur_sub_cat)</span>}
                                </div>

                                <div style="float: left;padding: 5px;font-weight: bold;">
                                    @if (cur_main_cat == 0)
                                    {<span>ללא קטגוריה</span>}
                                    else
                                    {<span>@NewAppFunctions.GetTitleById("Cat", cur_main_cat)</span>}
                                </div>
                            </div>
                        }

                        if (curCat != cur_main_cat)
                        {
                            curCat = cur_main_cat;
                            <div style="overflow:auto;margin-right:10px;padding:5px;font-size:18px;color:white;background-color:#808080">@NewAppFunctions.GetTitleById("Cat", cur_main_cat)</div>

                        }



                        <div style="overflow: auto;font-size: 16px;color: #000;">


                            <div style="border-radius: 5px; border: 2px solid #e3e3e3; padding: 5px; margin: 5px; overflow: auto; background-color: @bgColor" id="Prod_@product.p_id">
                                <img style="height: 50px;max-width: 50px;border-radius: 10px;margin: 3px;padding: 3px;float:right" src="ImgViewer?size=tn&p_id=@product.p_id" alt="אלט" />

                                @if (listType != "DELETED")
                                {
                                    <button style="float: left;padding: 5px;font-size: 16px;background-color: #fff;border: 2px solid #808080;border-radius: 5px;margin: 5px;color: #808080" onclick="MiscActions('SelectEntry','Prod_@product.p_id');sbload('GenSb','Caller?p1=ProductEdit&p2=@product.p_id');AdjustMainView();">עריכה</button>
                                }


                                @if (subProducts.Count > 0)
                                {
                                    <div style="margin: 5px;padding: 5px;color: #fff;background-color:  #ff6a00;border-radius: 5px;float: left" onclick="Accordionize('prodAcc_@product.p_id');">
                                        @subProducts.Count מוצרים פעילים
                                    </div>
                                }

                                <div style="font-size: 18px;overflow: auto;padding: 5px">
                                    <div style="padding: 1px;overflow: auto;font-size: 12px;color: #808080">

                                        #@product.p_id
                                        @if (product.v_id != 0)
                                        {
                                            <span>@AppFunctions.GetVendorTitleById(product.v_id)</span>
                                        }
                                    </div>
                                    <b>@product.title</b>

                                    <div style="font-size: 14px;overflow: auto;color: #808080;">


                                        <div style="padding: 2px;color: #000;float: right">
                                            @if (cur_main_cat == 0)
                                            {<span>ללא קטגוריה</span>}
                                            else
                                            {<span>@NewAppFunctions.GetTitleById("Cat", cur_main_cat)</span>}
                                        </div>
                                        <div style="padding: 2px;color: #000;float: right">
                                            @if (cur_sub_cat == 0)
                                            {<span>ללא תת קטגוריה</span>}
                                            else
                                            {<span>@NewAppFunctions.GetTitleById("Cat", cur_sub_cat)</span>}
                                        </div>
                                    </div>
                                </div>
                                @if (subProducts.Count > 0 && listType != "DELETED")
                                {
                                    <button class="Accordion" style="display: none" id="prodAcc_@product.p_id"></button>
                                    <div class="panel" style="padding: 0;margin: 0;">
                                        <div style="overflow: auto;">
                                            @foreach (var subProd in subProducts)
                                            {
                                                <div style="overflow: auto;border-bottom:1px dotted #808080;font-size: 18px;color: #000;background-color: #fff">
                                                    <div style="overflow: auto;">
                                                        <button style="float: right;padding: 5px;font-size: 16px;" onclick="sbload('GenSb','Caller?p1=ProductEdit&p2=@subProd.p_id');AdjustMainView();">עריכה</button>

                                                        <span style="padding: 5px;">@subProd.p_id - @subProd.title</span>

                                                    </div>
                                                </div>
                                            }

                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    }
                </div>




            </div>

        </div>




        <div style="overflow: auto;height: 100px;">&nbsp;</div>
    </div>
    <div style="overflow: auto;height: 150px;">&nbsp;</div>

    db.Close();
}

@helper ProductEdit_bck(int product_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, product_id);
    bool is_catalog = false;
    try { is_catalog = product.is_catalog; } catch { }
    bool is_setup = false;
    try { is_setup = product.is_setup; } catch { }
    bool init_complete = false;
    try { init_complete = product.init_complete; } catch { }

    int itemunit_type = 0;
    try { itemunit_type = product.itemunit_type; } catch { }
    sqlSelect = "SELECT * from ItemUnitTypes";
    var itemUnitTypes = db.Query(sqlSelect);
    //var itemTypes
    string itemunit = "";
    itemunit = product.itemunit;
    sqlSelect = "SELECT * FROM rounds WHERE is_catalog=1";
    var Menus = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM ProductPricingOptions WHERE p_id=@0";
    var PricingOptions = db.Query(sqlSelect, product_id);

    sqlSelect = "SELECT * FROM roundMenuItems WHERE p_id=@0";
    var AvailableInMenus = db.Query(sqlSelect, product_id);

    sqlSelect = "SELECT * FROM categories WHERE is_maincat=1";
    var MainCategories = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM categories WHERE is_spOffersCat=1";
    var spOfferCategries = db.Query(sqlSelect);


    sqlSelect = "SELECT * FROM vendors WHERE is_active=1";
    var Vendors = db.Query(sqlSelect);

    bool sell_1s = false; try { sell_1s = product.sell_1s; } catch { }
    bool sell_3s = false; try { sell_3s = product.sell_3s; } catch { }
    bool sell_5s = false; try { sell_5s = product.sell_5s; } catch { }
    int sell_inXs = 0; try { sell_inXs = product.sell_inXs; } catch { }

    string sell_1s_display_state = "none";
    string sell_Xs_display_state = "block";

    if (sell_1s) { sell_1s_display_state = "block;"; sell_Xs_display_state = "none;"; }

    <div style="overflow: auto;text-align: right;background-color: #fff;direction:rtl">
        @if (is_setup)
        {
            if (is_catalog)
            {
                <div style="color: #000">@NewAppHelpers.EditCatalogProduct(product_id)</div>
            }
            else
            {
                <div style="color: #000">@NewAppHelpers.EditProduct(product_id)</div>
            }
        }
        else
        {
            if (is_catalog)
            {
                if (init_complete)
                {
                    <div style="color: #000">@NewAppHelpers.EditCatalogProduct(product_id)</div>
                }
                else
                {
                    <div style="color: #000">@NewAppHelpers.CatalogProductSetup(product_id)</div>
                }

            }
            else
            {
                <div style="color: #000">@NewAppHelpers.ProductSetup(product_id)</div>
            }
        }



    </div>
    <div style="overflow: auto;height: 50px;">&nbsp;</div>

    db.Close();
}

@helper CatManager()
