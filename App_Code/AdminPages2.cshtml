@helper RoundMenuItemEdit(int menuItem_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM roundMenuItems WHERE id=@0";
    var menuItem = db.QuerySingle(sqlSelect, menuItem_id);
    int product_id = 0;
    int round_id = 0;
    try { product_id = menuItem.p_id; } catch { }
    try { round_id = menuItem.round_id; } catch { }

    //sqlSelect="SELECT * FROM tlg.products WHERE p_id=@0";
    var product = db.QuerySingle(sqlSelect, menuItem_id);

    sqlSelect = "SELECT * FROM rounds WHERE id=@0";
    var round = db.QuerySingle(sqlSelect, round_id);

    int itemunit_type = 0;
    try { itemunit_type = product.itemunit_type; } catch { }
    sqlSelect = "SELECT * from ItemUnitTypes";
    var itemUnitTypes = db.Query(sqlSelect);
    //var itemTypes
    string itemunit = "";
    itemunit = product.itemunit;
    sqlSelect = "SELECT * FROM rounds WHERE is_catalog=1";
    var Menus = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM roundMenuItems WHERE p_id=@0";
    var AvailableInMenus = db.Query(sqlSelect, product_id);

    sqlSelect = "SELECT * FROM categories WHERE is_maincat=1";
    var MainCategories = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM categories WHERE is_spOffersCat=1";
    var spOfferCategries = db.Query(sqlSelect);


    sqlSelect = "SELECT * FROM vendors WHERE is_active=1";
    var Vendors = db.Query(sqlSelect);

    bool sell_1s = false; try { sell_1s = product.sell_1s; } catch { }
    bool sell_3s = false; try { sell_3s = product.sell_3s; } catch { }
    bool sell_5s = false; try { sell_5s = product.sell_5s; } catch { }
    int sell_inXs = 0; try { sell_inXs = product.sell_inXs; } catch { }

    string sell_1s_display_state = "none";
    string sell_Xs_display_state = "block";

    if (sell_1s) { sell_1s_display_state = "block;"; sell_Xs_display_state = "none;"; }

    string unLimitedQuan_display_state = "block";
    string limitedQuan_display_state = "none";
    string Quan_display_state = "block";
    string unLimitedMaxInCart_display_state = "none";
    string limitedMaxInCart_display_state = "block";
    string MaxInCart_display_state = "block";

    if (product.is_quan_limit)
    {
        unLimitedQuan_display_state = "none";
        limitedQuan_display_state = "block";
    }
    if (!product.is_in_stock)
    {
        Quan_display_state = "none";

    }
    if (product.max_in_cart == -1)
    {
        limitedMaxInCart_display_state = "none";
        unLimitedMaxInCart_display_state = "block";
    }

    sqlSelect = "SELECT * FROM ProductPricingOptions WHERE p_id=@0 AND (round_id=@1 OR round_id=99999)";
    var PricingOptions = db.Query(sqlSelect, product.p_id, product.round_id);

    <div style="overflow: auto;text-align: right;background-color: #fff">
        <div style="overflow: auto;font-size: 20px;color: #000;">
            <div style="overflow: auto">
                <div style="color: #fff;background-color: #000;overflow: auto;padding: 5px;">
                    @product.title ב<span>@round.title</span>
                    <span style="font-size: 12px;color: yellow;float: left;margin-left:50px;">
                        מוצר #@product.p_id<br>פריט #@menuItem.id
                    </span>
                </div>
            </div>
        </div>

        <div style="overflow: auto;" id="ProductImagesContainer">
            @NewAppHelpers.ProductImages(product_id, true)
        </div>

        <div style="overflow: auto;padding: 5px;font-weight: bold;background-color: #ffffcc;font-size: 18px;color: #000;">
            מידע כללי
            <button type="button" style="padding: 2px;margin: 2px;font-size: 12px;background-color: #000;color: yellow;float: left;font-weight: bold" onclick="Accordionize('ItemMenuMoreInfoAcc');">מידע נוסף</button>
            <button type="button" style="padding: 2px;margin: 2px;font-size: 12px;background-color: #b200ff;color: #fff;float: left;font-weight: bold" onclick="callerSidebar='SideMenuSubDialog';sbload('ProductEditorViewer','AdminCaller?p1=ProductEdit&p2=@product.p_id');">דף המוצר</button>
        </div>

        <div style="padding: 5px;overflow: auto;color: #000">

            <div style="overflow: auto;font-size: 16px;font-weight: bold">
                @product.title

            </div>
            <div style="overflow: auto;font-size: 14px;">@product.description</div>
            <div style="overflow: auto;font-size: 16px;font-weight: bold">@product.title_e</div>
            <div style="overflow: auto;font-size: 14px;">@product.desc_e</div>
        </div>

        <button class="Accordion" id="ItemMenuMoreInfoAcc" style="display: none"></button>
        <div class="panel" style="padding: 0;margin: 0">

            <div style="overflow: auto;clear: both;color: #000;padding: 5px;">
                <div style="overflow: auto;font-size: 18px;">

                    <div style="overflow: auto;font-size: 18px;border-bottom: 1px dotted #000">
                        <span>
                            יח מידה
                            <span style="float: left;font-weight: bold">
                                <input type="hidden" id="itemunit_type" name="itemunit_type" value="@itemunit_type">
                                <span style="color: #000">@itemunit</span>
                            </span>
                        </span>
                    </div>


                </div>
                <div style="overflow: auto;font-size: 18px;border-bottom: 1px dotted #000">
                    ספק המוצר
                    <span style="float: left;font-weight: bold">
                        <input type="hidden" id="vendor_id" name="vendor_id" value="@product.vendor_id">
                        <span>@AppFunctions.GetVendorTitleById(product.vendor_id)</span>
                    </span>
                </div>
                <div style="overflow: auto;font-size: 18px;border-bottom: 1px dotted #000">
                    <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
                        קטגוריה ראשית
                        <span style="float: left;padding-left: 5px;font-weight: bold">@NewAppFunctions.GetTitleById("Cat", product.maincat_id)</span>
                    </div>
                    <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
                        תת קטגוריה
                        <span style="float: left;padding-left: 5px;font-weight: bold">@NewAppFunctions.GetTitleById("Cat", product.sub_cat_id)</span>
                    </div>
                    <div style="overflow: auto;width: 100%;border-bottom: 1px dotted #000">
                        קטגורית מבצעים
                        <span style="float: left;padding-left: 5px;font-weight: bold">@NewAppFunctions.GetTitleById("Cat", product.spOfferCatId)</span>
                    </div>
                </div>



                <div style="overflow: auto;font-size: 18px;">
                    <div style="overflow: auto;padding: 5px;font-weight: bold;background-color: #ffffcc">זמינות נוספת</div>

                    @foreach (var menu in Menus)
                    {
                        sqlSelect = "SELECT id,available_quan,itemunit FROM roundMenuItems WHERE p_id=@0 AND round_id=@1";
                        var menuProduct = db.QuerySingle(sqlSelect, product_id, menu.id);
                        bool isInMenu = false;
                        string roundQuanDisplayState = "none;";
                        string tmpValue = "";
                        if (menuProduct != null)
                        {
                            isInMenu = true;
                            roundQuanDisplayState = "block";
                            tmpValue = menuProduct.available_quan.ToString();
                            <div style="overflow: auto;">
                                ✅ @menu.title
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        <div style="overflow: auto;font-size: 18px;color: #000;">
            <div style="overflow: auto;padding: 5px;font-weight: bold;background-color: #ffffcc">
                מחירון
                <button type="button" style="padding: 2px;margin: 2px;font-size: 12px;background-color: #000;color: yellow;float: left;font-weight: bold" onclick="Accordionize('AddRoundItemPricingOptionAcc');">הוספת אפשרות</button>
                <div class="spinner" style="text-align: center;display: none;float: left" id="AddProductLoader">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>
            </div>
            <button style="display: none;" id="AddRoundItemPricingOptionAcc"></button>
            <div class="panel" style="padding: 0;margin: 0;text-align: center">

                <div id="AddPricingOptionsContainer">
                    <div style="overflow: auto;font-size: 18px;">
                        <div id="AddPricingOption">
                            <div style="overflow: auto;">
                                @Products.AddProductPricingOption(product_id, round_id)
                            </div>
                        </div>

                    </div>

                </div>

            </div>
            <div id="PricingOptionsContainer">
                <div style="overflow: auto;">
                    @Products.ProductPricingOptions(product_id, round_id)
                </div>
            </div>

        </div>


        <div style="overflow: auto;" id="MenuItemInfoDiv">
            <div style="overflow: auto;color: #000;padding: 5px;font-size: 18px;font-weight: bold;background-color: #ffffcc">
                הגדרות <button type="button" style="padding: 2px;margin: 2px;font-size: 12px;background-color: #000;color: yellow;float: left;font-weight: bold" onclick="showElement('MenuItemEditDiv');hideElement('MenuItemInfoDiv');">עריכה</button>

            </div>
            <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;">
                מוצר פעיל
                <span style="float: left">
                    @if (product.is_active)
                    {<span>✅</span>}
                    else
                    {<span>❌</span>}
                </span>
            </div>
            <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;">
                כלול במבצעים
                <span style="float: left">
                    @if (product.SpOffersOk)
                    {<span>✅</span>}
                    else
                    {<span>❌</span>}
                </span>
            </div>
            <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;">
                כלול בהקצאות קופת קהילה
                <span style="float: left">
                    @if (product.CharityOffersOk)
                    {<span>✅</span>}
                    else
                    {<span>❌</span>}
                </span>
            </div>

            <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;">
                זמין במלאי
                <span style="float: left">
                    @if (product.is_in_stock)
                    {<span>✅</span>}
                    else
                    {<span>❌</span>}
                </span>
            </div>
            <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;">
                זמין להנחות
                <span style="float: left">
                    @if (product.is_discountable)
                    {<span>✅</span>}
                    else
                    {<span>❌</span>}
                </span>
            </div>
            <div style="overflow: auto">
                <div style="overflow: auto;padding: 5px;;font-size: 18px;font-weight: bold;color: #000">
                    כמות זמינה
                    <div style="float: left;font-size: 16px;">
                        @if (product.is_quan_limit)
                        {
                            <div id="quanInfo">
                                @product.available_quan @product.itemunit
                            </div>
                        }
                        else
                        {
                            <div id="quanInfo">
