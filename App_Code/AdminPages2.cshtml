            לוח זמנים
            <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="showElement('RoundEditScheduleDiv');hideElement('RoundScheduleDiv');">עריכה</button>
        </div>

        @foreach (var sched in RoundSchedule)
        {
            <div style="padding: 0;margin: 0;overflow: auto;border-bottom: 1px dashed #e3e3e3">

                <span style="float: right;padding: 5px;margin: 5px;">
