@helper ZReport(int z_serial = 0)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var db = Database.Open("op_data");
var sqlSelect = "";
DateTime local_time = AppFunctions.LocalTime();
sqlSelect = "SELECT * FROM ZREPORTS WHERE serial=@0";
var zReport = db.QuerySingle(sqlSelect, z_serial);
if (zReport != null)
{
    int vendor_id = zReport.vendor_id;
    int round_id = zReport.round_id;
    int z_id = zReport.z_id;
    DateTime z_date = zReport.z_date;
    int active_z_serial = z_serial;
    bool is_active = zReport.is_active;
    if (is_active)
    {
        active_z_serial = 0;
    }
    int orders_count = 0;


    string round_title = AppFunctions.GetRoundTitleById(round_id);
    string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);

    sqlSelect = "SELECT order_id,nick_name,ship_city,grand_total,envelope_id,commision FROM MainOrders WHERE order_status>0 AND round_id=@0 AND (z_serial=@1 OR z_serial=0) ORDER BY envelope_id";
    var ordersInZ = db.Query(sqlSelect, round_id, active_z_serial);

    sqlSelect = "SELECT Count(order_id) AS the_cnt FROM MainOrders WHERE order_status>0 AND z_serial=@0 AND round_id=@1";
    var ordersCounter = db.QuerySingle(sqlSelect, active_z_serial, round_id);
    try { orders_count = ordersCounter.the_cnt; } catch { }

    //sqlSelect = "SELECT SUM(QUAN) AS the_quan FROM orderitems INNER JOIN mainorders ON orderitems.order_id=mainorders.order_id WHERE orderitems.p_id=@0 AND orderitems.z_serial=@1 AND orderitems.round_id=@2 AND mainorders.order_status>0";

    sqlSelect = "SELECT distinct p_id,title,itemunit FROM orderitems INNER JOIN mainorders ON orderitems.order_id=mainorders.order_id WHERE orderitems.z_serial=@0 AND orderitems.p_id>0 AND orderitems.round_id=@1 AND mainorders.order_status>0";
    var productsInZ = db.Query(sqlSelect, active_z_serial, round_id);

    sqlSelect = "SELECT COUNT(order_id) AS order_count,SUM(grand_total) as total_sales,SUM(commision) AS the_commision FROM mainorders WHERE  order_status>0 AND  z_serial=@0 AND round_id=@1";
    var zStats = db.QuerySingle(sqlSelect, active_z_serial, round_id);

    decimal z_total_sales = 0;try { z_total_sales = zStats.total_sales; } catch { }
    decimal z_total_commision = 0;try { z_total_commision = zStats.the_commision; } catch { }
    int z_order_count = 0;try { z_order_count = zStats.order_count; } catch { }

        <div style="max-height: 95%;overflow: auto;color:#000">
            <div style="overflow: auto;">

                <div style="overflow: auto;background-color: #808080;color: #fff;padding: 5px;">
                    <div style="float:right;padding:5px;margin:5px;font-size:30px;background-color:white;color:#000;border:2px solid #000" onclick="PageNavigator('ZADMIN')">
                        ➡️
                    </div>
                    <div style="float:right;padding:5px;margin:5px;font-size:30px;background-color:white;color:#000;border:2px solid #000" onclick="PageNavigator('ZREPORT',@z_serial)">
                        דוח יומי #@z_serial
                    </div>
                    <div style="float:right;padding:5px;margin:5px;font-size:30px;background-color:white;color:#000;border:2px solid #000">
                        @round_title
                    </div>
                    @if (is_active)
                    {
                        <div style="float:right;padding:5px;margin:5px;font-size:30px;background-color:#57d600;color:#000;border:2px solid #000">
                            דוח פעיל
                        </div>
                    }
                    <div style="float:left;padding:5px;margin:5px;font-size:30px;background-color:white;color:#000;border:2px solid #000">
                        @z_date.ToShortDateString()
                    </div>
                </div>

            </div>
            <div style="overflow: auto;padding:10px;">

                <center>
                    <div style="overflow:auto;font-size:30px">
                        דוח יומי לספק <span style="color:#b200ff">@vendor_name</span> עבור <span style="color:#b200ff">@round_title</span> לתאריך <span style="color:#b200ff">@z_date.ToShortDateString()</span>
                    </div>
                    <div class="zReportInfoBox">
                        <div style="overflow:auto;font-size:24px">
                            <b>סיכום כללי</b>
                        </div>
                        <div style="overflow:auto">
                            <div class="zReportRowHeader">
                                <div class="zReportRowItem">מכירות סך הכל</div>
                                <div class="zReportRowResult">@z_total_sales.ToString("C", culture)</div>
                            </div>
                            <div class="zReportRowHeader">
                                <div class="zReportRowItem">מספר הזמנות</div>
                                <div class="zReportRowResult">@z_order_count </div>
                            </div>
                            <div class="zReportRowHeader">
                                <div class="zReportRowItem">החלפות / החזרות</div>
                                <div class="zReportRowResult">@zReport.returns_count</div>
                            </div>
                            <div class="zReportRowHeader">
                                <div class="zReportRowItem"> ביטולים</div>
                                <div class="zReportRowResult">@zReport.cancel_count</div>
                            </div>
                            <div class="zReportRowHeader">
                                <div class="zReportRowItem">עמלה סך הכל</div>
                                <div class="zReportRowResult">@z_total_commision.ToString("C", culture)</div>

                            </div>
                        </div>
                    </div>


                    <div class="zReportInfoBox">
                        <div style="overflow:auto;font-size:24px">
                            <b>רשימת הזמנות</b>
                        </div>
                        <div style="overflow:auto">

                            @foreach (var order in ordersInZ)
                            {
                                <div class="zReportRowHeader">
                                    <div class="zReportRowItem">
                                        @order.nick_name
                                        <br />
                                        <div style="font-size: 12px; overflow: auto; float: right">
                                            הזמנה #@order.order_id   @order.ship_city
                                        </div>
                                    </div>
                                    <div class="zReportRowResult">@order.grand_total.ToString("C", culture)</div>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="zReportInfoBox">
                        <div style="overflow:auto;font-size:24px">
                            <b>ריכוז מוצרים</b>
                        </div>

                        @if (productsInZ.Count() > 0)
                        {
                            <div class="B">

                                @foreach (var product in productsInZ)
                                {
                                    sqlSelect = "SELECT SUM(QUAN) AS the_quan FROM orderitems INNER JOIN mainorders ON orderitems.order_id=mainorders.order_id WHERE orderitems.p_id=@0 AND orderitems.z_serial=@1 AND orderitems.round_id=@2 AND mainorders.order_status>0";
                                    var prodStats = db.QuerySingle(sqlSelect, product.p_id, active_z_serial, round_id);
                                    int prod_quan = 0; try { prod_quan = prodStats.the_quan; } catch { }

                                    <div class="zReportRowHeader">
                                        <div class="zReportRowItem">@product.title<br /><div style="font-size: 12px; overflow: auto;float:right">#@product.p_id</div></div>
                                        <div class="zReportRowResult">@prod_quan @product.itemunit</div>
                                    </div>
                                }

                            </div>

                        }
                        else{
                    <div class="zReportRowHeader">
                        <span style="color:#808080">אין מוצרים בדו"ח</span>
                    </div>
                        }

                    </div>


                    <div class="zReportInfoBox">
                        <div style="overflow:auto;font-size:24px">
                            <b>פירוט עמלות</b>
                        </div>
                        <div style="overflow:auto">

                            @foreach (var order in ordersInZ)
                            {
                                sqlSelect = "SELECT * FROM orderitems WHERE order_id=@0";
                                var orderitems = db.Query(sqlSelect, order.order_id);
                                decimal commision = order.commision;
                                if (commision == 0)
                                {
                                    try { commision = OrderFunctions.CalculateOrderComission(order.order_id); } catch { }
                                }
                                <div class="zReportRowHeader">
                                    <div style="overflow:auto">
                                        <div class="zReportRowItem">
                                            @order.nick_name
                                            <br />
                                            <div style="font-size: 12px; overflow: auto; float: right">
                                                הזמנה #@order.order_id   @order.ship_city
                                            </div>
                                        </div>
                                        <div class="zReportRowResult">@commision.ToString("C", culture)</div>
                                    </div>
                                    <center>
                                        <div style="overflow: auto; padding: 10px; font-size: 12px; width: 50%; background-color: #e3e3e3; margin: 10px; border: 1px dotted #808080; border-radius:5px">
                                            @if (orderitems.Count > 0)
                                            {
                                                foreach (var orderitem in orderitems)
                                                {

                                                    if (orderitem.item_id > -2)
                                                    {
                                                        <div style="overflow:auto;padding:5px;margin:5px;font-size:12px;border-bottom:1px dashed #808080">
                                                            <div class="zReportRowItem">
                                                                @orderitem.title

                                                                @if (orderitem.item_id > 0)
                                                                {
                                                                    <span style="font-size: 12px; ">
                                                                        (@orderitem.quan @orderitem.itemunit)
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="font-size: 12px;color:#808080 ">
                                                                        (מבצע)
                                                                    </span>
                                                                }

                                                            </div>
                                                            <div class="zReportRowResult">@orderitem.commision.ToString("C", culture)</div>
                                                        </div>
                                                    }

                                                }
                                            }
                                            else
                                            {
                                                <div style="overflow:auto;padding:5px;margin:5px;font-size:12px;color:#ff6a00">
                                                    -- אין פריטים חייבים בעמלה --
                                                </div>
                                            }

                                        </div>

                                    </center>
                                </div>

                            }

                        </div>
                    </div>


                </center>



            </div>





        </div>


        <div style="overflow:auto;height:250px;">&nbsp;</div>



    }
    db.Close();
}
