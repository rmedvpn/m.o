@helper CloseRoundZReport(int round_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    var u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";
    DateTime local_time = AppFunctions.LocalTime();


    sqlSelect = "SELECT id,round_type,is_open_for_orders,title,territory_id,round_start,is_sorted,has_started,z_id FROM Rounds WHERE id=@0";
    var round_info = db.QuerySingle(sqlSelect, round_id);
    if (round_info == null) { Response.Redirect("/crm"); }

    sqlSelect = "SELECT * FROM ZREPORTS WHERE is_Active=1 AND round_id=@0";
    var zData = db.QuerySingle(sqlSelect, round_id);
    int z_id = 0;
    DateTime z_date = Convert.ToDateTime("1/1/1900");
    if (zData != null)
    {
        z_id = zData.serial;
        z_date = zData.z_date.Date;
    }


    int round_type = round_info.round_type;

    string round_type_title = "";
    round_type_title = NewAppFunctions.GetRoundTypeTitleById(round_type);

    bool is_sorted = false;
    is_sorted = round_info.is_sorted;
    bool has_started = false;
    has_started = round_info.has_started;

    sqlSelect = "SELECT * FROM MainOrders WHERE z_serial=0 AND round_id = @0 AND order_status>0 ORDER BY order_id desc,order_status"; // order by is_approved, order_id DESC";
    var order_data = db.Query(sqlSelect, round_id);
    var title = round_info.title;

    bool is_round_clear_for_close = true;

    int tableColSpan = 8;

    <input type="hidden" name="round_id" id="round_id" value="@round_id">
    <input type="hidden" name="board_round_id" id="board_round_id" value="@round_id">
    <input type="hidden" name="cur_record" id="cur_record" value="0">
    <input type="hidden" name="IsInline" id="IsInline" value="1"><div style="text-align: right;font-size: 16px;width: 100%;height: 100%;overflow: auto;">
        <div style="position: fixed;display: none;z-index: 500000;width: 100%;height: 100%;background-color: #e3e3e3;opacity: 0.5;text-align: center;" id="RoundBoardLoader">
            <div class="cssload-loading"></div>
        </div>
        <div style="max-height: 95%;overflow: auto;direction:rtl">
            <div style="overflow: auto;">
                <div style="overflow: auto;background-color: #808080;color: #fff;padding: 5px;">
                    <span style="background-color: #fff;color: #000;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: left;margin: 5px;">
                        <span style="color:#f00"><b>Z#@z_id</b></span>
                    </span>

                    <span style="background-color: #fff;color: #000;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: left;margin: 5px;">
                        <b>@z_date.ToShortDateString()</b>
                    </span>


                    <span style="background-color: #fff;color: #000;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: left;margin: 5px;">💡 @NewAppFunctions.GetOrdersCountByRound("ALL", round_id) הזמנות</span>
                    <span style="background-color: #fff;color: #000;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: left;margin: 5px;">💰 ₪@Convert.ToInt32(NewAppFunctions.GetRoundTotalOrdersSum(round_id))</span>



                    <div style="float: right">





                        <button onclick="PageNavigator('ROUNDBOARD',@round_id);" style="background-color: #fff;color: #808080;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #808080;float: right;margin: 5px;">🔙 חזרה</button>
                        <div style="background-color: #fff;color: #57d600;padding: 5px;font-size: 16px;border-radius: 5px;border: 1px solid #57d600;float: right;margin: 5px;"><b>ℹ️ @round_type_title #@round_id </b></div>

                    </div>
                    <span style="font-size: 30px;float: right"><b>סגירת יום</b> @round_info.title</span>

                </div>


            </div>

            @if (order_data.Count() > 0)
            {
                <div style="overflow: auto; -webkit-overflow-scrolling: touch; ">

