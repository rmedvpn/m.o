                                <button type="button" style="font-size: 18px;padding: 5px;margin: 5px;background-color: #fff;width: 45%;color: #000;font-weight: bold" onclick="AjaxActions('UpdateSpecialOfferDetails', @spOfferId,'','UpdateSpecialOfferDetails');">✅ שמירת שינוים</button>
