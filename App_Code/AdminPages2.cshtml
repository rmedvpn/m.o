                        <span style="float: left">
                            <input type="checkbox" style="float: left;margin: 5px;padding: 5px;width: 20px;height: 20px;" id="is_active" name="is_active" @if (product.is_active) { <text> checked</text>}>
                        </span>

                    </div>
                    <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;background-color: #ffffcc">
                        כלול במבצעים
                        <span style="float: left">
                            <input type="checkbox" style="float: left;margin: 5px;padding: 5px;width: 20px;height: 20px;" id="SpOffersOk" name="SpOffersOk" @if (product.SpOffersOk) { <text> checked</text>}>
                        </span>

                    </div>
                    <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;background-color: #ffffcc">
                        כלול בהקצאות קופת קהילה
                        <span style="float: left">
                            <input type="checkbox" style="float: left;margin: 5px;padding: 5px;width: 20px;height: 20px;" id="CharityOffersOk" name="CharityOffersOk" @if (product.CharityOffersOk) { <text> checked</text>}>
                        </span>

                    </div>

                    <div style="overflow: auto;color: #000;padding: 5px;font-weight: bold;font-size: 18px;background-color: #ffffcc">
                        זמין במלאי
                        <span style="float: left">
                            <input type="checkbox" style="float: left;margin: 5px;padding: 5px;width: 20px;height: 20px;" id="is_in_stock" name="is_in_stock" @if (product.is_in_stock) { <text> checked</text>} onclick="if(this.checked){showElement('inStockQuanDiv');}else{hideElement('inStockQuanDiv');}">
