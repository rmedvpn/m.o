                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #57d600;color: #fff" onclick="AjaxActions('SaveRoundBasicInfo', '@round_id','','RoundBasicInfo', 'GENERAL');">שמירת שינויים</button>
