@helper RoundsAdmin(string showWhat = "ACTIVE", int vendor_id = 0)
{
    if (showWhat == "") { showWhat = "ACTIVE"; }
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string txtHeader = "סבבים ותחנות חלוקה - ";

    switch (showWhat)
    {
        case "ALL":
            sqlSelect = "SELECT * FROM rounds WHERE is_deleted=0 AND round_type>0 ";
            txtHeader = txtHeader + " כל הערוצים ";
            break;
        case "ACTIVE":
            sqlSelect = "SELECT * FROM rounds WHERE is_deleted=0 AND  is_active=1 ";
            txtHeader = txtHeader + " כל הערוצים הפעילים ";
            break;
        case "SETUP":
            sqlSelect = "SELECT * FROM rounds WHERE is_deleted=0 AND  is_setup=1 ";
            txtHeader = txtHeader + " כל הערוצים המוגדרים ";
            break;
        case "ROUNDS":
            sqlSelect = "SELECT * FROM rounds WHERE is_deleted=0 AND  round_type=1 ";
            txtHeader = txtHeader + " סבבי החלוקה ";
            break;
        case "OUTPOST":
            sqlSelect = "SELECT * FROM rounds WHERE is_deleted=0 AND  round_type=4 ";
            txtHeader = txtHeader + " תחנות מקומיות ";
            break;
        default:
            sqlSelect = "SELECT * FROM rounds WHERE is_deleted=0 AND  is_setup=1 ";
            txtHeader = txtHeader + " כל הערוצים המוגדרים ";
            showWhat = "SETUP";
            break;
    }

    if (vendor_id != 0)
    {
        sqlSelect = sqlSelect + " AND vendor_id=@0";
        txtHeader = txtHeader + " לספק " + AppFunctions.GetVendorTitleById(vendor_id);
    }
    else
    {
        txtHeader = txtHeader + " לכל הספקים הפעילים ";
    }
    //sqlSelect = sqlSelect + " order by is_setup DESC,round_type,sort_order,vendor_id DESC,id DESC"; //" order by is_setup DESC,round_type,vendor_id DESC,id DESC";
    sqlSelect = sqlSelect + " order by round_type,sort_order"; //" order by is_setup DESC,round_type,vendor_id DESC,id DESC";
    var Rounds = db.Query(sqlSelect, vendor_id);
    sqlSelect = "SELECT * FROM vendors";
    var vendors = db.Query(sqlSelect);

    <div style="overflow: auto;direction:rtl">
        <input type="hidden" id="showWhat" value="@showWhat">
        <div style="overflow: auto;padding: 5px;">
            <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;" onclick="Accordionize('AddRoundAcc')">חדש</button>
            <select style="font-size: 16px;margin: 5px;padding: 5px;float: left" id="selectedView" onChange="RepAjaxUpdate('ROUNDSADMIN','MainBoardContainer','MainLoader',this.value,document.getElementById('showing_vendor').value);">
                <option value="ACTIVE" @if (showWhat == "ACTIVE") { <text> selected</text> }>כל הערוצים הפעילים</option>
                <option value="SETUP" @if (showWhat == "SETUP") { <text> selected</text> }>כל הערוצים המוגדרים</option>
                <option value="ALL" @if (showWhat == "ALL") { <text> selected</text> }>כל הערוצים</option>
                <option value="ROUNDS" @if (showWhat == "ROUNDS") { <text> selected</text> }>סבבי חלוקה</option>
                <option value="OUTPOST" @if (showWhat == "OUTPOST") { <text> selected</text>}>תחנות מקומיות</option>
            </select>
            <select style="font-size: 16px;margin: 5px;padding: 5px;float: left" name="showing_vendor" id="showing_vendor" onChange="RepAjaxUpdate('ROUNDSADMIN', 'MainBoardContainer', 'MainLoader', document.getElementById('showWhat').value, this.value);">
                <option value="0">כל הספקים</option>
                @foreach (var vendor in vendors)
                {
                    <option value="@vendor.vendor_id" @if (vendor.vendor_id == vendor_id) { <TEXT> selected</TEXT>}>@vendor.vendor_name </option>
                }
            </select>
            <div style="font-size: 20px;float: right;color: #000">@txtHeader</div>
        </div>
        <div style="overflow: auto;">
            <button class="accordion" id="AddRoundAcc" style="display: none"></button>
            <div class="panel">
                <form id="AddNewRound">
                    <div style="overflow: auto;padding: 5px;border: 1px dotted #b200ff">
                        <div style="overflow: auto;float: right;">
                            <input type="text" id="title" name="title" placeholder="שם סבב" style="font-size: 16px;margin: 5px;padding: 5px;float: right">
                            <input type="text" id="title_e" name="title_e" placeholder="In English" style="font-size: 16px;margin: 5px;padding: 5px;float: right">

                            <select style="font-size: 16px;margin: 5px;padding: 5px;float: right" name="vendor_id" id="vendor_id">
                                <option value="">נא לבחור</option>
                                @foreach (var vendor in vendors)
                                {
                                    <option value="@vendor.vendor_id">@vendor.vendor_name</option>
                                }
                            </select>
                            <select name="round_type" id="round_type" style="font-size: 16px;margin: 5px;padding: 5px;float: right" onchange="if(this.value=='4'){showElement('OutPostOptions');}else{hideElement('OutPostOptions');}">
                                <option value="">נא לבחור</option>
                                <option value="1">סבב חלוקה</option>
                                <option value="4">תחנה מקומית</option>
                            </select>
                            <span style="font-size: 16px;margin: 5px;padding: 5px;display: none;color: #000;float: right" id="OutPostOptions">
                                <input type="checkbox" name="is_pickup" id="is_pickup"> איסוף
                                <input type="checkbox" name="is_express" id="is_express"> אקספרס
                            </span>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 12px;" onclick="AjaxActions('AddNewRound', '','', 'AddNewRound'); document.getElementById('AddNewRound').reset();">שמירה</button>
                        </div>


                    </div>
                </form>
            </div>
        </div>

        <div style="overflow: auto;clear: both;">
            @foreach (var round in Rounds)
            {
                string bgRawColor = "#000";
                bool is_setup = round.is_setup;
                bool is_active = round.is_active;
                if (!round.is_setup)
                {
                    bgRawColor = "#f00";
                }

                string round_vendor_name = "";
                round_vendor_name = AppFunctions.GetVendorTitleById(round.vendor_id);

                <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;background-color:#fff;color: #000;border-bottom: 1px dashed #000" id="RoundDiv_@round.id">
                    <input style="float: right;  margin: 3px;border:0" type="button" name="up_@round.id" value="⬆️" onclick="AjaxActions('SortRoundOrder',1,'MainLoader',@round.id);" />
                    <input style="float: right; margin: 3px; border: 0 " type="button" name="down_@round.id" value="⬇️" onclick="AjaxActions('SortRoundOrder',2,'MainLoader',@round.id);" />

                    <div style="overflow: auto;float: right;background-color: #fff;color: #808080;padding: 5px;margin: 5px;width: 40px;text-align: center;border-radius: 5px;font-size: 14px">
                        @if (round.is_setup && is_active)
                        {
                            <span style="color: #57d600">פעיל</span>
                        }
                        else
                        {
                            if (!is_setup)
                            {
                                <span style="color: #808080">לא מוגדר</span>
                            }
                            if (!is_active && is_setup)
                            {
                                <span style="color: #f00">לא פעיל</span>
                            }


                        }
                    </div>
                    <div style="overflow: auto;float: right;background-color: #fff;color: #808080;padding: 5px;margin: 5px;width: 120px;text-align: center;border-radius: 5px;font-size: 14px">@round_vendor_name</div>
                    @if (round.round_type == 1)
                    {
                        <div style="overflow: auto; float: right; background-color: #b200ff; color: #fff; padding: 5px; margin: 5px; width: 120px; text-align: center; border-radius: 5px; font-size: 14px">סבב חלוקה<span style="margin-right:5px;font-size:11px;">#@round.id</span></div>
                    }
                    @if (round.round_type == 4)
                    {
                        <div style="overflow: auto;float: right;background-color: #808080;color: #fff;padding: 5px;margin: 5px;width: 120px;text-align: center;border-radius: 5px;font-size: 14px">תחנה מקומית<span style="margin-right:5px;font-size:11px;">#@round.id</span></div>
                    }

                    <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #808080" onclick="MiscActions('SelectEntry','RoundDiv_@round.id');sbload('GenSb','Caller?p1=RoundEdit&p2=@round.id');AdjustMainView();">הגדרות</button>
                    <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #808080" onclick="MiscActions('SelectEntry','RoundDiv_@round.id');sbload('GenSb','Caller?p1=EditRoundMenu&p2=@round.id');AdjustMainView();">תפריט</button>
                    <div style="overflow: auto;padding: 5px;font-size: 20px;">@round.title </div>
                </div>
            }
        </div>


        <div style="overflow:auto;height:250px;">&nbsp;</div>


    </div>
    db.Close();
}

@helper RoundEdit(int round_id, string viewMode = "GENERAL")
{
   <div>@Rounds.RoundControlPanel(round_id,viewMode)</div>
}


@helper RoundEdit_bck(int round_id, string viewMode = "GENERAL")
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    if (round != null)
    {
        bool is_setup = round.is_setup;
        bool is_active = round.is_active;
        bool is_deleted = round.is_deleted;
        bool in_delivery_mode = round.in_delivery_mode;
        int vendor_id = round.vendor_id;
        int round_type = round.round_type;

        <input type="hidden" name="sRound_id" id="sRound_id" value="@round_id">
        <div style="padding: 0;margin: 0;overflow: auto;direction:rtl">

            <div style="background-color:  #000; overflow: auto; font-size: 24px; color: #fff;">

                @round.title <span style="font-size:12px;">#@round.id</span>
                @if (!is_active)
                {<span style="font-size:12px;margin-right:10px;background-color:#f00;color:yellow;padding:2px;"><b>לא פעיל</b></span>}
            <select name="viewType" style="padding: 3px;margin: 3px;font-size: 16px;float: left;margin-left: 10px;" onchange="RepAjaxUpdate('RoundSettingsView', 'GenSbContent', 'GenSbLoader',@round_id, this.value)">

                <option value="GENERAL" @if (viewMode == "GENERAL") { <text> selected</text>}>הגדרות כלליות</option>
                <option value="INVENTORY" @if (viewMode == "INVENTORY") { <text> selected</text>}>הגדרות מלאי</option>
                <option value="SCHEDULE" @if (viewMode == "SCHEDULE") { <text> selected</text>}>לוח זמנים</option>
                @if (round_type == 1)
                {
                    <option value="ROUND" @if (viewMode == "ROUND") { <text> selected</text>}>הגדרות קו חלוקה</option>
                }
                else
                {
                    <option value="ROUND" @if (viewMode == "ROUND") { <text> selected</text>}>הגדרות תחנה מקומית</option>
                }

                <option value="TEAM" @if (viewMode == "TEAM") { <text> selected</text>}>הגדרות צוות</option>
                <option value="DELIVERY" @if (viewMode == "DELIVERY") { <text> selected</text>}>הגדרות משלוחים</option>
            </select>
            </div>

            <div style="text-align: right;font-size: 18px;padding: 0;margin: 0;color: #000;min-height: 600px;overflow: auto;background-color: #fff">


                @if (is_deleted)
                {
                    <div style="overflow: auto;background-color:yellow;padding: 5px;margin: 5px;border: 2px solid #f00">
                        <div style="overflow: auto">
                            הערוץ נמחק!

                        </div>

                    </div>
                }

                @if (!is_setup)
                {
                    <div style="overflow: auto;background-color:#ffcccc;padding: 5px;margin: 5px;border: 2px solid #f00">
                        <div style="overflow: auto">
                            הפעלת ערוץ זה במערכת לא הושלמה!<div style="overflow: auto;font-size: 12px;">הערוץ '@round.title' לא מוצג כעת במערכת</div>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #e3e3e3;color: #000;float: left" onclick="AjaxActions('RoundFinishSetup', @round_id,'', 'RoundBasicInfo');">הפעלה</button>
                        </div>

                    </div>
                }


                @if (in_delivery_mode)
                {
                    <div style="overflow: auto;background-color:#b4dfff;padding: 5px;margin: 5px;border: 2px solid #f00">
                        מצב חלוקה <button style="font-size: 16px;padding: 5px;margin: 5px;float: left">ביטול מצב חלוקה</button>
                    </div>
                }


                <div style="overflow: auto" id="CurViewDiv">

                    @switch (viewMode)
                    {

                        case "GENERAL":
                            <div style="overflow: auto;">
                                @AdminPages2.RoundGeneralSettings(round_id)
                            </div>
                            <div style="overflow: auto; display: none">
                                Rounds.RoundDispatchSettings(round_id)
                            </div>
                            break;
                        case "INVENTORY":
                            <div style="overflow: auto">
                                <div style="overflow: auto">
                                    <div style="background-color: #fff;" id="RoundInventorySourcesDiv">
                                        AdminRounds.RoundInventorySources(round_id)
                                    </div>
                                </div>
                            </div>
                            break;
                        case "SCHEDULE":
                            <div style="overflow: auto;">
                                <div style="background-color: #fff;" id="RoundScheduleDiv">
                                    @AdminPages2.RoundSchedule(round_id)
                                </div>
                                <div style="background-color: #fff;display: none" id="RoundEditScheduleDiv">
                                    @AdminPages2.RoundEditSchedule(round_id)
                                </div>
                            </div>

                            break;
                        case "ROUND":
                            <div style="overflow: auto;">
                                @Rounds.RoundDispatchSettings(round_id)
                            </div>
                            break;
                        case "TEAM":
                            <div style="overflow: auto;">
                                <div style="overflow: auto;" id="RoundTeamSettingsDiv">
                                    @Rounds.RoundTeamSettings(round_id, vendor_id)
                                </div>
                            </div>
                            break;
                        case "DELIVERY":
                            <div style="overflow: auto;">
                                <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
                                    ניהול משלוחים
                                    <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="Accordionize('AddRoundDeliveryAcc');">הוספת משלוח</button>
                                </div>

                                <div style="overflow: auto" id="RoundSettingsDeliveriesDiv">

                                    AdminRounds.RoundSettingsDeliveries(round_id)


                                </div>

                            </div>
                            break;

                        default:
                            <div style="overflow: auto;">
                                vmn: @viewMode
                            </div>
                            break;

                    }

                </div>















            </div>




            <div style="overflow: auto;height: 100px;">&nbsp;</div>

        </div>

    }
    else
    {
        Response.Write("round: " + round_id);
    }

    db.Close();
}

