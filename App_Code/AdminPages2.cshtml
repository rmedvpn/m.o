                                <td class="header">הזמנה</td>
                                <td class="header">שם</td>
                                <td class="header">כתובת</td>
                                <td class="header">לתשלום</td>
                                <td class="header">שולם</td>
                                <td class="header">סטטוס</td>
                            </tr>
