                                <input type="checkbox" style="height: 20px;width: 20px;" id="sell_1s_ph" onclick="hideElement('sell_pre_pack');showElement('sell_all_div');document.getElementById('sell_1s').checked=true;"> 1
                                <input type="checkbox" id="sell_3s" name="sell_3s" style="height: 20px;width: 20px;" @if (sell_3s) { <text> checked </text> }> 3
                                <input type="checkbox" id="sell_5s" name="sell_5s" style="height: 20px;width: 20px;" @if (sell_5s) { <text> checked </text> }> 5
                                /
