@helper MainPanel()
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    string txtHeader = "";

    sqlSelect = "SELECT * FROM Rounds WHERE is_setup=1 AND is_active=1  AND round_type=1 order by sort_order ";
    var DeliveryRounds = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM Rounds WHERE in_delivery_mode=1 AND round_type=1 order by next_scheduled_delivery ";
    var DeliveryModeRounds = db.Query(sqlSelect);


    sqlSelect = "SELECT * FROM Rounds WHERE is_setup=1 AND is_active=1 AND  round_type=4 order by active_orders DESC ";
    var Outposts = db.Query(sqlSelect);
    DateTime localTime = AppFunctions.LocalTime();

    <input type="hidden" id="UpdateToken" value="MainPanel">

    <div style="direction:rtl;padding:5px;">
        <button style="float:left;padding:5px;margin:5px;" onclick="PageNavigator('ROUNDSADMIN')">⚙️</button>
        <div style="overflow: auto;width: 40%;float: right">
            <div style="overflow: auto">
                @if (DeliveryModeRounds.Count() > 0)
                {
                    <div style="overflow: auto;">
                        <h2 style="padding: 5px;">סבבים בתהליך חלוקה</h2>
                        @foreach (var item in DeliveryModeRounds)
                        {
                            <div>@AdminPages2.InDeliveryRoundInfo(item.id)</div>
                        }
                    </div>
                }
            </div>

            <div style="overflow: auto;">
                @if (DeliveryRounds.Count() > 0)
                {
                    <div style="overflow: auto;">
                        <h2 style="padding: 5px;">סבבים פתוחים</h2>
                        @foreach (var item in DeliveryRounds)
                        {
                            <div>@AdminPages2.RoundInfo(item.id)</div>
                        }
                    </div>
                }
            </div>
        </div>

        <div style="overflow: auto;width: 40%;float: right">
            @if (Outposts.Count() > 0)
            {
                <div style="overflow: auto;">

                    <h2 style="padding: 5px;">תחנות</h2>
                    @foreach (var item in Outposts)
                    {
                        int RoundOrderCount = NewAppFunctions.GetOrdersCountByRound("ALL", item.id);
                        decimal RoundTotalOrdersSum = NewAppFunctions.GetRoundTotalOrdersSum(item.id);
                        string orders_close = item.order_close_hour.ToString("HH:mm");
                        <div style="overflow: auto;" onclick="PageNavigator('ROUNDBOARD',@item.id);">
                            <div style="font-size: 18px;overflow: auto; ;padding: 5px;margin: 5px;background-color: #e3e3e3;color: #000">
                                <div style="text-align: right;overflow: auto;float: right">
                                    @item.title
                                    <div style="float: left;text-align: center;display: none">@NewAppHelpers.TeamRoundMiniStatus(item.round_status, item.id)</div>
                                </div>

                                <div style="overflow: auto;float: left;text-align: center">
                                    <div style="overflow: auto;text-align: center">
                                        <span style="padding: 5px;text-align: center;float: left;min-width: 60px;background-color: white;margin: 5px;border-radius: 5px;color: #000"><span style="font-size: 14px;">סה"כ<br></span><span style="font-size: 18px;"> ₪@Convert.ToInt32(RoundTotalOrdersSum)</span></span>
                                        <span style="padding: 5px;text-align: center;float: left;width: 40px;background-color: white;margin: 5px;border-radius: 5px;color: #000"><span style="font-size: 14px;">הזמנות<br></span><span style="font-size: 18px;">@RoundOrderCount</span></span>
                                        <span style="padding: 5px;text-align: center;float: left;background-color: white;margin: 5px;border-radius: 5px;color: #000;display: none"><span style="font-size: 14px;">שעת יציאה<br></span><span style="font-size: 18px;">@orders_close</span></span>
                                    </div>
                                </div>
                                <div style="float: right;overflow: auto" onclick="AjaxLoad('crmRound?round_id=@item.id');" id="RoundInfo_@item.id">
                                    <div class="spinner" style="text-align: center;float: left;display: none;" id="RdLoader_@item.id">
                                        <div class="bounce1"></div>
                                        <div class="bounce2"></div>
                                        <div class="bounce3"></div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div style="overflow:auto;height:250px;">&nbsp;</div>

    </div>
}
@helper RoundInfo(int round_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM dbo.rounds WHERE id=@0";
    var round = db.QuerySingle(sqlSelect, round_id);
    DateTime localTime = AppFunctions.LocalTime();


    int RoundOrderCount = 0; RoundOrderCount = NewAppFunctions.Counter("CURRENTROUNDORDERS", round.id.ToString());
    int RoundFutureOrders = 0; RoundFutureOrders = NewAppFunctions.Counter("FUTUREROUNDORDERS", round.id.ToString());

    decimal RoundTotalOrdersSum = NewAppFunctions.GetRoundTotalOrdersSum(round.id);

    string orders_close = round.order_close_hour.ToString("HH:mm");
    string dayOfOrder = NewAppFunctions.strDayOfWeek(round.order_close_hour);

    if (round.order_close_hour.Day == localTime.Day)
    {
        dayOfOrder = "היום";
    }
    if (round.order_close_hour.Day == localTime.AddDays(1).Day)
    {
        dayOfOrder = "מחר";
    }
    if (round.order_close_hour.Day > localTime.AddDays(1).Day || round.order_close_hour.Day < localTime.Day)
    {
        dayOfOrder = NewAppFunctions.strDayOfWeek(round.order_close_hour) + " " + round.order_close_hour.ToShortDateString();
    }

    <div style="overflow: auto;" onclick="PageNavigator('ROUNDBOARD',@round.id);">

        <div style="font-size: 18px;overflow: auto; ;padding: 5px;margin: 5px;background-color: #e3e3e3;color: #000">
            <div style="text-align: right;overflow: auto;float: right">
                @round.title<br>
                <span style="font-size: 12px;color: #b200ff;text-align: center;">סבב קרוב: @dayOfOrder</span><br>
                <span style="font-size: 12px;color: #808080;text-align: center;">@RoundFutureOrders הזמנות עתידיות</span>
            </div>
            <div style="overflow: auto;float: left;text-align: center">
                <div style="overflow: auto;text-align: center">
                    <span style="padding: 5px;text-align: center;float: left;width: 40px;background-color: white;margin: 5px;border-radius: 5px;color: #000;display: none"><span style="font-size: 14px;">עתידיות<br></span><span style="font-size: 18px;">@RoundFutureOrders</span></span>
                    <span style="padding: 5px;text-align: center;float: left;min-width: 60px;background-color: white;margin: 5px;border-radius: 5px;color: #000"><span style="font-size: 14px;">סה"כ<br></span><span style="font-size: 18px;"> ₪@Convert.ToInt32(RoundTotalOrdersSum)</span></span>
                    <span style="padding: 5px;text-align: center;float: left;background-color: white;margin: 5px;border-radius: 5px;color: #000"><span style="font-size: 14px;">שעת סגירה<br></span><span style="font-size: 18px;">@orders_close</span></span>
                    <span style="padding: 5px;text-align: center;float: left;;background-color: white;margin: 5px;border-radius: 5px;color: #000"><span style="font-size: 14px;">הזמנות<br></span><span style="font-size: 18px;">@RoundOrderCount</span></span>

                </div>
            </div>
            <div style="float: right;overflow: auto" onclick="AjaxLoad('crmRound?round_id=@round.id');" id="RoundInfo_@round.id">
                <div class="spinner" style="text-align: center;float: left;display: none;" id="RdLoader_@round.id">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>

            </div>
        </div>
    </div>

}
