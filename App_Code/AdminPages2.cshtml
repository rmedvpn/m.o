@helper RoundSchedule(int round_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT * FROM RoundsSchedules WHERE round_id=@0 ORDER BY DayOfWeek";
    var RoundSchedule = db.Query(sqlSelect, round_id);

    int curDay = -1;


    <div style="overflow: auto">
        <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
            לוח זמנים
            <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="showElement('RoundEditScheduleDiv');hideElement('RoundScheduleDiv');">עריכה</button>
        </div>

        @foreach (var sched in RoundSchedule)
        {
            <div style="padding: 0;margin: 0;overflow: auto;border-bottom: 1px dashed #e3e3e3">
                @if (curDay != sched.dayOfWeek)
                {
                    curDay = sched.dayOfWeek;
                    <div style="overflow: auto">
                        <span style="float: right;padding: 3px;margin: 3px;">יום @NewAppFunctions.strDayOfWeekFromInt(sched.dayOfWeek)                </span>
                        <span style="float: left;padding: 3px;margin: 3px;font-size: 12px;"> משלוח הבא #@sched.delivery_id  @sched.next_scheduled_launch.ToShortDateString() @sched.next_scheduled_launch.ToString("HH:mm")</span>

                    </div>
                }
                <div style="overflow: auto;float: left;">
                    <div style="float: left;padding: 3px;margin: 3px;"><span style="font-size: 12px;">שעת יציאה</span><br>@sched.round_start.ToString("HH:mm")</div>
                    <div style="float: left;padding: 3px;margin: 3px;"><span style="font-size: 12px;">סגירת הזמנות</span><br>@sched.round_order_close.ToString("HH:mm")</div>
                    <div style="float: left;padding: 3px;margin: 3px;"><span style="font-size: 12px;"># משלוח</span><br>@sched.next_delivery_id</div>
                </div>

            </div>
        }



        <div style="padding: 0;margin: 0;overflow: auto;">
        </div>
    </div>


    db.Close();
}
