                                            {
                                                <div style="overflow:auto"><span style="color:blue;font-size:12px"><b>סבב חלוקה</b></span></div>
                                            }

                                        </td>




                                        <td style="width:100px;padding:5px;">
                                            <div style="overflow:auto;font-size:12px;color:#000"><b>הזמנה #@order.order_id</b></div>
                                            <div style="overflow:auto;font-size:12px;color:#000">
                                                @order.timestamp.ToShortDateString()  @order.timestamp.ToString("HH:mm")
                                            </div>
                                        </td>


                                        <td style="width: 150px; padding: 5px;color:#000">
                                            @order.nick_name
                                        </td>
                                        <td style="width: 150px; padding: 5px;">@order.ship_city<br><span style="font-size: 12px;color: #808080;">@order.ship_address</span></td>
                                        <td style="width: 100px; padding: 5px;color:@amount_clear_bg_color;">@order.grand_total.ToString("C", culture)</td>
                                        <td style="width: 100px; padding: 5px;color:@amount_clear_bg_color;">@order.actual_amount_pickedup.ToString("C", culture)</td>
                                        <td style="width: 200px; padding: 5px;">
                                            <div style="font-size:14px;overflow:auto;color:@order_clear_bg_color"><b>@NewAppFunctions.GetTitleById("OrderStatus", order.order_status)</b></div>
                                        </td>

                                    </tr>

                                }
                            }
                            else
                            {
                                <tr><td colspan="999">-- אין הזמנות רלוונטיות --</td></tr>
                            }
                            <tr><td colspan="999" style="height: 50px;">&nbsp;</td></tr>
                        </table>
                    </form>

                    @if (is_round_clear_for_close)
                    {
                        <form id="CloseRoundZ">

                            <center>
                                <div style="padding:5px;margin:5px;background-color:#57d600;color:white;width:40%">

                                    <div style="overflow: auto; text-align: right">
                                        <input type="checkbox" checked style="padding: 5px; margin: 5px;" name="is_open_tommorow" onclick="if (this.checked) {hideElement('zedActionsDiv'); } else { showElement('zedActionsDiv'); }" /> פתיחת זד חדש למחר
                                    </div>
                                    <div style="overflow:auto;display:none;text-align:right" id="zedActionsDiv">
                                        <div style="overflow:auto;">
                                            <input type="radio" name="z_action" value="today" style="padding: 5px; margin: 5px;" /> פתיחת זד חדש להיום
                                        </div>
                                        <div style="overflow:auto;">
                                            <input type="radio" name="z_action" value="date" style="padding: 5px; margin: 5px;" /> פתיחת זד חדש לתאריך <input type="date" style="padding:5px;margin:5px;font-size:18px;" name="custom_z_date" />

                                        </div>
                                        <div style="overflow:auto;">
                                            <input type="radio" name="z_action" value="none" style="padding: 5px; margin: 5px;" />לא לפתוח זד בכלל
                                        </div>
                                        <div style="overflow:auto;">

                                            <div style="overflow:auto;">

                                                <div style="overflow:auto;">

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div style="overflow:auto">
                                        <button type="button" style="padding: 10px; margin: 10px; font-size: 18px;" onclick="AjaxActions('CloseRoundZ', '@round_id','', 'CloseRoundZ');">
                                            סגירת יום - @round_info.title - ZED #@z_id @z_date.ToShortDateString()
                                        </button>
                                    </div>


                                </div>
                            </center>
                        </form>


                    }
                    else
                    {
                        <button style="padding:10px;margin:10px;font-size:18px;background-color:#ffffcc;color:#000;border:2px dotted #f00">
                            לא ניתן לבצע סגירת יום - @round_info.title
                        </button>
                    }

                </div>
            }
            else
            {
                <div style="overflow:auto;padding:10px;margin:10px;font-size:22px;color:#f00">אין הזמנות לסגירה</div>
            }



        </div>


        <div style="overflow:auto;height:250px;">&nbsp;</div>

    </div>


    db.Close();
}


@helper ZAdmin(int vendor_id = 0, int round_id = 0)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "";
    DateTime local_time = AppFunctions.LocalTime();
    int cur_vendor_id = 0;

    sqlSelect = "SELECT * FROM ZREPORTS WHERE is_completed=0 ORDER BY vendor_id,round_id,z_id DESC";
    var zData = db.Query(sqlSelect);

    <div style="max-height: 95%;overflow: auto;direction:rtl">
        <div class="B">
            <div style="overflow: auto; background-color:#808080; color: white; padding: 5px; text-align: center">
                <h2>ניהול דוחות זד</h2>
            </div>
        </div>

        <div style="overflow: auto; -webkit-overflow-scrolling: touch; ">

            <form id="NewOrderFor3m">
                <table style="width: 100%; font-size: 16px; border-collapse: collapse; background-color: white;padding:10px; ">
                    <tr style="overflow: auto;background-color: #808080;color: #57d600;font-size:18px;">
                        <td class="header">#Z</td>
                        <td class="header">תאריך Z</td>

                        <td class="header">ערוץ</td>
                        <td class="header">הזמנות</td>

                        <td class="header">מכירות</td>
                        <td class="header">עמלה</td>
                        <td class="header"></td>
                    </tr>
                    <tr>
                        <td>
                            <center>
                                <div id="ordersLoader" style="display: none;">
                                    <div class="spinner" style="text-align: center;padding: 5px;margin: 5px;">
                                        <div class="bounce1"></div>
                                        <div class="bounce2"></div>
                                        <div class="bounce3"></div>
                                    </div>
                                </div>
                            </center>
                        </td>
                    </tr>
                    <tr id="NewOrderContainer"></tr>
                    @if (zData.Count() != 0)
                    {

                        foreach (var z in zData)
                        {
                            int z_orders_count = z.orders_count;
                            decimal z_total_sales = z.total_sales;
                            decimal z_total_commision = z.total_commision;
                            decimal commision_percantage = 0;

                            string forecolor = "#000";
                            if (z.is_active)
                            {
                                forecolor = "#ff6a00";
                                z_orders_count = Rounds.GetActiveZedOrdersCountForRound(z.round_id);
                                z_total_sales = Rounds.GetActiveZedTotalSalesForRound(z.round_id);
                                z_total_commision = Rounds.GetActiveZedTotalComissionForRound(z.round_id);
                            }

                            try { commision_percantage = z_total_commision / z_total_sales * 100; } catch { }

                            if (cur_vendor_id != z.vendor_id)
                            {
                                cur_vendor_id = z.vendor_id;
                                <tr>
                                    <td colspan="999" style="text-align:center;font-size:18px;color:#b200ff;padding:5px;margin:5px;background-color:#e3e3e3">
                                        <b>@AppFunctions.GetVendorTitleById(z.vendor_id)</b>
                                    </td>
                                </tr>
                            }

                <tr style="overflow: auto;font-size:18px;color:@forecolor" onclick="PageNavigator('ZREPORT',@z.serial)">
                    <td style="padding:5px;">@z.serial</td>
                    <td>@z.z_date.ToShortDateString()</td>

                    <td>@AppFunctions.GetRoundTitleById(z.round_id)</td>
                    <td>@z_orders_count</td>
                    <td>@z_total_sales.ToString("C", culture)</td>
                    <td>@z_total_commision.ToString("C", culture) <span class="PrplMiniTag" style="display:none">@String.Format("{0:0.00}", commision_percantage)%</span></td>
                    <td></td>
                </tr>
                          
                        }
                    }

                    <tr><td colspan="999" style="height: 50px;">&nbsp;</td></tr>
                </table>
            </form>

        </div>




    </div>


    <div style="overflow:auto;height:250px;">&nbsp;</div>



    db.Close();
}


