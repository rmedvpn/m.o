@helper RoundBoard_bck(int round_id, string showWhat = "TODAY", int requested_z_id = 0)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var u_id = WebSecurity.CurrentUserId;
var db = Database.Open("op_data");
var sqlSelect = "";
DateTime local_time = AppFunctions.LocalTime();
DateTime defTime = Convert.ToDateTime("1/1/1900");
DateTime z_date = Convert.ToDateTime("1/1/1900");
DateTime order_close_hour = Convert.ToDateTime("1/1/1900");
DateTime round_start = Convert.ToDateTime("1/1/1900");

int active_z_id = 0;
int active_z_serial = 0;
int z_id = 0;
sqlSelect = "SELECT * FROM Rounds WHERE id=@0";
var round_info = db.QuerySingle(sqlSelect, round_id);

sqlSelect = "SELECT TOP(1) * FROM ZREPORTS WHERE is_Active=1 AND round_id=@0 ORDER BY z_id DESC";
var ActiveZ = db.QuerySingle(sqlSelect, round_id);
if (ActiveZ != null)
{
    active_z_id = ActiveZ.z_id;
    active_z_serial = ActiveZ.serial;
    z_date = ActiveZ.z_date.Date;
    z_id = 0;
}

if (requested_z_id != 0)
{
    sqlSelect = "SELECT * FROM ZREPORTS WHERE  round_id=@0 AND serial=@1";
    var RequestedZ = db.QuerySingle(sqlSelect, round_id, requested_z_id);
    if (RequestedZ != null)
    {
        z_id = requested_z_id;
        z_date = RequestedZ.z_date.Date;
    }

}
if (requested_z_id == active_z_serial || requested_z_id == 0)
{
    z_id = 0;

}

string is_open_forOrders_text = "סגור";
bool is_open_for_orders = false; try { is_open_for_orders = round_info.is_open_for_orders; } catch { }
string is_open_for_orders_color = "#f00000";
string title_bar_bg_color = "#000";
int round_type = round_info.round_type;
bool is_express = round_info.is_express;
bool is_pickup = round_info.is_pickup;
bool is_route = round_info.is_route;
string round_type_title = "";
string viewTitle = "";
string round_start_time_bg_color = "";

if (round_type == 1)
{
    is_route = true;
    is_express = false;
    is_pickup = false;
    try { order_close_hour = round_info.order_close_hour; } catch { }
    try { round_start = round_info.round_start; } catch { }
    //if (order_close_hour < local_time)
    if (order_close_hour < local_time || order_close_hour== defTime)
    {
        round_start_time_bg_color = "#f00";
        if (round_start < local_time || round_start==defTime)
        {
            DataFunctions.WriteDebugLine("round_start1 " + round_start.ToString());

            Rounds.InitializeRound(round_id);
            sqlSelect = "SELECT * FROM Rounds WHERE id=@0";
            round_info = db.QuerySingle(sqlSelect, round_id);
            try { order_close_hour = round_info.order_close_hour; } catch { }
            try { round_start = round_info.round_start; } catch { }

        }

    }

    if (order_close_hour > local_time)
    {
        round_start_time_bg_color = "#57d600";
    }
    else
    {
        round_start_time_bg_color = "#f00";
    }

    // DataFunctions.WriteDebugLine("order_close_hour" + order_close_hour.ToString());
}

if (is_open_for_orders)
{
    is_open_for_orders = true;
    is_open_forOrders_text = "✌️ פתוח להזמנות";
    is_open_for_orders_color = "#57d600";

}
else
{
    is_open_forOrders_text = "❌ סגור להזמנות";
    title_bar_bg_color = "#f00";

}

round_type_title = NewAppFunctions.GetRoundTypeTitleById(round_type);


bool is_sorted = false;
is_sorted = round_info.is_sorted;
bool has_started = false;
has_started = round_info.has_started;

// showWhat = "ALL";
switch (showWhat)
{

    case "NEW":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 AND order_status<=0 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות חדשות";
        break;

    case "TODAY":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 AND (order_status>0 OR CAST(requested_delivery_date AS date) = CAST(@2 AS date)) ORDER BY order_status, delivery_id ,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות להיום";
        break;


    case "NODELIVERY":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND delivery_id<=0 AND z_serial=@0 AND  round_id = @1 AND (order_status>0 OR CAST(requested_delivery_date AS date) = CAST(@2 AS date)) ORDER BY delivery_id,order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות שלא משובצות לאף משלוח";
        break;

    case "ALL":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "כל ההזמנות";

        break;
    case "PROC":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status>1 AND order_status<=6  ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות בביצוע";

        break;
    case "PENDING":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status=1  ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות בהמתנה לאישור ספק";

        break;

    case "COMPLETED":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status>=9  ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות שבוצעו";

        break;
    case "CANCELLED":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE is_cancelled=1 AND  z_serial=@0 AND  round_id = @1 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "הזמנות שבוטלו";
        break;
    case "VENDOR":
        sqlSelect = "SELECT  MainOrders.*,rounds.short_title AS round_title,rounds.active_delivery_id FROM MainOrders JOIN rounds ON mainorders.round_id=rounds.id WHERE order_status=-6 AND  z_serial=@0 AND  round_id = @1 ORDER BY order_status,envelope_id,order_id DESC"; // order by is_approved, order_id DESC";
        viewTitle = "ביטולי ספק";
        break;
}

var order_data = db.Query(sqlSelect, z_id, round_id,local_time);
int orders_counter = 0;

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
var CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
try { orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=1 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
int cancelled_orders_counter = 0;
try { cancelled_orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE order_status=-6 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
int vendor_cancelled_orders_counter = 0;
try { vendor_cancelled_orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status<=0 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
int new_orders_counter = 0;
try { new_orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND   z_serial=@0 AND  round_id = @1 AND (order_status>0 OR CAST(requested_delivery_date AS date) = CAST(@2 AS date))"; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id,local_time);
int today_orders_counter = 0;
try { today_orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>1  AND order_status<=6 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
int in_proc_orders_counter = 0;
try { in_proc_orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status>=9 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
int completed_orders_counter = 0;
try { completed_orders_counter = CntRs.the_cnt; } catch { }

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE is_cancelled=0 AND order_status=1 AND  z_serial=@0 AND  round_id = @1 "; // order by is_approved, order_id DESC";
CntRs = db.QuerySingle(sqlSelect, z_id, round_id);
int awaiting_vendor_approval_orders_counter = 0;
try { awaiting_vendor_approval_orders_counter = CntRs.the_cnt; } catch { }


sqlSelect = "SELECT * FROM MainOrders WHERE round_id=@0 AND (order_status>0 OR cast(requested_delivery_date as DATE) =cast(@1 as DATE))AND delivery_id<=0  ORDER BY requested_delivery_date";
var unAssignedRoundOrders = db.Query(sqlSelect, round_id, local_time);

sqlSelect = "SELECT count(*) AS the_cnt  FROM MainOrders WHERE round_id=@0 AND (order_status>0 OR cast(requested_delivery_date as DATE) =cast(@1 as DATE))AND delivery_id<=0 ";
CntRs = db.QuerySingle(sqlSelect, round_id,local_time) ;
int unAssignedOrdersCounter = 0;
try { unAssignedOrdersCounter = CntRs.the_cnt; } catch { }

var title = round_info.title;

sqlSelect = "SELECT id,prod_code FROM roundMenuItems where round_id=@0 ";
var MenuItems = db.Query(sqlSelect, round_id);

sqlSelect = "SELECT id FROM roundSpecials where round_id=@0 AND is_active=1";
var MenuSpecials = db.Query(sqlSelect, round_id);

sqlSelect = "SELECT id,title,round_start FROM rounds where is_active=1 ";
//var Rounds = db.Query(sqlSelect);

sqlSelect = "SELECT serial,z_id,z_date,is_active FROM ZREPORTS where round_id=@0 order by is_active DESC, z_id DESC ";
var AvailableZeds = db.Query(sqlSelect, round_id);

decimal round_total = 0; try { round_total = Convert.ToInt32(NewAppFunctions.GetRoundTotalOrdersSum(round_id, z_id)); } catch { }

string orders_counter_text = "🤩  " + orders_counter + " הזמנות פעילות";
if (showWhat == "CANCELLED")
{
    orders_counter_text = "⛔  " + orders_counter + " הזמנות שבוטלו";
}

