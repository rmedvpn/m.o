                                <div style="overflow: auto;font-size: 14px;font-weight: bold">Description<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="special_desc_e" name="special_desc_e">@spOffer.desc_e</textarea></div>
