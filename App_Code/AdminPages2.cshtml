                    <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000" onclick="sbload('GenSb','Caller?p1=CatInfo&p2=@cat.id');AdjustMainView();">עריכה</button>
                    <div style="overflow: auto;"> @cat.id - @cat.title</div>
                    <div style="overflow: auto;clear: both;">
                        <button style="display: none" id="menuAcc_@cat.id"></button>
                        <div class="panel" style="padding: 0;margin: 0">
                            <div style="overflow: auto;padding: 5px;background-color: #ffffcc;color: #000">
                                <div style="overflow: auto;">
                                    <div style="overflow: auto;color: #b200ff;font-size: 14px;font-weight: bold">שם / Title</div>
                                    <div style="overflow: auto;font-size: 18px;">@cat.title / @cat.e_title</div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>



    db.Close();
}

@helper CatInfo(int cat_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM categories WHERE id=@0";
    var Category = db.QuerySingle(sqlSelect, cat_id);
    sqlSelect = "SELECT * FROM categories WHERE mainCat_id=@0 AND is_subcat=1";
    var SubCats = db.Query(sqlSelect, cat_id);
