            </div>


            <div style="overflow: auto;padding: 5px;;font-size: 18px;font-weight: bold;color: #000">
                <div style="overflow: auto;">מחיר מחירון <span style="float: left">@Convert.ToInt32(product.price) ₪</span></div>
            </div>


            <div style="overflow: auto;padding: 5px;font-size: 18px;font-weight: bold;color: #000">
