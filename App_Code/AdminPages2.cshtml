                    {<span style="padding: 2px;margin: 2px;background-color: #e3e3e3;color: #000">1</span>}
                    @if (sell_3s)
                    {<span style="padding: 2px;margin: 2px;background-color: #e3e3e3;color: #000">3</span>}
                    @if (sell_5s)
                    {<span style="padding: 2px;margin: 2px;background-color: #e3e3e3;color: #000">5</span>}
                    @if (sell_inXs > 0)
                    {<span style="padding: 2px;margin: 2px;background-color: #e3e3e3;color: #000">@sell_inXs </span>}
                    <span style="padding: 2px;margin: 2px;color: #000">@itemunit</span>
                </span>
            </div>


