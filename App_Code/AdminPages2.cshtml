@helper RoundBoard(int round_id, string showWhat = "PREP", int requested_z_id = 0)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var u_id = WebSecurity.CurrentUserId;
var db = Database.Open("op_data");
var sqlSelect = "";
DateTime local_time = AppFunctions.LocalTime();
DateTime defTime = Convert.ToDateTime("1/1/1900");
DateTime z_date = Convert.ToDateTime("1/1/1900");
DateTime order_close_hour = Convert.ToDateTime("1/1/1900");
DateTime round_start = Convert.ToDateTime("1/1/1900");

int active_z_id = 0;
int active_z_serial = 0;
int active_delivery_id = 0;
int z_id = 0;
sqlSelect = "SELECT * FROM Rounds WHERE id=@0";
