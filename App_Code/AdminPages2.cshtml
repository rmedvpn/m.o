                                        <input type="checkbox" style="padding: 5px;height: 20px;width: 20px;margin: 5px" @if (is_express) { <text> checked </text> } id="is_express" name="is_express" onclick="if (this.checked) { showElement('DeliverySettings'); } else { hideElement('DeliverySettings'); } AjaxActions('SaveRoundExpressSettings', '@round_id', 'RoundExpressPickupSettings', 'ROUND'); FixAccordion('round_settings');"> משלוחי אקספרס
                                    </div>
                                    <div style="overflow: auto;background-color: #e3e3e3;;display: @expressServiceDisplayState" id="DeliverySettings">
                                        <fieldset id="express_options_fieldset">
                                            <div style="padding: 5px;">
                                                <div style="overflow: auto;">
                                                    משלוחים לאזורים <br>
                                                    @foreach (var item in ServiceAreas)
                                                    {
                                                        sqlSelect = "SELECT * from roundAreas WHERE round_id=@0 AND area_id=@1";
                                                        var curArea = db.QuerySingle(sqlSelect, round_id, item.id);
                                                        bool is_curAreaSelected = false;
                                                        if (curArea != null)
                                                        {
                                                            is_curAreaSelected = true;
                                                        }
                                                        <div style="padding: 5px;margin: 5px;font-size: 16px;overflow: auto; ">
                                                            <input type="checkbox" style="height: 20px;width: 20px;margin: 5px;" id="RoundArea_@item.id" name="RoundArea_@item.id" value="@item.id" @if (is_curAreaSelected) { <text> checked </text> }> @item.Title
                                                        </div>
                                                    }

                                                </div>
                                                <div style="overflow: auto;">
                                                    <span style="float: right;">
                                                        התחייבות להגעה תוך
                                                    </span>
                                                    <span style="float: left">
                                                        <input type="text" style="width: 50px;padding: 5px;margin: 5px;font-size: 16px;" name="express_eta_min" id="express_eta_min" value="@express_eta_min">
                                                        <SELECT name="express_eta_type" id="express_eta_type" style="padding: 5px;margin: 5px;font-size: 16px;">
                                                            <option value="1">דקות</option>
                                                            <option value="2">שעות</option>
                                                        </SELECT>
                                                    </span>


                                                </div>
                                                <div style="overflow: auto;">
                                                    משלוח חינם במקרה איחור
                                                    <span style="float: left;">
                                                        <input type="checkbox" style="width: 20px;height: 20px;padding: 5px;margin: 5px;font-size: 16px;;" name="is_sh_late_waiver" id="is_sh_late_waiver" @if (round.is_sh_late_waiver) { <text> checked </text> }>
                                                    </span>
                                                </div>
                                                <div style="overflow: auto;">
                                                    הנחה במקרה איחור
                                                    <span style="float: left;">
                                                        <input type="text" style="width: 40px;padding: 5px;margin: 5px;font-size: 16px;float: right" name="sh_late_discount" id="sh_late_discount" placeholder="₪" @if (round.sh_late_discount != 0) { <text> value="@Convert.ToInt32(round.sh_late_discount)" </text> }>₪
                                                    </span>

                                                </div>
                                                <div style="overflow: auto;">
                                                    מחיר למשלוח <span style="float: left;"><input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 40px;" onfocus="this.value='';" id="shipping_charge" name="shipping_charge" placeholder="₪" @if (round.shipping_charge != 0) { <text> value="@Convert.ToInt32(round.shipping_charge)" </text> }>₪</span>
                                                </div>
                                                <div style="overflow: auto;">
                                                    מינימום למשלוח <span style="float: left;"><input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 40px;" onfocus="this.value='';" id="min_shipping_marker" name="min_shipping_marker" placeholder="₪" @if (round.min_shipping_marker != 0) { <text> value="@Convert.ToInt32(round.min_shipping_marker)" </text> }>₪</span>
                                                </div>
                                                <div style="overflow: auto;">
                                                    משלוח חינם בהזמנות מעל <span style="float: left;"><input type="text" style="padding: 5px;margin: 5px;font-size: 16px;width: 40px;" onfocus="this.value='';" id="free_shipping_marker" name="free_shipping_marker" placeholder="₪" @if (round.free_shipping_marker != 0) { <text> value="@Convert.ToInt32(round.free_shipping_marker)" </text> }>₪</span>
                                                </div>
                                                <div style="overflow: auto;">
                                                    הוראות קבלת משלוח<br>
                                                    <textarea placeholder="למשל: משלוחים כל יום בין 8 בבוקר ל4 אחהצ. משלוח תוך 90 דקות בהתחייבות" style="padding: 5px;margin: 5px;font-size: 16px;resize: none;width: 95%;" id="shipping_instructions" name="shipping_instructions" rows="3">@round.shipping_instructions</textarea>
                                                </div>
                                                <div style="overflow: auto;">
                                                    Delivery Instructions<br>
                                                    <textarea placeholder="English Please" style="padding: 5px;margin: 5px;font-size: 16px;resize: none;width: 95%;" id="shipping_instructions_e" name="shipping_instructions_e" rows="3">@round.shipping_instructions_e</textarea>
                                                </div>
                                                <div style="overflow: auto;text-align: center">
                                                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #f00;color: #fff;font-weight: bold" onclick="showElement('RoundDispatchInfo');hideElement('RoundDispatchSettings');">ביטול עריכה</button>

                                                    <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #57d600;color: #fff" onclick="AjaxActions('SaveRoundExpressSettings', '@round_id', '','RoundExpressPickupSettings', 'ROUND');">שמירת שינויים</button>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </form>
                            </div>
                        </div>

                        break;

                }

            </div>


        </div>

    </div>
}

@helper EditRoundMenu(int round_id)
