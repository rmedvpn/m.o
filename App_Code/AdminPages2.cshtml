@helper RoundDispatchSettings(int round_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    DateTime round_start = round.round_start;
    DateTime est_end_time = round.estimated_end_time;
    DateTime order_close = DateTime.Now;
    string title = round.title;
    string e_title = round.e_title;
    string description = round.description;
    string e_desc = round.e_desc;
    string comments = round.comments;
    bool is_express = round.is_express;
