                        <button style="padding:2px;margin:2px;font-size:16px;float:left" onclick="Accordionize('AddNotessAcc');">הוספה</button>
                        הערות לחבר.ה
                    </h3>

                    <div class="ProspectListRow">

                        <button class="accordion" style="display:none" id="AddNotessAcc"></button>
                        <div class="panel">
