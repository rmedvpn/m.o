                                        impBGColor = "Yellow";
                                    }
                                    if (note.is_system)
                                    {
                                        note_rep_name = "מערכת";
                                    }
                                    else
                                    {
                                        note_rep_name = AppFunctions.GetRepName(note.rep_id);
                                    }
                                    <div style="overflow:auto;">
                                        <span style="font-size:12px;color:#000"><span style="font-size:12px;color:#b200ff">@note.ts.ToShortDateString() @note.ts.ToString("HH:mm")</span><br /><span style="background-color:@impBGColor;">(@note_rep_name)</span></span>
                                        <span></span>
                                        <span>@note.theNote</span>
                                    </div>
                                }

                            </div>

                        }
                        else
                        {
                            <div class="ProspcetListCell">אין הערות</div>
                        }
                    </div>




                </div>

                <div class="formSectionSep"></div>
                <div class="formSection">
                    <h3>היסטורית הזמנות</h3>
                    <div class="ProspectListRow">
                        <div class="ProspcetListCell">
                            @foreach (var order in orders)
                            {
                                <div style="overflow:auto;">
                                    <span>@order.ts.ToShortDateString()</span>
                                    <span>@order.city</span>
                                    <span>@AppFunctions.GetRoundTitleById(order.r_id)</span>
                                </div>
                            }

                        </div>
                    </div>




                </div>
                <div class="formSectionSep"></div>

            </center>

        </div>

    }
    else
    {
        <center>
            <div style="overflow:auto;padding:20px;margin:20px;"><h2>המשתמש לא נמצא</h2></div>
        </center>

    }


    <div style="overflow:auto;height:150px;">&nbsp;</div>






    op_data.Close();
}

@helper OrderInfo(int order_id)
{

    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    //var m_join = Database.Open("m_join");
    var op_data = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM weborders WHERE serial=@0";
    var order = op_data.QuerySingle(sqlSelect, order_id);

    sqlSelect = "SELECT * FROM orderNotes WHERE order_id=@0 ORDER BY serial DESC";
    var orderNotes = op_data.Query(sqlSelect, order_id);

    if (order != null)
    {
        bool is_processed = order.is_processed;
        bool is_new_member = order.is_new_member;
        string wanum = order.wanum;
        wanum = AppFunctions.wanumize(wanum);
        string copPaste_wanum = wanum;
        string board_color = order.board_color;
        string member_name = order.nick_name;
        string provided_member_name = order.nick_name;
        if (member_name == "")
        {
            member_name = order.full_name;
        }
        var names = member_name.Split(' ');
        string first_name = names[0];
        string wanum_last_3 = "";
        if (member_name == "") { member_name = order.full_name; }
        if (board_color == "") { board_color = "#e3e3e3"; }
        try { wanum_last_3 = wanum.Substring(wanum.Length - 3); } catch { }
        string suggested_nick = first_name + wanum_last_3;
        string wanumized_friend_wanum = "";
        bool isRegisteredMember = false;
        int m_id = order.m_id;
        string pbName = "";

        sqlSelect = "SELECT m_id,member_name FROM pb WHERE wanum=@0";
        var pbEntry = op_data.QuerySingle(sqlSelect, wanum);
        bool is_verification_needed = false;
        bool is_manual_verification = order.is_manual_verification;
        if (pbEntry != null)
        {
            m_id = pbEntry.m_id;
            isRegisteredMember = true;
            pbName = pbEntry.member_name;
        }
        else
        {

            is_verification_needed = true;
        }


        string NickIdentifiedWanum = "";
        sqlSelect = "SELECT m_id,wanum FROM pb WHERE member_name=@0";
        pbEntry = op_data.QuerySingle(sqlSelect, member_name);
        try { NickIdentifiedWanum = pbEntry.wanum; } catch { }

        if (pbName == "")
        {
            pbName = member_name;
        }
        else
        {
            member_name = pbName;

        }

        string ref_desc = order.ref_source;
        if (ref_desc == "ref")
        {
            string ref_friend_wanum = order.ref_source_desc;
            wanumized_friend_wanum = AppFunctions.wanumize(ref_friend_wanum);
            sqlSelect = "SELECT member_name FROM pb WHERE wanum=@0";
            var refFriend = op_data.QuerySingle(sqlSelect, wanumized_friend_wanum);
            if (refFriend != null)
            {
                ref_desc = "<span style='float:right;'>✅</span> הפנייה על ידי החבר.ה " + refFriend.member_name + "<BR>" + ref_friend_wanum;
            }
            else
            {
                ref_desc = "<span style='float:right;'>❌</span> הפנייה על ידי מספר לא מזוהה " + ref_friend_wanum;
            }

        }
        if (is_new_member)
        {
            is_verification_needed = true;
        }

        if (is_manual_verification) { is_verification_needed = false; }

        <div style="overflow:auto;background-color:#e3e3e3;padding:10px;text-align:right;">
            <div style="overflow:auto;">
                <span style="float: left; margin-left: 40px;">
                    @if (isRegisteredMember)
                    {
                        <span style="font-size: 24px; color: #fff; background-color: #b200ff; float: left; margin-left: 10px; padding: 2px">משתמש רשום</span>
                    }
                    else
                    {
                        <span style="font-size: 24px; color: red; background-color: yellow; float: left; margin-left: 10px;padding:2px">משתמש לא רשום</span>
                    }

                    @if (is_verification_needed)
                    {
                        <span style="font-size: 24px; color: red; background-color: yellow; float: left; margin-left: 10px; padding: 2px ">נדרש אימות</span>
                    }
                    @if (is_manual_verification)
                    {
                        <span style="font-size: 24px; color: #fff; background-color: #b200ff; float: left; margin-left: 10px; padding: 2px ">בוצע אימות ידני</span>
                    }
                </span>
                <h2>
                    פרטי הזמנה #@order_id על שם @member_name
                </h2>
                <div style="overflow:auto;font-size:12px;text-align:right">@order.ts.ToShortDateString() @order.ts.ToString("HH:mm")</div>



            </div>

            <button class="Accordion" style="display:none" id="editOrderAcc"></button>
            <div class="panel" style="padding:0;margin:0">
                <div style="overflow:auto;background-color:#e3e3e3;text-align:right;">
                    @AppHelpers.EditWebOrder(order_id)
                </div>
            </div>

            <div style="overflow:auto;padding:5px;margin:5px;background-color:white;">
                <button type="button" style="padding:5px;margin:5px;font-size:16px;float:left" onclick="waLaunch('@order.wanum');">ווטסאפ</button>
                <button type="button" style="padding:5px;margin:5px;font-size:16px;float:left" onclick="Accordionize('editOrderAcc');">עריכה</button>

                <h3>חבר.ה מזמינ.ה</h3>
                <div style="overflow:auto">
                    <span style="float:right">@member_name</span>
                    @if (member_name != provided_member_name && provided_member_name != "")
                    {
                        <span style="font-size:12px;color:#b200ff;margin-right:10px;"> (הכינוי שהוזן הוא <span><b>@provided_member_name)</b></span></span>
                    }
                </div>
                <div style="overflow:auto">
                    @order.address @order.city
                </div>
                <div style="overflow:auto">
                    @copPaste_wanum
                    @if (copPaste_wanum != NickIdentifiedWanum && NickIdentifiedWanum != "")
                    {
                        if (provided_member_name == "")
                        {
                            provided_member_name = member_name;
                        }
                        <div style="overflow:auto;color:#b200ff">
                            מספר הטלפון של הכינוי שהוזן (@provided_member_name) רשום במערכת כ: @NickIdentifiedWanum
                        </div>

                    }
                </div>
                <div style="overflow:auto;height:20px;">&nbsp;</div>
                <div style="overflow:auto"> <h3>פירוט הזמנה</h3></div>
                <div style="overflow:auto">@order.menu_title</div>
                <div style="overflow:auto"> @order.orderbody</div>

                @if (order.donation > 0)
                {<div style="overflow:auto;height:20px;">&nbsp;</div>
                    <div style="overflow:auto">תרומה: @order.donation</div>
                }

                @if (order.ref_source != "")
                {
                    <div style="overflow:auto;height:20px;">&nbsp;</div>
                    <div style="overflow:auto">
                        <h3>מקור פניה</h3>
                    </div>
                    <div style="overflow:auto">
                        @Html.Raw(ref_desc)
                        @if (order.ref_source == "ref")
                        {
                            <button type="button" style="padding:5px;margin:5px;font-size:16px;float:left" onclick="waLaunch('@wanumized_friend_wanum');">ווטסאפ</button>
                        }
                    </div>

                }

                @if (order.birth_date.ToShortDateString() != "1/1/1900")
                {
                    <div style="overflow:auto;height:20px;">&nbsp;</div>
                    <div style="overflow:auto"><h3>תאריך לידה</h3></div>
                    <div style="overflow:auto">@order.birth_date.ToShortDateString() (גיל @AppFunctions.HowManyYearsAgoWas(order.birth_date))</div>
                }

            </div>


            @if (is_verification_needed)
            {
                <div style="overflow:auto;background-color:#e3e3e3;direction:rtl">
                    <div style="overflow:auto;text-align:center" id="orderActionsDiv">


                        <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="hideElement('orderActionsDiv');showElement('OrderRejectDiv');">דחיית ההזמנה</button>
                        <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="hideElement('orderActionsDiv');showElement('OrderApproveDiv');">אישור ההזמנה</button>
                    </div>
                    <div style="overflow: auto; display: none; padding: 5px; margin: 5px;text-align:center" id="OrderRejectDiv">
                        <form id="DenyOrderForm">
                            <center>
                                <select style="padding: 5px; margin: 5px;font-size:16px;" id="deny_reason" name="deny_reason" onchange="if (this.value == 'OTHER') { showElement('deny_reason_other'); } else {hideElement('deny_reason_other'); }">
                                    <option value="">נא לציין את סיבת הדחיה..</option>
                                    <option value="AGE">מתחת לגיל המינימום</option>
                                    <option value="CONTACT">פרטי קשר לא תקינים</option>
                                    <option value="TEST">הזמנה לבדיקה</option>
                                    <option value="OTHER">אחר..</option>
                                </select>
                                <textarea style="padding: 5px; margin: 5px;font-size:16px;display:none;resize:none" id="deny_reason_other" name="deny_reason_other"></textarea>
                                <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="hideElement('OrderRejectDiv');showElement('orderActionsDiv');">ביטול</button>
                                <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="AjaxActions('RefuseOrder','@order.serial','','DenyOrderForm');">דחיית ההזמנה</button>
                            </center>
                        </form>
                    </div>

                    <div style="overflow: auto; display: none; padding: 5px; margin: 5px;text-align:center" id="OrderApproveDiv">
                        <form id="VerifyOrderForm">
                            <center>
                                <span id="OrderRegSpan">
                                    @if (isRegisteredMember)
                                    {
                                        <span>
                                            המשתמש @pbName קיים במערכת!
                                            <input type="hidden" id="member_id" name="member_id" value="@m_id">
                                            <input type="hidden" id="wanum" name="wanum" value="@wanum">
                                            <input type="hidden" id="full_name" name="full_name" value="@member_name">
                                        </span>

                                        <span>
                                            <input type="checkbox" style="padding: 5px; margin: 5px;" name="is_welcome_msg" id="is_welcome_msg" checked>
                                            הודעת פתיחה
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            כינוי:<input type="text" style="padding: 5px; margin: 5px;font-size:16px;" placeholder="כינוי" id="suggested_nick" name="suggested_nick" value="@suggested_nick">
                                            <input type="hidden" id="wanum" name="wanum" value="@wanum">
                                            <input type="hidden" id="full_name" name="full_name" value="@member_name">
                                        </span>
                                        <span>
                                            <input type="checkbox" style="padding: 5px; margin: 5px;" name="is_register_member" id="is_register_member" checked onclick="document.getElementById('suggested_nick').disabled = !this.checked;">
                                            רישום למערכת
                                        </span>

                                        <span>
                                            <input type="checkbox" style="padding: 5px; margin: 5px;" name="is_welcome_msg" id="is_welcome_msg" checked>
                                            הודעת פתיחה
                                        </span>
                                    }
                                    <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="hideElement('OrderApproveDiv');showElement('orderActionsDiv');">ביטול</button>
                                    <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="AjaxActions('VerifyOrder', '@order.serial', '', 'VerifyOrderForm',document.getElementById('is_welcome_msg').checked);">אישור ההזמנה</button>
                                </span>


                            </center>
                        </form>
                    </div>


                </div>
            }



            <div style="overflow:auto;background-color:#e3e3e3;padding:5px;margin:5px;text-align:right;">

                <div style="overflow:auto">
                    <span onclick="Accordionize('addNoteAcc');" style="padding:5px;margin:5px;float:left;text-align:right;direction:rtl;border:1px solid #000;font-size:14px;background-color:#fff">
                        הערה חדשה
                    </span>
                    <span style="margin:5px;float:left;text-align:right;direction:rtl;border:1px solid #000;font-size:14px;background-color:#fff">
                        <input type="color" id="colorpicker" value="@board_color" onchange="AjaxActions('SetOrderBoardColor', '@order.serial', '', this.value,'@order.serial');">
                    </span>


                    <span style="padding:5px;margin:5px;float:left;text-align:right;direction:rtl;border:1px solid #000;font-size:14px;background-color:#fff">
                        <input type="checkbox" @if (is_processed) { <text> checked </text> } onclick="AjaxActions('SetOrderActiveState', '@order.serial', '', this.checked,'@order.serial');" /> טופל?

                    </span>



                    <h2>
                        הערות להזמנה
                    </h2>
                </div>
                <div style="overflow:auto">
                    <button class="Accordion" style="display:none" id="addNoteAcc"></button>
                    <div class="panel">
                        <div style="overflow:auto;background-color:#e3e3e3;padding:5px;margin:5px;text-align:right;">
                            <form id="orderNotesForm">
                                <input type="hidden" name="notes_order_id" id="notes_order_id" value="@order.serial" />
                                <textarea id="order_note" name="order_note" style="padding: 5px; margin: 5px;resize:none;font-size:16px;width:90%;text-align:right" rows="4" placeholder="נא להכניס הערה.."></textarea>
                                <button type="button" style="float:left;padding:5px;margin:5px;font-size:16px;" onclick="AjaxActions('WriteOrderComment','','','orderNotesForm','@order.serial');">שמירה</button>
                            </form>
                        </div>

                    </div>
                </div>

                @if (orderNotes.Count() > 0)
                {
                    foreach (var note in orderNotes)
                    {<div style="overflow:auto;padding:5px;background-color:white;border-bottom:1px dotted #b200ff">
                            <div style="overflow:auto;font-size:12px;float:right;">
                                @AppFunctions.GetRepName(note.rep_id) כתב.ה<br />@note.ts.ToShortDateString() @note.ts.ToString("HH:mm")
                            </div>
                            <div style="overflow:auto;font-size:16px;float:right;margin-right:20px;">
                                @note.order_note
                            </div>


                        </div>
                    }
                }
                else
                {
                    <div style="overflow:auto;font-size:16px;color:red">-= אין הערות להזמנה =-</div>
                }


            </div>
            @if (m_id != 0)
            {

                sqlSelect = "SELECT count(*) AS the_cnt FROM Mhistory WHERE m_id=@0";
                var ordHistory = op_data.QuerySingle(sqlSelect, m_id);
                int orders_count = 0; try { orders_count = ordHistory.the_cnt; } catch { }
                sqlSelect = "SELECT * FROM Mhistory WHERE m_id=@0 ORDER BY ts DESC";
                ordHistory = op_data.Query(sqlSelect, m_id);



                <div style="overflow:auto;padding:5px;margin:5px;text-align:right;">
                    <h2>
                        היסטורית הזמנות
                        <span style="padding:5px;margin:5px;font-size:14px;color:#b200ff">( @orders_count הזמנות )</span>
                    </h2>

                    @foreach (var old_order in ordHistory)
                    {
                        <div style="overflow: auto;  text-align: right; padding: 5px; margin: 5px;border-bottom:1px dotted #b200ff">
                            <div style="font-size:16px;float:right;padding:5px;margin:5px">
                                @old_order.ts.ToShortDateString()
                            </div>
                            <div style="font-size:16px;float:right;padding:5px;margin:5px">
                                @old_order.ship_city
                            </div>
                            <div style="font-size:16px;float:right;padding:5px;margin:5px">
                                @AppFunctions.GetRoundTitleById(old_order.round_id)
                            </div>
                        </div>
                    }


                </div>
            }
        </div>


    }


    op_data.Close();
}

@helper FeedBackManager(string showWhat = "NEW")
{
    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;
    string srchTitle = "";


    int newMembersCount = 0;

    //DataFunctions.ImportWebContactForm();



    switch (showWhat)
    {
        case "NEW":
            sqlSelect = "SELECT top(100) * FROM OrderFeedback WHERE status_code='NEW' order by serial DESC";
            srchTitle = " משובים חדשים";
            break;
        case "INWORK":
            sqlSelect = "SELECT top(100) * FROM OrderFeedback WHERE status_code='INWORK' order by serial DESC";
            srchTitle = " משובים בטיפול";
            break;
        case "COMPLETE":
            sqlSelect = "SELECT top(100) * FROM OrderFeedback WHERE status_code='COMPLETE' order by complete_ts DESC";
            srchTitle = " משובים שטופלו";
            break;
    }

    var Feedbacks = op_data.Query(sqlSelect);

    //srchTitle = " משובים";
    op_data.Close();


    int DefaultWelcomeMsg = 0;
    try { DefaultWelcomeMsg = Convert.ToInt32(Request["DefaultMembersWelcomeMsgTemplate"]); } catch { }



    <div style="overflow: auto;padding: 5px;">
        <select style="float:left;padding:5px;margin:5px;font-size:16px;" onchange="PageNavigator('FEEDBACKMANAGER',this.value);">
            <option value="NEW" @if (showWhat == "NEW") { <text> selected</text>}>משובים חדשים</option>
            <option value="INWORK" @if (showWhat == "INWORK") { <text> selected</text>}>משובים בטיפול</option>
            <option value="COMPLETE" @if (showWhat == "COMPLETE") { <text> selected</text>}>משובים שטופלו</option>
        </select>
        <h2 style="float:right;direction:rtl">
            @srchTitle
        </h2>
    </div>



    <div style="overflow: auto;">
        @foreach (var fb in Feedbacks)
        {
            string member_name = fb.nick_name;
            string provided_wanum = fb.wanum;
            string member_wanum = provided_wanum;
            int m_id = fb.u_id;
            int pb_id = 0;

            int fb_id = fb.serial;
            int is_ok_weight = fb.is_ok_weight;
            int is_happy = fb.is_happy;
            bool is_contact = fb.is_contact;
            DateTime create_ts = fb.ts;
            int DaysSinceContactInt = 0;
            int round_id = fb.menu_id;
            bool is_completed = fb.is_completed;
            string board_color = fb.board_color;
            bool is_reverse_lookup = false;
            sqlSelect = "SELECT member_name,wanum,create_ts,m_id,serial FROM pb WHERE wanum=@0";
            var pbEntry = op_data.QuerySingle(sqlSelect, provided_wanum);
            if (pbEntry != null)
            {
                member_name = pbEntry.member_name;
                member_wanum = pbEntry.wanum;
                m_id = pbEntry.m_id;
                pb_id = pbEntry.serial;
            }
            else
            {
                sqlSelect = "SELECT member_name,wanum,create_ts,m_id,serial FROM pb WHERE member_name=@0";
                pbEntry = op_data.QuerySingle(sqlSelect, member_name);
                if (pbEntry != null)
                {
                    member_name = pbEntry.member_name;
                    member_wanum = pbEntry.wanum;
                    m_id = pbEntry.m_id;
                    pb_id = pbEntry.serial;
                    is_reverse_lookup = true;
                }
            }

            DaysSinceContactInt = AppFunctions.HowManyDaysAgoWas(create_ts);



            string recognition_icon = "❌";

            if (m_id > 0)
            {
                recognition_icon = "✅";
            }
            if (is_reverse_lookup)
            {
                recognition_icon = "🤔";
            }

            <div class="ListRow" style="overflow:auto;background-color:@board_color" id="entry_@fb.serial">
                <div>
                    <div class="ListCell" style="float: right;width:50px;">
                        @recognition_icon


                    </div>



                    <div class="ListCell" style="float: right;">
                        <div style="overflow:auto;color:#000">
                            <b>@member_name</b>
                            @if (fb.nick_name != "" && fb.nick_name != member_name)
                            {<span style="color: #808080;font-size: 12px;">(@fb.nick_name)</span>}
                        </div>
                        <div style="color: #b200ff; font-size: 12px; overflow: auto">
                            🗓️ @create_ts.ToShortDateString() @create_ts.ToString("HH:mm")  (לפני @DaysSinceContactInt ימים)
                        </div>
                        <div style="color: #000; font-size: 14px; overflow: auto">
