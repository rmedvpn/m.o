@helper CreditHistory(string showWhat = "NEW")
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime default_date = Convert.ToDateTime("1/1/1900");

    DateTime ts = local_time;
    string srchTitle = "";
    int currMemberId = 0;

    int newMembersCount = 0;

    //DataFunctions.ImportWebContactForm();


    sqlSelect = "SELECT SUM(amount) as TotalDebt FROM chargebook WHERE is_paid=1 AND is_cancelled=0";
    var totDebt = op_data.QuerySingle(sqlSelect);
    decimal totalDebt = 0; try { totalDebt = totDebt.TotalDebt; } catch { }
    sqlSelect = "SELECT SUM(amount_due) as DueDebt FROM chargebook WHERE is_paid=0 AND current_due_date<=@0";
    var dueDebt = op_data.QuerySingle(sqlSelect, local_time);
    decimal DueDebt = 0; try { DueDebt = dueDebt.DueDebt; } catch { }
    sqlSelect = "SELECT * FROM chargebook WHERE is_paid=1 order by payment_ts DESC";
    var transactions = op_data.Query(sqlSelect);



    srchTitle = " היסטורית חובות";

    <div style="overflow: auto;padding: 5px;">
        <div style="float: left; padding: 5px; margin: 5px; font-size: 12px; border: 2px solid #b200ff; text-align: center; border-radius: 5px " onclick="PageNavigator('CREDIT');">
            <span style="font-size:18px;">הווה</span><br />חובות פתוחים
        </div>

        <div style="float: left; padding: 5px; margin: 5px; font-size: 12px; border: 2px solid #808080; text-align: center; border-radius: 5px ">
            <span style="font-size:18px;">@totalDebt.ToString("C", culture)</span><br />סה"כ חובות ששולמו
        </div>

        <h2 style="float:right;direction:rtl">
            @srchTitle
        </h2>

    </div>



    <div style="overflow: auto;" id="DebtsStatusDiv">


        <table style="width:99%;direction:rtl">
            <tr class="ListRow" style="width: 100%;">
                <td class="TableCell">שם חבר.ה</td>
                <td class="TableCell">סכום חוב</td>
                <td class="TableCell">תאריך נטילה</td>
                <td class="TableCell">תאריך פרעון</td>
                <td class="TableCell">תאריך תשלום</td>
            </tr>



            @foreach (var entry in transactions)
            {
                int member_id = entry.m_id;
                string member_name = ""; member_name = AppFunctions.GetMemberNameById(entry.m_id);
                decimal debt = entry.amount;
                DateTime due_date = default_date;
                DateTime payment_ts = default_date;
                DateTime credit_ts = default_date;
                try { due_date = entry.original_due_date; } catch { }
                try { payment_ts = entry.payment_ts; } catch { }
                try { credit_ts = entry.credit_ts; } catch { }
                bool is_cancelled = false; try { is_cancelled = entry.is_cancelled; } catch { }
                string tblClass = "TableCell";
                if (is_cancelled) { tblClass = "cancelledRow"; }


                <tr id="CreditEntryRow_@entry.m_id">


                    <td class="TableCell">
                        <div style="overflow:auto;color:#000">
                            <button type="button" style="margin-left: 5px; font-size: 16px;float:right;border:0 " onclick="sbload('MainSb', 'Caller?p1=Member_Info&p2=@entry.m_id');">👤</button>

                            <b>@member_name</b>

                        </div>
                    </td>

                    <td class="@tblClass">
                        <div style="overflow:auto;">
                            <b>@debt.ToString("C", culture) </b>


                        </div>

                    </td>
                    <td class="TableCell">
                        <div style="overflow:auto;color:#000">
                            <b>@credit_ts.ToShortDateString() </b>
                        </div>

                    </td>
                    <td class="TableCell">
                        <div style="overflow:auto;color:#000">
                            <b>@due_date.ToShortDateString() </b>
                        </div>

                    </td>
                    <td class="TableCell">
                        <div style="overflow:auto;color:#000">
                            @if (is_cancelled)
                            {

                                <span style="color:red;font-size:12px;">התנועה בוטלה ב<span>@entry.cancellation_ts.ToShortDateString()</span> ע"י @AppFunctions.GetRepName(entry.cancelled_by)</span><br />
                                <span style="color:#808080;font-size:12px;">@entry.cancellation_notes</span>
                            }
                            else
                            {
                                <b>@payment_ts.ToShortDateString() </b>
                            }
                        </div>

                    </td>
                </tr>








            }
        </table>

    </div>
    <div style="overflow: auto;height:200px;"> &nbsp; </div>

    op_data.Close();

}

@helper JOBAPPS(string showWhat = "NEW")
{
    int u_id = WebSecurity.CurrentUserId;
    string repTitle = "";
    var op_data = Database.Open("op_data");
    var m_join = Database.Open("m_join");
    var sqlSelect = "";
    string username = WebSecurity.CurrentUserName;
    DateTime local_time = AppFunctions.LocalTime();
    DateTime ts = local_time;
    string srchTitle = "";



    DataFunctions.ImportWebJobApps();

    //showWhat = "COMPLETED";
    sqlSelect = "SELECT * FROM jobapps order by ts DESC";
    srchTitle = " חיפוש עבודה - פניות";



    var formEntries = op_data.Query(sqlSelect);


    op_data.Close();
    m_join.Close();


    int DefaultWelcomeMsg = 0;
    try { DefaultWelcomeMsg = Convert.ToInt32(Request["DefaultMembersWelcomeMsgTemplate"]); } catch { }



    <div style="overflow: auto;padding: 5px;">


        <h2 style="float:right;direction:rtl">
            @srchTitle
        </h2>
    </div>



    <div style="overflow: auto;">
        @foreach (var entry in formEntries)
        {
            string member_name = entry.nick_name;
            string wanum = entry.wanum;
            int m_id = entry.m_id;
            string bgcolor = entry.bgcolor;
            string applyFor = entry.applyFor;
            DateTime create_ts = entry.ts;
            string city = entry.city;
            int DaysSinceContactInt = 0;
            int genderCode = entry.gender;
            string gender = "";
            switch (genderCode)
            {
                case 1:
                    gender = "בן";
                    break;

                case 2:
                    gender = "בת";
                    break;
            }
            if (m_id == 0)
            {
                sqlSelect = "SELECT member_name,wanum,create_ts,m_id,serial FROM pb WHERE wanum=@0";
                var pbEntry = op_data.QuerySingle(sqlSelect, wanum);
                if (pbEntry != null)
                {
                    member_name = pbEntry.member_name;
                    wanum = pbEntry.wanum;
                    m_id = pbEntry.m_id;
                }
            }


            DaysSinceContactInt = AppFunctions.HowManyDaysAgoWas(create_ts);

            applyFor = applyFor.Replace("##", " | ");
            applyFor = applyFor.Remove(applyFor.Length - 2, 2);
            string recognition_icon = "❌";

            if (m_id > 0)
            {
                recognition_icon = "✅";
            }


            <div class="ListRow" style="overflow:auto;background-color:@bgcolor" id="entry_@entry.serial">

                <div class="ListCell" style="float: right;width:30px;">
                    @recognition_icon
                </div>



                <div class="ListCell" style="float: right;">
                    <div style="overflow:auto;color:#000">
                        <b>@member_name</b> <span> @gender @entry.age </span> <span style="color:blue">@city</span>
                        @if (entry.nick_name != "" && entry.nick_name != member_name)
                        {<span style="color: #808080;font-size: 12px;">(@entry.nick_name)</span>}
                    </div>
                    <div style="color: #b200ff; font-size: 12px; overflow: auto">
                        🗓️ @create_ts.ToShortDateString() @create_ts.ToString("HH:mm")  (לפני @DaysSinceContactInt ימים)
                    </div>

                    <div style="color: #808080; font-size: 11px; overflow: auto">


                        @if (m_id > 0)
                        {
                            <span id="numRev_@entry.serial">
                                <button type="button" style="margin:2px;padding:2px;font-size:12px;float:right" onclick="RepAjaxUpdate('RevWanum', 'numRev_@entry.serial', '', '@m_id');">
                                    👁️
                                </button>
                            </span>
                        }
                        else
        {
                            <div style="overflow:auto"> @entry.wanum</div>
                        }

                        <span style="float:right;">
                            <input type="color" id="colorpicker" style="float: right; padding: 0; margin: 2px;width:20px;height:24px; " name="board_color" value="@bgcolor" onchange="AjaxActions('SetJobAppEntryColor', '@entry.serial', '', this.value,'@showWhat');">
                        </span>

                        <button type="button" style="margin:2px;padding:2px;font-size:12px;float:right" onclick="waLaunch('@entry.wanum');">
                            💬 ווטסאפ
                        </button>
                        @if (m_id > 0)
                        {
                            <button type="button" style="margin:2px;padding:2px;font-size:12px;float:right" onclick="sbload('MainSb', 'Caller?p1=Member_Info&p2=@m_id');">
                                👤 כרטיס
                            </button>
                        }

                        <span style="display:none">בקשת עבודה #@entry.serial</span>
                    </div>
                </div>


                <div class="ListCell" style="float: right;width:40%;">
                    <div style="overflow:auto;color:#000"><b>@applyFor </b></div>
                    <span style="color: #808080;font-size: 12px;">
                        <span style="color:#57d600">@entry.occupation</span>
                        <span style="color:#808080">@entry.experience</span>
                        <span  style="color:blue">@entry.added_value</span>



                    </span>

                </div>










            </div>
        }
    </div>
    <div style="overflow: auto;height:200px;"> &nbsp; </div>

}
