                        <input type="text" style="padding:5px;margin:5px;font-size:16px" name="ship_phone" />
                    </div>
                </div>
                <div style="overflow:auto;">
                    <div style="overflow:auto;">
                        כתובת<br />
                        <input type="text" style="padding:5px;margin:5px;font-size:16px" name="address" />
                    </div>
                    <div style="overflow:auto;">
                        עיר<br />
                        <input type="text" style="padding:5px;margin:5px;font-size:16px" name="city" />
                    </div>
                </div>

                <div style="overflow:auto;">
                    פירוט הזמנה<br />
                    <textarea style="padding:5px;margin:5px;font-size:16px;resize:none;" rows="6" name="order_body"></textarea>

                </div>
                <div style="overflow:auto;">
                    תרומה<br />
                    <input type="text" style="padding:5px;margin:5px;font-size:16px" name="donation" />
                </div>
                <div style="overflow:auto;"></div>
                <div style="overflow:auto;"></div>

                <div style="overflow: auto; padding: 5px; margin: 5px;text-align:center">

                    <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="controller.close('MainSb');">ביטול</button>
                    <button type="button" style="padding:5px;margin:5px;font-size:16px;" onclick="AjaxActions('RepInsertOrder','','','NewOrder','');">שמירת שינויים</button>
                </div>
            </form>
        </div>
        <div style="overflow:auto;height:100px">&nbsp;</div>

    </center>

    // m_join.Close();

    op_data.Close();

