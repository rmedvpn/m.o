
@helper ContactResponse(int contact_entry_id, int member_id = 0, string wanum = "", string reachout_type = "")
{

    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    var op_data = Database.Open("op_data");
    var sqlSelect = "";
    DateTime LocalTime = AppFunctions.LocalTime();
    DataFunctions.WriteDebugLine(reachout_type + "-" + member_id.ToString());

    string msgType = "";

    int template_id = 0;
    string contact_name = "";

    bool isMember = false;
    bool cus_refresh = false;

    int contactFormEntriesCnt = 0;

    bool is_prospect = false;
    bool is_prospect_msg = false;

    bool is_approved_prospect = false;
    DateTime approval_ts = Convert.ToDateTime("1/1/1900");

    int prospect_id = 0;
    bool is_contact_requests = false;

    if (reachout_type == "PROSPECTMSG")
    {
        prospect_id = member_id;
        member_id = 0;
        is_prospect_msg = true;
        is_prospect = true;
        sqlSelect = "SELECT * FROM webprospects WHERE serial=@0";
        var prospectMsg = op_data.QuerySingle(sqlSelect, prospect_id);
        try { wanum = prospectMsg.wanum; } catch { }
        try { contact_name = prospectMsg.prospect_name; } catch { }
    }

    DataFunctions.WriteDebugLine(prospect_id.ToString() + "-" + member_id.ToString());


    if (contact_entry_id > 0)
    {
        sqlSelect = "SELECT * FROM contactform WHERE serial=@0";
        var contact_entry = op_data.QuerySingle(sqlSelect, contact_entry_id);
        if (contact_entry != null)
        {
            member_id = contact_entry.m_id;
            wanum = contact_entry.wanum;
            sqlSelect = "SELECT COUNT(*) AS the_cnt FROM contactform WHERE wanum=@0";
            var contactFormEntries = op_data.QuerySingle(sqlSelect, wanum);
            try { contactFormEntriesCnt = contactFormEntries.the_cnt; } catch { }
            cus_refresh = contact_entry.cus_refresh;
            try { contact_name = contact_entry.nick_name; } catch { }
            is_contact_requests = true;
        }
    }




    if (member_id == 0)
    {
        sqlSelect = "SELECT * FROM pb WHERE wanum=@0";
        var pbEntry = op_data.QuerySingle(sqlSelect, wanum);
        if (pbEntry != null)
        {
            member_id = pbEntry.m_id;
        }
    }



    if (member_id > 0)
    {
        sqlSelect = "select * from pb WHERE m_id=@0";
        var memberRs = op_data.QuerySingle(sqlSelect, member_id);
        if (memberRs != null)
        {
            isMember = true;

            wanum = memberRs.wanum;
            contact_name = memberRs.member_name;
            DateTime tss = LocalTime;

            if (reachout_type == "")
            {
                reachout_type = "MEMBERCONTACT";
            }
        }
    }
    else
    {
        if (reachout_type == "")
        {
            reachout_type = "NONMEMBERCONTACT";
        }


    }

    if (reachout_type == "REFRESHMSG")
    {
        cus_refresh = true;
    }

    switch (reachout_type)
    {
        case "MEMBERWELCOME":
            try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultMembersWelcomeMsgTemplate")); } catch { }
            break;
        case "ORDERWELCOME":
            try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultOrderWelcomeMsgTemplate")); } catch { }
            break;


        case "MEMBERCONTACT":
        case "REFRESHMSG":
            if (cus_refresh) { try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultInfoReminderMsgTemplate-HE")); } catch { } }
            else { try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultMemberContactMsgTemplate")); } catch { } }
            break;

        case "NONMEMBERCONTACT":
            try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultNonMemberContactMsgTemplate")); } catch { }
            break;

        case "PROSPECTMSG":
            try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultWebProspectsMsgTemplate")); } catch { }

            break;

        default:
            if (isMember) { try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultMemberContactMsgTemplate")); } catch { } }
            else { try { template_id = Convert.ToInt32(AppFunctions.GetAppProperty("DefaultNonMemberContactMsgTemplate")); } catch { } }
            break;

    }

    DataFunctions.WriteDebugLine(prospect_id.ToString() + "-$!" + template_id.ToString());


    if (template_id > 0)
    {
        sqlSelect = "SELECT * FROM msgTemplates WHERE id=@0";
        var msgTemplate = op_data.QuerySingle(sqlSelect, template_id);
        try { msgType = msgTemplate.msgType; } catch { }
    }


    if (!is_prospect_msg)
    {
        sqlSelect = "SELECT * FROM PROSPECTS WHERE wanum=@0";
        var prospect = op_data.QuerySingle(sqlSelect, wanum);
        if (prospect != null)
        {
            is_prospect = true;
            prospect_id = prospect.serial;
            if (contact_name == "")
            {
                contact_name = prospect.prospect_name;
            }
            if (wanum.IsEmpty())
            {
                wanum = prospect.wanum;
            }
        }
        else
        {
            sqlSelect = "SELECT * FROM WEBPROSPECTS WHERE wanum=@0";
            prospect = op_data.QuerySingle(sqlSelect, wanum);
            if (prospect != null)
            {
                is_prospect = true;
                prospect_id = prospect.serial;
                if (contact_name == "")
                {
                    contact_name = prospect.prospect_name;
                }
                if (wanum.IsEmpty())
                {
                    wanum = prospect.wanum;
                }
                is_approved_prospect = prospect.is_approved;
                try { approval_ts = prospect.approval_ts; } catch { }
            }
        }
    }

    try { wanum = AppFunctions.wanumize(wanum); } catch { }

    string wanum_mask = ""; try { wanum_mask = "***" + wanum.Substring(wanum.Length - 4); } catch { }


    if (contact_name == "")
    {
        contact_name = wanum;
    }

    <div style="overflow: auto;font-weight: bold;font-size: 24px;padding: 5px;">
        <button class="closeSideBar" onclick="controller.close('MainSb');">❎</button>
        שליחת הודעה ל<span>@contact_name</span>

        @if (!isMember)
        {
            <span style="float:left;background-color:yellow;color:red;padding:5px;">משתמש לא רשום</span>

        }
        @if (cus_refresh && isMember)
        {
            <span style="float:left;background-color:#57d600;color:#fff;padding:5px;">נדרשת הודעת רענון</span>

        }
        @if (is_prospect)
        {
            <span style="float:left;background-color:#b200ff;color:#fff;padding:5px;">קיימת בקשת הצטרפות פתוחה!</span>

        }
    </div>

    if (isMember)
    {
        <div style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080;">
            <div class="formSectionSep"></div>
            <div>@ContactCenter.MemberInfo(member_id)</div>
        </div>

    }

    if (is_prospect)
    {
        <div style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080;">
            <div class="formSectionSep"></div>
            <div>@ContactCenter.ProspectPreview(prospect_id)</div>
        </div>
    }

    if (is_contact_requests)
    {
        <div style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080;">
            <div class="formSectionSep"></div>
            <div>@ContactCenter.ContactEntries(member_id, wanum)</div>
        </div>
    }


    <center>
        <div style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080;">
            <div class="formSectionSep"></div>


            <div class="formSection">

                <div style="overflow: auto;padding:10px;margin:5px;" id="MsgTemplatesDiv">
                    @ContactCenter.MessageSender(member_id, template_id, contact_entry_id, prospect_id, reachout_type)
                </div>
            </div>
            <form id="MsgSettingsFrm">
                <div class="formSection">

                    @switch (reachout_type)
                    {
                        case "MEMBERWELCOME":
                            <div style="overflow:auto;padding:5px;margin:5px;text-align:right" id="SendMsgActionSpan">
                                <textarea style="width:75%;font-size:16px;resize:none;" name="contact_notes" placeholder="הערות לטיפול.."></textarea>

                                <div style="overflow:auto;padding:5px;margin:5px;">



                                    <div id="ActionBtnDiv" style="float:left">

                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="copyTextAreaToClipBoard('tb_cb'); waLaunch('@wanum'); hideElement('SendMsgActionSpan'); showElement('afterSendDiv'); AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','WELCOMEMSG');">שליחת הודעת ברוכים הבאים ל<span>@contact_name</span></button>
                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="CancelMsgBtn" onclick="AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','DELWELCOMEMSG','1');controller.close('MainSb')">מחיקת התזכורת</button>

                                    </div>
                                </div>



                            </div>
                            <input type="hidden" name="member_id" id="member_id" value="@member_id" />
                            <input type="hidden" name="entry_id" id="entry_id" value="@contact_entry_id" />
                            <input type="hidden" name="reachout_type" id="reachout_type" value="@reachout_type" />

                            break;
                        case "REFRESHMSG":
                            <div style="overflow:auto;padding:5px;margin:5px;text-align:right" id="SendMsgActionSpan">
                                <textarea style="width:75%;font-size:16px;resize:none;" name="contact_notes" placeholder="הערות לטיפול.."></textarea>

                                <div style="overflow:auto;padding:5px;margin:5px;">



                                    <div id="ActionBtnDiv" style="float:left">

                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="copyTextAreaToClipBoard('tb_cb'); waLaunch('@wanum'); hideElement('SendMsgActionSpan'); showElement('afterSendDiv'); AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','PROSPECTREFRESHMSG');">שליחת הודעת לקוח חוזר ל<span>@contact_name</span></button>
                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="CancelMsgBtn" onclick="AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','DELPROSPECTREFRESHMSG');controller.close('MainSb')">סגירת בקשת הצטרפות</button>

                                    </div>
                                </div>



                            </div>
                            <input type="hidden" name="member_id" id="member_id" value="@member_id" />
                            <input type="hidden" name="entry_id" id="entry_id" value="@contact_entry_id" />
                            <input type="hidden" name="reachout_type" id="reachout_type" value="@reachout_type" />

                            break;
                        case "ORDERWELCOME":

                            <div style="overflow:auto;padding:5px;margin:5px;text-align:right" id="SendMsgActionSpan">
                                <textarea style="width:75%;font-size:16px;resize:none;" name="contact_notes" placeholder="הערות לטיפול.."></textarea>

                                <div style="overflow:auto;padding:5px;margin:5px;">



                                    <div id="ActionBtnDiv" style="float:left">

                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="copyTextAreaToClipBoard('tb_cb'); waLaunch('@wanum'); hideElement('SendMsgActionSpan'); showElement('afterSendDiv'); AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','ORDERWELCOMEMSG');">שליחת הודעת הזמנה ראשונה ל<span>@contact_name</span></button>
                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="CancelMsgBtn" onclick="AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','DELWELCOMEMSG','1');controller.close('MainSb')">לא משנה</button>




                                    </div>
                                </div>



                            </div>
                            <input type="hidden" name="member_id" id="member_id" value="@member_id" />
                            <input type="hidden" name="entry_id" id="entry_id" value="@contact_entry_id" />
                            <input type="hidden" name="reachout_type" id="reachout_type" value="@reachout_type" />

                            break;
                        case "PROSPECTMSG":

                            <div style="overflow:auto;padding:5px;margin:5px;text-align:right" id="SendMsgActionSpan">
                                <textarea style="width:75%;font-size:16px;resize:none;" name="contact_notes" placeholder="הערות לטיפול.."></textarea>

                                <div style="overflow:auto;padding:5px;margin:5px;">



                                    <div id="ActionBtnDiv" style="float:left">

                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="copyTextAreaToClipBoard('tb_cb'); waLaunch('@wanum'); hideElement('SendMsgActionSpan'); showElement('afterSendDiv'); AjaxActions('WEPROSPECTMSGSENT', '@prospect_id', '', '');">שליחת הודעה ל<span>@contact_name</span></button>
                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="CancelMsgBtn" onclick="AjaxActions('SENDMSG', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','DELWELCOMEMSG','1');controller.close('MainSb')">לא צריך, אפשר למחוק את התזכורת</button>




                                    </div>
                                </div>



                            </div>
                            <input type="hidden" name="member_id" id="member_id" value="@member_id" />
                            <input type="hidden" name="prospect_id" id="prospect_id" value="@prospect_id" />
                            <input type="hidden" name="entry_id" id="entry_id" value="@contact_entry_id" />
                            <input type="hidden" name="reachout_type" id="reachout_type" value="@reachout_type" />

                            break;
                        default:
                            <div style="overflow:auto;padding:5px;margin:5px;text-align:right" id="SendMsgActionSpan">
                                <textarea style="width:75%;font-size:16px;resize:none;" name="contact_notes" placeholder="הערות לטיפול.."></textarea>

                                <div style="overflow:auto;padding:5px;margin:5px;">

                                    <span style="float:right;padding:5px;margin:5px;">
                                        <input type="checkbox" name="is_ok_to_close" id="is_ok_to_close" checked /> הפניה טופלה
                                    </span>
                                    @if (contactFormEntriesCnt > 1)
                                    {
                                        <span style="float: right; padding: 5px; margin: 5px; ">
                                            <input type="checkbox" name="close_all_entries" id="close_all_entries" checked /> לסגור את כל הפניות למספר זה
                                        </span>
                                    }

                                    <div id="ActionBtnDiv" style="float:left">
                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="copyTextAreaToClipBoard('tb_cb'); waLaunch('@wanum'); hideElement('SendMsgActionSpan'); showElement('afterSendDiv'); AjaxActions('CONTACTRESPONSE', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm');">שליחת הודעה ל<span>@contact_name</span></button>
                                        <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="AjaxActions('CONTACTRESPONSE', document.getElementById('tb_cb').value, '', 'MsgSettingsFrm','1');controller.close('MainSb')">מחיקת פניה</button>


                                        @if (!isMember)
                                        {
                                            <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="hideElement('ActionBtnDiv'); showElement('FastRegisterBtnDiv');">רישום למערכת</button>
                                        }

                                    </div>



                                </div>



                            </div>
                            <input type="hidden" name="member_id" id="member_id" value="@member_id" />
                            <input type="hidden" name="entry_id" id="entry_id" value="@contact_entry_id" />
                            <input type="hidden" name="reachout_type" id="reachout_type" value="@reachout_type" />

                            break;

                    }






                    <center>
                        <div style="overflow:auto;display:none;width:80%" id="afterSendDiv">
                            <div style="padding: 5px; margin: 5px; text-align: center; background-color: #fff; border: 1px dashed #808080; color: #000;">
                                <div style="overflow: auto; padding: 5px; margin: 5px;"><b>⚠️ <span style="background-color:yellow">בבקשה לשים ❤️ </span> המערכת רשמה את שליחת ההודעה, נא לוודא שההודעה אכן הודבקה בווטסאפ ונשלחה ל<span>@contact_name</span>!</b></div>
                                <button type="button" style="font-size: 16px; text-align: center; color: #fff; background-color: #57d600; border: 2px solid #fff; padding: 5px; margin: 5px; font-weight: bold" onclick="controller.close('MainSb')">סגירה</button>
                                <button type="button" style="font-size: 16px; text-align: center; color: #fff; background-color: #808080; border: 2px solid #fff; padding: 5px; margin: 5px; font-weight: bold" onclick="copyTextAreaToClipBoard('tb_cb'); waLaunch('@wanum');">לשלוח שוב</button>

                                @if (is_prospect)
                                {
                                    <button type="button" style="font-size: 16px; text-align: center; color: #fff; background-color: #ff0000; border: 2px solid #fff; padding: 5px; margin: 5px; font-weight: bold" onclick=" AjaxActions('WEBPROSPECTBADWANUM', '@prospect_id', '', '');">סימון המספר @wanum_mask לא תקין</button>
                                    <button type="button" style="font-size: 16px;text-align: center;padding: 5px;margin: 5px;font-weight: bold;float:left" id="SendMsgBtn" onclick="hideElement('afterSendDiv'); showElement('FastRegisterBtnDiv');">רישום למערכת</button>




                                }


                            </div>

                        </div>

                        <div id="FastRegisterBtnDiv" style="display:none;float:left;overflow:auto">
                            <span style="float:right;font-size:12px;">לרישום מהיר נא להכניס פרטים</span>
                            <input type="text" placeholder="כינוי" style="padding:5px;margin:5px;font-size:16px;float:right" value="@contact_name" name="selectedNick" id="selectedNick" />
                            <input type="text" placeholder="ווטסאפ" style="padding:5px;margin:5px;font-size:16px;float:right" value="@wanum" name="NumberToRegister" id="NumberToRegister" />
                            <button type="button" style="font-size: 16px; text-align: center; padding: 5px; margin: 5px; font-weight: bold; float: right" id="SendMsgBtn" onclick="AjaxActions('RegisterNewMember', '', '', 'MsgSettingsFrm','@contact_entry_id','@reachout_type');">רישום למערכת</button>
                            <button type="button" style="font-size: 16px; text-align: center; padding: 5px; margin: 5px; font-weight: bold; float: right" id="SendMsgBtn" onclick="showElement('afterSendDiv'); hideElement('FastRegisterBtnDiv');">ביטול</button>
                        </div>


                    </center>
                    <span style="display:none">https://api.whatsapp.com/send?phone=@wanum</span>
                </div>
            </form>

            <div style="overflow: auto;height: 200px;">&nbsp;</div>
        </div>
    </center>







    op_data.Close();
}

@helper MemberInfo(int member_id)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var op_data = Database.Open("op_data");
var sqlSelect = "";
int rep_id = WebSecurity.CurrentUserId;
string rep_name = AppFunctions.GetRepName(rep_id);
DateTime local_time = AppFunctions.LocalTime();
DateTime default_time = Convert.ToDateTime("1/1/1900");
sqlSelect = "SELECT * FROM pb WHERE m_id=@0";
var pbEntry = op_data.QuerySingle(sqlSelect, member_id);

if (pbEntry != null)
{
    sqlSelect = "SELECT * FROM u_stats WHERE serial=@0";
    var member = op_data.QuerySingle(sqlSelect, member_id);
    sqlSelect = "SELECT * FROM OStats WHERE m_id=@0 ORDER BY ts DESC";
    var orders = op_data.Query(sqlSelect, member_id);
    sqlSelect = "SELECT * FROM usernotes WHERE m_id=@0 ORDER BY ts DESC";
    var usernotes = op_data.Query(sqlSelect, member_id);
    sqlSelect = "SELECT * FROM appservicesarea WHERE is_active=1";
    var ServiceAreas = op_data.Query(sqlSelect);

    DateTime birth_date = default_time;
    try { birth_date = pbEntry.birth_date; } catch { }

    int notes_count = 0; try { notes_count = usernotes.Count(); } catch { }
    int orders_count = 0; try { orders_count = pbEntry.oc; } catch { }
    int area_id = 0; try { area_id = pbEntry.def_area; } catch { }
    DateTime last_order_ts = local_time; try { last_order_ts = pbEntry.lo; } catch { }
    int DaysSinceLastOrder = 0; try { DaysSinceLastOrder = AppFunctions.HowManyDaysAgoWas(last_order_ts); } catch { }

    int DaysSinceJoinInt = 0;
    DaysSinceJoinInt = AppFunctions.HowManyDaysAgoWas(member.first_order_ts);
    DateTime zeroTime = new DateTime(1, 1, 1);
    TimeSpan span = local_time - birth_date;
    int age = 0; try { age = (zeroTime + span).Year - 1; } catch { }
    string member_wanum = pbEntry.wanum;
    string display_wanum = member_wanum.Substring(member_wanum.Length - 4) + "****";
    string member_name = pbEntry.member_name;
    bool is_blocked = false; try { is_blocked = pbEntry.is_blocked; } catch { }
    bool is_deleted = false; try { is_deleted = pbEntry.is_deleted; } catch { }
    bool is_credit = false; try { is_credit = pbEntry.is_credit; } catch { }
    bool is_credit_blocked = false; try { is_credit_blocked = pbEntry.is_credit_blocked; } catch { }


    decimal debt = pbEntry.debt;
    decimal credit_limit=pbEntry.credit_limit; 
    DateTime debt_due_date = default_time; try { debt_due_date = pbEntry.due_Date; } catch { }
    DateTime due_date = local_time.AddDays(14);


        <div style="overflow: auto;-webkit-overflow-scrolling: touch;background-color:#808080;">
            <center>

                <div class="formSectionSep"></div>
                <div class="formSection">

                    <h3>
                        <button type="button" style="padding: 2px; margin: 2px; font-size: 16px; float: left" onclick="waLaunch('@pbEntry.wanum');">ווטסאפ</button>
                        <button style="padding:2px;margin:2px;font-size:16px;float:left" onclick="Accordionize('EditInfoAcc');">עריכה</button>
                        <button style="padding:2px;margin:2px;font-size:16px;float:right" onclick="Accordionize('CreditInfoAcc');">קרדיט</button>
                        <button style="padding:2px;margin:2px;font-size:16px;float:right" onclick="Accordionize('DiscountsInfoAcc');">הנחות</button>

                        👤 פרטי חבר.ה #@member_id

                    </h3>

                    @if (is_deleted)
                    {
                        <div style="background-color:#e3e3e3;color:#808080;font-size:22px;padding:5px;margin:5px;overflow:auto;text-align:center">
                            <span><b>המשתמש נמחק!</b></span>
                        </div>

                    }
                    @if (is_blocked)
                    {
                        <div style="background-color:red;color:yellow;font-size:22px;padding:5px;margin:5px;overflow:auto;text-align:center">
                            <span><b>המשתמש חסום!</b></span>
                        </div>

                    }
                <div class="ProspectListRow">

                    <div class="ProspcetListCell">
                        <span class="ProspcetListCellHeader">שם<br></span>@pbEntry.member_name
                    </div>
                    <div class="ProspcetListCell">
                        <span class="ProspcetListCellHeader">גיל<br></span>@age
                    </div>
                    <div class="ProspcetListCell">
                        <span class="ProspcetListCellHeader">ווטסאפ<br></span>@display_wanum
                    </div>
