                                <div style="overflow:auto;">
                                    <textarea style="padding:5px;margin:5px;font-size:16px;resize:none;width:80%;float:right" placeholder="נא לרשום הערה.." name="usernote" id="usernote"></textarea>
                                    <span style="float:right">
                                        <input type="checkbox" style="padding: 5px; margin: 5px; float: right" name="is_important" id="is_important" /> חשוב?<br />
                                        <button type="button" style="padding: 5px; margin: 5px; font-size: 16px; float: right " onclick="AjaxActions('WRITEUSERNOTE', document.getElementById('usernote').value, '', 'NoteAddForm','@member_id');">שמירה</button>
                                    </span>

                                </div>
                            </form>
                        </div>
                        @if (notes_count > 0)
                        {
