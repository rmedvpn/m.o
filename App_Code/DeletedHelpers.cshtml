@helper FinalDelete()
{


    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    string PageTitle = "";

    var db = Database.Open("irgoon");
    var sqlSelect = "";
    sqlSelect = "select * from deletedUsers where pb_deleted=0 order by serial DESC";
    var deletedUsers = db.Query(sqlSelect);
    db.Close();

    <div style="overflow: auto;font-weight: bold;font-size: 30px;padding: 5px;">
        מחיקה סופית של משתמשים
    </div>
    <div style="overflow: auto;font-size: 16px;color: #000;padding: 0;font-weight: normal;background-color: #ffffcc;border: 2px solid #f00;padding: 5px;margin: 5px">
        👈 נא למחוק את היוזר מספר הטלפונים במכשיר עצמו לפני  המחיקה
    </div>

    <div style="overflow: auto;-webkit-overflow-scrolling: touch;width: 100%;height: 100%;">
        @foreach (var deletedUser in deletedUsers)
        {
            <div style="overflow: auto;padding: 5px;font-size: 18px;border-bottom: 1px solid #808080" id="prospect_@deletedUser.serial">
                <div style="float: right">@deletedUser.pbname<br><span style="font-size: 16px;color: #b200ff">@deletedUser.wanum</span></div>
                <button type="button" style="float: left;background-color: #f00;color: #fff;padding: 5px;margin: 5px;font-size: 16px;font-weight: bold" onclick="AjaxActions('FINALDELETEMEMBER',@deletedUser.serial,1);">מחיקה</button>

            </div>
        }




        <div style="overflow: auto;height: 200px;">&nbsp;</div>
    </div>


}
