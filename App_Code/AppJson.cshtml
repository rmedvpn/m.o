    public static string CreateFulfillmentOptionsJson(int round_id)
    {
        var db = Database.Open("op_data");

        var sqlSelect = "SELECT * FROM RoundFullfilmentOptions WHERE round_id=@0 AND is_deleted=0 ORDER BY service_type,id";
        var fulfillmentOptions = db.Query(sqlSelect, round_id);

        var options = new List<object>();

        foreach (var opt in fulfillmentOptions)
        {
            var item = new Dictionary<string, object>();

            int optionId = 0, serviceType = 0, vendorId = 0;
            decimal shippingCharge = 0, freeShippingMin = 0, minShipping = 0, minOrder = 0;
            bool isPickup = false, isExpress = false, isRoute = false;

            try { optionId = Convert.ToInt32(opt.id); } catch { }
            try { serviceType = Convert.ToInt32(opt.service_type); } catch { }
            try { vendorId = Convert.ToInt32(opt.vendor_id); } catch { }

            try { shippingCharge = Convert.ToDecimal(opt.shipping_charge); } catch { }
            try { freeShippingMin = Convert.ToDecimal(opt.free_shipping_marker); } catch { }
            try { minShipping = Convert.ToDecimal(opt.min_shipping_marker); } catch { }
            try { minOrder = Convert.ToDecimal(opt.min_order); } catch { }

            try { isPickup = Convert.ToBoolean(opt.is_pickup); } catch { }
            try { isExpress = Convert.ToBoolean(opt.is_express); } catch { }
            try { isRoute = Convert.ToBoolean(opt.is_route); } catch { }

            item["id"] = optionId;
            item["round"] = round_id;
            item["vendor"] = vendorId;
            item["type"] = serviceType;

            string title_h = ""; try { title_h = (opt.title_h ?? "").ToString(); } catch { }
            string title_e = ""; try { title_e = (opt.title_e ?? "").ToString(); } catch { }
            string desc_h = ""; try { desc_h = (opt.desc_h ?? "").ToString(); } catch { }
            string desc_e = ""; try { desc_e = (opt.desc_e ?? "").ToString(); } catch { }
            string short_title = ""; try { short_title = (opt.short_title ?? "").ToString(); } catch { }

            if (!string.IsNullOrWhiteSpace(title_h)) item["title_h"] = title_h;
            if (!string.IsNullOrWhiteSpace(title_e)) item["title_e"] = title_e;
            if (!string.IsNullOrWhiteSpace(desc_h)) item["desc_h"] = desc_h;
            if (!string.IsNullOrWhiteSpace(desc_e)) item["desc_e"] = desc_e;
            if (!string.IsNullOrWhiteSpace(short_title)) item["short_title"] = short_title;

            bool active = false; try { active = Convert.ToBoolean(opt.is_active); } catch { }
            bool open = false; try { open = Convert.ToBoolean(opt.is_open_for_orders); } catch { }
            bool freeShip = false; try { freeShip = Convert.ToBoolean(opt.is_free_shipping); } catch { }
            bool returns = false; try { returns = Convert.ToBoolean(opt.returns_allowed); } catch { }

            if (active) item["active"] = true;
            if (open) item["open"] = true;
            if (isRoute) item["route"] = true;
            if (isExpress) item["express"] = true;
            if (isPickup) item["pickup"] = true;
            if (returns) item["returns"] = true;

            item["min_order"] = minOrder;

            /*
             * Fulfillment-option defaults.
             */
            int shippingMethod = 0;
            int optionEta = 0;

            try { shippingMethod = Convert.ToInt32(opt.shipping_method); } catch { }
            try { optionEta = Convert.ToInt32(opt.express_eta_min); } catch { }

            if (!isPickup)
            {
                item["ship_charge"] = shippingCharge;
                item["free_ship_min"] = freeShippingMin;
                item["min_ship"] = minShipping;
                item["free_ship"] = freeShip;
                item["ship_method"] = shippingMethod;
                item["eta_min"] = optionEta;
            }

            string shippingInstructions = "";
            try { shippingInstructions = (opt.shipping_instructions ?? "").ToString(); } catch { }

            if (!string.IsNullOrWhiteSpace(shippingInstructions))
                item["ship_instructions"] = shippingInstructions;

            string shippingInstructionsE = "";
            try { shippingInstructionsE = (opt.shipping_instructions_e ?? "").ToString(); } catch { }

            if (!string.IsNullOrWhiteSpace(shippingInstructionsE))
                item["ship_instructions_e"] = shippingInstructionsE;

            /*
             * Pickup-specific configuration.
             */
            if (isPickup)
            {
                string pickupAddress = "";
                try { pickupAddress = (opt.pu_loc_address ?? "").ToString(); } catch { }

                if (!string.IsNullOrWhiteSpace(pickupAddress))
                    item["pickup_address"] = pickupAddress;

                string pickupAddressE = "";
                try { pickupAddressE = (opt.pu_loc_address_e ?? "").ToString(); } catch { }

                if (!string.IsNullOrWhiteSpace(pickupAddressE))
                    item["pickup_address_e"] = pickupAddressE;

                string pickupName = "";
                try { pickupName = (opt.gen_pu_loc ?? "").ToString(); } catch { }

                if (!string.IsNullOrWhiteSpace(pickupName))
                    item["pickup_name"] = pickupName;

                string pickupNameE = "";
                try { pickupNameE = (opt.gen_pu_loc_e ?? "").ToString(); } catch { }

                if (!string.IsNullOrWhiteSpace(pickupNameE))
                    item["pickup_name_e"] = pickupNameE;

                string pickupCity = "";
                try { pickupCity = (opt.pickup_city ?? "").ToString(); } catch { }

                if (!string.IsNullOrWhiteSpace(pickupCity))
                    item["pickup_city"] = pickupCity;

                string pickupCityE = "";
                try { pickupCityE = (opt.pickup_city_e ?? "").ToString(); } catch { }

                if (!string.IsNullOrWhiteSpace(pickupCityE))
                    item["pickup_city_e"] = pickupCityE;

                int mainPickupArea = 0;
                try { mainPickupArea = Convert.ToInt32(opt.main_pickup_area); } catch { }

                if (mainPickupArea > 0)
                    item["main_pickup_area"] = mainPickupArea;

                int pickupArea = 0;
                try { pickupArea = Convert.ToInt32(opt.pickup_area); } catch { }

                if (pickupArea > 0)
                    item["pickup_area"] = pickupArea;

                int pickupLead = 0;
                try { pickupLead = Convert.ToInt32(opt.pu_lead_time); } catch { }

                if (pickupLead > 0)
                    item["pickup_lead_min"] = pickupLead;
            }

            int minDispatch = 0;
            try { minDispatch = Convert.ToInt32(opt.min_to_dispatch); } catch { }

            if (minDispatch > 0)
                item["min_dispatch"] = minDispatch;

            /*
             * Opening hours.
             */
            var hours = new Dictionary<string, object>();

            Action<string, bool, object, object> AddDay = (day, enabled, startValue, endValue) =>
            {
                if (!enabled)
                    return;

                var dayHours = new Dictionary<string, object>();

                try
                {
                    DateTime start = Convert.ToDateTime(startValue);
                    dayHours["start"] = start.ToString("HH:mm");
                }
                catch { }

                try
                {
                    DateTime end = Convert.ToDateTime(endValue);
                    dayHours["end"] = end.ToString("HH:mm");
                }
                catch { }

                if (dayHours.Any())
                    hours[day] = dayHours;
            };

            bool isSun = false; try { isSun = Convert.ToBoolean(opt.is_sun); } catch { }
            bool isMon = false; try { isMon = Convert.ToBoolean(opt.is_mon); } catch { }
            bool isTue = false; try { isTue = Convert.ToBoolean(opt.is_tue); } catch { }
            bool isWed = false; try { isWed = Convert.ToBoolean(opt.is_wed); } catch { }
            bool isThu = false; try { isThu = Convert.ToBoolean(opt.is_thu); } catch { }
            bool isFri = false; try { isFri = Convert.ToBoolean(opt.is_fri); } catch { }
            bool isSat = false; try { isSat = Convert.ToBoolean(opt.is_sat); } catch { }

            AddDay("sun", isSun, opt.sun_start_time, opt.sun_end_time);
            AddDay("mon", isMon, opt.mon_start_time, opt.mon_end_time);
            AddDay("tue", isTue, opt.tue_start_time, opt.tue_end_time);
            AddDay("wed", isWed, opt.wed_start_time, opt.wed_end_time);
            AddDay("thu", isThu, opt.thu_start_time, opt.thu_end_time);
            AddDay("fri", isFri, opt.fri_start_time, opt.fri_end_time);
            AddDay("sat", isSat, opt.sat_start_time, opt.sat_end_time);

            if (hours.Any())
                item["hours"] = hours;

            /*
             * Areas
             *
             * IMPORTANT:
             *
             * Every RoundAreas row independently means that this fulfillment
             * option is available to that area.
             *
             * main_area_id is only used for optional inheritance.
             *
             * A sub-area DOES NOT require a corresponding main-area row.
             *
             * Effective hierarchy:
             *
             * Option defaults
             *      ↓
             * Main-area overrides (only if a main-area row exists)
             *      ↓
             * Specific-area overrides
             */
            if (!isPickup)
            {
                sqlSelect = "SELECT area_id,main_area_id,shipping_charge,free_shipping_marker,min_shipping_marker,express_eta_min,is_main_area FROM RoundAreas WHERE round_id=@0 AND fulfilment_option_id=@1 ORDER BY is_main_area DESC,main_area_id,area_id";
                var roundAreas = db.Query(sqlSelect, round_id, optionId).ToList();

                var areas = new List<object>();

                /*
                 * Store the actual values of main-area definitions that exist.
                 *
                 * No main-area entry is created implicitly.
                 */
                var mainAreaValues = new Dictionary<int, Dictionary<string, object>>();

                foreach (var row in roundAreas)
                {
                    bool isMainArea = false;
                    try { isMainArea = Convert.ToBoolean(row.is_main_area); } catch { }

                    if (!isMainArea)
                        continue;

                    int areaId = 0;
                    try { areaId = Convert.ToInt32(row.area_id); } catch { }

                    decimal areaShippingCharge = shippingCharge;
                    decimal areaFreeShippingMin = freeShippingMin;
                    decimal areaMinShipping = minShipping;
                    int areaEta = optionEta;

                    try { areaShippingCharge = Convert.ToDecimal(row.shipping_charge); } catch { }
                    try { areaFreeShippingMin = Convert.ToDecimal(row.free_shipping_marker); } catch { }
                    try { areaMinShipping = Convert.ToDecimal(row.min_shipping_marker); } catch { }
                    try { areaEta = Convert.ToInt32(row.express_eta_min); } catch { }

                    mainAreaValues[areaId] = new Dictionary<string, object>
            {
                    { "ship_charge", areaShippingCharge },
                    { "free_ship_min", areaFreeShippingMin },
                    { "min_ship", areaMinShipping },
                    { "eta_min", areaEta }
                };
                }

                /*
                 * Every row is written because the row itself defines availability.
                 */
                foreach (var row in roundAreas)
                {
                    var area = new Dictionary<string, object>();

                    int areaId = 0;
                    int mainAreaId = 0;

                    try { areaId = Convert.ToInt32(row.area_id); } catch { }
                    try { mainAreaId = Convert.ToInt32(row.main_area_id); } catch { }

                    bool isMainArea = false;
                    try { isMainArea = Convert.ToBoolean(row.is_main_area); } catch { }

                    area["area"] = areaId;
                    area["main_area"] = mainAreaId;

                    if (isMainArea)
                        area["main"] = true;

                    decimal areaShippingCharge = shippingCharge;
                    decimal areaFreeShippingMin = freeShippingMin;
                    decimal areaMinShipping = minShipping;
                    int areaEta = optionEta;

                    try { areaShippingCharge = Convert.ToDecimal(row.shipping_charge); } catch { }
                    try { areaFreeShippingMin = Convert.ToDecimal(row.free_shipping_marker); } catch { }
                    try { areaMinShipping = Convert.ToDecimal(row.min_shipping_marker); } catch { }
                    try { areaEta = Convert.ToInt32(row.express_eta_min); } catch { }

                    /*
                     * Default parent is ALWAYS the fulfillment option.
                     *
                     * Only switch to main-area defaults if:
                     *
                     * 1. this is a sub-area
                     * 2. a corresponding main-area definition actually exists
                     */
                    decimal parentShippingCharge = shippingCharge;
                    decimal parentFreeShippingMin = freeShippingMin;
                    decimal parentMinShipping = minShipping;
                    int parentEta = optionEta;

                    if (!isMainArea && mainAreaValues.ContainsKey(mainAreaId))
                    {
                        var parent = mainAreaValues[mainAreaId];

                        parentShippingCharge = Convert.ToDecimal(parent["ship_charge"]);
                        parentFreeShippingMin = Convert.ToDecimal(parent["free_ship_min"]);
                        parentMinShipping = Convert.ToDecimal(parent["min_ship"]);
                        parentEta = Convert.ToInt32(parent["eta_min"]);
                    }

                    /*
                     * Only store values that differ from the effective parent.
                     *
                     * If there is no main-area definition, these are compared
                     * directly against the fulfillment-option defaults.
                     */
                    if (areaShippingCharge != parentShippingCharge)
                        area["ship_charge"] = areaShippingCharge;

                    if (areaFreeShippingMin != parentFreeShippingMin)
                        area["free_ship_min"] = areaFreeShippingMin;

                    if (areaMinShipping != parentMinShipping)
                        area["min_ship"] = areaMinShipping;

                    if (areaEta != parentEta)
                        area["eta_min"] = areaEta;

                    areas.Add(area);
                }

                if (areas.Any())
                    item["areas"] = areas;
            }

            options.Add(item);
        }

        db.Close();

        var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
        return serializer.Serialize(options);
    }

    public static string CreateSpecialOfferJson(int spOffer_id, bool update_record = false)
    {
        var db = Database.Open("op_data");
        var sqlSelect = "";

        var spOffer = db.QuerySingle("SELECT id,title,title_e,description,desc_e,price,spOfferType,discountable,max_in_cart,special_commision,vendor_id FROM SpecialOffers WHERE id=@0 AND is_active=1", spOffer_id);

        if (spOffer == null)
        {
            db.Close();
            return "{}";
        }

        var item = new Dictionary<string, object>();

        int id = 0;
        int spOfferType = 0;
        int maxInCart = 0;
        int vendorId = 0;

        decimal price = 0;
        decimal specialCommision = 0;

        bool discountable = false;

        string title = "";
        string title_e = "";
        string description = "";
        string desc_e = "";

        try { id = Convert.ToInt32(spOffer.id); } catch { }
        try { spOfferType = Convert.ToInt32(spOffer.spOfferType); } catch { }
        try { maxInCart = Convert.ToInt32(spOffer.max_in_cart); } catch { }
        try { vendorId = Convert.ToInt32(spOffer.vendor_id); } catch { }

        try { price = Convert.ToDecimal(spOffer.price); } catch { }
        try { specialCommision = Convert.ToDecimal(spOffer.special_commision); } catch { }

        try { discountable = Convert.ToBoolean(spOffer.discountable); } catch { }

        try { title = Convert.ToString(spOffer.title) ?? ""; } catch { }
        try { title_e = Convert.ToString(spOffer.title_e) ?? ""; } catch { }
        try { description = Convert.ToString(spOffer.description) ?? ""; } catch { }
        try { desc_e = Convert.ToString(spOffer.desc_e) ?? ""; } catch { }


        var spOfferItems = db.Query("SELECT id,spOfferCatId,quan,title,title_e,itemunit_type,spItemType,p_id FROM SpecialOffersItems WHERE spOffer_id=@0 ORDER BY id", spOffer_id).ToList();

        var items = new List<object>();

        foreach (var spItem in spOfferItems)
        {
            var offerItem = new Dictionary<string, object>();

            int itemId = 0;
            int refId = 0;
            int quan = 0;
            int itemunitType = 0;
            int spItemType = 0;

            string itemTitle = "";
            string itemTitle_e = "";

            try { itemId = Convert.ToInt32(spItem.id); } catch { }
            try { quan = Convert.ToInt32(spItem.quan); } catch { }
