@using System
@using System.Collections.Generic
@using System.Globalization

@using System.Web.Script.Serialization


@functions {

    public static string CreateCategoriesJson()
    {
        var db = Database.Open("op_data");

        var rows = db.Query("SELECT id,title,e_title,is_maincat,cat_desc,cat_e_desc,mainCat_id,def_itemunit_type,is_subcat,is_spOffersCat,is_active,vendor_id FROM Categories WHERE is_active=1 ORDER BY is_maincat DESC,id").ToList();

        var mainCategories = new List<object>();
        var categories = new List<object>();


        // ---------------------------------------------------------
        // Main categories
        // ---------------------------------------------------------

        foreach (var main in rows.Where(x =>
        {
            try { return Convert.ToBoolean(x.is_maincat); }
            catch { return false; }
        }))
        {
            int mainId = 0;
            int defItemUnitType = 0;
            int vendorId = 0;

            string title_h = "";
            string title_e = "";
            string desc_h = "";
            string desc_e = "";

            try { mainId = Convert.ToInt32(main.id); } catch { }
            try { defItemUnitType = Convert.ToInt32(main.def_itemunit_type); } catch { }
            try { vendorId = Convert.ToInt32(main.vendor_id); } catch { }

            try { title_h = Convert.ToString(main.title) ?? ""; } catch { }
            try { title_e = Convert.ToString(main.e_title) ?? ""; } catch { }
            try { desc_h = (Convert.ToString(main.cat_desc) ?? "").Trim(); } catch { }
            try { desc_e = (Convert.ToString(main.cat_e_desc) ?? "").Trim(); } catch { }


            var childIds = new List<int>();
            var spOfferCategoryIds = new List<int>();

            foreach (var child in rows.Where(x =>
            {
                try
                {
                    return !Convert.ToBoolean(x.is_maincat) &&
                           Convert.ToInt32(x.mainCat_id) == mainId;
                }
                catch
                {
                    return false;
                }
            }))
            {
                int childId = 0;
                bool isSubCat = false;
                bool isSpOffersCat = false;

                try { childId = Convert.ToInt32(child.id); } catch { }
                try { isSubCat = Convert.ToBoolean(child.is_subcat); } catch { }
                try { isSpOffersCat = Convert.ToBoolean(child.is_spOffersCat); } catch { }

                if (childId <= 0) continue;

                if (isSubCat)
                {
                    childIds.Add(childId);
                }

                if (isSpOffersCat)
                {
                    spOfferCategoryIds.Add(childId);
                }
            }


            var mainItem = new Dictionary<string, object>();

            mainItem["id"] = mainId;
            mainItem["he"] = title_h;
            mainItem["en"] = title_e;
            mainItem["dh"] = desc_h;
            mainItem["de"] = desc_e;
            mainItem["unit"] = defItemUnitType;
            mainItem["vid"] = vendorId;
            mainItem["categories"] = childIds;
            mainItem["spCategories"] = spOfferCategoryIds;

            mainCategories.Add(mainItem);
        }


        // ---------------------------------------------------------
        // All non-main categories
        // Flat list so every category can be accessed directly by ID
        // ---------------------------------------------------------

        foreach (var row in rows.Where(x =>
        {
            try { return !Convert.ToBoolean(x.is_maincat); }
            catch { return false; }
        }))
        {
            int id = 0;
            int mainCatId = 0;
            int defItemUnitType = 0;
            int vendorId = 0;

            string title_h = "";
            string title_e = "";
            string desc_h = "";
            string desc_e = "";

            bool isSubCat = false;
            bool isSpOffersCat = false;

            try { id = Convert.ToInt32(row.id); } catch { }
            try { mainCatId = Convert.ToInt32(row.mainCat_id); } catch { }
            try { defItemUnitType = Convert.ToInt32(row.def_itemunit_type); } catch { }
            try { vendorId = Convert.ToInt32(row.vendor_id); } catch { }

            try { title_h = Convert.ToString(row.title) ?? ""; } catch { }
            try { title_e = Convert.ToString(row.e_title) ?? ""; } catch { }
            try { desc_h = (Convert.ToString(row.cat_desc) ?? "").Trim(); } catch { }
            try { desc_e = (Convert.ToString(row.cat_e_desc) ?? "").Trim(); } catch { }

            try { isSubCat = Convert.ToBoolean(row.is_subcat); } catch { }
            try { isSpOffersCat = Convert.ToBoolean(row.is_spOffersCat); } catch { }


            var category = new Dictionary<string, object>();

            category["id"] = id;
            category["main"] = mainCatId;
            category["he"] = title_h;
            category["en"] = title_e;
            category["dh"] = desc_h;
            category["de"] = desc_e;
            category["unit"] = defItemUnitType;
            category["sub"] = isSubCat;
            category["sp"] = isSpOffersCat;
            category["vid"] = vendorId;

            categories.Add(category);
        }


        // ---------------------------------------------------------
        // Final JSON
        // ---------------------------------------------------------

        var result = new Dictionary<string, object>();

        result["main"] = mainCategories;
        result["categories"] = categories;


        db.Close();

        return new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(result);
    }
    public static string CreateServiceAreasJson()
    {
        var db = Database.Open("op_data");

        var rows = db.Query("SELECT id,title,e_title,is_main_area,main_area_id,sort_order FROM AppServicesArea WHERE is_active=1 ORDER BY sort_order,id").ToList();

        var result = new List<object>();

        foreach (var main in rows.Where(x =>
        {
            try { return Convert.ToBoolean(x.is_main_area); }
            catch { return false; }
        }))
        {
            int mainId = 0;
            try { mainId = Convert.ToInt32(main.id); } catch { }

            string title_h = "";
            string title_e = "";

            try { title_h = Convert.ToString(main.title) ?? ""; } catch { }
            try { title_e = Convert.ToString(main.e_title) ?? ""; } catch { }

            var mainItem = new Dictionary<string, object>();

            mainItem["id"] = mainId;
            mainItem["title_h"] = title_h;
            mainItem["title_e"] = title_e;

            var areas = new List<object>();

            foreach (var row in rows.Where(x =>
            {
                try
                {
                    return Convert.ToInt32(x.main_area_id) == mainId && !Convert.ToBoolean(x.is_main_area);
                }
                catch
                {
                    return false;
                }
            }))
            {
                int id = 0;
                try { id = Convert.ToInt32(row.id); } catch { }

                string areaTitle_h = "";
                string areaTitle_e = "";

                try { areaTitle_h = Convert.ToString(row.title) ?? ""; } catch { }
                try { areaTitle_e = Convert.ToString(row.e_title) ?? ""; } catch { }

                var area = new Dictionary<string, object>();

                area["id"] = id;
                area["title_h"] = areaTitle_h;
                area["title_e"] = areaTitle_e;

                areas.Add(area);
            }

            mainItem["areas"] = areas;

            result.Add(mainItem);
        }

        db.Close();

        return new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(result);
    }
