    public static string CreateFullSpecialOffersJson()
    {
        var db = Database.Open("op_data");

        var rows = db.Query("SELECT id FROM SpecialOffers WHERE is_deleted=0 ORDER BY vendor_id,spOfferType,id").ToList();

        var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
        var result = new List<object>();

        foreach (var row in rows)
        {
            int spOffer_id = 0;
            try { spOffer_id = Convert.ToInt32(row.id); } catch { }

            if (spOffer_id <= 0)
            {
                continue;
            }

            string json = CreateSpecialOfferJson(spOffer_id);

            if (!string.IsNullOrWhiteSpace(json) && json != "{}")
            {
                try
                {
                    var offer = serializer.DeserializeObject(json);

                    if (offer != null)
                    {
                        result.Add(offer);
                    }
                }
                catch { }
            }
        }

        db.Close();

        return serializer.Serialize(result);
    }

    public static string CreateMenuSpecialOffersJson(int menu_id, bool update_record = false)
    {
        var db = Database.Open("op_data");

        var offers = db.Query("SELECT DISTINCT s.id,s.title,s.title_e,s.description,s.desc_e,s.price,s.spOfferType,s.discountable,s.max_in_cart,s.vendor_id FROM SpecialOffers s INNER JOIN SpOfferRoundsAvailability r ON s.id=r.specialOfferId WHERE s.is_active=1 AND r.round_id=@0 ORDER BY s.spOfferType,s.id", menu_id).ToList();

        if (!offers.Any())
        {
            db.Close();
            return "[]";
        }

        var offerIds = new List<int>();

        foreach (var offer in offers)
        {
            try
            {
                int offerId = Convert.ToInt32(offer.id);
                if (offerId > 0) offerIds.Add(offerId);
            }
            catch { }
        }

        if (!offerIds.Any())
        {
            db.Close();
            return "[]";
        }

        string ids = string.Join(",", offerIds);

        var spOfferItems = db.Query("SELECT id,spOffer_id,spOfferCatId,main_cat_id,quan,title,title_e,itemunit_type,spItemType,p_id FROM SpecialOffersItems WHERE spOffer_id IN (" + ids + ") ORDER BY spOffer_id,id").ToList();

        var itemsByOffer = new Dictionary<int, List<object>>();

        foreach (var spItem in spOfferItems)
        {
            int itemId = 0;
            int spOfferId = 0;
            int refId = 0;
            int mainCatId = 0;
            int qty = 0;
            int unitType = 0;
            int itemType = 0;

            string itemHe = "";
            string itemEn = "";

            try { itemId = Convert.ToInt32(spItem.id); } catch { }
            try { spOfferId = Convert.ToInt32(spItem.spOffer_id); } catch { }
            try { mainCatId = Convert.ToInt32(spItem.main_cat_id); } catch { }
            try { qty = Convert.ToInt32(spItem.quan); } catch { }
            try { unitType = Convert.ToInt32(spItem.itemunit_type); } catch { }
            try { itemType = Convert.ToInt32(spItem.spItemType); } catch { }

            try { itemHe = Convert.ToString(spItem.title) ?? ""; } catch { }
            try { itemEn = Convert.ToString(spItem.title_e) ?? ""; } catch { }

            if (itemType == 2)
            {
                try { refId = Convert.ToInt32(spItem.spOfferCatId); } catch { }
            }
            else
            {
                try { refId = Convert.ToInt32(spItem.p_id); } catch { }
            }

            var offerItem = new Dictionary<string, object>();

            offerItem["iid"] = itemId;
            offerItem["type"] = itemType;
            offerItem["ref"] = refId;
            offerItem["cat"] = mainCatId;
            offerItem["qty"] = qty;
            offerItem["he"] = itemHe;
            offerItem["en"] = itemEn;
            offerItem["unit"] = unitType;

            if (!itemsByOffer.ContainsKey(spOfferId))
            {
                itemsByOffer[spOfferId] = new List<object>();
            }

            itemsByOffer[spOfferId].Add(offerItem);
        }

        var result = new List<object>();

        foreach (var spOffer in offers)
        {
            int id = 0;
            int spOfferType = 0;
            int maxInCart = 0;
            int vendorId = 0;

            decimal price = 0;

            bool discountable = false;

            string title = "";
            string title_e = "";
            string description = "";
            string desc_e = "";

            try { id = Convert.ToInt32(spOffer.id); } catch { }
            try { spOfferType = Convert.ToInt32(spOffer.spOfferType); } catch { }
            try { maxInCart = Convert.ToInt32(spOffer.max_in_cart); } catch { }
            try { vendorId = Convert.ToInt32(spOffer.vendor_id); } catch { }

            try { price = Convert.ToDecimal(spOffer.price); } catch { }

            try { discountable = Convert.ToBoolean(spOffer.discountable); } catch { }

            try { title = Convert.ToString(spOffer.title) ?? ""; } catch { }
            try { title_e = Convert.ToString(spOffer.title_e) ?? ""; } catch { }
            try { description = (Convert.ToString(spOffer.description) ?? "").Trim(); } catch { }
            try { desc_e = (Convert.ToString(spOffer.desc_e) ?? "").Trim(); } catch { }

            var item = new Dictionary<string, object>();

            item["id"] = id;
            item["he"] = title;
            item["en"] = title_e;
            item["dh"] = description;
            item["de"] = desc_e;
            item["price"] = price;
            item["type"] = spOfferType;
            item["disc"] = discountable;
            item["max"] = maxInCart;
            item["vid"] = vendorId;

            if (itemsByOffer.ContainsKey(id))
            {
                item["items"] = itemsByOffer[id];
            }
            else
            {
                item["items"] = new List<object>();
            }

            result.Add(item);
        }

        string json = new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(result);

        if (update_record)
        {
            db.Execute("UPDATE Rounds SET spOffersJson=@0 WHERE id=@1", json, menu_id);
        }

        db.Close();

        return json;
    }
    public static string CreateMenuSpecialOffersAvailabilityJson(int menu_id, bool update_record = false)
    {
        var db = Database.Open("op_data");

        var menuItems = db.Query("SELECT DISTINCT p_id,spOfferCatId FROM roundMenuItems WHERE round_id=@0 AND SpOffersOk=1 AND is_active=1 AND is_available=1", menu_id).ToList();

        var productIds = new List<int>();
        var categoryIds = new List<int>();

        foreach (var menuItem in menuItems)
        {
            int p_id = 0;
            int spOfferCatId = 0;

            try { p_id = Convert.ToInt32(menuItem.p_id); } catch { }
            try { spOfferCatId = Convert.ToInt32(menuItem.spOfferCatId); } catch { }

            if (p_id > 0 && !productIds.Contains(p_id)) productIds.Add(p_id);
            if (spOfferCatId > 0 && !categoryIds.Contains(spOfferCatId)) categoryIds.Add(spOfferCatId);
        }

        productIds.Sort();
        categoryIds.Sort();

        var result = new Dictionary<string, object>();

        result["p"] = productIds;
        result["c"] = categoryIds;

        string json = new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(result);

        if (update_record)
        {
            db.Execute("UPDATE Rounds SET SpOfferAvailabilityJson=@0 WHERE id=@1", json, menu_id);
        }

        db.Close();

        return json;
    }
    public static string CreateFeaturedItemsJson(int round_id,bool update_record=false)
    {
        var db = Database.Open("op_data");

        var sqlSelect = @"SELECT p_id,title,title_e,curLowestUnitPrice,itemunit,itemunit_e
                  FROM roundMenuItems
                  WHERE round_id=@0 AND is_active=1 AND is_featured=1
                  ORDER BY id";

        var products = db.Query(sqlSelect, round_id);

        var items = new List<object>();

        foreach (var product in products)
        {
            var item = new Dictionary<string, object>();

            int p_id = 0;
            try { p_id = Convert.ToInt32(product.p_id); } catch { }

            if (p_id <= 0)
                continue;

            item["id"] = p_id;

            string title_h = ""; try { title_h = (product.title ?? "").ToString(); } catch { }
            string title_e = ""; try { title_e = (product.title_e ?? "").ToString(); } catch { }

            if (!string.IsNullOrWhiteSpace(title_h)) item["title_h"] = title_h;
            if (!string.IsNullOrWhiteSpace(title_e)) item["title_e"] = title_e;

            decimal price = 0;
            try { price = Convert.ToDecimal(product.curLowestUnitPrice); } catch { }

            if (price > 0)
                item["price"] = price;

            string unit_h = ""; try { unit_h = (product.itemunit ?? "").ToString(); } catch { }
            string unit_e = ""; try { unit_e = (product.itemunit_e ?? "").ToString(); } catch { }

            if (!string.IsNullOrWhiteSpace(unit_h)) item["unit_h"] = unit_h;
            if (!string.IsNullOrWhiteSpace(unit_e)) item["unit_e"] = unit_e;

            items.Add(item);
        }
        var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();

        string json = serializer.Serialize(items);
        if (update_record)
        {
            sqlSelect = "UPDATE rounds SET FeaturedItemsJson=@0 WHERE id=@1";
            db.Execute(sqlSelect, json, round_id);

        }

        db.Close();

        return json;
    }


