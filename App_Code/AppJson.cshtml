    public static string CreateFulfillmentOptionsJson()
    {
        var db = Database.Open("op_data");

        var rows = db.Query("SELECT id,title_h,title_e,is_route,is_express,is_pickup,icon FROM FullfilmentOptionTypes ORDER BY id").ToList();

        var result = new List<object>();

        foreach (var row in rows)
        {
            var item = new Dictionary<string, object>();

            int id = 0;
            bool isRoute = false;
            bool isExpress = false;
            bool isPickup = false;

            string title_h = "";
            string title_e = "";
            string icon = "";

            try { id = Convert.ToInt32(row.id); } catch { }

            try { title_h = Convert.ToString(row.title_h) ?? ""; } catch { }
            try { title_e = Convert.ToString(row.title_e) ?? ""; } catch { }
            try { icon = Convert.ToString(row.icon) ?? ""; } catch { }

            try { isRoute = Convert.ToBoolean(row.is_route); } catch { }
            try { isExpress = Convert.ToBoolean(row.is_express); } catch { }
            try { isPickup = Convert.ToBoolean(row.is_pickup); } catch { }

            item["id"] = id;
            item["title_h"] = title_h;
            item["title_e"] = title_e;
            item["route"] = isRoute;
            item["express"] = isExpress;
            item["pickup"] = isPickup;
            item["icon"] = icon;

            result.Add(item);
        }

        db.Close();

        return new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(result);
    }


