            db.Execute(sqlSelect, max_in_cart, spOffer_id);

            theHtmlOutput = " 👌 פרטי המבצע נשמרו ";
            db.Close();
        }
        else
        {
            theHtmlOutput = "!$!" + theHtmlOutput;
        }
        return theHtmlOutput;
    }


