@helper SpecialOfferInfo(int specialOfferId)
{
System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");

var db = Database.Open("op_data");
var sqlSelect = "SELECT * from specialOffers WHERE id=@0";
var spOffer = db.QuerySingle(sqlSelect, specialOfferId);
sqlSelect = "SELECT * FROM SpecialOffersItems WHERE spOffer_id=@0 order by SpItemType,main_cat_id";
var spItemsIncluded = db.Query(sqlSelect, specialOfferId);
sqlSelect = "SELECT id,title FROM rounds WHERE is_active=1 ";
var rounds = db.Query(sqlSelect, specialOfferId);
sqlSelect = "SELECT COUNT(id) AS the_cnt FROM SpOfferRoundsAvailability WHERE round_id>0 AND specialOfferId=@0";
var inRoundsCnt = db.QuerySingle(sqlSelect, specialOfferId);
int spOffersInRoundsCnt = 0; try { spOffersInRoundsCnt = inRoundsCnt.the_cnt; } catch { }
int spOfferType = 0;
try { spOfferType = spOffer.spOfferType; } catch { }
string offer_type_title = ""; try { offer_type_title = NewAppFunctions.GetTitleById("spOfferTypes", spOfferType); } catch { }
string offer_type_icon = ""; try { offer_type_icon = NewAppFunctions.GetTitleById("spOfferTypeIcon", spOfferType); } catch { }

    <div class="B">
        <div class="SPOFFERVIEWERTITLE">
            @spOffer.title
            <div style="float: left">
                @spOffer.price.ToString("C", culture)

            </div>
        </div>
        <div class="Spacer10"></div>
        <div class="SPOFFERVIEWERITEMS">

            @offer_type_icon הטבה מסוג <span>@offer_type_title</span>
        </div>
        <div class="SPOFFERVIEWERITEMS" id="spOfferItemsList">

            <div class="B">
                <div class="B">
                    <button type="button" class="SPOFFERVIEWERITEMDELBTN" onclick="Accordionize('AccAddItemToSpecial');">➕</button>
                    @if (spItemsIncluded.Count() > 0)
                    {
                        <div style="color: #4800ff;overflow: auto">כולל  </div>
                    }
                    else
                    {
                        <div style="color: #ff6a00;overflow: auto">אין עדיין פריטים במבצע  </div>
                    }
                </div>

                <div class="B">
                    <button class="accordion" style="display:none" id="AccAddItemToSpecial"></button>
                    <div class="panel">
                        <div style="overflow: auto" id="AddSpecialItemDiv">
                            @SpecialOffers.AddSpecialItem(specialOfferId)
                        </div>
                    </div>
                </div>
                <div style="overflow: auto;margin-right:15px;">
                    @foreach (var item in spItemsIncluded)
                    {
                        string cat_title = "";
                        string item_color = "#000";

                        if (item.SpItemType == 1)
                        {
                            item_color = "#ff6a00";
                        }
                        if (item.SpItemType == 2)
                        {
                            try { cat_title = NewAppFunctions.GetTitleById("Cat", item.main_cat_id); } catch { }
                            cat_title = "מקטגוריית " + cat_title;
                        }
                        if (item.SpItemType == 3) { item_color = "blue"; cat_title = "מהמוצר הקטגורי "; }
                        <div style="overflow: auto; font-size: 18px; color: @item_color;">
                            <button type="button" class="SPOFFERVIEWERITEMDELBTN" onclick="AjaxActions('RemoveSpecialItemFromOffer', @specialOfferId,'MainLoader',@item.id);">🗑️</button>
                            @item.quan @item.itemunit @cat_title @item.title
                        </div>

                    }

                </div>
                <div class="spinner" style="text-align: center;display: none;float: left" id="spOfferItemsLoader">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>
            </div>


        </div>


        @if (spOffer.special_commision > 0)
        {
            <div class="Spacer20"></div>
            <div class="SPOFFERVIEWERITEMS">עמלת מערכת @spOffer.special_commision.ToString("C", culture)</div>
        }

        <div class="Spacer20"></div>

        @if (!String.IsNullOrEmpty(spOffer.description))
        {
            <div class="Spacer20"></div>
            <div class="SPOFFERVIEWERITEMS">
                @spOffer.description
            </div>
        }

        @if (!String.IsNullOrEmpty(spOffer.desc_e))
        {
            <div class="Spacer20"></div>
            <div class="SPOFFERVIEWERITEMS">
                @spOffer.desc_e
            </div>
        }

        <div class="SPOFFERVIEWERITEMS">

            המבצע זמין ב<span>@spOffersInRoundsCnt</span> תפריטים
        </div>

        <div class="B">
            @foreach (var round in rounds)
            {
                sqlSelect = "SELECT * FROM SpOfferRoundsAvailability WHERE round_id=@0 AND specialOfferId=@1";
                var isSpOfferAvaialbleInRound = db.QuerySingle(sqlSelect, round.id, specialOfferId);
                bool isInRound = false;
                if (isSpOfferAvaialbleInRound != null)
                {
                    isInRound = true;
                }
                <div style="overflow: auto;">
                    <input type="checkbox" style="height: 20px;width: 20px;padding: 5px;margin: 5px" @if (isInRound) { <text> checked</text>} onclick="    if (this.checked) { AjaxActions('AddOfferToRound', @specialOfferId, 'MainLoader',@round.id, '1'); } else { AjaxActions('AddOfferToRound', @specialOfferId,'MainLoader',@round.id,'');} " /> @round.title
                </div>
            }
            <div class="B">
                <button style="padding:5px;margin:5px;font-size:16px;float:left" onclick="    AjaxActions('AddOfferToAllRounds', @specialOfferId,'MainLoader','1');">✅ הפעלת הכל</button>
                <button style="padding:5px;margin:5px;font-size:16px;float:left" onclick="    AjaxActions('AddOfferToAllRounds', @specialOfferId,'MainLoader','0');">❌ כיבוי הכל</button>

            </div>
        </div>

    </div>
    db.Close();
}

@helper AddSpecialItem(int specialOfferId)
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM SpecialOffers WHERE id=@0";
    var spOffer = db.QuerySingle(sqlSelect, specialOfferId);
    int vendor_id = 0; try { vendor_id = spOffer.vendor_id; } catch { }
    sqlSelect = "SELECT * from ItemUnitTypes ";
    var itemTypes = db.Query(sqlSelect);
    sqlSelect = "SELECT * from categories WHERE is_spOffersCat=1 ";
    var OfferCategories = db.Query(sqlSelect);
    sqlSelect = "SELECT * from categories WHERE is_maincat=1 ";
    var mainCats = db.Query(sqlSelect);

    sqlSelect = "SELECT * FROM SpecialOffersItems WHERE spOffer_id=@0 order by main_cat_id";
    var spItemsIncluded = db.Query(sqlSelect, specialOfferId);

    <div style="overflow: auto">
        <div style="overflow: auto;background-color: #ffffcc;padding: 5px;border: 1px dotted #000">
            <div style="overflow: auto;border-bottom: 1px dotted #000">
                <div style="overflow: auto;font-size: 14px;font-weight: bold">הוספה למבצע..</div>
                <form id="AddSpecialItemToOffer">
                    <div style="overflow: auto;padding: 5px;">
                        <input type="text" style="padding: 5px;font-size: 16px;margin-right: 5px;width: 40px" name="QuanToAdd" id="QuanToAdd" placeholder="x">
                        <select style="padding: 5px;font-size: 16px;margin-right: 5px;" name="itemunit_type" id="itemunit_type">
                            @foreach (var itemType in itemTypes)
                            {
                                <option value="@itemType.id">@itemType.title</option>
                            }

                        </select>
                        <select style="padding: 5px;font-size: 16px;margin-right: 5px;" name="MainOfferCatId" id="MainOfferCatId" onchange="RepAjaxUpdate('LoadSpOfferCatList', 'SpOfferSubCatDiv', 'spOfferSubCatLoader', this.value,@specialOfferId);">
                            <option value="">נא לבחור..</option>
                            @if (vendor_id > 0)
                            {
                                <option value="-1">מוצר ספציפי</option>
                            }
                      

                            @foreach (var cat in mainCats)
                            {
                                <option value="@cat.id">@cat.title</option>
                            }

                        </select>
                        <div style="overflow: auto">
                            <div class="spinner" style="text-align: center;display: none;" id="spOfferSubCatLoader">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>
                        </div>
                    </div>
                    <div style="overflow: auto;padding: 5px;" id="SpOfferSubCatDiv">

                    </div>
                </form>
            </div>



            <div style="overflow: auto;text-align: center">
                <div class="spinner" style="text-align: center;display: none;" id="spOfferAddItemsLoader">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>
            </div>
        </div>
    </div>


    db.Close();
}

@helper LoadSpOfferCatSelector(int main_cat_id, int specialOfferId, int vendor_id = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "";

    switch (main_cat_id)
    {
        case 0:
            break;
        case -1:
            sqlSelect = "SELECT * FROM products WHERE is_active=1 AND vendor_id=@0";
            var products = db.Query(sqlSelect, vendor_id);
            if (products.Count() > 0)
            {
                <div style="overflow: auto;width: 100%;">
                    מוצר
                    <select style="padding: 5px;margin: 5px;font-size: 16px;" id="item_p_id" name="item_p_id">
                        <option value="-1">נא לבחור </option>
                        @foreach (var product in products)
                        {
                            <option value="@product.p_id">@product.title</option>
                        }
                    </select>
                    <button type="button" style="margin: 5px;padding: 5px;font-size: 16px;border: 0;background-color: #57d600;color: #fff;float: left" onclick="AjaxActions('AddSpecialItemToOffer', @specialOfferId,'MainLoader','AddSpecialItemToOffer');">הוספה</button>
                </div>
            }
            else
            {
                <div>אין מוצרים</div>
            }

            break;
        case -2:
            sqlSelect = "SELECT * FROM products WHERE is_active=1 AND is_catalog=1 ORDER BY maincat_id,sub_cat_id";
            var catalog = db.Query(sqlSelect);
            if (catalog.Count() > 0)
            {
                <div style="overflow: auto;width: 100%;">
                    מוצר קטלוגי:
                    <select style="padding: 5px;margin: 5px;font-size: 16px;" id="catalog_p_id" name="catalog_p_id">
                        <option value="-1">נא לבחור </option>
                        @foreach (var product in catalog)
