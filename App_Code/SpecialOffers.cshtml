@using System
@using System.Collections.Generic
@using System.Globalization

@using System.Web.Script.Serialization

@helper SpecialOffersAdmin(int spOfferType = 0)
{
    var db = Database.Open("op_data");
    var sqlSelect = "";

    sqlSelect = "SELECT id,title FROM SpOfferTypes";
    var spOfferTypes = db.Query(sqlSelect);

    //SpOffersAdminDefaultId

    if (spOfferType == 0)
    {
        try { spOfferType = Convert.ToInt32(AppFunctions.GetAppProperty("SpOffersAdminDefaultId")); } catch { }
    }



    sqlSelect = "SELECT * FROM SpecialOffers where spOfferType=@0 order by vendor_id,is_activated,is_active DESC,id DESC";
    var SpecialOffers = db.Query(sqlSelect, spOfferType);


    <div style="overflow:auto" id="SpOfferAdminDiv">
        <div style="overflow: auto;background-color: #fff;min-height: 500px;">
            <div style="overflow: auto;padding: 5px;">
                <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;" onclick="    sbload('GenSb','Caller?p1=AddNewSpOffer');AdjustMainView();">חדש</button>
                <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000;" onclick="    AjaxActions('ReCreateSpecialOffersJson'); ">JSON</button>
                <div style="font-size: 20px;float: right;color: #000">
                    ניהול
                    <select style="font-size: 16px;padding: 5px;margin: 5px;background: transparent" onchange="RepAjaxUpdate('SpOfferAdmin','SpOfferAdminDiv','SpOfferAdminLoader',this.value);">
                        @foreach (var offerType in spOfferTypes)
                        {
                            <option value="@offerType.id" @if (offerType.id == spOfferType) { <text> selected</text>}>@offerType.title</option>
                        }

                    </select>


                </div>
                <div class="spinner" style="text-align: center;display: none;float: left" id="SpOfferAdminLoader">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>

            </div>

            <div style="overflow: auto;clear: both;" id="spOfferDiv">
                @foreach (var spItem in SpecialOffers)
                {
                    string rowColor = "#e3e3e3;";
                    bool is_active = false; try { is_active = spItem.is_active; } catch { }
                    bool is_activated = false; try { is_activated = spItem.is_activated; } catch { }
                    int vendor_id = 0; try { vendor_id = spItem.vendor_id; } catch { }
                    if (!is_active) { rowColor = "#ffffcc;"; }
                    if (!is_activated) { rowColor = "#ffcccc;"; }

                    <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;color: #000;background-color: @rowColor">
                        <button style="float: left;padding: 5px;margin: 5px;font-size: 16px;background-color: #fff;color: #000" onclick="sbload('GenSb', 'Caller?p1=SpecialEdit&p2=@spItem.id'); AdjustMainView();">עריכה</button>
                        <div style="overflow: auto;"> @spItem.id - @spItem.title</div>
                        @if (vendor_id > 0)
                        {
                            <div class="B">@vendor_id</div>
                        }

                    </div>
                }
            </div>
        </div>
        <div style="overflow: auto;height: 100px;background-color: #e3e3e3">&nbsp;</div>
    </div>
    db.Close();
}

@helper AddNewSpOffer()
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var db = Database.Open("op_data");
    int product_id = 0;
    var sqlSelect = "SELECT id,title FROM SpOfferTypes";
    var spOfferTypes = db.Query(sqlSelect);
    sqlSelect = "SELECT vendor_id,vendor_name FROM vendors WHERE is_active=1";
    var vendors = db.Query(sqlSelect);

    <div class="ADDSPOFFERPAGE">
        <div style="overflow: auto;font-size: 24px;color: #000;">
            <div style="overflow: auto">
                <div style="color: #fff;background-color: #000;overflow: auto;padding: 5px;">הגדרת מבצע חדש</div>

            </div>
            <div style="overflow: auto">
            </div>


        </div>
        <div class="B" style="padding:5px;">

            <form id="AddSpOffer">
                <div class="B">
                    <div class="SpOfferAddRow">
                        יצירה עבור
                        <span style="float: left">
                            <select class="A" name="vendor_id">
                                <option value="-1">כל הספקים</option>
                                @foreach (var vendor in vendors)
                                {
                                    <option value="@vendor.vendor_id">@vendor.vendor_name</option>
                                }

                            </select>
                        </span>
                    </div>
                    <div class="SpOfferAddRow">
                        סוג מבצע
                        <span style="float: left">
                            <select class="A" name="spOfferType">
                                @foreach (var offerType in spOfferTypes)
                                {
                                    <option value="@offerType.id">@offerType.title</option>
                                }

                            </select>
                        </span>
                    </div>
                    <div style="overflow: auto;">
                        <div class="SpOfferAddRow">
                            כותרת מבצע<br>
                            <input type="text" class="A" style="width:90%" id="special_title" name="special_title">
                        </div>
                        <div class="SpOfferAddRow">
                            Title<br>
                            <input type="text" class="A" style="width:90%" id="special_title_e" name="special_title_e">
                        </div>

                    </div>
                    <div style="overflow: auto;">
                        <div class="SpOfferAddRow">

                            תיאור<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="special_desc" name="special_desc"></textarea>
                        </div>
                        <div class="SpOfferAddRow">

                            Description<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="special_desc_e" name="special_desc_e"></textarea>
                        </div>
                    </div>

                    <div class="Spacer50"></div>
                    <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;text-align: center;">
                        <button type="button" style="font-size: 18px;padding: 5px;margin: 5px;background-color: #fff;width: 45%;color: #000;font-weight: bold" onclick="    AjaxActions('AddSpOffer', '','MainLoader','AddSpOffer');">✅ הוספת מבצע</button>
                    </div>


                </div>
            </form>


        </div>
    </div>

    db.Close();
}


@helper SpecialOfferEdit(int sp_offer_id)
{
var db = Database.Open("op_data");
var sqlSelect = "SELECT * from specialOffers WHERE id=@0";
var spOffer = db.QuerySingle(sqlSelect, sp_offer_id);
sqlSelect = "SELECT id,title FROM SpOfferTypes";
var spOfferTypes = db.Query(sqlSelect);

System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
int spOfferId = 0;
try { spOfferId = spOffer.id; } catch { }
int spOfferType = 0;
try { spOfferType = spOffer.spOfferType; } catch { }
sqlSelect = "SELECT id,title from rounds WHERE is_catalog=1 ORDER BY vendor_id";
var CatalogRounds = db.Query(sqlSelect);
sqlSelect = "SELECT rounds.id,rounds.title FROM rounds INNER JOIN RoundSpecials ON rounds.id=RoundSpecials.round_id WHERE RoundSpecials.specialOfferId=@0";
var SpOfferInRounds = db.Query(sqlSelect, spOfferId);

sqlSelect = "SELECT * FROM SpecialOffersItems WHERE spOffer_id=@0";
var spItemsIncluded = db.Query(sqlSelect, spOfferId);
string item_commision = spOffer.special_commision > 0 ? ((int)spOffer.special_commision).ToString() : "";

bool is_active = false; try { is_active = spOffer.is_active; } catch { }
bool is_activated = false; try { is_activated = spOffer.is_activated; } catch { }
try { spOfferType = spOffer.spOfferType; } catch { }
string offer_type_title = ""; try { offer_type_title = NewAppFunctions.GetTitleById("spOfferTypes", spOfferType); } catch { }


    <div class="B" style="overflow: auto;color: #000;background-color: #fff">

        <div>
            <div style="overflow: auto;font-size: 20px;background-color:#000;color:yellow;">
                הגדרות מבצע - <span>@spOffer.title</span>

                <button style="float: left;padding: 5px;margin: 5px;font-size: 14px;background-color: #b200ff;color: #fff;font-weight: bold;text-align: center;margin-left:40px;" id="StartEditBtn" onclick="showElement('EditSpOfferDiv');hideElement('spOfferItemsListDiv');hideElement('StartEditBtn');showElement('DoneEditBtn');">עריכה</button>
                <button style="float: left;padding: 5px;margin: 5px;font-size: 14px;background-color: #b200ff;color: #fff;font-weight: bold;text-align: center;margin-left:40px;display: none" id="DoneEditBtn" onclick="hideElement('EditSpOfferDiv');showElement('spOfferItemsListDiv');hideElement('DoneEditBtn');showElement('StartEditBtn');"> סיום עריכה </button>
                @if (!is_activated)
                {
                    <div class="NONACTIVESPOFFERALERT">
                        המבצע לא הופעל!
                    </div>
                }
                else
                {
                    if (!is_active)
                    {
                        <div class="NONACTIVESPOFFERALERT">
                            המבצע לא פעיל!
                        </div>
                    }
                }

            </div>
            <div style="overflow: auto;">
            </div>
            <div id="spOfferItemsListDiv">
                @SpecialOffers.SpecialOfferInfo(spOfferId)
            </div>

            <div style="padding: 0;margin: 0">

                <div style="overflow: auto;min-height: 500px;display: none" id="EditSpOfferDiv">

                    <form id="UpdateSpecialOfferDetails">
                        <input type="hidden" name="spOfferType" value="@spOfferType" />
                        <div style="overflow: auto;background-color: #e3e3e3;">
                            <div style="overflow: auto;">
                                <div class="SpOfferAddRow">
                                    המבצע פעיל?
                                    <input type="checkbox" style="float: left; padding: 5px; margin: 5px; height: 20px; width: 20px;" id="is_active" name="is_active" value="true" @if (spOffer.is_active) { <text> checked </text> } onclick="AjaxActions('ActivateSpOffer', @spOfferId,'MainLoader',this.checked);">
                                </div>
                                <div class="SpOfferAddRow">
                                    כותרת מבצע<br>
                                    <input type="text" class="A" style="width:90%" id="special_title" name="special_title" value="@spOffer.title">
                                </div>
                                <div class="SpOfferAddRow">
                                    Title<br>
                                    <input type="text" class="A" style="width:90%" id="special_title_e" name="special_title_e" value="@spOffer.title_e">
                                </div>

                            </div>
                            <div style="overflow: auto;">
                                <div class="SpOfferAddRow">
                                    תיאור<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="special_desc" name="special_desc">@spOffer.description</textarea>
                                </div>
                                <div class="SpOfferAddRow">

                                    Description<br><textarea style="font-size: 16px;padding: 5px;margin: 5px;width: 90%;resize: none" id="special_desc_e" name="special_desc_e">@spOffer.desc_e</textarea>
                                </div>
                            </div>


                            <div style="overflow: auto;font-size: 20px;font-weight: bold">מחיר מבוקש (₪)<span style="float: left"><input type="text" style="padding: 5px;margin: 5px;font-size: 18px;width: 50px;" id="special_price" name="special_price" value="@Convert.ToInt32(spOffer.price)"></span></div>
                            <div style="overflow: auto;font-size: 20px;font-weight: bold">עמלת מערכת (₪)<span style="float: left"><input type="text" style="padding: 5px;margin: 5px;font-size: 18px;width: 50px;" id="special_commision" name="special_commision" value="@item_commision"></span></div>
                            <div style="overflow: auto;font-size: 20px;font-weight: bold">מקסימום יח בהזמנה <span style="float: left"><input type="text" style="padding: 5px;margin: 5px;font-size: 18px;width: 50px;" id="max_in_cart" name="max_in_cart" @if (spOffer.max_in_cart > 0) { <text> value="@spOffer.max_in_cart" </text> }></span></div>
                            <div style="overflow: auto;font-size: 20px;font-weight: bold">איפשור כפל הנחות <span style="float: left"><input type="checkbox" style="padding: 5px;margin: 5px;height: 20px;width: 20px;" id="is_discountable" name="is_discountable" @if (spOffer.discountable) { <text> checked</text>}></span></div>
                            <div style="overflow: auto;padding: 5px;margin: 5px;font-size: 18px;text-align: center;">
                                <button type="button" style="font-size: 18px;padding: 5px;margin: 5px;background-color: #f00;width: 45%;color: #fff;font-weight: bold" onclick="    AjaxActions('DeleteSpOffer', @spOfferId,'MainLoader',@spOfferType);">מחיקה</button>
                                <button type="button" style="font-size: 18px;padding: 5px;margin: 5px;background-color: #fff;width: 45%;color: #000;font-weight: bold" onclick="    AjaxActions('UpdateSpecialOfferDetails', @spOfferId,'MainLoader','UpdateSpecialOfferDetails');">✅ שמירת שינוים</button>
                            </div>


