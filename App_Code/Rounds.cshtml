@helper RoundFullfilmentMethod(int round_id, int order_id = 0)
{
    var u_id = WebSecurity.CurrentUserId;
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT round_type,is_express,is_pickup FROM rounds WHERE id=@0";
    var round = db.QuerySingle(sqlSelect, round_id);
    int round_type = 0; try { round_type = round.round_type; } catch { }
    bool is_express = false; try { is_express = round.is_express; } catch { }
    bool is_pickup = false; try { is_pickup = round.is_pickup; } catch { }
    string selChecker = "checked";
    DateTime local_time = AppFunctions.LocalTime();
    sqlSelect = "SELECT requested_delivery_date FROM mainorders WHERE order_id=@0";
    var order = db.QuerySingle(sqlSelect, order_id);
    DateTime requested_delivery_date = local_time;
    try { requested_delivery_date = order.requested_delivery_date; } catch { }


    <div class="B">
        נא לבחור אופן אספקה
        @if (round_type == 1)
        {
            sqlSelect = "SELECT serial,scheduled_start FROM deliveries WHERE round_id=@0 AND scheduled_start>@1 AND scheduled_start>@2 AND has_Started=0 AND is_completed=0  ORDER BY scheduled_start";
            var deliveries = db.Query(sqlSelect, round_id, local_time, requested_delivery_date);

            /*
            if (deliveries == null)
            {
                Rounds.InitializeRound(round_id);
                deliveries = db.Query(sqlSelect, round_id, local_time);

            }
            */

            <div class="A" style="float:left">
                <input type="radio" class="A" name="order_type" value="ROUND" checked />
                🚚 סבב חלוקה
            </div>
        }
        else
        {
            if (is_pickup && is_express) { selChecker = ""; }

            if (is_pickup)
            {
                <div class="B" style="float:left">
                    <input type="radio" class="A" name="order_type" value="PICKUP" @selChecker />
                    🏠 איסוף עצמי
                </div>
            }
            if (is_express)
            {
                <div class="B" style="float:left">
                    <input type="radio" class="A" name="order_type" value="EXPRESS" @selChecker />
                    🛵 משלוח אקספרס
                </div>
            }

        }

    </div>
    <div class="A" style="text-align:center">
        <button type="button" class="OrderCommandBtn" onclick="AjaxActions('ORDERACTION',@order_id, 'MainLoader', 'SETORDERROUND', @round_id); ">אישור</button>
    </div>
    db.Close();
}



