                <div class="A">

                    <div class="B">
                        <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;color: #fff;background-color: #57d600" onclick="AjaxActions('OutpostOpeningHours', @round_id,'', 'OutpostOpeningHours', 'SCHEDULE');">שמירת שינויים</button>
                    </div>

                </div>

            </div>


