                                <input type="date" id="new_delivery_date" class="A" value="@local_time.Date.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="B" style="float:right;">
                                <input type="time" id="new_delivery_time" class="A" />
                            </div>
                            <div class="B" style="float:right;">
                                <button class="A" onclick="AjaxActions('CreateNewDeliveryInRound', '@round_id', 'MainLoader', document.getElementById('new_delivery_date').value,document.getElementById('new_delivery_time').value);">✔️</button>
                            </div>

                        </div>

                    </div>


                </div>

            </div>
        </div>


        @if (delivery != null)
