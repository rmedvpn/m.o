                            <select class="A" style="float: right; background-color: #e3e3e3; color: #000; cursor: pointer " name="requested_action" id="route_action_selector_@route_id" onchange="hideElement('cancel_notes_@route_id');hideElement('route_driver_selector_@route_id');hideElement('route_selector_approval_@route_id');if (this.value == '1') { showElement('route_driver_selector_@route_id'); }if (this.value >= 1 && this.value <= 4) { showElement('cancel_notes_@route_id'); } if (this.value != '') {showElement('route_selector_approval_@route_id'); }">
