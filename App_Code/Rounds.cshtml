                        decimal after_roundup_total = 0; try { after_roundup_total = db_order.after_roundup_total; } catch { }
                        int order_status = 0; try { order_status = db_order.order_status; } catch { }

                        if (db_order != null)
                        {
                            if (order_status >= 4 && order_status <= 5)
                            {
                                if (requested_action > 1)
                                {
                                    driver_id = db_order.driver_id;
                                    route_id = db_order.route_id;
                                    route_serial = db_order.route_serial;

                                }

                                try { driver_name = AppFunctions.GetRepName(driver_id); } catch { }

                                switch (requested_action)
                                {

                                    case 1: //transfer orders to another driver
                                        if (true)
                                        {

                                            if (route_serial != new_route_serial && route_serial > 0)
