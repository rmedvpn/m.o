    sqlSelect = "SELECT * FROM rounds WHERE id=@0";
    var round = db.QuerySingle(sqlSelect, round_id);
    int round_type = 0; try { round_type = round.round_type; } catch { }
    if (round_type == 4) //outpost
    {
        <div>@Rounds.OutpostEditOpeningHours(round_id)</div>
    }
    else
    {
        sqlSelect = "SELECT * FROM RoundsSchedules WHERE round_id=@0 ORDER BY DayOfWeek";
        var RoundSchedule = db.Query(sqlSelect, round_id);

        sqlSelect = "SELECT * from AppServicesArea WHERE is_active=1";
        var ServiceAreas = db.Query(sqlSelect);
