        decimal free_shipping_marker = 0; try { free_shipping_marker = Convert.ToDecimal(Request["free_shipping_marker"]); } catch { }
        string start_date = ""; start_date = Request["start_date"];
        string start_time = ""; start_time = Request["start_time"];
        DateTime round_start = defDate;

        //   if (start_date == "") { theHtmlOutput = theHtmlOutput + "חובה למלא תאריך יציאה<BR>"; }
        //  if (start_time == "") { theHtmlOutput = theHtmlOutput + "חובה למלא שעת יציאה<BR>"; }
        //try { round_start = Convert.ToDateTime(start_date + " " + start_time); } catch { }
        //if (round_start < local_time) { theHtmlOutput = theHtmlOutput + "חובה למלא זמן יציאה עתידי<BR>"; }

        int estimated_duration = 0; try { estimated_duration = Convert.ToInt32(Request["estimated_duration"]); } catch { }
        if (Request["estimated_round_time_unit"] == "h")
        {
            estimated_duration = estimated_duration * 60;
        }
        int min_to_dispatch = 0; try { min_to_dispatch = Convert.ToInt32(Request["min_to_dispatch"]); } catch { }


        DateTime expected_end_ts = Convert.ToDateTime("1/1/1970");
        string shipping_instructions = ""; shipping_instructions = Request["shipping_instructions"];
        string shipping_instructions_e = ""; shipping_instructions_e = Request["shipping_instructions_e"];
        // if (shipping_instructions == "") { theHtmlOutput = theHtmlOutput + "חובה למלא הנחיות משלוח<BR>"; }
        // if (shipping_instructions_e == "") { theHtmlOutput = theHtmlOutput + "חובה למלא הנחיות משלוח באנגלית<BR>"; }

        if (theHtmlOutput == "")
        {
            DateTime order_close_hour = round_start;
            DateTime next_scheduled_delivery = local_time;
            round_start = round_start.AddMinutes(min_to_dispatch); //add dynamicly
            try { expected_end_ts = round_start.AddMinutes(estimated_duration); } catch { }

            var db = Database.Open("op_data");
            var sqlSelect = "";

            sqlSelect = "SELECT next_scheduled_delivery FROM rounds WHERE id=@0";
            var round = db.QuerySingle(sqlSelect, round_id);
            try { next_scheduled_delivery = round.next_scheduled_delivery; } catch { }

