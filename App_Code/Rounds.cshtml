@helper RouteInDelivery(int delivery_id, int route_serial = 0, int round_id = 0)
{

    DateTime local_time = AppFunctions.LocalTime();

    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    var db = WebMatrix.Data.Database.Open("op_data");
    var sqlSelect = "SELECT * FROM routes WHERE serial=@0";
    var route = db.QuerySingle(sqlSelect, route_serial);
    int route_id = 0;
    int driver_id = 0;
    string driverName = "";
    string driverSelectorDisplayState = "block;";
    string driverInfoDisplayState = "none;";
    string start_address_street = ""; try { start_address_street = route.start_address_street; } catch { }
    string start_address_city = ""; try { start_address_city = route.start_address_city; } catch { }
    string end_address_street = ""; try { end_address_street = route.end_address_street; } catch { }
    string end_address_city = ""; try { end_address_city = route.end_address_city; } catch { }

    if (route != null)
    {
        round_id = route.round_id;
        route_id = route.route_id;
        driver_id = route.driver_id;
    }
    if (driver_id > 0)
    {
        driverName = route.driverName;
        driverSelectorDisplayState = "none;";
        driverInfoDisplayState = "block;";
    }

    sqlSelect = "SELECT * FROM routes WHERE delivery_id=@0 ORDER BY route_id";
    var routes = db.Query(sqlSelect, delivery_id);

    sqlSelect = "SELECT * FROM deliveries WHERE round_id=@0 AND is_completed=0  ORDER BY scheduled_start";
    string tmpOrdersList = "";
    sqlSelect = "SELECT order_id,username,ship_city,requested_delivery_date,order_status,envelope_id,route_id,stop_id,area_id,ship_address,routeAppAddress FROM MainOrders WHERE is_cancelled=0 AND delivery_id=@0 AND route_serial=@1  AND round_id=@2 ORDER by stop_id";
    var route_orders = db.Query(sqlSelect, delivery_id, route_serial, round_id);
    DataFunctions.WriteDebugLine(" delivery_id  " + delivery_id + " route_serial  " + route_serial + " round_id  " + round_id);
    int route_orders_count = route_orders.Count();

    string routeHeaderClass = "RouteHeaderCell";
    if (route_id == 0)
    {
        routeHeaderClass = "RouteHeaderCellPale";
    }
    if (route_orders_count == 0)
    {
        if (route_id > 0)
        {

            <tr>
                <td colspan="999" style="background-color: #e3e3e3; color: #808080; padding: 5px; margin: 5px;">
                    <span style="float:left" onclick="AjaxActions('RemoveRouteFromDelivery', @delivery_id, 'MainLoader',document.getElementById('current_delivery_id').value, @round_id,@route_serial);">❌</span><span>מסלול @route_id</span> <span class="MiniTag">(#@route.serial)</span> <span class="RedMiniTag">אין הזמנות במסלול</span>
                </td>

            </tr>
            <tr class="B" style="font-size: 12px;">
                <td class="A" colspan="999" style="float:right;font-size: 12px;">
                    <br />
                </td>
            </tr>

        }

    }
    else
    {
        sqlSelect = "SELECT DISTINCT u_id,username FROM TeamMembersInRounds WHERE (permission_code='ROUNDDRIVER' OR permission_code='ROUNDTEAMLEADER') AND round_id=@0";
        var drivers = db.Query(sqlSelect, round_id);

        <tr>
            <td colspan="999" class="@routeHeaderClass">
                <div class="B" style="float:right;">
                    <input type="checkbox" class="A" onclick="MiscActions('RouteSelector','@route_id', this.checked); " />
                    @if (route_id > 0)
                    {

                        <span>מסלול @route_id</span>
                    }
                    else
                    {
                        <span style="color:#f00">⚠️ ההזמנות הבאות לא משובצות למסלול</span>
                    }



                </div>

                <span style="float: left; padding: 5px; background-color: #fff; margin: 5px; color: #000;font-weight:bold">@route_orders_count <span class="MiniTag">הזמנות</span></span>

                @if (route_serial > 0)
                {
                    <select class="A" style="float:left;display:@driverSelectorDisplayState" onchange="AjaxActions('ChangeRouteDriver', @route_serial, 'MainLoader', @round_id,this.value,@delivery_id,@route_serial);">
                        <option value="0">נהג..</option>
                        @foreach (var driver in drivers)
                        {
                            sqlSelect = "SELECT driver_id FROM routes WHERE driver_id=@0 AND delivery_id=@1";
                            var driverAvailablityCheck = db.QuerySingle(sqlSelect, driver.u_id, delivery_id);
                            if (driverAvailablityCheck == null)
