                    <div class="deliveryToolTip" style="float:left;background-color:#f00">אין משלוחים מתוכננים</div>


                </div>
            }





        </div>
        <div class="B" style="float:left">
            <button class="accordion" style="display:none" id="AccAddDelivery"></button>
            <div class="panel">
                <div class="A" style="float:right;border:2px solid #000;border-radius:5px;background-color:#e3e3e3;color:black">

                    <div class="B">
                        <div class="B">
                            <span class="MiniTag">
                                <b>משלוח חדש</b>
                            </span>

                        </div>
