        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;
        string selOrders = ""; try { selOrders = Request["value"]; } catch { }
        string order_notes = ""; try { order_notes = Request["order_notes"]; } catch { }

        int requested_action = 0; try { requested_action = Convert.ToInt32(Request["requested_action"]); } catch { }
        int driver_id = 0; try { driver_id = Convert.ToInt32(Request["driver_id"]); } catch { }

        int delivery_id = 0; try { delivery_id = Convert.ToInt32(Request["delivery_id"]); } catch { }
        int route_serial = 0; try { route_serial = Convert.ToInt32(Request["route_serial"]); } catch { }
        int round_id = 0; try { round_id = Convert.ToInt32(Request["round_id"]); } catch { }


        string driver_name = "";
        string theHtmlOutput = "";
        string logMsg = "";
        string effected_orders_list = "";
        DateTime local_time = AppFunctions.LocalTime();
        string[] orders;
        string sep = "##";
        orders = selOrders.Split(sep.ToCharArray());

        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "";
        int actionCnt = 0;




        if (requested_action == 0)
        {
            theHtmlOutput += "חובה לבחור פעולה!<br>";
        }
        if (requested_action == 1 && driver_id == 0)
        {
            theHtmlOutput += "חובה לבחור נהג!<br>";
        }

        if (requested_action > 0 && requested_action < 5 && requested_action != 2 && order_notes.IsEmpty())
        {
            theHtmlOutput += "חובה לרשום הערות בפעולה זו!<br>";

        }

        if (theHtmlOutput == "")
        {
            //abort route code
            if (requested_action == 4)
            {
                Rounds.AbortRoute(route_serial, order_notes);
                try { driver_name = AppFunctions.GetRepName(driver_id); } catch { }
