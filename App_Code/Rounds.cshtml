            }
            else
            {
                int new_route_serial = 0;
                int route_id = 0;
                int stop_id = 0;
                if (requested_action == 1)
                {
                    new_route_serial = Rounds.CreateRouteInDeliveryAndReturnSerial(delivery_id, driver_id);
                    sqlSelect = "SELECT route_id FROM routes WHERE serial=@0";
                    var route = db.QuerySingle(sqlSelect, new_route_serial);
                    try { route_id = route.route_id; } catch { }

                }



                foreach (var order in orders)
                {

                    if (!order.IsEmpty())
                    {
                        int order_id = 0; try { order_id = Convert.ToInt32(order); } catch { }

                        theHtmlOutput += order_id.ToString() + "<br>";

                        sqlSelect = "SELECT order_status,username,after_roundup_total,route_id,route_serial,driver_id FROM mainorders WHERE order_id=@0";
