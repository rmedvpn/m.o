                    <div style="float: left;padding: 3px;margin: 3px;"><span style="font-size: 12px;">סגירת הזמנות</span><br>@sched.round_order_close.ToString("HH:mm")</div>
                }

                @if (round.round_type == 4)
                {
                    DateTime defDate = Convert.ToDateTime("1/1/1900");
                    bool is_express = true;
                    DateTime opening_hour = defDate;
                    DateTime closing_hour = defDate;
                    try { opening_hour = sched.express_open; } catch { }
                    try { closing_hour = sched.express_close; } catch { }
                    if (opening_hour == defDate)
                    {
                        try { opening_hour = sched.pickup_open; } catch { }
                        try { closing_hour = sched.pickup_close; } catch { }
                        is_express = false;
                    }

                    <div style="float: left;padding: 3px;margin: 3px;"><span style="font-size: 12px;">שעת סגירה</span><br>@closing_hour.ToString("HH:mm")</div>
                    <div style="float: left;padding: 3px;margin: 3px;"><span style="font-size: 12px;">שעת פתיחה</span><br>@opening_hour.ToString("HH:mm")</div>
                    if (is_express)
                    {
                        <div style="float: left;padding: 3px;margin: 3px;"><br>🛵</div>
                    }
                    else
                    {
                        <div style="float: left;padding: 3px;margin: 3px;"><br>🏠</div>
                    }
                }

            </div>





        }



        <div style="padding: 0;margin: 0;overflow: auto;">

        </div>
    </div>
    <div class="B" style="height:150px;">&nbsp;</div>



    db.Close();
}


