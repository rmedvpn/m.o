    public static void RouteResequnce(int route_serial)
    {
        DateTime local_time = AppFunctions.LocalTime();
        int stop_id = 0;
        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "SELECT order_id,stop_id FROM MainOrders WHERE route_serial>0 AND route_serial=@0 ORDER by stop_id";
        var orders = db.Query(sqlSelect, route_serial);

        if (orders.Count() > 0)
        {
            foreach (var order in orders)
            {
                stop_id++;
                sqlSelect = "UPDATE MainOrders SET stop_id=@0 WHERE order_id=@1";
                db.Execute(sqlSelect, stop_id, order.order_id);
            }
        }
        else
        {
            sqlSelect = "DELETE FROM routes WHERE serial=@0";
            db.Execute(sqlSelect, route_serial);
        }


        db.Close();
    }


    public static void DeliveryResequnce(int delivery_id)
    {
        DateTime local_time = AppFunctions.LocalTime();
        var db = WebMatrix.Data.Database.Open("op_data");
        var sqlSelect = "SELECT * FROM routes WHERE delivery_id=@0 ORDER by serial";
        var routes = db.Query(sqlSelect, delivery_id);
        int route_id = 1;
        int round_id = 0;
        foreach (var route in routes)
        {
            round_id = route.round_id;
            sqlSelect = "SELECT order_id FROM MainOrders WHERE route_serial=@0";
            var order = db.QuerySingle(sqlSelect, route.serial);
            if (order == null)
            {
                sqlSelect = "DELETE FROM routes WHERE serial=@0";
                db.Execute(sqlSelect, route.serial);
            }
            else
            {
                sqlSelect = "UPDATE ROUTES SET route_id=@0 WHERE serial=@1";
                db.Execute(sqlSelect, route_id, route.serial);
                Rounds.RouteResequnce(route.serial);
                route_id++;

            }

        }
        Rounds.reCalcDeliveryStatistics(round_id);

        db.Close();
    }


    public static string SortRouteOrder()
    {
        DateTime local_time = AppFunctions.LocalTime();
        int rep_id = WebMatrix.WebData.WebSecurity.CurrentUserId;

        int sortDir = 0;
        try { sortDir = Convert.ToInt32(Request["value"]); } catch { }
        int route_serial = 0; try { route_serial = Convert.ToInt32(Request["param1"]); } catch { }
        int stop_id = 0; try { stop_id = Convert.ToInt32(Request["param2"]); } catch { }
        int order_id = 0; try { order_id = Convert.ToInt32(Request["param4"]); } catch { }
        string theHtmlOutput = "";
        string logmsg = "";

        var op_data = Database.Open("op_data");
        var sqlSelect = "SELECT * FROM routes WHERE serial=@0";
        var route = op_data.QuerySingle(sqlSelect, route_serial);
        int cur_index = 0;
        int new_index = 0;
        int replacing_order_id = 0;

        if (route != null)
        {
            cur_index = stop_id;
            if (sortDir == 1) //up
            {
                sqlSelect = "SELECT TOP(1) * from MainOrders WHERE stop_id<@0 AND stop_id>0 AND route_serial=@1 ORDER BY stop_id DESC";
                var order = op_data.QuerySingle(sqlSelect, cur_index, route_serial);
                if (order != null)
                {
                    new_index = order.stop_id;
                    replacing_order_id = order.order_id;
                }
            }
            if (sortDir == 2) //desc
            {
                sqlSelect = "SELECT TOP(1) * from MainOrders WHERE stop_id>@0 AND stop_id>0 AND route_serial=@1 ORDER BY stop_id ";
                var order = op_data.QuerySingle(sqlSelect, cur_index, route_serial);
                if (order != null)
                {
                    new_index = order.stop_id;
                    replacing_order_id = order.order_id;
                }
            }
        }

        if (cur_index > 0 && new_index > 0)
        {
            sqlSelect = "UPDATE MainOrders SET stop_id=@0 WHERE order_id=@1";
            op_data.Execute(sqlSelect, new_index, order_id);
            op_data.Execute(sqlSelect, cur_index, replacing_order_id);
        }

        Rounds.RouteResequnce(route_serial);

        theHtmlOutput = " הפעולה בוצעה בהצלחה!";


        op_data.Close();




        return theHtmlOutput;
    }


