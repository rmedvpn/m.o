            sqlSelect = "SELECT * from AppServicesArea WHERE is_active=1";
            var ServiceAreas = db.Query(sqlSelect);
            foreach (var area in ServiceAreas)
            {
                string curAreaFld = "RoundArea_" + area.id;
                string curAreaFreeShippingMarkerFld = "RoundArea_SHFSM_" + area.id;
                string curAreaShippingChargeFld = "RoundArea_SH_" + area.id;
                string curAreaMainAreaIdFld = "RoundAreaMainId_" + area.id;
                decimal area_shipping_charge = 0;
                decimal area_free_shipping_marker = 0;
                int main_area_id = 0;
                bool is_main_area = false;
                sqlSelect = "DELETE FROM RoundAreas WHERE round_id=@0 AND area_id=@1";
                db.Execute(sqlSelect, round_id, area.id);
                if (!Request[curAreaFld].IsEmpty())
                {

                    try { area_shipping_charge = Convert.ToDecimal(Request[curAreaShippingChargeFld]); } catch { }
                    try { area_free_shipping_marker = Convert.ToDecimal(Request[curAreaFreeShippingMarkerFld]); } catch { }
                    try { main_area_id = Convert.ToInt32(Request[curAreaMainAreaIdFld]); } catch { }
                    if (area.id == main_area_id)
                    {
                        is_main_area = true;
