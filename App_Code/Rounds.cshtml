@helper Deliveries(int round_id, int delivery_id = 0)
{

    DateTime local_time = AppFunctions.LocalTime();

    int u_id = WebSecurity.CurrentUserId;
    string username = WebSecurity.CurrentUserName;
    var db = WebMatrix.Data.Database.Open("op_data");
    var sqlSelect = "SELECT * FROM deliveries WHERE round_id=@0 AND z_serial=0  ORDER BY scheduled_start";
    var future_deliveries = db.Query(sqlSelect, round_id);
    sqlSelect = "SELECT active_delivery_id,vendor_id FROM rounds WHERE id=@0";
    var round = db.QuerySingle(sqlSelect, round_id);
    int vendor_id = 0; try { vendor_id = round.vendor_id; } catch { }
    int active_delivery_id = 0; try { active_delivery_id = round.active_delivery_id; } catch { }


    dynamic delivery = null;



    if (delivery_id > 0)
    {
        sqlSelect = "SELECT * FROM deliveries WHERE serial=@0";
        delivery = db.QuerySingle(sqlSelect, delivery_id);

    }

    if (delivery == null)
    {
        sqlSelect = "SELECT * FROM deliveries WHERE has_started=1 AND is_completed=0 AND round_id=@0 ORDER BY actual_start";
        delivery = db.QuerySingle(sqlSelect, round_id);

    }
    if (delivery == null)
    {
        sqlSelect = "SELECT * FROM deliveries WHERE serial=@0";
        delivery = db.QuerySingle(sqlSelect, active_delivery_id);

    }
    if (delivery == null)
    {
        DataFunctions.WriteDebugLine("InitializeRound ");

        //Rounds.InitializeRound(round_id);
        sqlSelect = "SELECT * FROM deliveries WHERE round_id=@0 AND scheduled_start>@1 order by scheduled_start";
        delivery = db.QuerySingle(sqlSelect, round_id, local_time);

    }

    if (delivery != null)
    {
        delivery_id = delivery.serial;
    }
    else
    {
        delivery_id = 0;
    }

    sqlSelect = "SELECT * FROM routes WHERE delivery_id=@0 ORDER BY route_id";
    var routes = db.Query(sqlSelect, delivery_id);

    sqlSelect = "SELECT * FROM MainOrders WHERE is_cancelled=0 AND  z_serial=@0 AND  round_id = @1  AND order_status>=1 AND order_status<=3 AND  ((CAST(requested_delivery_date AS date) <= CAST(@2 AS date) AND delivery_id<=0) ) ORDER BY order_status,envelope_id,order_id DESC ";
    var unAssignedRoundOrders = db.Query(sqlSelect, 0, round_id, local_time);
    sqlSelect = "SELECT * FROM VendorAddresses WHERE vendor_id=@0";
    var VendorAddresses = db.Query(sqlSelect, vendor_id);
    int cur_route_id = 0;
    bool is_active_delivery = false;
    string bgColor = "#ffffff";
    string round_title = AppFunctions.GetRoundTitleById(round_id);

    sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE is_cancelled=0 AND delivery_id=@0"; // order by is_approved, order_id DESC";
    var current_orders = db.QuerySingle(sqlSelect, delivery_id);
    int delivery_orders_counter = 0; try { delivery_orders_counter = current_orders.the_cnt; } catch { }


    sqlSelect = "select * from TeamMembersInRounds WHERE round_id=@0 AND permission_code='ROUNDTEAMLEADER'";
    var RoundTeamLeaders = db.Query(sqlSelect, round_id);
    sqlSelect = "select * from TeamMembersInRounds WHERE round_id=@0 AND permission_code='ROUNDPACK'";
    var RoundPackers = db.Query(sqlSelect, round_id);
    is_active_delivery = false;
    bgColor = "#e3e3e3";
    if (delivery_id == active_delivery_id && delivery_id > 0)
    {
        is_active_delivery = true;
        bgColor = "#fff";
    }

    string OrderCountClass = "NoOrders";
    string tmpOrdersList = "";
    string deliveryStartDivDisplayState = "none;";
    string deliveryEndDivDisplayState = "none;";

    string StartAddressSelectorDivDisplayState = "block;";
    string EndAddressSelectorDivDisplayState = "block;";

    string start_address_street = ""; try { start_address_street = delivery.start_address_street; } catch { }
    string start_address_city = ""; try { start_address_city = delivery.start_address_city; } catch { }
    string end_address_street = ""; try { end_address_street = delivery.end_address_street; } catch { }
    string end_address_city = ""; try { end_address_city = delivery.end_address_city; } catch { }
    int start_address_id = 0; try { start_address_id = delivery.start_address_id; } catch { }
    int end_address_id = 0; try { end_address_id = delivery.end_address_id; } catch { }
    int team_leader_id = 0; try { team_leader_id = delivery.team_leader_id; } catch { }
    int packing_user_id = 0; try { packing_user_id = delivery.packing_user_id; } catch { }
    bool is_team_leader = false; try { is_team_leader = delivery.is_team_leader; } catch { }
    bool has_started = false; try { has_started = delivery.has_started; } catch { }
    bool is_completed = false; try { is_completed = delivery.is_completed; } catch { }
    bool auto_sorted = false; try { auto_sorted = delivery.auto_sorted; } catch { }




    if (start_address_id == -1)
    {
        deliveryStartDivDisplayState = "block;";
        StartAddressSelectorDivDisplayState = "none;";
    }
    else
    {
        start_address_city = "";
        start_address_street = "";
    }
    if (end_address_id == -1)
    {
        deliveryEndDivDisplayState = "block;";
        EndAddressSelectorDivDisplayState = "none;";
    }
    else
    {
        end_address_city = "";
        end_address_street = "";
    }
    if (VendorAddresses.Count() == 0)
    {
        deliveryStartDivDisplayState = "block;";
        deliveryEndDivDisplayState = "block;";
        StartAddressSelectorDivDisplayState = "none;";
        EndAddressSelectorDivDisplayState = "none;";
    }

    <div class="B">
        <input type="hidden" id="is_delivery" name="is_delivery" value="yes" />
        <input type="hidden" id="current_delivery_id" name="current_delivery_id" value="@delivery_id" />
        <div style="overflow:auto;display:none">

            @if (future_deliveries.Count() > 0)
            {


                <div class="B" style="float:left">
                    <div class="deliveryToolTip" style="float:left" onclick="Accordionize('AccAddDelivery');">
                        ➕
                    </div>
                    @if (!has_started)
                    {
                        <div class="deliveryToolTip" style="float:left" onclick="AjaxActions('StartDelivery', @delivery_id, 'MainLoader', document.getElementById('current_delivery_id').value,@round_id);">
                            ▶️ יוצאים לדרך!
                        </div>
                    }



                    <div class="deliveryToolTip" style="float: left; display: none" onclick="Accordionize('DeliveriesSummaryAcc');">🚚 @future_deliveries.Count() משלוחים מתוכננים</div>
                    <div class="deliveryToolTip" style="float: left; display: none" onclick="sbload('GenSb','Caller?p1=RoundCP&p2=@round_id&p3=SCHEDULE');AdjustMainView();">🕖 לוח זמנים</div>
                </div>
            }
            else
            {
                <div class="A" style="float:left;color:#f00;display:none">
