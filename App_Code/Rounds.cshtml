@helper RoundDispatchSettings(int round_id)
{
    System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("he-IL");
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    DateTime round_start = round.round_start;
    DateTime est_end_time = round.estimated_end_time;
    DateTime order_close = DateTime.Now;
    string title = round.title;
    string e_title = round.e_title;
    string description = round.description;
    string e_desc = round.e_desc;
    string comments = round.comments;
    bool is_daily = round.is_every_day;
    bool is_active = round.is_active;
    bool is_open_for_orders = round.is_open_for_orders;
    int vendor_id = round.vendor_id;
    int territory_id = round.territory_id;
    int round_type = round.round_type;
    int estimated_duration = round.estimated_duration;
    int min_to_dispatch = round.min_to_dispatch;
    decimal shipping_charge = round.shipping_charge;
    decimal free_shipping_marker = round.free_shipping_marker;
    decimal discounted_shipping_charge = round.discounted_shipping_charge;
    decimal discounted_shipping_marker = round.discounted_shipping_marker;
    string vendor_name = AppFunctions.GetVendorTitleById(vendor_id);
    string start_date = round.start_date;
    string start_time = round.start_time;


    int shift_leader_id = round.shift_leader_id;
    //strDate = dt.ToString("yyyy'-'MM'-'dd'T'HH':'mm':'ss");

    string express_start_time = round.express_start_time;
    string express_end_time = round.express_end_time;

    int express_eta_min = round.express_eta_min;
    bool is_sh_late_waiver = round.is_sh_late_waiver;

    //////////////////////

    bool is_express = round.is_express;
    bool is_pickup = round.is_pickup;
    bool is_route = round.is_route;
    string round_type_title = NewAppFunctions.GetRoundTypeTitleById(round_type);
    string expressServiceDisplayState = "none";
    string pickupServiceDisplayState = "none";



    ///




    sqlSelect = "SELECT roundAreas.*,AppServicesArea.title from roundAreas JOIN AppServicesArea ON roundAreas.area_id=AppServicesArea.id WHERE round_id=@0 order by main_area_id,is_main_area DESC";
    var CurrentServiceAreas = db.Query(sqlSelect, round_id);

    sqlSelect = "SELECT * from AppServicesArea WHERE is_active=1 AND is_main_area=1";
    // var ServiceAreas = db.Query(sqlSelect);

    sqlSelect = "SELECT * from AppServicesArea WHERE is_active=1 AND is_main_area=1";
    var MainServiceAreas = db.Query(sqlSelect);

    sqlSelect = "SELECT serial from roundAreas WHERE round_id=@0 AND area_id=-1";
    var AllAreasSelected = db.QuerySingle(sqlSelect, round_id);
    bool isAllAreasSelected = false;
    if (AllAreasSelected != null)
    {
        isAllAreasSelected = true;
    }

    //newend



    <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">

        <div class="B" style="">

            @if (round_type == 1)
            {
                <span style="float: left; background-color: #fff; border: 2px solid #57d600; color: #000; font-size: 16px; padding: 5px; margin: 5px;border-radius:5px;">
                    🚚 קו חלוקה
                </span>
            }
            @if (round_type == 5)
            {
                <span style="float: left; background-color: #fff; border: 2px solid #57d600; color: #000; font-size: 16px; padding: 5px; margin: 5px;border-radius:5px;">
                    🚚 תפריט
                </span>
            }


            @if (round_type == 4)
            {
                if (is_express)
                {
                    <span style="float: left; background-color: #fff; border: 2px solid #57d600; color: #000; font-size: 16px; padding: 5px; margin: 5px;border-radius:5px;">
                        🛵 שירות אקספרס
                    </span>


                }

                if (is_pickup)
                {

                    <span style="float: left; background-color: #fff; border: 2px solid #57d600; color: #000; font-size: 16px; padding: 5px; margin: 5px;border-radius:5px;">
                        🏠 איסוף עצמי
                    </span>

                }


            }

            <span style="float: right; color: #000; font-size: 18px; padding: 5px; margin: 5px;">
                @round_type_title <span class="PrplMiniTag">#@round_id</span>
            </span>
        </div>



    </div>

    <div style="overflow: auto;" id="RoundDispatchInfo">


        <div style="padding: 0;margin: 0;overflow: auto;">

            <div style="font-size: 16px;">

                @switch (round_type)
                {
                    case 1: //delivery route
                    case 5: //delivery route
                        <div class="PropSection" id="RoundRouteSettingsView">
                            <div style="overflow:auto;text-align: right;">

                                <div class="PropRow">
                                    <button type="button" class="A" style="float:left" onclick="hideElement('RoundRouteSettingsView');showElement('RoundRouteSettingsEdit');">⚙️</button>
                                    <span> 🚚 הגדרות קו חלוקה</span>
                                </div>

                                <div class="PropRow" style="display:none">
                                    <span class="PropTitle">סגירה הבאה להזמנות</span>

                                    <span class="PropValue">@AppFunctions.FormatRelativeDate(round.order_close_hour) <span class="MiniTag">(יום @AppFunctions.DayOfWeekTxt(((int)round.order_close_hour.DayOfWeek)))</span> @round.order_close_hour.ToString("HH:mm")</span>
                                </div>
                                <div class="PropRow" style="display:none">
                                    <span class="PropTitle">שעת יציאה הבאה</span>
                                    <span class="PropValue">@AppFunctions.FormatRelativeDate(round.round_start) <span class="MiniTag">(יום @AppFunctions.DayOfWeekTxt(((int)round.round_start.DayOfWeek)))</span> @round.round_start.ToString("HH:mm")</span>
                                </div>
                                <div class="PropRow">
                                    <span class="PropTitle">זמן מסלול מוערך</span>

                                    <span class="PropValue">@AppFunctions.FormatStringMinutes(estimated_duration)</span>
                                </div>
                                <div class="PropRow" style="display:none">
                                    <span class="PropTitle">סיום משוער</span>
                                    <span class="PropValue">@AppFunctions.FormatRelativeDate(est_end_time) <span class="MiniTag">(יום @AppFunctions.DayOfWeekTxt(((int)est_end_time.DayOfWeek)))</span> @est_end_time.ToString("HH:mm")</span>
                                </div>
                                <div class="PropRow">
                                    <span class="PropTitle">עלות משלוח</span>
                                    <span class="PropValue">@shipping_charge.ToString("C", culture)</span>
                                </div>
                                <div class="PropRow">
                                    <span class="PropTitle">חינם מעל</span>
                                    <span class="PropValue">@free_shipping_marker.ToString("C", culture)</span>
                                </div>


                                <div class="PropRow">
                                    <span class="PropTitle">הנחיות משלוח</span>
                                    <div class="B">
                                        <span class="PropValue" style="float:right">@round.shipping_instructions</span>
                                    </div>

                                </div>
                                <div class="PropRow">
                                    <div class="B">
                                        <span class="PropTitle">Delivery Information</span>
                                    </div>

                                    <div class="B">
                                        <span class="PropValue" style="float:right">@round.shipping_instructions_e</span>
                                    </div>
                                </div>

                                <div class="PropRow">
                                    <div class="B"><b>אזורי משלוח</b></div>
                                    <div class="B" style="margin:5px;">
                                        @foreach (var curArea in MainServiceAreas)
                                        {
                                            string cssClass = "";
                                            string titlePrefix = "";
                                            string titleSuffix = "";

                                            decimal area_shipping_charge = 0;
                                            decimal area_free_shipping_marker = 0;
                                            int subAreaCount = 0;

                                            bool isMainAreaSelected = false;

                                            sqlSelect = "SELECT * FROM RoundAreas WHERE round_id=@0 AND area_id=@1 ";
                                            var MainAreaSelection = db.QuerySingle(sqlSelect, round_id, curArea.id);
                                            if (MainAreaSelection != null)
                                            {
                                                isMainAreaSelected = true;
                                                area_shipping_charge = MainAreaSelection.shipping_charge;
                                                area_free_shipping_marker = MainAreaSelection.free_shipping_marker;
                                            }

                                            sqlSelect = "SELECT roundAreas.*,AppServicesArea.title from roundAreas JOIN AppServicesArea ON roundAreas.area_id=AppServicesArea.id WHERE round_id=@0 AND roundAreas.main_area_id=@1 AND roundAreas.is_main_area=0 order by main_area_id";
                                            var subAreasForMain = db.Query(sqlSelect, round_id, curArea.id);
                                            if (isMainAreaSelected)
                                            {
                                                cssClass = "GreenPropTag";
                                                titleSuffix = " וכל אזורי המשנה";
                                            }
                                            else
                                            {
                                                cssClass = "GrayPropTag";
                                                titleSuffix = " לאזורים הבאים בלבד ";
                                            }
                                            if (isMainAreaSelected || subAreasForMain.Count > 0)
                                            {
                                                <div class="B" style="margin-bottom:10px;">
                                                    <div class="@cssClass">
                                                        <div class="B">
                                                            <b>@curArea.title</b> @titleSuffix


                                                        </div>
                                                        <div style="float:left">
                                                            @if (area_free_shipping_marker > 0)
                                                            {
                                                                <span class="MiniTag" style="margin: 5px; margin-right: 10px;">
                                                                    חינם מעל @area_free_shipping_marker.ToString("C", culture)
                                                                </span>
                                                            }
                                                            @if (area_shipping_charge > 0)
                                                            {
                                                                <span class="MiniTag" style="margin: 5px; margin-right: 10px;">
                                                                    משלוח @area_shipping_charge.ToString("C", culture)
                                                                </span>
                                                            }

                                                        </div>

                                                    </div>
                                                    <div class="B">

                                                        @foreach (var subArea in subAreasForMain)
                                                        {
                                                            bool isSubAreaSelected = false;
                                                            cssClass = "BluePropTag";
                                                            <div class="@cssClass" style="padding-right: 25px;border-bottom:1px dotted #e3e3e3;font-size:14px;">
                                                                @subArea.title
                                                                <div style="float:left">
                                                                    @if (subArea.shipping_charge > 0)
                                                                    {
                                                                        <span class="MiniTag" style="margin: 5px; margin-right: 10px;">
                                                                            משלוח @subArea.shipping_charge.ToString("C", culture)
                                                                        </span>

                                                                    }

                                                                    @if (subArea.free_shipping_marker > 0)
                                                                    {
                                                                        <span class="MiniTag" style="margin:5px;margin-right:10px;">
                                                                            חינם מעל @subArea.free_shipping_marker.ToString("C", culture)
                                                                        </span>
                                                                    }
                                                                </div>

                                                            </div>

                                                        }

                                                    </div>

                                                </div>

                                            }

                                        }
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="PropSection" id="RoundRouteSettingsEdit" style="display:none">
                            <form id="RoundDeliveriesInfo">

                                <div class="B">
                                    <div style="overflow:auto;text-align: right;">
                                        <div class="PropRow">
                                            <button type="button" class="A" style="float:left" onclick="hideElement('RoundRouteSettingsEdit');showElement('RoundRouteSettingsView');">❌</button>
                                            <span> 🚚 הגדרות קו חלוקה</span>
                                        </div>
                                        <div class="PropRow" style="display:none">
                                            <span class="PropTitle">סגירה הבאה להזמנות</span>

                                            <span class="PropValue"><input type="date" class="PropTextBox" id="start_date" name="start_date" value="@round.order_close_hour.ToString("yyyy'-'MM'-'dd")"></span>
                                            <span class="PropValue"><input type="time" class="PropTextBox" id="start_time" name="start_time" value="@round.order_close_hour.ToString("HH:mm")"></span>
