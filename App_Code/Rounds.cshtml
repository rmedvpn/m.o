    public static void SetupDeliveriesFromRoundSchedules(int round_id = 0)
    {
        DateTime local_time = AppFunctions.LocalTime();
        DateTime defTime = Convert.ToDateTime("1/1/1900");
        DateTime tmp_date = defTime;
        string curTime = defTime.ToShortDateString() + " " + local_time.ToString("HH:mm");
        DateTime Round_Schedule_time = defTime; try { Round_Schedule_time = Convert.ToDateTime(curTime); } catch { }

        int min_to_dispatch = 0; min_to_dispatch = Rounds.GetMinToDispacthForDeliveryRound(round_id);
        int daysDiff = 0;
        string str_date = "";


        int todaysDayOfWeek = ((int)local_time.DayOfWeek);

        var db = Database.Open("op_data");

        var sqlSelect = "SELECT * FROM RoundsSchedules ";
        if (round_id > 0)
        {
            sqlSelect += " WHERE round_id=@0 ";
        }
        sqlSelect += " ORDER BY round_id,dayOfWeek";

        var schedule = db.Query(sqlSelect, round_id);

        foreach (var round_schecdule in schedule)
        {
            int schedule_id = round_schecdule.schedule_id;
            DateTime round_order_close = round_schecdule.round_order_close;
            int dayOfWeek = round_schecdule.dayOfWeek;
            DateTime round_start = round_schecdule.round_start;
            DateTime next_scheduled_delivery = defTime;

            daysDiff = dayOfWeek - todaysDayOfWeek;

            if (daysDiff < 0)
            {
                daysDiff = daysDiff + 7;
            }
            tmp_date = local_time.AddDays(daysDiff);
            str_date = tmp_date.ToShortDateString() + " " + round_order_close.ToString("HH:mm");
            try { tmp_date = Convert.ToDateTime(str_date); } catch { }
            round_order_close = tmp_date;


            tmp_date = local_time.AddDays(daysDiff);
            str_date = tmp_date.ToShortDateString() + " " + round_start.ToString("HH:mm");
            try { tmp_date = Convert.ToDateTime(str_date); } catch { }
            round_start = tmp_date;
            next_scheduled_delivery = round_start;

            DateTime next_scheduled_launch = round_schecdule.next_scheduled_launch;
            DateTime next_scheduled_finish = round_schecdule.next_scheduled_finish;
            int estimated_duration = Rounds.GetEstimatedDurationForDeliveryRound(round_id);
            next_scheduled_launch = next_scheduled_delivery;
            next_scheduled_finish = next_scheduled_launch.AddMinutes(estimated_duration);
            DataFunctions.WriteDebugLine(" schedule_id " + schedule_id + " round_order_close " + round_order_close + " dayOfWeek " + dayOfWeek + " round_start " + round_start + " next_scheduled_delivery " + next_scheduled_delivery + " daysDiff " + daysDiff + " next_scheduled_launch " + next_scheduled_launch + " next_scheduled_delivery " + next_scheduled_delivery + "estimated_duration " + estimated_duration);
            sqlSelect = "UPDATE RoundsSchedules SET next_scheduled_launch=@0,next_scheduled_finish=@1,next_order_close=@2 WHERE schedule_id=@3";
            int new_delivery_id = Rounds.CreateScheduledDeliveryAndReturnId(schedule_id);
            sqlSelect = "UPDATE RoundsSchedules SET next_delivery_id=@0 WHERE schedule_id=@1";
            db.Execute(sqlSelect, new_delivery_id, schedule_id);


        }


        db.Close();
    }




    public static void reCalcDeliveryStatistics(int round_id = 0)
    {
        DateTime local_time = AppFunctions.LocalTime();

        var db = WebMatrix.Data.Database.Open("op_data");

        var sqlSelect = "SELECT serial FROM deliveries ";
        if (round_id > 0)
        {
            sqlSelect += " WHERE round_id=@0";
        }
        var deliveries = db.Query(sqlSelect, round_id);

        foreach (var delivery in deliveries)
        {
            int orders_count = 0;
            int routes_count = 0;
            int drivers_count = 0;
            bool delivery_changed = false;
            int route_id = 1;
            sqlSelect = "SELECT COUNT(order_id) AS the_cnt FROM MainOrders WHERE delivery_id=@0";
            var counter = db.QuerySingle(sqlSelect, delivery.serial);
            try { orders_count = counter.the_cnt; } catch { }

            sqlSelect = "UPDATE deliveries SET orders_count=@0 WHERE serial=@1";
            db.Execute(sqlSelect, orders_count, delivery.serial);

            sqlSelect = "SELECT serial FROM routes WHERE delivery_id=@0 ORDER BY serial";
            var routes = db.Query(sqlSelect, delivery.serial);
            foreach (var route in routes)
            {
                sqlSelect = "SELECT top(1) order_id FROM mainorders WHERE route_serial=@0";
                var orderChk = db.QuerySingle(sqlSelect, route.serial);
                if (orderChk == null)
                {
                    sqlSelect = "DELETE FROM routes WHERE serial=@0";
                    db.Execute(sqlSelect, route.serial);
                    delivery_changed = true;
                }
            }
            if (delivery_changed)
            {
                sqlSelect = "SELECT serial FROM routes WHERE delivery_id=@0 ORDER BY serial";
                routes = db.Query(sqlSelect, delivery.serial);
                foreach (var route in routes)
                {
                    sqlSelect = "UPDATE routes SET route_id=@0 WHERE serial=@1";
                    db.Execute(sqlSelect, route_id, route.serial);
                }
            }




        }


        db.Close();
    }


