@helper RoundSchedule(int round_id)
{
    DateTime local_time = AppFunctions.LocalTime(); ;
    DateTime defTime = Convert.ToDateTime("1/1/1900");

    var db = WebMatrix.Data.Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT * FROM RoundsSchedules WHERE round_id=@0 ORDER BY DayOfWeek,next_scheduled_launch";
    var RoundSchedule = db.Query(sqlSelect, round_id);
    sqlSelect = "SELECT active_delivery_id,round_type FROM Rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    sqlSelect = "SELECT TOP(1) schedule_id FROM RoundsSchedules WHERE round_id=@0 AND next_scheduled_launch>@1 ORDER BY next_scheduled_launch";
    var nextSchedule = db.QuerySingle(sqlSelect, round_id, local_time);
    int active_delivery_id = 0; try { active_delivery_id = round.active_delivery_id; } catch { }
    int round_type = 0; try { round_type = round.round_type; } catch { }
    int next_schedule_id = 0; try { next_schedule_id = nextSchedule.schedule_id; } catch { }

    string icon = "";

    if (round_type == 1)
    {
        <div style="overflow: auto">
            <div style="overflow: auto;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
                לוח זמנים
                <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="showElement('RoundEditScheduleDiv');hideElement('RoundScheduleDiv');">⚙️ עריכה</button>
                <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="AjaxActions('CreateDeliveriesForAllSchedulesInRound', '@round_id','MainLoader', '@round_id','SCHEDULE');">📅 יצירת משלוחים</button>
            </div>

            <div class="A">
                @foreach (var sched in RoundSchedule)
                {
                    int schedule_id = sched.schedule_id;
                    sqlSelect = "SELECT serial,scheduled_start FROM deliveries WHERE schedule_id=@0 ORDER BY scheduled_start";
                    icon = "";
                    string txt_color = "#000";
                    if (sched.next_scheduled_launch < local_time)
                    {
                        txt_color = "#f00";
                    }
                    <div style="padding: 0;margin: 0;overflow: auto;border-bottom: 1px dashed #e3e3e3" onclick="RepAjaxUpdate('Deliveries', 'round_board_container', 'MainLoader', @round_id, @sched.next_delivery_id);">
                        <div style="overflow: auto; float: right">
                            <div class="B" style="float:right">
                                <div class="B" style="padding: 3px;margin: 3px;">
                                    <b>@icon יום @NewAppFunctions.strDayOfWeekFromInt(sched.dayOfWeek)</b>
                                </div>
                                @if (sched.next_scheduled_launch != defTime)
                                {
                                    <div class="B" style="padding: 3px;margin: 3px;font-size: 12px;color:@txt_color">📅 @sched.next_scheduled_launch.ToShortDateString()</div>
                                }
                                else
                                {
                                    <div class="B" style="padding: 3px;margin: 3px;font-size: 12px;">⚠️ <span style="color:#f00">טרם נקבע משלוח למועד זה</span></div>
                                }

                            </div>
                            <div class="B" style="float:right">
                                @if (next_schedule_id == sched.schedule_id)
                                {
                                    <div class="B" style="padding: 5px; margin: 5px; background-color: #b200ff; color: #fff; border-radius: 5px; font-size: 12px; ">
                                        <b>המשלוח הבא</b>
                                    </div>
                                }
                            </div>
                            <div class="B" style="float:right">
                                @if (sched.next_delivery_id == active_delivery_id && active_delivery_id > 0)
                                {
                                    <div class="B" style="padding: 5px; margin: 5px; background-color: #57d600;color:#fff;border-radius:5px;font-size:12px;">
                                        <b>המשלוח הפעיל</b>
                                    </div>
                                }
                            </div>

                        </div>
                        <div style="overflow: auto;float: left;">
                            <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">שעת יציאה</span><br>@sched.round_start.ToString("HH:mm")</div>
                            <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">סגירת הזמנות</span><br>@sched.round_order_close.ToString("HH:mm")</div>
                            @if (sched.next_delivery_id > 0)
                            {
                                <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">#משלוח</span><br>@sched.next_delivery_id</div>
                            }
                            else
                            {
                                <div style="float: left;padding: 3px;margin: 3px;text-align:center">
                                    <span style="font-size: 12px;">#משלוח</span><br>
                                    <button type="button" style="padding: 1px; margin: 1px; font-size: 12px; color: #f00; padding-left: 3px; padding-right: 3px;" onclick="AjaxActions('AddDeliveryToSchedule',@round_id,'MainLoader',  @sched.schedule_id, 'SCHEDULE');">יצירה</button>
                                </div>


                            }

                        </div>

                    </div>
                }
            </div>




            <div style="height: 150px;overflow: auto;">&nbsp;</div>
        </div>
    }
    else
    {
        <div style="overflow: auto">
            <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
                שעות פתיחה
                <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;display:none" onclick="">🥸 איפוס לברירת מחדל</button>
                <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="showElement('RoundEditScheduleDiv');hideElement('RoundScheduleDiv');">⚙️ עריכה</button>
            </div>

            <div class="A">




                @for (int dayOfWeek = 0; dayOfWeek < 7; dayOfWeek++)
                {

                    sqlSelect = "SELECT * FROM RoundsSchedules WHERE DayOfWeek=@0 AND round_id=@1 ORDER BY express_open,pickup_open";
                    var schedule = db.Query(sqlSelect, dayOfWeek, round_id);
                    icon = "";
                    string txt_color = "#000";

                    <div style="padding: 0;margin: 0;overflow: auto;border-bottom: 1px dashed #e3e3e3">
                        <div style="overflow: auto;">
                            <div class="B" style="padding: 3px;margin: 3px;float:right">
                                <b>@icon יום @NewAppFunctions.strDayOfWeekFromInt(dayOfWeek)</b>

                            </div>
                            @if (schedule.Count() > 0)
                            {

                                <div class="B" style="float:left">
                                    @foreach (var sched in schedule)
                                    {
                                        DateTime defDate = Convert.ToDateTime("1/1/1900");
                                        bool is_express = true;
                                        DateTime opening_hour = defDate;
                                        DateTime closing_hour = defDate;
                                        try { opening_hour = sched.express_open; } catch { }
                                        try { closing_hour = sched.express_close; } catch { }
                                        if (opening_hour == defDate)
                                        {
                                            try { opening_hour = sched.pickup_open; } catch { }
                                            try { closing_hour = sched.pickup_close; } catch { }
                                            is_express = false;
                                        }
                                        <div class="B">
                                            <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">שעת סגירה</span><br>@closing_hour.ToString("HH:mm")</div>

                                            <div style="float: left; padding: 3px; margin: 3px; text-align: center"><span style="font-size: 12px;">שעת פתיחה</span><br>@opening_hour.ToString("HH:mm")</div>
                                            @if (is_express)
                                            {
                                                <div style="float: left;padding: 3px;margin: 3px;"><br>🛵</div>
                                            }
                                            else
                                            {
                                                <div style="float: left;padding: 3px;margin: 3px;"><br>🏠</div>
                                            }

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="B" style="float:left">
                                    <div class="B" style="padding: 3px; margin: 3px; color: #f00;">
                                        סגור

                                    </div>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>

            <div style="height: 150px;overflow: auto;">&nbsp;</div>
        </div>
    }



    db.Close();
}


