@helper RoundTeamSettings(int round_id, int vendor_id)
{
    var db = Database.Open("op_data");
    var sqlSelect = "";
    sqlSelect = "SELECT * from teamMembersInRounds WHERE round_id=0 AND permission_id=0 AND vendor_id=@0";
    var VendorTeam = db.Query(sqlSelect, vendor_id);
    //sqlSelect = "SELECT * FROM irgoon.VendorPermissions WHERE vendor_id=@0 AND round_id=@1 ORDER BY u_id";
    //var roundVendorTeam = db.Query(sqlSelect,vendor_id,round_id);
    sqlSelect = "SELECT * FROM AppPermissionCodes WHERE permission_group='ROUND' ORDER BY sort_order";
    var roundPermissons = db.Query(sqlSelect);

    sqlSelect = "SELECT u_id FROM teamMembersInRounds WHERE vendor_id=@0 AND round_id=@1 GROUP BY u_id ORDER BY u_id";
    var teamMembersInRounds = db.Query(sqlSelect, vendor_id, round_id);


    <div style="overflow: auto;font-size: 18px;background-color: #ffffcc">
        <div style="overflow: auto;padding: 5px;border-bottom: 1px dotted #000">
            <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="Accordionize('AddTeamMembersAcc');">הוספה</button>
            <B>צוות</B> <span style="font-size: 16px;padding: 2px;color: #b200ff">@AppFunctions.GetVendorTitleById(vendor_id) #@vendor_id</span>
            <div class="spinner" style="text-align: center;display: none;float: left" id="RoundTeamSettingsLoader">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>
        <button class="Accordion" style="display: none" id="AddTeamMembersAcc"></button>
        <div class="panel" style="padding: 0;margin: 0">
            <div style="overflow: auto">
                <div style="overflow: auto">
                    <form id="teamAddForm">
                        <div style="overflow: auto">הוספת חבר/ת צוות</div>
                        <select style="padding: 5px;margin: 5px;font-size: 16px;float: right" name="team_member_id">
                            <option>נא לבחור חבר/ת צוות</option>
                            @foreach (var teamMember in VendorTeam)
                            {
                                <option value="@teamMember.u_id">@teamMember.username</option>
                            }
                        </select>
                        <select style="padding: 5px;margin: 5px;font-size: 16px;float: right" name="permission_id">
                            <option>נא לבחור הרשאה</option>
                            @foreach (var roundPermisson in roundPermissons)
                            {
                                <option value="@roundPermisson.id">@roundPermisson.title</option>
                            }
                        </select>
                        <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;float: right" onclick="AjaxActions('AddVendorTeamMemberToRound', @vendor_id,'GenSbLoader','teamAddForm',@round_id,'','TEAM');">הוספה</button>
                    </form>
                </div>
            </div>
        </div>
        <div style="padding:5px;margin: 0;overflow: auto;background-color: #fff">
            @if (teamMembersInRounds.Count() == 0)
            {
                <div style="color: #f00;padding: 5px;font-size: 16px;">אין אנשי צוות משוייכים</div>
            }
            else
            {
                foreach (var teamMember in teamMembersInRounds)
                {
                    sqlSelect = "SELECT * FROM teamMembersInRounds WHERE vendor_id=@0 AND round_id=@1 AND u_id=@2 ORDER BY sort_order";
                    var TeamMemberPermissions = db.Query(sqlSelect, vendor_id, round_id, teamMember.u_id);

                    <div style="color: #000;padding: 5px;margin: 5px;font-size: 16px;border-bottom: 1px dotted #e3e3e3;overflow: auto">

                        <b>@AppFunctions.GetRepName(teamMember.u_id)</b>

                        <div style="float: left;color: #000;">
                            @foreach (var item in TeamMemberPermissions)
                            {
                                <span style="border-radius: 5px;float: left;padding: 5px;margin: 5px;"><input type="checkbox" onclick="AjaxActions('RemoveVendorTeamMemberFromRound', @vendor_id,'GenSbLoader',@item.u_id,@round_id,@item.permission_id,'TEAM');" style="padding: 5px;margin: 5px;" checked> @NewAppFunctions.GetTitleById("VendorPermission", item.permission_id) </span>
                            }

                        </div>
                    </div>
                }
            }
        </div>
    </div>


    db.Close();
}

@helper RoundControlPanel(int round_id, string viewMode = "GENERAL")
{
    var db = Database.Open("op_data");
    var sqlSelect = "SELECT * FROM rounds WHERE id=@0 ";
    var round = db.QuerySingle(sqlSelect, round_id);
    if (round != null)
    {
        bool is_setup = round.is_setup;
        bool is_active = round.is_active;
        bool is_deleted = round.is_deleted;
        bool in_delivery_mode = round.in_delivery_mode;
        int vendor_id = round.vendor_id;
        int round_type = round.round_type;

        <input type="hidden" name="sRound_id" id="sRound_id" value="@round_id">
        <div style="padding: 0;margin: 0;overflow: auto;direction:rtl">

            <div style="background-color:  #000; overflow: auto; font-size: 24px; color: #fff;">

                @round.title <span style="font-size:12px;">#@round.id</span>
                @if (!is_active)
                {<span style="font-size:12px;margin-right:10px;background-color:#f00;color:yellow;padding:2px;"><b>לא פעיל</b></span>}
                <select name="viewType" style="padding: 3px;margin: 3px;font-size: 16px;float: left;margin-left: 10px;" onchange="RepAjaxUpdate('RoundSettingsView', 'GenSbContent', 'GenSbLoader',@round_id, this.value)">

                    <option value="GENERAL" @if (viewMode == "GENERAL") { <text> selected</text>}>הגדרות כלליות</option>
                    <option value="INVENTORY" @if (viewMode == "INVENTORY") { <text> selected</text>}>הגדרות מלאי</option>


                    @if (round_type == 1)
                    {
                        <option value="SCHEDULE" @if (viewMode == "SCHEDULE") { <text> selected</text>}>לוח זמנים</option>
                    }
                    else
                    {
                        <option value="SCHEDULE" @if (viewMode == "SCHEDULE") { <text> selected</text>}>שעות פתיחה</option>
                    }

                    @if (round_type == 1)
                    {
                        <option value="ROUND" @if (viewMode == "ROUND") { <text> selected</text>}>הגדרות קו חלוקה</option>
                    }
                    else
                    {
                        <option value="ROUND" @if (viewMode == "ROUND") { <text> selected</text>}>הגדרות תחנה מקומית</option>
                    }

                    <option value="TEAM" @if (viewMode == "TEAM") { <text> selected</text>}>הגדרות צוות</option>
                    <option value="DELIVERY" @if (viewMode == "DELIVERY") { <text> selected</text>}>הגדרות משלוחים</option>
                </select>
            </div>

            <div style="text-align: right;font-size: 18px;padding: 0;margin: 0;color: #000;min-height: 600px;overflow: auto;background-color: #fff">


                @if (is_deleted)
                {
                    <div style="overflow: auto;background-color:yellow;padding: 5px;margin: 5px;border: 2px solid #f00">
                        <div style="overflow: auto">
                            הערוץ נמחק!

                        </div>

                    </div>
                }

                @if (!is_setup)
                {
                    <div style="overflow: auto;background-color:#ffcccc;padding: 5px;margin: 5px;border: 2px solid #f00">
                        <div style="overflow: auto">
                            הפעלת ערוץ זה במערכת לא הושלמה!<div style="overflow: auto;font-size: 12px;">הערוץ '@round.title' לא מוצג כעת במערכת</div>
                            <button type="button" style="padding: 5px;margin: 5px;font-size: 16px;background-color: #e3e3e3;color: #000;float: left" onclick="AjaxActions('RoundFinishSetup', @round_id,'', 'RoundBasicInfo');">הפעלה</button>
                        </div>

                    </div>
                }


                @if (in_delivery_mode)
                {
                    <div style="overflow: auto;background-color:#b4dfff;padding: 5px;margin: 5px;border: 2px solid #f00">
                        מצב חלוקה <button style="font-size: 16px;padding: 5px;margin: 5px;float: left">ביטול מצב חלוקה</button>
                    </div>
                }


                <div style="overflow: auto" id="CurViewDiv">

                    @switch (viewMode)
                    {

                        case "GENERAL":
                            <div style="overflow: auto;">
                                @AdminPages2.RoundGeneralSettings(round_id)
                            </div>
                            <div style="overflow: auto; display: none">
                                Rounds.RoundDispatchSettings(round_id)
                            </div>
                            break;
                        case "INVENTORY":
                            <div style="overflow: auto">
                                <div style="overflow: auto">
                                    <div style="background-color: #fff;" id="RoundInventorySourcesDiv">
                                        AdminRounds.RoundInventorySources(round_id)
                                    </div>
                                </div>
                            </div>
                            break;
                        case "SCHEDULE":
                            <div style="overflow: auto;">
                                <input type="hidden" id="RoundScheduleReload" value="1" />
                                <input type="hidden" id="RoundScheduleReloadId" value="@round_id" />
                                <div style="background-color: #fff;" id="RoundScheduleDiv">
                                    @Rounds.RoundSchedule(round_id)
                                </div>
                                <div style="background-color: #fff;display: none" id="RoundEditScheduleDiv">
                                    @Rounds.RoundEditSchedule(round_id)
                                </div>
                            </div>

                            break;
                        case "ROUND":
                            <div style="overflow: auto;">
                                @Rounds.RoundDispatchSettings(round_id)
                            </div>
                            break;
                        case "TEAM":
                            <div style="overflow: auto;">
                                <div style="overflow: auto;" id="RoundTeamSettingsDiv">
                                    @Rounds.RoundTeamSettings(round_id, vendor_id)
                                </div>
                            </div>
                            break;
                        case "DELIVERY":
                            <div style="overflow: auto;">
                                <div style="overflow: auto;;padding: 5px;font-size: 18px;font-weight: bold;border-bottom: 1px dotted #000;background-color: #ffffcc">
                                    ניהול משלוחים
                                    <button type="button" style="float: left;padding: 2px;margin: 2px;background-color: #000;color: #fff;font-size: 16px;" onclick="Accordionize('AddRoundDeliveryAcc');">הוספת משלוח</button>
                                </div>

                                <div style="overflow: auto" id="RoundSettingsDeliveriesDiv">

                                    AdminRounds.RoundSettingsDeliveries(round_id)


                                </div>

                            </div>
                            break;

                        default:
                            <div style="overflow: auto;">
                                vmn: @viewMode
                            </div>
                            break;

                    }

                </div>















            </div>




            <div style="overflow: auto;height: 100px;">&nbsp;</div>

        </div>

    }
    else
    {
        Response.Write("round: " + round_id);
    }

    db.Close();
}


