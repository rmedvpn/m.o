@{
    
/*
Registration Page

This App requires pre-approval to register.
This page accepts a pre approval identifier and retrieves the pre approval info.
After that this is a Standard Registration Form using WebSecurity
*/

 Layout = "~/Shared/Layouts/_Layout.cshtml";
Page.Title = "הרשמה";
var wa_num = "";
var password1 = "";
var password2 = "";
var user_nick="";
var telegram_nick=""; 
var telegram_number="";
var accountType="";

     

 if(IsPost)
    {
        WebSecurity.Logout();
        wa_num = Request["wa_num"];
        user_nick = Request["user_nick"];
        password1 = Request["password1"];
        password2 = Request["password2"];
        telegram_nick = Request["telegram_nick"];
        telegram_number = Request["telegram_number"];
        accountType = Request["accountType"];
     
 // Validation
            if (user_nick.IsEmpty()) {
            ModelState.AddError("user_nick", "שדה חובה!");
        }

        if (!ValidationFunctions.IsAlphaNumeric(user_nick)) {
            ModelState.AddError("user_nick", "שם משתמש צריך להכיל מספרים ואותיות בלבד!");
        }
       
 if (password1.IsEmpty()) {
            ModelState.AddError("password1", "שדה חובה!");
        }
 if(WebSecurity.UserExists(user_nick))
        {
            ModelState.AddError("user_nick", "שם משתמש רשום כבר במערכת");
        }
 if(password1 != password2)
        {
            ModelState.AddError("password1", "הסיסמאות לא תואמות");
        }


        if (Request["terms_accept"].IsEmpty())
                {
            ModelState.AddError("terms_accept", "שדה חובה!");
        }
        


 // Create Account
        if(ModelState.IsValid)
        {
            WebSecurity.CreateUserAndAccount(user_nick, password1, null, false);
            WebSecurity.Login(user_nick, password1);
            var u_id = WebSecurity.CurrentUserId;
            var db = Database.Open("tlg");
            var sqlSelect = "Update members set telegram_nick=@0,telegram_number=@1,user_type=@2 WHERE userID=@3"; 
            db.Execute(sqlSelect,telegram_nick,telegram_number,accountType,u_id);
            
          
                Response.Redirect("Main" );
           
        }
    }
 }
  <div class="login-card" style="font-size: 24px;border-radius: 15px;">
 <h1><u>הרשמה</u></h1>
      <ul style="font-size: 12px;">
        <li>ההצטרפות מגיל 18, אין יוצאים מהכלל</li>
        <li>הגעת למערכת קהילתית סגורה המיועדת לצרכני קנאביס רפואי. אם הנך נציג/ה של רשויות אכיפת החוק, בבקשה ללחוץ כאן</li>
        <li><small style="color: #f00"><br>כל השדות הם חובה</small></li>
      </ul>

<form action="Register" method="post" >
    <p>
      
        @Html.Label("שם משתמש:", "user_nick")<br />
        @Html.TextBox("user_nick", user_nick) <br />
        @Html.ValidationMessage("user_nick")
    </p>
    <p>
        @Html.Label("סיסמא:", "password1")<br />
        @Html.Password("password1", password1) <br />
        @Html.ValidationMessage("password1")
    </p>
    <p>
        @Html.Label("אישור סיסמא:", "password2")<br />
        @Html.Password("password2", password2)
    </p>
     <p>
      
        @Html.Label("מספר ווטסאפ מזוהה:", "wa_num")<br />
        @Html.TextBox("wa_num", wa_num) <br />
        @Html.ValidationMessage("wa_num")
    </p>
    
    <br>
    <p>
        בהרשמה , את/ה מקבל/ת עליך את <b><a href="~/terms">תנאי החברות בקהילה</a></b><br><br>
         @Html.CheckBox("terms_accept", false)
        @Html.Label("קראתי ואני מסכימ/ה!", "terms_accept")<br />
          @Html.ValidationMessage("terms_accept")
       
    </p>
    <p>
         <input type="submit" value="הבא" />
    </p>
</form>

</div>