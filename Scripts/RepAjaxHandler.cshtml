                string[] FieldsArr;
                string sep = ",";
                FieldsArr = sqlTxt.Split(sep.ToCharArray());
                string sqlInsertTxt = "INSERT INTO TABLE (";
                int itemIndex = 0;
                string recName = "rec";

                foreach (var item in FieldsArr)
                {
                    sqlInsertTxt += item + ",";

                }
                sqlInsertTxt = sqlInsertTxt.Remove(sqlInsertTxt.Length - 1, 1);
                sqlInsertTxt += ") VALUES(";
                foreach (var item in FieldsArr)
                {
                    sqlInsertTxt += "@" + itemIndex + ",";
                    itemIndex++;
                }
                sqlInsertTxt = sqlInsertTxt.Remove(sqlInsertTxt.Length - 1, 1);
                sqlInsertTxt += ") ";
                sqlInsertTxt += Environment.NewLine;
                sqlInsertTxt += " op_data.Execute(sqlSelect,";
                foreach (var item in FieldsArr)
                {
                    sqlInsertTxt += recName + "." + item + ",";
                    itemIndex++;
                }
                sqlInsertTxt = sqlInsertTxt.Remove(sqlInsertTxt.Length - 1, 1);
                sqlInsertTxt += ") ";

                <div style="overflow:auto;font-size:12px;padding:5px;margin:5px;">@sqlTxt</div>
                <textarea style="overflow:auto;font-size:16px;padding:5px;margin:5px;">@sqlInsertTxt</textarea>

            }
            break;

