        case "CalcNewList":
            if (true)
            {
                int min_order_count = 0;
                DateTime emptyDate = Convert.ToDateTime("1/1/1900");
                DateTime max_order_date = emptyDate;
                DateTime min_order_date = emptyDate.AddYears(100);
                bool unassigned_only = true;

                if (Request["unassigned_only"].IsEmpty())
                {
                    unassigned_only = false;
                }

                try { min_order_count = Convert.ToInt32(Request["min_order_count"]); } catch { }
                try { max_order_date = Convert.ToDateTime(Request["max_order_date"]); } catch { }
                try { min_order_date = Convert.ToDateTime(Request["min_order_date"]); } catch { }
                var db = Database.Open("op_data");
                var sqlSelect = "select COUNT(u_stats.serial) AS the_cnt from u_stats JOIN pb ON u_stats.serial = pb.m_id WHERE u_stats.order_count>=@0 AND u_stats.last_order_ts<@1 AND u_stats.last_order_ts>@2";
                string strStartsWith = Request["StartsWith"];
                string tmp = sqlSelect;

                if (!strStartsWith.IsEmpty())
                {
                    try { strStartsWith = strStartsWith.Replace(",", "##"); } catch { }
                    string[] StartsWithArr;
                    string sep = "##";
                    StartsWithArr = strStartsWith.Split(sep.ToCharArray());
                    string curOpertor = " AND (";

                    foreach (var searchterm in StartsWithArr)
                    {
                        if (!searchterm.IsEmpty())
                        {
                            tmp = tmp + curOpertor + " pb.member_name LIKE N'" + searchterm + "%'";
                            curOpertor = " OR ";
                        }

                    }
                    tmp = tmp + " )";

                }
                if (unassigned_only)
                {
                    tmp = tmp + " AND preserve_rep=0";
                }


                sqlSelect = tmp;

                if (max_order_date == emptyDate)
                {
                    max_order_date = Convert.ToDateTime("1/1/2199");
                }

                var rs = db.QuerySingle(sqlSelect, min_order_count, max_order_date, min_order_date);
                int counter = 0;
                try { counter = rs.the_cnt; } catch { counter = -1; }

                if (counter <= 0)
                {
                    <div style="color: #f00">
                        לא נמצאו משתמשים
                    </div>
                }
                else
                {
                    <div style="color: #b200ff">
                        @counter משתמשים ברשימה
                        <form id="ListPreviewForm">
                            <button type="button" style="padding: 2px;margin: 2px;font-size: 12px;float: right;border: 0" onclick="callerSidebar='MainSb';sbload('SubMenu','Caller?p1=MembersListPreview','','ListPreviewForm');">🔍</button>
                            <input type="hidden" name="min_order_count" value="@Request["min_order_count"]">
                            <input type="hidden" name="max_order_date" value="@Request["max_order_date"]">
                            <input type="hidden" name="min_order_date" value="@Request["min_order_date"]">
                            <input type="hidden" name="StartsWith" value="@Request["StartsWith"]">
                            <input type="hidden" name="unassigned_only" value="@Request["unassigned_only"]">
                        </form>

                    </div>
                }
                db.Close();
            }
            break;



