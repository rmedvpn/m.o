if(theAction=="LoadProspectTemplate")
{
        int prospect_id=0; try{prospect_id=Convert.ToInt32(Request["param1"]);}catch{}
        int template_id=0; try{template_id=Convert.ToInt32(Request["param2"]);}catch{}
        <div style="overflow: auto;">
        @AppHelpers.LoadProspectTemplate(prospect_id,template_id)
        </div>

}

if(theAction=="LoadReachOutTemplate")
{
        int member_id=0; try{member_id=Convert.ToInt32(Request["param1"]);}catch{}
