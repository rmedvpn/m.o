                int moveDir = 0; if (theField == "ProdCustomFieldMoveUp") { moveDir = 1; }
                int currListIndex = 0;
                int newListIndex = 0;
                int listCount = 0;
                int replacingListIndex = 0;
                sqlSelect = "SELECT * FROM ProductsCustomFields WHERE id=@0";
                var fieldRs = db.QuerySingle(sqlSelect, field_id);
                try { currListIndex = fieldRs.listindex; } catch { }
                sqlSelect = "SELECT COUNT(id) as the_cnt FROM ProductsCustomFields WHERE is_activated=1 AND p_id=@0";
                fieldRs = db.QuerySingle(sqlSelect, p_id);
                try { listCount = fieldRs.the_cnt; } catch { }
                bool is_sequencing = false;
                bool is_update = false;
                if (moveDir == 0)
                { //move down -->replace with bottom field or if last field make first and push the list
                    if (currListIndex == listCount)
                    {
                        newListIndex = -1;
                        is_sequencing = true;
                        is_update = true;
                    }
                    else
                    {
                        newListIndex = currListIndex + 1;
                        sqlSelect = "UPDATE ProductsCustomFields SET listIndex=@0 WHERE p_id=@1 AND listIndex=@2";
                        db.Execute(sqlSelect, currListIndex, p_id, newListIndex);
                        is_update = true;
                    }
                }
                else
                { //move up -->replace with upper field or if first field make first and push the list
                    if (currListIndex == 1)
                    {
                        newListIndex = listCount + 1;
                        is_sequencing = true;
                        is_update = true;
                    }
                    else
                    {
                        newListIndex = currListIndex - 1;
                        sqlSelect = "UPDATE ProductsCustomFields SET listIndex=@0 WHERE p_id=@1 AND listIndex=@2";
                        db.Execute(sqlSelect, currListIndex, p_id, newListIndex);
                        is_update = true;

                    }
                }

                if (is_update)
                {
                    sqlSelect = "UPDATE ProductsCustomFields SET listIndex=@0 WHERE id=@1";
                    db.Execute(sqlSelect, newListIndex, field_id);
                }
                if (is_sequencing)
