                int currListIndex = 0;
                int newListIndex = 0;
                int listCount = 0;
                int replacingListIndex = 0;
                var db = Database.Open("op_data");
                var sqlSelect = "SELECT * FROM ProductsCustomFields WHERE id=@0";
