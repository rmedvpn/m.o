@{

Random rnd = new Random();
int icon_id = rnd.Next(1, 5);  // 1 <= month < 13
var menu_icon="Images/icon" + Convert.ToString(icon_id) + ".jpg";

   if (!WebSecurity.IsAuthenticated){
        Response.Redirect("~/");
      }

int u_id = WebSecurity.CurrentUserId;
bool is_mokdan=false;
    
    var db = Database.Open("tlg");
    var sqlSelect="SELECT is_mokdan FROM irgoon.Members Where UserId = @0"; 
    var user = db.QuerySingle(sqlSelect,u_id);
    db.Close();
    if (user!=null)
        {
            if(user.is_mokdan)
            {
                 is_mokdan=true;
            }
       }


}

