@{
      if (!WebSecurity.IsAuthenticated){Response.Redirect("~/");}
      

int u_id=WebSecurity.CurrentUserId;
string username = WebSecurity.CurrentUserName;
Layout = "~/Shared/Layouts/_MiniLayout.cshtml";
string PageTitle="";

var db = Database.Open("irgoon");
var sqlSelect="";

int member_id=0;
try{member_id=Convert.ToInt32(Request["member_id"]);}catch{}

sqlSelect = "select * from irgoon.irgUsers WHERE userId=@0";
var memberRs = db.QuerySingle(sqlSelect,member_id);

string wanum="";
if(memberRs!=null){
    wanum=memberRs.wanum;
}

sqlSelect= "Select * from irgoon.MasterWebOrders WHERE wanum=@0 ORDER BY ts DESC";
var userOrders=db.Query(sqlSelect,wanum);

decimal avgDaysBetweenOrders=0;
int total_orders=0;

db.Close();

}
<!DOCTYPE html>
<html>
<head>
 

</head>
<body>

<div class="heart" style="text-align: center;z-index: 99999;position: fixed;bottom: 75px;width: 50%;right: 25%;left: 25%;;text-align: center;opacity: 0.8;background: transparent;" id="ControlButtonDiv">
              <button id="ControlButton" onclick="controller.close('Info');"  style="border: 0;background-color: #e3e3e3;border-radius: 50%;font-size: 30px;z-index: 99999;padding: 5px;" >
                       ❎
              </button>
</div>


   @if(memberRs!=null){

        <div style="overflow: auto;font-weight: bold;font-size: 30px;padding: 5px;">
            <span style="float: left;font-weight: normal;font-size: 14px;">מזמינה/ב בממוצע כל <span  style="color: #57d600;font-weight: bold;">@Convert.ToInt32(memberRs.avgDaysBetweenOrders)</span> ימים</span>
            @memberRs.pbname
        </div>
  <div style="overflow: auto;-webkit-overflow-scrolling: touch;width: 100%;height: 100%;">
 
    <div style="overflow: auto;">
        
        <div style="overflow: auto;">
        <button class="accordion" id="UserInfoAcc" style="display: none;"></button>
        <div class="panel">
            <div>
                הזמנה ראשונה:  @memberRs.first_order_ts<br>
                הזמנה אחרונה:  @memberRs.first_order_ts<br>
            </div>
        </div>
        </div>
        <h2>היסטורית הזמנות</h2>
    @foreach(var order in userOrders){
        TimeSpan DaysSinceOrder = DateTime.Now - order.ts;
        var DaysSinceOrderInt = DaysSinceOrder.Days;
        <div style="overflow: auto;padding: 5px;margin: 5px;background-color: #e3e3e3;">
       <div style="overflow: auto;font-size: 14px;color: #b200ff">
           <span style="float: left;padding-left: 5px;">לפני @DaysSinceOrderInt ימים</span>
        @order.ts.ToShortDateString()</div>
        <div style="overflow: auto">@order.orderBody</div>
        </div>
    }
    </div>
    

      
</div>
    }


</body>
</html>
