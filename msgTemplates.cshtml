@{
      if (!WebSecurity.IsAuthenticated){Response.Redirect("~/");}
      

int u_id=WebSecurity.CurrentUserId;
string username = WebSecurity.CurrentUserName;
Layout = "~/Shared/Layouts/_MiniLayout.cshtml";
string PageTitle="";

var db = Database.Open("irgoon");
var sqlSelect="";

int member_id=0;
try{member_id=Convert.ToInt32(Request["id"]);}catch{}

sqlSelect = "select * from irgoon.msgTemplates where created_by=0 OR created_by=@0 order by created_by desc,id desc";
var msgTemplates = db.Query(sqlSelect,u_id);

db.Close();

}
<!DOCTYPE html>
<html>
<head>
 

</head>
<body>

<div class="heart" style="text-align: center;z-index: 99999;position: fixed;bottom: 75px;width: 50%;right: 25%;left: 25%;;text-align: center;opacity: 0.8;background: transparent;" id="ControlButtonDiv">
              <button id="ControlButton" onclick="controller.close('Info');"  style="border: 0;background-color: #e3e3e3;border-radius: 50%;font-size: 30px;z-index: 99999;padding: 5px;" >
                       ❎
              </button>
</div>



        <div style="overflow: auto;font-weight: bold;font-size: 30px;padding: 5px;">
               <button style="float: left;padding: 5px;margin: 5px;background-color: #fff;border: 2px solid #808080;font-size: 16px;font-weight: bold" onclick="Accordionize('newTemplate');">תבנית חדשה</button>
עריכת תבניות הודעה
        </div>
    <div style="overflow: auto;">
    <button class="accordion" style="display: none;" id="newTemplate"></button>
    <div class="panel" style="padding: 0;margin: 0">
        <div style="overflow:auto;padding: 5px;margin: 5px;border: 1px dotted #b200ff">
            <form id="NewTemplateForm">
            <input type="text" style="font-size: 16px;margin:5px;padding:5px;width: 95%" placeholder="כותרת לתבנית" id="templateTitle" name="templateTitle"><br>
            <select style="font-size: 16px;padding: 5px;margin: 5px;width: 97%" id="msgType" name="msgType">
            <option value="">נא לבחור סוג תבנית</option>
            <option value="REACHOUT" selected>שימור</option>
            <option value="PROSPECT">צירוף</option>
            </select>
            </form>
            <div style="overflow: auto;">
                <button style="font-size: 16px;padding: 5px;margin: 5px;font-weight: bold;background-color: #57d600;color: #fff;" onclick="AjaxActions('NEWMSGTEMPLATE',0,1);">שמירת שינוים</button>
                <button style="font-size: 16px;padding: 5px;margin: 5px;font-weight: bold;background-color: #f00;color: #fff;float: left" onclick="Accordionize('newTemplate');">לא משנה</button>
            </div>
        </div>

    </div>
    </div>


  <div style="overflow: auto;-webkit-overflow-scrolling: touch;width: 100%;height: 100%;">
      @foreach(var msgTmp in msgTemplates){
          string rowBgColor="#fff";
          bool is_new=false;
          if(msgTmp.is_new){
              rowBgColor="#ffffcc";
              is_new=true;
          }
          <div style="overflow: auto;padding: 5px;font-size: 18px;border-bottom: 1px dashed #808080;background-color: @rowBgColor">
              @if(is_new){
                  <span style="float: left;font-size: 12px;color: #000;font-weight: bold"><u>תבנית חדשה, נא לערוך</u></span>
              }
            @msgTmp.msg_title 
            @if(msgTmp.created_by==0){
                <br><span style="font-size: 12px;color: #b200ff">תבנית מערכת</span>
            }else{
                <br><span style="font-size: 12px;color: #57d600">יצרת את התבנית ב<span>@msgTmp.create_ts.ToShortDateString() @msgTmp.create_ts.ToString("HH:mm")</span></span>
            }

              @if(msgTmp.created_by==u_id){
              <span style="float: left"><button style="font-size: 12px;margin: 5px;padding: 5px;font-weight: bold;color: #fff;background-color: #57d600"  onclick="sbload('SubMenu','MsgEditor?id=@msgTmp.id');" id="TemplateGoBtn_@msgTmp.id">עריכה</button></span>
              <span style="float: left"><button style="font-size: 12px;margin: 5px;padding: 5px;font-weight: bold;color: #fff;background-color: #f00" onclick="hideElement('TemplateGoBtn_@msgTmp.id');;hideElement('TemplatedelBtn_@msgTmp.id');showElement('TemplatedelApp_@msgTmp.id');" id="TemplatedelBtn_@msgTmp.id">מחיקה</button>
                  <span style="float: left;display: none;color: #f00;font-size: 12px;font-weight: bold" id="TemplatedelApp_@msgTmp.id">
                      <input type="checkbox" style="padding: 5px;margin: 5px;width: 20px;height: 20px;" onclick="AjaxActions('DELTEMPLATE',@msgTmp.id,1);">בדוק? 
                      <button style="font-size: 12px;margin: 5px;padding: 5px;font-weight: bold;color: #fff;background-color: #b200ff" onclick="showElement('TemplatedelBtn_@msgTmp.id');hideElement('TemplatedelApp_@msgTmp.id');showElement('TemplateGoBtn_@msgTmp.id');">ביטול</button>
                  </span> 
              </span>

              }
              else{
              <span style="float: left"><button style="font-size: 12px;margin: 5px;padding: 5px;font-weight: bold;color: #fff;background-color: #57d600"  onclick="sbload('SubMenu','MsgEditor?id=@msgTmp.id');">עריכה</button></span>
              }

          </div>
      }




<div style="overflow: auto;height: 200px;">&nbsp;</div>
</div>

</body>
</html>
