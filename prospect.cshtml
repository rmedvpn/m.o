         <button id="MsgSentBtn" style="font-size: 16px;text-align: center;color: #fff;background-color: #b200ff;border:2px solid #b200ff;padding: 5px;margin: 5px;width: 90%;font-weight: bold;display: none" onclick="AjaxActions('PROSPECTMSGSENT',@memberRs.serial,1);">הודעת צירוף נשלחה ל<span>@memberRs.prospect_name</span></button>   

            <div style="overflow: auto;text-align: center">
                
            
